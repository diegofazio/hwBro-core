/* --- the link record ------------------------------------------------ */

/* .T. when that panel record is the one the link took over. It needs BOTH the
 * flag of the record and the open session, so a stale flag can never make a
 * panel read a local directory as if it were a remote one. */
STATIC FUNCTION HcLinkPanel( aP )
   IF ! HB_ISARRAY( s_aHcLink ) .OR. ! HB_ISARRAY( aP )
      RETURN .F.
   ENDIF
   IF Len( aP ) < HC_P_LINK .OR. ValType( aP[ HC_P_LINK ] ) != "L"
      RETURN .F.
   ENDIF
RETURN aP[ HC_P_LINK ] .AND. aP[ HC_P_ID ] == s_aHcLink[ HC_L_PANEL ]

/* name announced by the Slave, host and port of the peer */
STATIC FUNCTION HcLinkName()
   IF ! HB_ISARRAY( s_aHcLink )
      RETURN ""
   ENDIF
RETURN s_aHcLink[ HC_L_NAME ]

STATIC FUNCTION HcLinkHost()
   IF ! HB_ISARRAY( s_aHcLink )
      RETURN ""
   ENDIF
RETURN s_aHcLink[ HC_L_HOST ]

STATIC FUNCTION HcLinkPort()
   IF ! HB_ISARRAY( s_aHcLink )
      RETURN 0
   ENDIF
RETURN s_aHcLink[ HC_L_PORT ]

/* .T. when the action has to be REFUSED because of the link: the ACTIVE panel
 * is linked, or - with <lBoth> - any panel is (the copy, the move and the
 * compare read both panels). */
STATIC FUNCTION HcLinkTouch( lBoth )
   DEFAULT lBoth TO .F.
   IF ! HB_ISARRAY( s_aHcLink )
      RETURN .F.
   ENDIF
   IF HcLinkPanel( HcPanelActive() )
      RETURN .T.
   ENDIF
RETURN lBoth == .T.

/* S3: the guard of every action a linked panel does not allow. One short
 * sentence, in a normal message box, and the panel or the dialog behind stays
 * exactly as it was. <lBoth> says "any panel is linked" for the actions that
 * read (or write) BOTH panels; <lOps> is for an action that IS a file operation
 * and simply has no remote version (the synchronizer, which copies between the
 * two panels), so the message says so instead of "read-only". F3, F4,
 * Shift-F2, the right button panel and Enter on a file always use the plain
 * form. Answers .T. when it refused. */
STATIC FUNCTION HcLinkGuard( lOps, lBoth )
   DEFAULT lOps TO .F.
   DEFAULT lBoth TO .F.
   IF ! HcLinkTouch( lBoth )
      RETURN .F.
   ENDIF
   IF lOps
      UiMsg( "Commander Link: that action works on the local panels only.", BP_APPNAME )
   ELSE
      UiMsg( "Commander Link: the remote panel is read-only, that action is not available.", ;
             BP_APPNAME )
   ENDIF
RETURN .T.

/* the listing of a linked panel. NIL when the Slave cannot be asked: the
 * caller keeps what it already had, so a peer that went away never empties a
 * panel. <cDir> is the ABSOLUTE remote path (HC_P_DIR of the panel). */
STATIC FUNCTION HcLinkReadDir( cDir, cSort, lDesc )
   LOCAL aList, cErr := ""
   IF ! HB_ISARRAY( s_aHcLink )
      RETURN NIL
   ENDIF
   aList := HcLkList( s_aHcLink[ HC_L_SOCK ], cDir, @cErr )
   IF ! HB_ISARRAY( aList )
      RETURN NIL
   ENDIF
RETURN HcLinkRows( aList, cSort, lDesc, HcLinkHasUp( cDir, HcLinkTop() ) )
/* the top of the exported scope of the link in force ("" when the whole disk
 * is exported and there is nothing to stop a `..`) */
STATIC FUNCTION HcLinkTop()
   IF ! HB_ISARRAY( s_aHcLink ) .OR. Len( s_aHcLink ) < HC_L_TOP .OR. ;
      ValType( s_aHcLink[ HC_L_TOP ] ) != "C"
      RETURN ""
   ENDIF
RETURN s_aHcLink[ HC_L_TOP ]

/* the drives of the PEER through the session in force (S15), or NIL with <cErr>
 * set. Alt-F1/Alt-F2 on a linked panel list these and nothing else. */
STATIC FUNCTION HcLinkRemoteDrives( cErr )
   IF ! HB_ISARRAY( s_aHcLink )
      cErr := "there is no link"
      RETURN NIL
   ENDIF
RETURN HcLkRemoteDrives( s_aHcLink[ HC_L_SOCK ], @cErr )

/* S2/S14: navigation inside a linked panel. A directory entry is one step down
 * the remote tree and `..` is one step up it. `..` NEVER leaves the link: at the
 * top of the exported scope (and at the root of a drive when the whole disk is
 * exported) it is a NO-OP, which is also why the panel does not paint that row
 * there. Nothing here touches the local disk: only the remote path and the
 * listing change. */
STATIC PROCEDURE HcLinkChangeDir( aPanel, cName )
   LOCAL cNew, aList
   IF cName == ".."
      IF ! HcLinkHasUp( aPanel[ HC_P_DIR ], HcLinkTop() )
         RETURN                      /* S14: nothing to go up to, stay here */
      ENDIF
      cNew := HcLinkUpDir( aPanel[ HC_P_DIR ], HcLinkTop() )
   ELSE
      cNew := HcLinkDirJoin( aPanel[ HC_P_DIR ], cName )
   ENDIF
   aList := HcLinkReadDir( cNew, HcPanelSort( aPanel ), HcPanelDesc( aPanel ) )
   IF ! HB_ISARRAY( aList )
      UiMsg( "Commander Link: cannot read the remote directory.", BP_APPNAME )
      RETURN
   ENDIF
   aPanel[ HC_P_DIR ]  := cNew
   aPanel[ HC_P_LIST ] := aList
   HcCursorTo( aPanel, 1 )
RETURN

/* S2: mounts the directory a Master session starts in on the ACTIVE panel. The
 * old LOCAL directory of the panel is remembered (HC_L_PREVDIR), because an
 * explicit disconnect has to give it back (S14). One link at a time: whatever
 * was linked before is detached first. <cStart> is the absolute path the Slave
 * announced and <cTop> the top of the exported scope ("" = whole disk). */
STATIC PROCEDURE HcLinkAttach( hSock, cStart, cName, cHost, nPort, cTop )
   LOCAL aP
   HcLinkDetach()
   aP := HcPanelActive()
   s_aHcLink := { hSock, cStart, cName, cHost, nPort, aP[ HC_P_ID ], aP[ HC_P_DIR ], cTop }
   aP[ HC_P_LINK ] := .T.
   aP[ HC_P_DIR ]  := HcLinkNormDir( cStart )
   aP[ HC_P_SEL ]  := 1
   aP[ HC_P_TOP ]  := 1
   HcLoad( aP )
RETURN

/* S2: closes the link and gives the panel back its local directory, reloaded.
 * Safe to call when there is no link. */
STATIC PROCEDURE HcLinkDetach()
   LOCAL nId := 0, aP
   IF ! HB_ISARRAY( s_aHcLink )
      RETURN
   ENDIF
   nId := s_aHcLink[ HC_L_PANEL ]
   HcLkClose( s_aHcLink[ HC_L_SOCK ] )
   IF nId >= HC_PANEL_L .AND. nId <= HC_PANEL_R
      aP := HcPanel( nId )
      aP[ HC_P_LINK ] := .F.
      aP[ HC_P_DIR ]  := s_aHcLink[ HC_L_PREVDIR ]
      aP[ HC_P_SEL ]  := 1
      aP[ HC_P_TOP ]  := 1
   ENDIF
   s_aHcLink := NIL
   IF nId >= HC_PANEL_L .AND. nId <= HC_PANEL_R
      HcLoad( aP )
   ENDIF
RETURN

/* S14/L7: leaving the link is an EXPLICIT action (`Left`/`Right > Disconnect
 * link`), never a side effect of `..`. It closes the session and gives the
 * panel back the local directory it had before linking. A panel that is not
 * linked is left alone (the menu row is dimmed there anyway). */
STATIC PROCEDURE HcLinkDisconnect( nId )
   LOCAL aP
   IF nId < HC_PANEL_L .OR. nId > HC_PANEL_R
      RETURN
   ENDIF
   aP := HcPanel( nId )
   IF ! HcLinkPanel( aP )
      RETURN
   ENDIF
   HcLinkDetach()
RETURN

/* =====================================================================
 *  S6: the operations ACROSS the link (T7)
 *
 *  F5 (both directions), F6, F7 and F8 act for real on the linked panel: the
 *  command key, the `Copy to:` / `Rename or move to:` / `Make directory:`
 *  prompts and the seven button overwrite dialog are the SAME ones the local
 *  operations use, and only the side that has to change differs. Everything
 *  that touches bytes goes through the primitives of src/bp_link.prg, whose
 *  writes are atomic on both ends (.$$$ + rename): a cancel or a failure leaves
 *  the destination byte identical.
 *
 *  RULES THAT COME FROM THE PANEL MODEL (see the header of this section):
 *    - HC_P_DIR of a linked panel is an ABSOLUTE path of the peer and it is
 *      NEVER given to a local filesystem call. The local path of a remote
 *      directory is built with HcLinkLocalPath() out of the LOCAL destination
 *      directory, never out of HC_P_DIR;
 *    - a remote path is already the peer's absolute path, so "a file copied
 *      onto itself" and "a directory moved inside itself" are refused by
 *      comparing it as TEXT (HcNormPath() and HcPathInsideHc() read no disk),
 *      exactly like the local operations do;
 *    - the overwrite dialog is fed by the caller with the four texts of the two
 *      sides (aInfo) when one of them is remote, because HcOwStampText() and
 *      HcOwSizeText() read the local disk.
 * ===================================================================== */

/* --- the pure part -------------------------------------------------- */

/* What the user typed in a `Copy to:` / `Rename or move to:` field, read as an
 * ABSOLUTE path of the peer. A linked panel shows its path as
 * "\\NAME\C:\sub\dir\" (HcLinkTitle()), so the answer usually comes back in
 * that form and the peer name is dropped again (there is only one link). A bare
 * name, or a relative path, lands in <cBaseDir> (the remote directory the panel
 * is in); anything absolute is taken as it is. Answers { cAbs, lDir, lOk }:
 * cAbs in the canonical form of HcLinkNormDir(), lDir .T. when the answer names
 * a DIRECTORY (the base directory, or a value that ended with a separator) and
 * lOk .F. when there is nothing usable. PURE: it only rewrites text, and what
 * it answers is confined by the Slave (S11/S14). */
FUNCTION HcLinkTargetAbs( cInput, cBaseDir )
   LOCAL c, n, lDir := .F., cBase
   DEFAULT cBaseDir TO ""
   cBase := HcLinkNormDir( cBaseDir )
   IF ValType( cInput ) != "C" .OR. ValType( cBaseDir ) != "C"
      RETURN { "", .F., .F. }
   ENDIF
   c := AllTrim( StrTran( AllTrim( cInput ), "/", "\" ) )
   IF Len( c ) == 0
      RETURN { "", .F., .F. }
   ENDIF
   /* the trailing separator says "this is a directory" and it is read BEFORE
    * the value is cleaned */
   lDir := ( Right( c, 1 ) == "\" )
   IF Left( c, 2 ) == "\\"
      /* the UNC form of the title: peer name first, then the remote path. What
       * follows the peer name is kept WHOLE, so a UNC path of the peer itself
       * ("\\NAME\\\SERVER\SHARE") comes back as "\\SERVER\SHARE" */
      c := SubStr( c, 3 )
      n := At( "\", c )
      c := iif( n == 0, "", SubStr( c, n + 1 ) )
   ENDIF
   IF Left( c, 1 ) == "\" .AND. ! ( Left( c, 2 ) == "\\" )
      DO WHILE Left( c, 1 ) == "\"
         c := SubStr( c, 2 )
      ENDDO
   ENDIF
   DO WHILE Right( c, 1 ) == "\"
      c := Left( c, Len( c ) - 1 )
   ENDDO
   IF Len( c ) == 0
      RETURN { cBase, .T., .T. }     /* the remote directory the panel is in */
   ENDIF
   IF HcLinkIsAbsPath( c )
      RETURN { HcLinkNormDir( c ), lDir, .T. }
   ENDIF
   /* a bare name, or a relative path, lands in the remote directory */
RETURN { HcLinkNormDir( HcJoinPath( cBase, c ) ), lDir, .T. }

/* The LOCAL path a remote path maps to, under <cLocalDir>: the part of
 * <cAbsFile> below <cAbsRoot> is joined with BACKSLASHES (the local separator).
 * This is the only bridge between the remote tree and this disk, and it always
 * starts from a LOCAL directory. PURE. */
FUNCTION HcLinkLocalPath( cLocalDir, cAbsRoot, cAbsFile )
   LOCAL cFile, cRoot
   DEFAULT cAbsRoot TO ""
   IF ValType( cLocalDir ) != "C" .OR. ValType( cAbsFile ) != "C"
      RETURN ""
   ENDIF
   cFile := HcLinkNormDir( cAbsFile )
   cRoot := HcLinkNormDir( cAbsRoot )
   IF Len( cRoot ) > 0 .AND. Upper( Left( cFile, Len( cRoot ) ) ) == Upper( cRoot )
      cFile := SubStr( cFile, Len( cRoot ) + 1 )
      DO WHILE Left( cFile, 1 ) == "\"
         cFile := SubStr( cFile, 2 )
      ENDDO
   ENDIF
   IF Len( cFile ) == 0
      RETURN cLocalDir
   ENDIF
RETURN HcJoinPath( cLocalDir, cFile )

/* The directory a remote path lives in: the parent, or the path itself when it
 * is the top of a drive (used by the tree walkers, which never receive the
 * scope top: they start BELOW it and only go down). PURE. */
FUNCTION HcLinkParentDir( cDir )
RETURN HcLinkUpDir( cDir, "" )

/* Last segment of a remote path ("C:\a\x.txt" -> "x.txt"). PURE. */
FUNCTION HcLinkLastSeg( cRel )
   LOCAL c := "", n
   IF ValType( cRel ) == "C"
      c := AllTrim( StrTran( cRel, "\", "/" ) )
   ENDIF
   DO WHILE Right( c, 1 ) == "/"
      c := Left( c, Len( c ) - 1 )
   ENDDO
   n := Rat( "/", c )
   IF n > 0
      RETURN SubStr( c, n + 1 )
   ENDIF
RETURN c

/* The 14 sortable characters ("YYYYMMDDHHMMSS") of a date and an "HH:MM:SS"
 * time, or "" when either of them is unknown: the key of "Replace Older" for a
 * side that lives on the peer. PURE. */
FUNCTION HcLinkStampKey( xDate, cTime )
   LOCAL d, aT
   IF ValType( cTime ) != "C"
      RETURN ""
   ENDIF
   d := xDate
   IF ValType( d ) == "T"
      d := hb_TToD( d )
   ENDIF
   IF ValType( d ) != "D" .OR. Empty( d )
      RETURN ""
   ENDIF
   aT := HcOwClock( cTime )
RETURN StrZero( Year( d ), 4 ) + StrZero( Month( d ), 2 ) + StrZero( Day( d ), 2 ) + ;
       StrZero( aT[ 1 ], 2 ) + StrZero( aT[ 2 ], 2 ) + StrZero( aT[ 3 ], 2 )

/* "Replace Older" for a side that lives on the peer: .T. only when BOTH keys are
 * known and the destination is STRICTLY older than the source (an equal, newer
 * or unreadable one is never taken as older, exactly like HcOwOlder()). PURE. */
FUNCTION HcLinkOlderStamp( cSrcStamp, cDstStamp )
   IF ValType( cSrcStamp ) != "C" .OR. ValType( cDstStamp ) != "C"
      RETURN .F.
   ENDIF
   IF Len( cSrcStamp ) == 0 .OR. Len( cDstStamp ) == 0
      RETURN .F.
   ENDIF
RETURN cDstStamp < cSrcStamp

/* --- the session of the link ---------------------------------------- */

/* S6/T7: is the link usable? LinkRemotePut() DROPS THE SESSION when the upload
 * is cancelled or breaks (bp_link.prg: there is no CANCEL verb, and dropping
 * it is what makes the Slave abort the PUT and remove its temporary), so from
 * then on LinkRemotePing() answers .F. and the link has to be opened once more
 * before anything else is asked of it. */
STATIC FUNCTION HcLinkEnsure()
   IF ! HB_ISARRAY( s_aHcLink )
      RETURN .F.
   ENDIF
   IF HcLkPing( s_aHcLink[ HC_L_SOCK ] )
      RETURN .T.
   ENDIF
RETURN HcLinkReconnect()

/* Opens the session ONCE more at the address of the link and leaves the panel
 * where it is (its HC_P_DIR is the absolute path of the peer, so it does not
 * have to be rebuilt: only the listing is read again). When the peer does not
 * answer the panel is unlinked and the user is told in ONE message. Answers
 * .T. when the link works again. */
STATIC FUNCTION HcLinkReconnect()
   LOCAL cHost, nPort, nPanel, cRel := "", aOpen, cErr := "", aP
   IF ! HB_ISARRAY( s_aHcLink )
      RETURN .F.
   ENDIF
   cHost  := s_aHcLink[ HC_L_HOST ]
   nPort  := s_aHcLink[ HC_L_PORT ]
   nPanel := s_aHcLink[ HC_L_PANEL ]
   IF nPanel >= HC_PANEL_L .AND. nPanel <= HC_PANEL_R
      aP := HcPanel( nPanel )
      cRel := aP[ HC_P_DIR ]
   ENDIF
   aOpen := HcLkOpen( cHost, nPort, @cErr )
   IF hb_IsNIL( aOpen )
      HcLinkDetach()
      UiErr( "Commander Link: the link to " + AllTrim( cHost ) + ":" + ;
             LTrim( Str( nPort ) ) + " was lost." + ;
             iif( Len( cErr ) > 0, hb_eol() + cErr, "" ), BP_APPNAME )
      RETURN .F.
   ENDIF   HcLkClose( s_aHcLink[ HC_L_SOCK ] )
   s_aHcLink[ HC_L_SOCK ] := aOpen[ 1 ]
   s_aHcLink[ HC_L_ROOT ] := aOpen[ 2 ]
   s_aHcLink[ HC_L_NAME ] := aOpen[ 3 ]
   IF Len( s_aHcLink ) >= HC_L_TOP
      s_aHcLink[ HC_L_TOP ] := aOpen[ 4 ]
   ENDIF
   IF nPanel >= HC_PANEL_L .AND. nPanel <= HC_PANEL_R
      /* the same directory of the peer, read again */
      aP[ HC_P_DIR ] := cRel
      HcLoad( aP )
   ENDIF
RETURN .T.

/* Reloads both panels after an operation across the link and leaves the cursor
 * of the remote one on <cName> when it is still there (the same courtesy the
 * local operations have with HcReloadPanels()). Without a link nothing happens
 * beyond a plain reload: the panel was detached because the peer went away. */
STATIC PROCEDURE HcLinkReload( cName )
   LOCAL nId, aP, nSel
   IF ! HB_ISARRAY( s_aHcLink )
      HcReloadPanels( "", "" )
      RETURN
   ENDIF
   FOR nId := HC_PANEL_L TO HC_PANEL_R
      aP := HcPanel( nId )
      nSel := aP[ HC_P_SEL ]
      HcLoad( aP )
      IF Len( cName ) > 0 .AND. HcLinkPanel( aP )
         HcGotoName( aP, cName )
      ELSE
         HcCursorTo( aP, nSel )
      ENDIF
   NEXT
RETURN

/* --- the trees ------------------------------------------------------ */

/* Walks the remote tree of <cRel> and collects every FILE as { cRel, nSize }
 * and every DIRECTORY as its relative path (the directories come out before
 * their contents, so creating them in order always has the parent first).
 * Answers .F. when the peer cannot be read, and then nothing must be copied. */
STATIC FUNCTION HcLinkWalkRemote( cRel, aFiles, aDirs )
   LOCAL aList, aE, i, cSub, cErr := ""
   IF ! HB_ISARRAY( s_aHcLink )
      RETURN .F.
   ENDIF
   aList := HcLkList( s_aHcLink[ HC_L_SOCK ], cRel, @cErr )
   IF ! HB_ISARRAY( aList )
      RETURN .F.
   ENDIF
   FOR i := 1 TO Len( aList )
      aE := aList[ i ]
      cSub := HcLinkDirJoin( cRel, aE[ HC_E_NAME ] )
      IF HcIsDir( aE )
         AAdd( aDirs, cSub )
         IF ! HcLinkWalkRemote( cSub, aFiles, aDirs )
            RETURN .F.
         ENDIF
      ELSE
         AAdd( aFiles, { cSub, aE[ HC_E_SIZE ] } )
      ENDIF
   NEXT
RETURN .T.

/* bytes of a remote tree: the total of the progress bar (0 when the peer cannot
 * be asked, and then the bar just follows what arrives) */
STATIC FUNCTION HcLinkRemoteBytes( cRel )
   LOCAL aFiles := {}, aDirs := {}, i, n := 0
   IF ! HcLinkWalkRemote( cRel, aFiles, aDirs )
      RETURN 0
   ENDIF
   FOR i := 1 TO Len( aFiles )
      n += aFiles[ i ][ 2 ]
   NEXT
RETURN n

/* Creates <cDir> and every missing parent of it on the peer, and answers
 * { lOk, cErr }. The recursion stops when the directory is already there or
 * when the path is its own parent (the root of a drive), so it can never walk
 * out of the tree it was given. */
STATIC FUNCTION HcLinkMkDirOnce( cDir )
   LOCAL aSt, cErr := "", aRes, cParent
   aSt := HcLkStat( s_aHcLink[ HC_L_SOCK ], cDir, @cErr )
   IF HB_ISARRAY( aSt ) .AND. aSt[ 1 ] == "D"
      RETURN { .T., "" }
   ENDIF
   cParent := HcLinkParentDir( cDir )
   /* the parents first: a whole tree can be uploaded into a directory the
    * peer does not have yet */
   IF Len( cParent ) > 0 .AND. ! ( cParent == cDir )
      aRes := HcLinkMkDirOnce( cParent )
      IF ! aRes[ 1 ]
         RETURN aRes
      ENDIF
   ENDIF
   IF ! HcLkMkDir( s_aHcLink[ HC_L_SOCK ], cDir, @cErr )
      RETURN { .F., iif( Len( cErr ) == 0, "Cannot create " + cDir, cErr ) }
   ENDIF
RETURN { .T., "" }

/* Downloads the remote tree of <cRelSrc> into the LOCAL directory <cLocalDst>,
 * creating it (and every directory the tree has, empty ones included).
 * Answers { lOk, cErr, lCancel } like HcCopyAnyHc(). */
STATIC FUNCTION HcLinkGetTree( cRelSrc, cLocalDst )
   LOCAL aFiles := {}, aDirs := {}, i, cLocal, aRes, cErr := ""
   IF ! HcLinkWalkRemote( cRelSrc, aFiles, aDirs )
      RETURN { .F., "Cannot read the remote directory: " + ;
                   HcLinkTitle( HcLinkName(), cRelSrc ), .F. }
   ENDIF
   IF ! hb_DirExists( cLocalDst )
      IF hb_DirCreate( cLocalDst ) != 0
         RETURN { .F., "Cannot create the directory " + cLocalDst, .F. }
      ENDIF
   ENDIF
   FOR i := 1 TO Len( aDirs )
      cLocal := HcLinkLocalPath( cLocalDst, cRelSrc, aDirs[ i ] )
      IF ! hb_DirExists( cLocal )
         hb_DirCreate( cLocal )
      ENDIF
   NEXT
   FOR i := 1 TO Len( aFiles )
      IF HcProgStep( 0 )
         RETURN { .F., "", .T. }
      ENDIF
      cLocal := HcLinkLocalPath( cLocalDst, cRelSrc, aFiles[ i ][ 1 ] )
      aRes := HcLkGet( s_aHcLink[ HC_L_SOCK ], aFiles[ i ][ 1 ], cLocal, ;
                       {| nDone, nTotal | HcLinkProgStep( nDone, nTotal ) }, @cErr )
      IF ! aRes[ 1 ]
         RETURN { .F., cErr, cErr == "cancelled" }
      ENDIF
   NEXT
RETURN { .T., "", .F. }

/* Uploads the LOCAL tree of <cLocalSrc> into the remote directory <cRelDst>,
 * creating it and every directory below it. Answers { lOk, cErr, lCancel }. */
STATIC FUNCTION HcLinkPutTree( cLocalSrc, cRelDst )
   LOCAL aRaw, aE, i, cSub, aRes, cErr := ""
   aRes := HcLinkMkDirOnce( cRelDst )
   IF ! aRes[ 1 ]
      RETURN { .F., aRes[ 2 ], .F. }
   ENDIF
   aRaw := hb_vfDirectory( HcDirArg( cLocalSrc ), "HSD" )
   IF ! HB_ISARRAY( aRaw )
      aRaw := {}
   ENDIF
   FOR i := 1 TO Len( aRaw )
      aE := aRaw[ i ]
      IF aE[ 1 ] == "." .OR. aE[ 1 ] == ".."
         LOOP
      ENDIF
      IF HcProgStep( 0 )
         RETURN { .F., "", .T. }
      ENDIF
      cSub := HcLinkDirJoin( cRelDst, aE[ 1 ] )
      IF hb_DirExists( HcJoinPath( cLocalSrc, aE[ 1 ] ) )
         aRes := HcLinkPutTree( HcJoinPath( cLocalSrc, aE[ 1 ] ), cSub )
         IF ! aRes[ 1 ]
            RETURN aRes
         ENDIF
      ELSE
         aRes := HcLkPut( s_aHcLink[ HC_L_SOCK ], HcJoinPath( cLocalSrc, aE[ 1 ] ), cSub, ;
                          {| nDone, nTotal | HcLinkProgStep( nDone, nTotal ) }, @cErr )
         IF ! aRes[ 1 ]
            RETURN { .F., cErr, cErr == "cancelled" }
         ENDIF
      ENDIF
   NEXT
RETURN { .T., "", .F. }

/* --- the progress of a transfer ------------------------------------- */

STATIC PROCEDURE HcLinkProgBegin( cTitle, nTotal )
   s_nHcLinkPrev := 0
   HcProgBegin( cTitle, nTotal )
RETURN

/* The bProgress block of LinkRemoteGet()/LinkRemotePut(): nDone is cumulative
 * for the FILE in course, so a value that went backwards means another file
 * started and the bar only advances by the difference. Answers .T. to cancel,
 * which is what aborts the transfer (the module then removes its temporary and
 * the destination stays byte identical). */
STATIC FUNCTION HcLinkProgStep( nDone, nTotal )
   LOCAL nAdd
   DEFAULT nTotal TO 0
   IF ValType( nDone ) != "N"
      RETURN .F.
   ENDIF
   IF nDone < s_nHcLinkPrev
      s_nHcLinkPrev := 0
   ENDIF
   nAdd := nDone - s_nHcLinkPrev
   s_nHcLinkPrev := nDone
   IF nAdd <= 0
      RETURN .F.
   ENDIF
RETURN HcProgStep( nAdd )

/* --- what the overwrite dialog shows of a remote side ---------------- */

STATIC FUNCTION HcLinkSizeText( aEntry )
   IF ! HB_ISARRAY( aEntry )
      RETURN "?"
   ENDIF
   IF HcIsDir( aEntry )
      RETURN "DIR"
   ENDIF
RETURN HcSizeText( aEntry[ HC_E_SIZE ] ) + " bytes"

STATIC FUNCTION HcLinkEntryStamp( aEntry )
   IF ! HB_ISARRAY( aEntry ) .OR. Len( aEntry ) < HC_E_TIME
      RETURN ""
   ENDIF
RETURN HcLinkStampKey( aEntry[ HC_E_DATE ], aEntry[ HC_E_TIME ] )

/* the "YYYY-MM-DD HH:MM:SS" text of a 14 character key, like HcOwStampText() */
STATIC FUNCTION HcLinkStampText( cKey )
   IF ValType( cKey ) != "C" .OR. Len( cKey ) != 14
      RETURN "(no timestamp)"
   ENDIF
RETURN Left( cKey, 4 ) + "-" + SubStr( cKey, 5, 2 ) + "-" + SubStr( cKey, 7, 2 ) + ;
       " " + SubStr( cKey, 9, 2 ) + ":" + SubStr( cKey, 11, 2 ) + ":" + SubStr( cKey, 13, 2 )

/* STAT of a remote path: the array of HcLkStat() or NIL. It is asked over the
 * link, so it costs one round trip and it is only used where the answer
 * decides something (an existing destination, a directory to create). */
STATIC FUNCTION HcLinkRemoteStat( cRel )
   LOCAL cErr := ""
   IF ! HB_ISARRAY( s_aHcLink )
      RETURN NIL
   ENDIF
RETURN HcLkStat( s_aHcLink[ HC_L_SOCK ], cRel, @cErr )

STATIC FUNCTION HcLinkRemoteIsDir( cRel )
   LOCAL aSt := HcLinkRemoteStat( cRel )
RETURN HB_ISARRAY( aSt ) .AND. aSt[ 1 ] == "D"

STATIC FUNCTION HcLinkRemoteExists( cRel )
RETURN HB_ISARRAY( HcLinkRemoteStat( cRel ) )

/* the display path of a remote entry, the name included:
 * "\\NAME\C:\sub\file". It is only ever PAINTED or printed, never given to a
 * filesystem call, and it is the inverse of HcLinkTargetAbs(). PURE. */
STATIC FUNCTION HcLinkShow( cDir )
   LOCAL c := HcLinkNormDir( iif( ValType( cDir ) == "C", cDir, "" ) )
   LOCAL cOut := "\\" + AllTrim( HcLinkName() )
   IF Len( c ) == 0
      RETURN cOut + "\"
   ENDIF
RETURN cOut + "\" + c

/* the two texts of the DESTINATION side of an overwrite dialog when it lives on
 * the peer: a STAT that came back NIL (the peer cannot be asked) answers the
 * same "unknown" the local helpers answer */
STATIC FUNCTION HcLinkStatStamp( aSt )
   IF ! HB_ISARRAY( aSt )
      RETURN ""
   ENDIF
RETURN HcLinkStampKey( aSt[ 3 ], aSt[ 4 ] )

STATIC FUNCTION HcLinkStatSize( aSt )
   IF ! HB_ISARRAY( aSt )
      RETURN "?"
   ENDIF
   IF aSt[ 1 ] == "D"
      RETURN "DIR"
   ENDIF
RETURN HcSizeText( aSt[ 2 ] ) + " bytes"

/* --- F5: copy across the link --------------------------------------- */

/* The ACTIVE panel decides the direction: a linked active panel DOWNLOADS
 * (remote -> local), a linked OTHER panel UPLOADS (local -> remote). One link at
 * a time, so the two cases cannot both be true. */
STATIC PROCEDURE HcLinkCopy()
   IF HcLinkPanel( HcPanelActive() )
      HcLinkCopyGet()
   ELSE
      HcLinkCopyPut()
   ENDIF
RETURN

/* F5, remote -> local: the `Copy to:` proposal is the LOCAL directory of the
 * other panel (plus the name when a single file travels), the overwrite dialog
 * is asked for a destination that already exists and its sticky answers last
 * for the rest of THIS operation. */
STATIC PROCEDURE HcLinkCopyGet()
   LOCAL aP := HcPanelActive(), aSel := HcSourceSet( aP )
   LOCAL cLocalDir := HcPanel( HcOtherPanel() )[ HC_P_DIR ]
   LOCAL cDst, cDstProp, nDstW, cName, lSingle, cRel, cTo, cSrcShow, cAbs
   LOCAL i, aE, aRes, nTotal := 0, cErr := "", cFocusDir := "", cFocusName := ""
   LOCAL lCancel := .F., nOwState := 0, nChoice, cAction, cNew, lDo, aDec, aInfo
   IF ! HcLinkEnsure()
      RETURN
   ENDIF
   IF Empty( aSel )
      UiMsg( "Select the file(s) or directory(ies) to copy.", "Copy" )
      RETURN
   ENDIF
   lSingle  := Len( aSel ) == 1 .AND. ! HcIsDir( aSel[ 1 ] )
   cName    := iif( Len( aSel ) == 1, aSel[ 1 ][ HC_E_NAME ], "" )
   cDstProp := iif( lSingle, HcJoinPath( cLocalDir, cName ), cLocalDir )
   cDstProp := HcZipShowPath( cDstProp )
   nDstW := Min( 96, UiCols() - 16 )
   cDst := UiInput( "Copy to:", cDstProp, nDstW )
   IF hb_IsNIL( cDst )
      RETURN
   ENDIF
   cDst := AllTrim( cDst )
   /* a field only SHOWS nDstW cells: an answer that is exactly the cut of the
    * proposal is the proposal (same rule as the local copy) */
   IF Len( cDst ) == nDstW .AND. Len( cDstProp ) > nDstW .AND. ;
      Left( cDstProp, nDstW ) == cDst
      cDst := cDstProp
   ENDIF
   IF Len( cDst ) == 0
      UiErr( "The destination cannot be empty.", "Copy" )
      RETURN
   ENDIF
   cDst := HcCopyTarget( HcZipRealPath( cDst ), cLocalDir, cName, lSingle )
   IF lSingle
      IF ! hb_DirExists( HcParentDir( cDst ) )
         UiErr( "The destination directory does not exist:" + hb_eol() + ;
                HcParentDir( cDst ), "Copy" )
         RETURN
      ENDIF
   ELSEIF ! hb_DirExists( cDst )
      UiErr( "The destination directory does not exist:" + hb_eol() + cDst, "Copy" )
      RETURN
   ENDIF
   FOR i := 1 TO Len( aSel )
      nTotal += HcLinkRemoteBytes( HcLinkDirJoin( aP[ HC_P_DIR ], aSel[ i ][ HC_E_NAME ] ) )
   NEXT
   HcLinkProgBegin( "Copying", nTotal )
   FOR i := 1 TO Len( aSel )
      aE := aSel[ i ]
      cRel := HcLinkDirJoin( aP[ HC_P_DIR ], aE[ HC_E_NAME ] )
      cTo  := iif( lSingle, cDst, HcJoinPath( cDst, aE[ HC_E_NAME ] ) )
      /* cRel is already the peer's absolute path, so it compares as text with
       * the LOCAL destination (HcNormPath() reads no disk) */
      cAbs := cRel
      cSrcShow := HcLinkShow( cRel )
      IF ! HcIsDir( aE ) .AND. HcNormPath( cTo ) == HcNormPath( cAbs )
         /* the peer serves the very directory this panel is showing */
         cErr := "Cannot copy a file onto itself:" + hb_eol() + cTo
      ELSEIF HcIsDir( aE ) .AND. HcPathInsideHc( cAbs, cTo )
         cErr := "Cannot copy a directory into itself:" + hb_eol() + cTo
      ELSE
         lDo := .T.
         DO WHILE hb_DirExists( cTo ) .OR. hb_vfExists( cTo )
            IF nOwState == 0
               /* the SOURCE lives on the peer: its stamp and its size come
                * from the listing, never from this disk */
               aInfo := { HcLinkStampText( HcLinkEntryStamp( aE ) ), ;
                          HcLinkSizeText( aE ), NIL, NIL }
               nChoice := HcOwAsk( aE[ HC_E_NAME ], cSrcShow, cTo, aInfo )
               aDec := HcOwResolve( 0, nChoice, ;
                        HcLinkOlderStamp( HcLinkEntryStamp( aE ), HcFileStampKey( cTo ) ) )
            ELSE
               /* Replace All / Skip All: no question and no round trip */
               aDec := HcOwResolve( nOwState, 0, .F. )
            ENDIF
            nOwState := aDec[ 2 ]
            cAction := aDec[ 1 ]
            IF cAction == "CANCEL"
               lCancel := .T.
            ELSEIF cAction == "SKIP"
               lDo := .F.
            ELSEIF cAction == "RENAME"
               cNew := UiInput( "New destination name:", aE[ HC_E_NAME ], 60 )
               IF hb_IsNIL( cNew ) .OR. Len( AllTrim( cNew ) ) == 0
                  lDo := .F.
               ELSE
                  cTo := HcOwRename( cDst, AllTrim( cNew ) )
                  LOOP
               ENDIF
            ENDIF
            EXIT
         ENDDO
         IF lCancel
            EXIT
         ENDIF
         IF ! lDo
            LOOP
         ENDIF
         IF HcIsDir( aE )
            aRes := HcLinkGetTree( cRel, cTo )
         ELSE
            aRes := HcLkGet( s_aHcLink[ HC_L_SOCK ], cRel, cTo, ;
                             {| nDone, nTotal2 | HcLinkProgStep( nDone, nTotal2 ) }, @cErr )
            aRes := { aRes[ 1 ], cErr, cErr == "cancelled" }
         ENDIF
         IF aRes[ 3 ]
            lCancel := .T.
            EXIT
         ENDIF
         IF ! aRes[ 1 ]
            cErr := aRes[ 2 ]
         ELSE
            cFocusDir := cDst
            cFocusName := aE[ HC_E_NAME ]
            IF lSingle
               cFocusDir := HcParentDir( cDst )
               cFocusName := HcDirName( cDst )
            ENDIF
         ENDIF
      ENDIF
   NEXT
   HcProgEnd()
   HcZipSync()
   /* a cancelled or broken transfer can have dropped the session (a PUT does),
    * so the link is checked BEFORE the panels are read again */
   IF ! HcLinkEnsure()
      RETURN
   ENDIF
   HcLinkReload( cFocusName )
   IF Len( cErr ) > 0
      UiErr( cErr, "Copy" )
   ENDIF
RETURN

/* F5, local -> remote: the proposal is the path the linked panel SHOWS
 * ("\\NAME\sub\") plus the name of a single file, and the answer is read back
 * as a path inside the served root (HcLinkTargetAbs()). */
STATIC PROCEDURE HcLinkCopyPut()
   LOCAL aP := HcPanelActive(), aSel := HcSourceSet( aP )
   LOCAL aRem := HcPanel( HcOtherPanel() )
   LOCAL aTarget, cRelRoot := aRem[ HC_P_DIR ], cRelDst, cRelTo, cProp, cInput
   LOCAL nW, cName, lSingle, cSrc, cErr := "", cFocusName := ""
   LOCAL i, aE, aRes, aCnt, nTotal := 0, lCancel := .F.
   LOCAL nOwState := 0, nChoice, cAction, cNew, lDo, aDec, aInfo, aSt, cDstShow
   IF ! HcLinkEnsure()
      RETURN
   ENDIF
   IF Empty( aSel )
      UiMsg( "Select the file(s) or directory(ies) to copy.", "Copy" )
      RETURN
   ENDIF
   lSingle := Len( aSel ) == 1 .AND. ! HcIsDir( aSel[ 1 ] )
   cName   := iif( Len( aSel ) == 1, aSel[ 1 ][ HC_E_NAME ], "" )
   cProp   := HcLinkTitle( HcLinkName(), cRelRoot ) + iif( lSingle, cName, "" )
   nW      := Min( 96, UiCols() - 16 )
   cInput  := UiInput( "Copy to:", cProp, nW )
   IF hb_IsNIL( cInput )
      RETURN
   ENDIF
   cInput := AllTrim( cInput )
   IF Len( cInput ) == nW .AND. Len( cProp ) > nW .AND. Left( cProp, nW ) == cInput
      cInput := cProp
   ENDIF
   IF Len( cInput ) == 0
      UiErr( "The destination cannot be empty.", "Copy" )
      RETURN
   ENDIF
   aTarget := HcLinkTargetAbs( cInput, cRelRoot )
   IF ! aTarget[ 3 ]
      UiErr( "The destination cannot be empty.", "Copy" )
      RETURN
   ENDIF
   cRelDst := aTarget[ 1 ]
   /* the destination has to be usable BEFORE anything travels: the whole set
    * lands INSIDE a directory, a single file lands ON a path whose parent
    * directory must exist (the same rule the local copy follows) */
   IF lSingle .AND. ! aTarget[ 2 ]
      IF ! HcLinkRemoteIsDir( HcLinkParentDir( cRelDst ) )
         UiErr( "The destination directory does not exist:" + hb_eol() + ;
                HcLinkShow( HcLinkParentDir( cRelDst ) ), "Copy" )
         RETURN
      ENDIF
   ELSEIF ! HcLinkRemoteIsDir( cRelDst )
      UiErr( "The destination directory does not exist:" + hb_eol() + ;
             HcLinkShow( cRelDst ), "Copy" )
      RETURN
   ENDIF
   FOR i := 1 TO Len( aSel )
      aCnt := HcCountTreeHc( HcJoinPath( aP[ HC_P_DIR ], aSel[ i ][ HC_E_NAME ] ) )
      nTotal += aCnt[ 2 ]
   NEXT
   HcLinkProgBegin( "Copying", nTotal )
   FOR i := 1 TO Len( aSel )
      aE := aSel[ i ]
      cSrc := HcJoinPath( aP[ HC_P_DIR ], aE[ HC_E_NAME ] )
      cRelTo := iif( lSingle .AND. ! aTarget[ 2 ], cRelDst, ;
                     HcLinkDirJoin( cRelDst, aE[ HC_E_NAME ] ) )
      cDstShow := HcLinkShow( cRelTo )
      IF ! HcIsDir( aE ) .AND. HcNormPath( cSrc ) == HcNormPath( cRelTo )
         cErr := "Cannot copy a file onto itself:" + hb_eol() + cSrc
      ELSEIF HcIsDir( aE ) .AND. HcPathInsideHc( cSrc, cRelTo )
         cErr := "Cannot copy a directory into itself:" + hb_eol() + cSrc
      ELSE
         lDo := .T.
         DO WHILE HcLinkRemoteExists( cRelTo )
            IF nOwState == 0
               /* the DESTINATION lives on the peer: its stamp and its size
                * come from a STAT, never from this disk */
               aSt := HcLinkRemoteStat( cRelTo )
               aInfo := { NIL, NIL, HcLinkStampText( HcLinkStatStamp( aSt ) ), ;
                          HcLinkStatSize( aSt ) }
               nChoice := HcOwAsk( aE[ HC_E_NAME ], cSrc, cDstShow, aInfo )
               aDec := HcOwResolve( 0, nChoice, ;
                        HcLinkOlderStamp( HcFileStampKey( cSrc ), HcLinkStatStamp( aSt ) ) )
            ELSE
               /* Replace All / Skip All: no question and no round trip */
               aDec := HcOwResolve( nOwState, 0, .F. )
            ENDIF
            nOwState := aDec[ 2 ]
            cAction := aDec[ 1 ]
            IF cAction == "CANCEL"
               lCancel := .T.
            ELSEIF cAction == "SKIP"
               lDo := .F.
            ELSEIF cAction == "RENAME"
               cNew := UiInput( "New destination name:", aE[ HC_E_NAME ], 60 )
               IF hb_IsNIL( cNew ) .OR. Len( AllTrim( cNew ) ) == 0
                  lDo := .F.
               ELSE
                  cRelTo := HcLinkDirJoin( HcLinkParentDir( cRelTo ), AllTrim( cNew ) )
                  cDstShow := HcLinkShow( cRelTo )
                  LOOP
               ENDIF
            ENDIF
            EXIT
         ENDDO
         IF lCancel
            EXIT
         ENDIF
         IF ! lDo
            LOOP
         ENDIF
         IF HcIsDir( aE )
            aRes := HcLinkPutTree( cSrc, cRelTo )
         ELSE
            aRes := HcLkPut( s_aHcLink[ HC_L_SOCK ], cSrc, cRelTo, ;
                             {| nDone, nTotal2 | HcLinkProgStep( nDone, nTotal2 ) }, @cErr )
            aRes := { aRes[ 1 ], cErr, cErr == "cancelled" }
         ENDIF
         IF aRes[ 3 ]
            lCancel := .T.
            EXIT
         ENDIF
         IF ! aRes[ 1 ]
            cErr := aRes[ 2 ]
         ELSE
            cFocusName := HcLinkLastSeg( cRelTo )
         ENDIF
      ENDIF
   NEXT
   HcProgEnd()
   /* a cancelled or broken PUT drops the session: the link is opened once more
    * before the panel is read again, and when that fails the panel is unlinked
    * and the user hears about it in ONE message (HcLinkReconnect) */
   IF ! HcLinkEnsure()
      RETURN
   ENDIF
   HcLinkReload( cFocusName )
   IF Len( cErr ) > 0
      UiErr( cErr, "Copy" )
   ENDIF
RETURN

/* F6 on a linked panel: a rename can only land INSIDE the remote tree (the other
 * panel is the local disk and RENAME cannot cross machines), so the proposal is
 * the remote directory the panel is in plus the name, and the user edits the
 * name - the same way the local F6 proposes a directory plus the name. */
STATIC PROCEDURE HcLinkMove()
   LOCAL aP := HcPanelActive(), aSel := HcSourceSet( aP )
   LOCAL aE, cName, cRelFrom, cRelTo, cProp, cInput, nW, aTarget, cErr := ""
   LOCAL lOk, aSt
   IF ! HcLinkEnsure()
      RETURN
   ENDIF
   IF Len( aSel ) != 1
      UiMsg( "Select ONE entry to rename or move.", "Rename/Move" )
      RETURN
   ENDIF
   aE := aSel[ 1 ]
   cName := aE[ HC_E_NAME ]
   cRelFrom := HcLinkDirJoin( aP[ HC_P_DIR ], cName )
   cProp := HcLinkTitle( HcLinkName(), aP[ HC_P_DIR ] ) + cName
   nW := Min( 96, UiCols() - 16 )
   cInput := UiInput( "Rename or move to:", cProp, nW )
   IF hb_IsNIL( cInput )
      RETURN
   ENDIF
   cInput := AllTrim( cInput )
   IF Len( cInput ) == nW .AND. Len( cProp ) > nW .AND. Left( cProp, nW ) == cInput
      cInput := cProp
   ENDIF
   IF Len( cInput ) == 0
      UiErr( "The name cannot be empty.", "Rename/Move" )
      RETURN
   ENDIF
   aTarget := HcLinkTargetAbs( cInput, aP[ HC_P_DIR ] )
   IF ! aTarget[ 3 ]
      UiErr( "The name cannot be empty.", "Rename/Move" )
      RETURN
   ENDIF
   cRelTo := aTarget[ 1 ]
   IF cRelTo == cRelFrom
      UiMsg( "The name is the same.", "Rename/Move" )
      RETURN
   ENDIF
   /* a directory can never be moved into itself or into one of its
    * descendants: the containment helper works on the RELATIVE path because
    * HcNormPath() is purely textual */
   IF HcIsDir( aE ) .AND. HcPathInsideHc( cRelFrom, cRelTo )
      UiErr( "Cannot move a directory into itself or into one of its descendants:" + ;
             hb_eol() + HcLinkShow( cRelTo ), "Rename/Move" )
      RETURN
   ENDIF
   aSt := HcLinkRemoteStat( cRelTo )
   IF HB_ISARRAY( aSt ) .AND. ! HcConfirm( "Overwrite " + HcLinkShow( cRelTo ) + "?", ;
                                           "Rename/Move" )
      RETURN
   ENDIF
   lOk := HcLkRename( s_aHcLink[ HC_L_SOCK ], cRelFrom, cRelTo, @cErr )
   IF ! HcLinkEnsure()
      RETURN
   ENDIF
   HcLinkReload( iif( lOk, HcLinkLastSeg( cRelTo ), "" ) )
   IF ! lOk
      UiErr( iif( Len( cErr ) == 0, "Cannot rename " + cRelFrom, cErr ), "Rename/Move" )
   ENDIF
RETURN

/* F7 on a linked panel */
STATIC PROCEDURE HcLinkMakeDir()
   LOCAL aP := HcPanelActive(), cName, cRel, cErr := "", lOk
   IF ! HcLinkEnsure()
      RETURN
   ENDIF
   cName := UiInput( "Make directory:", "", 60 )
   IF hb_IsNIL( cName )
      RETURN
   ENDIF
   cName := AllTrim( cName )
   IF Len( cName ) == 0
      UiErr( "The name cannot be empty.", "Make directory" )
      RETURN
   ENDIF
   IF ! HcNameOk( cName )
      UiErr( "A directory name cannot contain any of these characters:" + hb_eol() + ;
             "    \  /  :  *  ?  " + Chr( 34 ) + "  <  >  |", "Make directory" )
      RETURN
   ENDIF
   cRel := HcLinkDirJoin( aP[ HC_P_DIR ], cName )
   lOk := HcLkMkDir( s_aHcLink[ HC_L_SOCK ], cRel, @cErr )
   IF ! HcLinkEnsure()
      RETURN
   ENDIF
   HcLinkReload( iif( lOk, cName, "" ) )
   IF ! lOk
      UiErr( iif( Len( cErr ) == 0, "Cannot create " + cName, cErr ), "Make directory" )
   ENDIF
RETURN

/* F8 on a linked panel: ONE confirmation, with the count and the destination,
 * and the text NAMES THE PEER so nobody deletes thinking it is local. */
STATIC PROCEDURE HcLinkDelete()
   LOCAL aP := HcPanelActive(), aSel := HcSourceSet( aP )
   LOCAL aE, i, nFiles := 0, nDirs := 0, cText, cErr := "", lOk, cRel
   IF ! HcLinkEnsure()
      RETURN
   ENDIF
   IF Empty( aSel )
      UiMsg( "Select the file(s) or directory(ies) to delete.", "Delete" )
      RETURN
   ENDIF
   FOR i := 1 TO Len( aSel )
      IF HcIsDir( aSel[ i ] )
         nDirs++
      ELSE
         nFiles++
      ENDIF
   NEXT
   IF Len( aSel ) == 1 .AND. nDirs == 1
      cText := "Delete directory " + aSel[ 1 ][ HC_E_NAME ] + " and all its contents?"
   ELSEIF nDirs == 0
      cText := "Delete " + LTrim( Str( nFiles ) ) + " file(s)?"
   ELSE
      cText := "Delete " + LTrim( Str( Len( aSel ) ) ) + " item(s)?" + hb_eol() + ;
               "(" + LTrim( Str( nFiles ) ) + " file(s) and " + ;
               LTrim( Str( nDirs ) ) + " director(ies) with their contents)"
   ENDIF
   cText += hb_eol() + "On the Commander Link peer " + ;
            HcLinkTitle( HcLinkName(), aP[ HC_P_DIR ] )
   IF ! HcConfirm( cText, "Delete" )
      RETURN
   ENDIF
   FOR i := 1 TO Len( aSel )
      aE := aSel[ i ]
      cRel := HcLinkDirJoin( aP[ HC_P_DIR ], aE[ HC_E_NAME ] )
      IF HcIsDir( aE )
         lOk := HcLkDelTree( s_aHcLink[ HC_L_SOCK ], cRel, @cErr )
      ELSE
         lOk := HcLkDelFile( s_aHcLink[ HC_L_SOCK ], cRel, @cErr )
      ENDIF
      IF ! lOk
         EXIT
      ENDIF
   NEXT
   IF ! HcLinkEnsure()
      RETURN
   ENDIF
   HcLinkReload( "" )
   IF ! lOk
      UiErr( iif( Len( cErr ) == 0, "Cannot delete the remote entries.", cErr ), "Delete" )
   ENDIF
RETURN

/* --- S9: the Slave side --------------------------------------------- */

/* Starts (or restarts) the listener of the Slave plus the UDP discovery on the
 * same port, serving <cFolder> with the scope <lWhole> (S14: the whole disk is
 * the default, `This panel's folder` narrows it to <cFolder>). Answers "" when
 * it worked and the reason when it did not (a taken port, a directory that is
 * gone...). */
STATIC FUNCTION HcLinkSlaveStart( nPort, cFolder, lWhole )
   LOCAL aRes, cRoot
   DEFAULT lWhole TO .T.
   HcLinkSlaveStop()
   IF ValType( nPort ) != "N" .OR. nPort < 1 .OR. nPort > 65535
      RETURN "The port has to be a number between 1 and 65535."
   ENDIF
   IF lWhole
      cRoot := HC_LINK_DISK_ROOT
   ELSE
      IF ! hb_DirExists( cFolder )
         RETURN "The directory to serve does not exist: " + cFolder
      ENDIF
      cRoot := cFolder
   ENDIF
   aRes := HcLkListen( nPort )
   IF hb_IsNIL( aRes[ 1 ] )
      RETURN aRes[ 2 ]
   ENDIF
   s_hHcLinkListen := aRes[ 1 ]
   /* the discovery is a courtesy: without it the Master can still be given the
    * address by hand (S5), so a taken UDP port is not an error */
   s_hHcLinkUdp  := HcLkUdpOpen( nPort )
   s_nHcLinkPort := nPort
   s_cHcLinkRoot := cRoot
RETURN ""

/* Closes the listener and the UDP socket of the Slave. The sessions it accepted
 * die with it (a pending PUT leaves its destination untouched, S10). Called
 * from the dialog when the Slave mode is switched off and when the program
 * leaves. */
STATIC PROCEDURE HcLinkSlaveStop()
   IF ! hb_IsNIL( s_hHcLinkListen )
      HcLkCloseAll()
      HcLkClose( s_hHcLinkListen )
      s_hHcLinkListen := NIL
   ENDIF
   IF ! hb_IsNIL( s_hHcLinkUdp )
      HcLkClose( s_hHcLinkUdp )
      s_hHcLinkUdp := NIL
   ENDIF
   s_cHcLinkRoot := ""
RETURN

/* S9: one pass of the Slave, called ONCE per iteration of the key loop, right
 * after the key/mouse wait and before the key is handled (a 0 ms budget, so it
 * can never block the screen). Nothing is painted here: the chip of the bar
 * shows on the next full repaint. LinkSetPumpHook() is NOT installed: that hook
 * exists only for the headless bank, which has no key loop to pump from. */
STATIC PROCEDURE HcLinkServe()
   IF ! hb_IsNIL( s_hHcLinkListen )
      HcLkPump( s_hHcLinkListen, s_cHcLinkRoot )
   ENDIF
   IF ! hb_IsNIL( s_hHcLinkUdp )
      HcLkPumpUdp( s_hHcLinkUdp, s_nHcLinkPort )
   ENDIF
RETURN

/* leaving the program: the link of the panels and the Slave of this screen */
STATIC PROCEDURE HcLinkShutdown()
   IF HB_ISARRAY( s_aHcLink )
      HcLkClose( s_aHcLink[ HC_L_SOCK ] )
      s_aHcLink := NIL
   ENDIF
   HcLinkSlaveStop()
RETURN

/* S2 of window-close.md (B3): the ONE public door to HcLinkShutdown().
 * HcLinkShutdown() is STATIC because this screen used to be the only owner of
 * the Slave, but Main() has to shut it down too: every exit shape ends there
 * -Alt-X, F10, the dot `QUIT` and the X of the window-, not only the
 * `Exit hwBro?` of HcAskQuit(). Main() cannot call a STATIC procedure, so the
 * door exists instead of un-STATIC-ing the original and its callers. */
FUNCTION HcLinkEnd()
   HcLinkShutdown()
RETURN NIL

/* --- S75: the firewall check of the Slave --------------------------- */

/* S75: what the Windows Firewall looks like for the connection the Slave is
 * about to serve. Only two verdicts are worth a warning: the firewall is on and
 * nothing allows hwBro (it MAY block), or an enabled inbound block rule covers
 * hwBro (it WILL block). Everything else - firewall off, already allowed, or a
 * registry that cannot be read - stays silent (S6). */
#define HC_FW_NONE     0
#define HC_FW_ALLOW    1
#define HC_FW_NOALLOW  2
#define HC_FW_BLOCK    3
#define HC_FW_UNKNOWN  4

/* S75: the rules and the three profile switches. The keys and the `k=v` data
 * are the same in every language, which is why the probe reads the registry and
 * not `netsh`: the netsh and Get-NetFirewallRule outputs are localized. */
#define HC_FW_KEY_RULES   "HKLM\SYSTEM\CurrentControlSet\Services\SharedAccess\Parameters\FirewallPolicy\FirewallRules"
#define HC_FW_KEY_PRIVATE "HKLM\SYSTEM\CurrentControlSet\Services\SharedAccess\Parameters\FirewallPolicy\StandardProfile"
#define HC_FW_KEY_PUBLIC  "HKLM\SYSTEM\CurrentControlSet\Services\SharedAccess\Parameters\FirewallPolicy\PublicProfile"
#define HC_FW_KEY_DOMAIN  "HKLM\SYSTEM\CurrentControlSet\Services\SharedAccess\Parameters\FirewallPolicy\DomainProfile"

/* the full path of this executable: it is what the rules name */
FUNCTION HcFwExePath()
RETURN hb_ProgName()

/* the last segment of a path, for the program comparison of the rules */
STATIC FUNCTION HcFwFileOnly( cPath )
   LOCAL c := AllTrim( iif( ValType( cPath ) == "C", cPath, "" ) )
   LOCAL i := Max( Rat( "\", c ), Rat( "/", c ) )
RETURN iif( i > 0, SubStr( c, i + 1 ), c )

/* .T. for the truthy spellings of the registry (Active=TRUE) */
STATIC FUNCTION HcFwTrue( cVal )
   LOCAL c := Upper( AllTrim( iif( ValType( cVal ) == "C", cVal, "" ) ) )
RETURN c == "TRUE" .OR. c == "YES" .OR. c == "ON" .OR. c == "1"

/* a DWORD as `reg query` prints it ("0x1") or as a plain number ("1") */
FUNCTION HcFwNum( cVal )
   LOCAL c := AllTrim( iif( ValType( cVal ) == "C", cVal, "0" ) ), i, n := 0
   IF Upper( Left( c, 2 ) ) == "0X"
      c := SubStr( c, 3 )
      FOR i := 1 TO Len( c )
         n := n * 16 + Max( 0, At( Upper( SubStr( c, i, 1 ) ), "0123456789ABCDEF" ) - 1 )
      NEXT
      RETURN n
   ENDIF
RETURN Int( Val( c ) )

/* The data of every value of a `reg query` output: what follows the type token.
 * The type names (REG_SZ, REG_DWORD...) are NOT localized, while the headers of
 * the listing are, so nothing here looks at those. */
FUNCTION HcFwRegData( cText, cType )
   LOCAL aOut := {}, aLines, i, cLine, nAt
   IF ValType( cText ) != "C" .OR. Len( cText ) == 0
      RETURN aOut
   ENDIF
   aLines := hb_ATokens( cText, Chr( 10 ) )
   FOR i := 1 TO Len( aLines )
      cLine := StrTran( aLines[ i ], Chr( 13 ), "" )
      nAt := At( Upper( cType ), Upper( cLine ) )
      IF nAt > 0
         AAdd( aOut, AllTrim( SubStr( cLine, nAt + Len( cType ) ) ) )
      ENDIF
   NEXT
RETURN aOut

/* S75: the firewall profile is ON when the EnableFirewall DWORD of that key is
 * not 0. The whole key is read (W32RegDump), so the value is found BY NAME and
 * the other switches of the profile key cannot be taken for it. An empty answer
 * (the key could not be read) means "not on": the check then says nothing at
 * all, which is S6. */
FUNCTION HcFwProfileOn( cText )
   LOCAL aLines, aData, i, cL, cU, nAt
   IF ValType( cText ) != "C" .OR. Len( cText ) == 0
      RETURN .F.
   ENDIF
   aLines := hb_ATokens( cText, Chr( 10 ) )
   FOR i := 1 TO Len( aLines )
      cL  := StrTran( aLines[ i ], Chr( 13 ), "" )
      cU  := Upper( cL )
      nAt := At( "REG_DWORD", cU )
      IF nAt == 0
         LOOP
      ENDIF
      IF "ENABLEFIREWALL" $ Upper( Left( cL, nAt ) )
         RETURN HcFwNum( AllTrim( SubStr( cL, nAt + 9 ) ) ) != 0
      ENDIF
   NEXT
   /* a text that does not name its values (one single DWORD): that one is the
    * answer, which is the shape of the fixture the bank uses */
   aData := HcFwRegData( cText, "REG_DWORD" )
RETURN Len( aData ) > 0 .AND. HcFwNum( aData[ 1 ] ) != 0

/* the protocol of a registry rule (6 = TCP, 17 = UDP, 256 = any) in the same
 * vocabulary the manual netsh commands use */
STATIC FUNCTION HcFwProtoName( cVal )
   LOCAL c := Upper( AllTrim( iif( ValType( cVal ) == "C", cVal, "" ) ) )
   DO CASE
   CASE c == "6"
      RETURN "TCP"
   CASE c == "17"
      RETURN "UDP"
   CASE c == "256"
      RETURN "ANY"
   ENDCASE
RETURN c

/* One rule of the registry. The data is a `k=v` list - `v2.30|Action=Allow|
 * Active=TRUE|Dir=In|Protocol=6|LPort=443|App=...|Name=...` - so the keys are
 * read BY NAME: the order and the extra keys do not matter, and a repeated key
 * (LPort=80|LPort=443) is accumulated. A rule with no LPort covers every port,
 * which is why the port field starts empty.
 *
 *   { cAction, lActive, cDir, cProto, cPorts, cApp } */
FUNCTION HcFwRule( cData )
   LOCAL aF, i, cF, nEq, cKey, cVal
   LOCAL aR := { "", .F., "", "", "", "" }
   IF ValType( cData ) != "C"
      RETURN aR
   ENDIF
   aF := hb_ATokens( cData, "|" )
   FOR i := 1 TO Len( aF )
      cF  := AllTrim( aF[ i ] )
      nEq := At( "=", cF )
      IF nEq < 2
         LOOP
      ENDIF
      cKey := Upper( AllTrim( Left( cF, nEq - 1 ) ) )
      cVal := AllTrim( SubStr( cF, nEq + 1 ) )
      DO CASE
      CASE cKey == "ACTION"
         aR[ 1 ] := cVal
      CASE cKey == "ACTIVE"
         aR[ 2 ] := HcFwTrue( cVal )
      CASE cKey == "DIR"
         aR[ 3 ] := cVal
      CASE cKey == "PROTOCOL"
         aR[ 4 ] := HcFwProtoName( cVal )
      CASE cKey == "LPORT"
         aR[ 5 ] := aR[ 5 ] + iif( Len( aR[ 5 ] ) > 0, ",", "" ) + cVal
      CASE cKey == "APP"
         aR[ 6 ] := cVal
      ENDCASE
   NEXT
RETURN aR

/* every rule of a `reg query` of the FirewallRules key, already parsed */
FUNCTION HcFwRules( cText )
   LOCAL aD := HcFwRegData( cText, "REG_SZ" ), aOut := {}, i
   FOR i := 1 TO Len( aD )
      AAdd( aOut, HcFwRule( aD[ i ] ) )
   NEXT
RETURN aOut

/* S5 of commander-cleanup.md: the VISIBLE name of one rule (`Name=...` of its
 * data), or "" when it carries none. HcFwRule() does not keep it, because the
 * verdict of S75 does not need it: the removal does, because that name is the
 * only handle netsh accepts. */
FUNCTION HcFwVisName( cData )
   LOCAL aF, i, cF, nEq
   IF ValType( cData ) != "C"
      RETURN ""
   ENDIF
   aF := hb_ATokens( cData, "|" )
   FOR i := 1 TO Len( aF )
      cF  := AllTrim( aF[ i ] )
      nEq := At( "=", cF )
      IF nEq < 2
         LOOP
      ENDIF
      IF Upper( AllTrim( Left( cF, nEq - 1 ) ) ) == "NAME"
         RETURN AllTrim( SubStr( cF, nEq + 1 ) )
      ENDIF
   NEXT
RETURN ""

/* S5: the visible names of the rules of OURS that the dump carries. Empty means
 * "this program added none, or they are already gone", which is the question the
 * dialog asks BEFORE deciding whether its `Remove rule` button is reachable.
 * The comparison is exact (`==` on Upper()) because this build runs with SET
 * EXACT OFF, where `=` pads the left side (AGENTS.md trap 20). PURE. */
FUNCTION HcFwOwnRules( cText )
   LOCAL aD := HcFwRegData( cText, "REG_SZ" ), aOut := {}, i, c
   FOR i := 1 TO Len( aD )
      c := HcFwVisName( aD[ i ] )
      IF Len( c ) > 0 .AND. ;
         ( Upper( c ) == Upper( HcFwRuleName( .T. ) ) .OR. ;
           Upper( c ) == Upper( HcFwRuleName( .F. ) ) )
         AAdd( aOut, c )
      ENDIF
   NEXT
RETURN aOut

/* .T. when the rule's protocol can carry our connection (TCP or UDP) */
STATIC FUNCTION HcFwProtoOk( cProto )
   LOCAL c := Upper( AllTrim( iif( ValType( cProto ) == "C", cProto, "" ) ) )
RETURN c == "TCP" .OR. c == "UDP" .OR. c == "ANY" .OR. c == "6" .OR. c == "17" .OR. c == "256"

/* .T. when the `App=` of a rule covers our executable. A rule with no program
 * (`App=` empty, `*`, `Any`) covers every program; `App=System` does NOT, which
 * is why the comparison is by file name and not by prefix. */
FUNCTION HcFwProgMatch( cApp, cExe )
   LOCAL cA := Upper( AllTrim( iif( ValType( cApp ) == "C", cApp, "" ) ) )
   LOCAL cE := Upper( AllTrim( iif( ValType( cExe ) == "C", cExe, "" ) ) )
   IF cA == "" .OR. cA == "*" .OR. cA == "ANY"
      RETURN .T.
   ENDIF
   IF cE == ""
      RETURN .F.
   ENDIF
RETURN HcFwFileOnly( cA ) == HcFwFileOnly( cE )

/* S75: a local port specification of a rule - `Any`, `*`, one number, a list
 * with commas and ranges (`31000-31010`). An empty specification is "every
 * port", which is what the registry means when the rule has no LPort. */
FUNCTION HcFwPortInSpec( cSpec, nPort )
   LOCAL aPart, aRange, i, cOne, nFrom, nTo
   IF ValType( nPort ) != "N" .OR. ValType( cSpec ) != "C"
      RETURN .F.
   ENDIF
   aPart := hb_ATokens( cSpec, "," )
   IF Len( aPart ) == 0
      RETURN .T.
   ENDIF
   FOR i := 1 TO Len( aPart )
      cOne := Upper( AllTrim( aPart[ i ] ) )
      IF cOne == "" .OR. cOne == "ANY" .OR. cOne == "*"
         RETURN .T.
      ENDIF
      IF "-" $ cOne
         aRange := hb_ATokens( cOne, "-" )
         nFrom  := Int( Val( AllTrim( aRange[ 1 ] ) ) )
         nTo    := iif( Len( aRange ) > 1, Int( Val( AllTrim( aRange[ 2 ] ) ) ), nFrom )
         IF nPort >= nFrom .AND. nPort <= nTo
            RETURN .T.
         ENDIF
      ELSEIF Int( Val( cOne ) ) == nPort
         RETURN .T.
      ENDIF
   NEXT
RETURN .F.

/* S75: does that parsed rule cover an INBOUND connection of <cExe> on <nPort>?
 * Outbound rules, disabled rules, other protocols and other programs never do. */
FUNCTION HcFwRuleCovers( aRule, cExe, nPort )
   IF ! HB_ISARRAY( aRule ) .OR. Len( aRule ) < 6
      RETURN .F.
   ENDIF
   IF ! aRule[ 2 ]
      RETURN .F.
   ENDIF
   IF Upper( AllTrim( aRule[ 3 ] ) ) != "IN"
      RETURN .F.
   ENDIF
   IF ! HcFwProtoOk( aRule[ 4 ] )
      RETURN .F.
   ENDIF
   IF ! HcFwPortInSpec( aRule[ 5 ], nPort )
      RETURN .F.
   ENDIF
RETURN HcFwProgMatch( aRule[ 6 ], cExe )

/* S75: the verdict, pure. A block rule wins over any allow rule: that is how
 * Windows Firewall resolves them, so the order of the list cannot matter. */
FUNCTION HcFwVerdict( lOn, aRules, cExe, nPort )
   LOCAL i, aR, lAllow := .F.
   IF ! lOn
      RETURN HC_FW_NONE
   ENDIF
   IF ! HB_ISARRAY( aRules )
      RETURN HC_FW_UNKNOWN
   ENDIF
   FOR i := 1 TO Len( aRules )
      aR := aRules[ i ]
      IF ! HcFwRuleCovers( aR, cExe, nPort )
         LOOP
      ENDIF
      IF Upper( AllTrim( aR[ 1 ] ) ) == "BLOCK"
         RETURN HC_FW_BLOCK
      ENDIF
      lAllow := .T.
   NEXT
RETURN iif( lAllow, HC_FW_ALLOW, HC_FW_NOALLOW )

/* S75: what the user reads. It names the executable and the port, and it says
 * whether the connection MAY fail (no rule) or WILL fail (a block rule). The
 * lines are broken here on purpose: the message boxes of this program cut a
 * long line hard -in the MIDDLE of a word- instead of wrapping at a space
 * (measured on screen), so the breaks belong to the sentence, not to the box. */
FUNCTION HcFwVerdictText( nVerdict, nPort, cExe )
   LOCAL cName := HcFwFileOnly( cExe )
   LOCAL cPort := LTrim( Str( nPort ) )
   IF Len( cName ) == 0
      cName := "hwBro"
   ENDIF
   DO CASE
   CASE nVerdict == HC_FW_NOALLOW
      RETURN "Windows Firewall is on and no inbound rule allows " + cName + "." + hb_eol() + ;
             "This machine may refuse the connection of the" + hb_eol() + ;
             "Master on port " + cPort + "."
   CASE nVerdict == HC_FW_BLOCK
      /* "may not be able" and not "cannot": the rule covers a PROFILE, and this
       * program cannot know which profile is active without asking Windows for
       * the network category, so the sentence must not promise more than the
       * probe knows (measured: cancelling the alert of Windows leaves
       * Action=Block|Profile=Public, which only blocks on a public network). */
      RETURN "A Windows Firewall rule blocks the incoming" + hb_eol() + ;
             "connections of " + cName + ", so the Master may not" + hb_eol() + ;
             "be able to connect on port " + cPort + "."
   ENDCASE
RETURN ""

/* S75: the argument with which hwBro re-launches ITSELF, elevated, to add the
 * two rules. A GUI program has no console, so the elevated instance shows no
 * black window - which is the whole point of going through itself.
 *
 * NOTE for whoever touches Main(): that instance must do its work and LEAVE
 * before any screen, database or splash exists (see `HcFwArgsWanted()`), and it
 * must not call anything that opens a window. */
#define HC_FW_ARG     "--fw-add-rule"
/* S5 of odd/tasks/commander-cleanup.md: the same re-launch, to REMOVE those two
 * rules. One argument per job, so the elevated instance knows what it came for
 * and never does the opposite. */
#define HC_FW_DEL_ARG "--fw-del-rule"

/* the name of the rule the port adds. TWO rules, one per protocol: the TCP one
 * carries the listener and the UDP one the discovery (S5), and netsh has no
 * "both" protocol. */
FUNCTION HcFwRuleName( lTcp )
RETURN "hwBro Commander Link (" + iif( lTcp, "TCP", "UDP" ) + ")"
/* the `advfirewall` parameters that add (or replace) one of those rules */
FUNCTION HcFwAddParams( cExe, lTcp )
RETURN 'advfirewall firewall add rule name="' + HcFwRuleName( lTcp ) + ;
       '" dir=in action=allow program="' + iif( ValType( cExe ) == "C", cExe, "" ) + ;
       '" protocol=' + iif( lTcp, "TCP", "UDP" ) + ' profile=any enable=yes'

/* the same thing as a full command: it is what the elevated launch runs and
 * what the user gets in the clipboard when the elevation is refused (S4) */
FUNCTION HcFwAddCmd( cExe, lTcp )
RETURN "netsh " + HcFwAddParams( cExe, lTcp )

/* S5 of commander-cleanup.md: the `advfirewall` parameters that DELETE one of
 * those rules. netsh knows a rule by its VISIBLE name - the `Name=` of its data
 * -, never by the GUID-ish name of the registry VALUE: measured, with the value
 * name netsh answers that no rule matches the criteria and deletes nothing. */
FUNCTION HcFwDelParams( lTcp )
RETURN 'advfirewall firewall delete rule name="' + HcFwRuleName( lTcp ) + '"'

/* the same thing as a full command: what the elevated launch runs and what the
 * user gets in the clipboard when the elevation is refused */
FUNCTION HcFwDelCmd( lTcp )
RETURN "netsh " + HcFwDelParams( lTcp )

/* S75: one registry read, IN PROCESS (W32RegDump): no `reg query`, no child
 * process, so the check cannot flash a console window -and it costs ~1 ms
 * instead of ~300-. The text keeps the shape of a `reg query` listing, so the
 * parser and its assertions are the same. Answers "" when the key is not there
 * or bp_win32.c is not linked (headless bank). */
STATIC FUNCTION HcFwRegRead( cKey )
   LOCAL cOut := ""
#ifndef BP_HC_STANDALONE
   IF hb_IsFunction( "W32REGDUMP" )
      cOut := W32RegDump( cKey )
   ENDIF
#endif
RETURN iif( ValType( cOut ) == "C", cOut, "" )

/* S75: { lFirewallOn, aRules } of this machine. The rules are only read when some
 * profile is on: the silence of an unreadable registry is the intended answer
 * (S6), so nothing is ever warned on a guess. */
STATIC FUNCTION HcFwProbe()
   LOCAL lOn := .F., aRules := {}
   lOn := HcFwProfileOn( HcFwRegRead( HC_FW_KEY_PRIVATE ) )
   lOn := lOn .OR. HcFwProfileOn( HcFwRegRead( HC_FW_KEY_PUBLIC ) )
   lOn := lOn .OR. HcFwProfileOn( HcFwRegRead( HC_FW_KEY_DOMAIN ) )
   IF lOn
      aRules := HcFwRules( HcFwRegRead( HC_FW_KEY_RULES ) )
   ENDIF
RETURN { lOn, aRules }

/* S75: installs the two rules. The elevation is a RE-LAUNCH OF hwBro ITSELF
 * (HC_FW_ARG): this program is a GUI application, so the elevated instance has
 * no console at all, while `cmd.exe` and `netsh.exe` are console applications
 * and each one flashes a black window on screen. ONE elevation prompt, because
 * the elevated instance adds both rules. Then the probe is asked again: the
 * exit code is not the answer, because an elevated netsh reports 0 even when a
 * group policy refuses the change. */
STATIC FUNCTION HcFwAddRules( cExe, nPort )
   LOCAL aProbe
   LOCAL nErr := HcFwElevate( cExe, HC_FW_ARG )
   aProbe := HcFwProbe()
RETURN { HcFwVerdict( aProbe[ 1 ], aProbe[ 2 ], cExe, nPort ), iif( nErr < 0, HcFwElevErr(), 0 ) }

/* the two Windows-only primitives, guarded so this module still links in the
 * headless bank (T5), which has no bp_win32.c */
STATIC FUNCTION HcFwElevate( cFile, cParams )
   LOCAL nExit := -1
#ifndef BP_HC_STANDALONE
   IF hb_IsFunction( "W32ELEVATE" )
      nExit := W32Elevate( cFile, cParams )
   ENDIF
#endif
RETURN nExit

STATIC FUNCTION HcFwElevErr()
   LOCAL nErr := 0
#ifndef BP_HC_STANDALONE
   IF hb_IsFunction( "W32ELEVERR" )
      nErr := W32ElevErr()
   ENDIF
#endif
RETURN nErr

/* S75: runs a program with NO console window (CREATE_NO_WINDOW). It is how the
 * elevated instance calls netsh: that process already has the privilege, so no
 * shell takes part and nothing can flash on screen. */
STATIC FUNCTION HcFwRunHidden( cFile, cParams )
   LOCAL nExit := -1
#ifndef BP_HC_STANDALONE
   IF hb_IsFunction( "W32RUNHIDDEN" )
      nExit := W32RunHidden( cFile, cParams )
   ENDIF
#endif
RETURN nExit

/* S75/S5: what this process came to do, as "ADD", "DEL" or "" for a normal
 * run. It is read from the command line, not from a global, because the elevated
 * instance is a FRESH process of hwBro itself (AGENTS.md trap 56: Main() gets no
 * argument array in this build, so hb_argv() is the way in). */
FUNCTION HcFwArgsMode()
   LOCAL c
   IF hb_argc() < 2
      RETURN ""
   ENDIF
   c := Lower( AllTrim( hb_argv( 1 ) ) )
   DO CASE
   CASE c == HC_FW_ARG
      RETURN "ADD"
   CASE c == HC_FW_DEL_ARG
      RETURN "DEL"
   ENDCASE
RETURN ""

/* S75/S5: was this process started to touch the rules at all? */
FUNCTION HcFwArgsWanted()
RETURN Len( HcFwArgsMode() ) > 0

/* the ONE entry point of the elevated instance: it does the job it was launched
 * for and nothing else. Called from Main() BEFORE any screen, database or splash
 * exists. */
FUNCTION HcFwApplyArgs()
   IF HcFwArgsMode() == "DEL"
      RETURN HcFwDelRules()
   ENDIF
RETURN HcFwApplyRules()

/* S75: the whole work of the elevated instance - the two netsh commands, hidden,
 * and nothing else. Called from Main() BEFORE any screen, database or splash
 * exists, and the caller leaves with the answer. Both rules are reported: the
 * caller only trusts the code as a hint, because the verdict is what counts. */
FUNCTION HcFwApplyRules()
   LOCAL cNetsh := hb_GetEnv( "SystemRoot" ) + "\System32\netsh.exe"
   LOCAL cExe   := HcFwExePath()
   LOCAL lTcp   := .F., lUdp := .F.
   lTcp := HcFwRunHidden( cNetsh, HcFwAddParams( cExe, .T. ) ) == 0
   lUdp := HcFwRunHidden( cNetsh, HcFwAddParams( cExe, .F. ) ) == 0
RETURN lTcp .AND. lUdp

/* S5 of commander-cleanup.md: the elevated instance that REMOVES the two rules.
 * Same shape as the add - netsh run hidden, no shell taking part - and the answer
 * is a hint, because netsh also returns non-zero when that name is not there,
 * which is not a failure of what the user asked for. The caller believes the
 * PROBE of the registry instead. */
FUNCTION HcFwDelRules()
   LOCAL cNetsh := hb_GetEnv( "SystemRoot" ) + "\System32\netsh.exe"
   LOCAL lTcp   := .F., lUdp := .F.
   lTcp := HcFwRunHidden( cNetsh, HcFwDelParams( .T. ) ) == 0
   lUdp := HcFwRunHidden( cNetsh, HcFwDelParams( .F. ) ) == 0
RETURN lTcp .OR. lUdp

/* the clipboard, where bp_win32.c is linked (S4: the commands of the fallback) */
STATIC FUNCTION HcFwClipPut( cText )
   LOCAL lOk := .F.
#ifndef BP_HC_STANDALONE
   IF hb_IsFunction( "W32CLIPPUT" )
      lOk := W32ClipPut( cText )
   ENDIF
#endif
RETURN lOk

/* S75: the warning of the Slave. Called ONCE, right after `Link` started the
 * listener in Slave mode, so the Slave is serving before this runs: refusing the
 * rule never stops it (S5). Nothing is read and nothing is asked unless the
 * firewall is really in the way (S1/S6). */
STATIC PROCEDURE HcFwSlaveWarn( nPort )
   LOCAL cExe := HcFwExePath(), aProbe, aDone, nVerdict, cMsg, cCmds
   aProbe   := HcFwProbe()
   nVerdict := HcFwVerdict( aProbe[ 1 ], aProbe[ 2 ], cExe, nPort )
   IF nVerdict != HC_FW_NOALLOW .AND. nVerdict != HC_FW_BLOCK
      RETURN
   ENDIF
   cMsg := HcFwVerdictText( nVerdict, nPort, cExe ) + hb_eol() + hb_eol() + ;
           "Add the inbound rule that allows it?"
   IF ! UiConfirm( cMsg, "Commander Link" )
      RETURN
   ENDIF
   aDone    := HcFwAddRules( cExe, nPort )
   nVerdict := aDone[ 1 ]
   IF nVerdict == HC_FW_ALLOW .OR. nVerdict == HC_FW_NONE
      UiInfo( "Firewall rule added." + hb_eol() + ;
              "The Master can connect to this machine on port " + ;
              LTrim( Str( nPort ) ) + ".", "Commander Link" )
      RETURN
   ENDIF
   /* UAC refused, netsh failed, or a block rule still applies: the exact
    * commands travel in the clipboard so they can be pasted in an elevated
    * prompt, and they are shown in a window when there is no clipboard */
   cCmds := HcFwAddCmd( cExe, .T. ) + hb_eol() + HcFwAddCmd( cExe, .F. )
   IF nVerdict == HC_FW_BLOCK
      UiErr( "A block rule still applies after adding the rule:" + hb_eol() + ;
             "remove it in Windows Firewall with Advanced" + hb_eol() + ;
             "Security.", "Commander Link" )
   ELSEIF aDone[ 2 ] == 1223
      /* ERROR_CANCELLED: the user said NO to the elevation prompt */
      HcFwFallback( cCmds, "The rule was not added: the elevation was cancelled." )
   ELSE
      HcFwFallback( cCmds, "The rule could not be added." )
   ENDIF
RETURN

/* S4: the manual way out. The commands go to the clipboard; without a clipboard
 * they are written to a .cmd in the temp directory and opened in Notepad, so a
 * ~150 column command is never cut to the width of a window. */
STATIC PROCEDURE HcFwFallback( cCmds, cWhy, cLast )
   LOCAL cFile := hb_DirTemp() + "hwbro-firewall-" + AllTrim( Str( Int( Seconds() ) ) ) + ".cmd"
   LOCAL nOut
   /* the LAST resort differs between adding and removing a rule: telling somebody
    * who wanted a rule GONE to "add an inbound allow rule" was the wrong advice
    * (found by the verification of 86aac70) */
   IF ValType( cLast ) != "C" .OR. Len( cLast ) == 0
      cLast := "Add an inbound allow rule for " + HcFwFileOnly( HcFwExePath() ) + ;
               hb_eol() + "in Windows Firewall with Advanced Security."
   ENDIF
   IF HcFwClipPut( cCmds )
      UiErr( cWhy + hb_eol() + ;
             "The two netsh commands are in the clipboard:" + hb_eol() + ;
             "run them in an elevated Command Prompt.", "Commander Link" )
      RETURN
   ENDIF
   nOut := FCreate( cFile )
   IF nOut >= 0
      FWrite( nOut, "@ECHO OFF" + hb_eol() + ;
                    "REM right click > Run as administrator" + hb_eol() + ;
                    cCmds + hb_eol() + "PAUSE" + hb_eol() )
      FClose( nOut )
      hb_run( 'notepad "' + cFile + '"' )
      UiInfo( cWhy + hb_eol() + ;
              "The commands are in:" + hb_eol() + ;
              cFile + hb_eol() + ;
              "Run that file as administrator.", "Commander Link" )
      RETURN
   ENDIF
   UiErr( cWhy + hb_eol() + cLast, "Commander Link" )
RETURN

/* S5 of commander-cleanup.md: the `Remove rule` button of the dialog. It removes
 * the two inbound rules the program added for the Link, by their visible names,
 * through the same elevated re-launch as the add (a GUI instance, so no console
 * ever appears), and then it BELIEVES THE PROBE: an elevated netsh reports 0 even
 * when a group policy refuses the change. Answers the list of OUR rules still in
 * force, so the dialog knows whether the button is still reachable. */
STATIC FUNCTION HcFwRemoveRules()
   LOCAL cExe := HcFwExePath(), nRet, aLeft, cCmds, cDump
   IF ! UiConfirm( "Remove the two inbound firewall rules that hwBro added" + ;
                   hb_eol() + "for the Commander Link (TCP and UDP)?", "Commander Link" )
      RETURN HcFwOwnRules( HcFwRegRead( HC_FW_KEY_RULES ) )
   ENDIF
   nRet  := HcFwElevate( cExe, HC_FW_DEL_ARG )
   cDump := HcFwRegRead( HC_FW_KEY_RULES )
   aLeft := HcFwOwnRules( cDump )
   IF Len( aLeft ) == 0
      /* an EMPTY dump is not "there is nothing left": it is a registry that could
       * not be read, and claiming the rule was removed would be a lie. The button
       * is only reachable with a dump that DID carry our rules, so this is the
       * registry going away between the two reads - rare, and still not a licence
       * to say it worked. */
      IF Len( cDump ) == 0
         UiErr( "The firewall rules could not be checked:" + hb_eol() + ;
                "read them in Windows Firewall with Advanced Security.", "Commander Link" )
      ELSE
         UiInfo( "Firewall rule removed." + hb_eol() + ;
                 "Windows will ask again the next time the Slave needs it.", ;
                 "Commander Link" )
      ENDIF
      RETURN aLeft
   ENDIF
   cCmds := HcFwDelCmd( .T. ) + hb_eol() + HcFwDelCmd( .F. )
   IF nRet < 0 .AND. HcFwElevErr() == 1223
      /* ERROR_CANCELLED: the elevation prompt was refused */
      HcFwFallback( cCmds, "The rule was not removed: the elevation was cancelled.", ;
                    "Remove the two hwBro Commander Link rules by hand" + hb_eol() + ;
                    "in Windows Firewall with Advanced Security." )
   ELSE
      HcFwFallback( cCmds, "The rule could not be removed: " + ;
                    LTrim( Str( Len( aLeft ) ) ) + " of ours are still in place.", ;
                    "Remove the two hwBro Commander Link rules by hand" + hb_eol() + ;
                    "in Windows Firewall with Advanced Security." )
   ENDIF
RETURN aLeft

/* --- S1/S5/S8: the Commander Link dialog ---------------------------- */

/* width of the `Address:` field of the dialog. It is the single source of the
 * column math of the connection fields (HcLinkCols()), so the paint, the caret
 * and the editor can never disagree. */
STATIC FUNCTION HcLinkAddrW( nR )
RETURN Max( 10, Min( 22, nR - 52 ) )

/* S1: the columns of the connection fields, relative to the left of the box:
 *   { address label, address field, address width, port label, port field,
 *     mode column }
 * `Port:` sits to the RIGHT of `Address` (asked by the user) and the `Mode`
 * column is pushed right of both, so the two of them can never overlap. */
STATIC FUNCTION HcLinkCols( nR )
   LOCAL nAw := HcLinkAddrW( nR )
   LOCAL nPortL := 12 + nAw + 1
   LOCAL nMode := Max( nPortL + 13, nR - 20 )
   IF nMode > Max( 0, nR - 13 )
      nMode := Max( 0, nR - 13 )
   ENDIF
RETURN { 2, 12, nAw, nPortL, nPortL + 5, nMode }

/* "Local: NAME:31000" once the Slave is serving, "" otherwise: it is what the
 * user has to type on the other machine (S8). The address line stays empty on
 * purpose - this port has no helper that asks Windows for the local IP. */
STATIC FUNCTION HcLinkLocalText()
   LOCAL cName := AllTrim( hb_GetEnv( "COMPUTERNAME" ) )
   IF hb_IsNIL( s_hHcLinkListen )
      RETURN ""
   ENDIF
   IF Len( cName ) == 0
      cName := "this machine"
   ENDIF
RETURN "Local: " + cName + ":" + LTrim( Str( s_nHcLinkPort ) )

/* S1: rows of the buttons of the dialog, RELATIVE to the top of its box
 * (1 = `Link`, 2 = `Remove rule` -S5 of commander-cleanup.md-, 3 = `Cancel`,
 * anything else = 0). They are one per row with a blank row between them, so no
 * two are ever side by side. PURE: the paint and the headless bank read the same
 * number (AGENTS.md section 6). */
FUNCTION HcLinkBtnRow( nN )
   DO CASE
   CASE nN == 1
      RETURN HC_LK_R_BTN1
   CASE nN == 2
      RETURN HC_LK_R_BTN2
   CASE nN == 3
      RETURN HC_LK_R_BTN3
   ENDCASE
RETURN 0

/* height MINUS ONE of the box: the last row the dialog paints (the help line
 * under the buttons) plus one row of inner padding. The dialog uses it as the
 * box height, so growing the content grows the frame instead of spilling out
 * of it (AGENTS.md section 4.b). PURE. */
FUNCTION HcLinkBoxH()
RETURN HC_LK_R_HELP + 1

/* S8: the port the dialog edits, in BOTH modes. An empty, impossible or
 * non-numeric field falls back to the default port instead of 0: a broadcast
 * to port 0 is exactly the "Discover finds nothing" of commander-link.md. */
FUNCTION HcLinkPortVal( cPort )
   LOCAL c := iif( ValType( cPort ) == "C", AllTrim( cPort ), "" ), n
   n := Val( c )
   IF Len( c ) == 0 .OR. n < 1 .OR. n > 65535
      RETURN HC_LINK_PORT
   ENDIF
RETURN Int( n )

/* S5/S8: the address the dialog hands to the client. The typed `host:port`
 * wins; a bare host takes <nPort> (the number the `Port:` field already
 * resolved), so what the dialog shows is always what it uses. PURE. */
FUNCTION HcLinkFullAddr( cAddr, nPort )
   LOCAL c := iif( ValType( cAddr ) == "C", AllTrim( cAddr ), "" )
   IF ValType( nPort ) != "N" .OR. nPort < 1 .OR. nPort > 65535
      nPort := HC_LINK_PORT
   ENDIF
   IF Len( c ) == 0
      RETURN c
   ENDIF
   IF At( ":", c ) == 0
      c := c + ":" + LTrim( Str( Int( nPort ) ) )
   ENDIF
RETURN c

/* next / previous focus slot of the dialog. `Discover` only exists while this
 * machine is the Master (S4/S7) and the two `Export:` radios only while it is
 * the Slave (they choose what that Slave exports, S14), so the focus order skips
 * whichever pair is disabled, exactly like the disabled buttons of the panels.
 * S5 of commander-cleanup.md: `Remove rule` joins the walk only when there is a
 * rule of ours to remove (lFwOn); with its default of .F. the order is the one
 * it always was, which is what the older assertions pin. */
FUNCTION HcLinkFocusStep( nFoc, nDir, lSlave, lFwOn )
   LOCAL n := nFoc, i
   IF ValType( nDir ) != "N" .OR. nDir == 0
      nDir := 1
   ENDIF
   lSlave := ( lSlave == .T. )
   lFwOn  := ( lFwOn == .T. )
   /* one slot per assignment of HC_LK_*: the walk always finds a live one */
   FOR i := 1 TO HC_LK_CANCEL
      n := n + nDir
      IF n > HC_LK_CANCEL
         n := HC_LK_ADDR
      ENDIF
      IF n < HC_LK_ADDR
         n := HC_LK_CANCEL
      ENDIF
      IF lSlave .AND. n == HC_LK_DISC
         /* the Master's Discover is dimmed in Slave mode */
      ELSEIF ! lSlave .AND. ( n == HC_LK_DISK .OR. n == HC_LK_FOLDER )
         /* the Slave's Export radios are dimmed in Master mode */
      ELSEIF ! lFwOn .AND. n == HC_LK_FWDEL
         /* `Remove rule` with nothing to remove */
      ELSE
         RETURN n
      ENDIF
   NEXT
RETURN nFoc

/* one radio of the `Mode` column. It registers its span in the shared control
 * table while it is painted, so the click and the paint cannot disagree
 * (AGENTS.md section 6). */
STATIC PROCEDURE HcLinkRadio( nRow, nCol, cLabel, lChecked, lFocus, cKind )
   LOCAL c := iif( lChecked, "(o) ", "( ) " ) + cLabel
   SetColor( iif( lFocus, UI_C_LISTSEL, UI_C_BOX ) )
   @ nRow, nCol SAY c
   HcSyncCtlAdd( nRow, nCol, Len( c ), "LNK", cKind )
   SetColor( UI_C_BOX )
RETURN

/* one button of the row at the bottom. An EMPTY <cKind> is a DISABLED button:
 * it is painted dimmed and it is not registered, so a click on it does nothing
 * and the focus never stops there.
 *
 * The focused button uses the SAME yellow as the fields and the radios, so there
 * is exactly one "you are here" colour in the dialog; the unfocused one is the
 * white-on-dark-grey of UiConfirmBtn(), because the brown of UI_C_BOXSEL read as
 * a second selection (reported: the whole form looked shaded). */
STATIC PROCEDURE HcLinkButton( nRow, nCol, cLabel, lFocus, cKind )
   LOCAL c := "[ " + cLabel + " ]"
   IF Len( cKind ) == 0
      SetColor( UI_C_BOXDIM )
   ELSE
      SetColor( iif( lFocus, UI_C_LISTSEL, UI_C_MENUKEY ) )
   ENDIF
   @ nRow, nCol SAY c
   IF Len( cKind ) > 0
      HcSyncCtlAdd( nRow, nCol, Len( c ), "LNK", cKind )
   ENDIF
   SetColor( UI_C_BOX )
RETURN

/* the whole box of the dialog, in ONE paint block owned by the caller. Every
 * control is registered here (HcSyncCtlAdd) as it is drawn. <lWhole> is what
 * this Slave exports (S14: `Whole disk` is the default); the two radios are
 * painted dimmed and left OUT of the control table in Master mode, where they
 * mean nothing, exactly like `Discover` in Slave mode. */
STATIC PROCEDURE HcLinkPaint( nT, nL, nR, nB, cAddr, cPort, cMode, nFoc, lWhole, lFwOn )
   LOCAL lSlave := ( cMode == "SLAVE" ), nCol
   LOCAL aC := HcLinkCols( nR ), nAw := aC[ 3 ], nPortL := aC[ 4 ], nPortF := aC[ 5 ]
   LOCAL nMode := aC[ 6 ]
   UiShadow( nT, nL, nT + nB, nL + nR )
   UiFillBox( nT, nL, nT + nB, nL + nR, UI_C_BOX )
   UiFrame( nT, nL, nT + nB, nL + nR, UI_C_BOX, .T. )
   SetColor( UI_C_CHIP )
   @ nT, nL + 2 SAY " Commander Link "
   /* left column: the connection (S5) */
   SetColor( UI_C_MENUBAR )
   @ nT + HC_LK_R_HDR, nL + 2 SAY PadR( "Connection", 30 )
   SetColor( UI_C_BOX )
   @ nT + HC_LK_R_ADDR, nL + aC[ 1 ] SAY "Address:"
   /* the focus of a field is the SAME yellow as the focus of a radio or a button
    * (UI_C_LISTSEL, the "you are here" colour of the whole program, and the one
    * the browser uses for the cell being edited). Before, the focused field was
    * UI_C_INPUT -a pale grey- while the others were green: the pale one looked
    * SHADED, as if it were disabled, and the user could not tell where the focus
    * was (reported). */
   SetColor( iif( nFoc == HC_LK_ADDR, UI_C_LISTSEL, UI_C_DLGFIELD ) )
   @ nT + HC_LK_R_ADDR, nL + aC[ 2 ] SAY PadR( Left( cAddr, nAw ), nAw )
   HcSyncCtlAdd( nT + HC_LK_R_ADDR, nL + aC[ 1 ], nAw + 10, "LNK", "ADDR" )
   /* S4/S7: `Discover` only makes sense while this machine is the MASTER. In
    * Slave mode it is painted disabled (dimmed) and it is NOT registered in the
    * control table, so neither the mouse nor the focus order can reach it. */
   HcLinkButton( nT + HC_LK_R_DISC, nL + 2, "Discover", nFoc == HC_LK_DISC, ;
                 iif( lSlave, "", "DISC" ) )
   /* S14: what this Slave EXPORTS. `Whole disk` is the default, so the Master
    * may navigate the entire filesystem of this machine; `This panel's folder`
    * narrows the scope to the folder of the active panel when `Link` runs. In
    * Master mode these two mean nothing, so they are dimmed and unregistered. */
   SetColor( iif( lSlave, UI_C_MENUBAR, UI_C_BOXDIM ) )
   @ nT + HC_LK_R_EXP, nL + 2 SAY PadR( "Export", 30 )
   HcLinkRadio( nT + HC_LK_R_EXPD, nL + 2, "Whole disk", lWhole, nFoc == HC_LK_DISK, ;
                iif( lSlave, "EXPDISK", "" ) )
   HcLinkRadio( nT + HC_LK_R_EXPF, nL + 2, "This panel's folder", ! lWhole, ;
                nFoc == HC_LK_FOLDER, iif( lSlave, "EXPDIR", "" ) )
   /* right column: the mode (S1, S8, S9) */
   SetColor( UI_C_MENUBAR )
   @ nT + HC_LK_R_HDR, nL + nMode SAY PadR( "Mode", 20 )
   HcLinkRadio( nT + HC_LK_R_ADDR, nL + nMode, "Master", ! lSlave, nFoc == HC_LK_MASTER, "MASTER" )
   HcLinkRadio( nT + HC_LK_R_DISC, nL + nMode, "Slave", lSlave, nFoc == HC_LK_SLAVE, "SLAVE" )
   /* S8: the port lives on the SAME row as the address, to its RIGHT (user
    * request), and is visible and editable in BOTH modes so the discovery of the
    * Master and the listener of the Slave cannot disagree. */
   SetColor( UI_C_BOX )
   @ nT + HC_LK_R_ADDR, nL + nPortL SAY "Port:"
   SetColor( iif( nFoc == HC_LK_PORT, UI_C_LISTSEL, UI_C_DLGFIELD ) )
   @ nT + HC_LK_R_ADDR, nL + nPortF SAY PadR( Left( cPort, 7 ), 7 )
   HcSyncCtlAdd( nT + HC_LK_R_ADDR, nL + nPortL, 12, "LNK", "PORT" )
   /* what to type on the other machine, once the Slave is serving */
   SetColor( UI_C_CHIP )
   @ nT + HC_LK_R_LOCAL, nL + 2 SAY PadR( HcLinkLocalText(), Max( 0, nR - 4 ) )
   /* S1: the buttons are STACKED, one per row, with a blank row between them.
    * S5: `Remove rule` sits between them and is painted DISABLED - dimmed and
    * unregistered, so neither the mouse nor the focus order reaches it - while
    * this machine has no rule of ours to remove, exactly like `Discover` in
    * Slave mode. */
   HcLinkButton( nT + HC_LK_R_BTN1, nL + 2, "Link",   nFoc == HC_LK_LINK,   "LINK" )
   HcLinkButton( nT + HC_LK_R_BTN2, nL + 2, "Remove rule", nFoc == HC_LK_FWDEL, ;
                 iif( lFwOn, "FWDEL", "" ) )
   HcLinkButton( nT + HC_LK_R_BTN3, nL + 2, "Cancel", nFoc == HC_LK_CANCEL, "CANCEL" )
   nCol := HcHintKey( nT + HC_LK_R_HINT, nL + 2, "Tab", "Next" )
   nCol := HcHintKey( nT + HC_LK_R_HINT, nCol, "Enter", "Do" )
   nCol := HcHintKey( nT + HC_LK_R_HINT, nCol, "Esc", "Cancel" )
   SetColor( UI_C_HINT )
   /* the sentence has to describe what the two fields DO: `Address` is the host
    * and `Port` the port (Discover fills both). Before it said "host:port of the
    * Slave" while there was a Port field, which contradicted itself (reported). */
   @ nT + HC_LK_R_HELP, nL + 2 SAY PadR( "Address: host or IP of the Slave.  Port: the port it serves.", ;
                                        Max( 0, nR - 4 ) )
   SetColor( UI_C_DESKTOP )
RETURN

/* S1: WHERE THE CURSOR IS has to be visible, which is what the user reported
 * missing ("el cursor no se ve donde esta posicionado"). The system caret does
 * not solve it here: measured with two captures 400 ms apart and the window in
 * front, SetCursor( 1 ) + DevPos() paint ZERO pixels of difference in this
 * driver. So the cursor is PAINTED like everywhere else in hwBro: the cell under
 * it is drawn with the two colours of the field SWAPPED (UiSwapColor()), exactly
 * the block that UiLineEdit() and the browser use. It is called AFTER
 * UiPaintEnd(), on top of the field that block just painted. */
STATIC PROCEDURE HcLinkCursor( nT, nL, nR, nFoc, cAddr, cPort )
   LOCAL aC := HcLinkCols( nR ), nAw := aC[ 3 ], cBody
   LOCAL nPos, nCol, c := ""
   SetCursor( 0 )
   DO CASE
   CASE nFoc == HC_LK_ADDR
      cBody := UI_C_LISTSEL
      nPos  := Min( Len( AllTrim( cAddr ) ) + 1, nAw )
      c     := SubStr( PadR( cAddr, nAw ), nPos, 1 )
      nCol  := nL + aC[ 2 ] + nPos - 1
   CASE nFoc == HC_LK_PORT
      cBody := UI_C_LISTSEL
      nPos  := Min( Len( AllTrim( cPort ) ) + 1, 7 )
      c     := SubStr( PadR( cPort, 7 ), nPos, 1 )
      nCol  := nL + aC[ 5 ] + nPos - 1
   OTHERWISE
      /* a radio or a button: its focus is the colour, a block would be noise */
      RETURN
   ENDCASE
   IF Len( c ) == 0
      c := " "
   ENDIF
   SetColor( UiSwapColor( cBody ) )
   @ nT + HC_LK_R_ADDR, nCol SAY c
   SetColor( UI_C_BOX )
RETURN

/* S4: broadcasts the discovery for the Slave of the LAN and lets the user pick
 * one. <nPort> is the port of the `Port:` field of the dialog (the same one the
 * Slave listens on); the address typed in the field keeps winning when it
 * already carries a `host:port`. Answers the address to use, or <cAddr>
 * untouched when there is nothing to choose. */
STATIC FUNCTION HcLinkDiscover( cAddr, nPort )
   LOCAL aFound, aList := {}, i, n
   aFound := HcLkDiscover( HcLinkPortVal( nPort ) )
   IF ! HB_ISARRAY( aFound ) .OR. Len( aFound ) == 0
      UiErr( "No Commander Link slave answered on this LAN.", "Commander Link" )
      RETURN cAddr
   ENDIF
   FOR i := 1 TO Len( aFound )
      AAdd( aList, PadR( aFound[ i ][ 1 ], 20 ) + "  " + aFound[ i ][ 2 ] + ":" + ;
                  LTrim( Str( aFound[ i ][ 3 ] ) ) )
   NEXT
   n := UiPick( aList, "Commander Link - slaves found", 1 )
   IF n < 1 .OR. n > Len( aFound )
      RETURN cAddr
   ENDIF
RETURN aFound[ n ][ 2 ] + ":" + LTrim( Str( aFound[ n ][ 3 ] ) )

/* S1: the dialog of the Commander Link, faithful to the one of the Norton
 * Commander (two columns, radio buttons and a button row) but over the LAN: the
 * left column is the ADDRESS of the Slave (typed as host:port, or picked from
 * the discovery) and the right one is the MODE of this machine.
 *
 * Modal, with the structure of HcZipDialog(): cursor hidden BEFORE the first
 * paint block, SaveScreen/RestScreen, ONE UiPaintBegin()/UiPaintEnd() per
 * change, a 0.05 s wait so the mouse is polled, and the shared control table
 * (HcSyncCtlReset/HcSyncCtlAdd/HcSyncCtlAt) resolves the clicks. Esc cancels; a
 * failure is reported with UiErr() and leaves the dialog open. */
STATIC PROCEDURE HcLinkDialog()
   LOCAL cAddr := s_cHcLinkAddr, cPort := LTrim( Str( s_nHcLinkPortDlg ) )
   LOCAL cMode := iif( hb_IsNIL( s_hHcLinkListen ), "MASTER", "SLAVE" )
   LOCAL nFoc := HC_LK_ADDR, lPaint := .T., lDone := .F., lSlave, nKey
   LOCAL nT, nL, nR, nB, cSave, cOldCur, aCtl, cKind, xDummy, nAw
   LOCAL cErr, aAddr, aOpen, nPort, cRoot, aP, lWhole := s_lHcLinkExportDisk
   /* S5 of commander-cleanup.md: is there a rule of OURS to remove? It is asked
    * ONCE here and again after each removal, never on every repaint: the
    * registry read is cheap but a full redraw happens on every arrow. */
   LOCAL lFwOwn := .F.

   nR := Min( 70, Max( 46, MaxCol() + 1 - 8 ) )
   /* the box is as tall as its LAST painted row: the buttons grew (stacked),
    * so the height comes from HcLinkBoxH() instead of a literal */
   nB := HcLinkBoxH()
   nT := UiFitRow( UiCenterRow( nB + 1 ), nB + 1 )
   nL := UiFitCol( UiCenterCol( nR ), nR + 1 )
   nAw := HcLinkAddrW( nR )
   lFwOwn := Len( HcFwOwnRules( HcFwRegRead( HC_FW_KEY_RULES ) ) ) > 0
   cOldCur := SetCursor( 0 )
   cSave := SaveScreen( nT, nL, nT + nB + 1, Min( nL + nR + 1, MaxCol() ) )
   DO WHILE ! lDone
      lSlave := ( cMode == "SLAVE" )
      IF lPaint
         UiPaintBegin()
         HcSyncCtlReset()            /* the clickable controls, rebuilt */
         HcLinkPaint( nT, nL, nR, nB, cAddr, cPort, cMode, nFoc, lWhole, lFwOwn )
         UiPaintEnd()
         /* the cursor goes AFTER the paint block, which restores the cursor */
         HcLinkCursor( nT, nL, nR, nFoc, cAddr, cPort )
         lPaint := .F.
      ENDIF
      nKey := Inkey( 0.05 )
      /* S9: the Slave is served from HERE too. This dialog is a loop of its
       * own, and `Link` in Slave mode leaves it OPEN (it is the only way to
       * read the `Local:` line). Without this call the listener and the UDP
       * discovery of this machine answer NOTHING while the dialog is up, so the
       * other machine's `Discover` says there is no slave - which is exactly
       * what was reported. */
      HcLinkServe()
      /* right-click-esc (S1/S2/S7): a plain right click cancels the dialog and
       * stops the Slave, exactly as Esc does in this screen */
      IF nKey == 0 .AND. HcMouseRightClick()
         nKey := K_ESC
      ENDIF
      IF nKey == 0
         aCtl   := HcSyncCtlAt( HcMouseClickRow(), HcMouseClickCol() )
         xDummy := HcMouseClickDbl()  /* read once: it must not leak */
         xDummy := HcMouseWheel()     /* nothing to scroll, but consumed */
         IF hb_IsNIL( aCtl )
            LOOP                      /* a click outside the box changes nothing */
         ENDIF
         cKind := aCtl[ 5 ]
         DO CASE
         CASE cKind == "ADDR"
            /* one click focuses the field, the click on the FOCUSED field
             * enters its editor, like the fields of the zip dialog */
            IF nFoc == HC_LK_ADDR
               nKey := K_ENTER
            ELSE
               nFoc := HC_LK_ADDR
               lPaint := .T.
            ENDIF
         CASE cKind == "DISC"
            nFoc := HC_LK_DISC
            nKey := K_ENTER
         CASE cKind == "MASTER"
            IF lSlave
               HcLinkSlaveStop()      /* S9: leaving Slave mode closes it */
               cMode := "MASTER"
            ENDIF
            nFoc := HC_LK_MASTER
            lPaint := .T.
         CASE cKind == "SLAVE"
            cMode := "SLAVE"
            nFoc := HC_LK_SLAVE
            lPaint := .T.
         CASE cKind == "PORT"
            IF nFoc == HC_LK_PORT
               nKey := K_ENTER
            ELSE
               nFoc := HC_LK_PORT
               lPaint := .T.
            ENDIF
         CASE cKind == "EXPDISK"
            lWhole := .T.
            nFoc := HC_LK_DISK
            lPaint := .T.
         CASE cKind == "EXPDIR"
            lWhole := .F.
            nFoc := HC_LK_FOLDER
            lPaint := .T.
         CASE cKind == "LINK"
            nFoc := HC_LK_LINK
            nKey := K_ENTER
         CASE cKind == "FWDEL"
            nFoc := HC_LK_FWDEL
            nKey := K_ENTER
         CASE cKind == "CANCEL"
            nFoc := HC_LK_CANCEL
            nKey := K_ENTER
         ENDCASE
      ENDIF
      IF nKey == 0
         LOOP
      ENDIF

      DO CASE
      CASE nKey == K_ESC
         lDone := .T.
      CASE nKey == K_TAB .OR. nKey == K_DOWN
         nFoc := HcLinkFocusStep( nFoc, 1, lSlave, lFwOwn )
         lPaint := .T.
      CASE nKey == K_SH_TAB .OR. nKey == K_UP
         nFoc := HcLinkFocusStep( nFoc, -1, lSlave, lFwOwn )
         lPaint := .T.
      CASE ( nFoc == HC_LK_MASTER .OR. nFoc == HC_LK_SLAVE ) .AND. ;
           ( nKey == K_SPACE .OR. nKey == K_LEFT .OR. nKey == K_RIGHT )
         IF lSlave
            HcLinkSlaveStop()
            cMode := "MASTER"
            nFoc := HC_LK_MASTER
         ELSE
            cMode := "SLAVE"
            nFoc := HC_LK_SLAVE
         ENDIF
         lPaint := .T.
      CASE nFoc == HC_LK_ADDR .AND. nKey == K_ENTER
         /* the editor uses the same yellow as the focused field, so entering the
          * field does not change its look under the user's hands */
         cAddr := UiLineEdit( nT + HC_LK_R_ADDR, nL + HcLinkCols( nR )[ 2 ], ;
                              HcLinkAddrW( nR ), cAddr, .F., UI_C_LISTSEL )
         IF LastKey() == K_ESC
            lDone := .T.
         ENDIF
         nFoc := HC_LK_DISC
         lPaint := .T.
      CASE nFoc == HC_LK_PORT .AND. nKey == K_ENTER
         cPort := UiLineEdit( nT + HC_LK_R_ADDR, nL + HcLinkCols( nR )[ 5 ], 7, cPort, .T., UI_C_LISTSEL )
         IF LastKey() == K_ESC
            lDone := .T.
         ENDIF
         lPaint := .T.
      /* S14: the two `Export:` radios of the Slave. Space and the arrows toggle
       * them, exactly like the radios of the `Mode` column. In Master mode the
       * pair is dimmed, unregistered and skipped by the focus order, so these
       * cases cannot be reached then. */
      CASE ( nFoc == HC_LK_DISK .OR. nFoc == HC_LK_FOLDER ) .AND. ;
           ( nKey == K_SPACE .OR. nKey == K_LEFT .OR. nKey == K_RIGHT )
         lWhole := ( nFoc == HC_LK_DISK )
         IF nKey == K_LEFT .OR. nKey == K_RIGHT
            lWhole := ! lWhole
         ENDIF
         nFoc := iif( lWhole, HC_LK_DISK, HC_LK_FOLDER )
         lPaint := .T.
      /* S4/S7: `Discover` only acts as the Master; in Slave mode the button is
       * disabled, its slot is skipped by the focus order and this case cannot
       * be reached */
      CASE ! lSlave .AND. nFoc == HC_LK_DISC .AND. ( nKey == K_ENTER .OR. nKey == K_SPACE )
         cAddr := HcLinkDiscover( cAddr, cPort )
         /* the picked entry comes as `host:port`, which is exactly what the two
          * fields are for: the host goes to Address and the port to `Port:`.
          * Leaving the whole `host:port` in Address made the sentence of the
          * dialog contradictory (there IS a Port field) and hid the port the
          * user was about to use (reported). */
         aAddr := HcLkAddr( cAddr )
         IF HB_ISARRAY( aAddr ) .AND. Len( aAddr ) > 1 .AND. ;
            ValType( aAddr[ 2 ] ) == "N" .AND. aAddr[ 2 ] > 0
            cAddr := aAddr[ 1 ]
            cPort := LTrim( Str( aAddr[ 2 ] ) )
         ENDIF
         nFoc := HC_LK_ADDR
         lPaint := .T.
      /* S5 of commander-cleanup.md: removing the two firewall rules the program
       * added. It is reachable only while one of them exists (otherwise the
       * button is dimmed and unregistered), and it never touches the Slave: the
       * listener keeps serving if it was already up. */
      CASE nFoc == HC_LK_FWDEL .AND. lFwOwn .AND. ;
           ( nKey == K_ENTER .OR. nKey == K_SPACE )
         lFwOwn := Len( HcFwRemoveRules() ) > 0
         IF ! lFwOwn
            /* the button has just become disabled under the focus: the focus
             * goes to `Cancel` instead of staying on a dimmed label, where the
             * next Enter would ask for an elevation to remove nothing */
            nFoc := HC_LK_CANCEL
         ENDIF
         lPaint := .T.
      CASE nFoc == HC_LK_LINK .AND. ( nKey == K_ENTER .OR. nKey == K_SPACE )
         IF lSlave
            /* the Slave serves the current directory of the active panel (the
             * other one when the active panel is a link, because a remote path
             * is not a local directory) - or the WHOLE DISK, which is the
             * default (S14) */
            nPort := Val( AllTrim( cPort ) )
            aP := HcPanelActive()
            cRoot := iif( HcLinkPanel( aP ), HcPanel( HcOtherPanel() )[ HC_P_DIR ], ;
                                           aP[ HC_P_DIR ] )
            cErr := HcLinkSlaveStart( nPort, cRoot, lWhole )
            IF Len( cErr ) > 0
               UiErr( cErr, "Commander Link" )
            ELSE
               s_nHcLinkPortDlg := s_nHcLinkPort
               s_lHcLinkExportDisk := lWhole
               /* S75: the listener is already up, so this only warns and
                * offers the firewall rule: it never stops the Slave */
               HcFwSlaveWarn( s_nHcLinkPort )
               /* S5: the warn may have just ADDED the two rules, so the button
                * that removes them has to become reachable without closing and
                * reopening this dialog (found by the verification of 86aac70) */
               lFwOwn := Len( HcFwOwnRules( HcFwRegRead( HC_FW_KEY_RULES ) ) ) > 0
            ENDIF
            cPort := LTrim( Str( s_nHcLinkPort ) )
            lPaint := .T.
         ELSE
            /* S5/S8: a bare host takes the port of the field, an explicit
             * host:port of the address wins */
            aAddr := HcLkAddr( HcLinkFullAddr( cAddr, HcLinkPortVal( cPort ) ) )
            aOpen := NIL
            cErr := ""
            IF aAddr == NIL
               cErr := "The address has to be a host or host:port, like 192.168.0.7."
            ELSE
               aOpen := HcLkOpen( aAddr[ 1 ], aAddr[ 2 ], @cErr )
            ENDIF
            IF hb_IsNIL( aOpen )
               UiErr( iif( Len( cErr ) == 0, "Cannot connect to the Slave.", cErr ), ;
                      "Commander Link" )
            ELSE
               /* S14: the start directory and the top of the exported scope
                * both come from the handshake */
               HcLinkAttach( aOpen[ 1 ], aOpen[ 2 ], aOpen[ 3 ], aAddr[ 1 ], aAddr[ 2 ], ;
                             aOpen[ 4 ] )
               s_cHcLinkAddr := aAddr[ 1 ] + ":" + LTrim( Str( aAddr[ 2 ] ) )
               s_nHcLinkPortDlg := aAddr[ 2 ]
               lDone := .T.
            ENDIF
         ENDIF
      CASE nFoc == HC_LK_CANCEL .AND. ( nKey == K_ENTER .OR. nKey == K_SPACE )
         lDone := .T.
      ENDCASE
   ENDDO
   /* S8: the port of the field is what the dialog will show next time, in
    * EITHER mode, so the Master's discovery and the Slave's listener agree by
    * construction instead of by accident */
   s_nHcLinkPortDlg := HcLinkPortVal( cPort )
   RestScreen( nT, nL, nT + nB + 1, Min( nL + nR + 1, MaxCol() ), cSave )
   /* S9 (user rule): LEAVING THE DIALOG DISCONNECTS THE SLAVE, whichever way it
    * is left - `Cancel`, `Esc`, or having attached as Master. The listener only
    * lives while this screen is open, so there is no state left to forget.
    * Before, a Slave that was already serving KEPT serving after Cancel, and the
    * bar chip kept announcing `[SLAVE :port]` over a machine that the user
    * believed disconnected (reported).
    * HcDrawMenuBar() repaints the whole row 0 -it starts with Space( UiCols() )-
    * so the chip cannot stay painted after the Slave is stopped. */
   HcLinkSlaveStop()
   HcDrawMenuBar( 0 )
   SetCursor( cOldCur )
   SetColor( UI_C_DESKTOP )
RETURN

/* =====================================================================
 *  File attributes (odd/tasks/hc-file-attributes.md, S1..S9)
 *
 *  `Files > ~F~ile attributes` reads and writes the four DOS attributes
 *  (Read only, Archive, Hidden, System) and the date/time stamp of the marked
 *  entries - or of the entry under the cursor - with the option of walking a
 *  directory's whole tree (`Include subdirectories`).
 *
 *  Everything that can be decided without a window is a PURE public function
 *  (S9) so the headless bank pins it without touching the disk:
 *  HcAttrBoxText(), HcAttrNewMask(), HcAttrDateVal(), HcAttrTimeVal(),
 *  HcAttrTargets(), HcAttrWalk() and HcAttrSummary(). The dialog and the writes
 *  are only exercised by the on-screen script (S10).
 * ===================================================================== */

/* S4: what a box of the dialog shows for a set of targets: [X] when EVERY one
 * of them has the attribute, [ ] when NONE does and [-] when they disagree (so
 * one Space press decides for the whole set). PURE. Note the ValType() guards:
 * comparing a non-logical with == .T. raises an Argument error in this build,
 * so an argument that is not a logical reads as an empty box. */
FUNCTION HcAttrBoxText( lAll, lAny )
   IF ValType( lAll ) == "L" .AND. lAll
      RETURN "[X]"
   ENDIF
   IF ValType( lAny ) == "L" .AND. lAny
      RETURN "[-]"
   ENDIF
RETURN "[ ]"

/* S5: the mask to write for a file whose current mask is <nOld>: ONLY the four
 * bits of the dialog change and every other bit - HB_FA_DIRECTORY, the sparse /
 * reparse / compression flags... - is preserved. A bad argument answers <nOld>,
 * so a caller that got something wrong writes the file exactly as it was
 * instead of clobbering a bit it did not mean to touch. PURE. */
FUNCTION HcAttrNewMask( nOld, lReadOnly, lArchive, lHidden, lSystem )
   LOCAL nNew
   IF ValType( nOld ) != "N"
      RETURN nOld
   ENDIF
   IF ValType( lReadOnly ) != "L" .OR. ValType( lArchive ) != "L" .OR. ;
      ValType( lHidden ) != "L" .OR. ValType( lSystem ) != "L"
      RETURN nOld
   ENDIF
   nNew := hb_bitAnd( nOld, hb_bitNot( HC_AT_MASK ) )
   IF lReadOnly
      nNew := hb_bitOr( nNew, HB_FA_READONLY )
   ENDIF
   IF lArchive
      nNew := hb_bitOr( nNew, HB_FA_ARCHIVE )
   ENDIF
   IF lHidden
      nNew := hb_bitOr( nNew, HB_FA_HIDDEN )
   ENDIF
   IF lSystem
      nNew := hb_bitOr( nNew, HB_FA_SYSTEM )
   ENDIF
RETURN nNew

/* two digits, nothing else: the shape every field of a stamp has */
/* digits only: any NON-EMPTY string of decimal digits. The SHAPE (two digits for
 * the day and the month, four for the year) is enforced by the rule that uses it
 * (HcAttrDateVal), not here: this helper used to demand exactly two characters,
 * which made a four-digit year invalid. */
STATIC FUNCTION HcAttrDigits( c )
   LOCAL i
   IF ValType( c ) != "C" .OR. Len( c ) == 0
      RETURN .F.
   ENDIF
   FOR i := 1 TO Len( c )
      IF ! HcIsDigit( SubStr( c, i, 1 ) )
         RETURN .F.
      ENDIF
   NEXT
RETURN .T.

/* ---- S6b: the FIXED MASK of the two stamp fields ---------------------- */

/* S6b of odd/tasks/hc-file-attributes.md: the `Date:` and the `Time:` field are
 * MASKS, not free text. Their shape is a TEMPLATE - `99/99/9999` for the date
 * and `99:99:99` for the time - where a `9` is one digit slot and every other
 * character is a fixed separator (the `/` and the `:`), which can be neither
 * typed over nor deleted. Only digits enter the slots and the cursor jumps over
 * the separators, so the shape can never be broken by typing. The whole rule
 * lives in the pure helpers below - so the bank pins it without a window - and
 * the editor of the dialog only walks them: HcAttrMaskTpl(),
 * HcAttrMaskCells(), HcAttrMaskShow(), HcAttrMaskDigits(), HcAttrMaskSlot(),
 * HcAttrMaskCell(), HcAttrMaskType() and HcAttrDateEmpty().
 *
 * Every helper takes the TEMPLATE as its LAST parameter and defaults it to the
 * date, so the date calls stay as they always were and the time is the same code
 * with the other template. The number of digit slots is ALWAYS the number of `9`
 * of the template (eight for the date, six for the time), never a constant. */

/* S6b: the template of a field, by KIND: `"TIME"` is the clock and everything
 * else - `"DATE"`, an absent or an unknown kind - is the date. PURE. */
FUNCTION HcAttrMaskTpl( cKind )
   IF ValType( cKind ) == "C" .AND. Upper( AllTrim( cKind ) ) == "TIME"
      RETURN HC_AT_TPL_TIME
   ENDIF
RETURN HC_AT_TPL_DATE

/* S6b: a usable template: the date one when the argument is absent, NIL, empty
 * or not a string, so no helper can be brought down by a bad one. */
STATIC FUNCTION HcMaskTplOf( cTpl )
   IF ValType( cTpl ) != "C" .OR. Len( cTpl ) == 0
      RETURN HC_AT_TPL_DATE
   ENDIF
RETURN cTpl

/* S6b: the DIGIT SLOTS of a template: its number of `9`. PURE. */
STATIC FUNCTION HcMaskSlots( cTpl )
   LOCAL c := HcMaskTplOf( cTpl ), i, n := 0
   FOR i := 1 TO Len( c )
      IF SubStr( c, i, 1 ) == "9"
         n++
      ENDIF
   NEXT
RETURN n

/* S6b: the cells the mask occupies - the length of its template, which is also
 * the width of the field (HC_AT_DATE_W / HC_AT_TIME_W), so the mask and the
 * field cannot drift apart. PURE. */
FUNCTION HcAttrMaskCells( cTpl )
RETURN Len( HcMaskTplOf( cTpl ) )

/* S6b: the cells to PAINT, from the digit slots: a slot the user has not typed
 * yet is a blank, and the separators of the template are always there. Accepts a
 * short or padded digit string and never crashes on NIL or on a non-string (both
 * are the empty mask). PURE. */
FUNCTION HcAttrMaskShow( cDigits, cTpl )
   LOCAL cT := HcMaskTplOf( cTpl ), c, cOut := "", i, nSlot := 0, ch
   IF ValType( cDigits ) == "C"
      c := PadR( cDigits, HcMaskSlots( cT ) )
   ELSE
      c := Space( HcMaskSlots( cT ) )
   ENDIF
   FOR i := 1 TO Len( cT )
      IF SubStr( cT, i, 1 ) == "9"
         ch := SubStr( c, nSlot + 1, 1 )
         IF HcIsDigit( ch )
            cOut += ch
         ELSE
            cOut += " "
         ENDIF
         nSlot++
      ELSE
         cOut += SubStr( cT, i, 1 )
      ENDIF
   NEXT
RETURN cOut

/* S6b: the digit slots to KEEP, taken from ANY text: every digit in order, at
 * most as many as the template has, and the rest of the slots blank. That is why
 * a user who types `01/01/2025` as if it were free text - separators included -
 * ends up with the same digits: a typed `/` is not a digit, so it is ignored, and
 * the mask already carries it. PURE. */
FUNCTION HcAttrMaskDigits( cText, cTpl )
   LOCAL nMax := HcMaskSlots( cTpl ), c := "", i, ch
   IF ValType( cText ) == "C"
      FOR i := 1 TO Len( cText )
         ch := SubStr( cText, i, 1 )
         IF HcIsDigit( ch ) .AND. Len( c ) < nMax
            c += ch
         ENDIF
      NEXT
   ENDIF
RETURN PadR( c, nMax )

/* S6b: the digit slot (0-based) that a display CELL (0-based) edits, or -1 when
 * the cell is one of the separators of the template or is outside the mask.
 * PURE. */
FUNCTION HcAttrMaskSlot( nCell, cTpl )
   LOCAL cT := HcMaskTplOf( cTpl ), i, nSlot := 0
   IF ValType( nCell ) != "N" .OR. nCell < 0 .OR. nCell >= Len( cT )
      RETURN -1
   ENDIF
   FOR i := 1 TO Len( cT )
      IF SubStr( cT, i, 1 ) == "9"
         IF i - 1 == nCell
            RETURN nSlot
         ENDIF
         nSlot++
      ENDIF
   NEXT
RETURN -1

/* S6b: the display CELL (0-based) of a digit slot, the other half of the walk:
 * the slot just PAST the last one - where the caret is left after the last digit
 * is typed - answers the cell after the last one. PURE. */
FUNCTION HcAttrMaskCell( nSlot, cTpl )
   LOCAL cT := HcMaskTplOf( cTpl ), i, nSlot2 := 0
   IF ValType( nSlot ) != "N" .OR. nSlot < 0
      RETURN -1
   ENDIF
   IF nSlot > HcMaskSlots( cT )
      RETURN -1
   ENDIF
   IF nSlot == HcMaskSlots( cT )
      RETURN Len( cT )
   ENDIF
   FOR i := 1 TO Len( cT )
      IF SubStr( cT, i, 1 ) == "9"
         IF nSlot2 == nSlot
            RETURN i - 1
         ENDIF
         nSlot2++
      ENDIF
   NEXT
RETURN -1

/* the digit string with ONE slot overwritten (<cCh> a digit or a blank): the
 * single place where a slot is written, shared by the typing rule and by the two
 * keys that clear a slot. */
STATIC FUNCTION HcAttrMaskPut( cDigits, nSlot, cCh, cTpl )
   LOCAL c, nMax := HcMaskSlots( cTpl )
   IF ValType( cDigits ) != "C"
      RETURN cDigits
   ENDIF
   c := PadR( cDigits, nMax )
   IF ValType( nSlot ) != "N" .OR. nSlot < 0 .OR. nSlot >= nMax
      RETURN c
   ENDIF
RETURN SubStr( c, 1, nSlot ) + cCh + SubStr( c, nSlot + 2 )

/* S6b: one typed character. A DIGIT goes into the slot it was typed on and a
 * non-digit is IGNORED - the mask already carries the separators - so the shape
 * cannot be broken. A bad argument answers the input unchanged. PURE. */
FUNCTION HcAttrMaskType( cDigits, nSlot, cCh, cTpl )
   IF ValType( cDigits ) != "C" .OR. ValType( nSlot ) != "N" .OR. ;
      ValType( cCh ) != "C"
      RETURN cDigits
   ENDIF
   IF Len( cCh ) != 1 .OR. ! HcIsDigit( cCh )
      RETURN PadR( cDigits, HcMaskSlots( cTpl ) )
   ENDIF
RETURN HcAttrMaskPut( cDigits, nSlot, cCh, cTpl )

/* S6d of odd/tasks/hc-file-attributes.md: is this key a DIGIT? A digit typed
 * while `Date:` or `Time:` has the focus opens its masked editor with that digit
 * as the first keystroke, so the value changes WITHOUT pressing `Enter` (the
 * user's report: "estando parado en la fecha en el cuadro de File attributes, no
 * me deja cambiarla"): the dialog had no digit branch, so the keystroke did
 * nothing. PURE. */
FUNCTION HcAttrDigitKey( nKey )
   IF ValType( nKey ) == "N" .AND. nKey >= Asc( "0" ) .AND. nKey <= Asc( "9" )
      RETURN .T.
   ENDIF
RETURN .F.

/* S6f of odd/tasks/hc-file-attributes.md: does THIS keystroke fill the LAST
 * digit slot of the mask? That is the only case in which the masked editor
 * closes because the value was COMPLETED BY TYPING (the SET CONFIRM OFF rule),
 * and the dialog has to know it, because a field completed by typing hands the
 * focus over to the NEXT control of its ring (HcAttrFillNext()) - `Date:` to
 * `Time:` and `Time:` to `Include subdirectories`. `Enter`, `Esc`, the arrows,
 * Backspace/Delete and the mouse never answer .T. here, so the "closes by
 * completion" path stays one rule instead of a flag each caller guesses. PURE. */
FUNCTION HcAttrMaskFill( nKey, nSlot, cTpl )
   IF ! HcAttrDigitKey( nKey )
      RETURN .F.
   ENDIF
   IF ValType( nSlot ) != "N"
      RETURN .F.
   ENDIF
RETURN nSlot == HcMaskSlots( cTpl ) - 1

/* S6b: the text carries NO digit at all, which is what an EMPTY MASK means - the
 * date's `  /  /    ` and the time's `  :  :  `: that half of the stamp is not
 * touched (HcAttrDateVal() and HcAttrTimeVal() read it as the empty value, while
 * a full one still parses). PURE. */
FUNCTION HcAttrDateEmpty( cText )
   LOCAL i
   IF ValType( cText ) != "C"
      RETURN .T.
   ENDIF
   FOR i := 1 TO Len( cText )
      IF HcIsDigit( SubStr( cText, i, 1 ) )
         RETURN .F.
      ENDIF
   NEXT
RETURN .T.

/* S6b: the slot the field opens on: the first one still blank or, when the value
 * is already complete, the first cell - typing then replaces it from the left,
 * like the classic GET. Shared by the editor and by the focus block so the two
 * never point at different cells. PURE. */
STATIC FUNCTION HcAttrMaskStart( cDigits, cTpl )
   LOCAL nMax := HcMaskSlots( cTpl ), i
   IF ValType( cDigits ) != "C"
      RETURN 0
   ENDIF
   FOR i := 1 TO nMax
      IF ! HcIsDigit( SubStr( cDigits, i, 1 ) )
         RETURN i - 1
      ENDIF
   NEXT
RETURN 0

/* S6d: the state the masked editor OPENS on when a digit was already typed on
 * the focused field: that digit lands on the slot the editor would open on
 * (HcAttrMaskStart()) and the caret advances, exactly as if it had been typed
 * inside the editor. Answers `{ cDigits, nSlot, lConfirm }`, so the dialog hands
 * the keystroke over instead of growing a second typing path. `lConfirm` is the
 * SET CONFIRM OFF rule of the mask - filling the LAST slot confirms the field -
 * so a digit typed there behaves like one typed inside. A key that is NOT a
 * digit answers the value untouched on its opening slot, which is what `Enter`
 * keeps doing. PURE.
 *
 * S6f: <lHome> is OPTIONAL and, when .T., makes the editor open on the FIRST
 * digit slot instead of the first blank one. It is what the dialog asks for right
 * after `Date:` was completed by typing and the focus is handed over to `Time:`:
 * the caret is painted on the clock's first digit there, so the digit the user
 * keeps typing has to land where the caret is, not on the first blank slot of the
 * clock. Absent, NIL or .F. keeps the classic opening slot, so every earlier
 * caller behaves exactly as before. */
FUNCTION HcAttrMaskSeed( cText, nFirstKey, cTpl, lHome )
   LOCAL cDig   := HcAttrMaskDigits( cText, cTpl )
   LOCAL nSlot  := 0
   IF ! ( lHome == .T. )
      nSlot := HcAttrMaskStart( cDig, cTpl )
   ENDIF
   IF ! HcAttrDigitKey( nFirstKey )
      RETURN { cDig, nSlot, .F. }
   ENDIF
   cDig := HcAttrMaskType( cDig, nSlot, Chr( nFirstKey ), cTpl )
   IF HcAttrMaskFill( nFirstKey, nSlot, cTpl )
      RETURN { cDig, nSlot, .T. }
   ENDIF
RETURN { cDig, nSlot + 1, .F. }

/* S6: the `Date:` field. DD/MM/YYYY (the separator the user asked for; `-` and
 * `.` are accepted too when typing) and blanks around it; the year is FOUR
 * digits and is handed to SToD() as it is - a two-digit year is refused, never
 * guessed. An EMPTY field is valid and answers no date at all, which means "leave
 * the stamp alone" (the apply path reads it as "this half was not given").
 * PURE: { lOk, dDate }. */
FUNCTION HcAttrDateVal( cText )
   LOCAL c, aPart, cS, d
   IF ValType( cText ) != "C"
      RETURN { .F., NIL }
   ENDIF
   c := AllTrim( cText )
   IF Len( c ) == 0
      RETURN { .T., NIL }
   ENDIF
   /* S6b: the field is a MASK, so its empty form is `  /  /    `, which carries
    * no digit at all: that is the empty date ("leave the stamp alone"), not an
    * invalid one */
   IF HcAttrDateEmpty( cText )
      RETURN { .T., NIL }
   ENDIF
   c := StrTran( StrTran( c, "/", "-" ), ".", "-" )
   aPart := hb_ATokens( c, "-" )
   IF Len( aPart ) != 3
      RETURN { .F., NIL }
   ENDIF
   IF ! HcAttrDigits( aPart[ 1 ] ) .OR. ! HcAttrDigits( aPart[ 2 ] ) .OR. ;
      ! HcAttrDigits( aPart[ 3 ] )
      RETURN { .F., NIL }
   ENDIF
   /* S6: the year is FOUR digits, the format the user asked for (DD/MM/YYYY),
    * so no "20" is glued in front of it any more: a two-digit year is refused
    * instead of guessed. SToD() wants YYYYMMDD, and the round trip is what
    * rejects 31-02 or month 13, which it would otherwise turn into an empty
    * date in silence. */
   IF Len( aPart[ 1 ] ) != 2 .OR. Len( aPart[ 2 ] ) != 2 .OR. Len( aPart[ 3 ] ) != 4
      RETURN { .F., NIL }
   ENDIF
   cS := aPart[ 3 ] + aPart[ 2 ] + aPart[ 1 ]
   d  := SToD( cS )
   IF Empty( d ) .OR. ! ( DToS( d ) == cS )
      RETURN { .F., NIL }
   ENDIF
RETURN { .T., d }

/* S6b: the text is the EMPTY time mask `  :  :  ` - nothing but blanks and the
 * two `:` of its template. Like HcAttrDateEmpty() for the date, that is the
 * empty value; the shape is checked (not merely "no digit") so that a text such
 * as `aa:bb` stays a refused time. PURE. */
STATIC FUNCTION HcMaskTimeBlank( cText )
   LOCAL i, ch
   IF ValType( cText ) != "C"
      RETURN .F.
   ENDIF
   FOR i := 1 TO Len( cText )
      ch := SubStr( cText, i, 1 )
      IF ! ( ch == ":" ) .AND. ! ( ch == " " )
         RETURN .F.
      ENDIF
   NEXT
RETURN .T.

/* S6: the `Time:` field. HH:MM:SS in 24 hours; `HH:MM` is accepted and the
 * seconds are filled with :00. An EMPTY field is valid and answers no time at
 * all ("leave that half alone"), and so does the EMPTY MASK `  :  :  ` the field
 * shows when the first target has no time (S6b). PURE: { lOk, cTime }. */
FUNCTION HcAttrTimeVal( cText )
   LOCAL c, aPart, nH, nM, nS := 0
   IF ValType( cText ) != "C"
      RETURN { .F., NIL }
   ENDIF
   c := AllTrim( cText )
   IF Len( c ) == 0
      RETURN { .T., NIL }
   ENDIF
   IF HcMaskTimeBlank( cText )
      RETURN { .T., NIL }
   ENDIF
   aPart := hb_ATokens( c, ":" )
   IF Len( aPart ) < 2 .OR. Len( aPart ) > 3
      RETURN { .F., NIL }
   ENDIF
   IF ! HcAttrDigits( aPart[ 1 ] ) .OR. ! HcAttrDigits( aPart[ 2 ] )
      RETURN { .F., NIL }
   ENDIF
   IF Len( aPart ) == 3
      IF ! HcAttrDigits( aPart[ 3 ] )
         RETURN { .F., NIL }
      ENDIF
      nS := Val( aPart[ 3 ] )
   ENDIF
   nH := Val( aPart[ 1 ] )
   nM := Val( aPart[ 2 ] )
   IF nH > 23 .OR. nM > 59 .OR. nS > 59
      RETURN { .F., NIL }
   ENDIF
RETURN { .T., StrZero( nH, 2 ) + ":" + StrZero( nM, 2 ) + ":" + StrZero( nS, 2 ) }

/* S2/S9: the entries the command acts on, IN LISTING ORDER: the marked ones or,
 * when nothing is marked, the one under the cursor (<nSel>). `..` is never a
 * target and the set is de-duplicated, so marking one entry twice - or a panel
 * that carries the same name twice - can never write it twice. PURE: it only
 * looks at the array. */
FUNCTION HcAttrTargets( aList, nSel )
   LOCAL aOut := {}, i, cName
   IF ! HB_ISARRAY( aList )
      RETURN aOut
   ENDIF
   FOR i := 1 TO Len( aList )
      IF ! HB_ISARRAY( aList[ i ] ) .OR. Len( aList[ i ] ) < HC_E_MARK
         LOOP
      ENDIF
      IF ValType( aList[ i ][ HC_E_NAME ] ) != "C"
         LOOP
      ENDIF
      cName := aList[ i ][ HC_E_NAME ]
      /* a non-logical mark is not a mark (comparing it with == .T. raises) */
      IF ! ( ValType( aList[ i ][ HC_E_MARK ] ) == "L" .AND. aList[ i ][ HC_E_MARK ] )
         LOOP
      ENDIF
      IF cName == ".."
         LOOP
      ENDIF
      IF AScan( aOut, {| c | Upper( c ) == Upper( cName ) } ) > 0
         LOOP
      ENDIF
      AAdd( aOut, cName )
   NEXT
   IF Len( aOut ) > 0
      RETURN aOut
   ENDIF
   /* nothing marked: the entry under the cursor, never the parent */
   IF ValType( nSel ) == "N" .AND. nSel >= 1 .AND. nSel <= Len( aList ) .AND. ;
      HB_ISARRAY( aList[ nSel ] ) .AND. ValType( aList[ nSel ][ HC_E_NAME ] ) == "C" .AND. ;
      ! ( aList[ nSel ][ HC_E_NAME ] == ".." )
      AAdd( aOut, aList[ nSel ][ HC_E_NAME ] )
   ENDIF
RETURN aOut

/* the children of a directory for the walk: { subdirectories, files, reparse
 * points }, each group in name order and case-insensitively. The listing comes
 * from the same call the panels use (hb_vfDirectory with the "HSD" filter), so
 * the walk sees the entries the panel shows: hidden and system ones included,
 * "." and ".." never. A reparse point (a junction or a symlink) is listed but
 * it is NOT descended into: following it could walk out of the tree the user
 * pointed at, or loop for ever. */
STATIC FUNCTION HcAttrChildren( cDir )
   LOCAL aDirs := {}, aFiles := {}, aLinks := {}, aRaw, a, i, nAttr, cName
   aRaw := hb_vfDirectory( HcDirArg( cDir ), "HSD" )
   IF ! HB_ISARRAY( aRaw )
      RETURN { aDirs, aFiles, aLinks }
   ENDIF
   FOR i := 1 TO Len( aRaw )
      a := aRaw[ i ]
      IF ! HB_ISARRAY( a ) .OR. Len( a ) < 1 .OR. ValType( a[ 1 ] ) != "C"
         LOOP
      ENDIF
      cName := a[ 1 ]
      IF ( cName == "." ) .OR. ( cName == ".." ) .OR. Empty( cName )
         LOOP
      ENDIF
      nAttr := 0
      IF ! hb_vfAttrGet( HcJoinPath( cDir, cName ), @nAttr )
         nAttr := 0
      ENDIF
      IF hb_bitAnd( nAttr, HB_FA_DIRECTORY ) == 0
         AAdd( aFiles, cName )
      ELSEIF hb_bitAnd( nAttr, HB_FA_REPARSE ) != 0
         AAdd( aLinks, cName )
      ELSE
         AAdd( aDirs, cName )
      ENDIF
   NEXT
   IF Len( aDirs ) > 1
      ASort( aDirs, 1, Len( aDirs ), {| x, y | Upper( x ) < Upper( y ) } )
   ENDIF
   IF Len( aFiles ) > 1
      ASort( aFiles, 1, Len( aFiles ), {| x, y | Upper( x ) < Upper( y ) } )
   ENDIF
   IF Len( aLinks ) > 1
      ASort( aLinks, 1, Len( aLinks ), {| x, y | Upper( x ) < Upper( y ) } )
   ENDIF
RETURN { aDirs, aFiles, aLinks }

/* S7/S9: the ordered list of paths a target expands to. The path itself comes
 * FIRST (a directory always changes its own attributes, with the box on or off),
 * then its tree when <lTree> is .T.: level by level, and at each level the
 * subdirectories of every directory before its files, each group in name order.
 * `..` is never followed and a reparse point is never entered, so the walk can
 * neither loop nor leave the tree the user pointed at. With <lTree> false, or a
 * target that is not a directory, the answer is the path alone. PURE for the
 * bank: the plan is decided here and no attribute is touched. */
FUNCTION HcAttrWalk( cRoot, lTree )
   LOCAL aOut := {}, aLevel, aNext, aCh, cDir, cChild, i, j
   IF ValType( cRoot ) != "C" .OR. Len( AllTrim( cRoot ) ) == 0
      RETURN aOut
   ENDIF
   cDir := AllTrim( cRoot )
   AAdd( aOut, cDir )
   IF lTree != .T. .OR. ! hb_DirExists( cDir )
      RETURN aOut
   ENDIF
   aLevel := { cDir }
   DO WHILE Len( aLevel ) > 0
      aNext := {}
      FOR i := 1 TO Len( aLevel )
         aCh := HcAttrChildren( aLevel[ i ] )
         FOR j := 1 TO Len( aCh[ 1 ] )
            cChild := HcJoinPath( aLevel[ i ], aCh[ 1 ][ j ] )
            AAdd( aOut, cChild )
            AAdd( aNext, cChild )
         NEXT
         FOR j := 1 TO Len( aCh[ 3 ] )
            /* a reparse point is listed (its own attributes can change) but it
             * is never descended into */
            AAdd( aOut, HcJoinPath( aLevel[ i ], aCh[ 3 ][ j ] ) )
         NEXT
         FOR j := 1 TO Len( aCh[ 2 ] )
            AAdd( aOut, HcJoinPath( aLevel[ i ], aCh[ 2 ][ j ] ) )
         NEXT
      NEXT
      aLevel := aNext
   ENDDO
RETURN aOut

/* S8: the one-line result of an apply, in English like every other text of the
 * interface. A cancelled walk keeps what was already written, so it says so
 * instead of pretending the whole set was done (S7). PURE. */
FUNCTION HcAttrSummary( nOk, nFail, lCancel )
   LOCAL c := LTrim( Str( iif( ValType( nOk ) == "N", nOk, 0 ) ) ) + " entries changed"
   IF lCancel == .T.
      RETURN c + ", cancelled"
   ENDIF
   IF ValType( nFail ) == "N" .AND. nFail > 0
      RETURN c + ", " + LTrim( Str( nFail ) ) + " failed."
   ENDIF
RETURN c + "."

/* S3: next / previous focus slot of the dialog. All nine slots exist always, so
 * the walk is a plain ring (the link dialog skips slots by mode; here there is
 * nothing to skip). */
STATIC FUNCTION HcAttrFocusStep( nFoc, nDir )
   IF ValType( nFoc ) != "N"
      nFoc := HC_AT_RO
   ENDIF
   IF ValType( nDir ) != "N" .OR. nDir == 0
      nDir := 1
   ENDIF
   nFoc += nDir
   IF nFoc > HC_AT_CANCEL
      nFoc := HC_AT_RO
   ENDIF
   IF nFoc < HC_AT_RO
      nFoc := HC_AT_CANCEL
   ENDIF
RETURN nFoc

/* S6f of hc-file-attributes.md, GENERALISED - the user's rule «Esto debe suceder
 * en todos los inputs»: the control the dialog hands the focus to when a field
 * closes because its value was COMPLETED BY TYPING (the LAST mask slot filled by
 * a digit, the SET CONFIRM OFF path of the mask), which happens for EVERY input
 * of the dialog, not just for `Date:`.
 *
 * The NEXT control is resolved through the dialog's own focus ring
 * (HcAttrFocusStep(), the helper `Tab`/`Shift-Tab` walk), so the hand-over cannot
 * disagree with the focus order and a change of that order is FOLLOWED instead
 * of a control name being pasted here.
 *
 * Answers { nFocus, lHome }: <lHome> is .T. only when the control that receives
 * the focus is one of the two MASKED fields, whose caret then sits on the FIRST
 * digit slot - so the digit the user keeps typing lands on the cell the caret is
 * painted on. A box or a button has no caret, so the flag is .F. for them (and
 * the caret of the field that was left stops being painted, since it is no
 * longer the focused field). `Enter` and `Esc` never reach this: they close a
 * field without completing it, so they never move the focus (S6d). PURE. */
FUNCTION HcAttrFillNext( nFoc )
   LOCAL nNext := HcAttrFocusStep( nFoc, 1 )
RETURN { nNext, nNext == HC_AT_DATE .OR. nNext == HC_AT_TIME }

/* S6g of odd/tasks/hc-file-attributes.md: where the focus goes when a MASKED
 * field CLOSES. <lFull> is the ONLY input that decides it - .T. when the field
 * closed because its value was COMPLETED BY TYPING (the SET CONFIRM OFF rule,
 * HcAttrMaskFill()), .F. for `Enter`, `Esc` and every other way of closing - so
 * the answer cannot depend on HOW the editor was opened. That is exactly the
 * point: the two `Enter` branches of the dialog used to ignore the completion
 * flag, so a value typed INSIDE an editor opened with `Enter` did not hand the
 * focus over while the same digits typed straight on the focused field did, and
 * the user's rule (Log L12: «al terminar de escribir la hora debe pasar el
 * proximo») is that completing by typing moves the focus either way.
 *
 * Answers { nFocus, lHome }: with .T. the NEXT control of the ring, resolved by
 * HcAttrFillNext() - the single source of truth of the hand-over, so a change of
 * the focus order is followed instead of a control name being pasted anywhere -
 * plus the caret flag it answers; with .F. the SAME control and no forced caret,
 * which is the S6d rule (`Enter` and `Esc` never move the focus). PURE. */
FUNCTION HcAttrFocusAfter( nFoc, lFull )
   LOCAL aNext
   IF ValType( lFull ) != "L" .OR. ! lFull
      RETURN { nFoc, .F. }
   ENDIF
   aNext := HcAttrFillNext( nFoc )
RETURN { aNext[ 1 ], aNext[ 2 ] }

/* the attribute bit behind box 1..4 (HC_AT_RO..HC_AT_SYS, the order the dialog
 * reads and paints) */
STATIC FUNCTION HcAttrBit( n )
   DO CASE
   CASE n == 1
      RETURN HB_FA_READONLY
   CASE n == 2
      RETURN HB_FA_ARCHIVE
   CASE n == 3
      RETURN HB_FA_HIDDEN
   CASE n == 4
      RETURN HB_FA_SYSTEM
   ENDCASE
RETURN 0

/* DD/MM/YYYY of a date, "" when there is none: the shape of the `Date:` field.
 * S6/S9: the text the `Date:` field shows and the seed it opens with,
 * DD/MM/YYYY (the format the user asked for). Public so the bank pins the
 * shape: that text is what the user reads and types over. */
FUNCTION HcAttrDateText( d )
   IF ValType( d ) != "D" .OR. Empty( d )
      RETURN ""
   ENDIF
RETURN StrZero( Day( d ), 2 ) + "/" + StrZero( Month( d ), 2 ) + "/" + ;
       StrZero( Year( d ), 4 )

/* S4: what one Space press does to a box that shows [X], [ ] or [-]. The state
 * the box SHOWS turns into [X], so the press decides for the whole set - and a
 * second press, when the box already reads [X], turns it off for the whole set
 * too. Answers the new { lAll, lAny }. */
STATIC FUNCTION HcAttrToggle( lAll, lAny )
   /* the guard is what HcAttrBoxText() documents: comparing a non-logical with
    * `.T.` raises Argument error in this build (AGENTS.md trap 20) */
   IF ValType( lAll ) != "L" .OR. ValType( lAny ) != "L"
      RETURN { .F., .F. }
   ENDIF
   IF lAll .AND. lAny
      RETURN { .F., .F. }
   ENDIF
RETURN { .T., .T. }

/* S4/L3b of hc-file-attributes.md: should this bit end up ON for a file whose
 * mask is nOld? A box the user DECIDED wins for every file (lAll = every target
 * has the bit, lAny = some do); a box still showing [-] (lAll .F. and lAny .T.)
 * is UNDECIDED, so the file keeps the bit it already has. Pure, and the apply
 * path asks it once per bit and per file, which is what keeps `Apply` from
 * writing a bit the user never decided: the first version of the loop reused
 * the dialog's array (`aWant := aAll`), so after the first target the mixed bit
 * was forced to that target's value for all the rest. */
FUNCTION HcAttrWantBit( lAll, lAny, nOld, nBit )
   IF ValType( lAll ) != "L" .OR. ValType( lAny ) != "L"
      RETURN .F.
   ENDIF
   IF ValType( nOld ) != "N" .OR. ValType( nBit ) != "N"
      RETURN .F.
   ENDIF
   IF lAll
      RETURN .T.
   ENDIF
   IF lAny
      RETURN hb_bitAnd( nOld, nBit ) != 0
   ENDIF
RETURN .F.

/* Space and Enter are the two keys that act on a box (and on
 * `Include subdirectories`): a click sends one of them, so the mouse and the
 * keyboard go through the very same CASE. */
STATIC FUNCTION HcAttrHot( nKey )
RETURN nKey == K_SPACE .OR. nKey == K_ENTER

/* T1 (S11): the label of button 1..2 with its quick key marked (`~X~`), the
 * convention of the whole program and the one the OTHER box of this screen -
 * `Find / Replace` - already follows (HcFindBtnLabel()). The letter is INSIDE
 * its own word and never invented outside it, so the label is ONE source of
 * truth: the paint reads it through UiDrawHot() and the bank checks that the
 * letter it marks is the letter HcAttrBtnHot() answers for that button. */
FUNCTION HcAttrBtnLabel( nBtn )
   IF ValType( nBtn ) != "N"
      RETURN ""
   ENDIF
   DO CASE
   CASE Int( nBtn ) == 1
      RETURN "~A~pply"
   CASE Int( nBtn ) == 2
      RETURN "~C~ancel"
   ENDCASE
RETURN ""

/* T1 (S11) + Log L14: the button a key runs, 0 when it runs none - the rule the
 * two hot letters obey, PURE so the headless bank pins it without a window:
 *
 *   `Alt+A`/`Alt+a` -> 1 (`Apply`), `Alt+C`/`Alt+c` -> 2 (`Cancel`);
 *   a BARE letter -> 0, any other key -> 0, anything with CTRL -> 0.
 *
 * The user's correction is that the quick key of a BUTTON in this port is
 * `Alt+<letter>` («Alt + Letra»), never the bare letter: a bare letter belongs
 * to a text field. Inside a modal the chord only arrives reliably through the
 * window-hook ring, which the caller drains and hands in as the ALT bit (AGENTS
 * trap 61), so the ALT bit is REQUIRED here. It has no focus argument on
 * purpose: the chord works from anywhere in the dialog (measured on screen),
 * which is what a button's quick key means in the menus of this program.
 * CTRL refuses the whole thing because on a Spanish keyboard AltGr IS Ctrl+Alt
 * (AGENTS trap 38), so `AltGr+A` (which types a character) can never apply
 * anything; a missing or non-numeric shift state is no ALT at all, so a bare
 * letter answers 0. */
FUNCTION HcAttrBtnHot( nKey, nShift )
   LOCAL cCh, lAlt, lCtl
   IF ValType( nKey ) != "N"
      RETURN 0
   ENDIF
   nKey := Int( nKey )
   /* a letter lives well below 127: anything else is not a quick key, and this
    * build can drop a byte >= 128 through Chr() (AGENTS trap 47) */
   IF nKey < 32 .OR. nKey > 126
      RETURN 0
   ENDIF
   cCh := Upper( Chr( nKey ) )
   IF ! ( cCh == "A" .OR. cCh == "C" )
      RETURN 0
   ENDIF
   lAlt := ValType( nShift ) == "N" .AND. hb_BitAnd( nShift, HB_GTI_KBD_ALT ) != 0
   lCtl := ValType( nShift ) == "N" .AND. hb_BitAnd( nShift, HB_GTI_KBD_CTRL ) != 0
   IF ! lAlt .OR. lCtl
      RETURN 0
   ENDIF
   IF cCh == "A"
      RETURN 1
   ENDIF
RETURN 2

/* S6e: the colour of ONE of the two stamp fields of THIS dialog. The user asked
 * for a SINGLE focus colour ("es confuso el foco del input activo. Quiero que
 * sea uno solo de color amarillo. No se porque hay otro pintado de verde."): the
 * field with the focus is UI_C_LISTSEL - the one colour that means "you are
 * here" in this dialog family - and the field WITHOUT focus is painted as the
 * interior of the box (UI_C_BOX), never with UI_C_DLGFIELD, the green that the
 * fields of the OTHER dialogs use (that define is untouched). So the only
 * yellow of the row, and the only field colour, is where the focus is. PURE. */
FUNCTION HcAttrFieldColor( lFocus )
   IF ValType( lFocus ) == "L" .AND. lFocus
      RETURN UI_C_LISTSEL
   ENDIF
RETURN UI_C_BOX

/* one checkbox of the dialog. It registers its span in the shared control table
 * while it is painted, so the click and the paint cannot disagree (AGENTS.md
 * section 6). */
STATIC PROCEDURE HcAttrOpt( nRow, nCol, cText, lFocus, cKind )
   SetColor( iif( lFocus, UI_C_LISTSEL, UI_C_BOX ) )
   @ nRow, nCol SAY cText
   HcSyncCtlAdd( nRow, nCol, Len( cText ), "ATTR", cKind )
   SetColor( UI_C_BOX )
RETURN

/* one button, STACKED like the ones of the Commander Link dialog: the focused
 * one uses the yellow that means "you are here" in this dialog family and the
 * other the white-on-dark-grey of UiConfirmBtn().
 *
 * T1: <cLabel> carries its quick key marked (`~A~pply`, see HcAttrBtnLabel()),
 * so the letter is painted by UiDrawHot() INSIDE the label and stays visible in
 * both states: UI_C_HOTSEL over the focused yellow and UI_C_HOTON over the
 * unfocused dark grey, the two pairs this program already uses for a hot key
 * (HcFindBtn() does exactly this). No new colour define, and the focus still
 * reads as ONE colour: only the letter changes pair. The background is laid down
 * first because UiDrawHot() only SAYs text. */
STATIC PROCEDURE HcAttrButton( nRow, nCol, cLabel, lFocus, cKind )
   LOCAL c := "[ " + cLabel + " ]"
   LOCAL cPlain := StrTran( c, "~", "" )
   LOCAL cColor := iif( lFocus, UI_C_LISTSEL, UI_C_MENUKEY )
   SetColor( cColor )
   @ nRow, nCol SAY Space( Len( cPlain ) )
   UiDrawHot( nRow, nCol, c, cColor, iif( lFocus, UI_C_HOTSEL, UI_C_HOTON ) )
   HcSyncCtlAdd( nRow, nCol, Len( cPlain ), "ATTR", cKind )
   SetColor( UI_C_BOX )
RETURN

/* S3: height MINUS ONE of the box: its last painted row plus one row of inner
 * padding (the convention of HcLinkBoxH()), so growing the content grows the
 * frame instead of spilling out of it. PURE. */
FUNCTION HcAttrBoxH()
RETURN HC_AT_R_HINT2 + 1

/* the count line and, under it, the name (cut keeping its tail, so the extension
 * survives) or the number of entries */
STATIC PROCEDURE HcAttrHead( nT, nL, nR, aNames )
   LOCAL cCount, cWhat, n := Len( aNames )
   IF n == 1
      cCount := "1 file"
      cWhat  := HcPathTitle( aNames[ 1 ], Max( 0, nR - 4 ) )
   ELSE
      cCount := LTrim( Str( n ) ) + " entries"
      cWhat  := "(" + LTrim( Str( n ) ) + " items)"
   ENDIF
   SetColor( UI_C_CHIP )
   @ nT + HC_AT_R_COUNT, nL + HC_AT_COL_L SAY PadR( " " + cCount + " ", Max( 0, nR - 4 ) )
   SetColor( UI_C_BOX )
   @ nT + HC_AT_R_WHAT, nL + HC_AT_COL_L SAY PadR( cWhat, Max( 0, nR - 4 ) )
   SetColor( UI_C_BOX )
RETURN

/* the whole box, in ONE paint block owned by the caller. Every control is
 * registered here (HcSyncCtlAdd) as it is drawn, so the click is translated into
 * the key that already does the job. */
STATIC PROCEDURE HcAttrPaint( nT, nL, nR, nB, aNames, aAll, aAny, cDate, cTime, lSub, nFoc )
   LOCAL nCol
   UiShadow( nT, nL, nT + nB, nL + nR )
   UiFillBox( nT, nL, nT + nB, nL + nR, UI_C_BOX )
   UiFrame( nT, nL, nT + nB, nL + nR, UI_C_BOX, .T. )
   SetColor( UI_C_CHIP )
   @ nT, nL + 2 SAY " File attributes "
   HcAttrHead( nT, nL, nR, aNames )
   /* S3/S4: the two columns of boxes, each showing [X], [ ] or [-] */
   HcAttrOpt( nT + HC_AT_R_BOX1, nL + HC_AT_COL_L, ;
              HcAttrBoxText( aAll[ 1 ], aAny[ 1 ] ) + " Read only", nFoc == HC_AT_RO, "RO" )
   HcAttrOpt( nT + HC_AT_R_BOX1, nL + HC_AT_COL_R, ;
              HcAttrBoxText( aAll[ 2 ], aAny[ 2 ] ) + " Archive", nFoc == HC_AT_AR, "AR" )
   HcAttrOpt( nT + HC_AT_R_BOX2, nL + HC_AT_COL_L, ;
              HcAttrBoxText( aAll[ 3 ], aAny[ 3 ] ) + " Hidden", nFoc == HC_AT_HID, "HID" )
   HcAttrOpt( nT + HC_AT_R_BOX2, nL + HC_AT_COL_R, ;
              HcAttrBoxText( aAll[ 4 ], aAny[ 4 ] ) + " System", nFoc == HC_AT_SYS, "SYS" )
   /* S6: the two halves of the stamp, side by side on one row */
   nCol := nL + HC_AT_COL_L
   SetColor( UI_C_BOX )
   @ nT + HC_AT_R_DATE, nCol SAY "Date:"
   SetColor( HcAttrFieldColor( nFoc == HC_AT_DATE ) )
   @ nT + HC_AT_R_DATE, nCol + 6 SAY PadR( Left( cDate, HC_AT_DATE_W ), HC_AT_DATE_W )
   HcSyncCtlAdd( nT + HC_AT_R_DATE, nCol, 6 + HC_AT_DATE_W, "ATTR", "DATE" )
   nCol := nL + HC_AT_COL_R
   SetColor( UI_C_BOX )
   @ nT + HC_AT_R_DATE, nCol SAY "Time:"
   SetColor( HcAttrFieldColor( nFoc == HC_AT_TIME ) )
   @ nT + HC_AT_R_DATE, nCol + 6 SAY PadR( Left( cTime, HC_AT_TIME_W ), HC_AT_TIME_W )
   HcSyncCtlAdd( nT + HC_AT_R_DATE, nCol, 6 + HC_AT_TIME_W, "ATTR", "TIME" )
   /* S7: the tree option, alone on its row */
   HcAttrOpt( nT + HC_AT_R_SUB, nL + HC_AT_COL_L, ;
              HcAttrBoxText( lSub, lSub ) + " Include subdirectories", ;
              nFoc == HC_AT_SUB, "SUB" )
   /* S3: the buttons are STACKED, one per row, with a blank row between them.
    * T1: each one carries its quick key inside its own label (HcAttrBtnLabel()). */
   HcAttrButton( nT + HC_AT_R_APPLY, nL + HC_AT_COL_L, HcAttrBtnLabel( 1 ), ;
                 nFoc == HC_AT_APPLY, "APPLY" )
   HcAttrButton( nT + HC_AT_R_CANCEL, nL + HC_AT_COL_L, HcAttrBtnLabel( 2 ), ;
                 nFoc == HC_AT_CANCEL, "CANCEL" )
   nCol := HcHintKey( nT + HC_AT_R_HINT, nL + HC_AT_COL_L, "Tab", "Next" )
   nCol := HcHintKey( nT + HC_AT_R_HINT, nCol, "Space", "Toggle" )
   nCol := HcHintKey( nT + HC_AT_R_HINT, nCol, "Enter", "Apply" )
   nCol := HcHintKey( nT + HC_AT_R_HINT, nCol, "Esc", "Cancel" )
   /* T1 (Log L14): the two quick keys of the buttons are `Alt+<letter>` - the
    * chord the dialog really listens for - announced on their own row (there is
    * no room for both with their `Alt-` on the row above), chained by the same
    * helper as the others */
   nCol := HcHintKey( nT + HC_AT_R_HINT2, nL + HC_AT_COL_L, "Alt-A", "Apply" )
   nCol := HcHintKey( nT + HC_AT_R_HINT2, nCol, "Alt-C", "Cancel" )
   SetColor( UI_C_BOX )
RETURN

/* S3: WHERE THE CURSOR IS, in the two fields, painted as a block with the two
 * colours of the field swapped (UiSwapColor()). It is the answer the Commander
 * Link dialog already gives, for the same measured reason: SetCursor(1) +
 * DevPos() paint ZERO pixels of difference in this driver, so a painted block is
 * the only cursor that can be seen. Called AFTER UiPaintEnd(), on top of what
 * the paint block drew.
 *
 * <lHome> (S6f) is OPTIONAL: with .T. the block sits on the FIRST digit slot
 * instead of the slot the editor would normally open on, which is what the
 * dialog asks for right after `Date:` was completed by typing and the focus was
 * handed over to `Time:` (the caret and the next digit have to agree). */
STATIC PROCEDURE HcAttrCursor( nT, nL, nFoc, cDate, cTime, lHome )
   LOCAL c, cT, nPos, nCol, cBody, cDig
   SetCursor( 0 )
   DO CASE
   CASE nFoc == HC_AT_DATE .OR. nFoc == HC_AT_TIME
      /* S6b: both stamp fields are masks, so the block sits on the slot the
       * masked editor would open on: the focus and the edit always point at the
       * same cell */
      IF nFoc == HC_AT_DATE
         cT   := HcAttrMaskTpl( "DATE" )
         cDig := HcAttrMaskDigits( cDate, cT )
         nCol := nL + HC_AT_COL_L + 6
      ELSE
         cT   := HcAttrMaskTpl( "TIME" )
         cDig := HcAttrMaskDigits( cTime, cT )
         nCol := nL + HC_AT_COL_R + 6
      ENDIF
      cBody := UI_C_LISTSEL
      nPos  := HcAttrMaskCell( iif( lHome == .T., 0, HcAttrMaskStart( cDig, cT ) ), cT )
      IF nPos < 0 .OR. nPos >= Len( cT )
         /* the caret is past the last cell (the value is complete): nothing to
          * mark with a block */
         RETURN
      ENDIF
      c    := SubStr( HcAttrMaskShow( cDig, cT ), nPos + 1, 1 )
      nCol := nCol + nPos
   OTHERWISE
      /* a box or a button: its focus is the colour, a block would be noise */
      RETURN
   ENDCASE
   IF Len( c ) == 0
      c := " "
   ENDIF
   SetColor( UiSwapColor( cBody ) )
   @ nT + HC_AT_R_DATE, nCol SAY c
   SetColor( UI_C_BOX )
RETURN

/* S6b: one repaint of a masked field - its cells and the block cursor on the
 * digit slot the caret is on - in ONE paint block, so a keystroke costs one
 * REFRESH. */
STATIC PROCEDURE HcAttrMaskPaint( nRow, nCol, cDig, nSlot, cTpl )
   LOCAL cShow, nCell
   cShow := HcAttrMaskShow( cDig, cTpl )
   nCell := HcAttrMaskCell( nSlot, cTpl )
   UiPaintBegin()
   SetColor( UI_C_LISTSEL )
   @ nRow, nCol SAY cShow
   IF nCell >= 0 .AND. nCell < HcAttrMaskCells( cTpl )
      SetColor( UiSwapColor( UI_C_LISTSEL ) )
      @ nRow, nCol + nCell SAY SubStr( cShow, nCell + 1, 1 )
   ENDIF
   SetColor( UI_C_BOX )
   UiPaintEnd()
RETURN

/* S6b: the editor of the two masked fields, member of the HcAttrPaint() /
 * HcAttrCursor() family: the dialog's own paint block per change, the system
 * cursor hidden and its own BLOCK painted (SetCursor(1)+DevPos() paints zero
 * pixels in this driver, AGENTS.md section 3), and Inkey( 0.05 ) so the mouse
 * keeps working. It does NOT touch the control table: the field was registered
 * by HcAttrPaint() and a click on it reaches the dialog, not this editor.
 *
 * <cTpl> is the TEMPLATE of the field (HcAttrMaskTpl( "DATE" ) /
 * HcAttrMaskTpl( "TIME" )), so the date and the time are the same editor with
 * their own shape: the separators of the template are fixed and the cursor jumps
 * over them.
 *
 * The keys ARE the mask: a digit fills its slot and advances, a non-digit is
 * IGNORED (`/`, `:`, `-`, `.`, a letter), the arrows/Home/End walk slot to slot
 * and never stop on a separator, Backspace clears the slot and moves back,
 * Delete clears it, Enter confirms and Esc cancels leaving the field as it was.
 * When the last slot is filled the field confirms itself, like the classic GET
 * with SET CONFIRM OFF (the convention of the browser's cell editor), so a user
 * who types `01/01/2025` as free text ends up with the same date and the same
 * confirmation as before the mask existed. UiLineEdit() is NOT used here: it has
 * no mask and derives `MM/DD/YY` from DToC( Date() ), which is why the `Time:`
 * field had free text while the date was already masked.
 *
 * Answers the DISPLAY text the dialog keeps (the template's cells).
 *
 * <nFirstKey> (S6d) is OPTIONAL: the key that was already typed on the focused
 * field, as an Inkey() code, or 0/NIL for none. A digit there is applied BEFORE
 * the loop, on the slot this editor would open on, so typing on the focused
 * field edits it without pressing Enter first. <lHome> (S6f) is OPTIONAL too and
 * forces that opening slot to the FIRST digit one (see HcAttrMaskSeed()).
 *
 * <lFull> is an OPTIONAL by-reference answer (S6f): .T. only when the field
 * closed because the LAST digit slot was filled by typing - the SET CONFIRM OFF
 * path, either from the seeding digit or from one typed inside the editor - and
 * .F. for `Enter`, for `Esc` and for anything else. The dialog uses it to hand
 * the focus over to the NEXT control of the ring (HcAttrFillNext()), for EVERY
 * input of the dialog; the return value stays the text, so a caller that does
 * not care about why the field closed ignores the flag. */
STATIC FUNCTION HcAttrMaskEdit( nRow, nCol, cText, cTpl, nFirstKey, lHome, lFull )
   LOCAL cDig, nSlots, nSlot, nKey, cOldCur, lDone := .F., lOk := .F., aPt, nCell, aSeed
   lFull   := .F.
   aSeed   := HcAttrMaskSeed( cText, nFirstKey, cTpl, lHome )
   cDig    := aSeed[ 1 ]
   nSlot   := aSeed[ 2 ]
   lOk     := aSeed[ 3 ]
   lDone   := lOk
   /* S6f: the seeding digit completed the value, so this IS a close by
    * completion (the `Enter` path below never sets it) */
   lFull   := lOk
   nSlots  := HcMaskSlots( cTpl )
   cOldCur := SetCursor( 0 )
   IF ! lDone
      HcAttrMaskPaint( nRow, nCol, cDig, nSlot, cTpl )
   ENDIF
   DO WHILE ! lDone
      nKey := Inkey( 0.05 )
      /* right-click-esc (S1/S2/S7): a plain right click cancels this field
       * (and the box that owns it), the same as Esc in the mask editor */
      IF nKey == 0 .AND. HcMouseRightClick()
         nKey := K_ESC
      ENDIF
      IF nKey == 0
         /* the mouse: a click ON the mask puts the caret on the digit under the
          * pointer (a click on a separator is ignored) and a click anywhere else
          * does nothing, so a lost click can never close the field. Both readings
          * of the hook are consumed, so nothing leaks into the next screen
          * (AGENTS.md trap 65) */
         aPt := { HcMouseClickRow(), HcMouseClickCol() }
         HcMouseClickDbl()
         HcMouseWheel()
         IF aPt[ 1 ] == nRow .AND. aPt[ 2 ] >= nCol .AND. ;
            aPt[ 2 ] < nCol + HcAttrMaskCells( cTpl )
            nCell := HcAttrMaskSlot( aPt[ 2 ] - nCol, cTpl )
            IF nCell >= 0
               nSlot := nCell
               HcAttrMaskPaint( nRow, nCol, cDig, nSlot, cTpl )
            ENDIF
         ENDIF
         LOOP
      ENDIF
      DO CASE
      CASE nKey == K_ENTER
         lOk   := .T.
         lDone := .T.
      CASE nKey == K_ESC
         lDone := .T.
      CASE nKey == K_LEFT
         IF nSlot > 0
            nSlot--
         ENDIF
         HcAttrMaskPaint( nRow, nCol, cDig, nSlot, cTpl )
      CASE nKey == K_RIGHT
         IF nSlot < nSlots - 1
            nSlot++
         ENDIF
         HcAttrMaskPaint( nRow, nCol, cDig, nSlot, cTpl )
      CASE nKey == K_HOME
         nSlot := 0
         HcAttrMaskPaint( nRow, nCol, cDig, nSlot, cTpl )
      CASE nKey == K_END
         nSlot := nSlots - 1
         HcAttrMaskPaint( nRow, nCol, cDig, nSlot, cTpl )
      CASE nKey == K_BS
         /* clear the slot we are on and step back, so holding Backspace erases
          * the value from right to left */
         cDig := HcAttrMaskPut( cDig, nSlot, " ", cTpl )
         IF nSlot > 0
            nSlot--
         ENDIF
         HcAttrMaskPaint( nRow, nCol, cDig, nSlot, cTpl )
      CASE nKey == K_DEL
         cDig := HcAttrMaskPut( cDig, nSlot, " ", cTpl )
         HcAttrMaskPaint( nRow, nCol, cDig, nSlot, cTpl )
      CASE HcAttrDigitKey( nKey )
         cDig := HcAttrMaskType( cDig, nSlot, Chr( nKey ), cTpl )
         IF HcAttrMaskFill( nKey, nSlot, cTpl )
            /* the last slot: confirm (SET CONFIRM OFF), so a complete value is
             * never left half-confirmed. S6f: this is the "closed by
             * completion" path the dialog has to know about */
            lOk   := .T.
            lFull := .T.
            lDone := .T.
         ELSE
            nSlot++
            HcAttrMaskPaint( nRow, nCol, cDig, nSlot, cTpl )
         ENDIF
      OTHERWISE
         /* a typed `/`, `:`, `-`, `.`, a letter: IGNORED, the mask already
          * carries its separators, so the shape cannot be broken by typing */
      ENDCASE
   ENDDO
   SetCursor( cOldCur )
   IF lOk
      RETURN HcAttrMaskShow( cDig, cTpl )
   ENDIF
RETURN cText

/* S6g of odd/tasks/hc-file-attributes.md: the ONE call the dialog makes to edit
 * one of the two masked fields, so no branch can forget the hand-over. It runs
 * the mask editor (HcAttrMaskEdit()), asks it WHY it closed through its <lFull>
 * by-reference answer and turns that answer into the new focus with
 * HcAttrFocusAfter(), which walks the ring with HcAttrFillNext().
 *
 * Living here is what closes the gap the user's rule exposed: the digit typed on
 * the focused field, the `Enter` that OPENS the editor and any future way in all
 * end at the same place, because none of them can skip asking for the flag - the
 * two `Enter` branches used to call the editor without it, so a value completed
 * inside that editor left the focus where it was while the same digits typed
 * straight on the field handed it over.
 *
 * Answers { cText, nFocus, lHome }: the display text the dialog keeps, the
 * control that has the focus AFTER the edit and whether its caret sits on the
 * FIRST digit slot (only the two masked fields have one). A close that is not a
 * completion (`Enter`, `Esc`) answers the focus and no forced caret, so the S6d
 * rule is preserved. */
STATIC FUNCTION HcAttrMaskRun( nRow, nCol, cText, cTpl, nFirstKey, nFoc, lHome )
   LOCAL lFull := .F., aNext
   cText := HcAttrMaskEdit( nRow, nCol, cText, cTpl, nFirstKey, lHome, @lFull )
   aNext := HcAttrFocusAfter( nFoc, lFull )
RETURN { cText, aNext[ 1 ], aNext[ 2 ] }

 * <aAll>/<aAny> are the state of the four boxes (index 1..4 in the order of
 * HC_AT_RO..HC_AT_SYS; a box still showing [-] was not decided by the user) and
 * <dDate>/<cTime> the two halves of the stamp (NIL = that half was left empty
 * and has to be KEPT).
 *
 * Three things here are MEASURED, not assumed (L3 of the document):
 *   - hb_vfAttrSet() and hb_vfTimeSet() answer .T./.F., never a number, so the
 *     `IF <number>` trap of AGENTS.md does not apply but the .F. does.
 *   - hb_vfTimeSet() FAILS on a READ-ONLY file, so when a new stamp is asked
 *     for the R bit is cleared first and the final mask - which may set it again
 *     - is written after it.
 *   - a NIL half does NOT mean "leave it alone" to hb_vfTimeSet(): it resets
 *     that half to NOW. The current stamp of the file is read and the missing
 *     half filled from it, so an empty field really means "do not touch it". */
STATIC FUNCTION HcAttrApply( aWalk, aAll, aAny, dDate, cTime )
   LOCAL i, j, nOk := 0, nFail := 0, lCancel := .F., lMulti := ( Len( aWalk ) > 1 )
   LOCAL nAttr, nNew, dNew, cNew, dCur, cCur, lOk, aWant
   IF lMulti
      HcProgBegin( "Changing attributes", Len( aWalk ) )
   ENDIF
   FOR i := 1 TO Len( aWalk )
      IF lMulti
         IF HcProgStep( 1 )
            /* S7: what was already written STAYS written; the summary below
             * says `cancelled` */
            lCancel := .T.
            EXIT
         ENDIF
      ENDIF
      nAttr := 0
      IF ! hb_vfAttrGet( aWalk[ i ], @nAttr )
         nFail++
         LOOP
      ENDIF
      lOk  := .T.
      /* S4: a box still showing [-] means the user did NOT decide that bit, so
       * it is left exactly as this file has it. Without this, pressing `Apply`
       * to change only the date would strip an attribute from the entries that
       * happened to have it. One Space press turns the box into [X] (all of
       * them get it) and a second one into [ ] (none of them keeps it), so
       * every decided state is still one or two presses away. The decision is
       * the pure HcAttrWantBit(), and aWant is a NEW array: reusing aAll made
       * the mixed bit read that target's value for every later one. */
      aWant := {}
      FOR j := 1 TO 4
         AAdd( aWant, HcAttrWantBit( aAll[ j ], aAny[ j ], nAttr, HcAttrBit( j ) ) )
      NEXT
      nNew := HcAttrNewMask( nAttr, aWant[ 1 ], aWant[ 2 ], aWant[ 3 ], aWant[ 4 ] )
      dNew := NIL
      cNew := NIL
      IF ValType( dDate ) == "D" .OR. ValType( cTime ) == "C"
         dCur := NIL
         cCur := ""
         IF ! hb_vfTimeGet( aWalk[ i ], @dCur, @cCur )
            /* S6: the half the user did NOT type is taken from the file. If the
             * file cannot be read that half cannot be recovered, and writing the
             * stamp anyway would set "now" in silence (hb_vfTimeSet() treats a
             * NIL half as now), so this entry is counted as failed instead */
            lOk := .F.
         ENDIF
         IF ValType( dDate ) == "D"
            dNew := dDate
         ELSEIF ValType( dCur ) == "D"
            dNew := dCur
         ENDIF
         IF ValType( cTime ) == "C"
            cNew := cTime
         ELSE
            cNew := Left( cCur, 8 )
         ENDIF
      ENDIF
      IF ValType( dNew ) == "D" .AND. hb_bitAnd( nAttr, HB_FA_READONLY ) != 0
         IF ! hb_vfAttrSet( aWalk[ i ], hb_bitAnd( nAttr, hb_bitNot( HB_FA_READONLY ) ) )
            lOk := .F.
         ENDIF
      ENDIF
      IF ValType( dNew ) == "D" .AND. lOk
         IF ! HcSetStamp( aWalk[ i ], dNew, cNew )
            lOk := .F.
         ENDIF
      ENDIF
      /* the attributes are written ALWAYS - they are what the dialog is for -
       * even when the stamp of this file could not be written */
      IF ! hb_vfAttrSet( aWalk[ i ], nNew )
         lOk := .F.
      ENDIF
      IF lOk
         nOk++
      ELSE
         nFail++
      ENDIF
   NEXT
   IF lMulti
      HcProgEnd()
   ENDIF
RETURN { nOk, nFail, lCancel }

/* S6/S10 of hc-file-attributes.md: write the stamp of ONE path.
 *
 * The native helper goes first because it is the only way to stamp a DIRECTORY
 * in this build: hb_vfTimeSet() opens the path for writing and a directory
 * cannot be opened that way (Harbour hb_fsSetFileTime(), AGENTS.md trap 66), so
 * a directory used to be counted as failed. `hb_vfTimeSet()` stays as the
 * fallback: it serves the headless banks - they link bp_hc.prg WITHOUT
 * bp_win32.c, which is why the guard is here - and any path the native call
 * refuses. The scalar is compared with `!= 0` (AGENTS.md trap 59). */
STATIC FUNCTION HcSetStamp( cPath, dDate, cText )
   LOCAL lOk := .F.
#ifndef BP_HC_STANDALONE
   lOk := ( W32SETSTAMP( cPath, DToS( dDate ) + StrTran( cText, ":", "" ) ) != 0 )
#endif
   IF ! lOk
      lOk := hb_vfTimeSet( cPath, dDate, cText )
   ENDIF
RETURN lOk

/* S1/S3: the `File attributes` dialog, member of the HcLinkDialog() family:
 * geometry derived from the canvas with constants relative to the box, cursor
 * hidden BEFORE the first paint block, SaveScreen/RestScreen, ONE
 * UiPaintBegin()/UiPaintEnd() per change, a 0.05 s wait so the mouse is polled,
 * and the shared control table (HcSyncCtlReset/HcSyncCtlAdd/HcSyncCtlAt)
 * resolving the clicks into the very keys the keyboard sends.
 *
 * `Esc` cancels; a bad date or time is reported with the message of S6 and the
 * dialog STAYS OPEN (nothing is written before both fields pass). An `Esc`
 * inside the field editor only leaves that field, so the dialog is not closed by
 * a keystroke meant to discard one edit. */
STATIC PROCEDURE HcAttrDialog()
   LOCAL aP, aNames, aTop, aWalk, aTog, aAll, aAny, i, j
   LOCAL nFoc, lPaint, lDone, lSub, lApply
   LOCAL lHome
   LOCAL cDate, cTime, cNew, dDate, nT, nL, nR, nB, cSave, cOldCur, nKey
   LOCAL aCtl, cKind, aDt, aTm, nAttr, dCur, cCur, aRes, cTplD, cTplT, aEd
   LOCAL nShift, nBtn, cAltCh

   aP := HcPanelActive()
   /* S3 of commander-link.md: a linked panel is not a local one, so there is
    * nothing there whose attributes could be read or written */
   IF HcLinkPanel( aP )
      UiErr( "Commander Link: the remote panel is read-only, that action is not available.", ;
             "File attributes" )
      RETURN
   ENDIF
   aNames := HcAttrTargets( aP[ HC_P_LIST ], aP[ HC_P_SEL ] )
   IF Len( aNames ) == 0
      UiMsg( "There is nothing to change attributes for.", "File attributes" )
      RETURN
   ENDIF
   aTop := {}
   FOR i := 1 TO Len( aNames )
      AAdd( aTop, HcJoinPath( aP[ HC_P_DIR ], aNames[ i ] ) )
   NEXT
   /* S4: the starting state of the four boxes comes from EVERY target: all of
    * them have it -> [X], none -> [ ], they disagree -> [-] */
   aAll := { .T., .T., .T., .T. }
   aAny := { .F., .F., .F., .F. }
   FOR i := 1 TO Len( aTop )
      nAttr := 0
      IF ! hb_vfAttrGet( aTop[ i ], @nAttr )
         LOOP
      ENDIF
      FOR j := 1 TO 4
         IF hb_bitAnd( nAttr, HcAttrBit( j ) ) != 0
            aAny[ j ] := .T.
         ELSE
            aAll[ j ] := .F.
         ENDIF
      NEXT
   NEXT
   /* S6: both fields start with the values of the FIRST target; S6b: each one
    * opens as its MASK shows it (`01/01/2025` / `17:42:13`, or `  /  /    ` /
    * `  :  :  ` when the first target has no stamp at all) */
   cTplD  := HcAttrMaskTpl( "DATE" )
   cTplT  := HcAttrMaskTpl( "TIME" )
   dCur := NIL
   cCur := ""
   hb_vfTimeGet( aTop[ 1 ], @dCur, @cCur )
   cDate  := HcAttrMaskShow( HcAttrMaskDigits( HcAttrDateText( dCur ), cTplD ), cTplD )
   cTime  := HcAttrMaskShow( HcAttrMaskDigits( Left( cCur, 8 ), cTplT ), cTplT )
   nFoc   := HC_AT_RO
   lPaint := .T.
   lDone  := .F.
   lSub   := .F.
   lApply := .F.
   /* S6f: .T. while `Time:` is the field with the focus and its caret was forced
    * to the first digit slot, which is the state completing `Date:` by typing
    * leaves behind. It is a local of this dialog (no module state that could leak
    * into another screen) and every key or click that decides the focus by itself
    * clears it. */
   lHome  := .F.
   dDate  := NIL
   cNew   := NIL
   aDt    := { .T., NIL }
   aTm    := { .T., NIL }

   nR := Min( HC_AT_W, Max( 44, MaxCol() + 1 - 6 ) )
   nB := HcAttrBoxH()
   nT := UiFitRow( UiCenterRow( nB + 1 ), nB + 1 )
   nL := UiFitCol( UiCenterCol( nR ), nR + 1 )
   /* Log L14: whatever the hook recorded BEFORE the box opened (an
    * Alt+<letter> of the panel left pending) is not a quick key of this dialog,
    * so it is discarded once - the same line HcFindDlg() has. */
   HcAltHookFlush()
   cOldCur := SetCursor( 0 )
   cSave := SaveScreen( nT, nL, nT + nB + 1, Min( nL + nR + 1, MaxCol() ) )
   DO WHILE ! lDone
      IF lPaint
         UiPaintBegin()
         HcSyncCtlReset()          /* the clickable controls, rebuilt */
         HcAttrPaint( nT, nL, nR, nB, aNames, aAll, aAny, cDate, cTime, lSub, nFoc )
         UiPaintEnd()
         /* the cursor goes AFTER the paint block, which restores the cursor */
         HcAttrCursor( nT, nL, nFoc, cDate, cTime, lHome )
         lPaint := .F.
      ENDIF
      nKey := Inkey( 0.05 )
      /* T1: the modifier state of that very key, read IMMEDIATELY after Inkey()
       * (this driver answers the LIVE state, AGENTS trap 37): HcAttrBtnHot()
       * needs the ALT bit to accept the chord and the CTRL bit to refuse
       * Ctrl+letter, which on a Spanish keyboard is the AltGr that types a
       * character (AGENTS trap 38) */
      nShift := HcShiftState()
      /* Log L14/S14 of hc-replace-editor.md: the quick keys are `Alt+<letter>`
       * and inside a modal this driver can SWALLOW the letter from Inkey() (AGENTS
       * trap 61), so the window hook's ring is the channel - exactly as in
       * HcFindDlg(), which measured it. What the ring recorded WINS over what
       * Inkey() delivered; one keystroke is one character, hence the first
       * pending letter stands in for the key with the ALT bit it was typed with. */
      cAltCh := HcHookDrain()
      IF Len( cAltCh ) > 0
         nKey   := Asc( Left( cAltCh, 1 ) )
         nShift := HB_GTI_KBD_ALT
      ENDIF
      /* right-click-esc (S1/S2/S7): a plain right click cancels the box, the
       * same as Esc (and as its Cancel button, which is the same CASE) */
      IF nKey == 0 .AND. HcMouseRightClick()
         nKey := K_ESC
      ENDIF
      IF nKey == 0
         aCtl := HcSyncCtlAt( HcMouseClickRow(), HcMouseClickCol() )
         /* both are read once, so nothing of the hook leaks into the next
          * screen (AGENTS.md trap 65) */
         HcMouseClickDbl()
         HcMouseWheel()
         IF hb_IsNIL( aCtl )
            LOOP                   /* a click outside the box changes nothing */
         ENDIF
         lHome := .F.              /* a click decides the focus: no forced caret */
         cKind := aCtl[ 5 ]
         DO CASE
         CASE cKind == "RO"
            nFoc := HC_AT_RO
            nKey := K_SPACE
         CASE cKind == "AR"
            nFoc := HC_AT_AR
            nKey := K_SPACE
         CASE cKind == "HID"
            nFoc := HC_AT_HID
            nKey := K_SPACE
         CASE cKind == "SYS"
            nFoc := HC_AT_SYS
            nKey := K_SPACE
         CASE cKind == "SUB"
            nFoc := HC_AT_SUB
            nKey := K_SPACE
         CASE cKind == "DATE"
            /* one click focuses the field, the click on the FOCUSED field
             * enters its editor, like the fields of the zip and link dialogs */
            IF nFoc == HC_AT_DATE
               nKey := K_ENTER
            ELSE
               nFoc := HC_AT_DATE
               lPaint := .T.
            ENDIF
         CASE cKind == "TIME"
            IF nFoc == HC_AT_TIME
               nKey := K_ENTER
            ELSE
               nFoc := HC_AT_TIME
               lPaint := .T.
            ENDIF
         CASE cKind == "APPLY"
            nFoc := HC_AT_APPLY
            nKey := K_ENTER
         CASE cKind == "CANCEL"
            nFoc := HC_AT_CANCEL
            nKey := K_ENTER
         ENDCASE
      ENDIF
      IF nKey == 0
         LOOP
      ENDIF
      /* T1 (S11) + Log L14: the QUICK KEY of a button - `Alt+A` / `Alt+C` - acts
       * exactly like `Enter` on it, from anywhere in the dialog: the focus moves
       * to that button and the key is turned into the very `Enter` the branches
       * below already handle, so there is ONE implementation of Apply and ONE of
       * Cancel and they cannot diverge. A BARE `A`/`C` is not a quick key (it
       * answers 0): on a masked field the mask ignores it (only digits enter) and
       * anywhere else it does nothing at all, which is what the user asked for.
       * CTRL - and so AltGr, which is Ctrl+Alt - is refused by HcAttrBtnHot(). */
      nBtn := HcAttrBtnHot( nKey, nShift )
      DO CASE
      CASE nBtn == 1
         nFoc  := HC_AT_APPLY
         lHome := .F.
         nKey  := K_ENTER
      CASE nBtn == 2
         nFoc  := HC_AT_CANCEL
         lHome := .F.
         nKey  := K_ENTER
      ENDCASE
#ifndef BP_HC_STANDALONE
      /* the same diagnostic as the key loop of the panels and of the
       * `Find / Replace` box, for the same reason: with BP_DEBUG=1, hwbro.err
       * says what the driver delivered, what the window hook recorded and which
       * button the quick key ran, so a report from a user machine shows which
       * CHANNEL carried the `Alt+<letter>` of the buttons (Log L14). */
      BpLog( "HcAttr key=" + LTrim( Str( nKey ) ) + " shift=" + LTrim( Str( nShift ) ) + ;
             " ring=[" + cAltCh + "] btn=" + LTrim( Str( nBtn ) ) + ;
             " foc=" + LTrim( Str( nFoc ) ) + " hc=" + LTrim( Str( HcAltHookTotal() ) ) )
#endif
      DO CASE
      CASE nKey == K_ESC
         lDone := .T.
      CASE nKey == K_TAB .OR. nKey == K_DOWN
         nFoc := HcAttrFocusStep( nFoc, 1 )
         lHome := .F.
         lPaint := .T.
      CASE nKey == K_SH_TAB .OR. nKey == K_UP
         nFoc := HcAttrFocusStep( nFoc, -1 )
         lHome := .F.
         lPaint := .T.
      CASE nFoc == HC_AT_RO .AND. HcAttrHot( nKey )
         aTog := HcAttrToggle( aAll[ 1 ], aAny[ 1 ] )
         aAll[ 1 ] := aTog[ 1 ]
         aAny[ 1 ] := aTog[ 2 ]
         lPaint := .T.
      CASE nFoc == HC_AT_AR .AND. HcAttrHot( nKey )
         aTog := HcAttrToggle( aAll[ 2 ], aAny[ 2 ] )
         aAll[ 2 ] := aTog[ 1 ]
         aAny[ 2 ] := aTog[ 2 ]
         lPaint := .T.
      CASE nFoc == HC_AT_HID .AND. HcAttrHot( nKey )
         aTog := HcAttrToggle( aAll[ 3 ], aAny[ 3 ] )
         aAll[ 3 ] := aTog[ 1 ]
         aAny[ 3 ] := aTog[ 2 ]
         lPaint := .T.
      CASE nFoc == HC_AT_SYS .AND. HcAttrHot( nKey )
         aTog := HcAttrToggle( aAll[ 4 ], aAny[ 4 ] )
         aAll[ 4 ] := aTog[ 1 ]
         aAny[ 4 ] := aTog[ 2 ]
         lPaint := .T.
      CASE nFoc == HC_AT_SUB .AND. HcAttrHot( nKey )
         lSub := ! lSub
         lPaint := .T.
      CASE ( nFoc == HC_AT_DATE .OR. nFoc == HC_AT_TIME ) .AND. HcAttrDigitKey( nKey )
         /* S6d: a DIGIT typed on the focused field STARTS the edit - the user's
          * report. The keystroke is handed to the masked editor as its first key,
          * so it lands on the slot the editor opens on and the caret advances,
          * exactly as if it had been typed inside the editor, and Enter is not
          * needed. The SAME rule serves the two fields.
          * S6f/S6g: <lHome> is only the caret the hand-over from `Date:` left on
          * the clock's first digit, and HcAttrMaskRun() is what turns a close BY
          * COMPLETION into the hand-over of the ring: the digit typed here, the
          * `Enter` that opens the editor and any future way in all go through
          * that one call, so none of them can forget the hand-over. */
         IF nFoc == HC_AT_DATE
            aEd := HcAttrMaskRun( nT + HC_AT_R_DATE, nL + HC_AT_COL_L + 6, ;
                                  cDate, cTplD, nKey, nFoc, lHome )
            cDate := aEd[ 1 ]
         ELSE
            aEd := HcAttrMaskRun( nT + HC_AT_R_DATE, nL + HC_AT_COL_R + 6, ;
                                  cTime, cTplT, nKey, nFoc, lHome )
            cTime := aEd[ 1 ]
         ENDIF
         /* Log L14: an Alt+<letter> typed INSIDE the field editor is a plain
          * letter to the mask, so what the hook recorded meanwhile is NOT a
          * quick key of the box afterwards - the same flush HcFindDlg() does
          * after closing one of its fields */
         HcAltHookFlush()
         /* S6f, GENERALISED (the user: "luego de tipear la fecha, se debe pasar
          * el foco automaticamente al primer caracter de la hora" and then «Esto
          * debe suceder en todos los inputs»): when a field closes because its
          * LAST slot was filled by TYPING, it hands the focus to the NEXT control
          * of the ring - whatever that control is. `Date:` -> `Time:` with its
          * caret on the first digit (the next control is a masked field), and
          * `Time:` -> `Include subdirectories`, the last input of the dialog,
          * where the clock's block caret stops being painted because the clock is
          * no longer the focused field. The next control is asked to
          * HcAttrFillNext(), which walks HcAttrFocusStep() - the ring itself - so
          * the hand-over follows the focus order instead of a constant pasted
          * here. `Enter` and `Esc` never set the flag, so the S6d rule (only `Tab`
          * moves the focus on those two) still holds. */
         nFoc   := aEd[ 2 ]
         lHome  := aEd[ 3 ]
         lPaint := .T.
      CASE nFoc == HC_AT_DATE .AND. nKey == K_ENTER
         /* S6b: the field is edited with its own MASK editor; UiLineEdit() has
          * no mask and would let the shape be broken by typing. S6d: closing the
          * editor with `Enter`/`Esc` does NOT move the focus, so Tab is what
          * decides where to go (it used to jump to Time:). S6g: completing the
          * value INSIDE this editor DOES hand the focus over, exactly like typing
          * straight on the focused field - HcAttrMaskRun() asks the editor why it
          * closed and applies the same ring step, so the way the editor was
          * opened cannot change where the focus ends (the user's rule, Log L12). */
         aEd := HcAttrMaskRun( nT + HC_AT_R_DATE, nL + HC_AT_COL_L + 6, ;
                               cDate, cTplD, NIL, nFoc, lHome )
         HcAltHookFlush()
         cDate  := aEd[ 1 ]
         nFoc   := aEd[ 2 ]
         lHome  := aEd[ 3 ]
         lPaint := .T.
      CASE nFoc == HC_AT_TIME .AND. nKey == K_ENTER
         /* S6b: the SAME masked editor, with the `:` of the time's template, so
          * the clock is as fixed as the date. UiLineEdit() was free text.
          * S6d: `Enter`/`Esc` keep the focus on Time: (it used to jump to Include
          * subdirs). S6f: <lHome> so the editor opens on the digit the caret is
          * on. S6g: and a value completed inside it hands the focus to the next
          * control of the ring, through the same HcAttrMaskRun(). */
         aEd := HcAttrMaskRun( nT + HC_AT_R_DATE, nL + HC_AT_COL_R + 6, ;
                               cTime, cTplT, NIL, nFoc, lHome )
         HcAltHookFlush()
         cTime  := aEd[ 1 ]
         nFoc   := aEd[ 2 ]
         lHome  := aEd[ 3 ]
         lPaint := .T.
      CASE nFoc == HC_AT_APPLY .AND. ( nKey == K_ENTER .OR. nKey == K_SPACE )
         /* S6: both fields are validated BEFORE anything is written; a bad one
          * is reported and the dialog stays open on the field to fix */
         aDt := HcAttrDateVal( cDate )
         aTm := HcAttrTimeVal( cTime )
         IF ! aDt[ 1 ]
            UiErr( "Invalid date: " + AllTrim( cDate ) + ".", "File attributes" )
            nFoc := HC_AT_DATE
            lPaint := .T.
         ELSEIF ! aTm[ 1 ]
            UiErr( "Invalid time: " + AllTrim( cTime ) + ".", "File attributes" )
            nFoc := HC_AT_TIME
            lPaint := .T.
         ELSE
            lApply := .T.
            lDone  := .T.
         ENDIF
      CASE nFoc == HC_AT_CANCEL .AND. ( nKey == K_ENTER .OR. nKey == K_SPACE )
         lDone := .T.
      ENDCASE
   ENDDO
   RestScreen( nT, nL, nT + nB + 1, Min( nL + nR + 1, MaxCol() ), cSave )
   IF lApply
      dDate := aDt[ 2 ]
      cNew  := aTm[ 2 ]
      /* S7: a directory target always changes its own attributes; its tree only
       * with `Include subdirectories`. The paths are de-duplicated, so a marked
       * file that is also inside a marked directory is written ONCE. */
      aWalk := {}
      FOR i := 1 TO Len( aTop )
         aTog := HcAttrWalk( aTop[ i ], lSub )
         FOR j := 1 TO Len( aTog )
            IF AScan( aWalk, {| c | Upper( c ) == Upper( aTog[ j ] ) } ) == 0
               AAdd( aWalk, aTog[ j ] )
            ENDIF
         NEXT
      NEXT
      aRes := HcAttrApply( aWalk, aAll, aAny, dDate, cNew )
      /* S8: the attributes of an entry may have changed, so BOTH panels are
       * reloaded from disk (listing and status row) before the result is
       * reported */
      HcLoad( HcPanel( HC_PANEL_L ) )
      HcLoad( HcPanel( HC_PANEL_R ) )
      HcDrawScreen()
      UiMsg( HcAttrSummary( aRes[ 1 ], aRes[ 2 ], aRes[ 3 ] ), "File attributes" )
   ENDIF
   SetCursor( cOldCur )
   SetColor( UI_C_DESKTOP )
RETURN

/* ===== File search: the pure core (S3..S8) ===== */

/* S3 of odd/tasks/hc-file-search.md: the default state of the File search
 * screen, one slot per FSX_* of bp_def.ch. The two fields that hold numbers
 * (FSX_NDAYS / FSX_SVAL) are STRINGS because they are typed into a field: the
 * pure rules below turn them into numbers with Val(), so a half-typed value
 * costs nothing instead of breaking the search. FSX_DIR stays empty on purpose:
 * the CALLER fills it with the directory of the active panel (this module has no
 * panel here, and the bank has no screen). Array() does not fill (trap 26), so
 * every slot is written by name. */
FUNCTION HcFsState()
   LOCAL aSt := Array( FSX_REPL )
   aSt[ FSX_MASK ]    := "*.*"
   aSt[ FSX_DIR ]     := ""
   aSt[ FSX_MASKRE ]  := .F.
   aSt[ FSX_ONLYSEL ] := .F.
   aSt[ FSX_DEPTH ]   := -1
   aSt[ FSX_TEXT ]    := ""
   aSt[ FSX_TXT ]     := .F.
   aSt[ FSX_WORD ]    := .F.
   aSt[ FSX_CASE ]    := .F.
   aSt[ FSX_RE ]      := .F.
   aSt[ FSX_HEX ]     := .F.
   aSt[ FSX_NOT ]     := .F.
   aSt[ FSX_DATES ]   := .F.
   aSt[ FSX_DATE1 ]   := CToD( "" )
   aSt[ FSX_DATE2 ]   := CToD( "" )
   aSt[ FSX_DAYS ]    := .F.
   aSt[ FSX_NDAYS ]   := "1"
   aSt[ FSX_SIZE ]    := .F.
   aSt[ FSX_SOP ]     := "="
   aSt[ FSX_SVAL ]    := "1"
   aSt[ FSX_SUNIT ]   := 2
   aSt[ FSX_MSG ]     := ""
   /* the `Replace with:` line: the box starts OFF and the replacement empty, so
    * nothing can be written until the user turns it on and types a text */
   aSt[ FSX_REPLON ]  := .F.
   aSt[ FSX_REPL ]    := ""
RETURN aSt

/* S3: the session memory. The array is COPIED element by element (arrays are
 * references in Harbour - trap 67 -, so `s_aFsSt := aSt` would alias the
 * screen's state and the "remembered" defaults would follow the live edits).
 * PUBLIC (a FUNCTION, not one of the STATIC PROCEDUREs of the screen) because
 * the headless bank has to drive the session memory to pin the merge rule of
 * HcFsRestore(); it answers .T. when it stored something.
 * L8 of odd/tasks/hc-file-search.md: the FOLDER is the one exception and is
 * NEVER remembered. `Search in:` starts at the directory of the active panel
 * every time the screen opens (HcSearchDir()), so a path kept here would win
 * over the panel and the field would stop following it - exactly the defect
 * the user reported. The mask and the options do travel in the memory. */
FUNCTION HcFsSaveState( aSt )
   LOCAL aCopy := {}, i
   IF ! HB_ISARRAY( aSt )
      RETURN .F.
   ENDIF
   FOR i := 1 TO Len( aSt )
      AAdd( aCopy, aSt[ i ] )
   NEXT
   IF Len( aCopy ) >= FSX_DIR .AND. ValType( aCopy[ FSX_DIR ] ) == "C"
      aCopy[ FSX_DIR ] := ""
   ENDIF
   s_aFsSt := aCopy
RETURN .T.

/* S3: a fresh state with the session memory merged over it, slot by slot and
 * ONLY when the remembered slot has the same ValType as the default one. That
 * guard is the whole point: a stale or foreign array (another feature's state,
 * a NIL slot, a number where a string goes) can never poison the screen, it
 * simply leaves the default in place. The caller gets the same array it passed
 * when it passed a good one, and a new one otherwise. */
FUNCTION HcFsRestore( aSt )
   LOCAL i, nMax
   IF ! HB_ISARRAY( aSt )
      aSt := HcFsState()
   ENDIF
   IF ! HB_ISARRAY( s_aFsSt )
      RETURN aSt
   ENDIF
   nMax := Min( Len( aSt ), Len( s_aFsSt ) )
   FOR i := 1 TO nMax
      IF ValType( s_aFsSt[ i ] ) == ValType( aSt[ i ] )
         aSt[ i ] := s_aFsSt[ i ]
      ENDIF
   NEXT
RETURN aSt

/* S3: a COPY of a result list, rows included, because arrays are references in
 * Harbour (AGENTS trap 67) and the screen edits its rows in place. A slot that
 * is not an array travels as it is, and anything that is not a list at all
 * answers an empty one. PURE. */
STATIC FUNCTION HcFsResCopy( aRes )
   LOCAL aOut := {}, aRow, i, j
   IF ! HB_ISARRAY( aRes )
      RETURN aOut
   ENDIF
   FOR i := 1 TO Len( aRes )
      IF HB_ISARRAY( aRes[ i ] )
         aRow := Array( Len( aRes[ i ] ) )
         FOR j := 1 TO Len( aRes[ i ] )
            aRow[ j ] := aRes[ i ][ j ]
         NEXT
         AAdd( aOut, aRow )
      ELSE
         AAdd( aOut, aRes[ i ] )
      ENDIF
   NEXT
RETURN aOut

/* S3: store the results of the search that just ran, so the screen can show them
 * again on the next visit. PUBLIC and PURE of the screen (no paint, no keyboard)
 * so the bank drives it: it answers the packet it stored - { aRes, nSel, nTop,
 * cDir }, always a COPY - and {} when it stored NOTHING.
 *
 * A list that is not a list, or an EMPTY one, stores nothing and CLEARS what was
 * remembered: the last search is the truth, and a search that found nothing must
 * not leave the previous results looking like the answer of this one. The cursor
 * is clamped into the list it is stored with (1 when it is not a number) and the
 * scroll top is kept as a 1-based row (the screen clamps it again when it puts
 * it back with HcSearchSet()). */
FUNCTION HcSearchRemember( aRes, nSel, nTop, cDir )
   s_aFsRes    := NIL
   s_nFsResSel := 0
   s_nFsResTop := 1
   s_cFsResDir := ""
   IF ! HB_ISARRAY( aRes ) .OR. Len( aRes ) == 0
      RETURN {}
   ENDIF
   s_aFsRes    := HcFsResCopy( aRes )
   s_nFsResSel := 1
   IF ValType( nSel ) == "N"
      s_nFsResSel := Max( 1, Min( Int( nSel ), Len( s_aFsRes ) ) )
   ENDIF
   IF ValType( nTop ) == "N"
      s_nFsResTop := Max( 1, Int( nTop ) )
   ENDIF
   s_cFsResDir := iif( ValType( cDir ) == "C", cDir, "" )
RETURN { HcFsResCopy( s_aFsRes ), s_nFsResSel, s_nFsResTop, s_cFsResDir }

/* S3: what the screen puts back when it opens: { aRes, nSel, nTop, cDir } with a
 * COPY of the remembered list, or {} when nothing was remembered. A cursor that
 * is no longer inside the list (the memory is a plain pair of numbers) is
 * clamped to its last row instead of pointing at a row that does not exist.
 * PURE. */
FUNCTION HcSearchRecall()
   LOCAL aCopy, n
   IF ! HB_ISARRAY( s_aFsRes ) .OR. Len( s_aFsRes ) == 0
      RETURN {}
   ENDIF
   aCopy := HcFsResCopy( s_aFsRes )
   n     := Len( aCopy )
RETURN { aCopy, Max( 1, Min( s_nFsResSel, n ) ), Max( 1, s_nFsResTop ), s_cFsResDir }

/* S3: are these two paths the same folder? The panel and the `Search in:` field
 * build the path differently (a trailing separator, the case of a drive), so the
 * comparison trims both, drops the trailing separators and ignores the case. An
 * empty side is NEVER the same folder: Empty() is true for a string of spaces
 * (AGENTS trap 46), so the question is asked with Len(). PURE. */
STATIC FUNCTION HcFsSameDir( cA, cB )
   LOCAL cX := Upper( AllTrim( iif( ValType( cA ) == "C", cA, "" ) ) )
   LOCAL cY := Upper( AllTrim( iif( ValType( cB ) == "C", cB, "" ) ) )
   DO WHILE Len( cX ) > 1 .AND. ( Right( cX, 1 ) == "\" .OR. Right( cX, 1 ) == "/" )
      cX := Left( cX, Len( cX ) - 1 )
   ENDDO
   DO WHILE Len( cY ) > 1 .AND. ( Right( cY, 1 ) == "\" .OR. Right( cY, 1 ) == "/" )
      cY := Left( cY, Len( cY ) - 1 )
   ENDDO
   IF Len( cX ) == 0 .OR. Len( cY ) == 0
      RETURN .F.
   ENDIF
RETURN cX == cY

/* S3: the message row when the screen reopens with the remembered results. Same
 * folder as the one `Search in:` is showing now: the plain count. A DIFFERENT
 * folder: the folder is spelled out, so an old result list under a new path is
 * never silent. PURE. */
STATIC FUNCTION HcSearchRecallMsg( nCount, cResDir, cDir )
   LOCAL cOld := AllTrim( iif( ValType( cResDir ) == "C", cResDir, "" ) )
   IF Len( cOld ) > 0 .AND. ! HcFsSameDir( cOld, cDir )
      RETURN "Results from " + cOld + "."
   ENDIF
RETURN LTrim( Str( iif( ValType( nCount ) == "N", nCount, 0 ) ) ) + " result(s)."

/* S3/L8: the folder proposed in `Search in:` when the screen opens. It is
 * ALWAYS the directory the ACTIVE panel is showing, never a remembered path:
 * the user reported that the field did not take the path he was standing on in
 * the active panel. A Commander Link panel has no LOCAL path - its HC_P_DIR is
 * an absolute path of the PEER and is never handed to the local filesystem -,
 * so a linked panel falls back to the OTHER panel when that one is local, and
 * when both are linked the caller keeps whatever the field had. The flag of the
 * record is the whole test, so the rule is PURE and the bank pins it without a
 * window; a stale flag at worst proposes the other panel's folder.
 * Empty() is true for a string of spaces (trap 46), so the "is there a path?"
 * question is asked with Len( AllTrim( ... ) ). PURE. */
FUNCTION HcSearchDir( aPanel, aOther )
   LOCAL cDir := HcSearchPanelDir( aPanel )
   IF Len( AllTrim( cDir ) ) == 0
      cDir := HcSearchPanelDir( aOther )
   ENDIF
RETURN cDir

/* the local folder of ONE panel record: "" when it is a Commander Link one
 * (its path belongs to the peer) or when the record is not a panel at all */
STATIC FUNCTION HcSearchPanelDir( aP )
   IF ! HB_ISARRAY( aP ) .OR. Len( aP ) < HC_P_LINK
      RETURN ""
   ENDIF
   IF ValType( aP[ HC_P_LINK ] ) == "L" .AND. aP[ HC_P_LINK ]
      RETURN ""
   ENDIF
   IF ValType( aP[ HC_P_DIR ] ) != "C"
      RETURN ""
   ENDIF
RETURN aP[ HC_P_DIR ]

/* S1: is this keystroke the `Ctrl-F` of the file manager? In this driver
 * `Ctrl-F` arrives as the CODE 6, which inkey.ch calls K_END AND K_CTRL_F at
 * the same time (measured, trap 37), so the only thing that separates it from a
 * plain End is the CTRL bit of HB_GTI_KBDSHIFTS, read immediately after
 * Inkey(). ALT is rejected: on a Spanish keyboard AltGr is Ctrl+Alt (trap 38)
 * and AltGr+F types a character, it does not search. F7 is rejected on purpose:
 * in the manager F7 is `Make directory`. PURE. */
FUNCTION HcSearchKey( nKey, nShift )
   LOCAL lCtrl, lAlt
   IF ValType( nShift ) != "N"
      nShift := 0
   ENDIF
   lCtrl := hb_bitAnd( nShift, HB_GTI_KBD_CTRL ) != 0
   lAlt  := hb_bitAnd( nShift, HB_GTI_KBD_ALT ) != 0
   IF lAlt .OR. ! lCtrl
      RETURN .F.
   ENDIF
RETURN nKey == K_CTRL_F .OR. nKey == K_END

/* S4: does this name pass the mask of the form? Without FSX_MASKRE the mask is
 * the DOS list of the marks (`*`, `?`, separated by `;`/`,`), compared by
 * HcMaskMatch(): ONE comparator for the marks of the panel and the search, so
 * `*.prg;*.ch` means the same in both places. With FSX_MASKRE the mask is a
 * PCRE over the whole name, compiled CASE-INSENSITIVELY like the plain mask
 * (a mask behaves the same with and without `Regular expression`), so a pattern
 * that NEEDS case sensitivity says so itself with `(?-i)`. A pattern that does
 * not compile matches NOTHING: it is reported by HcFsBad(), never thrown. PURE
 * (no disk, no screen). */
FUNCTION HcFsMaskOk( cName, aSt )
   LOCAL cMask, aMt
   IF ValType( cName ) != "C"
      RETURN .F.
   ENDIF
   IF ! HB_ISARRAY( aSt ) .OR. Len( aSt ) < FSX_MASK
      RETURN .F.
   ENDIF
   cMask := iif( ValType( aSt[ FSX_MASK ] ) == "C", aSt[ FSX_MASK ], "" )
   IF aSt[ FSX_MASKRE ] != .T.
      RETURN HcMaskMatch( cMask, cName )
   ENDIF
   IF Len( cMask ) == 0
      RETURN .F.
   ENDIF
   aMt := HcMatcher( cMask, .F., .F., .T. )
   IF ! HB_ISARRAY( aMt ) .OR. aMt[ HM_BAD ] == .T.
      RETURN .F.
   ENDIF
RETURN Len( HcLineMatches( cName, aMt ) ) > 0

/* S5: the `Subdirectories:` chip as text. Any value that is not one of the six
 * of the cycle reads as `All`, the widest one: a corrupted state searches more,
 * never less. PURE. */
FUNCTION HcFsDepthText( n )
   IF ValType( n ) != "N"
      RETURN "All"
   ENDIF
   DO CASE
   CASE n == 0
      RETURN "None"
   CASE n == 1
      RETURN "1"
   CASE n == 2
      RETURN "2"
   CASE n == 3
      RETURN "3"
   CASE n == 5
      RETURN "5"
   ENDCASE
RETURN "All"

/* S5: the next / previous value of the cycle -1 (all), 0 (none), 1, 2, 3, 5,
 * wrapping at BOTH ends, so `<-` on `All` lands on `5` and `->` on `5` comes
 * back to `All`. An unknown value starts the walk on `All`. PURE. */
FUNCTION HcFsDepthStep( n, nDir )
   LOCAL aStep := { -1, 0, 1, 2, 3, 5 }, nAt := 1, i
   IF ValType( n ) == "N"
      FOR i := 1 TO Len( aStep )
         IF aStep[ i ] == n
            nAt := i
         ENDIF
      NEXT
   ENDIF
   IF ValType( nDir ) != "N" .OR. nDir == 0
      nDir := 1
   ENDIF
   nAt += iif( nDir > 0, 1, -1 )
   IF nAt > Len( aStep )
      nAt := 1
   ELSEIF nAt < 1
      nAt := Len( aStep )
   ENDIF
RETURN aStep[ nAt ]

/* S5: the three filters of the `Advanced` tab, ANDed. `aEntry` is one entry as
 * HcReadDir() answers it (name, size, date, attr, ...), so only the first four
 * slots are read and both the 5 and the 6 element shapes work. A NIL or
 * ill-typed entry SATISFIES every filter: the walk keeps going and nothing
 * crashes on a listing the OS answered strangely. The date range is INCLUSIVE
 * and an empty bound (CToD( "" )) does not bound that side; the age filter is
 * `date >= Date() - N`; the size is compared against `value * unit`. PURE. */
FUNCTION HcFsFilterOk( aEntry, aSt )
   LOCAL dDate, nSize, nVal, nUnit
   IF ! HB_ISARRAY( aEntry ) .OR. Len( aEntry ) < 3
      RETURN .T.
   ENDIF
   IF ! HB_ISARRAY( aSt ) .OR. Len( aSt ) < FSX_SIZE
      RETURN .T.
   ENDIF
   dDate := aEntry[ 3 ]
   IF ValType( dDate ) == "T"
      /* the listing hands the date over as a TIMESTAMP (measured: hb_DirScan()/
       * hb_vfDirectory() answer "T" and HcDateStr() has to do hb_TToD()), so a
       * real row of HcReadDir() is filtered on its DAY */
      dDate := iif( Empty( dDate ), CToD( "" ), hb_TToD( dDate ) )
   ENDIF
   IF ValType( dDate ) != "D"
      dDate := NIL
   ENDIF
   /* S5: date range. Empty( d ) is the test for "no bound" and it is a DATE,
    * not a string of blanks (a blank date is Empty, trap 46 does not apply) */
   IF aSt[ FSX_DATES ] == .T. .AND. ValType( dDate ) == "D"
      IF ValType( aSt[ FSX_DATE1 ] ) == "D" .AND. ! Empty( aSt[ FSX_DATE1 ] )
         IF dDate < aSt[ FSX_DATE1 ]
            RETURN .F.
         ENDIF
      ENDIF
      IF ValType( aSt[ FSX_DATE2 ] ) == "D" .AND. ! Empty( aSt[ FSX_DATE2 ] )
         IF dDate > aSt[ FSX_DATE2 ]
            RETURN .F.
         ENDIF
      ENDIF
   ENDIF
   /* S5: age in days, counted back from today */
   IF aSt[ FSX_DAYS ] == .T. .AND. ValType( dDate ) == "D"
      nVal := Val( iif( ValType( aSt[ FSX_NDAYS ] ) == "C", aSt[ FSX_NDAYS ], "0" ) )
      IF dDate < Date() - Int( nVal )
         RETURN .F.
      ENDIF
   ENDIF
   /* S5: size against value * unit. The comparison is strict, so `>` on the
    * same size is false, exactly like the chip reads */
   IF aSt[ FSX_SIZE ] == .T.
      nUnit := iif( ValType( aSt[ FSX_SUNIT ] ) == "N", aSt[ FSX_SUNIT ], 1 )
      nUnit := iif( nUnit == 2, 1024, iif( nUnit == 3, 1024 * 1024, 1 ) )
      nVal  := Val( iif( ValType( aSt[ FSX_SVAL ] ) == "C", aSt[ FSX_SVAL ], "0" ) ) * nUnit
      nSize := iif( ValType( aEntry[ 2 ] ) == "N", aEntry[ 2 ], 0 )
      DO CASE
      CASE aSt[ FSX_SOP ] == ">"
         IF ! ( nSize > nVal )
            RETURN .F.
         ENDIF
      CASE aSt[ FSX_SOP ] == "<"
         IF ! ( nSize < nVal )
            RETURN .F.
         ENDIF
      OTHERWISE
         IF ! ( nSize == nVal )
            RETURN .F.
         ENDIF
      ENDCASE
   ENDIF
RETURN .T.

/* S6: the walk. Answers { { cPath, aEntry }, ... } of the FILES under cDir that
 * pass the mask (S4) and the filters (S5). The listing comes from HcReadDir(),
 * the same call the panels use (never hb_DirScan, trap 3), so the walk sees what
 * the panel shows: hidden and system entries included, `.` and `..` never.
 * FSX_DEPTH: -1 walks every level, 0 only the folder itself and n the first n
 * levels below it; the walk is level by level, so a depth is never overshot. A
 * reparse point (a junction or a symlink) is listed but NEVER entered: following
 * it could leave the tree the user pointed at, or loop for ever. It stops after
 * FS_LIM_FILES files visited, so a search of C:\ cannot run away.
 *
 * What is NOT here, on purpose: the content decision of S7 belongs to the scan
 * (T3, which owns the read, the progress and the cancel), and FSX_ONLYSEL is the
 * CALLER's job: from T3 the screen passes a pre-filtered list (the marked
 * entries of the active panel) instead of one directory, so this walk never has
 * to know about panels. */
FUNCTION HcFsWalk( cDir, aSt )
   LOCAL aOut := {}, aLevel, aNext, aList, aE, cName, cPath, i, j
   LOCAL nDepth, nLevel := 0, nSeen := 0, lMore := .T., nAttr
   IF ValType( cDir ) != "C" .OR. Len( AllTrim( cDir ) ) == 0
      RETURN aOut
   ENDIF
   IF ! HB_ISARRAY( aSt ) .OR. Len( aSt ) < FSX_DEPTH
      RETURN aOut
   ENDIF
   nDepth := iif( ValType( aSt[ FSX_DEPTH ] ) == "N", aSt[ FSX_DEPTH ], -1 )
   /* hb_vfDirectory() needs the trailing separator of the directory */
   aLevel := { HcDirArg( cDir ) }
   DO WHILE lMore .AND. Len( aLevel ) > 0
      aNext := {}
      FOR i := 1 TO Len( aLevel )
         /* hb_vfDirectory() needs the trailing separator, and a subdirectory
          * joined from its parent has none (measured: without it the listing
          * comes back with ONE element) */
         aList := HcReadDir( HcDirArg( aLevel[ i ] ) )
         FOR j := 1 TO Len( aList )
            aE := aList[ j ]
            IF ! HB_ISARRAY( aE ) .OR. Len( aE ) < HC_E_ATTR
               LOOP
            ENDIF
            cName := aE[ HC_E_NAME ]
            IF ValType( cName ) != "C" .OR. Len( cName ) == 0 .OR. ;
               cName == "." .OR. cName == ".."
               LOOP
            ENDIF
            cPath := HcJoinPath( aLevel[ i ], cName )
            IF HcIsDir( aE )
               /* the reparse bit is not in the listing, so it is asked here: a
                * junction is listed and never walked through */
               nAttr := 0
               IF hb_vfAttrGet( cPath, @nAttr ) .AND. ;
                  hb_bitAnd( nAttr, HB_FA_REPARSE ) != 0
                  LOOP
               ENDIF
               IF nDepth < 0 .OR. nLevel + 1 <= nDepth
                  AAdd( aNext, cPath )
               ENDIF
            ELSE
               nSeen++
               IF HcFsMaskOk( cName, aSt ) .AND. HcFsFilterOk( aE, aSt )
                  AAdd( aOut, { cPath, aE } )
               ENDIF
               IF nSeen >= FS_LIM_FILES
                  lMore := .F.
                  EXIT
               ENDIF
            ENDIF
         NEXT
         IF ! lMore
            EXIT
         ENDIF
      NEXT
      aLevel := aNext
      nLevel++
   ENDDO
RETURN aOut

/* S12/S7: the bytes of a file as { { cText, cEol }, ... }, one pair per line and
 * with EACH LINE'S OWN terminator (`\r\n`, `\n` or `\r`, and "" on a last line
 * that has none). The terminator travels byte for byte so a replace can rebuild
 * the file EXACTLY as it was (HcFsJoin()) instead of converting the line endings
 * of the whole file. A file that ends with a terminator does not get a trailing
 * empty line. PURE. */
FUNCTION HcFsLines( cData )
   LOCAL aOut := {}, cLine := "", i := 1, c
   IF ValType( cData ) != "C"
      RETURN aOut
   ENDIF
   DO WHILE i <= Len( cData )
      c := SubStr( cData, i, 1 )
      IF c == Chr( 13 )
         IF SubStr( cData, i + 1, 1 ) == Chr( 10 )
            AAdd( aOut, { cLine, Chr( 13 ) + Chr( 10 ) } )
            i += 2
         ELSE
            AAdd( aOut, { cLine, Chr( 13 ) } )
            i++
         ENDIF
         cLine := ""
      ELSEIF c == Chr( 10 )
         AAdd( aOut, { cLine, Chr( 10 ) } )
         cLine := ""
         i++
      ELSE
         cLine += c
         i++
      ENDIF
   ENDDO
   IF Len( cLine ) > 0
      AAdd( aOut, { cLine, "" } )
   ENDIF
RETURN aOut

/* S12: the bytes back, `cText + cEol` per line in order, so HcFsJoin(
 * HcFsLines( x ) ) == x for every file (that round trip is what makes an atomic
 * replace safe). A malformed pair is taken as a text with no terminator. PURE. */
FUNCTION HcFsJoin( aLines )
   LOCAL cData := "", i, aLn
   IF ! HB_ISARRAY( aLines )
      RETURN ""
   ENDIF
   FOR i := 1 TO Len( aLines )
      aLn := aLines[ i ]
      IF HB_ISARRAY( aLn )
         IF ValType( aLn[ 1 ] ) == "C"
            cData += aLn[ 1 ]
         ENDIF
         IF Len( aLn ) >= 2 .AND. ValType( aLn[ 2 ] ) == "C"
            cData += aLn[ 2 ]
         ENDIF
      ELSEIF ValType( aLn ) == "C"
         cData += aLn
      ENDIF
   NEXT
RETURN cData

/* S8: the bytes of one file for the search, as { lOk, cData, cErr }. The read is
 * RAW: no Ctrl-Z is stripped and nothing is decoded, because a replace has to
 * write back the same bytes. `lHex` is the mode of the search: WITHOUT it a
 * binary (HcIsBinaryText()) is refused with "Binary file" and the caller counts
 * it as SKIPPED, not as an error to show; WITH it every file is read, because
 * hex is the only mode that searches binaries (S7). A file over FS_LIM_FILE is
 * skipped with "File too large" (the caller counts it apart) instead of loading
 * 200 MB. PURE but for the read itself: no screen, no message. */
FUNCTION HcFsRead( cFile, lHex )
   LOCAL nHandle, nSize, nRead, cData
   IF ValType( cFile ) != "C" .OR. Len( cFile ) == 0
      RETURN { .F., "", "File not found" }
   ENDIF
   IF ! hb_vfExists( cFile )
      RETURN { .F., "", "File not found" }
   ENDIF
   nHandle := FOpen( cFile, FO_READ )
   IF nHandle < 0
      RETURN { .F., "", "Cannot open the file (error " + LTrim( Str( FError() ) ) + ")" }
   ENDIF
   nSize := FSeek( nHandle, 0, FS_END )
   FSeek( nHandle, 0, FS_SET )
   IF ValType( nSize ) != "N" .OR. nSize < 0
      nSize := 0
   ENDIF
   IF nSize > FS_LIM_FILE
      FClose( nHandle )
      RETURN { .F., "", "File too large" }
   ENDIF
   cData := Space( nSize )
   IF nSize > 0
      nRead := FRead( nHandle, @cData, nSize )
      IF ValType( nRead ) != "N" .OR. nRead < 0
         nRead := 0
      ENDIF
      IF nRead != nSize
         cData := Left( cData, nRead )
      ENDIF
   ENDIF
   FClose( nHandle )
   IF lHex != .T. .AND. HcIsBinaryText( cData )
      RETURN { .F., "", "Binary file" }
   ENDIF
RETURN { .T., cData, "" }

/* S7: the matcher of the TEXT mode (the HcMatcher() of the editor, so `Whole
 * words only`, `Match case` and `Regular expression` behave exactly as they do
 * in `Find / Replace`), or NIL in hex mode: there the search is byte based and
 * HcFsTextHits() uses the bytes of HcHexQuery() instead. PURE. */
FUNCTION HcFsMatcher( aSt )
   LOCAL cWhat
   IF ! HB_ISARRAY( aSt ) .OR. Len( aSt ) < FSX_TEXT
      RETURN NIL
   ENDIF
   IF aSt[ FSX_HEX ] == .T.
      RETURN NIL
   ENDIF
   cWhat := iif( ValType( aSt[ FSX_TEXT ] ) == "C", aSt[ FSX_TEXT ], "" )
RETURN HcMatcher( cWhat, aSt[ FSX_CASE ], aSt[ FSX_WORD ], aSt[ FSX_RE ] )

/* S7/S11: can the query be searched at all? "" when it can and the message to
 * show when it cannot, so the screen and the replace share ONE wording: an empty
 * query says "Not found.", a regex that does not compile says "Invalid regular
 * expression." and a hex query with an odd number of digits or a character that
 * is not hex says "Invalid hexadecimal value." (HcHexQuery() answers "" for
 * both). PURE. */
FUNCTION HcFsBad( aSt )
   LOCAL aMt
   IF ! HB_ISARRAY( aSt ) .OR. Len( aSt ) < FSX_TEXT
      RETURN "Not found."
   ENDIF
   IF ValType( aSt[ FSX_TEXT ] ) != "C" .OR. Len( aSt[ FSX_TEXT ] ) == 0
      RETURN "Not found."
   ENDIF
   IF aSt[ FSX_HEX ] == .T.
      IF Len( HcHexQuery( aSt[ FSX_TEXT ], .T. ) ) == 0
         RETURN "Invalid hexadecimal value."
      ENDIF
      RETURN ""
   ENDIF
   aMt := HcFsMatcher( aSt )
   IF HB_ISARRAY( aMt ) .AND. aMt[ HM_BAD ] == .T.
      RETURN "Invalid regular expression."
   ENDIF
RETURN ""

/* S7: how many times the query appears in the bytes of one file. TEXT mode sums
 * the matches of every line (HcFsLines()) through the matcher, so the count is
 * the one the editor would report for the same document; HEX mode counts the
 * NON-OVERLAPPING hits of the bytes of HcHexQuery() over the whole content,
 * newlines and all. FSX_NOT does NOT invert the answer here: this is the count,
 * and `> 0` against `== 0` is the scan's decision (S7), so the same number also
 * feeds the `M hits` column of the list. PURE. */
FUNCTION HcFsTextHits( cData, aSt, aMt )
   LOCAL aLines, aLn, cQ, cWhat, nLen, nFrom, nAt, nHits := 0, i
   IF ValType( cData ) != "C" .OR. Len( cData ) == 0
      RETURN 0
   ENDIF
   IF ! HB_ISARRAY( aSt ) .OR. Len( aSt ) < FSX_TEXT
      RETURN 0
   ENDIF
   cWhat := iif( ValType( aSt[ FSX_TEXT ] ) == "C", aSt[ FSX_TEXT ], "" )
   IF aSt[ FSX_HEX ] == .T.
      cQ   := HcHexQuery( cWhat, .T. )
      nLen := Len( cQ )
      IF nLen == 0
         RETURN 0
      ENDIF
      /* At() takes no start offset in this build, so the tail is searched and
       * the offset added back (the same walk HcLineMatches() does) */
      nFrom := 1
      DO WHILE nFrom + nLen - 1 <= Len( cData )
         nAt := At( cQ, SubStr( cData, nFrom ) )
         IF nAt == 0
            EXIT
         ENDIF
         nHits++
         nFrom += nAt - 1 + nLen
      ENDDO
      RETURN nHits
   ENDIF
   IF ! HB_ISARRAY( aMt )
      aMt := HcFsMatcher( aSt )
   ENDIF
   IF ! HB_ISARRAY( aMt )
      RETURN 0
   ENDIF
   aLines := HcFsLines( cData )
   FOR i := 1 TO Len( aLines )
      aLn := HcLineMatches( aLines[ i ][ 1 ], aMt )
      IF HB_ISARRAY( aLn )
         nHits += Len( aLn )
      ENDIF
   NEXT
RETURN nHits

/* ===== File search: the screen (S2, S9, S10, S13, S14) ===== */

/* Geometry of odd/tasks/hc-file-search.md S2, derived from the canvas (never a
 * literal 120/80/44/25): the form box on top with its tab strip, the results box
 * below and the three footer rows (status, message and key chips) at the bottom.
 * The Advanced tab REUSES the rows R1..R4, the left column FSB_COL and the two
 * buttons of row R9, and the two buttons are shared by the two tabs.
 *
 * FSR_B is derived from the status row so the results frame can never grow over
 * it: S2 gives the form rows 1..17, the results rows 18..40 and the footer the
 * last three rows of the canvas (41/42/43). */
#define FS_ROW_STATUS ( MaxRow() - 2 )
#define FS_ROW_MSG    ( MaxRow() - 1 )
#define FS_ROW_HINT   MaxRow()

#define FSB_T       1                    /* top border of the form box      */
#define FSB_B       17                   /* bottom border of the form box   */
#define FSB_L       1                    /* left border                     */
#define FSB_R       ( UiCols() - 2 )     /* right border                    */
#define FSB_TABS    2                    /* the General / Advanced strip    */
#define FSB_R1      4                    /* Search:  |  Date range:         */
#define FSB_R2      5                    /* Search in:                      */
#define FSB_R3      6                    /* [ ] only selected | Not older   */
#define FSB_R4      7                    /* Subdirectories: (General only)  */
#define FSB_RSIZE   8                    /* File size: the third filter row of
                                          `Advanced`, on its OWN row: S2 wants
                                          the three filters on 4, 6 and 8  */
#define FSB_R5      9                    /* [ ] Search text:                */
#define FSB_R6      10                   /* Whole words | Match case        */
#define FSB_R7      11                   /* Regular exp.| Hexadecimal       */
#define FSB_R8      12                   /* Files that do NOT contain...    */
#define FSB_RREPL   13                   /* [ ] Replace with:  (right under the
                                          five content options, inside the box) */
#define FSB_R9      15                   /* the two buttons                 */
#define FSB_COL     3                    /* first column of a label         */
#define FSB_FLD     18                   /* first column of a wide field    */
#define FSB_FLDW    58                   /* its width                       */
/* `Subdirectories:` is the longest label of the column (15 cells, 3..17), so the
 * chip of that row is pushed one cell right: without it the chip starts glued to
 * the colon (measure in `_reversing/verifica-file-search.ps1`, S2) */
#define FSB_DEPTH   ( FSB_FLD + 1 )      /* first column of the depth chip  */
#define FSB_TXTFLD  22                   /* first column of the text field  */
#define FSB_TXTW    94                   /* its width                       */
#define FSB_C1      6                    /* left column of the options      */
#define FSB_C2      44                   /* right column of the options     */
#define FSB_BTN_W   10                   /* width of one button             */
#define FSB_BTN2    ( FSB_R - 2 - 2 * FSB_BTN_W - 2 )   /* the right button */
#define FSB_MASKRE  ( FSB_FLD + FSB_FLDW + 2 )   /* RE of the mask (78)     */
#define FSB_DATEW   10                   /* `DD/MM/YYYY` mask width         */
#define FSB_AND     ( FSB_FLD + FSB_DATEW + 1 )  /* the word `and`          */
#define FSB_DATE2   ( FSB_FLD + FSB_DATEW + 5 )  /* the second date         */
#define FSB_NDAYS   ( FSB_FLD + 6 )      /* N days field                    */
#define FSB_NDAYW   6                    /* its width                       */
#define FSB_SOP     FSB_FLD              /* the operator chip               */
#define FSB_SOPW    5                    /* its width                       */
#define FSB_SVAL    ( FSB_SOP + FSB_SOPW + 1 )   /* the size value          */
#define FSB_SVALW   10                   /* its width                       */
#define FSB_SUNIT   ( FSB_SVAL + FSB_SVALW + 1 ) /* the unit chip           */
#define FSB_SUNITW  8                    /* its width: `Bytes` is 5 glyphs, so 6
                                          cells go inside the brackets or the
                                          label comes out cut as `Byte`     */

#define FSR_T       18                   /* top border of the results box   */
#define FSR_B       ( FS_ROW_STATUS - 1 )
#define FSR_L       1
#define FSR_R       ( UiCols() - 2 )
#define FSR_HDR     19                   /* `Results` + the counts          */
#define FSR_FIRST   20                   /* first result row                */
#define FSR_LAST    ( FSR_B - 1 )        /* last result row                 */
#define FSR_HITS    6                    /* cells of the hit count          */
#define FSR_BAR     ( FSR_R - 1 )        /* column of the scroll bar        */
/* S1 of hc-fsearch-marks.md: EVERY result row carries its own checkbox -the 3
 * cells of `[X]` / `[ ]`-, then ONE cell of air and then the text. The box takes
 * those 4 cells from the NAME and never from the hit count, so the counter keeps
 * its FSR_HITS cells untouched. */
#define FSR_MARK    ( FSR_L + 1 )        /* first cell of the row checkbox  */
#define FSR_MARKW   3                    /* the checkbox is always 3 cells  */
#define FSR_TEXT    ( FSR_L + 5 )        /* first cell of the row text      */

/* the state the screen keeps besides aSt (the form state of S3): where the
 * focus is, which tab is open, whether the focus is on the results list, the
 * results themselves and the two footer texts */
#define FSS_FOC     1
#define FSS_TAB     2
#define FSS_LIST    3
#define FSS_RES     4
#define FSS_SEL     5
#define FSS_TOP     6
#define FSS_MSG     7
#define FSS_ERR     8
#define FSS_MARK    9   /* S14: is the checkbox column of the results active? */

/* one row of the results: { cPath, nHits, dDate, nSize, cTime, lMark }. The first
 * four slots are the contract of S9; the fifth is the time of the entry, which
 * is only used by the status row; the sixth is the checkbox of the row (S2 of
 * hc-fsearch-marks.md), `.T.` = marked, and its ABSENCE means marked too. */
#define FSRW_PATH   1
#define FSRW_HITS   2
#define FSRW_DATE   3
#define FSRW_SIZE   4
#define FSRW_TIME   5
#define FSRW_MARK   6

/* ------------------------------------------------------------------ pure --- */

/* S5: the text of the `File size:` operator chip. Anything that is not one of
 * the three operators reads as `=`, the exact one, so a state that got corrupted
 * compares instead of matching nothing. PURE. */
FUNCTION HcFsSizeOpText( cOp )
   IF ValType( cOp ) != "C"
      RETURN "="
   ENDIF
   DO CASE
   CASE cOp == ">"
      RETURN ">"
   CASE cOp == "<"
      RETURN "<"
   ENDCASE
RETURN "="

/* S5: the next / previous operator of the cycle `=` -> `>` -> `<` -> `=`, with
 * wrap at both ends; no direction (or 0) means forward. PURE. */
FUNCTION HcFsSizeOpStep( cOp, nDir )
   LOCAL aOp := { "=", ">", "<" }, nAt := 1, i
   FOR i := 1 TO Len( aOp )
      IF aOp[ i ] == HcFsSizeOpText( cOp )
         nAt := i
      ENDIF
   NEXT
   IF ValType( nDir ) != "N" .OR. nDir == 0
      nDir := 1
   ENDIF
   nAt += iif( nDir > 0, 1, -1 )
   IF nAt > Len( aOp )
      nAt := 1
   ELSEIF nAt < 1
      nAt := Len( aOp )
   ENDIF
RETURN aOp[ nAt ]

/* S5: the text of the `File size:` unit chip, the same three numbers
 * HcFsFilterOk() multiplies by. PURE. */
FUNCTION HcFsSizeUnitText( n )
   IF ValType( n ) != "N"
      RETURN "Bytes"
   ENDIF
   DO CASE
   CASE n == 2
      RETURN "KiB"
   CASE n == 3
      RETURN "MiB"
   ENDCASE
RETURN "Bytes"

/* S5: the next / previous unit of the cycle Bytes -> KiB -> MiB -> Bytes. An
 * unknown unit starts the walk on Bytes. PURE. */
FUNCTION HcFsSizeUnitStep( n, nDir )
   IF ValType( n ) != "N" .OR. ( n != 1 .AND. n != 2 .AND. n != 3 )
      n := 1
   ENDIF
   IF ValType( nDir ) != "N" .OR. nDir == 0
      nDir := 1
   ENDIF
   n += iif( nDir > 0, 1, -1 )
   IF n > 3
      n := 1
   ELSEIF n < 1
      n := 3
   ENDIF
RETURN n

/* S13: the ORDER of the focus ring. It is NOT the numeric order of the FSF_*
 * stops: `Replace with:` (FSF_REPL = 24) is painted right under the five
 * content options, so it is walked there - after FSF_NOT and before the
 * Advanced stops - and not at the end, where its number would put it. ONE list
 * is the whole order, and HcSearchFocusStep() walks it. PURE. */
STATIC FUNCTION HcSearchRing()
RETURN { FSF_TABS, FSF_MASK, FSF_DIR, FSF_MASKRE, FSF_ONLYSEL, FSF_DEPTH, FSF_TEXT, ;
         FSF_WORD, FSF_CASE, FSF_RE, FSF_HEX, FSF_NOT, FSF_REPL, ;
         FSF_DATES, FSF_D1, FSF_D2, FSF_DAYS, FSF_NDAYS, FSF_SIZE, ;
         FSF_SOP, FSF_SVAL, FSF_SUNIT, FSF_BTSEARCH, FSF_BTCANCEL }

/* S13/S14: is this focus stop SKIPPED for this state and this tab? Two rules:
 *   - the stops of the OTHER tab do not exist here (the same numbering serves
 *     both tabs, so this is what keeps Tab inside the tab that is open);
 *   - a control that depends on a filter that is OFF is dimmed and unreachable
 *     (the five content options need `Search text:`, the two dates need
 *     `Date range:`, the days need `Not older than:` and the value and the two
 *     chips of the size need `File size:`).
 * The checkboxes that TURN a filter on are never skipped, which is what makes
 * the filter reachable in the first place. `Replace with:` follows the same rule
 * as the five content options: replacing without a query makes no sense, so it
 * is skipped (and painted dim) while `Search text:` is OFF. PURE. */
FUNCTION HcSearchSkip( nStop, aSt, nTab )
   LOCAL lTxt := .F., lDates := .F., lDays := .F., lSize := .F.
   IF ValType( nStop ) != "N"
      RETURN .T.
   ENDIF
   nStop := Int( nStop )
   IF nStop < 1 .OR. nStop > FSF_MAX
      RETURN .T.
   ENDIF
   IF HB_ISARRAY( aSt ) .AND. Len( aSt ) >= FSX_SIZE
      lTxt   := ( aSt[ FSX_TXT ] == .T. )
      lDates := ( aSt[ FSX_DATES ] == .T. )
      lDays  := ( aSt[ FSX_DAYS ] == .T. )
      lSize  := ( aSt[ FSX_SIZE ] == .T. )
   ENDIF
   IF ValType( nTab ) == "N" .AND. Int( nTab ) == 2
      /* Advanced: the General-only stops are not here (`Replace with:` too) */
      IF nStop >= FSF_MASK .AND. nStop <= FSF_NOT
         RETURN .T.
      ENDIF
      IF nStop == FSF_REPL
         RETURN .T.
      ENDIF
   ELSE
      /* General: neither are the Advanced-only ones */
      IF nStop >= FSF_DATES .AND. nStop <= FSF_SUNIT
         RETURN .T.
      ENDIF
   ENDIF
   DO CASE
   CASE nStop == FSF_D1 .OR. nStop == FSF_D2
      RETURN ! lDates
   CASE nStop == FSF_NDAYS
      RETURN ! lDays
   CASE nStop == FSF_SOP .OR. nStop == FSF_SVAL .OR. nStop == FSF_SUNIT
      RETURN ! lSize
   CASE nStop == FSF_WORD .OR. nStop == FSF_CASE .OR. nStop == FSF_RE .OR. ;
        nStop == FSF_HEX .OR. nStop == FSF_NOT .OR. nStop == FSF_REPL
      RETURN ! lTxt
   ENDCASE
RETURN .F.

/* S13/S14: the next (or previous) focus stop of the ring, wrapping in both
 * directions and skipping what HcSearchSkip() refuses. The walk follows
 * HcSearchRing(), which is where `Replace with:` sits under the five content
 * options and not at the end of the numbering. When everything is skipped the
 * stop does not move. PURE. */
FUNCTION HcSearchFocusStep( nFrom, lBack, aSt, nTab )
   LOCAL aOrd := HcSearchRing(), nAt := 0, nDir, i
   IF ValType( nFrom ) != "N"
      nFrom := FSF_TABS
   ENDIF
   nFrom := Int( nFrom )
   nAt := AScan( aOrd, {| n2 | n2 == nFrom } )
   IF nAt == 0
      nAt := 1
   ENDIF
   nDir := iif( ValType( lBack ) == "L" .AND. lBack, -1, 1 )
   FOR i := 1 TO Len( aOrd )
      nAt += nDir
      IF nAt > Len( aOrd )
         nAt := 1
      ENDIF
      IF nAt < 1
         nAt := Len( aOrd )
      ENDIF
      IF ! HcSearchSkip( aOrd[ nAt ], aSt, nTab )
         RETURN aOrd[ nAt ]
      ENDIF
   NEXT
RETURN nFrom

/* S13: what a click on a control MEANS: { kind, index } with 1 = text field, 2
 * = tab, 3 = checkbox, 4 = button, 5 = pick chip and 6 = key chip (whose second
 * element is the NAME of the key it announces, "F5" or "Alt-R", and NOT an
 * index: the caller resolves it with HcSyncChipInput()), or NIL when the
 * control is not one of this screen. The array is the one HcSyncCtlAt() answers
 * while the screen is painted, so a click and a key can never point at two
 * different things. PURE. */
FUNCTION HcSearchClick( aCtl )
   LOCAL cKind, xArg
   IF ! HB_ISARRAY( aCtl ) .OR. Len( aCtl ) < 5
      RETURN NIL
   ENDIF
   cKind := aCtl[ 4 ]
   xArg  := aCtl[ 5 ]
   IF ValType( cKind ) != "C"
      RETURN NIL
   ENDIF
   IF cKind == "KEY"
      /* S13.6: the footer key chips are painted by HcSearchHint() with the
       * shared kind "KEY" and the NAME of the key they announce ("F5",
       * "Alt-R", ...), and the checkbox of the results header is registered the
       * same way with "Alt-I" (S4 of hc-fsearch-marks.md). The caller turns that
       * name into the input with HcSyncChipInput(), which is the ONE table of
       * chip names, so a chip this program does not know can never run a wrong
       * action (that helper answers { 0, nil } when the name is not a single
       * character, so the caller tests the number with != 0) */
      IF ValType( xArg ) != "C"
         RETURN NIL
      ENDIF
      RETURN { 6, xArg }
   ENDIF
   IF ValType( xArg ) != "N"
      RETURN NIL
   ENDIF
   DO CASE
   CASE cKind == "FSFLD"
      RETURN { 1, xArg }
   CASE cKind == "FSTAB"
      RETURN { 2, xArg }
   CASE cKind == "FSCHK"
      RETURN { 3, xArg }
   CASE cKind == "FSBTN"
      RETURN { 4, xArg }
   CASE cKind == "FSPIK"
      RETURN { 5, xArg }
   ENDCASE
RETURN NIL

/* S14: what `Enter` DOES on a focus stop: "edit" on a text or masked field,
 * "toggle" on a checkbox, "pick" on one of the three chips, "tab" on the tab
 * strip, "search" / "cancel" on the two buttons and "" when the stop is not
 * reachable with the state and tab in force (a dimmed control does nothing). The
 * screen and the bank read this one rule, so a key can never invent an action
 * the paint does not offer. PURE. */
FUNCTION HcSearchEnter( aSt, nFoc, nTab )
   IF ValType( nFoc ) != "N"
      RETURN ""
   ENDIF
   nFoc := Int( nFoc )
   IF HcSearchSkip( nFoc, aSt, nTab )
      RETURN ""
   ENDIF
   DO CASE
   CASE nFoc == FSF_TABS
      RETURN "tab"
   CASE nFoc == FSF_MASK .OR. nFoc == FSF_DIR .OR. nFoc == FSF_TEXT .OR. ;
        nFoc == FSF_REPL .OR. nFoc == FSF_D1 .OR. nFoc == FSF_D2 .OR. ;
        nFoc == FSF_NDAYS .OR. nFoc == FSF_SVAL
      /* FSF_TEXT and FSF_REPL are ROWS of the form: the box is toggled with
       * Space and Enter there opens the text field, because the field shares
       * the stop (S2 gives one stop to each line, so the text is typed from
       * the box) */
      RETURN "edit"
   CASE nFoc == FSF_DEPTH .OR. nFoc == FSF_SOP .OR. nFoc == FSF_SUNIT
      RETURN "pick"
   CASE nFoc == FSF_MASKRE .OR. nFoc == FSF_ONLYSEL .OR. ;
        nFoc == FSF_WORD .OR. nFoc == FSF_CASE .OR. nFoc == FSF_RE .OR. ;
        nFoc == FSF_HEX .OR. nFoc == FSF_NOT .OR. nFoc == FSF_DATES .OR. ;
        nFoc == FSF_DAYS .OR. nFoc == FSF_SIZE
      RETURN "toggle"
   CASE nFoc == FSF_BTSEARCH
      RETURN "search"
   CASE nFoc == FSF_BTCANCEL
      RETURN "cancel"
   ENDCASE
RETURN ""

/* S13.7/S14: which button a keystroke runs - 1 Search, 2 Cancel, 0 none. The
 * chord is `Alt+<letter>` from ANY stop of the form, because a bare letter
 * belongs to the field that has the focus. CTRL refuses the whole thing: on a
 * Spanish keyboard AltGr IS Ctrl+Alt (AGENTS trap 38), so `AltGr+S` - which
 * types a character - can never start a search. A missing or non-numeric shift
 * state is no ALT at all, so a bare letter answers 0. <nFoc> is taken for
 * symmetry with HcFindHot() and does not change the rule. PURE. */
FUNCTION HcSearchHot( nKey, nShift, nFoc )
   LOCAL cCh, lAlt, lCtl
   IF ValType( nKey ) != "N"
      RETURN 0
   ENDIF
   nKey := Int( nKey )
   /* a letter lives well below 127: anything else is not a quick key, and this
    * build can drop a byte >= 128 through Chr() (AGENTS trap 47) */
   IF nKey < 32 .OR. nKey > 126
      RETURN 0
   ENDIF
   cCh := Upper( Chr( nKey ) )
   IF ! ( cCh == "S" .OR. cCh == "C" )
      RETURN 0
   ENDIF
   lAlt := ValType( nShift ) == "N" .AND. hb_BitAnd( nShift, HB_GTI_KBD_ALT ) != 0
   lCtl := ValType( nShift ) == "N" .AND. hb_BitAnd( nShift, HB_GTI_KBD_CTRL ) != 0
   IF ! lAlt .OR. lCtl
      RETURN 0
   ENDIF
   IF cCh == "S"
      RETURN 1
   ENDIF
RETURN 2

/* S18/T7: which checkbox an `Alt+<letter>` chord toggles - the FSF_* stop, or 0
 * when that letter is not a box of this tab. One letter per box, unique inside
 * its tab, and NONE of them is S / C / R / L: those four chords already exist
 * (the two buttons and the two replacements) and they win, so no box can steal
 * them. `O` is the only letter the two tabs share and it can be shared, because
 * exactly one tab is alive at a time.
 * The chord reaches this helper as ONE character - the driver hands an
 * `Alt+<letter>` over as the bare letter with the ALT bit (AGENTS trap 37), and
 * HcSearchAltOf()/the ALT ring of the hook have already refused a bare letter and
 * AltGr - so the letter is compared case-insensitively and anything that is not
 * a single character answers 0.
 * A box the state and the tab have DIMMED does not answer either, and
 * HcSearchSkip() is the ONE rule of what is dimmed (S13): the five content
 * options and `Replace with:` need `Search text:` ON, and the box that turns a
 * filter on is its own switch, so it always answers.
 * PURE: no screen, no disk. */
FUNCTION HcSearchChkHot( cCh, aSt, nTab )
   LOCAL nStop := 0
   IF ValType( cCh ) != "C" .OR. Len( cCh ) != 1
      RETURN 0
   ENDIF
   cCh := Upper( cCh )
   IF ValType( nTab ) == "N" .AND. Int( nTab ) == 2
      /* Advanced: D = Date range, O = Not older than, F = File size */
      DO CASE
      CASE cCh == "D" ; nStop := FSF_DATES
      CASE cCh == "O" ; nStop := FSF_DAYS
      CASE cCh == "F" ; nStop := FSF_SIZE
      ENDCASE
   ELSE
      /* General: U = the regex of the mask, O = only the selected entries,
       * T = Search text, W = whole words, M = match case, E = the regex of the
       * content, H = hexadecimal, N = the files that do NOT contain the text
       * and P = Replace with */
      DO CASE
      CASE cCh == "U" ; nStop := FSF_MASKRE
      CASE cCh == "O" ; nStop := FSF_ONLYSEL
      CASE cCh == "T" ; nStop := FSF_TEXT
      CASE cCh == "W" ; nStop := FSF_WORD
      CASE cCh == "M" ; nStop := FSF_CASE
      CASE cCh == "E" ; nStop := FSF_RE
      CASE cCh == "H" ; nStop := FSF_HEX
      CASE cCh == "N" ; nStop := FSF_NOT
      CASE cCh == "P" ; nStop := FSF_REPL
      ENDCASE
   ENDIF
   IF nStop == 0
      RETURN 0
   ENDIF
   IF HcSearchSkip( nStop, aSt, nTab )
      RETURN 0
   ENDIF
RETURN nStop

/* S20/T10: which tab an `Alt+<letter>` chord switches to - 1 for `G`
 * (`[ ~G~eneral ]`), 2 for `A` (`[ ~A~dvanced ]`) and 0 for everything else.
 * The two letters are the NATURAL ones of each label (the user's request, L18)
 * and they cost nothing because no box of either tab wears them: `A` used to be
 * the chord of Replace all and that action moved to `Alt-L` (L18), so the four
 * action chords are now S (Search), C (Cancel), R (Replace) and L (Replace all).
 * No box wears either one, which is what makes the precedence work: the
 * checkboxes of the live tab are resolved FIRST (HcSearchChkHot()) and the strip
 * right after, so neither can steal the other's letter.
 * The chord reaches this helper as ONE character - the driver hands an
 * `Alt+<letter>` over as the bare letter with the ALT bit (trap 37) and
 * HcSearchAltOf()/the ALT ring of the hook have already refused a bare letter
 * and AltGr -, so the letter is compared case-insensitively and anything that
 * is not a single character answers 0.
 * PURE: no state, no tab, no screen. */
FUNCTION HcSearchTabHot( cCh )
   IF ValType( cCh ) != "C" .OR. Len( cCh ) != 1
      RETURN 0
   ENDIF
   DO CASE
   CASE Upper( cCh ) == "G" ; RETURN 1
   CASE Upper( cCh ) == "A" ; RETURN 2
   ENDCASE
RETURN 0

/* ----------------------------------------------------------------- scan --- */

/* S9: the search itself. { aResults, cMsg, lCancelled } with one row per file as
 * { cPath, nHits, dDate, nSize, cTime }. It walks with HcFsWalk() (S6), which
 * already applies the name mask (S4) and the three filters (S5), reads every
 * file with HcFsRead() (S8) only when `Search text:` is ON and counts with
 * HcFsTextHits() (S7) through ONE matcher compiled before the loop. FSX_NOT
 * keeps the files with 0 hits.
 *
 * `aOnly` is the extra list of S6: with FSX_ONLYSEL the screen hands over the
 * marked entries of the active panel (files AND the files of a marked folder),
 * so this function never has to know that panels exist and the bank can drive it
 * without a screen. A NIL or empty list answers "There is nothing selected to
 * search in."
 *
 * `bProg` is {| nDone, nTotal, cWhat | ... } and its answer .T. CANCELS the
 * scan (a NIL block never cancels). The caps of bp_def.ch are reported in cMsg
 * instead of cutting the list silently.
 *
 * NO UiMsg(), NO UiCols(), NO Inkey() here: the progress box belongs to the
 * caller (HcSearchProg()) and the message is returned, never shown. */
FUNCTION HcFsScan( aSt, bProg, aOnly )
   LOCAL aRes := {}, aWalk := {}, aE, aRead, aMt, cData, cPath, cMsg := ""
   LOCAL cMask, lTxt, lHex, lCancel := .F., lCapRes := .F., lCapFiles := .F.
   LOCAL nHits, nFound := 0, nSkip := 0, nSeen := 0, i
   IF ! HB_ISARRAY( aSt ) .OR. Len( aSt ) < FSX_SIZE
      RETURN { aRes, "Not found.", .F. }
   ENDIF
   /* S9: an empty mask matches nothing and the user would see an empty list for
    * what is really a typo, so it is reported before anything is walked */
   cMask := iif( ValType( aSt[ FSX_MASK ] ) == "C", AllTrim( aSt[ FSX_MASK ] ), "" )
   IF Len( cMask ) == 0
      RETURN { aRes, "Enter a file name mask.", .F. }
   ENDIF
   lTxt := ( aSt[ FSX_TXT ] == .T. )
   lHex := ( lTxt .AND. aSt[ FSX_HEX ] == .T. )
   IF lTxt
      cMsg := HcFsBad( aSt )
      IF Len( cMsg ) > 0
         RETURN { aRes, cMsg, .F. }
      ENDIF
      aMt := HcFsMatcher( aSt )
   ENDIF
   IF aSt[ FSX_ONLYSEL ] == .T.
      IF ! HB_ISARRAY( aOnly )
         RETURN { aRes, "There is nothing selected to search in.", .F. }
      ENDIF
      FOR i := 1 TO Len( aOnly )
         aE := aOnly[ i ]
         IF ! HB_ISARRAY( aE ) .OR. Len( aE ) < 2 .OR. ValType( aE[ 1 ] ) != "C"
            LOOP
         ENDIF
         /* the mask and the filters still apply, so `Search in:` the selection
          * narrows the set and never widens it */
         IF HcFsMaskOk( hb_FNameNameExt( aE[ 1 ] ), aSt ) .AND. ;
            HcFsFilterOk( aE[ 2 ], aSt )
            AAdd( aWalk, { aE[ 1 ], aE[ 2 ] } )
         ENDIF
      NEXT
      IF Len( aWalk ) == 0
         RETURN { aRes, "There is nothing selected to search in.", .F. }
      ENDIF
   ELSE
      cPath := iif( ValType( aSt[ FSX_DIR ] ) == "C", AllTrim( aSt[ FSX_DIR ] ), "" )
      IF Len( cPath ) == 0
         RETURN { aRes, "Enter the folder to search in.", .F. }
      ENDIF
      IF ! hb_DirExists( cPath )
         RETURN { aRes, "The directory does not exist: " + cPath, .F. }
      ENDIF
      aWalk := HcFsWalk( cPath, aSt )
      /* S9: the walk stops by itself after FS_LIM_FILES files; when it came back
       * full the search says so instead of pretending it saw the whole tree */
      IF Len( aWalk ) >= FS_LIM_FILES
         lCapFiles := .T.
      ENDIF
   ENDIF
   FOR i := 1 TO Len( aWalk )
      nSeen++
      IF nSeen > FS_LIM_FILES
         lCapFiles := .T.
         EXIT
      ENDIF
      IF HB_ISBLOCK( bProg )
         IF Eval( bProg, i, Len( aWalk ), aWalk[ i ][ 1 ] ) == .T.
            lCancel := .T.
            EXIT
         ENDIF
      ENDIF
      cPath := aWalk[ i ][ 1 ]
      aE    := aWalk[ i ][ 2 ]
      nHits := 0
      IF lTxt
         aRead := HcFsRead( cPath, lHex )
         IF ! aRead[ 1 ]
            /* S8: a binary in text mode and a file over the cap are SKIPPED and
             * counted apart, never reported as errors of the search */
            nSkip++
            LOOP
         ENDIF
         cData := aRead[ 2 ]
         nHits := HcFsTextHits( cData, aSt, aMt )
         IF aSt[ FSX_NOT ] == .T.
            IF nHits > 0
               LOOP
            ENDIF
         ELSEIF nHits == 0
            LOOP
         ENDIF
      ENDIF
      AAdd( aRes, { cPath, nHits, ;
                    iif( HB_ISARRAY( aE ) .AND. Len( aE ) >= 3, aE[ 3 ], CToD( "" ) ), ;
                    iif( HB_ISARRAY( aE ) .AND. ValType( aE[ 2 ] ) == "N", aE[ 2 ], 0 ), ;
                    iif( HB_ISARRAY( aE ) .AND. Len( aE ) >= HC_E_TIME, aE[ HC_E_TIME ], "" ) } )
      nFound++
      IF nFound >= FS_LIM_RES
         lCapRes := .T.
         EXIT
      ENDIF
   NEXT
   cMsg := LTrim( Str( nFound ) ) + iif( nFound == 1, " file found", " files found" )
   IF nSkip > 0
      cMsg += ", " + LTrim( Str( nSkip ) ) + " skipped"
   ENDIF
   cMsg += "."
   IF lCapRes
      cMsg += " The list stops at " + LTrim( Str( FS_LIM_RES ) ) + " results."
   ENDIF
   IF lCapFiles
      cMsg += " The search stopped after " + LTrim( Str( FS_LIM_FILES ) ) + " files."
   ENDIF
   IF lCancel
      cMsg += " Search cancelled."
   ENDIF
RETURN { aRes, cMsg, lCancel }

/* =====================================================================
 *  S1..S3 of hc-fsearch-marks.md -- the checkbox of ONE result row
 *
 *  The mark is the SIXTH slot of the row (FSRW_MARK) and not a parallel list, so
 *  it travels with the row for free: HcFsResCopy() copies every slot (the
 *  session memory of S3 of hc-file-search.md), HcFsRefresh() drops it together
 *  with the row it removes, and the rows HcFsScan() builds do not carry it,
 *  which is what makes every NEW row start MARKED without touching HcFsScan().
 *
 *  A MISSING sixth slot means MARKED: an array of five slots -the fixtures of
 *  the bank, a list remembered by an older build- reads as "all marked", so
 *  `Replace all` keeps writing where it always wrote until the user unmarks
 *  something. Every helper here is PURE: no screen, no disk.
 * ===================================================================== */

/* S14: the checkbox of a result is part of the REPLACEMENT and not of the
 * search, so it only exists while replacing is possible: `Search text:` AND
 * `Replace with:` on, which is the same condition that makes the `FSF_REPL` stop
 * reachable. With it off, the results list is exactly the list this screen
 * painted before the feature - no checkbox column, the name back to full width
 * and no `Alt-I` chip in the footer -, and `HcFsReplaceAct( "all" )` already
 * refuses before touching a file. The MARKS do not die: they stay in the sixth
 * slot of the rows, so turning the line off and on again returns the same set.
 * PURE. */
FUNCTION HcFsMarkOn( aSt )
   IF ! HB_ISARRAY( aSt ) .OR. Len( aSt ) < FSX_REPL
      RETURN .F.
   ENDIF
RETURN ( aSt[ FSX_TXT ] == .T. .AND. aSt[ FSX_REPLON ] == .T. )

/* S3: is the row <n> marked? .T. when the sixth slot is missing, when <n> is out
 * of range, when the row is not an array and when <aRes> is not a list at all -
 * the absent mark means "marked", which is the default of the whole feature.
 * The value is read strictly: only a real .F. means unmarked (NIL, a slot just
 * created by ASize() or junk all read as marked). PURE. */
FUNCTION HcFsMark( aRes, n )
   IF ! HB_ISARRAY( aRes ) .OR. ValType( n ) != "N"
      RETURN .T.
   ENDIF
   n := Int( n )
   IF n < 1 .OR. n > Len( aRes ) .OR. ! HB_ISARRAY( aRes[ n ] )
      RETURN .T.
   ENDIF
   IF Len( aRes[ n ] ) < FSRW_MARK
      RETURN .T.
   ENDIF
RETURN ! ( ValType( aRes[ n ][ FSRW_MARK ] ) == "L" .AND. aRes[ n ][ FSRW_MARK ] == .F. )

/* S3: write the mark of row <n> and answer the value that stayed. A row of five
 * slots gets its sixth one with ASize() - NEVER AIns(), which loses the last
 * element in this build, and never Array( n, x ), which does not fill (AGENTS
 * traps 26 and 27). An index out of range, a row that is not an array or a list
 * that is not an array answer .F. and touch NOTHING. PURE. */
FUNCTION HcFsSetMark( aRes, n, lOn )
   LOCAL lNew := ( ValType( lOn ) == "L" .AND. lOn == .T. )
   IF ! HB_ISARRAY( aRes ) .OR. ValType( n ) != "N"
      RETURN .F.
   ENDIF
   n := Int( n )
   IF n < 1 .OR. n > Len( aRes ) .OR. ! HB_ISARRAY( aRes[ n ] )
      RETURN .F.
   ENDIF
   IF Len( aRes[ n ] ) < FSRW_MARK
      ASize( aRes[ n ], FSRW_MARK )
   ENDIF
   aRes[ n ][ FSRW_MARK ] := lNew
RETURN lNew

/* S3: how many rows are marked. PURE. */
FUNCTION HcFsMarkCount( aRes )
   LOCAL i, n := 0
   IF ! HB_ISARRAY( aRes )
      RETURN 0
   ENDIF
   FOR i := 1 TO Len( aRes )
      IF HcFsMark( aRes, i )
         n++
      ENDIF
   NEXT
RETURN n

/* S3/S5: mark (or unmark) EVERY row and answer how many ended up marked, which
 * is what the header of the results box shows after `Alt-I`. PURE. */
FUNCTION HcFsMarkAll( aRes, lOn )
   LOCAL lNew := ( ValType( lOn ) == "L" .AND. lOn == .T. ), n := 0, i
   IF ! HB_ISARRAY( aRes )
      RETURN 0
   ENDIF
   FOR i := 1 TO Len( aRes )
      IF HB_ISARRAY( aRes[ i ] )
         IF HcFsSetMark( aRes, i, lNew )
            n++
         ENDIF
      ENDIF
   NEXT
RETURN n

/* S3/S4: the three states of the header checkbox - 0 none, 1 some, 2 all. An
 * empty list has nothing marked, so it answers 0. PURE. */
FUNCTION HcFsMarkState( aRes )
   LOCAL i, nRows := 0, nMark := 0
   IF ! HB_ISARRAY( aRes )
      RETURN 0
   ENDIF
   FOR i := 1 TO Len( aRes )
      IF HB_ISARRAY( aRes[ i ] )
         nRows++
         IF HcFsMark( aRes, i )
            nMark++
         ENDIF
      ENDIF
   NEXT
   IF nRows == 0 .OR. nMark == 0
      RETURN 0
   ENDIF
   IF nMark >= nRows
      RETURN 2
   ENDIF
RETURN 1

/* S3/S10: the glyph of the checkbox, ALWAYS three cells (`[X]` / `[ ]`). The
 * state is told by the TEXT and never by a band (the rule of the project), so
 * this feature needs no new colour at all. PURE. */
FUNCTION HcFsMarkText( lOn )
RETURN iif( ValType( lOn ) == "L" .AND. lOn == .T., "[X]", "[ ]" )

/* S3/S4: the glyph of the HEADER cell, the three states of HcFsMarkState() as
 * `[X]` (all marked), `[-]` (some) and `[ ]` (none). PURE. */
FUNCTION HcFsMarkHead( aRes )
   LOCAL nState := HcFsMarkState( aRes )
   DO CASE
   CASE nState == 2
      RETURN HcFsMarkText( .T. )
   CASE nState == 1
      RETURN "[-]"
   ENDCASE
RETURN HcFsMarkText( .F. )

/* S10: one row of the results list. The path is cut FROM THE LEFT (HcPathTitle()
 * keeps the tail, which is where the file name lives) and the hit count is
 * right-aligned in FSR_HITS cells; a row with 0 hits - the name only search of
 * S10.b - shows the padding only. An absent or out of range index paints a full
 * row of blanks of the width asked for. PURE. */
FUNCTION HcFsListLine( aRes, n, nW )
   LOCAL cPath := "", cHits := "", nPathW, nHits
   IF ValType( nW ) != "N" .OR. nW <= 0
      RETURN ""
   ENDIF
   nW := Int( nW )
   nPathW := Max( 0, nW - FSR_HITS )
   IF HB_ISARRAY( aRes ) .AND. ValType( n ) == "N" .AND. ;
      n >= 1 .AND. n <= Len( aRes ) .AND. HB_ISARRAY( aRes[ n ] )
      IF ValType( aRes[ n ][ FSRW_PATH ] ) == "C"
         cPath := aRes[ n ][ FSRW_PATH ]
      ENDIF
      nHits := iif( ValType( aRes[ n ][ FSRW_HITS ] ) == "N", aRes[ n ][ FSRW_HITS ], 0 )
      IF nHits > 0
         cHits := PadL( LTrim( Str( nHits ) ), FSR_HITS )
      ENDIF
   ENDIF
   IF Len( cHits ) == 0
      cHits := Space( FSR_HITS )
   ENDIF
RETURN Left( PadR( HcPathTitle( cPath, nPathW ), nPathW ) + cHits, nW )

/* S10: the status row of the result under the cursor: `DD/MM/YY  HH:MM  N bytes
 *  M hits`, and "" for an empty list or an index out of range. The time is only
 * printed when the row carries it (fifth slot), so a four slot row still reads
 * the same way. PURE. */
FUNCTION HcFsStatusText( aRes, nSel )
   LOCAL aRow, c := "", cTime := "", nHits, nSize
   IF ! HB_ISARRAY( aRes ) .OR. ValType( nSel ) != "N"
      RETURN ""
   ENDIF
   IF nSel < 1 .OR. nSel > Len( aRes ) .OR. ! HB_ISARRAY( aRes[ nSel ] )
      RETURN ""
   ENDIF
   aRow := aRes[ nSel ]
   c := HcDateStr( aRow[ FSRW_DATE ] )
   IF Len( aRow ) >= FSRW_TIME
      cTime := HcTimeStr( aRow[ FSRW_TIME ] )
      IF Len( RTrim( cTime ) ) > 0
         c += "  " + cTime
      ENDIF
   ENDIF
   nSize := iif( ValType( aRow[ FSRW_SIZE ] ) == "N", aRow[ FSRW_SIZE ], 0 )
   nHits := iif( ValType( aRow[ FSRW_HITS ] ) == "N", aRow[ FSRW_HITS ], 0 )
RETURN c + "  " + LTrim( Str( nSize ) ) + " bytes  " + ;
       LTrim( Str( nHits ) ) + " hits"

/* S10.c: ONE result is re-read after the viewer (F3) or the editor (F4) came
 * back: the size, the date and the time of the row are refreshed in place, the
 * content is recounted when `Search text:` is ON and a row that no longer
 * matches the search is REMOVED from the list (the array is a reference, so the
 * screen and the caller see it). Answers { nHits, cMsg }: cMsg is
 * `No longer matches: <file>.`, "" when the row still matches or "" with a
 * positive count when it does. PURE but for the read of the file itself: no
 * screen, no message box. */
FUNCTION HcFsRefresh( aRes, nSel, aSt )
   LOCAL aRow, aList, aE, aRead, cPath, cName, cMsg := "", cData
   LOCAL dDate := CToD( "" ), cTime := "", nSize := 0, nHits := 0, nAt := 0, i
   LOCAL lMatch := .T., lTxt
   IF ! HB_ISARRAY( aRes ) .OR. ValType( nSel ) != "N"
      RETURN { 0, "" }
   ENDIF
   IF nSel < 1 .OR. nSel > Len( aRes ) .OR. ! HB_ISARRAY( aRes[ nSel ] )
      RETURN { 0, "" }
   ENDIF
   aRow  := aRes[ nSel ]
   cPath := iif( ValType( aRow[ FSRW_PATH ] ) == "C", aRow[ FSRW_PATH ], "" )
   cName := hb_FNameNameExt( cPath )
   IF Len( AllTrim( cPath ) ) == 0 .OR. ! hb_vfExists( cPath )
      lMatch := .F.
   ELSE
      aList := HcReadDir( HcDirArg( HcParentDir( cPath ) ) )
      FOR i := 1 TO Len( aList )
         IF HB_ISARRAY( aList[ i ] ) .AND. ValType( aList[ i ][ HC_E_NAME ] ) == "C" .AND. ;
            Upper( aList[ i ][ HC_E_NAME ] ) == Upper( cName )
            nAt := i
            EXIT
         ENDIF
      NEXT
      IF nAt == 0
         lMatch := .F.
      ELSE
         aE := aList[ nAt ]
         nSize := iif( ValType( aE[ HC_E_SIZE ] ) == "N", aE[ HC_E_SIZE ], 0 )
         dDate := aE[ HC_E_DATE ]
         cTime := iif( Len( aE ) >= HC_E_TIME, aE[ HC_E_TIME ], "" )
         aRow[ FSRW_SIZE ] := nSize
         aRow[ FSRW_DATE ] := dDate
         IF Len( aRow ) >= FSRW_TIME
            aRow[ FSRW_TIME ] := cTime
         ENDIF
         /* the mask and the filters can stop matching too (a file renamed into
          * another extension, one that grew over the size filter...) */
         IF ! HcFsMaskOk( cName, aSt ) .OR. ! HcFsFilterOk( aE, aSt )
            lMatch := .F.
         ENDIF
      ENDIF
   ENDIF
   lTxt := HB_ISARRAY( aSt ) .AND. Len( aSt ) >= FSX_TEXT .AND. aSt[ FSX_TXT ] == .T.
   IF lMatch .AND. lTxt
      aRead := HcFsRead( cPath, aSt[ FSX_HEX ] == .T. )
      IF ! aRead[ 1 ]
         /* it is not searchable any more (binary, too big or gone): that is
          * exactly "no longer matches" */
         lMatch := .F.
      ELSE
         cData := aRead[ 2 ]
         nHits := HcFsTextHits( cData, aSt, HcFsMatcher( aSt ) )
         IF aSt[ FSX_NOT ] == .T.
            lMatch := ( nHits == 0 )
         ELSE
            lMatch := ( nHits > 0 )
         ENDIF
      ENDIF
   ENDIF
   IF ! lMatch
      nHits := 0
      ADel( aRes, nSel )
      ASize( aRes, Len( aRes ) - 1 )
      cMsg := "No longer matches: " + cName + "."
   ELSEIF lTxt
      aRow[ FSRW_HITS ] := nHits
   ELSE
      nHits := iif( ValType( aRow[ FSRW_HITS ] ) == "N", aRow[ FSRW_HITS ], 0 )
   ENDIF
RETURN { nHits, cMsg }

/* =====================================================================
 *  S11 / S12 -- the REPLACEMENT of the File search (T4 of hc-file-search.md)
 *
 *  The screen finds; this block writes. It is the engine of the editor's
 *  Replace All (HcReplaceAll()) applied file by file, and every write goes
 *  through ONE atomic writer (HcFsWriteFile()) so a failure can never leave a
 *  half written file behind:
 *
 *    HcFsWriteFile()   <file>.$$$ -> <file>.$$$BAK -> <file>, or nothing
 *    HcFsReplaceText() the bytes of one buffer with the hits replaced
 *    HcFsReplaceFile() one file: read, count, write only when there is a hit
 *    HcFsReplaceAll()  every row of the list, summing up
 *    HcFsReplaceAct()  what the two keys of the screen ask for (Alt-R / Alt-L)
 * ===================================================================== */

/* S12: the atomic write of the zip rewrite (S50 of hc-zip-browse.md). The bytes
 * go to <cFile>.$$$ first; only when they are ALL written the original is moved
 * to <cFile>.$$$BAK, the temporary takes its place and the backup is erased. On
 * any failure the backup goes back where it was, the temporary is erased and the
 * file is left BYTE FOR BYTE as it was - the answer says what really failed.
 * hb_vfRename() answers 0 on success (AGENTS trap 44), never .T., so it is never
 * used as a boolean. { lOk, cErr }. */
FUNCTION HcFsWriteFile( cFile, cData )
   LOCAL cTmp, cBak, nOut, nWritten
   IF ValType( cFile ) != "C" .OR. Len( AllTrim( cFile ) ) == 0
      RETURN { .F., "File not found" }
   ENDIF
   IF ValType( cData ) != "C"
      cData := ""
   ENDIF
   cTmp := cFile + ".$$$"
   cBak := cFile + ".$$$BAK"
   /* a leftover of an interrupted run: the temporary is rubbish, but a backup
    * whose original is MISSING is the only copy of the file, so it goes back
    * before anything else is touched */
   IF hb_vfExists( cTmp )
      FErase( cTmp )
   ENDIF
   IF hb_vfExists( cBak )
      IF ! hb_vfExists( cFile )
         hb_vfRename( cBak, cFile )
      ELSE
         FErase( cBak )
      ENDIF
   ENDIF
   nOut := FCreate( cTmp )
   IF nOut < 0
      RETURN { .F., "Cannot create the temporary file (error " + ;
                     LTrim( Str( FError() ) ) + ")" }
   ENDIF
   IF Len( cData ) > 0
      nWritten := FWrite( nOut, cData )
      IF ValType( nWritten ) != "N" .OR. nWritten != Len( cData )
         FClose( nOut )
         FErase( cTmp )
         RETURN { .F., "Cannot write the temporary file (error " + ;
                        LTrim( Str( FError() ) ) + ")" }
      ENDIF
   ENDIF
   FClose( nOut )
   /* a file that did not exist yet has no original to move out of the way: the
    * temporary simply takes its name (a brand new file cannot lose anything) */
   IF ! hb_vfExists( cFile )
      IF hb_vfRename( cTmp, cFile ) != 0
         FErase( cTmp )
         RETURN { .F., "Cannot create the file (error " + LTrim( Str( FError() ) ) + ")" }
      ENDIF
      RETURN { .T., "" }
   ENDIF
   /* the original out of the way: if this fails nothing was touched */
   IF hb_vfRename( cFile, cBak ) != 0
      FErase( cTmp )
      RETURN { .F., "Cannot rename the file (error " + LTrim( Str( FError() ) ) + ")" }
   ENDIF
   IF hb_vfRename( cTmp, cFile ) != 0
      /* the new file did not take its place: the backup goes back */
      hb_vfRename( cBak, cFile )
      FErase( cTmp )
      RETURN { .F., "Cannot replace the file (error " + LTrim( Str( FError() ) ) + ")" }
   ENDIF
   FErase( cBak )
RETURN { .T., "" }

/* S11: the bytes of one buffer with every hit replaced, as { cData, nCount }.
 * The work per line is HcReplaceAll(), the SAME engine Replace All uses in the
 * editor (S84), so `$1`..`$9`, `&` and `$$` of the replacement mean exactly the
 * same here. The lines are put back together with HcFsJoin(), so each line keeps
 * its OWN terminator: CRLF stays CRLF, a mixed file stays mixed and a file with
 * no trailing newline stays without one. PURE. */
FUNCTION HcFsReplaceText( cData, aMt, cRepl )
   LOCAL aLines, aTxt := {}, aOut, aNew := {}, i
   IF ValType( cData ) != "C"
      RETURN { "", 0 }
   ENDIF
   aLines := HcFsLines( cData )
   FOR i := 1 TO Len( aLines )
      AAdd( aTxt, aLines[ i ][ 1 ] )
   NEXT
   aOut := HcReplaceAll( aTxt, aMt, NIL, NIL, cRepl )
   FOR i := 1 TO Len( aLines )
      AAdd( aNew, { iif( i <= Len( aOut[ 1 ] ), aOut[ 1 ][ i ], aLines[ i ][ 1 ] ), ;
                    aLines[ i ][ 2 ] } )
   NEXT
RETURN { HcFsJoin( aNew ), aOut[ 2 ] }

/* S11/S12: the replacement of ONE file as { nCount, cErr, lSkipped }. The file
 * is read with HcFsRead() FIRST, so nothing is ever written from a read that did
 * not succeed: a binary in text mode, a file over the cap or a missing file come
 * back SKIPPED (lSkipped) with the reason HcFsRead() gave. A read-only file is
 * skipped too (trap 66: hb_vfAttrGet() answers .T./.F. and leaves the mask in
 * the SECOND parameter). A file with no hit is NEVER touched. PURE but for the
 * reads and the one write: no screen, no message. */
FUNCTION HcFsReplaceFile( cFile, aMt, cRepl, lHex )
   LOCAL aRead, aRep, aWrite, nAttr := 0
   IF ValType( cFile ) != "C" .OR. Len( AllTrim( cFile ) ) == 0
      RETURN { 0, "File not found", .T. }
   ENDIF
   aRead := HcFsRead( cFile, lHex )
   IF ! aRead[ 1 ]
      RETURN { 0, aRead[ 3 ], .T. }
   ENDIF
   IF hb_vfAttrGet( cFile, @nAttr ) .AND. ;
      hb_bitAnd( nAttr, HB_FA_READONLY ) != 0
      RETURN { 0, "Read only", .T. }
   ENDIF
   aRep := HcFsReplaceText( aRead[ 2 ], aMt, cRepl )
   IF aRep[ 2 ] == 0
      RETURN { 0, "", .F. }
   ENDIF
   aWrite := HcFsWriteFile( cFile, aRep[ 1 ] )
   IF ! aWrite[ 1 ]
      RETURN { 0, aWrite[ 2 ], .F. }
   ENDIF
RETURN { aRep[ 2 ], "", .F. }

/* S11/S7 of hc-fsearch-marks.md: the sentence of a whole Replace All, built in
 * ONE place so the screen and the bank can never word it two ways: `<n>
 * occurrence(s) replaced in <m> file(s).`, then `, <k> failed` and `, <s>
 * skipped` when those two counts are not zero, and at the end `, <o> not
 * selected` for the rows whose checkbox is OFF (the fifth argument is OPTIONAL,
 * so every old caller keeps its sentence and its signature). PURE. */
FUNCTION HcFsReplaceMsg( nCount, nFiles, nFailed, nSkipped, nOff )
   LOCAL c := "0 occurrence(s) replaced in 0 file(s)"
   IF ValType( nCount ) == "N" .AND. ValType( nFiles ) == "N"
      c := LTrim( Str( nCount ) ) + " occurrence(s) replaced in " + ;
           LTrim( Str( nFiles ) ) + " file(s)"
   ENDIF
   IF ValType( nFailed ) == "N" .AND. nFailed > 0
      c += ", " + LTrim( Str( nFailed ) ) + " failed"
   ENDIF
   IF ValType( nSkipped ) == "N" .AND. nSkipped > 0
      c += ", " + LTrim( Str( nSkipped ) ) + " skipped"
   ENDIF
   IF ValType( nOff ) == "N" .AND. nOff > 0
      c += ", " + LTrim( Str( nOff ) ) + " not selected"
   ENDIF
RETURN c + "."

/* S11/S7: `Replace All` over the rows of the list, as { nFiles, nCount, nFailed,
 * nSkipped, cMsg, nOff }. One row is one file and HcFsReplaceFile() decides: a
 * file that is skipped (read only, binary, too large) goes to nSkipped, one
 * whose write failed goes to nFailed, and only a file that really had hits and
 * was written counts in nFiles/nCount.
 *
 * The checkbox of the row is honoured HERE: a row whose mark is OFF is not even
 * READ - it is counted in the sixth slot (nOff) and its file is left byte for
 * byte as it was -, and the sentence names it (`<o> not selected`). The sixth
 * slot is NEW and LAST, so every old caller of the four first ones and of the
 * message keeps working. PURE but for the writes. */
FUNCTION HcFsReplaceAll( aRes, aMt, cRepl, lHex )
   LOCAL aRep, cPath, nFiles := 0, nCount := 0, nFailed := 0, nSkipped := 0, nOff := 0, i
   IF ! HB_ISARRAY( aRes )
      RETURN { 0, 0, 0, 0, HcFsReplaceMsg( 0, 0, 0, 0 ), 0 }
   ENDIF
   FOR i := 1 TO Len( aRes )
      IF ! HB_ISARRAY( aRes[ i ] ) .OR. ValType( aRes[ i ][ FSRW_PATH ] ) != "C"
         LOOP
      ENDIF
      cPath := aRes[ i ][ FSRW_PATH ]
      IF Len( AllTrim( cPath ) ) == 0
         LOOP
      ENDIF
      IF ! HcFsMark( aRes, i )
         /* S7: the checkbox is OFF, so this file is NOT selected: it is not
          * read, it is not written and it only shows up in the count */
         nOff++
         LOOP
      ENDIF
      aRep := HcFsReplaceFile( cPath, aMt, cRepl, lHex )
      IF aRep[ 3 ] == .T.
         nSkipped++
      ELSEIF Len( aRep[ 2 ] ) > 0
         nFailed++
      ELSEIF aRep[ 1 ] > 0
         nFiles++
         nCount += aRep[ 1 ]
      ENDIF
   NEXT
RETURN { nFiles, nCount, nFailed, nSkipped, ;
         HcFsReplaceMsg( nCount, nFiles, nFailed, nSkipped, nOff ), nOff }

/* S11: what the two actions of the screen DO - `Alt-R` = Replace and `Alt-L` =
 * Replace all - as { cMsg, nSel, lErr }. There is no dialog any more: the
 * replacement is typed in the `Replace with:` line of the SAME form as the
 * search (the user's request, verbatim), so the query, its options and the
 * replacement travel in ONE state array and the matcher is built from it.
 *
 * The refusals come FIRST and in this order - the box off, Hexadecimal mode,
 * `Search text:` off, an empty result list and a query that cannot be searched
 * (HcFsBad()) - and none of them touches a file or opens a confirmation. The
 * third element says that the answer is a refusal, so the screen paints it as an
 * error.
 *
 * `nSel` comes in and goes out as the row of the list the cursor is on: a
 * replacement can make that row disappear (HcFsRefresh() re-reads it and removes
 * it when it no longer matches), so the caller gets back the row to keep. */
FUNCTION HcFsReplaceAct( cAct, aSt, aRes, nSel )
   LOCAL cMsg := "", cPath, cName, cRepl, aMt, aRead, aRep, aAll
   LOCAL nSum := 0, nRows := 0, nBefore, i
   IF ValType( nSel ) != "N"
      nSel := 0
   ENDIF
   IF ! HB_ISARRAY( aSt ) .OR. Len( aSt ) < FSX_REPL
      RETURN { "Turn on Replace with to replace.", nSel, .T. }
   ENDIF
   IF ValType( aSt[ FSX_REPLON ] ) != "L" .OR. aSt[ FSX_REPLON ] != .T.
      RETURN { "Turn on Replace with to replace.", nSel, .T. }
   ENDIF
   IF aSt[ FSX_HEX ] == .T.
      RETURN { "Replace is not available in Hexadecimal mode.", nSel, .T. }
   ENDIF
   IF aSt[ FSX_TXT ] != .T.
      RETURN { "Turn on Search text to replace.", nSel, .T. }
   ENDIF
   IF ! HB_ISARRAY( aRes ) .OR. Len( aRes ) == 0
      RETURN { "Search something first.", nSel, .T. }
   ENDIF
   cMsg := HcFsBad( aSt )
   IF Len( cMsg ) > 0
      RETURN { cMsg, nSel, .T. }
   ENDIF
   cRepl := iif( ValType( aSt[ FSX_REPL ] ) == "C", aSt[ FSX_REPL ], "" )
   aMt   := HcFsMatcher( aSt )
   IF ! HB_ISARRAY( aMt )
      RETURN { "Not found.", nSel, .T. }
   ENDIF
   IF aMt[ HM_BAD ] == .T.
      RETURN { "Invalid regular expression.", nSel, .T. }
   ENDIF

   IF cAct == "replace"
      /* ONE file: the row under the cursor. It is read FIRST by
       * HcFsReplaceFile(), so a read that did not succeed never becomes a write,
       * and a file with 0 hits is not touched at all. */
      IF nSel < 1 .OR. nSel > Len( aRes ) .OR. ! HB_ISARRAY( aRes[ nSel ] )
         nSel := 1
      ENDIF
      cPath := iif( ValType( aRes[ nSel ][ FSRW_PATH ] ) == "C", ;
                    aRes[ nSel ][ FSRW_PATH ], "" )
      cName := hb_FNameNameExt( cPath )
      IF Len( AllTrim( cPath ) ) == 0
         RETURN { "Nothing to replace.", nSel, .T. }
      ENDIF
      aRep := HcFsReplaceFile( cPath, aMt, cRepl, .F. )
      /* S10.c: the row is re-read and recounted, so it either shows its new hit
       * count or leaves the list when the file no longer matches */
      HcFsRefresh( aRes, nSel, aSt )
      IF nSel > Len( aRes )
         nSel := Len( aRes )
      ENDIF
      IF nSel < 1 .AND. Len( aRes ) > 0
         nSel := 1
      ENDIF
      IF aRep[ 1 ] > 0
         RETURN { LTrim( Str( aRep[ 1 ] ) ) + " occurrence(s) replaced in " + cName + ".", ;
                  nSel, .F. }
      ENDIF
      DO CASE
      CASE aRep[ 2 ] == "Read only"
         RETURN { "Skipped (read only): " + cName + ".", nSel, .T. }
      CASE aRep[ 2 ] == "Binary file"
         RETURN { "Skipped (binary file): " + cName + ".", nSel, .T. }
      CASE aRep[ 2 ] == "File too large"
         RETURN { "Skipped (file too large): " + cName + ".", nSel, .T. }
      CASE Len( aRep[ 2 ] ) > 0
         RETURN { aRep[ 2 ] + ": " + cName + ".", nSel, .T. }
      ENDCASE
      RETURN { "Nothing to replace in " + cName + ".", nSel, .F. }
   ENDIF

   /* `Alt-L` = Replace all: the totals are RECOUNTED with the matcher of the
    * form before the question is asked, and nothing is written until it is
    * answered. ONE confirmation names both totals.
    * S7 of hc-fsearch-marks.md: the checkbox of each row decides. With ZERO
    * marked rows nothing is counted, no confirmation is opened, nothing is
    * written and the answer is an ERROR (`No result is selected to replace.`).
    * A row without the mark is not even read. `Alt-R` (above) never looks at the
    * checkbox: it is an explicit action on the row under the cursor. */
   FOR i := 1 TO Len( aRes )
      IF ! HcFsMark( aRes, i )
         LOOP
      ENDIF
      IF ! HB_ISARRAY( aRes[ i ] ) .OR. ValType( aRes[ i ][ FSRW_PATH ] ) != "C"
         LOOP
      ENDIF
      cPath := aRes[ i ][ FSRW_PATH ]
      IF Len( AllTrim( cPath ) ) == 0
         LOOP
      ENDIF
      nRows++
      aRead := HcFsRead( cPath, .F. )
      IF aRead[ 1 ]
         nSum += HcFsTextHits( aRead[ 2 ], aSt, aMt )
      ENDIF
   NEXT
   IF nRows == 0
      RETURN { "No result is selected to replace.", nSel, .T. }
   ENDIF
   IF nSum == 0
      RETURN { "Nothing to replace.", nSel, .F. }
   ENDIF
   IF ! HcConfirm( "Replace " + LTrim( Str( nSum ) ) + " occurrence(s) in " + ;
                   LTrim( Str( nRows ) ) + " file(s)?", "Search and replace" )
      RETURN { "Nothing replaced.", nSel, .F. }
   ENDIF
   aAll := HcFsReplaceAll( aRes, aMt, cRepl, .F. )
   /* every row is recounted with the rule of the screen and the ones that no
    * longer match leave the list (HcFsRefresh() answers nothing when the row it
    * was given is gone, so it walks with the index held still) */
   i := 1
   DO WHILE i <= Len( aRes )
      nBefore := Len( aRes )
      HcFsRefresh( aRes, i, aSt )
      IF Len( aRes ) == nBefore
         i++
      ENDIF
   ENDDO
   IF nSel > Len( aRes )
      nSel := Len( aRes )
   ENDIF
   IF nSel < 1 .AND. Len( aRes ) > 0
      nSel := 1
   ENDIF
RETURN { aAll[ 5 ], nSel, .F. }

/* -------------------------------------------------------------- the form --- */

/* the label of a control of the left column; DIM when its filter is off */
STATIC PROCEDURE HcSearchLabel( nRow, nCol, cText, lDim )
   SetColor( iif( lDim, UI_C_BOXDIM, UI_C_BOX ) )
   @ nRow, nCol SAY cText
   SetColor( UI_C_BOX )
RETURN

/* S19: one text field. The colour is the ONE focus colour of the program
 * (UI_C_LISTSEL) when it has the focus and the two soft, fixed backgrounds when
 * it does not - never the green of the older dialogs (S13.5, the rule of the
 * `File attributes` dialog): UI_C_FIELDBG for the two SEARCH fields (`Search:`
 * and `Search text:`, the ones the user reads as a query) and the interior of
 * the box (UI_C_BOX) for the rest. A DIM field belongs to a filter that is OFF:
 * it is painted dimmed and it is NOT registered, so neither the mouse nor the
 * ring can reach it. */
STATIC PROCEDURE HcSearchField( nRow, nCol, nW, cValue, lFocus, lDim, nIdx, lSoft )
   LOCAL c := PadR( Left( iif( ValType( cValue ) == "C", cValue, "" ), nW ), nW )
   DEFAULT lSoft TO .F.
   IF lDim
      SetColor( UI_C_BOXDIM )
      @ nRow, nCol SAY c
   ELSE
      SetColor( iif( lFocus, UI_C_LISTSEL, iif( lSoft == .T., UI_C_FIELDBG, UI_C_BOX ) ) )
      @ nRow, nCol SAY c
      HcSyncCtlAdd( nRow, nCol, nW, "FSFLD", nIdx )
   ENDIF
   SetColor( UI_C_BOX )
RETURN

/* one checkbox: `[X] label`, registered with its own index. Every label carries
 * its quick letter inside it (`~X~`, S18) and HcSearchCheck() paints AND
 * registers the whole box, so the chord and the click act on the same thing.
 * S19/L14: a box carries NO background of its own - it rests on the background
 * of the form (UI_C_BOX when off, UI_C_FLATBG when on, the same cyan either way)
 * and its state is read from the `[X]`/`[ ]` glyph; only the FOCUS paints a
 * band, the yellow of UI_C_LISTSEL, which is why the 7th parameter `lFocus`
 * exists (the ring stop this box already toggles). The content options are
 * painted DIM and unregistered while `Search text:` is OFF (S13/S14), so a
 * click on them does nothing at all. */
STATIC PROCEDURE HcSearchCheck( nRow, nCol, lOn, lDim, cLabel, nIdx, lFocus )
   LOCAL nLab := Len( StrTran( cLabel, "~", "" ) )
   LOCAL cCol := iif( lDim, UI_C_BOXDIM, ;
                      iif( lFocus == .T., UI_C_LISTSEL, ;
                           iif( lOn == .T., UI_C_FLATBG, UI_C_BOX ) ) )
   LOCAL cHot := iif( lDim, UI_C_BOXDIM, iif( lFocus == .T., UI_C_HOTSEL, UI_C_HOT ) )
   SetColor( cCol )
   @ nRow, nCol SAY "[" + iif( lOn == .T., "X", " " ) + "]"
   IF Empty( UiHotKey( cLabel ) )
      UiWrite( nRow, nCol + 4, PadR( cLabel, nLab ), cCol )
   ELSE
      UiDrawHot( nRow, nCol + 4, PadR( cLabel, nLab + 2 ), cCol, cHot )
   ENDIF
   SetColor( UI_C_BOX )
   IF ! lDim
      HcSyncCtlAdd( nRow, nCol, 4 + nLab, "FSCHK", nIdx )
   ENDIF
RETURN

/* one chip with a value that `Enter` / `left` / `right` walk (the depth, the
 * size operator and the size unit). S19/L14: a chip carries NO background of its
 * own either - at rest it is FLAT on the form (UI_C_FLATBG) and only the focus
 * paints the yellow band */
STATIC PROCEDURE HcSearchChip( nRow, nCol, nW, cValue, lFocus, lDim, nIdx )
   LOCAL c := "[" + PadR( " " + cValue + " ", nW - 2 ) + "]"
   IF lDim
      SetColor( UI_C_BOXDIM )
      @ nRow, nCol SAY c
   ELSE
      SetColor( iif( lFocus, UI_C_LISTSEL, UI_C_FLATBG ) )
      @ nRow, nCol SAY c
      HcSyncCtlAdd( nRow, nCol, nW, "FSPIK", nIdx )
   ENDIF
   SetColor( UI_C_BOX )
RETURN

/* one tab of the strip: the active one in the selection colour of the box, the
 * other one FLAT on the form (S19/L14: only the inputs carry a background). The
 * quick letter (`Alt+G`, `Alt+A`, S20) is painted INSIDE its own label by
 * UiDrawHot(), and the visible width and the click rectangle are computed over
 * the label WITHOUT its marks - exactly what HcSearchButton() does -, so neither
 * the tab nor its click target moves. Returns the column of the next tab. */
STATIC FUNCTION HcSearchTab( nRow, nCol, cLabel, lActive, nIdx )
   LOCAL cPlain := StrTran( cLabel, "~", "" )
   LOCAL nW := Len( cPlain ) + 4
   LOCAL cCol := iif( lActive == .T., UI_C_BOXSEL, UI_C_FLATBG )
   LOCAL cHot := iif( lActive == .T., UI_C_HOTSEL, UI_C_HOT )
   SetColor( cCol )
   @ nRow, nCol SAY Space( nW )
   UiDrawHot( nRow, nCol, "[ " + cLabel + " ]", cCol, cHot )
   HcSyncCtlAdd( nRow, nCol, nW, "FSTAB", nIdx )
   SetColor( UI_C_BOX )
RETURN nCol + nW + 2

/* one button: the focused one in the selection colour of the box and the other
 * one FLAT, resting on the background of the form (UI_C_FLATBG, S19/L14) with
 * the same yellow quick letter either way - its brackets are what keeps it
 * reading as a button, not a band; the quick letter (`Alt+S`, `Alt+C`) is
 * painted INSIDE its own label by UiDrawHot(), which is the convention of
 * HcFindBtn()/HcAttrButton(). */
STATIC PROCEDURE HcSearchButton( nRow, nCol, cLabel, lFocus, nIdx )
   LOCAL cPlain := StrTran( cLabel, "~", "" )
   LOCAL nW := Len( cPlain ) + 4
   LOCAL cCol := iif( lFocus == .T., UI_C_BOXSEL, UI_C_FLATBG )
   LOCAL cHot := iif( lFocus == .T., UI_C_HOTSEL, UI_C_HOT )
   SetColor( cCol )
   @ nRow, nCol SAY Space( nW )
   UiDrawHot( nRow, nCol, "[ " + cLabel + " ]", cCol, cHot )
   HcSyncCtlAdd( nRow, nCol, nW, "FSBTN", nIdx )
   SetColor( UI_C_BOX )
RETURN

/* one key chip of the bottom row, chained with HcHintKey() so the chips never
 * overlap; the chip answers the mouse with the very key it announces */
STATIC FUNCTION HcSearchHint( nRow, nCol, cKey, cAct )
   LOCAL nW := Len( cKey ) + 2 + Len( cAct ) + 2
   HcSyncCtlAdd( nRow, nCol, nW, "KEY", cKey )
RETURN HcHintKey( nRow, nCol, cKey, cAct )

/* DD/MM/YYYY as the mask shows it, or the empty mask `  /  /    ` - the same
 * shape and the same helpers the `File attributes` dialog uses (S13.2) */
STATIC FUNCTION HcSearchDateShow( d )
   LOCAL cTpl := HcAttrMaskTpl( "DATE" )
RETURN HcAttrMaskShow( HcAttrMaskDigits( HcAttrDateText( d ), cTpl ), cTpl )

/* the focus stop behind a text field index (S13: the painters register the
 * INDEX of the control, the ring works with the STOPS of bp_def.ch) */
STATIC FUNCTION HcSearchFieldStop( nIdx )
   DO CASE
   CASE nIdx == 1 ; RETURN FSF_MASK
   CASE nIdx == 2 ; RETURN FSF_DIR
   CASE nIdx == 3 ; RETURN FSF_TEXT
   CASE nIdx == 4 ; RETURN FSF_D1
   CASE nIdx == 5 ; RETURN FSF_D2
   CASE nIdx == 6 ; RETURN FSF_NDAYS
   CASE nIdx == 7 ; RETURN FSF_SVAL
   CASE nIdx == 8 ; RETURN FSF_REPL
   ENDCASE
RETURN 0

/* the focus stop behind a checkbox index */
STATIC FUNCTION HcSearchCheckStop( nIdx )
   DO CASE
   CASE nIdx == 1  ; RETURN FSF_MASKRE
   CASE nIdx == 2  ; RETURN FSF_ONLYSEL
   CASE nIdx == 3  ; RETURN FSF_TEXT
   CASE nIdx == 4  ; RETURN FSF_WORD
   CASE nIdx == 5  ; RETURN FSF_CASE
   CASE nIdx == 6  ; RETURN FSF_RE
   CASE nIdx == 7  ; RETURN FSF_HEX
   CASE nIdx == 8  ; RETURN FSF_NOT
   CASE nIdx == 9  ; RETURN FSF_DATES
   CASE nIdx == 10 ; RETURN FSF_DAYS
   CASE nIdx == 11 ; RETURN FSF_SIZE
   CASE nIdx == 12 ; RETURN FSF_REPL
   ENDCASE
RETURN 0

/* the focus stop behind a pick chip index */
STATIC FUNCTION HcSearchPickStop( nIdx )
   DO CASE
   CASE nIdx == 1 ; RETURN FSF_DEPTH
   CASE nIdx == 2 ; RETURN FSF_SOP
   CASE nIdx == 3 ; RETURN FSF_SUNIT
   ENDCASE
RETURN 0

/* .T. when the stop is one of the text (or masked) fields, i.e. when a typed
 * character has to open it */
STATIC FUNCTION HcSearchIsText( nStop )
RETURN nStop == FSF_MASK .OR. nStop == FSF_DIR .OR. nStop == FSF_TEXT .OR. ;
       nStop == FSF_REPL .OR. nStop == FSF_D1 .OR. nStop == FSF_D2 .OR. ;
       nStop == FSF_NDAYS .OR. nStop == FSF_SVAL

/* .T. when the stop is one of the three chips */
STATIC FUNCTION HcSearchIsPick( nStop )
RETURN nStop == FSF_DEPTH .OR. nStop == FSF_SOP .OR. nStop == FSF_SUNIT

/* S13.6: `Space` (and a click, which produces the same thing) toggles the box of
 * that stop; a stop that is not a box does nothing */
STATIC PROCEDURE HcSearchToggle( aSt, nStop )
   LOCAL i := 0
   DO CASE
   CASE nStop == FSF_MASKRE  ; i := FSX_MASKRE
   CASE nStop == FSF_ONLYSEL ; i := FSX_ONLYSEL
   CASE nStop == FSF_TEXT    ; i := FSX_TXT
   CASE nStop == FSF_WORD    ; i := FSX_WORD
   CASE nStop == FSF_CASE    ; i := FSX_CASE
   CASE nStop == FSF_RE      ; i := FSX_RE
   CASE nStop == FSF_HEX     ; i := FSX_HEX
   CASE nStop == FSF_NOT     ; i := FSX_NOT
   CASE nStop == FSF_REPL    ; i := FSX_REPLON
   CASE nStop == FSF_DATES   ; i := FSX_DATES
   CASE nStop == FSF_DAYS    ; i := FSX_DAYS
   CASE nStop == FSF_SIZE    ; i := FSX_SIZE
   ENDCASE
   IF i > 0
      aSt[ i ] := ! ( ValType( aSt[ i ] ) == "L" .AND. aSt[ i ] )
   ENDIF
RETURN

/* the result under a given index as the text of the status row needs it; the
 * screen keeps `nSel` 1-based and 0 when there is no result at all */
STATIC FUNCTION HcSearchThumb( aScr )
   LOCAL n := Len( aScr[ FSS_RES ] ), nVis := FSR_LAST - FSR_FIRST + 1, nSize, nPos
   IF n <= nVis
      RETURN { 0, 0 }
   ENDIF
   nSize := Max( 1, Int( nVis * nVis / n ) )
   nPos := Int( ( aScr[ FSS_TOP ] - 1 ) * ( nVis - nSize ) / Max( 1, n - nVis ) )
   nPos := Max( 0, Min( nPos, nVis - nSize ) )
RETURN { nPos, nSize }

/* moves the cursor of the list to nTo, keeping it inside the visible window
 * (the HcCursorTo() rule). Answers .T. when something really changed, which is
 * what decides how much has to be repainted */
STATIC FUNCTION HcSearchSet( aScr, nTo )
   LOCAL n := Len( aScr[ FSS_RES ] ), nVis := FSR_LAST - FSR_FIRST + 1
   LOCAL nSel, nTop, lChg
   IF n < 1
      lChg := ( aScr[ FSS_SEL ] != 0 .OR. aScr[ FSS_TOP ] != 1 )
      aScr[ FSS_SEL ] := 0
      aScr[ FSS_TOP ] := 1
      RETURN lChg
   ENDIF
   nSel := Min( Max( 1, nTo ), n )
   nTop := aScr[ FSS_TOP ]
   IF nSel < nTop
      nTop := nSel
   ENDIF
   IF nSel > nTop + nVis - 1
      nTop := nSel - nVis + 1
   ENDIF
   nTop := Max( 1, Min( nTop, Max( 1, n - nVis + 1 ) ) )
   lChg := ( nSel != aScr[ FSS_SEL ] .OR. nTop != aScr[ FSS_TOP ] )
   aScr[ FSS_SEL ] := nSel
   aScr[ FSS_TOP ] := nTop
RETURN lChg

STATIC FUNCTION HcSearchMove( aScr, nDelta )
RETURN HcSearchSet( aScr, aScr[ FSS_SEL ] + nDelta )

/* ------------------------------------------------------------- painters --- */

/* the tab strip of row FSB_TABS. `left`/`right` on the strip, `Space`, `Enter`
 * (the stop FSF_TABS) and a click on a tab all end here. */
STATIC PROCEDURE HcSearchDrawTabs( aScr )
   LOCAL nCol := FSB_L + 2
   nCol := HcSearchTab( FSB_TABS, nCol, "~G~eneral", aScr[ FSS_TAB ] == 1, 1 )
   nCol := HcSearchTab( FSB_TABS, nCol, "~A~dvanced", aScr[ FSS_TAB ] == 2, 2 )
RETURN

/* the `General` tab, exactly the labels of S2 */
STATIC PROCEDURE HcSearchDrawGeneral( aSt, aScr )
   LOCAL nFoc := aScr[ FSS_FOC ]
   LOCAL lList := aScr[ FSS_LIST ]
   LOCAL lTxt := ( aSt[ FSX_TXT ] == .T. )
   HcSearchLabel( FSB_R1, FSB_COL, "Search:", .F. )
   HcSearchField( FSB_R1, FSB_FLD, FSB_FLDW, aSt[ FSX_MASK ], ;
                  ( ! lList .AND. nFoc == FSF_MASK ), .F., 1, .T. )
   HcSearchCheck( FSB_R1, FSB_MASKRE, aSt[ FSX_MASKRE ], .F., "Reg~u~lar expression", 1, ;
                  ( ! lList .AND. nFoc == FSF_MASKRE ) )
   HcSearchLabel( FSB_R2, FSB_COL, "Search in:", .F. )
   HcSearchField( FSB_R2, FSB_FLD, FSB_FLDW, aSt[ FSX_DIR ], ;
                  ( ! lList .AND. nFoc == FSF_DIR ), .F., 2, .F. )
   HcSearchCheck( FSB_R3, FSB_COL, aSt[ FSX_ONLYSEL ], .F., ;
                  "Search ~o~nly in the selected entries", 2, ;
                  ( ! lList .AND. nFoc == FSF_ONLYSEL ) )
   HcSearchLabel( FSB_R4, FSB_COL, "Subdirectories:", .F. )
   HcSearchChip( FSB_R4, FSB_DEPTH, 7, HcFsDepthText( aSt[ FSX_DEPTH ] ), ;
                 ( ! lList .AND. nFoc == FSF_DEPTH ), .F., 1 )
   HcSearchCheck( FSB_R5, FSB_COL, aSt[ FSX_TXT ], .F., "Search ~t~ext:", 3, ;
                  ( ! lList .AND. nFoc == FSF_TEXT ) )
   HcSearchField( FSB_R5, FSB_TXTFLD, FSB_TXTW, aSt[ FSX_TEXT ], ;
                  ( ! lList .AND. nFoc == FSF_TEXT ), .F., 3, .T. )
   HcSearchCheck( FSB_R6, FSB_C1, aSt[ FSX_WORD ], ! lTxt, "~W~hole words only", 4, ;
                  ( ! lList .AND. nFoc == FSF_WORD ) )
   HcSearchCheck( FSB_R6, FSB_C2, aSt[ FSX_CASE ], ! lTxt, "~M~atch case", 5, ;
                  ( ! lList .AND. nFoc == FSF_CASE ) )
   HcSearchCheck( FSB_R7, FSB_C1, aSt[ FSX_RE ], ! lTxt, "Regular ~e~xpression", 6, ;
                  ( ! lList .AND. nFoc == FSF_RE ) )
   HcSearchCheck( FSB_R7, FSB_C2, aSt[ FSX_HEX ], ! lTxt, "~H~exadecimal", 7, ;
                  ( ! lList .AND. nFoc == FSF_HEX ) )
   HcSearchCheck( FSB_R8, FSB_C1, aSt[ FSX_NOT ], ! lTxt, ;
                  "Files that do ~N~OT contain the text", 8, ;
                  ( ! lList .AND. nFoc == FSF_NOT ) )
   /* S2/S11: the replacement lives in THIS form, one line under the five content
    * options - the user asked for it verbatim (`Replace with:` plus its input).
    * The field uses the same column and width as `Search text:`, and the whole
    * line follows the rule of the five options: dim and unreachable while
    * `Search text:` is OFF, because replacing needs a query. */
   HcSearchCheck( FSB_RREPL, FSB_COL, aSt[ FSX_REPLON ], ! lTxt, "Re~p~lace with:", 12, ;
                  ( ! lList .AND. nFoc == FSF_REPL ) )
   HcSearchField( FSB_RREPL, FSB_TXTFLD, FSB_TXTW, aSt[ FSX_REPL ], ;
                  ( ! lList .AND. nFoc == FSF_REPL ), ! lTxt, 8, .F. )
RETURN

/* the `Advanced` tab: the three filters, reusing the rows and the columns of the
 * General one. A filter that is OFF keeps its box reachable (it is the switch)
 * and dims and unregisters its own fields. */
STATIC PROCEDURE HcSearchDrawAdvanced( aSt, aScr )
   LOCAL nFoc := aScr[ FSS_FOC ]
   LOCAL lList := aScr[ FSS_LIST ]
   LOCAL lDates := ( aSt[ FSX_DATES ] == .T. )
   LOCAL lDays := ( aSt[ FSX_DAYS ] == .T. )
   LOCAL lSize := ( aSt[ FSX_SIZE ] == .T. )
   HcSearchCheck( FSB_R1, FSB_COL, lDates, .F., "~D~ate range:", 9, ;
                  ( ! lList .AND. nFoc == FSF_DATES ) )
   HcSearchField( FSB_R1, FSB_FLD, FSB_DATEW, HcSearchDateShow( aSt[ FSX_DATE1 ] ), ;
                  ( ! lList .AND. nFoc == FSF_D1 ), ! lDates, 4, .F. )
   HcSearchLabel( FSB_R1, FSB_AND, "and", ! lDates )
   HcSearchField( FSB_R1, FSB_DATE2, FSB_DATEW, HcSearchDateShow( aSt[ FSX_DATE2 ] ), ;
                  ( ! lList .AND. nFoc == FSF_D2 ), ! lDates, 5, .F. )
   HcSearchCheck( FSB_R3, FSB_COL, lDays, .F., "N~o~t older than:", 10, ;
                  ( ! lList .AND. nFoc == FSF_DAYS ) )
   HcSearchField( FSB_R3, FSB_NDAYS, FSB_NDAYW, aSt[ FSX_NDAYS ], ;
                  ( ! lList .AND. nFoc == FSF_NDAYS ), ! lDays, 6, .F. )
   HcSearchLabel( FSB_R3, FSB_NDAYS + FSB_NDAYW + 1, "day(s)", ! lDays )
   HcSearchCheck( FSB_RSIZE, FSB_COL, lSize, .F., "~F~ile size:", 11, ;
                  ( ! lList .AND. nFoc == FSF_SIZE ) )
   HcSearchChip( FSB_RSIZE, FSB_SOP, FSB_SOPW, HcFsSizeOpText( aSt[ FSX_SOP ] ), ;
                 ( ! lList .AND. nFoc == FSF_SOP ), ! lSize, 2 )
   HcSearchField( FSB_RSIZE, FSB_SVAL, FSB_SVALW, aSt[ FSX_SVAL ], ;
                  ( ! lList .AND. nFoc == FSF_SVAL ), ! lSize, 7, .F. )
   HcSearchChip( FSB_RSIZE, FSB_SUNIT, FSB_SUNITW, HcFsSizeUnitText( aSt[ FSX_SUNIT ] ), ;
                 ( ! lList .AND. nFoc == FSF_SUNIT ), ! lSize, 3 )
RETURN

/* the two buttons of row FSB_R9, shared by the two tabs and aligned to the right
 * (S2) */
STATIC PROCEDURE HcSearchDrawButtons( aScr )
   LOCAL lOk := ! aScr[ FSS_LIST ]
   HcSearchButton( FSB_R9, FSB_BTN2, "~S~earch", ;
                   lOk .AND. aScr[ FSS_FOC ] == FSF_BTSEARCH, 1 )
   HcSearchButton( FSB_R9, FSB_BTN2 + FSB_BTN_W + 2, "~C~ancel", ;
                   lOk .AND. aScr[ FSS_FOC ] == FSF_BTCANCEL, 2 )
RETURN

/* S1/S2/S10: ONE result row, from its index inside the list; a row outside the
 * window is not painted at all and an index with no result blanks the cells. The
 * row is the checkbox (FSR_MARK, 3 cells), one cell of air and then the text
 * from FSR_TEXT - the checkbox takes its 4 cells from the NAME, never from the
 * hit count of HcFsListLine(). The CALLER owns the paint block, so moving the
 * cursor or toggling ONE mark repaints only what changed. */
STATIC PROCEDURE HcSearchDrawResRow( aScr, nIdx )
   LOCAL nText := iif( aScr[ FSS_MARK ], FSR_TEXT, FSR_MARK )
   LOCAL nW := FSR_BAR - nText
   LOCAL nScr := FSR_FIRST + nIdx - aScr[ FSS_TOP ], cLine
   IF nScr < FSR_FIRST .OR. nScr > FSR_LAST
      RETURN
   ENDIF
   SetColor( UI_C_BOX )
   IF nIdx < 1 .OR. nIdx > Len( aScr[ FSS_RES ] )
      @ nScr, nText SAY Space( Max( 0, FSR_BAR - nText ) )
      RETURN
   ENDIF
   cLine := HcFsListLine( aScr[ FSS_RES ], nIdx, nW )
   /* S13.5, ONE focus at a time: the row carries the highlight of the program
    * (UI_C_LISTSEL) only while the LIST owns the focus. A click on a field or a
    * key that leaves the list takes that yellow away in the same repaint, so the
    * screen can never show two focused things at once (measured with the mouse
    * probe: before this rule a click on the mask field left the old row yellow
    * AND the field yellow). S10 of hc-fsearch-marks.md: the checkbox of the row
    * goes with the row colour, so it is yellow with it and never a band of its
    * own. */
   SetColor( iif( nIdx == aScr[ FSS_SEL ] .AND. aScr[ FSS_LIST ] == .T., UI_C_LISTSEL, UI_C_BOX ) )
   IF aScr[ FSS_MARK ]
      @ nScr, FSR_MARK SAY HcFsMarkText( HcFsMark( aScr[ FSS_RES ], nIdx ) ) + " "
   ENDIF
   @ nScr, nText SAY cLine
   SetColor( UI_C_BOX )
RETURN

/* S3/S4/S8 of hc-fsearch-marks.md: the checkbox CELL of the header row, the
 * three states of HcFsMarkHead() in the header colour. It is the "Alt-I" key
 * control of the click map, so a click on it produces EXACTLY the input the
 * chord produces (HcSearchClick() answers { 6, "Alt-I" } and the loop resolves it
 * with HcSyncChipInput()): the mark is toggled in ONE place, the DO CASE of the
 * keys. <lReg> is .F. when the caller is a partial repaint - the click map is
 * built by the FULL paint, so a partial one must not register it again. */
STATIC PROCEDURE HcSearchDrawHeadMark( aScr, lReg )
   /* S14: with `Replace with:` off there is no column to show nor to click */
   IF ! aScr[ FSS_MARK ]
      RETURN
   ENDIF
   SetColor( UI_C_HDR )
   @ FSR_HDR, FSR_MARK SAY HcFsMarkHead( aScr[ FSS_RES ] )
   SetColor( UI_C_BOX )
   IF ValType( lReg ) == "L" .AND. lReg == .T.
      HcSyncCtlAdd( FSR_HDR, FSR_MARK, FSR_MARKW, "KEY", "Alt-I" )
   ENDIF
RETURN

/* the scroll bar of the column FSR_BAR: a dim track of Chr( 176 ) and a darker
 * thumb of Chr( 178 ) in the same dim grey pair (the Compare screen measured that
 * a block character paints with the FOREGROUND of the pair, AGENTS trap 39) */
STATIC PROCEDURE HcSearchDrawScroll( aScr )
   LOCAL aT := HcSearchThumb( aScr ), i, nVis := FSR_LAST - FSR_FIRST + 1
   FOR i := 0 TO nVis - 1
      IF Empty( aT[ 2 ] )
         SetColor( UI_C_BOX )
         @ FSR_FIRST + i, FSR_BAR SAY " "
      ELSEIF i >= aT[ 1 ] .AND. i < aT[ 1 ] + aT[ 2 ]
         SetColor( UI_C_CMPTHUMB )
         @ FSR_FIRST + i, FSR_BAR SAY Chr( 178 )
      ELSE
         SetColor( UI_C_CMPTRACK )
         @ FSR_FIRST + i, FSR_BAR SAY Chr( 176 )
      ENDIF
   NEXT
   SetColor( UI_C_BOX )
RETURN

/* the results box: frame, header with the two counts and the header checkbox,
 * every visible row and the scroll bar */
STATIC PROCEDURE HcSearchDrawResults( aScr )
   LOCAL i, nTot := Len( aScr[ FSS_RES ] ), nHits := 0
   LOCAL nText := iif( aScr[ FSS_MARK ], FSR_TEXT, FSR_MARK )
   LOCAL cRight, nW := FSR_BAR - nText + 1, nVis := FSR_LAST - FSR_FIRST + 1
   FOR i := 1 TO nTot
      IF HB_ISARRAY( aScr[ FSS_RES ][ i ] ) .AND. ValType( aScr[ FSS_RES ][ i ][ FSRW_HITS ] ) == "N"
         nHits += aScr[ FSS_RES ][ i ][ FSRW_HITS ]
      ENDIF
   NEXT
   UiFillBox( FSR_T, FSR_L, FSR_B, FSR_R, UI_C_BOX )
   UiFrame( FSR_T, FSR_L, FSR_B, FSR_R, UI_C_BOXBORD, .F. )
   SetColor( UI_C_HDR )
   @ FSR_HDR, nText SAY PadR( " Results", nW )
   cRight := LTrim( Str( nTot ) ) + " files, " + LTrim( Str( nHits ) ) + " hits "
   IF Len( cRight ) < nW
      @ FSR_HDR, nText + nW - Len( cRight ) SAY cRight
   ENDIF
   SetColor( UI_C_BOX )
   /* S4: the header checkbox, painted AFTER the label (PadR wipes the cells from
    * FSR_TEXT on) and registered as the "Alt-I" key control */
   HcSearchDrawHeadMark( aScr, .T. )
   FOR i := 1 TO nVis
      HcSearchDrawResRow( aScr, aScr[ FSS_TOP ] + i - 1 )
   NEXT
   HcSearchDrawScroll( aScr )
RETURN

STATIC PROCEDURE HcSearchDrawStatus( aScr )
   LOCAL c := HcFsStatusText( aScr[ FSS_RES ], aScr[ FSS_SEL ] )
   SetColor( UI_C_STATUS )
   @ FS_ROW_STATUS, 0 SAY PadR( " " + c, UiCols() )
   SetColor( UI_C_DESKTOP )
RETURN

STATIC PROCEDURE HcSearchDrawMsg( aScr )
   SetColor( iif( aScr[ FSS_ERR ], UI_C_ERR, UI_C_STATUSBAR ) )
   @ FS_ROW_MSG, 0 SAY PadR( " " + iif( ValType( aScr[ FSS_MSG ] ) == "C", aScr[ FSS_MSG ], "" ), ;
                             UiCols() )
   SetColor( UI_C_DESKTOP )
RETURN

STATIC PROCEDURE HcSearchDrawHint( aScr )
   LOCAL nCol := 1
   SetColor( UI_C_MENUBAR )
   @ FS_ROW_HINT, 0 SAY Space( UiCols() )
   nCol := HcSearchHint( FS_ROW_HINT, nCol, "F5", "=Search" )
   nCol := HcSearchHint( FS_ROW_HINT, nCol, "Alt-R", "=Replace" )
   nCol := HcSearchHint( FS_ROW_HINT, nCol, "Alt-L", "=Replace all" )
   nCol := HcSearchHint( FS_ROW_HINT, nCol, "F3", "=View" )
   nCol := HcSearchHint( FS_ROW_HINT, nCol, "F4", "=Edit" )
   nCol := HcSearchHint( FS_ROW_HINT, nCol, "Enter", "=Go to file" )
   nCol := HcSearchHint( FS_ROW_HINT, nCol, "Esc", "=Close" )
   /* S6/S14 of hc-fsearch-marks.md: the EIGHTH chip of the footer, chained with
    * the other seven (never a fixed column) and appended at the END, so none of
    * the seven moves nor gets shortened. `Alt-I` is the only free letter: A is
    * the `Advanced` tab and U/O/T/W/M/E/H/N/P/D/F are checkboxes. It is painted
    * (and registered) ONLY while the checkbox column of the results is active,
    * so the footer never announces a key that does nothing. */
   IF aScr[ FSS_MARK ]
      nCol := HcSearchHint( FS_ROW_HINT, nCol, "Alt-I", "=All" )
   ENDIF
   SetColor( UI_C_DESKTOP )
RETURN

/* the whole screen, inside the caller's paint block: the clickable controls are
 * rebuilt on EVERY paint (S13.6), so a click can never land on a control that
 * moved or is there no more. There is no modal box over this screen any more:
 * the replacement lives in the `Replace with:` line of the form, so this painter
 * is the only thing that ever owns the click map. */
STATIC PROCEDURE HcSearchDrawScreen( aSt, aScr )
   HcSyncCtlReset()
   /* S14 of hc-fsearch-marks.md: the checkbox column of the results belongs to
    * the REPLACEMENT, so it only exists while replacing is possible. The flag is
    * settled here, on every FULL paint (a full paint follows every change of
    * the form), so the partial repaints can read it without carrying aSt. */
   aScr[ FSS_MARK ] := HcFsMarkOn( aSt )
   UiCls()
   SetColor( UI_C_CHIP )
   @ 0, 0 SAY PadR( " Search and replace ", UiCols() )
   /* the form box: the shadow goes first, so the results box painted below
    * covers the part of it that falls on its top border */
   UiShadow( FSB_T, FSB_L, FSB_B, FSB_R )
   UiFillBox( FSB_T, FSB_L, FSB_B, FSB_R, UI_C_BOX )
   UiFrame( FSB_T, FSB_L, FSB_B, FSB_R, UI_C_BOXBORD, .F. )
   HcSearchDrawTabs( aScr )
   IF aScr[ FSS_TAB ] == 2
      HcSearchDrawAdvanced( aSt, aScr )
   ELSE
      HcSearchDrawGeneral( aSt, aScr )
   ENDIF
   HcSearchDrawButtons( aScr )
   HcSearchDrawResults( aScr )
   HcSearchDrawStatus( aScr )
   HcSearchDrawMsg( aScr )
   HcSearchDrawHint( aScr )
   SetColor( UI_C_DESKTOP )
RETURN

STATIC PROCEDURE HcSearchPaint( aSt, aScr )
   UiPaintBegin()
   HcSearchDrawScreen( aSt, aScr )
   UiPaintEnd()
RETURN

/* only the two rows the cursor left and reached plus the status row and the
 * scroll bar; a scrolled window repaints the whole visible area. In ONE paint
 * block either way. */
STATIC PROCEDURE HcSearchPaintMoved( aSt, aScr, nOld, nOldTop )
   UiPaintBegin()
   IF aScr[ FSS_TOP ] != nOldTop
      HcSearchDrawResults( aScr )
   ELSE
      HcSearchDrawResRow( aScr, nOld )
      HcSearchDrawResRow( aScr, aScr[ FSS_SEL ] )
      HcSearchDrawScroll( aScr )
   ENDIF
   HcSearchDrawStatus( aScr )
   UiPaintEnd()
RETURN

/* S8 of hc-fsearch-marks.md: toggling the checkbox of ONE row repaints that row
 * (and the header cell, because its three-state glyph can change) inside ONE
 * paint block. No Scroll(): in GTWVG it does not carry the text buffer. */
STATIC PROCEDURE HcSearchPaintMark( aScr )
   UiPaintBegin()
   HcSearchDrawResRow( aScr, aScr[ FSS_SEL ] )
   HcSearchDrawHeadMark( aScr, .F. )
   UiPaintEnd()
RETURN

/* S8/S5: `Alt-I` toggles EVERY row, so the whole results box (the visible rows
 * plus the header cell) is repainted, also inside ONE paint block. */
STATIC PROCEDURE HcSearchPaintMarks( aScr )
   LOCAL i, nVis := FSR_LAST - FSR_FIRST + 1
   UiPaintBegin()
   FOR i := 1 TO nVis
      HcSearchDrawResRow( aScr, aScr[ FSS_TOP ] + i - 1 )
   NEXT
   HcSearchDrawHeadMark( aScr, .F. )
   UiPaintEnd()
RETURN

/* ------------------------------------------------------------------- run --- */

/* S9: the progress box of the scan. The total is only known once the walk is
 * done, so the box is opened by the FIRST step reported and closed by the
 * screen right after the scan; its answer (.T. when <Esc> was pressed) is what
 * CANCELS the search, keeping the results found so far (the HcProgStep() pattern
 * of the copy). */
STATIC FUNCTION HcSearchProg( nDone, nTotal, cWhat )
   IF ! s_lFsProgOn
      s_lFsProgOn := .T.
      UiProgBegin( "Searching", nTotal, .T. )
   ENDIF
RETURN UiProgUpdate( nDone, nTotal, cWhat )

/* S6: the marked entries of the ACTIVE panel as { cPath, aEntry } pairs, the list
 * HcFsScan() takes when `Search only in the selected entries` is ON. A marked
 * FOLDER brings its files with the same depth rule of the search; a marked file
 * comes as it is. Empty when nothing is marked. */
STATIC FUNCTION HcFsSelList( aSt )
   LOCAL aP := HcPanelActive(), aOut := {}, aE, aSub, cPath, i, j
   FOR i := 1 TO Len( aP[ HC_P_LIST ] )
      aE := aP[ HC_P_LIST ][ i ]
      IF ! HB_ISARRAY( aE ) .OR. Len( aE ) < HC_E_ATTR
         LOOP
      ENDIF
      IF ValType( aE[ HC_E_MARK ] ) != "L" .OR. ! aE[ HC_E_MARK ]
         LOOP
      ENDIF
      IF ValType( aE[ HC_E_NAME ] ) != "C"
         LOOP
      ENDIF
      cPath := HcJoinPath( aP[ HC_P_DIR ], aE[ HC_E_NAME ] )
      IF HcIsDir( aE )
         aSub := HcFsWalk( cPath, aSt )
         FOR j := 1 TO Len( aSub )
            AAdd( aOut, aSub[ j ] )
         NEXT
      ELSE
         AAdd( aOut, { cPath, aE } )
      ENDIF
   NEXT
RETURN aOut

/* S9: run the search of the form and move the results into the screen state,
 * with the focus on the list when there is something to walk (S2) */
STATIC PROCEDURE HcSearchRun( aSt, aScr )
   LOCAL aOnly, aScan
   IF aSt[ FSX_ONLYSEL ] == .T.
      aOnly := HcFsSelList( aSt )
   ENDIF
   aScan := HcFsScan( aSt, {| nDone, nTotal, cWhat | HcSearchProg( nDone, nTotal, cWhat ) }, aOnly )
   IF s_lFsProgOn
      UiProgEnd()
      s_lFsProgOn := .F.
   ENDIF
   aScr[ FSS_RES ]  := aScan[ 1 ]
   aScr[ FSS_SEL ]  := iif( Len( aScan[ 1 ] ) > 0, 1, 0 )
   aScr[ FSS_TOP ]  := 1
   aScr[ FSS_MSG ]  := aScan[ 2 ]
   aScr[ FSS_ERR ]  := ( Len( aScan[ 1 ] ) == 0 )
   aScr[ FSS_LIST ] := ( Len( aScan[ 1 ] ) > 0 )
   aSt[ FSX_MSG ]   := aScan[ 2 ]
   /* S3: a search REPLACES what the screen remembers (an empty result list
    * clears it), so reopening never shows the results of an older search */
   HcSearchRemember( aScr[ FSS_RES ], aScr[ FSS_SEL ], aScr[ FSS_TOP ], aSt[ FSX_DIR ] )
RETURN

/* S10.b: `Enter` on a result (or a double click) goes to the FILE: the screen
 * closes and the ACTIVE panel is left in the folder of that result with the
 * cursor on the file. Answers .T. when there is somewhere to go (the caller
 * closes the screen with it); a linked panel and a file that is gone answer .F.
 * and say why. */
STATIC FUNCTION HcSearchGoto( aScr )
   LOCAL aP, cPath, cName
   IF ValType( aScr[ FSS_SEL ] ) != "N" .OR. aScr[ FSS_SEL ] < 1 .OR. ;
      aScr[ FSS_SEL ] > Len( aScr[ FSS_RES ] )
      RETURN .F.
   ENDIF
   IF HcLinkGuard()
      RETURN .F.
   ENDIF
   cPath := aScr[ FSS_RES ][ aScr[ FSS_SEL ] ][ FSRW_PATH ]
   cName := hb_FNameNameExt( cPath )
   IF Len( AllTrim( cPath ) ) == 0 .OR. ! hb_vfExists( cPath )
      aScr[ FSS_MSG ] := "The file is not there any more: " + cPath
      aScr[ FSS_ERR ] := .T.
      RETURN .F.
   ENDIF
   aP := HcPanelActive()
   aP[ HC_P_DIR ] := HcParentDir( cPath )
   HcLoad( aP )
   HcGotoName( aP, cName )
RETURN .T.

/* S10.c: `F3` / `F4` on the result under the cursor. Both screens are full
 * screen and save and restore the canvas by themselves, so coming back here is
 * one full repaint with the SAME results, the SAME cursor and the SAME form; the
 * file is then re-read and recounted (HcFsRefresh) and a row that no longer
 * matches disappears from the list. */
STATIC PROCEDURE HcSearchAct( aSt, aScr, nKey, cResDir )
   LOCAL cPath, aNew
   IF ValType( aScr[ FSS_SEL ] ) != "N" .OR. aScr[ FSS_SEL ] < 1 .OR. ;
      aScr[ FSS_SEL ] > Len( aScr[ FSS_RES ] )
      RETURN
   ENDIF
   cPath := aScr[ FSS_RES ][ aScr[ FSS_SEL ] ][ FSRW_PATH ]
   IF nKey == K_F3
      HcView( cPath )
   ELSE
      HcEdit( cPath )
   ENDIF
   /* the two screens leave their own cursor state behind: this one owns it again */
   SetCursor( 0 )
   aNew := HcFsRefresh( aScr[ FSS_RES ], aScr[ FSS_SEL ], aSt )
   IF Len( aNew[ 2 ] ) > 0
      aScr[ FSS_MSG ] := aNew[ 2 ]
      aScr[ FSS_ERR ] := .F.
   ENDIF
   IF aScr[ FSS_SEL ] > Len( aScr[ FSS_RES ] )
      aScr[ FSS_SEL ] := Len( aScr[ FSS_RES ] )
   ENDIF
   IF aScr[ FSS_SEL ] < 1 .AND. Len( aScr[ FSS_RES ] ) > 0
      aScr[ FSS_SEL ] := 1
   ENDIF
   HcSearchSet( aScr, aScr[ FSS_SEL ] )
   /* S3: the viewer/editor came back and HcFsRefresh() may have recounted or
    * dropped the row, so the session memory follows the list the screen shows,
    * with the folder THAT list came from (the caller owns it) */
   HcSearchRemember( aScr[ FSS_RES ], aScr[ FSS_SEL ], aScr[ FSS_TOP ], cResDir )
RETURN

/* the ALT letter of a keystroke ("" when there is none). The ALT ring of the
 * window hook hands the letter over as a plain key with the ALT bit (trap 61),
 * and CTRL is refused so AltGr - Ctrl+Alt on a Spanish keyboard - is never a
 * shortcut (trap 38) */
STATIC FUNCTION HcSearchAltOf( nKey, nShift )
   LOCAL lAlt, lCtl
   IF ValType( nKey ) != "N" .OR. nKey < 32 .OR. nKey > 126
      RETURN ""
   ENDIF
   IF ValType( nShift ) != "N"
      RETURN ""
   ENDIF
   lAlt := hb_BitAnd( nShift, HB_GTI_KBD_ALT ) != 0
   lCtl := hb_BitAnd( nShift, HB_GTI_KBD_CTRL ) != 0
   IF ! lAlt .OR. lCtl
      RETURN ""
   ENDIF
RETURN Upper( Chr( nKey ) )

/* S13.3: the PURE part of "typing a character opens the field and enters it"
 * (the same rule as the `teclear directamente` of the structure editor and of
 * HcFindEdit() in the Find / Replace box of the editor). The character goes to
 * the FIRST cell of the value -it OVERWRITES it- and the tail is kept, so
 * typing `q` over `*.*` gives `q.*` and never `*.*q`. A digit field only takes
 * a digit, and a key that is not a printable character of this build (32..126:
 * Chr() can drop a byte >= 128, AGENTS trap 47) seeds nothing at all. Answers
 * the value the field editor opens with; "" means the old value is used as it
 * is, which is what Enter and Ins do. PURE: no screen, no disk. */
FUNCTION HcSearchSeed( cValue, nKey, lDigits )
   LOCAL cSeed := "", cTail
   DEFAULT lDigits TO .F.
   IF ValType( cValue ) != "C"
      cValue := ""
   ENDIF
   IF ValType( nKey ) != "N" .OR. nKey < 32 .OR. nKey > 126
      RETURN cValue
   ENDIF
   cSeed := Chr( nKey )
   IF lDigits .AND. ! ( cSeed >= "0" .AND. cSeed <= "9" )
      RETURN cValue
   ENDIF
   cTail := iif( Len( cValue ) > 1, SubStr( cValue, 2 ), "" )
RETURN cSeed + cTail

/* S13: the editor of ONE field of the form. The text fields are UiLineEdit()
 * (digits only for the two numbers, lTabNav so that Tab and Shift-Tab confirm
 * and walk the ring); the two dates use the FIXED MASK of the `File attributes`
 * dialog (HcAttrMaskEdit(): only digits, the `/` separators can neither be typed
 * over nor deleted and filling the last digit confirms alone), and an invalid
 * date is reported BEFORE anything is stored.
 *
 * It answers the Alt chord the field editor left pending ("" when there was
 * none): S13.7 made the editor of bp_ui.prg close on an Alt chord and leave it
 * to its caller -this screen-, so `Alt+S` typed INSIDE a field runs Search
 * instead of writing an `s` in the value. */
STATIC FUNCTION HcSearchEditField( aSt, aScr, nFirstKey )
   LOCAL nStop := aScr[ FSS_FOC ], nExit, cNew, cDisp, aV, lFull := .F.
   LOCAL dNew, iSlot := 0, nRow := FSB_R1, nCol := FSB_FLD, nW := FSB_FLDW
   LOCAL lDig := .F., cTpl := HcAttrMaskTpl( "DATE" )
   LOCAL lDate := .F., nKey := iif( ValType( nFirstKey ) == "N", nFirstKey, 0 )
   LOCAL cChord
   DO CASE
   CASE nStop == FSF_MASK
      iSlot := FSX_MASK
   CASE nStop == FSF_DIR
      iSlot := FSX_DIR
      nRow := FSB_R2
   CASE nStop == FSF_TEXT
      iSlot := FSX_TEXT
      nRow := FSB_R5
      nCol := FSB_TXTFLD
      nW   := FSB_TXTW
   CASE nStop == FSF_REPL
      iSlot := FSX_REPL
      nRow := FSB_RREPL
      nCol := FSB_TXTFLD
      nW   := FSB_TXTW
   CASE nStop == FSF_D1 .OR. nStop == FSF_D2
      lDate := .T.
      nCol := iif( nStop == FSF_D1, FSB_FLD, FSB_DATE2 )
      nW   := FSB_DATEW
   CASE nStop == FSF_NDAYS
      iSlot := FSX_NDAYS
      nRow := FSB_R3
      nCol := FSB_NDAYS
      nW   := FSB_NDAYW
      lDig := .T.
   CASE nStop == FSF_SVAL
      iSlot := FSX_SVAL
      nRow := FSB_R4
      nCol := FSB_SVAL
      nW   := FSB_SVALW
      lDig := .T.
   ENDCASE
   IF lDate
      cDisp := HcSearchDateShow( aSt[ iif( nStop == FSF_D1, FSX_DATE1, FSX_DATE2 ) ] )
      cDisp := HcAttrMaskEdit( nRow, nCol, cDisp, cTpl, nKey, .F., @lFull )
      aV := HcAttrDateVal( cDisp )
      IF aV[ 1 ] == .T.
         dNew := iif( hb_IsNIL( aV[ 2 ] ), CToD( "" ), aV[ 2 ] )
         aSt[ iif( nStop == FSF_D1, FSX_DATE1, FSX_DATE2 ) ] := dNew
      ELSE
         /* S13.2: NOTHING is stored when the date is invalid */
         aScr[ FSS_MSG ] := "Invalid date: " + AllTrim( cDisp )
         aScr[ FSS_ERR ] := .T.
      ENDIF
      /* the ring only moves when the value was COMPLETED by typing
       * (HcAttrMaskEdit() says so through <lFull>), the SET CONFIRM OFF rule */
      cChord := UiAltChord()
      HcAltHookFlush()
      IF lFull == .T.
         aScr[ FSS_FOC ] := HcSearchFocusStep( nStop, .F., aSt, aScr[ FSS_TAB ] )
      ENDIF
      RETURN cChord
   ENDIF
   IF iSlot == 0
      RETURN ""
   ENDIF
   /* S13.3: a character typed on the focused field OPENS it AND IS ENTERED -
    * HcSearchSeed() puts it in the first cell and keeps the tail -, which is
    * what leaves Enter free for "do". Before, the keystroke that opened the
    * editor was never handed over to it, so typing `alpha` left `lpha`. */
   cNew := UiLineEdit( nRow, nCol, nW, HcSearchSeed( aSt[ iSlot ], nKey, lDig ), ;
                       lDig, UI_C_LISTSEL, .F., .T. )
   nExit := UiEditExit()
   /* S13.7/trap 61: the Alt chord typed INSIDE the field editor, read BEFORE
    * the flush -it is pending in bp_ui.prg, not in the ALT ring any more- and
    * returned so the screen runs the same action the key would have run. What
    * else was typed inside the editor is not a quick key afterwards (flush). */
   cChord := UiAltChord()
   HcAltHookFlush()
   IF ! hb_IsNIL( cNew )
      aSt[ iSlot ] := cNew
   ENDIF
   IF nExit == K_TAB
      aScr[ FSS_FOC ] := HcSearchFocusStep( nStop, .F., aSt, aScr[ FSS_TAB ] )
   ELSEIF nExit == K_SH_TAB
      aScr[ FSS_FOC ] := HcSearchFocusStep( nStop, .T., aSt, aScr[ FSS_TAB ] )
   ENDIF
RETURN cChord

/* S14: `Enter` on one of the three chips: the list of its values (UiPick()) is
 * opened with the value in force pre-selected, so a chip can also be set by
 * choosing from a list instead of cycling it. The arrows use HcSearchStep() and
 * never open anything. */
STATIC PROCEDURE HcSearchPick( aSt, aScr )
   LOCAL nStop := aScr[ FSS_FOC ], aItems := {}, nSel := 0, cTitle := ""
   IF ! HcSearchIsPick( nStop )
      RETURN
   ENDIF
   DO CASE
   CASE nStop == FSF_DEPTH
      aItems := { "All", "None", "1", "2", "3", "5" }
      cTitle := "Subdirectories"
      nSel := AScan( aItems, {| c | c == HcFsDepthText( aSt[ FSX_DEPTH ] ) } )
   CASE nStop == FSF_SOP
      aItems := { "=", ">", "<" }
      cTitle := "File size"
      nSel := AScan( aItems, {| c | c == HcFsSizeOpText( aSt[ FSX_SOP ] ) } )
   CASE nStop == FSF_SUNIT
      aItems := { "Bytes", "KiB", "MiB" }
      cTitle := "File size"
      nSel := AScan( aItems, {| c | c == HcFsSizeUnitText( aSt[ FSX_SUNIT ] ) } )
   ENDCASE
   nSel := UiPick( aItems, cTitle, Max( 1, nSel ) )
   /* the box restores the screen behind it and takes the caret with it: this
    * screen owns the cursor, so it is hidden again (AGENTS: SetCursor(0)) */
   SetCursor( 0 )
   IF nSel < 1
      RETURN
   ENDIF
   DO CASE
   CASE nStop == FSF_DEPTH
      aSt[ FSX_DEPTH ] := { -1, 0, 1, 2, 3, 5 }[ nSel ]
   CASE nStop == FSF_SOP
      aSt[ FSX_SOP ] := aItems[ nSel ]
   CASE nStop == FSF_SUNIT
      aSt[ FSX_SUNIT ] := nSel
   ENDCASE
RETURN

/* ---------------------------------------------------------------- screen --- */

/* S14: the keys of the screen, for its own F1 */
STATIC PROCEDURE HcSearchHelp()
   LOCAL a := { ;
      "Search and replace: the files of a folder, by name and by content", ;
      "", ;
      "  Search:            the name mask (`*.*` by default, `;` separates a", ;
      "                     list of masks). With `Regular expression` it is a", ;
      "                     PCRE over the whole name, case-insensitive.", ;
      "  Search in:         the folder to walk.", ;
      "  Subdirectories:    All / None / 1 / 2 / 3 / 5 levels.", ;
      "  Search text:       also look INSIDE the files. The five options under", ;
      "                     it need this box on: whole words, match case,", ;
      "                     regular expression, hexadecimal (the only mode that", ;
      "                     reads binaries) and 'do NOT contain'.", ;
      "  Replace with:      the replacement, in THIS form: turn the box on and", ;
      "                     type it. It needs `Search text:` on, and Alt-R /", ;
      "                     Alt-L are the two actions that use it.", ;
      "  Advanced:          date range, 'not older than' N days and file size", ;
      "                     (operator, value and unit), ANDed together.", ;
      "", ;
      "  Tab / Shift-Tab    next / previous control (Up / Down do the same)", ;
      "  Left / Right       walk the chips and move the focus", ;
      "  Space              toggle the focused checkbox", ;
      "  Enter              edit the focused field, pick from a chip, run the", ;
      "                     focused button; on a result it GOES TO THE FILE", ;
      "  Ctrl-Tab           switch between General and Advanced", ;
      "  F5                 run the search (Esc cancels it and keeps what was", ;
      "                     found so far)", ;
      "  F3 / F4            view / edit the highlighted file and come back here", ;
      "                     with the same results (it is re-read and recounted)", ;
      "  Alt-R              replace in the HIGHLIGHTED file only", ;
      "  Alt-L              replace in EVERY MARKED result, after one", ;
      "                     confirmation (a result with its box off is left", ;
      "                     untouched)", ;
      "  Alt-S / Alt-C      the two buttons", ;
      "  F1                 this help             Esc  close the screen", ;
      "", ;
      "  Up / Down, PgUp / PgDn and Home / End walk the results, the wheel moves", ;
      "  one row per notch and a double click on a result is Enter.", ;
      "  Ins / Space        (focus on the results) check or uncheck the", ;
      "                     highlighted result", ;
      "  Alt-I              check every result, or uncheck them all when every", ;
      "                     one is already checked (also a click on the box of", ;
      "                     the Results header)" }
   UiTextWin( a, "Search and replace" )
RETURN

/* S31/S13.6: the mouse. The wheel moves the list one row per notch (and is
 * swallowed while the focus is on the form), a click on a result row puts the
 * cursor there, a double click on it returns Enter, a click on the scroll bar
 * goes one page back or on, and every other control becomes the SAME input the
 * keyboard produces, so the DO CASE of the key loop stays the only place where
 * an option acts. Returns { nKey, cAlt } or an empty array. */
STATIC FUNCTION HcSearchMouseInput( aSt, aScr )
   LOCAL nNotch, nRow, nCol, nIdx, nOld, nOldTop, aC, aHit, lDbl, aT, lWasList
   LOCAL nVis := FSR_LAST - FSR_FIRST + 1
   nNotch := HcMouseWheel()
   IF nNotch != 0
      IF aScr[ FSS_LIST ] .AND. Len( aScr[ FSS_RES ] ) > 0
         nOld := aScr[ FSS_SEL ]
         nOldTop := aScr[ FSS_TOP ]
         IF HcSearchMove( aScr, -nNotch )
            HcSearchPaintMoved( aSt, aScr, nOld, nOldTop )
         ENDIF
      ENDIF
      RETURN {}
   ENDIF
   nRow := HcMouseClickRow()
   nCol := HcMouseClickCol()
   lDbl := HcMouseClickDbl()
   IF nRow < 0 .OR. nCol < 0
      RETURN {}
   ENDIF
   IF nRow >= FSR_FIRST .AND. nRow <= FSR_LAST .AND. nCol >= FSR_L .AND. nCol <= FSR_R
      IF nCol == FSR_BAR
         /* a click on the scroll bar: above the thumb one page back, below it
          * one page on */
         aT := HcSearchThumb( aScr )
         IF ! Empty( aT[ 2 ] )
            nOld := aScr[ FSS_SEL ]
            nOldTop := aScr[ FSS_TOP ]
            IF nRow - FSR_FIRST < aT[ 1 ]
               HcSearchMove( aScr, -nVis )
            ELSE
               HcSearchMove( aScr, nVis )
            ENDIF
            HcSearchPaintMoved( aSt, aScr, nOld, nOldTop )
         ENDIF
         RETURN {}
      ENDIF
      nIdx := aScr[ FSS_TOP ] + ( nRow - FSR_FIRST )
      IF nIdx >= 1 .AND. nIdx <= Len( aScr[ FSS_RES ] )
         nOld := aScr[ FSS_SEL ]
         nOldTop := aScr[ FSS_TOP ]
         lWasList := aScr[ FSS_LIST ]
         aScr[ FSS_LIST ] := .T.
         HcSearchSet( aScr, nIdx )
         IF lWasList
            HcSearchPaintMoved( aSt, aScr, nOld, nOldTop )
         ELSE
            /* the focus comes FROM the form: its yellow has to go away with the
             * row, and the buttons go back to their normal colour, so this is a
             * full repaint (the same one the keyboard does when it leaves the
             * list). Without it the field kept its yellow and the screen showed
             * two focuses at once (measured with the mouse probe). */
            HcSearchPaint( aSt, aScr )
         ENDIF
         /* S9 of hc-fsearch-marks.md: a click on the CHECKBOX of the row puts
          * the cursor on that row (just done, with the focus on the list) and is
          * the Ins key, so the DO CASE of the key loop stays the ONLY place
          * where a mark acts. It answers before the double click: the checkbox
          * toggles on the click that lands on it and its cell never means
          * "Enter". */
         IF aScr[ FSS_MARK ] .AND. nCol >= FSR_MARK .AND. nCol < FSR_MARK + FSR_MARKW
            RETURN { K_INS, "" }
         ENDIF
         IF lDbl == .T.
            RETURN { K_ENTER, "" }
         ENDIF
      ENDIF
      RETURN {}
   ENDIF
   aC := HcSyncCtlAt( nRow, nCol )
   aHit := HcSearchClick( aC )
   IF ! HB_ISARRAY( aHit )
      RETURN {}
   ENDIF
   DO CASE
   CASE aHit[ 1 ] == 1
      /* a text field: the first click focuses it, a click on the field that
       * already has the focus opens it (Enter, in the key loop) */
      IF ! aScr[ FSS_LIST ] .AND. aScr[ FSS_FOC ] == HcSearchFieldStop( aHit[ 2 ] )
         RETURN { K_INS, "" }
      ENDIF
      aScr[ FSS_FOC ] := HcSearchFieldStop( aHit[ 2 ] )
      aScr[ FSS_LIST ] := .F.
      HcSearchPaint( aSt, aScr )
   CASE aHit[ 1 ] == 2
      aScr[ FSS_TAB ] := Min( 2, Max( 1, aHit[ 2 ] ) )
      aScr[ FSS_FOC ] := iif( aScr[ FSS_TAB ] == 1, FSF_MASK, FSF_DATES )
      aScr[ FSS_LIST ] := .F.
      HcSearchPaint( aSt, aScr )
   CASE aHit[ 1 ] == 3
      /* a checkbox toggles itself, which is exactly what Space does */
      aScr[ FSS_FOC ] := HcSearchCheckStop( aHit[ 2 ] )
      aScr[ FSS_LIST ] := .F.
      HcSearchToggle( aSt, aScr[ FSS_FOC ] )
      HcSearchFixFocus( aSt, aScr )
      HcSearchPaint( aSt, aScr )
   CASE aHit[ 1 ] == 4
      aScr[ FSS_FOC ] := iif( aHit[ 2 ] == 1, FSF_BTSEARCH, FSF_BTCANCEL )
      aScr[ FSS_LIST ] := .F.
      RETURN { K_ENTER, "" }
   CASE aHit[ 1 ] == 5
      aScr[ FSS_FOC ] := HcSearchPickStop( aHit[ 2 ] )
      aScr[ FSS_LIST ] := .F.
      RETURN { K_LEFT, "" }
   CASE aHit[ 1 ] == 6
      /* S13.6: one of the EIGHT key chips of the footer row. It becomes the VERY
       * input its name announces - the same { nKey, cAlt } the keyboard sends -
       * so the DO CASE of the key loop stays the only place where a key acts. A
       * name HcSyncChipInput() does not know answers { 0, "" }, and a 0 key
       * makes the caller do nothing at all instead of guessing an action. */
      RETURN HcSyncChipInput( aC[ 5 ] )
   ENDCASE
RETURN {}

/* a toggle can hide the control that has the focus (`Search text:` off with the
 * focus on `Match case`): the focus then walks on to the next reachable stop, so
 * it never sits on a dimmed control */
STATIC PROCEDURE HcSearchFixFocus( aSt, aScr )
   IF HcSearchSkip( aScr[ FSS_FOC ], aSt, aScr[ FSS_TAB ] )
      aScr[ FSS_FOC ] := HcSearchFocusStep( aScr[ FSS_FOC ], .T., aSt, aScr[ FSS_TAB ] )
   ENDIF
   IF aScr[ FSS_TAB ] == 2 .AND. aScr[ FSS_FOC ] < FSF_DATES
      aScr[ FSS_FOC ] := FSF_DATES
   ENDIF
RETURN

/* S2/S13/S14: the screen. Full screen (no SaveScreen), ONE paint block per
 * repaint, the system cursor hidden while it owns it, the ALT ring of the hook
 * as the source of the Alt+<letter> chords (trap 61) and the mouse polled on
 * every pass. */
STATIC PROCEDURE HcSearchScreen( aSt )
   LOCAL aScr := { FSF_MASK, 1, .F., {}, 0, 1, "", .F., .F. }
   LOCAL nKey, nShift, cAltCh, aIn, cAct, cAlt, cOldCur, lLeave := .F., lFull := .T.
   LOCAL nOld, nOldTop, nHot, aRep, cChord, aRec, cResDir := ""
   LOCAL nChk, nTabHot
   cOldCur := SetCursor( 0 )
   /* whatever the hook recorded BEFORE the screen opened is not a shortcut here */
   HcAltHookFlush()
   aScr[ FSS_MSG ] := aSt[ FSX_MSG ]
   /* S3: the results of the last search of the session come back WITHOUT pressing
    * F5, with the cursor and the scroll where they were left and the focus on the
    * list (that is where the user wants to be). The form is restored as always -
    * `Search in:` keeps the folder of the ACTIVE panel (L8) -, so when the
    * remembered list came from ANOTHER folder the message row says which one it
    * was instead of showing an old list under a new path in silence. The pairs
    * are put back through HcSearchSet(), which keeps the cursor inside the
    * visible window and clamps a top that no longer fits. */
   aRec := HcSearchRecall()
   IF Len( aRec ) > 0
      aScr[ FSS_RES ]  := aRec[ 1 ]
      aScr[ FSS_TOP ]  := aRec[ 3 ]
      aScr[ FSS_SEL ]  := 0
      HcSearchSet( aScr, aRec[ 2 ] )
      aScr[ FSS_LIST ] := .T.
      aScr[ FSS_MSG ]  := HcSearchRecallMsg( Len( aScr[ FSS_RES ] ), aRec[ 4 ], aSt[ FSX_DIR ] )
      aScr[ FSS_ERR ]  := .F.
      /* S3: the memory keeps saying where THIS list came from (it may be the
       * folder of the previous visit, not the one `Search in:` shows now), so
       * every save of this visit stores the pair list + folder together */
      cResDir := aRec[ 4 ]
   ENDIF
   DO WHILE ! lLeave
      /* S13.7: the chord a field editor of THIS pass leaves pending (the opt-in
       * Alt hook of bp_ui.prg) is handled by ONE place at the end of the pass,
       * so S / R / A run exactly the code their key runs */
      cChord := ""
      IF lFull
         HcSearchPaint( aSt, aScr )
         SetCursor( 0 )
         lFull := .F.
      ENDIF
      nKey := Inkey( 0.05 )
      /* the modifier state of THAT key, read immediately after Inkey() (this
       * driver answers the LIVE state: AGENTS trap 37) */
      nShift := HcShiftState()
      /* S13.7: inside a modal this driver can swallow an Alt+<letter> from
       * Inkey(); the ring of the window hook recorded it, and what the ring kept
       * WINS (trap 61): one keystroke is one character */
      cAltCh := HcHookDrain()
      IF Len( cAltCh ) > 0
         nKey   := Asc( Left( cAltCh, 1 ) )
         nShift := HB_GTI_KBD_ALT
      ENDIF
      /* right-click-esc (S1/S2/S7): a plain right click leaves the File search,
       * the same as Esc, and the results list goes with it */
      IF nKey == 0 .AND. HcMouseRightClick()
         nKey := K_ESC
      ENDIF
      IF nKey == 0
         aIn := HcSearchMouseInput( aSt, aScr )
         IF ! Empty( aIn )
            nKey := aIn[ 1 ]
            IF ! Empty( aIn[ 2 ] )
               /* the chip of a button hands over its Alt letter: the chord the
                * keyboard sends is the letter with the ALT bit */
               nKey   := Asc( Upper( aIn[ 2 ] ) )
               nShift := HB_GTI_KBD_ALT
            ENDIF
         ENDIF
      ENDIF
      IF nKey == 0
         LOOP
      ENDIF
      /* S13.7: the quick key of the two buttons becomes the same K_ENTER a click
       * on the button produces, so key, click and Enter run ONE path */
      nHot := HcSearchHot( nKey, nShift, aScr[ FSS_FOC ] )
      IF nHot > 0
         aScr[ FSS_FOC ] := iif( nHot == 1, FSF_BTSEARCH, FSF_BTCANCEL )
         aScr[ FSS_LIST ] := .F.
         nKey := K_ENTER
         lFull := .T.
      ENDIF
      cAlt := HcSearchAltOf( nKey, nShift )
      nChk := HcSearchChkHot( cAlt, aSt, aScr[ FSS_TAB ] )
      nTabHot := HcSearchTabHot( cAlt )
      nOld := aScr[ FSS_SEL ]
      nOldTop := aScr[ FSS_TOP ]
      DO CASE
      CASE nKey == K_ESC
         lLeave := .T.

      CASE nKey == K_F1
         HcSearchHelp()
         lFull := .T.

      CASE nChk != 0
         /* S18/T7: the quick letter of a checkbox - `Alt+<letter>` from ANY
          * stop of the form, because a bare letter belongs to the field that
          * has the focus. It is resolved BEFORE the two replacement chords:
          * those four letters (S / C / R / L) are the property of the buttons
          * and of the replacement, so no box wears one and this case can never
          * steal them (HcSearchChkHot() answers 0 for them). Toggling leaves
          * the focus ON the box that was toggled and repaints the whole form,
          * the same way Space does. */
         aScr[ FSS_FOC ] := nChk
         aScr[ FSS_LIST ] := .F.
         HcSearchToggle( aSt, aScr[ FSS_FOC ] )
         HcSearchFixFocus( aSt, aScr )
         lFull := .T.

      CASE nTabHot != 0
         /* S20/T10: the quick letter of a tab label - `Alt+G` / `Alt+A` from
          * ANY stop of the form, and it is resolved AFTER the boxes of the open
          * tab (no box wears G or A, so the two can never collide) and BEFORE
          * the two replacement chords. Switching the tab leaves the focus where
          * the click and Ctrl-Tab leave it, drops the results list and repaints
          * the whole form: one path, so key, click and Ctrl-Tab agree. */
         aScr[ FSS_TAB ] := nTabHot
         aScr[ FSS_FOC ] := iif( nTabHot == 1, FSF_MASK, FSF_DATES )
         aScr[ FSS_LIST ] := .F.
         lFull := .T.

      CASE cAlt == "R" .OR. cAlt == "L"
         /* S10.b/S11: replacing is an action APART from searching, and it lives
          * in `HcFsReplaceAct()` behind these two keys: `Alt-R` writes the file
          * of the highlighted result and `Alt-L` writes every result after ONE
          * confirmation. No box opens - the replacement comes from the
          * `Replace with:` line of this same form. The refusals (box off, hex
          * mode, `Search text:` off, empty list, a query that cannot be
          * searched) come from there in one place, and `.T.` on the third slot
          * means the message is an error (painted in UI_C_ERR). */
         aRep := HcFsReplaceAct( iif( cAlt == "R", "replace", "all" ), aSt, ;
                                 aScr[ FSS_RES ], aScr[ FSS_SEL ] )
         aScr[ FSS_MSG ] := aRep[ 1 ]
         aScr[ FSS_ERR ] := aRep[ 3 ]
         HcSearchSet( aScr, aRep[ 2 ] )
         /* S3: the replacement recounted (and may have emptied) the rows, so the
          * memory stores what the screen shows and not the list of before */
         HcSearchRemember( aScr[ FSS_RES ], aScr[ FSS_SEL ], aScr[ FSS_TOP ], cResDir )
         lFull := .T.

      CASE cAlt == "I" .AND. HcFsMarkOn( aSt )
         /* S5 of hc-fsearch-marks.md: `Alt-I` INVERTS every result - if all are
          * marked it unmarks them all, otherwise it marks them all -, and only
          * the visible rows and the header cell are repainted, in ONE block
          * (S8). The letter is I and not A because `A` is the `Advanced` tab and
          * U/O/T/W/M/E/H/N/P/D/F are checkboxes of the form; the chord travels in
          * the SAME channel as `Alt-R`/`Alt-L` (the ALT ring of the window hook),
          * so it also works with the caret inside the field editor, where the
          * editor closes keeping the value (S13.8). It never writes and it does
          * not touch the cursor. */
         HcFsMarkAll( aScr[ FSS_RES ], HcFsMarkState( aScr[ FSS_RES ] ) != 2 )
         HcSearchPaintMarks( aScr )

      CASE nKey == K_F5 .OR. HcSearchKey( nKey, nShift )
         HcSearchRun( aSt, aScr )
         cResDir := aSt[ FSX_DIR ]
         lFull := .T.

      CASE ( nKey == K_F3 .OR. nKey == K_F4 ) .AND. aScr[ FSS_LIST ]
         HcSearchAct( aSt, aScr, nKey, cResDir )
         lFull := .T.

      CASE nKey == K_ENTER
         IF aScr[ FSS_LIST ]
            /* S10.b: go to the file (the screen closes when there is one) */
            IF HcSearchGoto( aScr )
               lLeave := .T.
            ELSE
               lFull := .T.
            ENDIF
         ELSE
            cAct := HcSearchEnter( aSt, aScr[ FSS_FOC ], aScr[ FSS_TAB ] )
            DO CASE
            CASE cAct == "search"
               HcSearchRun( aSt, aScr )
               lFull := .T.
            CASE cAct == "cancel"
               lLeave := .T.
            CASE cAct == "edit"
               cChord := HcSearchEditField( aSt, aScr, 0 )
               lFull := .T.
            CASE cAct == "toggle"
               HcSearchToggle( aSt, aScr[ FSS_FOC ] )
               HcSearchFixFocus( aSt, aScr )
               lFull := .T.
            CASE cAct == "tab"
               aScr[ FSS_TAB ] := iif( aScr[ FSS_TAB ] == 1, 2, 1 )
               aScr[ FSS_FOC ] := iif( aScr[ FSS_TAB ] == 1, FSF_MASK, FSF_DATES )
               lFull := .T.
            CASE cAct == "pick"
               HcSearchPick( aSt, aScr )
               lFull := .T.
            ENDCASE
         ENDIF

      CASE nKey == K_INS .AND. ! aScr[ FSS_LIST ] .AND. HcSearchIsText( aScr[ FSS_FOC ] )
         cChord := HcSearchEditField( aSt, aScr, 0 )
         lFull := .T.

      CASE aScr[ FSS_LIST ] .AND. ( nKey == K_UP .OR. nKey == K_DOWN .OR. ;
           nKey == K_PGUP .OR. nKey == K_PGDN .OR. nKey == K_HOME .OR. nKey == K_END )
         /* S10/S14: the results list. Only the cursor moves, and only the rows
          * it leaves and reaches are repainted (one paint block) */
         DO CASE
         CASE nKey == K_UP
            HcSearchMove( aScr, -1 )
         CASE nKey == K_DOWN
            HcSearchMove( aScr, 1 )
         CASE nKey == K_PGUP
            HcSearchMove( aScr, -( FSR_LAST - FSR_FIRST + 1 ) )
         CASE nKey == K_PGDN
            HcSearchMove( aScr, FSR_LAST - FSR_FIRST + 1 )
         CASE nKey == K_HOME
            HcSearchMove( aScr, -Len( aScr[ FSS_RES ] ) )
         CASE nKey == K_END
            HcSearchMove( aScr, Len( aScr[ FSS_RES ] ) )
         ENDCASE
         IF aScr[ FSS_SEL ] != nOld .OR. aScr[ FSS_TOP ] != nOldTop
            HcSearchPaintMoved( aSt, aScr, nOld, nOldTop )
         ENDIF

      CASE ( nKey == K_INS .OR. nKey == K_SPACE ) .AND. aScr[ FSS_LIST ] .AND. ;
           Len( aScr[ FSS_RES ] ) > 0 .AND. aScr[ FSS_MARK ]
         /* S5/S9 of hc-fsearch-marks.md: Ins and Space with the focus on the
          * RESULTS list toggle the checkbox of the highlighted row. They do NOT
          * move the cursor, they never leave the list and they repaint that row
          * plus the header cell in ONE paint block (S8). The case is gated on
          * aScr[ FSS_LIST ] and it sits BEFORE the three `Space` cases of the
          * form, so it can never steal `Space` from a checkbox, a tab or a
          * chip. */
         HcFsSetMark( aScr[ FSS_RES ], aScr[ FSS_SEL ], ;
                      ! HcFsMark( aScr[ FSS_RES ], aScr[ FSS_SEL ] ) )
         HcSearchPaintMark( aScr )

      CASE nKey == K_SPACE .AND. ! aScr[ FSS_LIST ] .AND. aScr[ FSS_FOC ] == FSF_TABS
         aScr[ FSS_TAB ] := iif( aScr[ FSS_TAB ] == 1, 2, 1 )
         aScr[ FSS_FOC ] := iif( aScr[ FSS_TAB ] == 1, FSF_MASK, FSF_DATES )
         lFull := .T.

      CASE nKey == K_SPACE .AND. ! aScr[ FSS_LIST ] .AND. ;
           ( aScr[ FSS_FOC ] == FSF_TEXT .OR. aScr[ FSS_FOC ] == FSF_REPL )
         /* S2 gives the `Search text:` and `Replace with:` ROWS one stop each:
          * Space turns the box on and off (Enter, above, edits the text of that
          * row) */
         HcSearchToggle( aSt, aScr[ FSS_FOC ] )
         HcSearchFixFocus( aSt, aScr )
         lFull := .T.

      CASE nKey == K_SPACE .AND. ! aScr[ FSS_LIST ] .AND. ;
           HcSearchEnter( aSt, aScr[ FSS_FOC ], aScr[ FSS_TAB ] ) == "toggle"
         HcSearchToggle( aSt, aScr[ FSS_FOC ] )
         HcSearchFixFocus( aSt, aScr )
         lFull := .T.

      CASE nKey == K_TAB .AND. hb_BitAnd( nShift, HB_GTI_KBD_CTRL ) != 0
         /* S14: Ctrl-Tab switches tab from anywhere */
         aScr[ FSS_TAB ] := iif( aScr[ FSS_TAB ] == 1, 2, 1 )
         aScr[ FSS_FOC ] := iif( aScr[ FSS_TAB ] == 1, FSF_MASK, FSF_DATES )
         aScr[ FSS_LIST ] := .F.
         lFull := .T.

      CASE nKey == K_TAB .OR. nKey == K_DOWN
         aScr[ FSS_LIST ] := .F.
         aScr[ FSS_FOC ] := HcSearchFocusStep( aScr[ FSS_FOC ], .F., aSt, aScr[ FSS_TAB ] )
         lFull := .T.

      CASE nKey == K_SH_TAB .OR. nKey == K_UP
         aScr[ FSS_LIST ] := .F.
         aScr[ FSS_FOC ] := HcSearchFocusStep( aScr[ FSS_FOC ], .T., aSt, aScr[ FSS_TAB ] )
         lFull := .T.

      CASE ( nKey == K_LEFT .OR. nKey == K_RIGHT ) .AND. ! aScr[ FSS_LIST ]
         IF aScr[ FSS_FOC ] == FSF_TABS
            aScr[ FSS_TAB ] := iif( aScr[ FSS_TAB ] == 1, 2, 1 )
            aScr[ FSS_FOC ] := iif( aScr[ FSS_TAB ] == 1, FSF_MASK, FSF_DATES )
         ELSEIF HcSearchIsPick( aScr[ FSS_FOC ] )
            HcSearchStep( aSt, aScr, iif( nKey == K_RIGHT, 1, -1 ) )
         ELSE
            aScr[ FSS_FOC ] := HcSearchFocusStep( aScr[ FSS_FOC ], nKey == K_LEFT, ;
                                                 aSt, aScr[ FSS_TAB ] )
         ENDIF
         lFull := .T.

      CASE ! aScr[ FSS_LIST ] .AND. HcSearchIsText( aScr[ FSS_FOC ] ) .AND. ;
           nKey >= 32 .AND. nKey <= 255
         /* S13.3: a typed character opens the field and enters it, so `Enter`
          * stays free for "do" */
         cChord := HcSearchEditField( aSt, aScr, nKey )
         lFull := .T.
      ENDCASE
      /* S13.7: a chord the field editor left pending runs the SAME action its
       * key runs -`S` moves the focus to Search and presses it, `R` and `L`
       * call the replacement-, so a chord typed inside a field can never be
       * lost nor typed into the value it was editing. */
      IF Len( cChord ) > 0
         nChk := HcSearchChkHot( cChord, aSt, aScr[ FSS_TAB ] )
         nTabHot := HcSearchTabHot( cChord )
         DO CASE
         CASE cChord == "S"
            aScr[ FSS_FOC ] := FSF_BTSEARCH
            aScr[ FSS_LIST ] := .F.
            HcSearchRun( aSt, aScr )
            cResDir := aSt[ FSX_DIR ]
         CASE cChord == "R" .OR. cChord == "L"
            aRep := HcFsReplaceAct( iif( cChord == "R", "replace", "all" ), aSt, ;
                                    aScr[ FSS_RES ], aScr[ FSS_SEL ] )
            aScr[ FSS_MSG ] := aRep[ 1 ]
            aScr[ FSS_ERR ] := aRep[ 3 ]
            HcSearchSet( aScr, aRep[ 2 ] )
            /* S3: same as the Alt-R / Alt-L keys - the memory follows the rows */
            HcSearchRemember( aScr[ FSS_RES ], aScr[ FSS_SEL ], aScr[ FSS_TOP ], cResDir )
         CASE nChk != 0
            /* S18/T7: the chord a field editor of this pass left pending can
             * also be the quick letter of a checkbox, so it runs the SAME
             * toggle the Alt key runs above instead of being lost */
            aScr[ FSS_FOC ] := nChk
            aScr[ FSS_LIST ] := .F.
            HcSearchToggle( aSt, aScr[ FSS_FOC ] )
            HcSearchFixFocus( aSt, aScr )
         CASE nTabHot != 0
            /* S20/T10: the chord a field editor of this pass left pending can
             * also be the quick letter of a tab label, so it switches the tab
             * the same way the Alt key does instead of being lost */
            aScr[ FSS_TAB ] := nTabHot
            aScr[ FSS_FOC ] := iif( nTabHot == 1, FSF_MASK, FSF_DATES )
            aScr[ FSS_LIST ] := .F.
         CASE cChord == "I" .AND. aScr[ FSS_MARK ]
            /* S5/S13.8 of hc-fsearch-marks.md: `Alt-I` typed INSIDE a field
             * editor comes back here as a pending chord, so it inverts the marks
             * exactly like the key does (the whole screen is repainted right
             * below, in ONE block) */
            HcFsMarkAll( aScr[ FSS_RES ], HcFsMarkState( aScr[ FSS_RES ] ) != 2 )
         ENDCASE
         lFull := .T.
      ENDIF
   ENDDO
   /* S3: the list leaves with the row and the scroll top the user left it on -
    * every way of walking it (keys, wheel, click, F3/F4) ends here -, so the
    * next visit puts the cursor back where it was instead of on the first row.
    * An empty list clears the memory: the last search is the truth. */
   HcSearchRemember( aScr[ FSS_RES ], aScr[ FSS_SEL ], aScr[ FSS_TOP ], cResDir )
   SetCursor( cOldCur )
   SetColor( UI_C_DESKTOP )
RETURN

/* S14: one step of a chip without opening its list (the arrows of the chips) */
STATIC PROCEDURE HcSearchStep( aSt, aScr, nDir )
   DO CASE
   CASE aScr[ FSS_FOC ] == FSF_DEPTH
      aSt[ FSX_DEPTH ] := HcFsDepthStep( aSt[ FSX_DEPTH ], nDir )
   CASE aScr[ FSS_FOC ] == FSF_SOP
      aSt[ FSX_SOP ] := HcFsSizeOpStep( aSt[ FSX_SOP ], nDir )
   CASE aScr[ FSS_FOC ] == FSF_SUNIT
      aSt[ FSX_SUNIT ] := HcFsSizeUnitStep( aSt[ FSX_SUNIT ], nDir )
   ENDCASE
RETURN

/* S1/S3: the entry point of `Files > Search and Replace` and of `Ctrl-F`. The
 * form state is the session memory (S3) merged over the defaults and, EVERY time
 * the screen opens, `Search in:` is the folder of the ACTIVE panel (L8: a linked
 * panel falls back to the other one, and with both of them linked or no path
 * at all the field keeps what it had). The folder is the one slot the session
 * memory does not carry, so a remembered path can never win over the panel;
 * what the user typed into the field is used for that session only. Nothing
 * goes to disk. */
STATIC PROCEDURE HcSearch()
   LOCAL aSt := HcFsRestore( HcFsState() ), cDir
   cDir := HcSearchDir( HcPanelActive(), HcPanel( HcOtherPanel() ) )
   IF Len( AllTrim( cDir ) ) > 0
      aSt[ FSX_DIR ] := cDir
   ENDIF
   HcSearchScreen( aSt )
   HcFsSaveState( aSt )
RETURN

