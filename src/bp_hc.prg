/* =====================================================================
 *  Entry point
 * ===================================================================== */

FUNCTION BpHcScreen()
   LOCAL cChosen := ""
   LOCAL lExit := .F., lFull := .T., lRows := .F., lCmd := .F., lStatus := .F.
   LOCAL lShKey := .F., lShRun := .F., lCtrl := .F., nClip := 0
   /* S2 of recycle-bin-delete.md: lHard is the Shift+Del step of THIS pass (the
    * window hook records it) and lDelLine says a previous pass sent its Del to
    * the command line, so a late copy of that same stroke can never delete */
   LOCAL lHard := .F., lDelLine := .F.
   LOCAL nKey, nOldActive, nOldSel, nOldTop, aP, aOld, aNew, nShift
   LOCAL nTreeAct := 0
   LOCAL lFind, cFind, nAnchor, cAlt, cHook, cHookGot
   LOCAL cLetter, cAct, cFlash
   LOCAL lPending := .F., nPendKey := 0
   LOCAL cOldCur

   /* FIX 3: the panels are created once; coming back from another screen (Esc
    * in the browser, the viewer/editor, the synchronizer) keeps the directory,
    * the active panel, the zoom and the cursor instead of resetting everything
    * to hb_cwd() */
   HcReuse()
   /* S49: changes made while the screen was away (a database opened FROM the
    * working tree of an archive changes that file) are written back before the
    * panels are used again */
   HcZipSync()
   /* the quit request of the menu bar never survives a re-entry */
   s_lHcQuit := .F.
   /* neither does a database handed over by F4 */
   s_cHcOpen := ""
   /* an unfinished right-button gesture never survives a re-entry either */
   s_lHcDrag     := .F.
   s_nHcDragPan  := 0
   s_nHcDragIdx  := 0
   s_nHcDragLast := 0
   s_nHcDragRow  := 0
   s_nHcDragCol  := 0
   s_nHcDragTick := 0
   s_lHcDragMv   := .F.
   s_lHcDragMenu := .F.
   s_lHcDragBody := .F.
   s_aHcDragDone := {}
   /* the incremental search never survives a re-entry of the screen */
   s_lHcFindOn := .F.
   s_cHcFindPat := ""
   /* neither does the temporary notice of the status row (L6): a copy made
    * before another screen was opened must not show up here */
   s_cHcFlash := ""
   s_nHcFlashUntil := 0
   s_cHcFlashShown := ""
   /* S2 of recycle-bin-delete.md: NEITHER does a Shift+Del the window hook
    * recorded while the user was in another screen (the editor, the dot, a
    * dialog: none of those drains that channel), so a stroke made elsewhere can
    * never delete an entry of the panels when this screen opens. Same recipe as
    * HcWordFlush() for the editor chords. */
   HcHardDelReset()
   lHard := .F.
   lDelLine := .F.
   /* local mirror of the search input (the module statics only feed the
    * painters of the status row) */
   lFind := .F.
   cFind := ""
   nAnchor := 1
   /* the screen draws its own cursor on the entries, but the caret stays
    * visible in the command line (HcCaretOn), like the dot prompt */
   cOldCur := SetCursor( 0 )
   /* wheel and clicks of the driver window (no-op without a GTWVG window).
    * The window may not exist yet when this screen is the first one of the
    * process, so HcMousePoll() retries the hook until it answers .T. */
   s_lHcHook := HcMouseHook( .T. )

   DO WHILE ! lExit
      /* S1/S4 of window-close.md (B3): the X of the window, once per pass and
       * before anything else of the pass -not even the first painting-. The
       * manager cannot finish here: it leaves through the exit shape it already
       * has for Quit / Esc / F10 -lExit, and with the EXIT so the rest of this
       * pass is skipped- and the tail after ENDDO removes the window hook and
       * restores the caret exactly as it always does. `Exit hwBro?` is NOT
       * asked (L7): the X is an explicit gesture, and BpCloseAsk() has already
       * raised the program's exit flag, so Main() ends the program when this
       * screen returns "" (no database opened). The headless bank of T5 links
       * this module WITHOUT hwbro.prg, so the poll is compiled out there. */
#ifndef BP_HC_STANDALONE
      IF BpCloseAsk()
         lExit := .T.
         EXIT
      ENDIF
#endif
      IF lFull
         HcDrawScreen()
         lFull := .F.
         lRows := .F.
         lCmd  := .F.
         lStatus := .F.
      ENDIF

      /* Short wait: while there is no key the mouse is polled (GTWVG of this
       * Harbour delivers neither the wheel nor the clicks through Inkey(), so
       * bp_win32.c records them and HcMousePoll collects them). A click on the
       * hotkey bar returns the key of that slot, so it goes through exactly the
       * same code as a real key press. Without a GTWVG window (headless bank)
       * the polling returns 0 and the loop keeps working. */
      nKey := Inkey( 0.05 )
      IF nKey != 0
         /* The ALT state of the key just read, BEFORE anything else touches
          * the driver: this GTWVG delivers Alt+<letter> as the PLAIN letter in
          * Inkey() and reports the ALT flag here (measured: Alt+C -> 99 with
          * 4148, plain c -> 99 with 48), so both channels are needed. */
         nShift := HcShiftState()
         /* S33: the SHIFT state of the key that just arrived (Shift+arrows
          * extend the selection); it travels in the same word as ALT */
         lShKey := HcKeyShift( nShift )
         /* S7 of hc-clipboard-files.md: the CTRL bit separates Ctrl+C/V from
          * PgDn/Ins, whose key codes are the same ones */
         lCtrl := HcKeyCtrl( nShift )
#ifndef BP_HC_STANDALONE
         BpLog( "HC key=" + LTrim( Str( nKey ) ) + " kbdshifts=" + LTrim( Str( nShift ) ) + ;
                 " asyncshift=" + iif( W32ShiftDown(), "1", "0" ) + ;
                 " sh=" + iif( lShKey, "1", "0" ) )
#endif
      ELSE
         nShift := 0
         lCtrl := .F.
      ENDIF

      /* S7 of hc-clipboard-files.md, SECOND channel: the combos the driver does
       * not report with their modifier (Ctrl+C, Shift+Ins) are recorded by the
       * window hook. When one is there, it acts and the Inkey() copy of the SAME
       * stroke is dropped (nKey := 0), so one keystroke is one action: without
       * that, Shift+Ins would also toggle a mark and Ctrl+C would type a 'c'. */
      /* The panel of THIS pass, before the hook channels below: they act on it
       * (the command line state, the marked entries) and the first hooked chord
       * can arrive in the FIRST pass, when `aP` is still NIL because the
       * assignment of the normal path is further down. Measured: Ctrl+C on a
       * freshly opened manager fed NIL to HcCmdBusy(), which raised inside
       * Len()/Array access and took hwBro down through BpFatal() (the recursive
       * handler ended in `Unrecoverable error 9003`). */
      aP := HcPanelActive()
      nClip := HcClipDrain()
      IF nClip != 0
         IF HcPanelTree( aP )
            /* T5 (S7): Ctrl+C / Ctrl+X / Ctrl+V / Shift+Ins work on FILES and a
             * tree panel has none. The chord does not reach the cascade below
             * (it is drained here as a code), so the guard lives HERE, where it
             * is dispatched. */
            HcTreeNoFiles()
         ELSEIF ! HcCmdBusy( aP )
            /* 1 = copy, 2 = paste, 3 = CUT. The panels have no "cut": a cut
             * copies the entries and leaves them where they are (a real cut
             * would have to delete them, and F6 is the move). Before, anything
             * that was not a copy PASTED, so Ctrl+X dropped the clipboard into
             * the current directory. */
            IF nClip == 2
               HcClipPaste()
               lFull := .T.
            ELSE
               HcClipCopy()
            ENDIF
         ENDIF
         nKey := 0
      ENDIF

      /* S1/S2 of recycle-bin-delete.md, THIRD channel: Shift+Del. MEASURED
       * (traps 37/58/61): this driver delivers the combo with no modifier of
       * its own - it used to arrive as the clipboard code 4 and the panels
       * RESOLVED IT AS PASTE - so the window hook of bp_win32.c records it and
       * is the FIRST source. When the hook answered, the Inkey() copy of the
       * SAME stroke must not reach HcPanelKey() (which would delete a second
       * time): that is why nKey is zeroed.
       *
       * The step is DRAINED ON EVERY PASS, here, and NOT inside the branch that
       * acts on it. MEASURED DEFECT (L6): the drain used to sit behind
       * "IF ! HcCmdBusy(...)", so a Shift+Del typed while the COMMAND LINE was
       * in use left the flag pending in the hook; a pass later, with the line
       * already consumed, the flag fired BY ITSELF and deleted the entry of the
       * cursor for ever, with no keystroke from the user. A stale flag must
       * never fire later, so: (a) it is taken out of the hook every pass, (b)
       * with a command line in use it is thrown away, and (c) if the PREVIOUS
       * pass sent its Del to the command line, the copy the hook recorded late
       * for that same stroke is thrown away too (lDelLine).
       * The "!= 0" is NOT cosmetic: this Harbour raises "Argument error:
       * conditional" on IF <number> and HcHardDelDrain() answers a number
       * (trap 59). Without it the panel loop died on its FIRST pass. */
      lHard := ( HcHardDelDrain() != 0 )
      IF lHard .AND. lDelLine
         /* the Del of the previous pass edited the command line: this is the
          * late copy of that stroke, never a delete */
         HcHardDelReset()
         lHard := .F.
      ENDIF
      lDelLine := .F.

      IF ! HcCmdBusy( HcPanelActive() )
         IF HcPanelTree( HcPanelActive() ) .AND. ( lHard .OR. ;
            ( nKey == K_DEL .AND. ( lShKey .OR. HcShiftLive() ) ) )
            /* T5 (S7): Shift+Del is a file operation and the hook delivers it
             * BEFORE the key cascade, so it is guarded here; the message is
             * shown once and the stroke is spent. */
            HcHardDelReset()
            HcTreeNoFiles()
            nKey  := 0
         ELSEIF lHard
            HcDelete( .T. )
            lFull := .T.
            nKey  := 0
         ELSEIF nKey == K_DEL .AND. ( lShKey .OR. HcShiftLive() )
            /* fallback for a stroke the hook did not record: a plain Del code
             * with SHIFT held. lShKey is the state of the key that just
             * arrived and HcShiftLive() the live one (HcKeyShift() already
             * ORs W32ShiftDown(), trap 40: this driver does not report SHIFT
             * for the arrow keys). HcHardDelReset() drops the hook copy of
             * THIS stroke so one keystroke can never delete twice. */
            HcDelete( .T. )
            lFull := .T.
            nKey  := 0
            HcHardDelReset()
         ENDIF
      ELSE
         /* a command line is in use: Shift+Del is just a forward delete in the
          * line. The flag belongs to that stroke, so it is DISCARDED here (and
          * a copy the hook records late is dropped by lDelLine above) instead
          * of waiting for the line to become idle. */
         IF lHard
            HcHardDelReset()
         ENDIF
         IF nKey == K_DEL
            lDelLine := .T.
         ENDIF
      ENDIF

      /* SECOND channel: the characters the window hook of bp_win32.c recorded
       * while ALT was held. They are drained on EVERY pass, also when Inkey()
       * delivered nothing - which is exactly the case this exists for, because
       * on the user's machine holding Alt and typing swallows the letters.
       * Once the hook has recorded anything it is the ONLY source of the
       * Alt-held letters (s_lHcHookSource): that is what makes one keystroke
       * add exactly one character, whatever the timing of the two channels. */
      cHook := HcHookDrain()
      IF ! Empty( s_cHcHookDrop ) .AND. ! Empty( cHook )
         IF Upper( Left( cHook, 1 ) ) == s_cHcHookDrop
            /* the hook copy of the stroke Inkey() already consumed */
            cHook := SubStr( cHook, 2 )
            s_cHcHookDrop := ""
         ENDIF
      ENDIF
      cHookGot := cHook

      IF nKey == 0
         nKey := HcMousePoll()
      ENDIF

      /* S9 of commander-link.md: while the Slave mode is on, the listener and
       * the UDP discovery are served BETWEEN two keys with a 0 ms budget (a
       * plain "look once"), exactly like the mouse is polled, so the screen
       * never blocks waiting for a peer. Nothing is painted here: the chip of
       * the bar appears on the next full repaint. */
      HcLinkServe()

      IF lPending
         /* the key was carried over from the previous pass: there is nothing
          * to read, it is the same keystroke going through the normal cases */
         nKey := nPendKey
         lPending := .F.
         nPendKey := 0
         nShift := 0
      ENDIF

      /* L6 of hc-clipboard-files.md: the TEMPORARY notice of the status row.
       * HcDrawStatus() records what it painted (s_cHcFlashShown), so this check
       * repaints the row ONCE when the notice appears and ONCE when it expires
       * - never on every 50 ms pass. It has to live HERE, before the pass gives
       * up: the hook chords (Ctrl+C, Ctrl+X) zero the key, so the normal
       * repaint of a pass never runs, and the notice has to appear anyway.
       * The incremental search OWNS the row while it is open, so the notice is
       * skipped then (and its deadline is left to pass on its own). */
      IF ! s_lHcFindOn
         cFlash := HcFlashText( s_cHcFlash, s_nHcFlashUntil, hb_MilliSeconds() )
         IF ! ( cFlash == s_cHcFlashShown )
            IF Empty( cFlash )
               /* the deadline has passed: forget it, so a later copy arms a
                * fresh one and nothing is left half-armed */
               s_cHcFlash := ""
               s_nHcFlashUntil := 0
            ENDIF
            HcFlashRow()
         ENDIF
      ENDIF

      /* nothing from Inkey(), nothing from the mouse and nothing from the
       * hook: there is nothing to do in this pass */
      IF nKey == 0 .AND. Empty( cHook )
         LOOP
      ENDIF

      nOldActive := HcActive()
      aP := HcPanelActive()
      /* T2 of hc-tree-panel.md: a tree panel keeps its cursor and its scroll
       * window in HC_P_TSEL/HC_P_TTOP, so the "old" pair of HcRepaint() is
       * taken from whichever view the panel is showing. The pair has to be of
       * ONE view: mixing them would repaint the wrong rows. */
      nOldSel := iif( HcPanelTree( aP ), aP[ HC_P_TSEL ], aP[ HC_P_SEL ] )
      nOldTop := iif( HcPanelTree( aP ), aP[ HC_P_TTOP ], aP[ HC_P_TOP ] )

      /* S43: Del is the panel's delete key (F8) while the command line is idle;
       * with a line in use Del keeps editing it. The mapping is applied to the
       * KEY, before the trace and the search classification, so log and action
       * always name the key that actually runs. It is NOT applied while the
       * search input is open: there Del closes the input and does nothing. */
      IF ! lFind
         nKey := HcPanelKey( nKey, HcCmdBusy( aP ) )
      ENDIF

      /* the Alt+<letter> of this pass. With the hook working it is the ONLY
       * source; Inkey()+shift state is the fallback when the hook is not there
       * (headless bank, other driver). The branch is chosen by capability, not
       * per keystroke. */
      cAlt := ""
      IF ! lFind
         IF ! s_lHcHookSource
            cAlt := HcAltLetter( nKey, nShift )
            IF ! Empty( cAlt )
               /* the hook copy of THIS stroke, if it lands in a later pass,
                * must not be appended: it is dropped once */
               s_cHcHookDrop := Upper( Left( cAlt, 1 ) )
            ENDIF
         ENDIF
         IF Empty( cAlt ) .AND. ! Empty( cHook )
            /* the hook delivered the letter: it is the source, whatever Inkey()
             * did with the same stroke (it is not used while the hook works) */
            cAlt := Upper( Left( cHook, 1 ) )
            cHook := SubStr( cHook, 2 )
         ENDIF
      ENDIF

      /* while the search input is open every hooked character extends the
       * word, whatever Inkey() did or did not deliver */
      IF lFind .AND. ! Empty( cHook )
         cFind += cHook
         cHook := ""
         s_cHcFindPat := cFind
         HcFindApply( aP, nAnchor, cFind )
         lStatus := .T.
      ENDIF

#ifndef BP_HC_STANDALONE
      /* Diagnostic of the key loop (only with BP_DEBUG=1, hwbro.err): the key
       * and the shift state the driver reported, the Alt letter recognised,
       * what the WINDOW HOOK recorded (hc = total, x = characters taken from it
       * in this pass), which channel is the source (src) and what the input does
       * with the key (act: ENTER/ESC/BS/APPEND/LETTER/CLOSE). Both channels and
       * the decision in one line, so a report from a user machine shows exactly
       * where a key went. */
      cLetter := HcLetterOf( nKey )
      cAct := iif( lFind, HcFindKeyAction( nKey, cLetter, s_lHcHookSource, ;
                                          HcShiftAlt( nShift ) ), "" )
      BpLog( "Hc key=" + LTrim( Str( nKey ) ) + " shift=" + LTrim( Str( nShift ) ) + ;
             " alt=" + cAlt + " find=" + iif( lFind, "1", "0" ) + ;
             " hc=" + LTrim( Str( HcAltHookTotal() ) ) + " x=[" + cHookGot + "]" + ;
             " src=" + iif( s_lHcHookSource, "hook", "inkey" ) + ;
             " act=" + cAct + " pat=" + cFind )
#else
      /* the same classification without the trace (headless build) */
      cLetter := HcLetterOf( nKey )
      cAct := iif( lFind, HcFindKeyAction( nKey, cLetter, s_lHcHookSource, ;
                                          HcShiftAlt( nShift ) ), "" )
#endif

      /* S46: the SHIFT selection of the panels is a RUN. The first step of the
       * run also toggles the row the cursor is standing on ("comenzar por el que
       * estoy parado"), the following ones only the rows they enter. Any input
       * ends the run: the flag is read and cleared here, and only a SHIFT cursor
       * move (HcCursorMove) arms it again for the next pass. */
      lShRun := s_lHcShiftRun
      s_lHcShiftRun := .F.

      DO CASE

      /* ---------------- tree panel keys (T3, S6) ----------------
       * ONE case, first, and only for the twelve keys of a TREE panel: it
       * answers 0 for everything else (Tab, Ctrl-O, F1..F10, Alt-F1/F2, Ins,
       * Del, +, -, *, Shift-F2, printable keys, the clipboard chords) and also 0
       * when the command line is in use, so those branches below keep running
       * exactly as they do in a listing. It is skipped while the incremental
       * search input is open, because that input owns every key (Esc closes the
       * search first, and the key that closes it is replayed by the pending-key
       * path, so the tree still gets it in the next pass). */
      CASE ! lFind .AND. ;
           ( nTreeAct := HcTreeKeyAct( nKey, aP[ HC_P_TREE ], HcCmdBusy( aP ), nShift ) ) != 0
         /* .T. = the model or the other panel changed: a full repaint; .F. =
          * only the tree rows moved, and the block after ENDCASE repaints just
          * the two rows the cursor left and reached */
         IF HcTreeAct( aP, nTreeAct )
            lFull := .T.
         ENDIF

      /* ---------------- a tree panel has no FILES (T5, S7) ----------------
       * F3..F8, Ins, Del, + - *, Shift-F2, Shift-F4 and the clipboard chords
       * need files, and a tree panel lists folders only: each of them answers
       * with ONE message and the normal branch below never runs, so nothing is
       * half-done. It sits AFTER the tree keys (Up/Down/Home/End/Right/Left/
       * Enter/Esc/Tab/Ctrl-O...) and BEFORE every file branch. F1, F2, F9, F10,
       * Tab, Ctrl-O and the arrows are NOT in HcTreeFileKey() and keep working.
       * Measured: K_CTRL_F, K_CTRL_V and K_CTRL_X share their codes with K_END,
       * K_INS and K_DOWN, and this is exactly why the tree CASE runs first. */
      CASE aP[ HC_P_TREE ] .AND. HcTreeFileKey( nKey )
         HcTreeNoFiles()

      /* ---------------- incremental search input (S13) ---------------- */
      CASE lFind .AND. cAct == "ESC"
         /* Esc abandons the SEARCH, not the position it already found: the
          * cursor STAYS on the entry the search landed on (the anchor is only
          * the starting point of the forward scan, not where Esc returns to). */
         HcFindClose()
         lFind := .F.
         lStatus := .T.

      CASE lFind .AND. cAct == "BS"
         IF ! Empty( cFind )
            cFind := Left( cFind, Len( cFind ) - 1 )
         ENDIF
         s_cHcFindPat := cFind
         HcFindApply( aP, nAnchor, cFind )
         lStatus := .T.

      CASE lFind .AND. cAct == "APPEND"
         /* a letter without ALT (or with ALT when Inkey() is the source): it is
          * appended and the search runs again */
         cFind += cLetter
         s_cHcFindPat := cFind
         HcFindApply( aP, nAnchor, cFind )
         lStatus := .T.

      CASE lFind .AND. cAct == "LETTER"
         /* a letter WITH ALT while the hook is the source: its hook copy is the
          * one that appends it, so here it is deliberately IGNORED and the
          * input STAYS OPEN. A letter must never close the input. */

      CASE lFind
         /* NOT a letter (arrows, Home/End, PgUp/PgDn, Tab, Ctrl-O, F1..F10,
          * Alt-F1/F2, Ins, Del, +/-, digits and anything else): the input
          * CLOSES (status row restored) and the key is handled by the normal
          * key handling of the screen, carried over as a pending key so this
          * very key goes through the normal CASEs ONCE, with no duplicated
          * handlers. That way F10 asks Exit hwBro?, the arrows/Home/End/PgUp/
          * PgDn/Tab move the cursor, Ctrl-O zooms and Alt-F1/Alt-F2 pick the
          * drives.
          * ENTER comes here on purpose: the search only MOVED the cursor onto
          * the matching entry, and Enter then acts on it exactly as if it had
          * been typed on the panel with no search open (enter the directory,
          * run the file, open the *.DBF, run a non-empty command line). The
          * input closes first, so nothing of the search survives the action.
          * HcFindPendKey() also gives the Alt+<function key> of the same
          * stroke back its plain meaning, so F4 edits, F3 views, F10 asks and
          * so on even when ALT is still held down. */
         HcFindClose()
         lFind := .F.
         lStatus := .T.
         nPendKey := HcFindPendKey( nKey )
         lPending := .T.

      CASE ! Empty( cAlt )
         /* Alt+<letter>: open the search seeded with that letter plus any other
          * letter the window hook had already queued */
         nAnchor := aP[ HC_P_SEL ]
         cFind := cAlt + cHook
         cHook := ""
         HcFindOpen( cFind )
         HcFindApply( aP, nAnchor, cFind )
         lFind := .T.

      CASE nKey == K_ESC
         IF ! Empty( aP[ HC_P_CMD ] ) .OR. s_nHcHist > 0
            /* a non-empty command line is cleared first: Esc only quits from
             * an empty one, as in upstream */
            HcCmdClear( aP )
            lCmd := .T.
         ELSE
            HcQuit()
         ENDIF

      CASE nKey == K_F10
         HcQuit()

      CASE nKey == K_UP
         IF HcCmdBusy( aP )
            /* with something typed, Up/Down recall the history */
            HcHistGet( aP, -1 )
            lCmd := .T.
         ELSEIF HcCursorMove( aP, aP[ HC_P_SEL ] - 1, lShKey, lShRun )
            /* S33: SHIFT+Up extended the selection: every traversed row
             * changed its mark, so the whole panel is repainted */
            lFull := .T.
         ENDIF

      CASE nKey == K_DOWN
         IF HcCmdBusy( aP )
            HcHistGet( aP, 1 )
            lCmd := .T.
         ELSEIF HcCursorMove( aP, aP[ HC_P_SEL ] + 1, lShKey, lShRun )
            lFull := .T.
         ENDIF

      CASE nKey == K_CTRL_UP .OR. nKey == K_CTRL_P
         /* the history is always reachable from an empty line with Ctrl-Up:
          * Up/Down belong to the panel (see the F1 help) */
         HcHistGet( aP, -1 )
         lCmd := .T.

      CASE nKey == K_CTRL_DOWN .OR. nKey == K_CTRL_N
         HcHistGet( aP, 1 )
         lCmd := .T.

      /* S1/S3/S7 of hc-clipboard-files.md: the Windows file clipboard. These
       * cases go BEFORE K_PGUP/K_PGDN/K_INS because the codes collide: in
       * inkey.ch K_CTRL_C IS K_PGDN (3), K_CTRL_V IS K_INS (22) and K_CTRL_X IS
       * K_DOWN (24), so only the CTRL bit of HB_GTI_KBDSHIFTS tells them apart
       * (the same trick Ctrl-F/End uses, trap 37). K_CTRL_INS (402) is unique
       * and Shift+Ins arrives as a plain Ins with the SHIFT bit. */
      CASE ( nKey == K_CTRL_C .AND. lCtrl ) .OR. nKey == K_CTRL_INS
         /* the marked entries, or the entry under the cursor. MEASURED: with
          * this driver Ctrl+Ins arrives as 402 with the CTRL bit, but Ctrl+C
          * arrives as the plain letter 'c' and without the bit, so that one
          * comes from the window hook (HcClipDrain, below) */
         IF ! HcCmdBusy( aP )
            HcClipCopy()
         ENDIF

      CASE nKey == K_CTRL_V .AND. lCtrl
         /* Ctrl+V arrives as 22 (the Ins code) WITH the CTRL bit: that is the
          * only thing that separates it from a mark. Shift+Ins is NOT reported
          * with SHIFT here, so it comes from the hook instead (HcClipDrain) */
         IF ! HcCmdBusy( aP )
            HcClipPaste()
            lFull := .T.
         ENDIF

      CASE nKey == K_PGUP
         IF HcCursorMove( aP, aP[ HC_P_SEL ] - HC_VIS, lShKey, lShRun )
            lFull := .T.
         ENDIF

      CASE nKey == K_PGDN
         IF HcCursorMove( aP, aP[ HC_P_SEL ] + HC_VIS, lShKey, lShRun )
            lFull := .T.
         ENDIF

      /* S1 of odd/tasks/hc-file-search.md: `Ctrl-F` opens the File search. In
       * this driver Ctrl-F arrives as the CODE 6, which inkey.ch calls K_END AND
       * K_CTRL_F at the same time (measured, AGENTS trap 37), so the CTRL bit is
       * the only thing that tells it from a plain End and this CASE has to run
       * BEFORE the K_HOME/K_END walks of the panel. HcSearchKey() is the pure
       * rule (it also refuses ALT, so AltGr - Ctrl+Alt on a Spanish keyboard -
       * can never open it, trap 38). */
      CASE HcSearchKey( nKey, nShift )
         HcSearch()
         lFull := .T.

      CASE nKey == K_HOME
         IF HcCmdCaret( aP, 0 )
            lCmd := .T.
         ELSEIF HcCursorMove( aP, 1, lShKey, lShRun )
            lFull := .T.
         ENDIF

      CASE nKey == K_END
         IF HcCmdCaret( aP, Len( aP[ HC_P_CMD ] ) )
            lCmd := .T.
         ELSEIF HcCursorMove( aP, Len( aP[ HC_P_LIST ] ), lShKey, lShRun )
            lFull := .T.
         ENDIF

      CASE nKey == K_CTRL_LEFT
         /* one word or one symbol back inside the command line (the same rule
          * the dialog fields use, UiWordLeft) */
         IF HcCmdCaret( aP, UiWordLeft( aP[ HC_P_CMD ], aP[ HC_P_CMDCOL ] ) )
            lCmd := .T.
         ENDIF

      CASE nKey == K_CTRL_RIGHT
         IF HcCmdCaret( aP, UiWordRight( aP[ HC_P_CMD ], aP[ HC_P_CMDCOL ] ) )
            lCmd := .T.
         ENDIF

      CASE nKey == K_TAB
         /* Tab switches the active panel; while zoomed there is only one
          * panel on screen, so it does nothing (same as `upstream`) */
         IF ! s_lZoom
            aOld := HcPanelActive()
            HcSetActive( iif( HcActive() == HC_PANEL_L, HC_PANEL_R, HC_PANEL_L ) )
            /* the command line travels with the user (same as upstream) */
            aNew := HcPanelActive()
            aNew[ HC_P_CMD ]    := aOld[ HC_P_CMD ]
            aNew[ HC_P_CMDCOL ] := aOld[ HC_P_CMDCOL ]
            HcCmdClear( aOld )
            lFull := .T.
         ENDIF

      CASE nKey == K_CTRL_O
         HcToggleZoom()
         lFull := .T.

      CASE nKey == K_ALT_F1
         IF HcPickDrive( HC_PANEL_L )
            lFull := .T.
         ENDIF

      CASE nKey == K_ALT_F2
         IF HcPickDrive( HC_PANEL_R )
            lFull := .T.
         ENDIF

      CASE nKey == K_INS
         HcToggleMark()

      CASE nKey == K_LEFT
         IF HcCmdMove( aP, -1 )
            lCmd := .T.
         ENDIF

      CASE nKey == K_RIGHT
         IF HcCmdMove( aP, 1 )
            lCmd := .T.
         ENDIF

      CASE nKey == K_BS
         IF HcCmdBack( aP )
            lCmd := .T.
         ENDIF

      CASE nKey == K_DEL
         IF HcCmdDel( aP )
            lCmd := .T.
         ENDIF

      CASE ( nKey == 43 .OR. nKey == 45 ) .AND. HcCmdBusy( aP )
         /* with a command line in use the character belongs to it */
         HcCmdInsert( aP, Chr( nKey ) )
         lCmd := .T.

      CASE nKey == 43 .OR. nKey == 45          /* + / - */
         IF HcMarkByMask( nKey == 43 )
            lRows := .T.
         ENDIF

      CASE nKey == K_ENTER
         IF ! Empty( aP[ HC_P_CMD ] )
            /* the command line runs with Enter (upstream starts it in a shell) */
            HcRunCmd( aP )
            lFull := .T.
         ELSE
            cChosen := HcEnterEntry()
            IF ! Empty( cChosen )
               lExit := .T.
            ELSE
               lFull := .T.
            ENDIF
         ENDIF

      CASE nKey == K_F1 .OR. nKey == K_F2 .OR. nKey == K_F3 .OR. ;
           nKey == K_F4 .OR. nKey == K_F5 .OR. nKey == K_F6 .OR. ;
           nKey == K_F7 .OR. nKey == K_F8 .OR. nKey == K_F9
         /* help, zoom, view, edit, copy, renmov, mkdir, delete and the
          * menu bar of F9: all of them go through the same dispatcher as the
          * hotkey bar clicks */
         HcRunKey( nKey )
         lFull := .T.

      CASE nKey == K_SH_F2
         /* S1 of odd/tasks/hc-compare.md: the same routine the `Files` menu
          * entry runs, so the key and the menu can never diverge. The screen
          * is read only, so there is nothing to reload afterwards. */
         HcCompare()
         lFull := .T.

      CASE nKey == K_SH_F4
         /* S4 of odd/tasks/hc-ctx-menu-clipboard.md: a NEW file in the
          * directory of the active panel, opened in the editor. It is reached
          * from here and from the `New file` entry of the right button panel,
          * which calls the same routine. */
         HcNewFile()
         lFull := .T.

      CASE nKey >= 32 .AND. nKey <= 126
         /* any printable key starts/extends the command line (like upstream) */
         HcCmdInsert( aP, Chr( nKey ) )
         lCmd := .T.

      CASE nKey >= 160 .AND. nKey <= 255
         HcCmdInsert( aP, Chr( nKey ) )
         lCmd := .T.

      ENDCASE

      /* F4 on a *.DBF hands the path back to the caller (S66): the flag is set
       * by HcEdit(), so the key, the `Files > Edit` entry and the `F4` chip all
       * leave the screen exactly like Enter on that same file. */
      IF ! Empty( s_cHcOpen )
         cChosen := s_cHcOpen
         s_cHcOpen := ""
         lExit := .T.
      ENDIF

      /* F2 on something that is not a database: the DB manager without a base.
       * The screen leaves with NO path and without asking `Exit hwBro?`, and
       * Main() shows that manager instead of entering this one again. */
      IF s_lHcWantData
         s_lHcWantData := .F.
         lExit := .T.
      ENDIF

      /* the menu bar answered `Yes` to Exit hwBro? (S28: Quit) */
      IF s_lHcQuit
         s_lHcQuit := .F.
         lExit := .T.
      ENDIF

      IF ! lExit
         /* S12: the tree of the other panel followed this directory change, so
          * the whole screen has to be drawn again (the tree is not the active
          * panel and HcRepaint() would never paint it). Before the flags below,
          * so they can still take over when they need to. */
         IF s_lHcTreeFollowed
            s_lHcTreeFollowed := .F.
            lFull := .T.
         ENDIF
         /* S4 of theme-dark-mode.md: a theme row of the `Commands` dropdown
          * switched the colour layer while the menu had the screen saved, so the
          * menu, the panels and the chrome rows are all still painted with the
          * PREVIOUS theme. The row raised the flag instead of painting; the whole
          * screen is drawn once here, after the menu is gone, and every other
          * screen paints on entry with the theme now in force. lFull is the
          * full-paint path, so a second paint cannot follow. */
         IF s_lHcThemePicked
            s_lHcThemePicked := .F.
            lFull := .T.
         ENDIF
         IF HcActive() != nOldActive
            lFull := .T.
         ENDIF
         IF ! lFull
            IF lCmd
               /* only the command line changed */
               HcPaintCmd()
               lCmd := .F.
            ELSEIF s_lHcFindOn .OR. lStatus
               /* the search input: rows the cursor left/reached + status row */
               HcPaintFind( nOldSel, nOldTop )
               lStatus := .F.
            ELSEIF lRows
               HcPaintRows( HcActive() )
               lRows := .F.
            ELSE
               /* navigation repaints only the rows that changed */
               HcRepaint( nOldSel, nOldTop )
            ENDIF
         ENDIF
      ENDIF

   ENDDO

   HcMouseHook( .F. )
   s_lHcHook := .F.
   SetCursor( cOldCur )
   SetColor( UI_C_DESKTOP )
RETURN cChosen

/* The quit path of S3/S9: the same `Exit hwBro?` confirmation the rest of
 * the program uses. Only the real program has BpSetExit(); the headless bank
 * of T5 links this module without hwbro.prg (-DBP_HC_STANDALONE). */
STATIC FUNCTION HcAskQuit()
   IF ! UiConfirm( "Exit hwBro?", "Exit" )
      RETURN .F.
   ENDIF
   /* S9: leaving the program closes the link of the panels and the Slave of
    * this screen (its listener, its sessions and its UDP socket) */
   HcLinkShutdown()
#ifndef BP_HC_STANDALONE
   BpSetExit( .T. )
#endif
RETURN .T.

/* the `Exit hwBro?` of the whole screen: F10, Esc on an empty command line and
 * the Quit entry of the menu bar all ask HERE, and the key loop leaves when the
 * flag is raised (so there is a single quit path) */
STATIC PROCEDURE HcQuit()
   IF HcAskQuit()
      s_lHcQuit := .T.
   ENDIF
RETURN

/* Ctrl-O: the active panel takes the whole width. The key and the `Zoom panel`
 * entry of the Left/Right menus reach this one routine. */
STATIC PROCEDURE HcToggleZoom()
   s_lZoom := ! s_lZoom
RETURN

/* =====================================================================
 *  Pure / disk helpers (the only non-STATIC symbols besides BpHcScreen)
 * ===================================================================== */

/* .T. when the entry is a directory (same test as `upstream`: "D" in the
 * attributes the OS returned) */
FUNCTION HcIsDir( aEntry )
   IF ! HB_ISARRAY( aEntry ) .OR. Len( aEntry ) < HC_E_ATTR
      RETURN .F.
   ENDIF
   IF ValType( aEntry[ HC_E_ATTR ] ) != "C"
      RETURN .F.
   ENDIF
RETURN "D" $ Upper( aEntry[ HC_E_ATTR ] )

/* Comparison of a listing: .T. when aX goes before aY. It is the code block
 * handed to ASort().
 *
 * S2/S3 (L25): the DIRECTORIES always come first and always in ascending name
 * order, with the `..` parent entry above everything, whatever the key and the
 * direction; only the FILES follow the key of the panel (cSort = "NAME" |
 * "SIZE" | "DATE") and its direction (lDesc). Ties are broken by name and then
 * by size, so the same listing always comes out in the same order. The default
 * arguments (name, ascending) are the order the screen had before the headers
 * became sortable, so S12.10..S12.13 still describe it. */
FUNCTION HcSortCmp( aX, aY, cSort, lDesc )
   LOCAL lDX, lDY, n
   DEFAULT cSort TO "NAME"
   DEFAULT lDesc TO .F.
   IF ! HB_ISARRAY( aX ) .OR. ! HB_ISARRAY( aY )
      /* a malformed record is never reordered */
      RETURN HcEntryKey( aX ) < HcEntryKey( aY )
   ENDIF
   lDX := HcIsDir( aX )
   lDY := HcIsDir( aY )
   IF lDX .OR. lDY
      IF lDX .AND. ! lDY
         RETURN .T.
      ENDIF
      IF lDY .AND. ! lDX
         RETURN .F.
      ENDIF
      /* two directories: `..` first, then by name, case-insensitive */
      IF HcIsParent( aX ) .AND. ! HcIsParent( aY )
         RETURN .T.
      ENDIF
      IF HcIsParent( aY ) .AND. ! HcIsParent( aX )
         RETURN .F.
      ENDIF
      RETURN HcEntryKey( aX ) < HcEntryKey( aY )
   ENDIF
   n := HcSortCmpFiles( aX, aY, cSort )
   IF lDesc
      RETURN n > 0
   ENDIF
RETURN n < 0

/* S34: sorts a listing IN PLACE with the key and the direction of a panel. The
 * entries keep their identity (marks, and the row the cursor names), so a
 * re-sort from a header click never loses anything. Returns the same array. */
FUNCTION HcSortList( aList, cSort, lDesc )
   DEFAULT cSort TO "NAME"
   DEFAULT lDesc TO .F.
   IF ! HB_ISARRAY( aList ) .OR. Len( aList ) < 2
      RETURN aList
   ENDIF
   ASort( aList, 1, Len( aList ), {| x, y | HcSortCmp( x, y, cSort, lDesc ) } )
RETURN aList

/* S4/S6: the sort state a panel goes to when the user asks for cWanted: the
 * same key INVERTS the direction, another key starts ASCENDING. Returns
 * { cSort, lDesc }. cWanted = "" keeps the key and only reverses it, which is
 * the `Reverse order` entry of the Left/Right menus. PURE. */
FUNCTION HcSortNext( cCur, lDesc, cWanted )
   DEFAULT cWanted TO cCur
   IF ValType( cCur ) != "C" .OR. Empty( cCur )
      cCur := "NAME"
   ENDIF
   IF ValType( cWanted ) != "C" .OR. Empty( cWanted )
      cWanted := cCur
   ENDIF
   IF Upper( cWanted ) == Upper( cCur )
      RETURN { cCur, iif( ValType( lDesc ) == "L", ! lDesc, .T. ) }
   ENDIF
RETURN { Upper( cWanted ), .F. }

/* S4: the sortable column of the header under a click, out of the 0 based
 * offset inside the panel (the first inner column is 0) and the REAL width of
 * the name field of that panel. The one cell separators belong to the column on
 * their left, like the separators of a table, and `Time` is NOT sortable
 * because it is the very same timestamp as `Date` (S4): it answers "". PURE. */
FUNCTION HcHeaderSortAt( nRel, nNameW )
   DEFAULT nNameW TO 1
   IF ValType( nRel ) != "N" .OR. ValType( nNameW ) != "N" .OR. nNameW < 1 .OR. nRel < 0
      RETURN ""
   ENDIF
   IF nRel < nNameW
      RETURN "NAME"
   ENDIF
   IF nRel <= nNameW + HC_SIZE_W
      RETURN "SIZE"
   ENDIF
   IF nRel <= nNameW + HC_SIZE_W + 1 + HC_DATE_W
      RETURN "DATE"
   ENDIF
RETURN ""

/* .T. when the entry is the `..` parent row (S3: it always goes on top) */
STATIC FUNCTION HcIsParent( aEntry )
   IF ! HB_ISARRAY( aEntry ) .OR. Len( aEntry ) < HC_E_NAME
      RETURN .F.
   ENDIF
   IF ValType( aEntry[ HC_E_NAME ] ) != "C"
      RETURN .F.
   ENDIF
RETURN aEntry[ HC_E_NAME ] == ".."

/* -1 / 0 / 1 comparison of two FILES of a panel with its sort key (S3) */
STATIC FUNCTION HcSortCmpFiles( aX, aY, cSort )
   LOCAL n := 0
   DO CASE
   CASE cSort == "SIZE"
      n := HcCmpNum( HcEntrySize( aX ), HcEntrySize( aY ) )
   CASE cSort == "DATE"
      n := HcCmpStr( HcEntryStamp( aX ), HcEntryStamp( aY ) )
   ENDCASE
   /* S3: the ties are broken by name and then by size, so two listings of the
    * same directory always come out in the same order */
   IF n == 0
      n := HcCmpStr( HcEntryKey( aX ), HcEntryKey( aY ) )
   ENDIF
   IF n == 0
      n := HcCmpNum( HcEntrySize( aX ), HcEntrySize( aY ) )
   ENDIF
RETURN n

STATIC FUNCTION HcCmpStr( cA, cB )
   IF cA < cB
      RETURN -1
   ENDIF
RETURN iif( cA > cB, 1, 0 )

STATIC FUNCTION HcCmpNum( nA, nB )
   IF nA < nB
      RETURN -1
   ENDIF
RETURN iif( nA > nB, 1, 0 )

/* size of one entry, 0 when it does not carry one (a directory, a test record) */
STATIC FUNCTION HcEntrySize( aEntry )
   IF ! HB_ISARRAY( aEntry ) .OR. Len( aEntry ) < HC_E_SIZE
      RETURN 0
   ENDIF
   IF ValType( aEntry[ HC_E_SIZE ] ) != "N"
      RETURN 0
   ENDIF
RETURN aEntry[ HC_E_SIZE ]

/* S3: the COMPLETE timestamp of an entry as 14 characters "YYYYMMDDHHMMSS", the
 * key of the `DATE` order. The date column only SHOWS DD/MM/YY, so this cannot
 * be built out of HcDateStr(): two files of the same day must still compare by
 * their hour. When the entry carries no date/time the answer is "". */
STATIC FUNCTION HcEntryStamp( aEntry )
   LOCAL d, aT
   IF ! HB_ISARRAY( aEntry ) .OR. Len( aEntry ) < HC_E_DATE
      RETURN ""
   ENDIF
   d := aEntry[ HC_E_DATE ]
   IF ValType( d ) == "T"
      /* a timestamp is reduced to its date: this Harbour has no Hour()/Minute()/
       * Sec(), and the entry carries its clock in HC_E_TIME anyway */
      d := hb_TToD( d )
   ENDIF
   IF ValType( d ) != "D" .OR. Empty( d )
      RETURN ""
   ENDIF
   aT := HcOwClock( iif( Len( aEntry ) >= HC_E_TIME, aEntry[ HC_E_TIME ], NIL ) )
RETURN StrZero( Year( d ), 4 ) + StrZero( Month( d ), 2 ) + StrZero( Day( d ), 2 ) + ;
       StrZero( aT[ 1 ], 2 ) + StrZero( aT[ 2 ], 2 ) + StrZero( aT[ 3 ], 2 )

/* one entry line, ready to be written with a SAY: name padded to nNameW,
 * size right-aligned in HC_SIZE_W cells, one separator column, the date in
 * HC_DATE_W cells, one separator column and the time (HH:MM, 24 hours) in the
 * last HC_TIME_W cells (S15). The `..` entry is shown as [..] with UP--DIR in
 * the size field and NOTHING in the date and time fields, like `upstream`. */
FUNCTION HcFormatEntry( aEntry, nNameW )
   LOCAL cName, cSize, cDate, cTime, cDateStr
   DEFAULT nNameW TO HC_SIZE_W + HC_DATE_W + HC_TIME_W + 2
   IF ! HB_ISARRAY( aEntry )
      RETURN Space( nNameW + HC_SIZE_W + HC_DATE_W + HC_TIME_W + 2 )
   ENDIF
   cName := aEntry[ HC_E_NAME ]
   IF ValType( cName ) != "C"
      cName := ""
   ENDIF
   IF HcIsDir( aEntry )
      cSize := PadL( iif( cName == "..", "UP--DIR", "DIR" ), HC_SIZE_W )
   ELSEIF ValType( aEntry[ HC_E_SIZE ] ) == "N"
      cSize := PadL( LTrim( Str( aEntry[ HC_E_SIZE ] ) ), HC_SIZE_W )
   ELSE
      cSize := PadL( "0", HC_SIZE_W )
   ENDIF
   cDateStr := HcDateStr( aEntry[ HC_E_DATE ] )
   cDate := PadR( Left( cDateStr, HC_DATE_W ), HC_DATE_W )
   cTime := PadR( Left( HcEntryTime( aEntry ), HC_TIME_W ), HC_TIME_W )
   IF cName == ".."
      cName := "[..]"
      cDate := Space( HC_DATE_W )
      cTime := Space( HC_TIME_W )
   ENDIF
RETURN PadR( Left( cName, nNameW ), nNameW ) + cSize + " " + cDate + " " + cTime

/* time field of one entry (HC_E_TIME) or blanks when the entry does not carry
 * one (the tests and the `..` entry build 5 element records) */
STATIC FUNCTION HcEntryTime( aEntry )
   IF ! HB_ISARRAY( aEntry ) .OR. Len( aEntry ) < HC_E_TIME
      RETURN Space( HC_TIME_W )
   ENDIF
RETURN HcTimeStr( aEntry[ HC_E_TIME ] )

/* cDir + cName with exactly one separator between them */
FUNCTION HcJoinPath( cDir, cName )
   LOCAL c := cDir
   IF ! Empty( c ) .AND. ! ( Right( c, 1 ) == "\" ) .AND. ! ( Right( c, 1 ) == "/" )
      c += "\"
   ENDIF
RETURN c + cName

/* Parent directory of cDir, ending with the separator. A drive root is its
 * own parent ("C:\" -> "C:\"), so walking up can never leave the drive. */
FUNCTION HcParentDir( cDir )
   LOCAL c := AllTrim( cDir ), n
   /* the trailing separator is dropped, but not the one of "C:\" */
   IF Len( c ) > 3 .AND. ( Right( c, 1 ) == "\" .OR. Right( c, 1 ) == "/" )
      c := Left( c, Len( c ) - 1 )
   ENDIF
   n := Max( Rat( "\", c ), Rat( "/", c ) )
   IF n > 0
      RETURN Left( c, n )
   ENDIF
   IF Len( c ) == 2 .AND. Right( c, 1 ) == ":"
      RETURN c + "\"
   ENDIF
RETURN c

/* DOS style mask match, case-insensitive: `?` is one character, `*` is any
 * run of them, and several masks may be given separated by `;` or `,`.
 * "*" and "*.*" match everything, including names without an extension. */
FUNCTION HcMaskMatch( cMask, cName )
   LOCAL aM, i, c
   IF Empty( cMask ) .OR. ValType( cName ) != "C"
      RETURN .F.
   ENDIF
   aM := hb_ATokens( StrTran( cMask, ",", ";" ), ";" )
   FOR i := 1 TO Len( aM )
      c := AllTrim( aM[ i ] )
      IF c == "*" .OR. c == "*.*"
         RETURN .T.
      ENDIF
      IF ! Empty( c ) .AND. HcWildMatch( Upper( c ), Upper( cName ) )
         RETURN .T.
      ENDIF
   NEXT
RETURN .F.

/* =====================================================================
 *  Panels
 * ===================================================================== */

STATIC PROCEDURE HcInit()
   LOCAL cDir := hb_cwd()
   /* S11: both panels start in the process working directory and the
    * session state lives in memory (no configuration file is ever read) */
   s_aPanels := { HcNewPanel( cDir, HC_PANEL_L ), HcNewPanel( cDir, HC_PANEL_R ), HC_PANEL_L }
   s_lZoom := .F.
   s_lHcInited := .T.
RETURN

/* Re-entry of the screen (Esc in the browser, F2, ...): the panels KEEP their
 * directory, the active panel, the Ctrl-O zoom and the cursor index, both
 * listings are reloaded from disk (the cursor is clamped to the new listing)
 * and the marks survive only for the entries that still exist. */
STATIC PROCEDURE HcReuse()
   LOCAL nId, aP, aMarked, i, j
   IF ! s_lHcInited .OR. ! HB_ISARRAY( s_aPanels ) .OR. Len( s_aPanels ) < HC_PANEL_ACTIVE
      HcInit()
      RETURN
   ENDIF
   FOR nId := HC_PANEL_L TO HC_PANEL_R
      aP := HcPanel( nId )
      aMarked := {}
      FOR i := 1 TO Len( aP[ HC_P_LIST ] )
         IF aP[ HC_P_LIST ][ i ][ HC_E_MARK ]
            AAdd( aMarked, aP[ HC_P_LIST ][ i ][ HC_E_NAME ] )
         ENDIF
      NEXT
      /* the command line is not kept across screens */
      HcCmdClear( aP )
      HcLoad( aP )
      FOR i := 1 TO Len( aP[ HC_P_LIST ] )
         FOR j := 1 TO Len( aMarked )
            IF aMarked[ j ] == aP[ HC_P_LIST ][ i ][ HC_E_NAME ]
               aP[ HC_P_LIST ][ i ][ HC_E_MARK ] := .T.
               EXIT
            ENDIF
         NEXT
      NEXT
   NEXT
RETURN

STATIC FUNCTION HcNewPanel( cDir, nId )
   /* S34: every panel carries ITS OWN sort key and direction, so each panel
    * keeps its order across reloads, a directory change and a return from
    * another screen (never a module static: Left sorts the left panel and
    * Right the right one). T1 of hc-tree-panel.md appends the three tree slots
    * (.F., {}, 1) and T2 the scroll top (1): the panel starts in the normal
    * listing, with no nodes, the tree cursor on the first row and the window
    * at the top. */
   LOCAL aP := { cDir, {}, 1, 1, "", 0, "NAME", .F., nId, .F., .F., {}, 1, 1 }
   HcLoad( aP )
RETURN aP

STATIC FUNCTION HcPanel( nId )
   IF ! HB_ISARRAY( s_aPanels ) .OR. Len( s_aPanels ) < HC_PANEL_ACTIVE
      HcInit()
   ENDIF
RETURN s_aPanels[ nId ]

STATIC FUNCTION HcActive()
   IF ! HB_ISARRAY( s_aPanels ) .OR. Len( s_aPanels ) < HC_PANEL_ACTIVE
      HcInit()
   ENDIF
RETURN s_aPanels[ HC_PANEL_ACTIVE ]

STATIC FUNCTION HcPanelActive()
RETURN HcPanel( HcActive() )

STATIC PROCEDURE HcSetActive( nId )
   s_aPanels[ HC_PANEL_ACTIVE ] := nId
RETURN

/* (re)reads the directory of a panel and keeps the cursor inside it. EVERY
 * path that reloads a listing ends up here (a directory change, a drive
 * change, the reload after a copy/move/delete/mkdir, coming back from the
 * browser and the `Reload panel` entry), so the sort key of the panel is
 * applied to all of them (S34/S7). */
STATIC PROCEDURE HcLoad( aPanel )
   LOCAL aList, aChain, cKeep, nIdx, nOther
   /* S39: a reload makes any pending click pair stale: the rows are about to
    * show other entries, so the next click can never be the second one of a
    * double click (see HcClickPair()). */
   s_nHcListGen++
   /* CORRECTION (independent verifier, defect 1 of hc-tree-panel.md): a panel
    * that has JUST become a Commander Link panel (or that is inside an archive)
    * can still carry the tree from the panel it was a moment ago - HcLinkAttach()
    * sets HC_P_LINK and then calls HcLoad(). The tree branch below comes FIRST,
    * so without this wall the panel would rebuild a LOCAL tree out of the peer's
    * ABSOLUTE path (HcTreeDirs() -> HcReadDir() touch THIS disk) and, worse, it
    * would keep HC_P_TREE = .T. with an empty model. So the tree is switched off
    * here and the branches below decide what the panel really is. */
   IF HcPanelTree( aPanel ) .AND. HcLoadNotLocal( aPanel )
      aPanel[ HC_P_NODES ] := {}
      aPanel[ HC_P_TSEL ]  := 1
      aPanel[ HC_P_TTOP ]  := 1
      aPanel[ HC_P_TREE ]  := .F.
      aPanel[ HC_P_LIST ]  := {}
      s_nHcListGen++
   ENDIF
   /* T2 of hc-tree-panel.md (S5): A TREE PANEL IS NOT A LISTING. It is rebuilt
    * from its HC_P_DIR -the cache of folders is dropped here, which is what
    * `Reload panel` and the reload after every file operation need- and the node
    * under the cursor survives when that path is still in the new chain. It
    * NEVER reaches the local hb_vfDirectory() listing below. */
   IF HcPanelTree( aPanel )
      cKeep := HcTreeCurPath( aPanel )
      aPanel[ HC_P_NODES ] := HcTreeNew( aPanel[ HC_P_DIR ] )
      aPanel[ HC_P_LIST ]  := {}          /* a tree panel has no listing */
      aPanel[ HC_P_TSEL ]  := 1
      aPanel[ HC_P_TTOP ]  := 1
      HcTreeOpenChain( aPanel )
      IF ! Empty( cKeep )
         nIdx := AScan( aPanel[ HC_P_NODES ], {| aN | HcTreeIsPath( aN, cKeep ) } )
         IF nIdx > 0
            aPanel[ HC_P_TSEL ] := HcTreeSel( aPanel[ HC_P_NODES ], nIdx )
         ENDIF
      ENDIF
      HcTreeScroll( aPanel )
      RETURN
   ENDIF
   /* S2 of odd/tasks/commander-link.md: A LINKED PANEL IS NOT A LOCAL ONE. Its
    * HC_P_DIR is an ABSOLUTE path of the peer, so it is NEVER given to
    * HcCheckDir()/HcReadDir() (both touch the local disk): the listing comes
    * from the Slave and the branch leaves BEFORE any local call. A Slave that
    * cannot be asked keeps the listing the panel already had instead of
    * emptying it. */
   IF HcLinkPanel( aPanel )
      aList := HcLinkReadDir( aPanel[ HC_P_DIR ], HcPanelSort( aPanel ), ;
                             HcPanelDesc( aPanel ) )
      IF HB_ISARRAY( aList )
         aPanel[ HC_P_LIST ] := aList
      ENDIF
      HcCursorTo( aPanel, aPanel[ HC_P_SEL ] )
      RETURN
   ENDIF
   aPanel[ HC_P_DIR ]  := HcCheckDir( aPanel[ HC_P_DIR ] )
   aPanel[ HC_P_LIST ] := HcReadDir( aPanel[ HC_P_DIR ], HcPanelSort( aPanel ), ;
                                     HcPanelDesc( aPanel ) )
   HcCursorTo( aPanel, aPanel[ HC_P_SEL ] )
   /* S12 of hc-tree-panel.md (reverse sync): THE one place every directory change
    * of a local panel goes through, so it is also the one place where the tree of
    * the OTHER panel has to follow: enter a folder, `..` up, a drive pick, a
    * reload after an operation. The LINK branch above never gets here and must
    * not: its HC_P_DIR is the peer's and HcLoadNotLocal() refuses it (a zip panel
    * too), so a peer path can never enter the model. The panel that changed is
    * taken from its OWN id (HcLoad() can be called for a panel that is not the
    * active one), and the function never paints: it raises a flag that makes the
    * key loop draw the whole screen, because the tree is not the active panel and
    * HcRepaint() only paints that one. */
   IF Len( aPanel ) >= HC_P_ID .AND. ValType( aPanel[ HC_P_ID ] ) == "N" .AND. ;
      aPanel[ HC_P_ID ] >= HC_PANEL_L .AND. aPanel[ HC_P_ID ] <= HC_PANEL_R
      nOther := iif( aPanel[ HC_P_ID ] == HC_PANEL_L, HC_PANEL_R, HC_PANEL_L )
   ELSE
      nOther := 0
   ENDIF
   /* The other panel is read STRAIGHT from s_aPanels and only when the panel
    * set is fully built: HcNewPanel() ends in HcLoad(), and s_aPanels does not
    * exist yet while the two panels are being created, so HcPanel() there would
    * call HcInit() again, which builds the panels again... an endless recursion
    * that closed hwBro at startup (measured). Nothing to follow at that point
    * anyway: both panels start in the plain listing. */
   IF nOther > 0 .AND. HB_ISARRAY( s_aPanels ) .AND. ;
      Len( s_aPanels ) >= HC_PANEL_R .AND. HB_ISARRAY( s_aPanels[ nOther ] ) .AND. ;
      HcTreeFollow( s_aPanels[ nOther ], aPanel )
      s_lHcTreeFollowed := .T.
   ENDIF
RETURN

/* S34: sort key of a panel, "NAME" by default, and its direction. They live in
 * the panel record, so an old/short record still answers something sane. */
STATIC FUNCTION HcPanelSort( aPanel )
   IF ! HB_ISARRAY( aPanel ) .OR. Len( aPanel ) < HC_P_SORT .OR. ;
      ValType( aPanel[ HC_P_SORT ] ) != "C" .OR. Empty( aPanel[ HC_P_SORT ] )
      RETURN "NAME"
   ENDIF
RETURN aPanel[ HC_P_SORT ]

STATIC FUNCTION HcPanelDesc( aPanel )
   IF ! HB_ISARRAY( aPanel ) .OR. Len( aPanel ) < HC_P_DESC .OR. ;
      ValType( aPanel[ HC_P_DESC ] ) != "L"
      RETURN .F.
   ENDIF
RETURN aPanel[ HC_P_DESC ]

/* S4/S6: changes the order of ONE panel. The click on a column header and the
 * four entries of the Left/Right menus all come through here, so the two paths
 * cannot diverge: the same key inverts the direction and another key starts
 * ascending (HcSortNext); cSort = "" only reverses the current direction (the
 * `Reverse order` entry). The listing is re-sorted IN PLACE - every mark and
 * the identity of the entries travel with the rows - and the cursor goes back
 * to the SAME entry by name, or to the first row when it is gone (S4). */
STATIC PROCEDURE HcSortPanel( nId, cSort )
   LOCAL aP := HcPanel( nId ), aNext, cName := "", n := 0
   IF HB_ISARRAY( aP[ HC_P_LIST ] ) .AND. aP[ HC_P_SEL ] >= 1 .AND. ;
      aP[ HC_P_SEL ] <= Len( aP[ HC_P_LIST ] )
      cName := aP[ HC_P_LIST ][ aP[ HC_P_SEL ] ][ HC_E_NAME ]
   ENDIF
   aNext := HcSortNext( HcPanelSort( aP ), HcPanelDesc( aP ), ;
                        iif( Empty( cSort ), HcPanelSort( aP ), cSort ) )
   aP[ HC_P_SORT ] := aNext[ 1 ]
   aP[ HC_P_DESC ] := aNext[ 2 ]
   HcSortList( aP[ HC_P_LIST ], aNext[ 1 ], aNext[ 2 ] )
   IF ! Empty( cName )
      n := AScan( aP[ HC_P_LIST ], {| aE | HB_ISARRAY( aE ) .AND. ;
                                          aE[ HC_E_NAME ] == cName } )
   ENDIF
   HcCursorTo( aP, iif( n > 0, n, 1 ) )
   /* the header mark, the order of the rows and the status row all changed */
   HcDrawScreen()
RETURN

/* the directory of the panel exists; if it does not, walk up until one does
 * (the working directory is the last resort) */
STATIC FUNCTION HcCheckDir( cDir )
   LOCAL c := cDir, cOld
   DO WHILE ! Empty( c ) .AND. ! hb_DirExists( c )
      cOld := c
      c := HcParentDir( c )
      IF c == cOld
         c := ""
      ENDIF
   ENDDO
   IF Empty( c )
      c := hb_cwd()
   ENDIF
RETURN c

/* listing of one directory in the order of the panel: `..` above everything,
 * then the directories by name and then the files in the order of cSort (S2/S3,
 * "NAME" ascending by default). The OS does not report `..` at a drive root, so
 * there is none there. */
STATIC FUNCTION HcReadDir( cDir, cSort, lDesc )
   LOCAL aOut := {}, aRaw, i, aE
   DEFAULT cSort TO "NAME"
   DEFAULT lDesc TO .F.
   IF ! hb_DirExists( cDir )
      RETURN aOut
   ENDIF
   aRaw := hb_vfDirectory( cDir, "HSD" )
   IF ! HB_ISARRAY( aRaw )
      aRaw := {}
   ENDIF
   FOR i := 1 TO Len( aRaw )
      aE := aRaw[ i ]
      IF ValType( aE[ 1 ] ) == "C" .AND. aE[ 1 ] == "."
         /* "." is the directory itself: never listed */
      ELSE
         /* `..` is listed like any other directory: HcSortList() puts it on
          * top, so no in-place insert (AIns() loses the last element here) */
         AAdd( aOut, HcEntryNew( aE ) )
      ENDIF
   NEXT
RETURN HcSortList( aOut, cSort, lDesc )

/* one entry of the panel record out of one element of hb_vfDirectory():
 * { name, size, date, attr, .F., time }. `hb_DirScan`/`hb_vfDirectory` return
 * { name, size, date, time, attr }, so the time (element 4) is kept too: the
 * panel shows it in its own column (S15). */
STATIC FUNCTION HcEntryNew( aRaw )
   LOCAL cAttr := iif( Len( aRaw ) >= 5, aRaw[ 5 ], "A" )
   LOCAL xTime := iif( Len( aRaw ) >= 4, aRaw[ 4 ], NIL )
RETURN { aRaw[ 1 ], aRaw[ 2 ], aRaw[ 3 ], cAttr, .F., xTime }

/* sort key: "A" + name for directories, "B" + name for files, so the
 * directories always come first and the comparison is case-insensitive */
STATIC FUNCTION HcEntryKey( aEntry )
   LOCAL cAttr, cName
   IF ! HB_ISARRAY( aEntry )
      RETURN "B"
   ENDIF
   cAttr := iif( Len( aEntry ) >= HC_E_ATTR, aEntry[ HC_E_ATTR ], "A" )
   IF ValType( cAttr ) != "C"
      cAttr := "A"
   ENDIF
   cName := aEntry[ HC_E_NAME ]
   IF ValType( cName ) != "C"
      cName := ""
   ENDIF
RETURN iif( "D" $ Upper( cAttr ), "A", "B" ) + Upper( cName )

/* cursor + scroll window of a panel: the cursor always stays visible */
STATIC PROCEDURE HcCursorTo( aPanel, nSel )
   LOCAL n := Len( aPanel[ HC_P_LIST ] ), nTop := aPanel[ HC_P_TOP ]
   IF n < 1
      aPanel[ HC_P_SEL ] := 1
      aPanel[ HC_P_TOP ] := 1
      RETURN
   ENDIF
   nSel := Min( Max( 1, nSel ), n )
   IF nSel < nTop
      nTop := nSel
   ENDIF
   IF nSel > nTop + HC_VIS - 1
      nTop := nSel - HC_VIS + 1
   ENDIF
   nTop := Max( 1, Min( nTop, Max( 1, n - HC_VIS + 1 ) ) )
   aPanel[ HC_P_SEL ] := nSel
   aPanel[ HC_P_TOP ] := nTop
RETURN

/* puts the cursor on the entry called cName (if it is still there) */
STATIC PROCEDURE HcGotoName( aPanel, cName )
   LOCAL n := AScan( aPanel[ HC_P_LIST ], {| x | Upper( x[ HC_E_NAME ] ) == Upper( cName ) } )
   IF n > 0
      HcCursorTo( aPanel, n )
   ENDIF
RETURN

/* ---- Tree panel model (odd/tasks/hc-tree-panel.md, T1) ----
 *
 * The folder tree of ONE panel is a PURE model: an array of node records in
 * FLAT PRE-ORDER (the children of a folder sit immediately after it and
 * HC_TN_DEPTH says how deep a node is), so nothing here is recursive and the
 * whole model can be pinned by the headless bank without a screen, a window or
 * a key. Every function below is pure EXCEPT HcTreeDirs() and HcTreeLoad(),
 * which read a folder once (S5: a folder already read never touches the disk
 * again). The model knows nothing about painting, keys or the mouse: that is
 * T2..T5 of the same task.
 */

/* root of the unit that holds cDir, ALWAYS with its trailing separator:
 * "C:\xampp\htdocs\" -> "C:\" and "\\SRV\SHARE\a\b" -> "\\SRV\SHARE\". A
 * path with no drive and no UNC prefix has no unit root and answers "" (the
 * caller decides what to do with it). */
FUNCTION HcTreeRootOf( cDir )
   LOCAL c, aPart
   IF ValType( cDir ) != "C"
      RETURN ""
   ENDIF
   c := StrTran( AllTrim( cDir ), "/", "\" )
   IF Empty( c )
      RETURN ""
   ENDIF
   IF Left( c, 2 ) == "\\"
      /* a UNC path: the root is the SERVER and the SHARE, not the server
       * alone ("\\\\SRV\SHARE\a" never climbs to "\\\\SRV") */
      aPart := hb_ATokens( SubStr( c, 3 ), "\" )
      DO CASE
      CASE Len( aPart ) >= 2
         RETURN "\\" + aPart[ 1 ] + "\" + aPart[ 2 ] + "\"
      CASE Len( aPart ) == 1
         RETURN "\\" + aPart[ 1 ] + "\"
      ENDCASE
      RETURN ""
   ENDIF
   IF Len( c ) >= 2 .AND. SubStr( c, 2, 1 ) == ":"
      RETURN Upper( Left( c, 2 ) ) + "\"
   ENDIF
RETURN ""

/* the folder chain from the root of the unit down to cDir INCLUSIVE, every
 * element with its trailing separator: "C:\a\b" -> {"C:\", "C:\a\",
 * "C:\a\b\"}. A path that IS the root answers ONE element. A missing or
 * doubled separator, "." and ".." are resolved by HcNormPath(), which never
 * climbs over the drive root or the UNC prefix, so the chain can never leave
 * the unit (it also upper-cases, the canonical form used by the port). */
FUNCTION HcTreeChain( cDir )
   LOCAL c, cRoot, cRest, cAcc, aPart, aOut := {}, i
   IF ValType( cDir ) != "C"
      RETURN aOut
   ENDIF
   c := HcNormPath( cDir )
   cRoot := HcTreeRootOf( c )
   IF Empty( c ) .OR. Empty( cRoot )
      RETURN aOut
   ENDIF
   AAdd( aOut, cRoot )
   cRest := SubStr( c, Len( cRoot ) + 1 )
   IF Empty( cRest )
      RETURN aOut                 /* the path IS the root: one element */
   ENDIF
   aPart := hb_ATokens( cRest, "\" )
   cAcc := cRoot
   FOR i := 1 TO Len( aPart )
      IF ! Empty( aPart[ i ] )
         cAcc += aPart[ i ] + "\"
         AAdd( aOut, cAcc )
      ENDIF
   NEXT
RETURN aOut

/* the model of a folder tree with ONE node: the root of the unit that holds
 * cDir, expanded (so T2 can open the chain under it) and NOT read yet. The
 * root of a drive or of a UNC share KEEPS its trailing separator, because
 * "C:" alone means the current directory of the drive. */
FUNCTION HcTreeNew( cDir )
   LOCAL aNodes := {}, cRoot := HcTreeRootOf( cDir ), cName
   IF Empty( cRoot )
      RETURN aNodes
   ENDIF
   cName := HcDirName( cRoot )
   IF Empty( cName )
      /* a drive root has no last segment (HcDirName( "C:\" ) answers ""), so
       * the row would show no name at all */
      cName := cRoot
   ENDIF
   AAdd( aNodes, { cRoot, cName, 0, .T., .F., 0, .T. } )
RETURN aNodes

/* names of the SUBFOLDERS of cPath, sorted case-insensitively (the order the
 * panel listing already gives: directories first and by name). Files never
 * appear - the tree lists folders only (S2) - and so does not `..`, which
 * HcReadDir() does list. A folder that is not there answers {} and NEVER
 * raises: the tree has to survive a folder that disappeared under the cursor.
 * HcDirArg() closes the path with its separator first: hb_vfDirectory() needs it
 * and without it the listing comes back with ONE bogus entry (measured). */
FUNCTION HcTreeDirs( cPath )
   LOCAL aOut := {}, aList, i, aE
   IF ValType( cPath ) != "C" .OR. Empty( cPath )
      RETURN aOut
   ENDIF
   aList := HcReadDir( HcDirArg( cPath ), "NAME", .F. )
   IF ! HB_ISARRAY( aList )
      RETURN aOut
   ENDIF
   FOR i := 1 TO Len( aList )
      aE := aList[ i ]
      IF HB_ISARRAY( aE ) .AND. Len( aE ) >= HC_E_ATTR .AND. HcIsDir( aE ) .AND. ;
         ! ( aE[ HC_E_NAME ] == ".." ) .AND. ! ( aE[ HC_E_NAME ] == "." )
         AAdd( aOut, aE[ HC_E_NAME ] )
      ENDIF
   NEXT
RETURN aOut

/* S5: reads the children of the node nIdx ONCE and inserts them immediately
 * after it (flat pre-order), returns the number of child folders. A folder
 * that was already read answers its HC_TN_KIDS WITHOUT touching the disk and
 * inserts nothing, so a cursor walking up and down costs one listing per
 * folder and no more. AIns() does not grow the array in this Harbour (trap 27)
 * so the room is made with ASize() and the rows are moved from the end back. */
FUNCTION HcTreeLoad( aNodes, nIdx )
   LOCAL aNode, aKids, n, nDepth, i
   IF ! HB_ISARRAY( aNodes ) .OR. ValType( nIdx ) != "N" .OR. ;
      nIdx < 1 .OR. nIdx > Len( aNodes )
      RETURN 0
   ENDIF
   aNode := aNodes[ nIdx ]
   IF ! HB_ISARRAY( aNode ) .OR. Len( aNode ) < HC_TN_LAST
      RETURN 0
   ENDIF
   IF aNode[ HC_TN_LOAD ]
      RETURN aNode[ HC_TN_KIDS ]
   ENDIF
   aKids := HcTreeDirs( aNode[ HC_TN_PATH ] )
   n := Len( aKids )
   nDepth := aNode[ HC_TN_DEPTH ] + 1
   IF n > 0
      ASize( aNodes, Len( aNodes ) + n )
      FOR i := Len( aNodes ) - n TO nIdx + 1 STEP -1
         aNodes[ i + n ] := aNodes[ i ]
      NEXT
      FOR i := 1 TO n
         aNodes[ nIdx + i ] := { HcJoinPath( aNode[ HC_TN_PATH ], aKids[ i ] ), ;
                                 aKids[ i ], nDepth, .F., .F., 0, i == n }
      NEXT
   ENDIF
   /* the node is the SAME array the model holds, so this is what marks it as
    * read (and what HcTreeView/HcTreeMark/HcTreeLoad read afterwards) */
   aNode[ HC_TN_LOAD ] := .T.
   aNode[ HC_TN_KIDS ] := n
RETURN n

/* opens a folder, reading it first if it was never read (S5). It answers the
 * EXPANDED state after the call, which is what HcTreeToggle() hands back. */
FUNCTION HcTreeExpand( aNodes, nIdx )
   IF ! HB_ISARRAY( aNodes ) .OR. ValType( nIdx ) != "N" .OR. ;
      nIdx < 1 .OR. nIdx > Len( aNodes ) .OR. ! HB_ISARRAY( aNodes[ nIdx ] ) .OR. ;
      Len( aNodes[ nIdx ] ) < HC_TN_LAST
      RETURN .F.
   ENDIF
   IF ! aNodes[ nIdx ][ HC_TN_LOAD ]
      HcTreeLoad( aNodes, nIdx )
   ENDIF
   /* CORRECTION (defect 2): a KNOWN LEAF can never be "open": the model does
    * not claim it (EXP stays .F.) and the call answers .F., so HcTreeOpen() and
    * HcTreeAct( HC_TKA_OPEN ) do nothing on it. A folder that turns out to be a
    * leaf only AFTER being read lands here too, which is what the chain of
    * HcTreeOpenChain() needs (it reads the panel's own folder and then leaves it
    * on the cursor, without claiming it is expanded). */
   IF aNodes[ nIdx ][ HC_TN_LOAD ] == .T. .AND. aNodes[ nIdx ][ HC_TN_KIDS ] == 0
      aNodes[ nIdx ][ HC_TN_EXP ] := .F.
      RETURN .F.
   ENDIF
   aNodes[ nIdx ][ HC_TN_EXP ] := .T.
RETURN .T.

/* closes a folder. It never touches the disk and never throws the children
 * away: their rows stay in the model and only the VIEW hides them, so opening
 * it again brings them back in the same order and at the same positions. The
 * root may be collapsed too (the model does not care: T3 decides what a view
 * with nothing visible means). Answers the EXPANDED state after the call. */
FUNCTION HcTreeCollapse( aNodes, nIdx )
   IF ! HB_ISARRAY( aNodes ) .OR. ValType( nIdx ) != "N" .OR. ;
      nIdx < 1 .OR. nIdx > Len( aNodes ) .OR. ! HB_ISARRAY( aNodes[ nIdx ] ) .OR. ;
      Len( aNodes[ nIdx ] ) < HC_TN_EXP
      RETURN .F.
   ENDIF
   aNodes[ nIdx ][ HC_TN_EXP ] := .F.
RETURN .F.

/* flips a folder open/closed and answers the NEW state (the cursor of the tree
 * and the marker of the row read it from here) */
FUNCTION HcTreeToggle( aNodes, nIdx )
   IF ! HB_ISARRAY( aNodes ) .OR. ValType( nIdx ) != "N" .OR. ;
      nIdx < 1 .OR. nIdx > Len( aNodes ) .OR. ! HB_ISARRAY( aNodes[ nIdx ] ) .OR. ;
      Len( aNodes[ nIdx ] ) < HC_TN_EXP
      RETURN .F.
   ENDIF
   IF aNodes[ nIdx ][ HC_TN_EXP ]
      RETURN HcTreeCollapse( aNodes, nIdx )
   ENDIF
RETURN HcTreeExpand( aNodes, nIdx )

/* the rows the user can see, as MODEL indices in model order: a node is
 * visible when EVERY level above it is expanded (the root always is). It is a
 * single pass over the flat array - the expanded state of the last node seen at
 * each depth is kept in aOpen - so there is no recursion and no disk. */
FUNCTION HcTreeView( aNodes )
   LOCAL aOut := {}, aOpen := {}, i, j, nD, lVis
   IF ! HB_ISARRAY( aNodes )
      RETURN aOut
   ENDIF
   FOR i := 1 TO Len( aNodes )
      IF ! HB_ISARRAY( aNodes[ i ] ) .OR. Len( aNodes[ i ] ) < HC_TN_LAST
         LOOP
      ENDIF
      nD := Max( 0, aNodes[ i ][ HC_TN_DEPTH ] )
      /* the state of this node belongs to ITS level and replaces whatever the
       * previous sibling left there */
      ASize( aOpen, nD + 1 )
      aOpen[ nD + 1 ] := aNodes[ i ][ HC_TN_EXP ]
      lVis := .T.
      FOR j := 1 TO nD
         IF aOpen[ j ] != .T.
            lVis := .F.
            EXIT
         ENDIF
      NEXT
      IF lVis
         AAdd( aOut, i )
      ENDIF
   NEXT
RETURN aOut

/* 1-based position of the node nIdx inside HcTreeView(), 0 when it is hidden
 * (inside a collapsed folder). The tree cursor is kept in THESE coordinates. */
FUNCTION HcTreeSel( aNodes, nIdx )
   IF ValType( nIdx ) != "N"
      RETURN 0
   ENDIF
RETURN AScan( HcTreeView( aNodes ), nIdx )

/* the CP437 guide of a row, built from the ancestor chain: two cells per level,
 * the outermost ancestor first (the ROOT column included, always two blanks
 * because the root has no siblings to point at). An ancestor still has siblings
 * below it while it is not the LAST child of its own parent, and that is what a
 * vertical bar says; the node itself closes with a tee (more siblings) or a
 * corner (last). The root has no guide ("") and a depth-d node gets 2*(d+1)
 * cells, which is exactly where its marker starts (HcTreeMarkCol()). */
FUNCTION HcTreeGuide( aNodes, nIdx )
   LOCAL c := "", aChain := {}, nD, nWant, nI, j
   IF ! HB_ISARRAY( aNodes ) .OR. ValType( nIdx ) != "N" .OR. ;
      nIdx < 1 .OR. nIdx > Len( aNodes ) .OR. ! HB_ISARRAY( aNodes[ nIdx ] ) .OR. ;
      Len( aNodes[ nIdx ] ) < HC_TN_LAST
      RETURN ""
   ENDIF
   nD := aNodes[ nIdx ][ HC_TN_DEPTH ]
   IF ValType( nD ) != "N" .OR. nD < 1
      RETURN ""
   ENDIF
   /* in a pre-order array the FIRST node of the wanted depth found while
    * walking BACKWARDS is always the ancestor of that level, so the chain is
    * read without any parent pointer: aChain[ 1 ] is the parent */
   nWant := nD - 1
   nI := nIdx - 1
   DO WHILE nI >= 1 .AND. nWant >= 0
      IF HB_ISARRAY( aNodes[ nI ] ) .AND. Len( aNodes[ nI ] ) >= HC_TN_LAST .AND. ;
         aNodes[ nI ][ HC_TN_DEPTH ] == nWant
         AAdd( aChain, aNodes[ nI ] )
         nWant--
      ENDIF
      nI--
   ENDDO
   FOR j := Len( aChain ) TO 1 STEP -1
      /* INCLUDING the root column: aChain[ Len ] is the root, which has no
       * siblings to point at, so its column is two BLANK cells and the first
       * level lands indented under the root's marker instead of on top of it.
       * HcTreeNew() forces the root's HC_TN_LAST to .T., so that column is
       * always "  " and the guide of a depth-d node (d >= 1) is exactly
       * 2*(d+1) cells: the root column, its ancestors and its own tee/corner. */
      c += iif( aChain[ j ][ HC_TN_LAST ] == .T., "  ", Chr( 179 ) + " " )
   NEXT
RETURN c + iif( aNodes[ nIdx ][ HC_TN_LAST ] == .T., ;
                Chr( 192 ) + Chr( 196 ), Chr( 195 ) + Chr( 196 ) )

/* the marker of 4 cells (HC_TREE_MKW) before the name: "[-] " expanded,
 * "[ ] " collapsed AND already read with no subfolder (a known leaf) and
 * "[+] " for everything else - collapsed with subfolders, or a folder that was
 * never read and could still open (S2). */
FUNCTION HcTreeMark( aNodes, nIdx )
   LOCAL aNode
   IF ! HB_ISARRAY( aNodes ) .OR. ValType( nIdx ) != "N" .OR. ;
      nIdx < 1 .OR. nIdx > Len( aNodes ) .OR. ! HB_ISARRAY( aNodes[ nIdx ] ) .OR. ;
      Len( aNodes[ nIdx ] ) < HC_TN_KIDS
      RETURN "[+] "
   ENDIF
   aNode := aNodes[ nIdx ]
   /* CORRECTION (defect 2): a KNOWN LEAF (read, no subfolders) is ALWAYS "[ ] ",
    * expanded or not: an expanded leaf is not a thing, and before this it painted
    * "[-] " on a folder that has nothing to open. */
   IF aNode[ HC_TN_LOAD ] == .T. .AND. aNode[ HC_TN_KIDS ] == 0
      RETURN "[ ] "
   ENDIF
   IF aNode[ HC_TN_EXP ] == .T.
      RETURN "[-] "
   ENDIF
RETURN "[+] "

/* the body of a row: guide + marker + name, padded with spaces to nW cells and
 * cut to nW, so the painter can SAY it straight into the panel. It is the two
 * parts of HcTreeRowParts() put together, so paint and rule cannot diverge. */
FUNCTION HcTreeRowText( aNodes, nIdx, nW )
   LOCAL aParts := HcTreeRowParts( aNodes, nIdx, nW )
RETURN Left( aParts[ 1 ] + aParts[ 2 ], iif( ValType( nW ) == "N" .AND. nW > 0, nW, 0 ) )

/* S9 (T5): the body of a row in its TWO painted parts: { cGuideMark, cName }.
 * The guide and the marker are the left side (the tree decoration) and the name
 * is the text; the painter gives them their own colour and the bank pins that
 * the two together are HcTreeRowText() of the same width. The name is padded so
 * the sum is EXACTLY nW cells (and cut when nW is smaller than the left side). */
FUNCTION HcTreeRowParts( aNodes, nIdx, nW )
   LOCAL cLeft, cName := "", aNode
   IF ValType( nW ) != "N" .OR. nW < 0
      nW := 0
   ENDIF
   cLeft := HcTreeGuide( aNodes, nIdx ) + HcTreeMark( aNodes, nIdx )
   IF nW < Len( cLeft )
      RETURN { Left( cLeft, nW ), "" }
   ENDIF
   IF HB_ISARRAY( aNodes ) .AND. ValType( nIdx ) == "N" .AND. ;
      nIdx >= 1 .AND. nIdx <= Len( aNodes )
      aNode := aNodes[ nIdx ]
      IF HB_ISARRAY( aNode ) .AND. Len( aNode ) >= HC_TN_NAME .AND. ;
         ValType( aNode[ HC_TN_NAME ] ) == "C"
         cName := aNode[ HC_TN_NAME ]
      ENDIF
   ENDIF
RETURN { cLeft, PadR( cName, nW - Len( cLeft ) ) }

/* S7 (T5): .T. for the keys that need FILES and therefore mean nothing in a tree
 * panel, which lists folders only. Everything else - F1 (help), F2 (the zoom),
 * F9 (the bar), F10 (quit), Tab, Ctrl-O, Esc, the arrows and the
 * printable keys - answers .F. and keeps its normal branch.
 *
 * NOTE (measured, inkey.ch): some of these codes are ALIASES of keys the tree
 * uses - K_CTRL_F is 6, the same as K_END, and K_CTRL_V/K_CTRL_X share their
 * codes with K_INS/K_DOWN - so this predicate must NEVER be consulted before the
 * keyboard of the tree: in BpHcScreen() the tree CASE runs FIRST and the file
 * CASE only sees what the tree did not take. This build has NO K_SH_INS: a
 * Shift+Ins arrives as K_INS (AGENTS trap 58), which is already blocked below. */
FUNCTION HcTreeFileKey( nKey )
   IF ValType( nKey ) != "N"
      RETURN .F.
   ENDIF
   IF nKey == K_F3 .OR. nKey == K_F4 .OR. nKey == K_F5 .OR. ;
      nKey == K_F6 .OR. nKey == K_F7 .OR. nKey == K_F8 .OR. ;
      nKey == K_INS .OR. nKey == K_DEL .OR. ;
      nKey == Asc( "+" ) .OR. nKey == Asc( "-" ) .OR. nKey == Asc( "*" ) .OR. ;
      nKey == K_SH_F2 .OR. nKey == K_SH_F4 .OR. ;
      nKey == K_CTRL_F .OR. nKey == K_CTRL_C .OR. nKey == K_CTRL_X .OR. ;
      nKey == K_CTRL_V .OR. nKey == K_CTRL_INS
      RETURN .T.
   ENDIF
RETURN .F.

/* the marker of a KNOWN LEAF, which is the one painted in the dim colour (S9) */
#define HC_TREE_LEAF_MARK  "[ ] "


/* 0-based column of the marker inside the body of the row: it IS the length of
 * the guide, so the pure rule, the painter (guide then marker) and the click
 * band can never disagree. The root's marker starts at column 0 and every level
 * adds one slot of two cells: 0, 4, 6, 8... (S8). */
FUNCTION HcTreeMarkCol( aNodes, nIdx )
RETURN Len( HcTreeGuide( aNodes, nIdx ) )

/* what a click on the 0-based column nCol of a row means: HC_TREE_HIT_MARK on
 * the marker, HC_TREE_HIT_ROW on any other column of the row body (the guide,
 * the text and the padding are all "the row") and 0 for a column left of the
 * body. A click on the marker of a KNOWN LEAF still answers MARK: deciding
 * that nothing happens there is the job of the caller (S8). */
FUNCTION HcTreeHit( aNodes, nIdx, nCol )
   LOCAL nMark
   IF ValType( nCol ) != "N" .OR. nCol < 0
      RETURN 0
   ENDIF
   nMark := HcTreeMarkCol( aNodes, nIdx )
   IF nCol >= nMark .AND. nCol < nMark + HC_TREE_MKW
      RETURN HC_TREE_HIT_MARK
   ENDIF
RETURN HC_TREE_HIT_ROW

/* ---- Tree panel state (odd/tasks/hc-tree-panel.md, T2) ----
 *
 * The panel record carries the tree: HC_P_TREE (is this panel a tree?),
 * HC_P_NODES (the flat pre-order model of T1), HC_P_TSEL (the cursor inside the
 * VISIBLE rows) and HC_P_TTOP (the scroll top). Everything below takes the
 * panel arrays explicitly and is PUBLIC, so the headless bank pins the whole
 * state machine without a screen. Painting is further down (HcDrawTreeTitle and
 * friends); keys and the mouse are T3/T4.
 */

/* .T. when a panel is showing the folder tree. Guarded, so an old/short panel
 * record never breaks a caller. */
FUNCTION HcPanelTree( aP )
   IF ! HB_ISARRAY( aP ) .OR. Len( aP ) < HC_P_TREE .OR. ;
      ValType( aP[ HC_P_TREE ] ) != "L"
      RETURN .F.
   ENDIF
RETURN aP[ HC_P_TREE ]

/* .T. when that node record is the folder of cPath (compared in the canonical
 * form of HcNormPath(), never with a raw `==`: the chain answers upper case and
 * the rows carry the case of the disk) */
FUNCTION HcTreeIsPath( aNode, cPath )
   IF ! HB_ISARRAY( aNode ) .OR. Len( aNode ) < HC_TN_PATH .OR. ;
      ValType( aNode[ HC_TN_PATH ] ) != "C" .OR. ValType( cPath ) != "C" .OR. ;
      Empty( cPath )
      RETURN .F.
   ENDIF
RETURN HcNormPath( aNode[ HC_TN_PATH ] ) == HcNormPath( cPath )

/* model index of the node under the tree cursor of the panel, 0 when there is
 * no model or the cursor is out of the visible rows */
FUNCTION HcTreeCurrent( aP )
   LOCAL aNodes, aView
   IF ! HB_ISARRAY( aP ) .OR. Len( aP ) < HC_P_TSEL
      RETURN 0
   ENDIF
   aNodes := aP[ HC_P_NODES ]
   IF ! HB_ISARRAY( aNodes ) .OR. Len( aNodes ) == 0 .OR. ;
      ValType( aP[ HC_P_TSEL ] ) != "N"
      RETURN 0
   ENDIF
   aView := HcTreeView( aNodes )
   IF aP[ HC_P_TSEL ] < 1 .OR. aP[ HC_P_TSEL ] > Len( aView )
      RETURN 0
   ENDIF
RETURN aView[ aP[ HC_P_TSEL ] ]

/* the folder the tree cursor is on, "" when there is none */
FUNCTION HcTreeCurPath( aP )
   LOCAL nIdx := HcTreeCurrent( aP )
   IF nIdx < 1
      RETURN ""
   ENDIF
   IF Len( aP[ HC_P_NODES ][ nIdx ] ) < HC_TN_PATH .OR. ;
      ValType( aP[ HC_P_NODES ][ nIdx ][ HC_TN_PATH ] ) != "C"
      RETURN ""
   ENDIF
RETURN aP[ HC_P_NODES ][ nIdx ][ HC_TN_PATH ]

/* clamps the tree cursor into the visible rows and scrolls the window so the
 * cursor is always inside HC_VIS rows (the very rule of HcCursorTo()). .T. when
 * the model has rows, .F. when it is empty (both slots then sit on 1). */
FUNCTION HcTreeScroll( aP )
   LOCAL n, nSel, nTop
   IF ! HB_ISARRAY( aP ) .OR. Len( aP ) < HC_P_TTOP
      RETURN .F.
   ENDIF
   n := Len( HcTreeView( aP[ HC_P_NODES ] ) )
   IF n < 1
      aP[ HC_P_TSEL ] := 1
      aP[ HC_P_TTOP ] := 1
      RETURN .F.
   ENDIF
   nSel := iif( ValType( aP[ HC_P_TSEL ] ) == "N", aP[ HC_P_TSEL ], 1 )
   nSel := Min( Max( 1, nSel ), n )
   nTop := iif( ValType( aP[ HC_P_TTOP ] ) == "N", aP[ HC_P_TTOP ], 1 )
   IF nSel < nTop
      nTop := nSel
   ENDIF
   IF nSel > nTop + HC_VIS - 1
      nTop := nSel - HC_VIS + 1
   ENDIF
   nTop := Max( 1, Min( nTop, Max( 1, n - HC_VIS + 1 ) ) )
   aP[ HC_P_TSEL ] := nSel
   aP[ HC_P_TTOP ] := nTop
RETURN .T.

/* moves the tree cursor to the visible row nTarget (clamped) and then does the
 * LAZY TOUCH of S5: the folder that just came under the cursor is read now, so
 * the children are ready before the user expands it. A folder already read is
 * never read again. The cursor stays on the SAME node (its model index does not
 * move, but the position is recomputed with HcTreeSel() anyway). .T. when the
 * visible row changed. */
FUNCTION HcTreeNav( aP, nTarget )
   LOCAL nOld, nIdx
   IF ! HB_ISARRAY( aP ) .OR. Len( aP ) < HC_P_TTOP .OR. ValType( nTarget ) != "N"
      RETURN .F.
   ENDIF
   nOld := aP[ HC_P_TSEL ]
   aP[ HC_P_TSEL ] := nTarget
   HcTreeScroll( aP )
   nIdx := HcTreeCurrent( aP )
   IF HcTreeUnread( aP[ HC_P_NODES ], nIdx )
      HcTreeLoad( aP[ HC_P_NODES ], nIdx )
      aP[ HC_P_TSEL ] := HcTreeSel( aP[ HC_P_NODES ], nIdx )
      HcTreeScroll( aP )
   ENDIF
RETURN aP[ HC_P_TSEL ] != nOld

/* Right/`+`: on a closed folder opens it; on an open one goes down to its first
 * child (the next visible row). .T. when something changed. */
FUNCTION HcTreeOpen( aP )
   LOCAL aNodes := iif( HB_ISARRAY( aP ), aP[ HC_P_NODES ], NIL ), nIdx, nSel, nOld
   nIdx := HcTreeCurrent( aP )
   IF nIdx < 1
      RETURN .F.
   ENDIF
   IF aNodes[ nIdx ][ HC_TN_EXP ] != .T.
      IF HcTreeExpand( aNodes, nIdx )
         HcTreeScroll( aP )
         RETURN .T.
      ENDIF
      RETURN .F.           /* a known leaf: nothing opens, nothing moves */
   ENDIF
   nOld := aP[ HC_P_TSEL ]
   nSel := HcTreeSel( aNodes, nIdx )
   IF nSel > 0
      HcTreeNav( aP, nSel + 1 )
   ENDIF
RETURN aP[ HC_P_TSEL ] != nOld

/* Left/`-`: on an open folder closes it; anywhere else goes up to its parent
 * (the first node above it one level up). .T. when something changed. */
FUNCTION HcTreeClose( aP )
   LOCAL aNodes := iif( HB_ISARRAY( aP ), aP[ HC_P_NODES ], NIL ), nIdx, nD, i
   nIdx := HcTreeCurrent( aP )
   IF nIdx < 1
      RETURN .F.
   ENDIF
   IF aNodes[ nIdx ][ HC_TN_EXP ] == .T.
      HcTreeCollapse( aNodes, nIdx )
      HcTreeScroll( aP )
      RETURN .T.
   ENDIF
   nD := aNodes[ nIdx ][ HC_TN_DEPTH ] - 1
   IF ValType( nD ) == "N" .AND. nD >= 0
      FOR i := nIdx - 1 TO 1 STEP -1
         IF HB_ISARRAY( aNodes[ i ] ) .AND. Len( aNodes[ i ] ) >= HC_TN_DEPTH .AND. ;
            aNodes[ i ][ HC_TN_DEPTH ] == nD
            RETURN HcTreeNav( aP, HcTreeSel( aNodes, i ) )
         ENDIF
      NEXT
   ENDIF
RETURN .F.

/* Enter: the folder under the cursor opens or closes (S6) */
FUNCTION HcTreeSwap( aP )
   LOCAL aNodes, nIdx := HcTreeCurrent( aP )
   IF nIdx < 1
      RETURN .F.
   ENDIF
   aNodes := aP[ HC_P_NODES ]
   /* S8 (T4): a KNOWN LEAF has nothing to open or to close. Its marker is "[ ]"
    * and a click on it (or Enter) changes NOTHING: no state, no repaint. The
    * EXPANDED flag is forced back to .F. so a leaf that was read and left open
    * by an earlier toggle shows the "[ ]" of a leaf again. */
   IF HB_ISARRAY( aNodes[ nIdx ] ) .AND. Len( aNodes[ nIdx ] ) >= HC_TN_KIDS .AND. ;
      aNodes[ nIdx ][ HC_TN_LOAD ] == .T. .AND. aNodes[ nIdx ][ HC_TN_KIDS ] == 0
      aNodes[ nIdx ][ HC_TN_EXP ] := .F.
      RETURN .F.
   ENDIF
   HcTreeToggle( aNodes, nIdx )
   HcTreeScroll( aP )
RETURN .T.

/* T4/T5 correction: .T. when a panel does NOT walk this disk - a Commander Link
 * peer (the SLOT, live session or not, because an orphaned flag still holds a
 * path of the peer) or a panel inside an archive. Used by HcLoad() to drop a
 * tree the panel can no longer show. */
STATIC FUNCTION HcLoadNotLocal( aP )
   IF ! HB_ISARRAY( aP )
      RETURN .F.
   ENDIF
   IF Len( aP ) >= HC_P_LINK .AND. aP[ HC_P_LINK ] == .T.
      RETURN .T.
   ENDIF
   IF HcLinkPanel( aP )
      RETURN .T.
   ENDIF
RETURN HcTreeInZip( aP )

/* S7 (T5): the ONE answer of a tree panel to a key or gesture that works on
 * files. UiErr() and not UiMsg(): a note would be easy to take as "done", and
 * this one has to be seen. Nothing else is said and nothing is attempted. */
STATIC PROCEDURE HcTreeNoFiles()
   UiErr( "The tree panel lists folders only: switch to the other panel to work with files.", ;
          BP_APPNAME )
RETURN

/* T2: .T. when the panel is inside an archive. MEASURED: HcZipPanelOf() answers
 * the PANEL ID, not "is this a zip" - the session of a panel is HcZipTop(),
 * which answers NIL for a plain directory. */
STATIC FUNCTION HcTreeInZip( aP )
   LOCAL nId := HcZipPanelOf( aP )
   IF ValType( nId ) != "N" .OR. nId < 1
      RETURN .F.
   ENDIF
   IF Empty( HcZipTop( nId ) )
      RETURN .F.
   ENDIF
RETURN .T.

/* S4: the OTHER panel shows the folder the tree cursor is on, the moment the
 * cursor changes folder - and it is NOT re-read while the cursor walks inside
 * the same folder. A panel that is not a plain local listing (another tree, a
 * Commander Link peer, an archive) is left alone: .F. and nothing touched. */
FUNCTION HcTreeSync( aP, aOther )
   LOCAL cCur
   IF ! HB_ISARRAY( aOther ) .OR. Len( aOther ) < HC_P_LINK
      RETURN .F.
   ENDIF
   IF HcPanelTree( aOther ) .OR. aOther[ HC_P_LINK ] == .T.
      RETURN .F.
   ENDIF
   IF HcTreeInZip( aOther )
      RETURN .F.
   ENDIF
   cCur := HcTreeCurPath( aP )
   IF Empty( cCur )
      RETURN .F.
   ENDIF
   /* S12 (reverse sync): the invariant on the TREE side too - the tree panel's
    * HC_P_DIR is ALWAYS the folder under its cursor, even when the other panel
    * needs no change. Without this, walking the tree left the panel's directory
    * pointing at the folder where the tree was entered, and `Reload panel`/
    * `Esc`/HcTreeFollow() would disagree with what the user is looking at. */
   aP[ HC_P_DIR ] := HcDirArg( cCur )
   IF HcNormPath( aOther[ HC_P_DIR ] ) == HcNormPath( cCur )
      RETURN .F.
   ENDIF
   aOther[ HC_P_DIR ] := HcDirArg( cCur )
   aOther[ HC_P_SEL ] := 1
   aOther[ HC_P_TOP ] := 1
   HcLoad( aOther )
RETURN .T.

/* S12 (reverse sync, odd/tasks/hc-tree-panel.md): the OTHER half of S4. When the
 * panel that is NOT a tree changes DIRECTORY - enter a folder, `..` up, a drive
 * pick, a reload after an operation: everything ends in HcLoad() - the tree panel
 * moves its cursor to that folder and opens the chain down to it.
 *
 * It answers .T. when it moved the tree, .F. when there was nothing to do. It
 * NEVER calls HcTreeSync(), HcLoad() or HcDrawScreen(): the first two would
 * re-enter the sync (a loop: the sync calls HcLoad(), which calls this) and the
 * third is the caller's business - the screen repaints on s_lHcTreeFollowed.
 *
 * The invariant it keeps, and which makes `Reload panel` and `Esc` coherent: the
 * tree panel's HC_P_DIR is ALWAYS the folder under its cursor. */
FUNCTION HcTreeFollow( aP, aOther )
   LOCAL cDir, aChain, aNodes, n, i, lMoved := .F.
   IF ! HcPanelTree( aP ) .OR. ! HB_ISARRAY( aOther ) .OR. ;
      Len( aOther ) < HC_P_TOP
      RETURN .F.
   ENDIF
   /* a tree never drags another tree, and a panel that does not walk THIS disk
    * (a Commander Link peer or a panel inside an archive) never drags anything:
    * its HC_P_DIR is a path of the peer or of a temporary tree, and no part of
    * it may enter the model (same wall as HcLoad()) */
   IF HcPanelTree( aOther ) .OR. HcLoadNotLocal( aOther )
      RETURN .F.
   ENDIF
   cDir := HcNormPath( aOther[ HC_P_DIR ] )
   IF Empty( cDir )
      RETURN .F.
   ENDIF
   IF HcNormPath( HcTreeCurPath( aP ) ) == cDir
      /* already on that folder: only the invariant, no disk and no repaint */
      aP[ HC_P_DIR ] := HcDirArg( cDir )
      RETURN .F.
   ENDIF
   /* another unit (another drive or a UNC share): the model cannot be reused,
    * because its root node is the root of the unit we were looking at */
   aNodes := aP[ HC_P_NODES ]
   IF ! HB_ISARRAY( aNodes ) .OR. Len( aNodes ) < 1 .OR. ;
      ! ( HcNormPath( HcTreeRootOf( cDir ) ) == ;
          HcNormPath( aNodes[ 1 ][ HC_TN_PATH ] ) )
      aP[ HC_P_NODES ] := HcTreeNew( cDir )
      lMoved := .T.
      aNodes := aP[ HC_P_NODES ]
      IF ! HB_ISARRAY( aNodes ) .OR. Len( aNodes ) < 1
         RETURN lMoved
      ENDIF
   ENDIF
   /* the chain from the root down to cDir: the node of each level is looked for
    * in the model and, when it is not there yet (the model is lazy), the PARENT
    * is read with HcTreeLoad(), which inserts the children right after it. The
    * level walked so far is opened, so the next one is visible and the cursor
    * can be put on it. If a level is missing (the folder was deleted meanwhile)
    * the walk stops and the model already built is kept. */
   aChain := HcTreeChain( cDir )
   FOR i := 2 TO Len( aChain )
      aNodes := aP[ HC_P_NODES ]
      n := AScan( aNodes, {| aN | HcTreeIsPath( aN, aChain[ i ] ) } )
      IF n < 1
         n := AScan( aNodes, {| aN | HcTreeIsPath( aN, aChain[ i - 1 ] ) } )
         IF n > 0
            HcTreeLoad( aNodes, n )
            aNodes := aP[ HC_P_NODES ]
            n := AScan( aNodes, {| aN | HcTreeIsPath( aN, aChain[ i ] ) } )
         ENDIF
      ENDIF
      IF n < 1
         EXIT
      ENDIF
      /* the level itself is opened (HcTreeExpand() reads it if needed and does
       * nothing on a known leaf), and then the cursor goes to it */
      HcTreeExpand( aNodes, n )
      aNodes := aP[ HC_P_NODES ]
      aP[ HC_P_TSEL ] := HcTreeSel( aNodes, n )
      lMoved := .T.
   NEXT
   HcTreeScroll( aP )
   /* the invariant: the tree's directory IS the folder under its cursor (if the
    * walk stopped early it is the last level it did reach) */
   IF ! Empty( HcTreeCurPath( aP ) )
      aP[ HC_P_DIR ] := HcDirArg( HcTreeCurPath( aP ) )
   ENDIF
   IF lMoved
      /* a moved model makes a pending click pair stale (same reason as HcLoad) */
      s_nHcListGen++
   ENDIF
RETURN lMoved

/* S3: opens the chain from the root of the unit down to HC_P_DIR on the model
 * the panel already has and leaves the tree cursor on that folder. Each ancestor
 * is EXPANDED as the walk reaches it, which is what makes the folder below it
 * exist at all (the model is lazy: a folder that was never read has no children
 * to look for), and the panel's own folder is left open too so its subfolders
 * are on screen. Shared by the entry to the view and by HcLoad(), so the two
 * cannot drift apart. */
STATIC PROCEDURE HcTreeOpenChain( aP )
   LOCAL aChain := HcTreeChain( aP[ HC_P_DIR ] ), aNodes, n := 1, i
   IF Len( aChain ) < 2 .OR. ! HB_ISARRAY( aP[ HC_P_NODES ] ) .OR. ;
      Len( aP[ HC_P_NODES ] ) < 1
      RETURN
   ENDIF
   FOR i := 2 TO Len( aChain )       /* element 1 is the root, already there */
      aNodes := aP[ HC_P_NODES ]
      HcTreeExpand( aNodes, n )      /* reads it if needed: its children appear */
      n := AScan( aNodes, {| aN | HcTreeIsPath( aN, aChain[ i ] ) } )
      IF n < 1
         RETURN
      ENDIF
      aP[ HC_P_TSEL ] := HcTreeSel( aNodes, n )
   NEXT
   /* the folder of the panel itself is opened too (S3: the window shows where
    * the user is standing, with its subfolders under it) */
   HcTreeExpand( aP[ HC_P_NODES ], n )
   aP[ HC_P_TSEL ] := HcTreeSel( aP[ HC_P_NODES ], n )
RETURN

/* S3/S7: puts a panel in tree mode with the chain of its directory open and the
 * cursor on that same directory. A Commander Link panel and a panel inside an
 * archive are REFUSED (the menu row is dimmed too): the tree walks this disk.
 * Only one panel at a time shows the tree (S4), so the other one is left first. */
FUNCTION HcTreePanelEnter( aP, aOther )
   IF ! HB_ISARRAY( aP ) .OR. Len( aP ) < HC_P_TTOP
      RETURN .F.
   ENDIF
   /* a linked panel (the slot OR a live session: an orphaned flag still holds a
    * path of the peer) and a panel inside an archive are refused */
   IF ( Len( aP ) >= HC_P_LINK .AND. aP[ HC_P_LINK ] == .T. ) .OR. ;
      HcLinkPanel( aP ) .OR. HcTreeInZip( aP )
      RETURN .F.
   ENDIF
   IF HB_ISARRAY( aOther ) .AND. HcPanelTree( aOther )
      HcTreePanelExit( aOther )
   ENDIF
   aP[ HC_P_TREE ]  := .T.
   /* T4: a new tree is a new IDENTITY: a click on a row of the previous view can
    * never be the second half of a double click (see HcTreeClickAct) */
   s_nHcListGen++
   aP[ HC_P_NODES ] := HcTreeNew( aP[ HC_P_DIR ] )
   aP[ HC_P_TSEL ]  := 1
   aP[ HC_P_TTOP ]  := 1
   HcTreeOpenChain( aP )
   HcTreeScroll( aP )
   /* the other panel follows before the lazy touch: both read the same folder
    * once, and the tree one is the one that can open it */
   HcTreeSync( aP, aOther )
   HcTreeNav( aP, aP[ HC_P_TSEL ] )
RETURN .T.

/* S3: leaves the tree and lands the panel on the folder the cursor was on
 * (that is what Esc means). .F. when the panel was not a tree. */
FUNCTION HcTreePanelExit( aP )
   LOCAL cPath
   IF ! HcPanelTree( aP ) .OR. Len( aP ) < HC_P_TTOP
      RETURN .F.
   ENDIF
   cPath := HcTreeCurPath( aP )
   IF ! Empty( cPath )
      aP[ HC_P_DIR ] := HcDirArg( cPath )
   ENDIF
   aP[ HC_P_SEL ]   := 1
   aP[ HC_P_TOP ]   := 1
   aP[ HC_P_TREE ]  := .F.
   aP[ HC_P_NODES ] := {}
   aP[ HC_P_TSEL ]  := 1
   aP[ HC_P_TTOP ]  := 1
   HcLoad( aP )
RETURN .T.

/* S1: the switch of the `Tree panel` row of the Left/Right menus (and, later,
 * of the key). Answers the state of the panel AFTER the call. */
FUNCTION HcTreePanelToggle( aP, aOther )
   IF HcPanelTree( aP )
      HcTreePanelExit( aP )
   ELSE
      HcTreePanelEnter( aP, aOther )
   ENDIF
RETURN HcPanelTree( aP )

/* S5: `Reload panel` on a tree panel drops the cache of folders and reads the
 * chain again (it is what HcLoad() does with a tree). Public because HcLoad()
 * is STATIC and the headless bank - and later T3/T4 - have to reach it. */
FUNCTION HcTreeReload( aP )
   LOCAL lTree := HcPanelTree( aP )
   /* T4: reloading rebuilds the model, so it also renews the click identity */
   s_nHcListGen++
   HcLoad( aP )
RETURN lTree

/* S6 (T3): what a key means in a tree panel. PURE: it only looks at its three
 * arguments, so the whole table is pinned by the headless bank.
 *
 *   lTree false            -> 0 for every key (a listing keeps its own keys)
 *   lBusy true             -> 0 for every key: with the COMMAND LINE in use the
 *                             arrows, Home and End belong to the line and Esc
 *                             clears it, so the tree must not take them
 *   0                      -> "not a tree key": the normal cascade of
 *                             BpHcScreen() runs exactly as it does today
 *
 * The tree takes exactly TWELVE keys: Up, Down, PgUp, PgDn, Home, End, Right
 * (open), Left (close), Enter (toggle) and Esc (leave). Tab, Ctrl-O, F1..F10,
 * Alt-F1/F2, Ins, Del, +, -, *, Shift-F2, the printable keys and the clipboard
 * chords answer 0 on purpose, so their existing branches keep running. */
FUNCTION HcTreeKeyAct( nKey, lTree, lBusy, nShift )
   IF lTree != .T. .OR. lBusy == .T. .OR. ValType( nKey ) != "N"
      RETURN 0
   ENDIF
   IF ValType( nShift ) != "N"
      nShift := 0
   ENDIF
   /* CORRECTION (defect 4): WITH `CTRL` HELD THE TREE TAKES NO KEY AT ALL. This
    * driver gives several tree keys the SAME code as a clipboard chord - 6 is
    * K_END and K_CTRL_F, 3 is K_PGDN and K_CTRL_C, 24 is K_DOWN and K_CTRL_X,
    * 22 is K_INS and K_CTRL_V (AGENTS trap 37) - so without this test `Ctrl-F`
    * quietly meant "go to the last row", `Files > Search and Replace` was
    * unreachable from a tree panel and the S7 message of HcTreeFileKey() never
    * ran. Answering 0 hands the chord to the CASE below, which is the S7 one.
    * A plain `End`, `PgDn` or `Down` (no CTRL) keeps working. */
   IF HcKeyCtrl( nShift )
      RETURN 0
   ENDIF
   DO CASE
   CASE nKey == K_UP    ; RETURN HC_TKA_UP
   CASE nKey == K_DOWN  ; RETURN HC_TKA_DOWN
   CASE nKey == K_PGUP  ; RETURN HC_TKA_PGUP
   CASE nKey == K_PGDN  ; RETURN HC_TKA_PGDN
   CASE nKey == K_HOME  ; RETURN HC_TKA_HOME
   CASE nKey == K_END   ; RETURN HC_TKA_END
   CASE nKey == K_RIGHT ; RETURN HC_TKA_OPEN
   CASE nKey == K_LEFT  ; RETURN HC_TKA_CLOSE
   CASE nKey == K_ENTER ; RETURN HC_TKA_TOGGLE
   CASE nKey == K_ESC   ; RETURN HC_TKA_LEAVE
   ENDCASE
RETURN 0

/* S6 (T3): runs one tree action. The third argument is the panel the S4 sync
 * walks (the other one); it defaults to the panel that does NOT have the focus
 * and the headless bank hands its own, so the sync can be measured without a
 * screen.
 *
 * Answers .T. when the caller must repaint the WHOLE screen: the SHAPE of the
 * model changed (an open/close/toggle that really did something, or leaving the
 * view) or HcTreeSync() moved the other panel. Answers .F. when only the two
 * rows of the tree need repainting: a refused open/close, a clamped move or an
 * arrow that stays inside the same folder. */
FUNCTION HcTreeAct( aP, nAct, aOther )
   LOCAL nTarget := 0, lMove := .F., lShape := .F., lMoved := .F.
   IF ! HB_ISARRAY( aP ) .OR. ValType( nAct ) != "N" .OR. ;
      Len( aP ) < HC_P_TTOP
      RETURN .F.
   ENDIF
   /* the third argument is the OTHER PANEL (an array). MEASURED: HcOtherPanel()
    * answers the panel ID, not the panel, so the default has to go through
    * HcPanel() - with the bare id the sync was silently skipped. */
   IF ! HB_ISARRAY( aOther )
      aOther := HcPanel( HcOtherPanel() )
   ENDIF
   IF nAct == HC_TKA_LEAVE
      /* Esc: the panel lands on the folder of the cursor and goes back to the
       * plain listing, so its header, its rows and the command line all change */
      HcTreePanelExit( aP )
      RETURN .T.
   ENDIF
   IF nAct < HC_TKA_UP .OR. nAct > HC_TKA_LEAVE
      RETURN .F.                 /* no action at all: nothing to do, nothing moved */
   ENDIF
   DO CASE
   CASE nAct == HC_TKA_UP
      nTarget := aP[ HC_P_TSEL ] - 1 ; lMove := .T.
   CASE nAct == HC_TKA_DOWN
      nTarget := aP[ HC_P_TSEL ] + 1 ; lMove := .T.
   CASE nAct == HC_TKA_PGUP
      nTarget := aP[ HC_P_TSEL ] - HC_VIS ; lMove := .T.
   CASE nAct == HC_TKA_PGDN
      nTarget := aP[ HC_P_TSEL ] + HC_VIS ; lMove := .T.
   CASE nAct == HC_TKA_HOME
      nTarget := 1 ; lMove := .T.
   CASE nAct == HC_TKA_END
      nTarget := Len( HcTreeView( aP[ HC_P_NODES ] ) ) ; lMove := .T.
   CASE nAct == HC_TKA_OPEN
      lShape := HcTreeOpen( aP )
   CASE nAct == HC_TKA_CLOSE
      lShape := HcTreeClose( aP )
   CASE nAct == HC_TKA_TOGGLE
      lShape := HcTreeSwap( aP )
   ENDCASE
   IF lMove
      HcTreeNav( aP, nTarget )        /* clamps at both ends */
   ENDIF
   /* S4: the other panel follows the folder under the cursor, and only a real
    * change of folder makes it re-read anything */
   IF HB_ISARRAY( aOther )
      lMoved := HcTreeSync( aP, aOther )
   ENDIF
RETURN lShape .OR. lMoved

/* S8 (T4): the VISIBLE row of the tree that the screen row nRow points at, 0
 * when the row is not one of the rows of the panel. It is the INVERSE of the
 * mapping HcTreeDrawRows() paints with, so paint and mouse cannot disagree.
 * CORRECTION (defect 3): a row PAST the end of the visible view answers 0 - the
 * file panels ignore a click below their last entry and S8 says the tree follows
 * their rule; before this the row clamped to the last node, so a click on empty
 * space selected the last folder and re-read the other panel. */
FUNCTION HcTreeRowIdx( aP, nRow )
   LOCAL n, nMax
   IF ! HB_ISARRAY( aP ) .OR. Len( aP ) < HC_P_TTOP .OR. ValType( nRow ) != "N"
      RETURN 0
   ENDIF
   IF nRow < HC_ROW_FIRST .OR. nRow > HC_ROW_LAST
      RETURN 0
   ENDIF
   nMax := Len( HcTreeView( aP[ HC_P_NODES ] ) )
   n := aP[ HC_P_TTOP ] + nRow - HC_ROW_FIRST
   IF nMax < 1 .OR. n < 1 .OR. n > nMax
      RETURN 0
   ENDIF
RETURN n

/* S8 (T4): a PLAIN click on a tree row is a cursor move, with the lazy touch of
 * S5. .T. when the cursor really moved. */
FUNCTION HcTreeClickMove( aP, nRow )
   LOCAL nIdx := HcTreeRowIdx( aP, nRow )
   IF nIdx < 1
      RETURN .F.
   ENDIF
RETURN HcTreeNav( aP, nIdx )

/* S8 (T4): what a LEFT click on the tree means, as the action code the keyboard
 * produces, so a click runs through the SAME HcTreeAct() and there is only one
 * place where a tree action happens:
 *
 *   the marker cell  ([-] [+] [ ])          -> HC_TKA_TOGGLE
 *   a row, with a VALID double-click pair   -> HC_TKA_TOGGLE (double click = Enter)
 *   a row, single click                     -> 0 (the caller does HcTreeClickMove())
 *   outside the body / no row              -> 0
 *
 * The pair is armed by EVERY click (the marker ones included), so the click
 * after a marker click can never pair with the one before it. The identity it is
 * judged on is the TREE's identity - the generation of the model plus the NODE
 * PATH - never the screen row: a click that lands on the same row after the tree
 * changed is a plain click. */
FUNCTION HcTreeClickAct( aP, nRow, nCol, lDbl, cId )
   LOCAL nIdx, aView, nModel, nBody, lPair
   IF ! HB_ISARRAY( aP ) .OR. Len( aP ) < HC_P_TTOP
      RETURN 0
   ENDIF
   nIdx  := HcTreeRowIdx( aP, nRow )
   lPair := HcClickPair( lDbl == .T., cId )
   IF nIdx < 1 .OR. ValType( nCol ) != "N"
      RETURN 0
   ENDIF
   aView  := HcTreeView( aP[ HC_P_NODES ] )
   nModel := aView[ nIdx ]
   nBody  := nCol - ( HcPanelL( aP[ HC_P_ID ] ) + 1 )
   IF HcTreeHit( aP[ HC_P_NODES ], nModel, nBody ) == HC_TREE_HIT_MARK
      RETURN HC_TKA_TOGGLE
   ENDIF
   IF lPair
      RETURN HC_TKA_TOGGLE
   ENDIF
RETURN 0

/* T2 helper: .T. when the node nIdx of the model was never read (S5) */
STATIC FUNCTION HcTreeUnread( aNodes, nIdx )
   IF ! HB_ISARRAY( aNodes ) .OR. ValType( nIdx ) != "N" .OR. ;
      nIdx < 1 .OR. nIdx > Len( aNodes ) .OR. ! HB_ISARRAY( aNodes[ nIdx ] ) .OR. ;
      Len( aNodes[ nIdx ] ) < HC_TN_LOAD
      RETURN .F.
   ENDIF
RETURN ! aNodes[ nIdx ][ HC_TN_LOAD ]

/* changes the directory of a panel: `..` goes up and leaves the cursor on the
 * directory we came from (like `upstream`), a directory entry goes down with the
 * cursor on its first entry */
STATIC PROCEDURE HcChangeDir( aPanel, cName )
   LOCAL cFrom, nId, z
   /* S2: a linked panel walks the remote tree (and `..` NEVER leaves the link:
    * at the top of the exported scope it is a no-op, S14); nothing here ever
    * touches the local disk */
   IF HcLinkPanel( aPanel )
      HcLinkChangeDir( aPanel, cName )
      RETURN
   ENDIF
   IF cName == ".."
      /* S48: at the ROOT of an archive `..` leaves the ZIP (it must never
       * climb out of the working tree) */
      nId := HcZipPanelOf( aPanel )
      z := iif( nId > 0, HcZipTop( nId ), NIL )
      IF ! hb_IsNIL( z ) .AND. ;
         HcNormPath( aPanel[ HC_P_DIR ] ) == HcNormPath( z[ HC_Z_ROOT ] )
         HcZipLeave( nId )
         RETURN
      ENDIF
      cFrom := HcDirName( aPanel[ HC_P_DIR ] )
      aPanel[ HC_P_DIR ] := HcParentDir( aPanel[ HC_P_DIR ] )
      HcLoad( aPanel )
      HcGotoName( aPanel, cFrom )
   ELSE
      aPanel[ HC_P_DIR ] := HcJoinPath( aPanel[ HC_P_DIR ], cName ) + "\"
      aPanel[ HC_P_SEL ] := 1
      aPanel[ HC_P_TOP ] := 1
      HcLoad( aPanel )
   ENDIF
RETURN

/* last segment of a directory path ("C:\a\b\" -> "b") */
STATIC FUNCTION HcDirName( cDir )
   LOCAL c := cDir, n
   IF Len( c ) > 3 .AND. ( Right( c, 1 ) == "\" .OR. Right( c, 1 ) == "/" )
      c := Left( c, Len( c ) - 1 )
   ENDIF
   n := Max( Rat( "\", c ), Rat( "/", c ) )
   IF n > 0
      RETURN SubStr( c, n + 1 )
   ENDIF
RETURN c

/* Enter on the entry under the cursor. It returns the FULL PATH of a *.DBF
 * (S8: the caller opens it) and "" for everything else, after navigating
 * into a directory or running another file with the shell (S3). */
/* S81 (odd/tasks/hc-enter-actions.md): what `Enter` does with a FILE, decided
 * by the extension -- upper case, after the LAST dot of the name, so a folder
 * with dots never decides it. It is PURE so the headless bank pins the whole
 * rule; directories are handled by the caller before getting here.
 *
 *   .DBF                        -> HC_ENTER_DBF (the caller opens the Browse edit)
 *   .ZIP                        -> HC_ENTER_ZIP (the archive opens IN the panel)
 *   .EXE .BAT .CMD .PS1 .PY ... -> HC_ENTER_RUN  (ask for confirmation, then run)
 *   anything else               -> HC_ENTER_OPEN (the Windows association)
 *
 * A name without an extension is never guessed: the association decides. */
FUNCTION HcEnterKind( cName )
   LOCAL nPos, cExt
   IF ValType( cName ) != "C" .OR. Len( cName ) == 0
      RETURN HC_ENTER_OPEN
   ENDIF
   nPos := Rat( ".", cName )
   IF nPos == 0 .OR. nPos == Len( cName )
      RETURN HC_ENTER_OPEN
   ENDIF
   cExt := Upper( SubStr( cName, nPos + 1 ) )
   DO CASE
   CASE cExt == "DBF"
      RETURN HC_ENTER_DBF
   CASE cExt == "ZIP"
      RETURN HC_ENTER_ZIP
   CASE ( "," + cExt + "," ) $ HC_ENTER_SCRIPTS
      RETURN HC_ENTER_RUN
   ENDCASE
RETURN HC_ENTER_OPEN

/* S81: hand a file to the program Windows associates with it. The C helper does
 * the ShellExecute; without it (the headless bank compiles this module with
 * -DBP_HC_STANDALONE) there is nothing to launch and this path is never taken. */
STATIC PROCEDURE HcShellOpen( cFile )
   LOCAL lOk := .F.
#ifndef BP_HC_STANDALONE
   lOk := W32ShellOpen( cFile )
#endif
   IF ! lOk
      UiErr( "Cannot open this file with its associated program:" + hb_eol() + cFile, ;
             BP_APPNAME )
   ENDIF
RETURN

/* S81: run a confirmed script with the PANEL DIRECTORY as the current
 * directory, so the relative paths inside it (a `copy x.txt`, a `python
 * tool.py`, a `call build.bat`) resolve where the user is looking and not where
 * hwBro happened to be started from. The process directory is put back right
 * after, so nothing else of the program changes; a panel directory that no
 * longer exists simply runs from the current one. */
STATIC PROCEDURE HcRunScript( cFile, cDir )
   LOCAL cOld := CurDir()
   IF ! Empty( cDir ) .AND. hb_DirExists( cDir )
      DirChange( cDir )
   ENDIF
   hb_run( Chr( 34 ) + cFile + Chr( 34 ) )
   IF ! Empty( cOld )
      DirChange( cOld )
   ENDIF
RETURN

STATIC FUNCTION HcEnterEntry()
   LOCAL aP := HcPanelActive(), aE, cFull, n
   IF Empty( aP[ HC_P_LIST ] )
      RETURN ""
   ENDIF
   n := aP[ HC_P_SEL ]
   IF n < 1 .OR. n > Len( aP[ HC_P_LIST ] )
      RETURN ""
   ENDIF
   aE := aP[ HC_P_LIST ][ n ]
   IF HcIsDir( aE )
      HcChangeDir( aP, aE[ HC_E_NAME ] )
      RETURN ""
   ENDIF
   /* S3: a file of a linked panel is never opened, viewed, edited or run - a
    * *.DBF least of all, because there is no remote Browse view nor Browse
    * edit by design */
   IF HcLinkGuard()
      RETURN ""
   ENDIF
   cFull := HcJoinPath( aP[ HC_P_DIR ], aE[ HC_E_NAME ] )
   IF Upper( Right( cFull, 4 ) ) == ".ZIP" .AND. HcZipIsZip( cFull )
      /* S47: Enter on an archive opens its CONTENTS in this panel. A failed
       * open leaves the panel as it was (HcZipOpenPanel says why). */
      HcZipOpenPanel( HcActive(), cFull )
      RETURN ""
   ENDIF
   IF HcIsDbfFile( cFull )
      /* case-insensitive: FOO.DBF and foo.dbf both go back to the caller. The
       * test is the shared HcIsDbfFile(), so Enter and F4 cannot drift apart
       * on what a database is (S66). Returning the path IS "open the Browse
       * edit": Main() opens it and the record browser with editing runs. */
      RETURN cFull
   ENDIF
   /* S81: the rest is decided by the extension (HcEnterKind). A script is
    * never run without the confirmation box under it; anything else goes to
    * the program Windows associates with it (the built-in viewer is F3/F4). */
   DO CASE
   CASE HcEnterKind( aE[ HC_E_NAME ] ) == HC_ENTER_ZIP
      IF HcZipIsZip( cFull )
         HcZipOpenPanel( HcActive(), cFull )
      ELSE
         HcShellOpen( cFull )
      ENDIF
   CASE HcEnterKind( aE[ HC_E_NAME ] ) == HC_ENTER_RUN
      IF UiConfirm( "Run this file?" + hb_eol() + cFull, BP_APPNAME )
         /* S81: with the directory of THIS panel as the current directory */
         HcRunScript( cFull, aP[ HC_P_DIR ] )
      ENDIF
   OTHERWISE
      HcShellOpen( cFull )
   ENDCASE
RETURN ""

/* Ins: toggles the mark of the current entry and advances, so a run of files
 * can be marked with repeated Ins presses (same as `upstream`) */
STATIC PROCEDURE HcToggleMark()
   LOCAL aP := HcPanelActive(), aE, n := aP[ HC_P_SEL ]
   IF Empty( aP[ HC_P_LIST ] ) .OR. n < 1 .OR. n > Len( aP[ HC_P_LIST ] )
      RETURN
   ENDIF
   aE := aP[ HC_P_LIST ][ n ]
   IF aE[ HC_E_NAME ] == ".."
      RETURN
   ENDIF
   aE[ HC_E_MARK ] := ! aE[ HC_E_MARK ]
   HcCursorTo( aP, n + 1 )
RETURN

/* `+` marks and `-` unmarks every entry matching a mask typed by the user.
 * Returns .T. when the list has to be repainted. */
STATIC FUNCTION HcMarkByMask( lSelect )
   LOCAL aP := HcPanelActive(), aE, cMask, i, lAny := .F.
   /* S3 of commander-cleanup.md: the field opens with the mask used LAST time
    * and, the very first time, with `*.*`. It opens WHOLE SELECTED (the last
    * argument of UiInput), so typing REPLACES the proposal instead of being
    * appended to it - without that, typing `*.prg` over a seeded `*.*` would
    * leave `*.**.prg` and match nothing. */
   cMask := UiInput( iif( lSelect, "Select files by mask:", ;
                                "Deselect files by mask:" ), HcMaskSeed(), 40, .T. )
   IF Empty( cMask )
      RETURN .F.
   ENDIF
   cMask := AllTrim( cMask )
   HcMaskRemember( cMask )
   FOR i := 1 TO Len( aP[ HC_P_LIST ] )
      aE := aP[ HC_P_LIST ][ i ]
      IF ! ( aE[ HC_E_NAME ] == ".." )
         IF HcMaskMatch( cMask, aE[ HC_E_NAME ] )
            aE[ HC_E_MARK ] := lSelect
            lAny := .T.
         ENDIF
      ENDIF
   NEXT
RETURN lAny

/* The mask that `Select group` / `Deselect group` PROPOSES: the one typed last
 * in this session or, while there is none, `*.*` (S3 of commander-cleanup.md).
 * Pure: it only reads the session slot. */
FUNCTION HcMaskSeed()
   IF Empty( s_cHcMaskSeed )
      RETURN HC_MASK_SEED
   ENDIF
RETURN s_cHcMaskSeed

/* Remember the mask that was accepted. An empty or non-character answer does
 * NOT overwrite the memory: cancelling the box must not throw away the last
 * mask the user actually used. Answers .T. when the slot changed. */
FUNCTION HcMaskRemember( cMask )
   LOCAL cNew
   IF ValType( cMask ) != "C"
      RETURN .F.
   ENDIF
   cNew := AllTrim( cMask )
   IF Empty( cNew ) .OR. ( cNew == s_cHcMaskSeed )
      RETURN .F.
   ENDIF
   s_cHcMaskSeed := cNew
RETURN .T.

/* Alt-F1 / Alt-F2: the panel jumps to the root of the chosen drive. The list
 * is built by asking whether the drive root exists: unlike `upstream` this never
 * changes the current drive of the process. A LINKED panel lists the drives OF
 * THE PEER (S15: the DRIVES verb) and choosing one NAVIGATES the remote panel; it
 * never unlinks (S14: leaving the link is `Left`/`Right > Disconnect link`). */
STATIC FUNCTION HcPickDrive( nId )
   LOCAL aP := HcPanel( nId ), aDrv, n, cErr := ""
   IF HcLinkPanel( aP )
      aDrv := HcLinkRemoteDrives( @cErr )
      IF ! HB_ISARRAY( aDrv )
         UiErr( "Commander Link: cannot ask the Slave for its drives." + ;
                iif( Len( cErr ) > 0, hb_eol() + cErr, "" ), BP_APPNAME )
         RETURN .F.
      ENDIF
      IF Empty( aDrv )
         RETURN .F.
      ENDIF
      n := UiPick( aDrv, iif( nId == HC_PANEL_L, "Choose left drive", ;
                                                "Choose right drive" ), 1 )
      IF n < 1 .OR. n > Len( aDrv )
         RETURN .F.
      ENDIF
      aP[ HC_P_DIR ] := aDrv[ n ] + "\"
      aP[ HC_P_SEL ] := 1
      aP[ HC_P_TOP ] := 1
      HcLoad( aP )
      RETURN .T.
   ENDIF
   aDrv := HcDrives()
   IF Empty( aDrv )
      RETURN .F.
   ENDIF
   n := UiPick( aDrv, iif( nId == HC_PANEL_L, "Choose left drive", ;
                                             "Choose right drive" ), 1 )
   IF n < 1 .OR. n > Len( aDrv )
      RETURN .F.
   ENDIF
   aP[ HC_P_DIR ] := aDrv[ n ] + "\"
   aP[ HC_P_SEL ] := 1
   HcLoad( aP )
RETURN .T.

/* the drives of this machine: ONE implementation in bp_link.prg (LinkDrives()),
 * shared with the DRIVES verb of the Slave, through the bridge of the module so
 * the headless build still links (HcLkDrives) */
STATIC FUNCTION HcDrives()
RETURN HcLkDrives()

/* =====================================================================
 *  Painting (S6 colours, S7 geometry, one paint block per refresh)
 * ===================================================================== */

STATIC PROCEDURE HcDrawScreen()
   LOCAL i
   UiPaintBegin()
   /* The canvas is cleared TWICE on purpose. UiCls() is the CLS of the driver
    * with UI_C_DESKTOP, like every other screen of hwBro; on top of it the
    * whole canvas is blanked cell by cell, because the driver only repaints
    * the cells that are WRITTEN: the columns that no panel writes (0..HC_LL-1,
    * the gutter between the panels and the right margin) kept the characters
    * of the previous screen (the browser's after Esc, the splash's on entry)
    * even though the CLS had been issued. With both, no cell of the canvas can
    * keep stale content: on entry, after Ctrl-O and on every return from
    * another screen.
    *
    * The blanking uses UI_C_DARK, the BODY of the panels - not UI_C_DESKTOP -,
    * so the background of the file manager IS the body of its panels (S14).
    * With the desktop pair the two margins (columns 0..1 and 118..119) came out
    * light gray next to the dark body in `Classic` (170,170,170 against
    * 85,85,85): the two stripes the user reported. In `Dark` both pairs land on
    * the same near black, which is why the screen already looked uniform there.
    * The gutter between the panels is blanked with the same pair for the same
    * reason. */
   UiCls()
   SetColor( UI_C_DARK )
   FOR i := HC_MENU TO MaxRow()
      @ i, 0 SAY Space( UiCols() )
   NEXT
   /* which *.DBF are open right now (colours the entries, polish 3) */
   HcRefreshOpenDbs()
   IF HcPanelVisible( HC_PANEL_L )
      HcDrawPanel( HC_PANEL_L )
   ENDIF
   IF HcPanelVisible( HC_PANEL_R )
      HcDrawPanel( HC_PANEL_R )
   ENDIF
   /* the three chrome rows of S7 and the menu bar of S25 above the panels */
   HcDrawStatus()
   HcDrawCmd()
   HcDrawBar()
   HcDrawMenuBar( 0 )
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()
   HcCaretOn()
RETURN

/* the command line alone (typing, history, Esc): one paint block, one row */
STATIC PROCEDURE HcPaintCmd()
   UiPaintBegin()
   HcDrawCmd()
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()
   HcCaretOn()
RETURN

/* whole panel: interior, frame, title, header, separator and the visible
 * entries. The caller owns the UiPaintBegin()/UiPaintEnd() pair.
 * NO shadow: the panels of the Commander paint none, in any mode (S14). The two
 * cells right of the frame (columns HC_RR+1..MaxCol(), i.e. 118..119) are the
 * BACKGROUND of the file manager, i.e. UI_C_DARK - the same pair as the body of
 * the panel, so the margin cannot be told apart from it. A block shadow there
 * was measured as a grey stripe on the Dark theme and as a grey box on the
 * Classic one: `Chr(219)` is painted with the FOREGROUND of the pair (AGENTS.md
 * trap 39), so UI_C_SHADOW ("N+/N") wrote a solid grey column over the
 * background instead of a shade. Nothing replaces it. */
STATIC PROCEDURE HcDrawPanel( nId )
   LOCAL nL := HcPanelL( nId ), nR := HcPanelR( nId )
   LOCAL aP := HcPanel( nId ), lTree := HcPanelTree( aP )
   UiFillBox( HC_T + 1, nL + 1, HC_B - 1, nR - 1, UI_C_DARK )
   UiFrame( HC_T, nL, HC_B, nR, ;
            iif( nId == HcActive(), UI_C_FRAME2, UI_C_FRAME1 ), .F. )
   /* T2 of hc-tree-panel.md: a tree panel shares the frame, the interior and the
    * rule, and paints its own title, header and rows */
   IF lTree
      HcDrawTreeTitle( nId )
      HcDrawTreeHeader( nId )
   ELSE
      HcDrawTitle( nId )
      HcDrawHeader( nId )
   ENDIF
   SetColor( UI_C_HDR )
   @ HC_ROW_SEP, nL + 1 SAY Replicate( BP_LINE_SINGLE, nR - nL - 1 )
   IF lTree
      HcTreeDrawRows( nId, HC_ROW_FIRST, HC_ROW_LAST )
   ELSE
      HcDrawRows( nId, HC_ROW_FIRST, HC_ROW_LAST )
   ENDIF
   /* the current colour is left as the BACKGROUND of the file manager, i.e. the
    * body of the panel (S14): whatever paints next without setting a colour
    * blends with the panels instead of punching a hole of the old desktop */
   SetColor( UI_C_DARK )
RETURN

/* ---- Tree panel painting (odd/tasks/hc-tree-panel.md, T2; S2/S9) ----
 *
 * No new colour and no literal of a canvas: the width comes from the panel
 * rectangle, the colours are the ones the listing already uses (UI_C_DARK body,
 * UI_C_LISTSEL cursor, UI_C_CHIP title band). The rows painted are the VISIBLE
 * ones, offset by the scroll top of the panel (HC_P_TTOP).
 */

/* cells the tree text may use: the interior of the panel, one cell of margin at
 * each side, as HcDrawRow() does */
FUNCTION HcTreeBodyW( nId )
RETURN Max( 0, HcPanelR( nId ) - HcPanelL( nId ) - 1 )

/* the status row of a tree panel: the folder under the cursor and, when it was
 * read, how many folders it holds, plus the [TREE] chip. A path that does not
 * fit is cut FROM THE LEFT ("...") because the tail -the folder the user is
 * looking at- is what matters. Pure, so the headless bank pins it. */
FUNCTION HcTreeStatusText( aNodes, nIdx, nW )
   LOCAL c, cTail, nTail, nAvail
   IF ValType( nW ) != "N" .OR. nW < 0
      nW := 0
   ENDIF
   IF ! HB_ISARRAY( aNodes ) .OR. ValType( nIdx ) != "N" .OR. ;
      nIdx < 1 .OR. nIdx > Len( aNodes ) .OR. ! HB_ISARRAY( aNodes[ nIdx ] ) .OR. ;
      Len( aNodes[ nIdx ] ) < HC_TN_KIDS
      RETURN Left( "Tree: (no folder)", nW )
   ENDIF
   cTail := "   [TREE]"
   IF aNodes[ nIdx ][ HC_TN_LOAD ] == .T. .AND. ValType( aNodes[ nIdx ][ HC_TN_KIDS ] ) == "N"
      cTail := "   " + LTrim( Str( aNodes[ nIdx ][ HC_TN_KIDS ] ) ) + " folders" + cTail
   ENDIF
   nTail := Len( cTail )
   nAvail := Max( 0, nW - nTail )
   c := iif( ValType( aNodes[ nIdx ][ HC_TN_PATH ] ) == "C", aNodes[ nIdx ][ HC_TN_PATH ], "" )
   IF Len( c ) > nAvail
      c := iif( nAvail > 3, "..." + Right( c, nAvail - 3 ), Left( c, nAvail ) )
   ENDIF
   c := PadR( c, nAvail )
RETURN Left( c + cTail, nW )

/* colour of a tree row: the cursor is yellow only in the panel that HAS the
 * focus (the same convention as HcRowColor: the inactive panel never highlights
 * its cursor) and everything else is the body colour */
FUNCTION HcTreeRowColor( nId, lCursor )
RETURN iif( lCursor .AND. nId == HcActive(), UI_C_LISTSEL, UI_C_DARK )

/* title row of a tree panel: the same cyan band as HcDrawTitle() with the
 * folder of the cursor and the [TREE] chip at the right end, where the link
 * chip of a peer sits on a linked panel */
STATIC PROCEDURE HcDrawTreeTitle( nId )
   LOCAL aP := HcPanel( nId ), nL := HcPanelL( nId )
   LOCAL nW := HcPanelR( nId ) - nL - 1, cPath := HcTreeCurPath( aP )
   LOCAL cChip := "[TREE]", nChipW, nGap, nPathW
   cPath := iif( Empty( cPath ), "Tree", "Tree: " + cPath )
   nChipW := Min( Len( cChip ), Max( 0, nW ) )
   nGap   := iif( nW - nChipW - 1 > 0, 1, 0 )
   nPathW := Max( 0, nW - nChipW - nGap )
   SetColor( UI_C_CHIP )
   @ HC_ROW_TITLE, nL + 1 SAY PadR( HcPathTitle( cPath, nPathW ), nPathW )
   IF nGap > 0
      @ HC_ROW_TITLE, nL + 1 + nPathW SAY Space( nGap )
   ENDIF
   IF nChipW > 0
      SetColor( UI_C_BOXSEL )
      @ HC_ROW_TITLE, nL + 1 + nPathW + nGap SAY PadR( Left( cChip, nChipW ), nChipW )
   ENDIF
   SetColor( UI_C_DESKTOP )
RETURN

/* header of a tree panel: the same band and colours as HcDrawHeader() with
 * only `Name` - the tree has no size, date or time to show, and a header cell
 * with an order arrow would be a sort the tree does not have (S8) */
STATIC PROCEDURE HcDrawTreeHeader( nId )
   LOCAL nL := HcPanelL( nId ), nW := HcPanelR( nId ) - nL - 1
   SetColor( UI_C_HDR )
   @ HC_ROW_HDR, nL + 1 SAY PadR( "Name", Max( 0, nW ) )
   SetColor( UI_C_DESKTOP )
RETURN

/* the VISIBLE tree rows, screen rows nFirst..nLast: the row nRow shows the
 * visible row HC_P_TTOP + ( nRow - HC_ROW_FIRST ), and past the end of the view
 * the interior is painted empty in the body colour.
 *
 * S9 (T5): the guide and the marker of a KNOWN LEAF are the DIM pair
 * (UI_C_DIM: dim text on the body background, no new colour) and the rest of the
 * row keeps the colour of the row; the cursor
 * row of the ACTIVE panel is ONE band of UI_C_LISTSEL with no dim inside it. The
 * three SAYs of a row all happen inside the paint block of the caller (there is
 * never a block per row). */
STATIC PROCEDURE HcTreeDrawRows( nId, nFirst, nLast )
   LOCAL aP := HcPanel( nId ), aView := HcTreeView( aP[ HC_P_NODES ] )
   LOCAL nW := HcTreeBodyW( nId ), nRow, nIdx, aParts, cRow, cMark, nLeft
   FOR nRow := nFirst TO nLast
      IF nRow >= HC_ROW_FIRST .AND. nRow <= HC_ROW_LAST
         nIdx := aP[ HC_P_TTOP ] + nRow - HC_ROW_FIRST
         IF nIdx < 1 .OR. nIdx > Len( aView )
            SetColor( UI_C_DARK )
            @ nRow, HcPanelL( nId ) + 1 SAY Space( nW )
         ELSE
            aParts := HcTreeRowParts( aP[ HC_P_NODES ], aView[ nIdx ], nW )
            cRow   := HcTreeRowColor( nId, nIdx == aP[ HC_P_TSEL ] )
            cMark  := HcTreeMark( aP[ HC_P_NODES ], aView[ nIdx ] )
            IF cRow == UI_C_LISTSEL
               /* the cursor band is ONE colour: the whole row, no dim inside */
               SetColor( UI_C_LISTSEL )
               @ nRow, HcPanelL( nId ) + 1 SAY ;
                  Left( aParts[ 1 ] + aParts[ 2 ], nW )
            ELSE
               nLeft := Len( aParts[ 1 ] )
               IF cMark == HC_TREE_LEAF_MARK .OR. nLeft < Len( cMark )
                  /* the guide AND the marker of a known leaf: the dim pair */
                  SetColor( UI_C_DIM )
                  @ nRow, HcPanelL( nId ) + 1 SAY aParts[ 1 ]
               ELSE
                  /* the guide is dim, the [-]/[+] marker carries the row colour */
                  SetColor( UI_C_DIM )
                  IF nLeft > Len( cMark )
                     @ nRow, HcPanelL( nId ) + 1 SAY Left( aParts[ 1 ], nLeft - Len( cMark ) )
                  ENDIF
                  SetColor( cRow )
                  @ nRow, HcPanelL( nId ) + 1 + nLeft - Len( cMark ) SAY cMark
               ENDIF
               SetColor( cRow )
               @ nRow, HcPanelL( nId ) + 1 + nLeft SAY aParts[ 2 ]
            ENDIF
         ENDIF
      ENDIF
   NEXT
   SetColor( UI_C_DESKTOP )
RETURN

STATIC PROCEDURE HcDrawTitle( nId )
   LOCAL aP := HcPanel( nId ), nL := HcPanelL( nId )
   LOCAL nW := HcPanelR( nId ) - nL - 1
   LOCAL z := HcZipTop( nId ), cTitle, cChip, nChipW, nPathW
   /* S2 of commander-link.md: a LINKED panel shows \\NAME\sub\dir\ instead of a
    * local path and carries the chip of the peer, so it is obvious that what
    * is listed lives on the other machine */
   IF HcLinkPanel( aP )
      cTitle := HcLinkTitle( HcLinkName(), aP[ HC_P_DIR ] )
      cChip  := HcLinkPeerText( HcLinkHost(), HcLinkPort() )
      nChipW := Min( Len( cChip ) + 1, Max( 0, nW ) )
      nPathW := Max( 0, nW - nChipW )
      SetColor( UI_C_CHIP )
      @ HC_ROW_TITLE, nL + 1 SAY PadR( HcPathTitle( cTitle, nPathW ), nPathW )
      SetColor( UI_C_BOXSEL )
      @ HC_ROW_TITLE, nL + 1 + nPathW SAY PadR( Left( cChip, nChipW ), nChipW )
      SetColor( UI_C_DESKTOP )
      RETURN
   ENDIF
   /* S48: inside an archive the chip shows the ARCHIVE and the relative part,
    * never the working tree (which is an implementation detail) */
   cTitle := iif( hb_IsNIL( z ), aP[ HC_P_DIR ], ;
                  HcZipVirtualPath( z[ HC_Z_FILE ], z[ HC_Z_ROOT ], aP[ HC_P_DIR ] ) )
   SetColor( UI_C_CHIP )
   @ HC_ROW_TITLE, nL + 1 SAY PadR( HcPathTitle( cTitle, nW ), nW )
   SetColor( UI_C_DESKTOP )
RETURN

/* the path of a panel, cut like `upstream` does when it does not fit: the head of
 * the path plus the tail, so the directory name is always readable */
STATIC FUNCTION HcPathTitle( cDir, nW )
   LOCAL c := cDir
   IF nW < 8 .OR. Len( c ) <= nW
      RETURN Left( c, nW )
   ENDIF
RETURN Left( c, 3 ) + "..." + Right( c, nW - 6 )

/* S5/S34: the header row of a panel. The cell of the ACTIVE sort column is
 * painted in the list-selection colour and carries a CP437 arrow, so the order
 * in force is readable at a glance; the rest of the row is painted as it always
 * was. The cells keep their widths, so nothing moves when the mark moves. */
STATIC PROCEDURE HcDrawHeader( nId )
   LOCAL aP := HcPanel( nId ), nL := HcPanelL( nId ), nW := HcNameW( nId )
   HcHeaderCell( HC_ROW_HDR, nL + 1, "Name", nW, .F., "NAME", aP )
   HcHeaderCell( HC_ROW_HDR, nL + nW + 1, "Size", HC_SIZE_W, .T., "SIZE", aP )
   SetColor( UI_C_HDR )
   @ HC_ROW_HDR, nL + nW + 1 + HC_SIZE_W SAY "|"
   HcHeaderCell( HC_ROW_HDR, nL + nW + HC_SIZE_W + 2, "Date", HC_DATE_W, .T., "DATE", aP )
   SetColor( UI_C_HDR )
   @ HC_ROW_HDR, nL + nW + HC_SIZE_W + 2 + HC_DATE_W SAY "|"
   /* `Time` is the same timestamp as `Date`, so it is not sortable (S4) */
   SetColor( UI_C_HDR )
   @ HC_ROW_HDR, nL + nW + HC_SIZE_W + HC_DATE_W + 3 SAY PadL( "Time", HC_TIME_W )
   SetColor( UI_C_DESKTOP )
RETURN

/* one cell of the header row: the active sort column carries an arrow
 * (Chr(24) ascending, Chr(25) descending) after its label and the others do
 * not. L26: the cell keeps the NORMAL header colour - the yellow background
 * (UI_C_LISTSEL) the first version used was rejected by the user, the arrow is
 * enough. "Name" occupies 4 of its 31 cells, "Size" 4 of 10 and "Date" 4 of 8,
 * so label + space + arrow still fits in every cell. */
STATIC PROCEDURE HcHeaderCell( nRow, nCol, cLabel, nW, lRight, cSort, aP )
   LOCAL lOn := ( HcPanelSort( aP ) == cSort ), c := cLabel
   IF lOn
      c := cLabel + " " + iif( HcPanelDesc( aP ), Chr( 25 ), Chr( 24 ) )
   ENDIF
   SetColor( UI_C_HDR )
   @ nRow, nCol SAY iif( lRight, PadL( c, nW ), PadR( c, nW ) )
   SetColor( UI_C_DESKTOP )
RETURN

/* width of the name field: everything the size, date and time fields leave */
STATIC FUNCTION HcNameW( nId )
RETURN HcPanelR( nId ) - HcPanelL( nId ) - 1 - ;
       ( HC_SIZE_W + 1 + HC_DATE_W + 1 + HC_TIME_W )

STATIC PROCEDURE HcDrawRows( nId, nFirst, nLast )
   LOCAL nRow
   FOR nRow := nFirst TO nLast
      HcDrawRow( nId, nRow )
   NEXT
   SetColor( UI_C_DESKTOP )
RETURN

STATIC PROCEDURE HcDrawRow( nId, nRow )
   LOCAL aP := HcPanel( nId ), nL := HcPanelL( nId )
   LOCAL nIdx := aP[ HC_P_TOP ] + nRow - HC_ROW_FIRST
   IF nRow < HC_ROW_FIRST .OR. nRow > HC_ROW_LAST
      RETURN
   ENDIF
   IF nIdx < 1 .OR. nIdx > Len( aP[ HC_P_LIST ] )
      /* past the end of the listing: empty interior */
      SetColor( UI_C_DARK )
      @ nRow, nL + 1 SAY Space( HcPanelR( nId ) - nL - 1 )
      SetColor( UI_C_DESKTOP )
      RETURN
   ENDIF
   SetColor( HcRowColor( nId, nIdx ) )
   @ nRow, nL + 1 SAY HcFormatEntry( aP[ HC_P_LIST ][ nIdx ], HcNameW( nId ) )
   SetColor( UI_C_DESKTOP )
RETURN

/* S6: cursor of the active panel yellow, cursor of the inactive one cyan,
 * marked entries red, an already open database in the picked colour (only
 * its colour changes, never its text), directories in the header colour and
 * files dark. The cursor always wins. */
STATIC FUNCTION HcRowColor( nId, nIdx )
   LOCAL aP := HcPanel( nId ), aE := aP[ HC_P_LIST ][ nIdx ]
   /* Only the panel that HAS the focus highlights its current entry: the other
    * panel shows it like any other row, so a <Tab> never leaves something that
    * looks selected behind (the mark of Ins and an open database still show in
    * both panels: those are real state, not the cursor). */
   IF nIdx == aP[ HC_P_SEL ] .AND. nId == HcActive()
      RETURN UI_C_LISTSEL
   ENDIF
   IF aE[ HC_E_MARK ]
      RETURN UI_C_RECSEL
   ENDIF
   IF HcIsDbfFile( aE[ HC_E_NAME ] ) .AND. HcIsOpenDb( aE[ HC_E_NAME ] ) .AND. ;
      ! HcLinkPanel( aP )
      RETURN UI_C_PICKED
   ENDIF
   /* Directories are NOT tinted any more: they look exactly like a file. Only
    * the cursor, a mark or an open database change a row's colour. */
RETURN UI_C_DARK

/* ---- which databases are open (polish 3) ---- */

/* S66: .T. for a path whose LAST four characters are .DBF, case-insensitive.
 * ONE helper for the three places that have to agree on what a database is:
 * Enter (HcEnterEntry hands the path back), F4 (HcEdit hands it back too) and
 * the row colour of an open database. Public so the headless bank pins it. */
FUNCTION HcIsDbfFile( cFile )
   IF ValType( cFile ) != "C" .OR. Len( cFile ) < 4
      RETURN .F.
   ENDIF
RETURN Upper( Right( cFile, 4 ) ) == ".DBF"

/* name without directory or extension, in upper case: "C:\a\CLI.DBF" ->
 * "CLI". NOTE: in this Harbour DBF() returns the name WITHOUT the extension
 * (and the alias when the area was renamed), so the comparison is done on the
 * stem and alias by alias. */
STATIC FUNCTION HcStem( cFile )
   LOCAL c := AllTrim( cFile )
   IF Rat( "\", c ) > 0
      c := SubStr( c, Rat( "\", c ) + 1 )
   ENDIF
   IF Rat( "/", c ) > 0
      c := SubStr( c, Rat( "/", c ) + 1 )
   ENDIF
   IF Rat( ".", c ) > 0
      c := Left( c, Rat( ".", c ) - 1 )
   ENDIF
RETURN Upper( c )

/* Refresh the list of the *.DBF that are open in a work area. It is done once
 * per full repaint (CoreAreas() walks the work areas, so it is not something
 * to call per painted row). */
STATIC PROCEDURE HcRefreshOpenDbs()
   LOCAL a, i
   s_aHcOpen := {}
#ifndef BP_HC_STANDALONE
   a := CoreAreas()
   FOR i := 1 TO Len( a )
      /* [2] = alias, [3] = DBF() (name without extension, or the alias when
       * the area was renamed): both stems are accepted */
      AAdd( s_aHcOpen, HcStem( a[ i ][ 3 ] ) )
      AAdd( s_aHcOpen, HcStem( a[ i ][ 2 ] ) )
   NEXT
#endif
RETURN

/* .T. when that *.DBF is open in a work area right now. Without bp_core.prg
 * (the headless bank of tests) nothing is ever reported as open. */
STATIC FUNCTION HcIsOpenDb( cName )
   LOCAL cStem := HcStem( cName )
   IF Empty( cStem ) .OR. Empty( s_aHcOpen )
      RETURN .F.
   ENDIF
RETURN AScan( s_aHcOpen, {| c | c == cStem } ) > 0

/* repaints only the rows the cursor left and reached (no full redraw). T2: a
 * tree panel repaints its tree rows from HC_P_TSEL/HC_P_TTOP, with the same
 * two-row optimisation, so the caller hands in the slots of the view in use
 * (HcRepaint() of the loop already takes them from the panel it paints). */
STATIC PROCEDURE HcRepaint( nOldSel, nOldTop )
   LOCAL aP := HcPanelActive(), nRow, lTree := HcPanelTree( aP )
   LOCAL nSel := iif( lTree, aP[ HC_P_TSEL ], aP[ HC_P_SEL ] )
   LOCAL nTop := iif( lTree, aP[ HC_P_TTOP ], aP[ HC_P_TOP ] )
   IF nSel == nOldSel .AND. nTop == nOldTop
      RETURN
   ENDIF
   UiPaintBegin()
   IF nTop != nOldTop
      IF lTree
         HcTreeDrawRows( HcActive(), HC_ROW_FIRST, HC_ROW_LAST )
      ELSE
         HcDrawRows( HcActive(), HC_ROW_FIRST, HC_ROW_LAST )
      ENDIF
   ELSE
      nRow := HC_ROW_FIRST + ( nOldSel - nTop )
      IF nRow >= HC_ROW_FIRST .AND. nRow <= HC_ROW_LAST
         IF lTree
            HcTreeDrawRows( HcActive(), nRow, nRow )
         ELSE
            HcDrawRow( HcActive(), nRow )
         ENDIF
      ENDIF
      nRow := HC_ROW_FIRST + ( nSel - nTop )
      IF nRow >= HC_ROW_FIRST .AND. nRow <= HC_ROW_LAST
         IF lTree
            HcTreeDrawRows( HcActive(), nRow, nRow )
         ELSE
            HcDrawRow( HcActive(), nRow )
         ENDIF
      ENDIF
   ENDIF
   /* the status row describes the entry under the cursor, so it follows it */
   HcDrawStatus()
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()
   HcCaretOn()
RETURN

/* all the rows of a panel, used when a mask changes many marks at once */
STATIC PROCEDURE HcPaintRows( nId )
   UiPaintBegin()
   IF HcPanelTree( HcPanel( nId ) )
      HcTreeDrawRows( nId, HC_ROW_FIRST, HC_ROW_LAST )
   ELSE
      HcDrawRows( nId, HC_ROW_FIRST, HC_ROW_LAST )
   ENDIF
   HcDrawStatus()
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()
   HcCaretOn()
RETURN

/* =====================================================================
 *  Panel rectangles (Ctrl-O zoom changes them)
 * ===================================================================== */

STATIC FUNCTION HcPanelVisible( nId )
   IF ! s_lZoom
      RETURN .T.
   ENDIF
RETURN nId == HcActive()

/* the panel columns of one panel: { left, right }. Public so the headless
 * bank can pin the geometry invariants (S14: the frames of the two panels are
 * contiguous, and the width is derived from the canvas). */
FUNCTION HcPanelCols( nId )
RETURN { HcPanelL( nId ), HcPanelR( nId ) }

STATIC FUNCTION HcPanelL( nId )
   IF s_lZoom
      RETURN HC_LL
   ENDIF
RETURN iif( nId == HC_PANEL_L, HC_LL, HC_RL )

STATIC FUNCTION HcPanelR( nId )
   IF s_lZoom
      RETURN HC_RR
   ENDIF
RETURN iif( nId == HC_PANEL_L, HC_LR, HC_RR )

/* =====================================================================
 *  Small helpers
 * ===================================================================== */

/* the date of an entry as 10 stable characters (yyyy-mm-dd). It accepts both
 * a Harbour date and the timestamp hb_vfDirectory() returns, and it does not
 * depend on the SET DATE FORMAT of the process. */
STATIC FUNCTION HcDateStr( xDate )
   LOCAL d
   IF ValType( xDate ) == "T"
      d := hb_TToD( xDate )
   ELSEIF ValType( xDate ) == "D"
      d := xDate
   ELSE
      RETURN Space( HC_DATE_W )
   ENDIF
   IF Empty( d )
      RETURN Space( HC_DATE_W )
   ENDIF
/* L24 of hc-commander.md: DD/MM/YY (8 cells), as the user asked; the year
 * keeps 2 digits */
RETURN StrZero( Day( d ), 2 ) + "/" + StrZero( Month( d ), 2 ) + "/" + ;
       SubStr( StrZero( Year( d ), 4 ), 3, 2 )

/* S15: the time column, always HH:MM in 24 hours. Measured on this Harbour:
 * hb_DirScan()/hb_vfDirectory() hand over the DATE as a "T" timestamp and the
 * TIME as a string "HH:MM:SS", so that string is what the entries keep. An
 * empty or unexpected value gives blanks, which is what the `..` entry shows.
 * NOTE: Hour()/Minute() are NOT available in this build (no hbct/xhb), so a
 * timestamp is not accepted here; it is not needed either. */
FUNCTION HcTimeStr( xTime )
   LOCAL c := "", aPart
   IF ValType( xTime ) != "C"
      RETURN Space( HC_TIME_W )
   ENDIF
   c := AllTrim( xTime )
   IF Empty( c )
      RETURN Space( HC_TIME_W )
   ENDIF
   IF ":" $ c
      aPart := hb_ATokens( c, ":" )
      IF Len( aPart ) >= 2
         RETURN StrZero( Val( aPart[ 1 ] ), 2 ) + ":" + StrZero( Val( aPart[ 2 ] ), 2 )
      ENDIF
   ENDIF
   /* a bare number is taken as HHMMSS */
   c := StrZero( Val( c ), 6 )
RETURN Left( c, 2 ) + ":" + SubStr( c, 3, 2 )

/* DOS wildcard match on two already upper-cased strings: `?` is one
 * character, `*` is any run of them */
STATIC FUNCTION HcWildMatch( cMask, cName )
   LOCAL i := 1, j := 1, nStar := 0, nMatch := 0
   LOCAL cM, cN
   DO WHILE j <= Len( cName )
      cM := iif( i <= Len( cMask ), SubStr( cMask, i, 1 ), "" )
      cN := SubStr( cName, j, 1 )
      IF ! Empty( cM ) .AND. ( cM == "?" .OR. cM == cN )
         i++
         j++
      ELSEIF cM == "*"
         nStar := i
         nMatch := j
         i++
      ELSEIF nStar > 0
         /* backtrack: the star swallows one more character */
         i := nStar + 1
         nMatch++
         j := nMatch
      ELSE
         RETURN .F.
      ENDIF
   ENDDO
   DO WHILE i <= Len( cMask ) .AND. SubStr( cMask, i, 1 ) == "*"
      i++
   ENDDO
RETURN i > Len( cMask )

/* =====================================================================
 *  Text buffer helpers of the viewer/editor (S5)
 *
 *  They are pure functions on strings and arrays, so the headless bank can
 *  check the round trip without touching a disk.
 * ===================================================================== */

/* text -> array of lines. CRLF and a lone CR become LF, the empty lines in the
 * middle are KEPT and the newline that ends the file does not add an extra
 * empty line. An empty text is one empty line (a file always has a line). */
FUNCTION HcSplitLines( cText )
   LOCAL a := {}, c, n
   IF ValType( cText ) != "C"
      RETURN { "" }
   ENDIF
   c := StrTran( cText, Chr( 13 ) + Chr( 10 ), Chr( 10 ) )
   c := StrTran( c, Chr( 13 ), Chr( 10 ) )
   IF ! Empty( c ) .AND. Right( c, 1 ) == Chr( 10 )
      c := Left( c, Len( c ) - 1 )
   ENDIF
   IF Empty( c )
      AAdd( a, "" )
      RETURN a
   ENDIF
   DO WHILE .T.
      n := At( Chr( 10 ), c )
      IF n == 0
         EXIT
      ENDIF
      AAdd( a, Left( c, n - 1 ) )
      c := SubStr( c, n + 1 )
   ENDDO
   AAdd( a, c )
RETURN a

/* array of lines -> text with the line separator of this OS (CRLF on
 * Windows), every line terminated: that is what upstream writes and what makes
 * HcSplitLines( HcJoinLines( a ) ) give the same array back */
FUNCTION HcJoinLines( aLines )
   LOCAL c := "", i
   IF ! HB_ISARRAY( aLines )
      RETURN ""
   ENDIF
   FOR i := 1 TO Len( aLines )
      c += aLines[ i ] + hb_eol()
   NEXT
RETURN c

/* A text file has no control characters other than TAB, CR and LF. The test
 * is 29 At() calls (fast C scans) instead of a character by character loop
 * over a buffer of up to HE_MAXSIZE bytes. */
/* S60: .T. when the file has BINARY content, so the viewer and the editor refuse
 * it instead of painting garbage. MEASURED, and the reason this is not just
 * "any control byte":
 *   - a DOS text file may END with Ctrl-Z (0x1A, the old end-of-file marker) and
 *     Spanish text is full of bytes >= 128 (Latin-1 accents), so NEITHER is a
 *     sign of a binary file any more (before, a .TXT ending in ^Z opened the
 *     viewer and it said "Binary file", which is a lie);
 *   - tab, LF and CR are text;
 *   - any OTHER byte below 32 is binary. This keeps the original BRO.INI (which
 *     starts with 20 4E 16 00 and carries NULs: it is a packed config, NOT a
 *     text .ini) correctly refused.
 * The trailing ^Z is dropped when the file is read (HcReadText), so it is never
 * painted. */
FUNCTION HcIsBinaryText( cText )
   LOCAL i
   IF ValType( cText ) != "C"
      RETURN .F.
   ENDIF
   FOR i := 0 TO 31
      IF i != 9 .AND. i != 10 .AND. i != 13 .AND. i != 26
         IF At( Chr( i ), cText ) > 0
            RETURN .T.
         ENDIF
      ENDIF
   NEXT
RETURN .F.

/* =====================================================================
 *  Chrome rows of the file manager (T2)
 * ===================================================================== */

/* S70: the STATUS row of the manager, built as a TABLE. Every field has a
 * FIXED width, so the size, the date and the time never move when the name of
 * the entry under the cursor changes length (reported by the user: the row has
 * to be read in columns).
 *
 *   1-2    two leading columns (L27)
 *   3-42   name       HC_ST_NAME_W, cut with "..." when it does not fit
 *   43-52  size       HC_SIZE_W, right-aligned ("DIR" for a directory)
 *   53-58  unit       HC_ST_UNIT_W: " bytes" for a file, blanks for a directory
 *   59     separator
 *   60-67  date       HC_DATE_W (DD/MM/YY)
 *   68     separator
 *   69-73  time       HC_TIME_W (HH:MM), blanks for the [..] entry
 *   74     separator
 *   75-82  "[marked]" HC_ST_FLAG_W, blanks when the entry is not marked
 *   83..   "   |   N marked, X bytes" when the panel has marks (S41)
 *
 * The answer is ALWAYS nWidth cells long. Pure (aEntry and aList are plain
 * arrays), so the headless bank pins the columns. */
FUNCTION HcStatusText( aEntry, aList, nWidth )
   LOCAL cName := "", cSize, cUnit := Space( HC_ST_UNIT_W )
   LOCAL cDate, cTime, cFlag, c, nMarked := 0, nBytes := 0
   DEFAULT nWidth TO UiCols()
   IF HB_ISARRAY( aEntry )
      cName := aEntry[ HC_E_NAME ]
      IF ValType( cName ) != "C"
         cName := ""
      ENDIF
      IF cName == ".."
         cName := "[..]"
      ENDIF
      IF Len( cName ) > HC_ST_NAME_W
         /* a cut name keeps its beginning and SAYS it was cut: a silent
          * truncation would hide which file this is */
         cName := Left( cName, HC_ST_NAME_W - 3 ) + "..."
      ENDIF
      IF HcIsDir( aEntry )
         cSize := PadL( "DIR", HC_SIZE_W )
      ELSE
         cSize := PadL( HcSizeText( aEntry[ HC_E_SIZE ] ), HC_SIZE_W )
         cUnit := PadR( " bytes", HC_ST_UNIT_W )
      ENDIF
      cDate := PadR( HcDateStr( aEntry[ HC_E_DATE ] ), HC_DATE_W )
      cTime := PadR( HcEntryTime( aEntry ), HC_TIME_W )
      IF cName == "[..]"
         cDate := Space( HC_DATE_W )
         cTime := Space( HC_TIME_W )
      ENDIF
      cFlag := PadR( iif( Len( aEntry ) >= HC_E_MARK .AND. aEntry[ HC_E_MARK ], ;
                          "[marked]", "" ), HC_ST_FLAG_W )
   ELSE
      cSize := Space( HC_SIZE_W )
      cDate := Space( HC_DATE_W )
      cTime := Space( HC_TIME_W )
      cFlag := Space( HC_ST_FLAG_W )
   ENDIF
   c := "  " + PadR( Left( cName, HC_ST_NAME_W ), HC_ST_NAME_W ) + cSize + cUnit + ;
        " " + cDate + " " + cTime + " " + cFlag
   nMarked := HcMarkedCount( aList )
   IF nMarked > 0
      /* S41: the marks also carry the bytes they add up: a marked directory
       * counts as zero, so the number is always the size of the FILES marked */
      nBytes := HcMarkedBytes( aList )
      c += "   |   " + LTrim( Str( nMarked ) ) + " marked, " + ;
           HcSizeText( nBytes ) + " bytes"
   ENDIF
RETURN PadR( Left( c, nWidth ), nWidth )

/* status row: the entry under the cursor of the ACTIVE panel and how many
 * entries are marked, in the fixed columns of HcStatusText(), or the temporary
 * notice of a copy (L6) while it is alive. The whole row is cleared first so a
 * shorter line never leaves the tail of the previous one on screen. */
STATIC PROCEDURE HcDrawStatus()
   LOCAL aP := HcPanelActive(), aE := NIL, nIdx, nW := UiCols(), c, cFlash
   SetColor( UI_C_HINT )
   /* the whole row, in its own colour, before the text: nothing of the
    * previous frame can survive past the end of the line */
   @ HC_STATUS, 0 SAY Space( nW )
   /* L27: the text of this row starts TWO columns in (the user asked for one
    * more column than the single leading space it had) */
   IF s_lHcFindOn
      /* S13.3: the incremental search OWNS the row while it is open:
       * "Search: <pattern>" and a block caret right after it, in the colour of
       * the row (a black block over the cyan band); the tail stays blanked
       * with the spaces written above. */
      c := " " + HC_FIND_TAG + s_cHcFindPat
      IF Len( c ) > nW - 1
         c := Left( c, nW - 1 )
      ENDIF
      @ HC_STATUS, 0 SAY c
      @ HC_STATUS, Len( c ) SAY Chr( 219 )
      /* the search owns the row, so no notice is shown while it is open */
      s_cHcFlashShown := ""
      SetColor( UI_C_DESKTOP )
      RETURN
   ENDIF
   /* L6: the temporary notice of a copy, if it is still alive. Same row, same
    * UI_C_HINT pair and the same column the entry text uses (two leading
    * cells), and a message that does not fit is CUT to the row - never
    * wrapped and never pushed into the bar. */
   cFlash := HcFlashText( s_cHcFlash, s_nHcFlashUntil, hb_MilliSeconds() )
   s_cHcFlashShown := cFlash
   IF ! Empty( cFlash )
      @ HC_STATUS, 0 SAY Left( "  " + cFlash, nW )
      SetColor( UI_C_DESKTOP )
      RETURN
   ENDIF
   nIdx := aP[ HC_P_SEL ]
   /* T2: a tree panel says which folder the tree cursor is on (S2/S9) instead
    * of describing a listing it does not have */
   IF HcPanelTree( aP )
      @ HC_STATUS, 0 SAY HcTreeStatusText( aP[ HC_P_NODES ], HcTreeCurrent( aP ), nW )
      SetColor( UI_C_DESKTOP )
      RETURN
   ENDIF
   IF ! Empty( aP[ HC_P_LIST ] ) .AND. nIdx >= 1 .AND. nIdx <= Len( aP[ HC_P_LIST ] )
      aE := aP[ HC_P_LIST ][ nIdx ]
   ENDIF
   @ HC_STATUS, 0 SAY HcStatusText( aE, aP[ HC_P_LIST ], nW )
   SetColor( UI_C_DESKTOP )
RETURN

STATIC FUNCTION HcSizeText( nSize )
   IF ValType( nSize ) != "N"
      RETURN "0"
   ENDIF
RETURN LTrim( Str( nSize ) )

/* S41: the bytes of the marked entries of a panel listing. A marked DIRECTORY
 * adds NOTHING (its size is not the size of what it holds, and the user asked
 * for exactly that), and the ".." entry is never counted. Pure, so the headless
 * bank can pin the rule. */
FUNCTION HcMarkedBytes( aList )
   LOCAL i, aE, n := 0
   IF ! HB_ISARRAY( aList )
      RETURN 0
   ENDIF
   FOR i := 1 TO Len( aList )
      aE := aList[ i ]
      IF HB_ISARRAY( aE ) .AND. aE[ HC_E_MARK ] .AND. ;
         aE[ HC_E_NAME ] != ".." .AND. ! HcIsDir( aE )
         IF ValType( aE[ HC_E_SIZE ] ) == "N"
            n += aE[ HC_E_SIZE ]
         ENDIF
      ENDIF
   NEXT
RETURN n

/* how many entries of a LISTING are marked. It takes the listing (HC_P_LIST),
 * not the panel, so the status row can be pinned by the headless bank. */
STATIC FUNCTION HcMarkedCount( aList )
   LOCAL i, n := 0
   IF ! HB_ISARRAY( aList )
      RETURN 0
   ENDIF
   FOR i := 1 TO Len( aList )
      IF HB_ISARRAY( aList[ i ] ) .AND. Len( aList[ i ] ) >= HC_E_MARK .AND. ;
         aList[ i ][ HC_E_MARK ]
         n++
      ENDIF
   NEXT
RETURN n

/* Prompt of the command line: the directory of the active panel and ">" (the
 * same prompt upstream builds on Windows). A path that does not fit is cut from the
 * left, so the last directory is still readable. */
STATIC FUNCTION HcCmdPrompt( cDir )
   LOCAL c := cDir + ">"
   LOCAL nMax := Max( 8, MaxCol() + 1 - 12 )
   IF Len( c ) > nMax
      c := "..." + Right( c, nMax - 3 )
   ENDIF
RETURN c

/* Horizontal scroll of the command line: how many leading characters of the
 * typed text are hidden so the caret is always on screen. */
STATIC FUNCTION HcCmdOffset( aP )
   LOCAL nAvail := MaxCol() + 1 - Len( HcCmdPrompt( aP[ HC_P_DIR ] ) )
   LOCAL nLen := Len( aP[ HC_P_CMD ] )
   IF nAvail < 1 .OR. nLen <= nAvail
      RETURN 0
   ENDIF
RETURN Min( Max( 0, aP[ HC_P_CMDCOL ] - nAvail + 1 ), nLen - nAvail )

STATIC PROCEDURE HcDrawCmd()
   LOCAL aP := HcPanelActive(), cPrompt := HcCmdPrompt( aP[ HC_P_DIR ] )
   LOCAL nW := UiCols(), nOff := HcCmdOffset( aP )
   /* the prompt and the typed command start TWO columns in (L27: the user
    * asked for one more column; it used to be flush with the left border) */
   LOCAL nPad := 2
   LOCAL nAvail := Max( 0, nW - Len( cPrompt ) - nPad )
   LOCAL cShow := SubStr( aP[ HC_P_CMD ], nOff + 1, nAvail )
   SetColor( UI_C_STATUSBAR )
   /* PadR() does not truncate: the row is written with EXACTLY nW cells */
   @ HC_CMD, 0 SAY PadR( Space( nPad ) + Left( cPrompt + cShow, nW - nPad ), nW )
   SetColor( UI_C_DESKTOP )
RETURN

/* leaves the system caret in the command line at its position. It runs AFTER
 * UiPaintEnd(), because the paint block hides the caret and restores it. */
STATIC PROCEDURE HcCaretOn()
   LOCAL aP, nCol
   IF s_lHcFindOn
      /* while the incremental search is open ITS block caret is the caret:
       * the system one stays hidden */
      SetCursor( 0 )
      RETURN
   ENDIF
   aP := HcPanelActive()
   /* +2: the prompt of HcDrawCmd() starts two columns in (L27) */
   nCol := 2 + Len( HcCmdPrompt( aP[ HC_P_DIR ] ) ) + aP[ HC_P_CMDCOL ] - HcCmdOffset( aP )
   SetCursor( 1 )
   DevPos( HC_CMD, Max( 0, Min( nCol, MaxCol() ) ) )
RETURN

/* the ten slots of upstream's bar, in their order. The ninth one is `PullDn`
 * from the image of L12 on: pulling down the menu bar is what F9 does now.
 * Slot 2 is the DB MANAGER: it used to be the panel zoom, which kept its own
 * key (Ctrl-O) and every menu row that announces it. */
STATIC FUNCTION HcBarLabels()
RETURN { "Help", "DbMgr", "View", "Edit", "Copy", "RenMov", "MkDir", "Delete", "PullDn", "Quit" }

/* the key each slot stands for */
STATIC FUNCTION HcBarKeys()
RETURN { K_F1, K_F2, K_F3, K_F4, K_F5, K_F6, K_F7, K_F8, K_F9, K_F10 }

/* width of one slot: the ten slots spread over the canvas */
STATIC FUNCTION HcBarSlotW()
RETURN Max( 6, Int( ( MaxCol() + 1 ) / HC_BAR_SLOTS ) )

STATIC PROCEDURE HcDrawBar()
   LOCAL aL := HcBarLabels(), nW := HcBarSlotW(), i, nCol, nLen
   SetColor( UI_C_MENUBAR )
   /* the whole row in the bar colour first, so the slots never leave a
    * character of the previous frame past the last label */
   @ HC_BAR, 0 SAY Space( UiCols() )
   FOR i := 1 TO Len( aL )
      nCol := ( i - 1 ) * nW
      IF nCol + 3 > MaxCol()
         EXIT
      ENDIF
      /* L28: the slot key reads F1..F10 (it used to be 1..10) and it is
       * painted with the SAME colour as the hot key of the menu bar above
       * (UI_C_HOT, yellow over cyan), so it reads as the first cell of the
       * chip instead of a separate number */
      SetColor( UI_C_HOT )
      @ HC_BAR, nCol SAY PadL( "F" + LTrim( Str( i ) ), 3 )
      /* L27: the label is a CHIP with its own background colour, exactly like
       * the labels of the menu bar above (UI_C_MENULBL, black over cyan). One
       * column of the bar colour stays between chips so they do not touch. */
      SetColor( UI_C_MENULBL )
      nLen := Min( nW - 4, MaxCol() + 1 - nCol - 4 )
      @ HC_BAR, nCol + 3 SAY PadR( aL[ i ], Max( 0, nLen ) )
   NEXT
   SetColor( UI_C_DESKTOP )
RETURN

/* slot (1..HC_BAR_SLOTS) of the bar under a column, 0 when there is none */
STATIC FUNCTION HcBarSlotAt( nCol )
   LOCAL n := Int( nCol / HcBarSlotW() ) + 1
   IF n < 1 .OR. n > HC_BAR_SLOTS
      RETURN 0
   ENDIF
RETURN n

/* =====================================================================
 *  Command line: editing, history and running (T2)
 * ===================================================================== */

/* .T. while the command line is in use: it has text, or the user is walking
 * the history (so Up/Down keep recalling instead of moving the panel) */
STATIC FUNCTION HcCmdBusy( aP )
RETURN ! Empty( aP[ HC_P_CMD ] ) .OR. s_nHcHist > 0

STATIC PROCEDURE HcCmdClear( aP )
   aP[ HC_P_CMD ] := ""
   aP[ HC_P_CMDCOL ] := 0
   s_nHcHist := 0
RETURN

STATIC FUNCTION HcCmdInsert( aP, cText )
   LOCAL nPos := aP[ HC_P_CMDCOL ]
   IF Empty( cText )
      RETURN .F.
   ENDIF
   aP[ HC_P_CMD ] := Stuff( aP[ HC_P_CMD ], nPos + 1, 0, cText )
   aP[ HC_P_CMDCOL ] := Min( Len( aP[ HC_P_CMD ] ), nPos + Len( cText ) )
RETURN .T.

STATIC FUNCTION HcCmdMove( aP, nDir )
   LOCAL nPos := Max( 0, Min( aP[ HC_P_CMDCOL ] + nDir, Len( aP[ HC_P_CMD ] ) ) )
   IF nPos == aP[ HC_P_CMDCOL ]
      RETURN .F.
   ENDIF
   aP[ HC_P_CMDCOL ] := nPos
RETURN .T.

/* Home, End, Ctrl-Left and Ctrl-Right inside the command line: the caret goes
 * to the given cell (0 = before the first character, Len() = after the last
 * one) and the key is CONSUMED. Out of the line (.F.) the key keeps its panel
 * meaning, so Home/End still jump the listing when nothing is typed. */
STATIC FUNCTION HcCmdCaret( aP, nPos )
   IF ! HcCmdBusy( aP )
      RETURN .F.
   ENDIF
   aP[ HC_P_CMDCOL ] := Max( 0, Min( nPos, Len( aP[ HC_P_CMD ] ) ) )
RETURN .T.

STATIC FUNCTION HcCmdBack( aP )
   LOCAL nPos := aP[ HC_P_CMDCOL ]
   IF nPos < 1
      RETURN .F.
   ENDIF
   aP[ HC_P_CMD ] := Stuff( aP[ HC_P_CMD ], nPos, 1, "" )
   aP[ HC_P_CMDCOL ] := nPos - 1
RETURN .T.

STATIC FUNCTION HcCmdDel( aP )
   LOCAL nPos := aP[ HC_P_CMDCOL ]
   IF nPos >= Len( aP[ HC_P_CMD ] )
      RETURN .F.
   ENDIF
   aP[ HC_P_CMD ] := Stuff( aP[ HC_P_CMD ], nPos + 1, 1, "" )
RETURN .T.

/* the history never stores an empty line nor the line that is already the
 * last one, so pressing Enter twice does not fill it with copies */
STATIC PROCEDURE HcHistAdd( cLine )
   LOCAL c := AllTrim( cLine )
   IF Empty( c )
      RETURN
   ENDIF
   IF ! Empty( s_aHcHist ) .AND. s_aHcHist[ Len( s_aHcHist ) ] == c
      RETURN
   ENDIF
   AAdd( s_aHcHist, c )
   IF Len( s_aHcHist ) > HC_HIST_MAX
      ADel( s_aHcHist, 1 )
      /* ADel() leaves a NIL at the end: the array has to be shrunk */
      ASize( s_aHcHist, Len( s_aHcHist ) - 1 )
   ENDIF
   s_nHcHist := 0
RETURN

/* Up (-1) walks to older lines, Down (1) to newer ones; past the newest the
 * line is empty again and the panel gets Up/Down back */
STATIC PROCEDURE HcHistGet( aP, nDir )
   LOCAL n := Len( s_aHcHist )
   IF n < 1
      RETURN
   ENDIF
   IF nDir < 0
      s_nHcHist := iif( s_nHcHist == 0, n, Max( 1, s_nHcHist - 1 ) )
   ELSE
      s_nHcHist := iif( s_nHcHist >= n, 0, s_nHcHist + 1 )
   ENDIF
   IF s_nHcHist == 0
      aP[ HC_P_CMD ] := ""
      aP[ HC_P_CMDCOL ] := 0
   ELSE
      aP[ HC_P_CMD ] := s_aHcHist[ s_nHcHist ]
      aP[ HC_P_CMDCOL ] := Len( aP[ HC_P_CMD ] )
   ENDIF
RETURN

/* Enter on a non-empty command line: a line that names an existing file of the
 * active panel runs it directly, anything else goes through the shell like upstream
 * does. The line goes to the history and the prompt is cleared. */
STATIC PROCEDURE HcRunCmd( aP )
   LOCAL c := AllTrim( aP[ HC_P_CMD ] ), cFull
   IF Empty( c )
      RETURN
   ENDIF
   /* S3: a linked panel runs nothing. Its HC_P_DIR is a path of the PEER, so
    * handing it to hb_run() would look for a file of the other machine on this
    * disk (and the fallback would run the line in a local shell, which is not
    * what a remote panel promises). */
   IF HcLinkGuard()
      RETURN
   ENDIF
   HcHistAdd( c )
   HcCmdClear( aP )
   cFull := HcJoinPath( aP[ HC_P_DIR ], c )
   BEGIN SEQUENCE WITH {| e | Break( e ) }
      IF hb_vfExists( cFull )
         hb_run( Chr( 34 ) + cFull + Chr( 34 ) )
      ELSE
         hb_processRun( hb_GetEnv( "COMSPEC" ) + " /c " + c )
      ENDIF
   RECOVER
      UiErr( "Cannot run:" + hb_eol() + c, BP_APPNAME )
   END SEQUENCE
RETURN

/* =====================================================================
 *  Mouse (T2): wheel and clicks
 *
 *  GTWVG of this Harbour delivers neither the wheel nor the clicks through
 *  Inkey(); bp_win32.c hooks the driver window and records them, and here they
 *  are polled next to the key wait, exactly like the dot prompt does. The C
 *  helper reports a click on the 80x25 grid IT was written for, so the cell of
 *  THIS canvas is recovered proportionally from the centre of the reported
 *  cell (that is why a click is accurate to about two rows).
 * ===================================================================== */

STATIC FUNCTION HcMouseHook( lOn )
   LOCAL lOk := .F.
#ifndef BP_HC_STANDALONE
   lOk := DotMouseHook( lOn )
#endif
RETURN lOk

STATIC FUNCTION HcMouseWheel()
   LOCAL n := 0
#ifndef BP_HC_STANDALONE
   n := DotMouseWheel()
#endif
RETURN n

STATIC FUNCTION HcMouseClickRow()
   LOCAL n := -1
#ifndef BP_HC_STANDALONE
   n := DotMouseClickRow()
#endif
RETURN n

STATIC FUNCTION HcMouseClickCol()
   LOCAL n := -1
#ifndef BP_HC_STANDALONE
   n := DotMouseClickCol()
#endif
RETURN n

/* S32: .T. when the last click was made with SHIFT held (range selection) */
STATIC FUNCTION HcMouseClickShift()
   LOCAL l := .F.
#ifndef BP_HC_STANDALONE
   l := W32ClickShift()
#endif
RETURN l

/* S39: .T. when the click just collected was the second of a double click */
STATIC FUNCTION HcMouseClickDbl()
   LOCAL l := .F.
#ifndef BP_HC_STANDALONE
   l := W32ClickDbl()
#endif
RETURN l

/* S39: identity of the entry a click lands on: the generation of the listing,
 * the panel and the NAME of the entry. "" when the click did not land on an
 * entry (a bar, the header, outside a panel). */
FUNCTION HcClickId( nGen, nId, cName )
   IF ValType( nGen ) != "N" .OR. ValType( nId ) != "N" .OR. ;
      ValType( cName ) != "C" .OR. Len( cName ) == 0
      RETURN ""
   ENDIF
RETURN Str( nGen, 10, 0 ) + "/" + Str( nId, 2, 0 ) + "/" + cName

/* S39: was this click the SECOND one of a double click? The window hook says
 * only "another click on the same ROW within the double click time"; the pair is
 * real only when both clicks landed on the same ENTRY of the same listing, so
 * navigating with one click and then shooting that row again is a plain click.
 * It also remembers this click for the next one. */
FUNCTION HcClickPair( lDbl, cId )
   LOCAL lPair := .F.
   IF ValType( cId ) == "C" .AND. Len( cId ) > 0
      lPair := ( lDbl == .T. .AND. cId == s_cHcClickId )
   ENDIF
   s_cHcClickId := iif( ValType( cId ) == "C", cId, "" )
RETURN lPair

/* S39: forgets the pending click pair (a new screen, the headless bank) */
FUNCTION HcClickReset()
   s_cHcClickId := ""
RETURN NIL

/* S39: the key a mouse click turns into: a double click on a listed row is
 * exactly the Enter key on that entry (open the .DBF, enter the directory, run
 * the file), so it goes through the same dispatch as the keyboard and the mouse
 * cannot diverge from it. 0 = the click was handled as a gesture, no key. */
FUNCTION HcClickKey( lDbl, nRow )
   IF lDbl .AND. ValType( nRow ) == "N" .AND. ;
      nRow >= HC_ROW_FIRST .AND. nRow <= HC_ROW_LAST
      RETURN K_ENTER
   ENDIF
RETURN 0

/* S33: .T. when the last click was made with CTRL held (mark/unmark one entry) */
STATIC FUNCTION HcMouseClickCtrl()
   LOCAL l := .F.
#ifndef BP_HC_STANDALONE
   l := W32ClickCtrl()
#endif
RETURN l

/* S37: right button drag. bp_win32.c follows the button while it is held and
 * hands the PRESS/MOVE steps and the RELEASE over separately, so a gesture that
 * ends between two polls cannot lose its UP.
 * The four wrappers below are PUBLIC (HcCtxRight*) because the Browse edit of
 * bp_core.prg needs the same channel for its context menu, and the guard that
 * answers "nothing happened" in the headless banks has to exist ONCE. */
STATIC FUNCTION HcMouseRightStep()
RETURN HcCtxRightStep()

STATIC FUNCTION HcMouseRightUp()
RETURN HcCtxRightUp()

/* S38: milliseconds since the physical press (0 outside a gesture) */
STATIC FUNCTION HcMouseRightPressMs()
   LOCAL n := 0
#ifndef BP_HC_STANDALONE
   n := W32RPRESSMS()
#endif
RETURN n

/* S38: how long the button has been held, in seconds. It is taken from the
 * message itself when the window hook is there, so the up to 50 ms wait of the
 * poll does not add to the hold; the Seconds() tick is the fallback. */
STATIC FUNCTION HcHoldElapsed()
   LOCAL nMs := HcMouseRightPressMs()
   IF nMs > 0
      RETURN nMs / 1000
   ENDIF
RETURN Seconds() - s_nHcDragTick

STATIC FUNCTION HcMouseRightRow()
RETURN HcCtxRightRow()

STATIC FUNCTION HcMouseRightCol()
RETURN HcCtxRightCol()

/* S37: a step (the press or a move with the button held) waiting in the channel
 * of bp_win32.c. Recorded and consumed when read, so it can never be handled
 * twice. */
FUNCTION HcCtxRightStep()
   LOCAL l := .F.
#ifndef BP_HC_STANDALONE
   l := ( W32RMOUSESTEP() != 0 )
#endif
RETURN l

/* S37: the release of the right button waiting in the channel, consumed here */
FUNCTION HcCtxRightUp()
   LOCAL l := .F.
#ifndef BP_HC_STANDALONE
   l := ( W32RMOUSEUP() != 0 )
#endif
RETURN l

/* S5/S6 of browse-edit-mouse.md: the canvas CELL of the last step of the right
 * button (-1 when there was none). These two getters do NOT clear themselves,
 * so a screen that already used a press has to forget it with
 * HcCtxRightReset() or it would open its menu again on every idle pass
 * (AGENTS trap 65). */
FUNCTION HcCtxRightRow()
   LOCAL n := -1
#ifndef BP_HC_STANDALONE
   n := W32RMOUSEROW()
#endif
RETURN n

FUNCTION HcCtxRightCol()
   LOCAL n := -1
#ifndef BP_HC_STANDALONE
   n := W32RMOUSECOL()
#endif
RETURN n

/* S5/S6: forget the cell of the last right-button step (the press has been
 * used): without it the same press is read forever. */
PROCEDURE HcCtxRightReset()
#ifndef BP_HC_STANDALONE
   W32RMOUSERESET()
#endif
RETURN

/* right-click-esc (S6): whether the right gesture is STILL a plain click, that
 * is, the press and its release with no move in between. A PEEK, like the cell
 * getters above: the press and the release are read in different passes, so the
 * fact has to survive being read. bp_win32.c owns it because only that side can
 * see a move that came back to the cell of the press. */
FUNCTION HcCtxRightPlain()
   LOCAL l := .F.
#ifndef BP_HC_STANDALONE
   l := ( W32RMOUSEPLAIN() != 0 )
#endif
RETURN l

/* right-click-esc (S3/S4/S6): the whole rule, as a PURE function of the four
 * facts of the channel. Answers { lFire, lArmedOut }: lFire says "one plain
 * click ended in this pass, treat it as one Esc", lArmedOut is what the caller
 * stores for the next poll.
 *   a drag (or a forced close) just ended  -> nothing, and forget it
 *   a plain release and a press was armed  -> FIRE
 *   press and release in the same pass     -> FIRE
 *   a release nobody armed                 -> nothing
 *   a plain press without its release yet  -> arm it
 *   a drag already under way               -> disarm
 *   nothing new this pass                  -> keep the arm as it was */
FUNCTION HcRClickState( lStep, lUp, lPlain, lArmed )
   lStep  := ( lStep  == .T. )
   lUp    := ( lUp    == .T. )
   lPlain := ( lPlain == .T. )
   lArmed := ( lArmed == .T. )
   IF lUp .AND. ! lPlain
      RETURN { .F., .F. }
   ENDIF
   IF lUp .AND. ( lArmed .OR. lStep )
      RETURN { .T., .F. }
   ENDIF
   IF lUp
      RETURN { .F., .F. }
   ENDIF
   IF lStep
      RETURN { .F., lPlain }
   ENDIF
RETURN { .F., lArmed }

/* right-click-esc (S1/S4/S5): one plain right click since the last poll.
 * Drains the channel and answers the verdict of HcRClickState(), so a screen's
 * idle pass can do
 *
 *    IF nKey == 0 .AND. HcMouseRightClick()
 *       nKey := K_ESC
 *    ENDIF
 *
 * and the CASE that already handles Esc stays the only place where Esc acts.
 * The cell is forgotten once it has been consumed (AGENTS trap 65) or the same
 * press would be read on every pass, and the arm is dropped when the gesture
 * fires, so one click is exactly one Esc and holding the button repeats
 * nothing. Screens where the right button already does something (the panels,
 * the Text editor, the Browse edit) never call this: they read the channel
 * themselves, and this feature leaves them alone. */
FUNCTION HcMouseRightClick()
   LOCAL lStep := .F.
   LOCAL lUp, lPlain, aSt
   DO WHILE HcCtxRightStep()
      lStep := .T.
   ENDDO
   lUp    := HcCtxRightUp()
   lPlain := HcCtxRightPlain()
   IF lUp .OR. lStep
      HcCtxRightReset()
   ENDIF
   aSt := HcRClickState( lStep, lUp, lPlain, s_lHcRClickArmed )
   s_lHcRClickArmed := aSt[ 2 ]
RETURN aSt[ 1 ]

/* right-click-esc (S8): whether a plain press is ARMED, that is, seen and still
 * waiting for its release. It is the only way a caller can tell "the gesture is
 * still going" from "nothing happened" (HcMouseRightClick() answers .F. in both
 * cases), and the Browse edit needs it because the cell of the press is gone as
 * soon as the detector consumes it: the decision "this gesture started outside
 * the record grid" cannot be re-derived on the pass that sees the release, so
 * the caller keeps it and has to know when to throw it away. */
FUNCTION HcRClickArmed()
RETURN s_lHcRClickArmed

/* S6 of hc-ctx-menu-clipboard.md: the POINTER cell, with no button pressed.
 * bp_win32.c records every move of the mouse in its own statics (the moves of
 * the right button are a different channel, the one the drag of S37 uses), so
 * this is what makes the highlight of the context menu follow the pointer after
 * the button is released. In the headless banks (-DBP_HC_STANDALONE) there is no
 * window hook and the answers are "no move" / "no cell". */
STATIC FUNCTION HcPointerStep()
   LOCAL l := .F.
#ifndef BP_HC_STANDALONE
   l := ( W32POINTERSTEP() != 0 )
#endif
RETURN l

/* S7 of commander-cleanup.md: the same channel, PUBLIC, because the menus of
 * hwbro.prg (the F1..F9 bar of the Browse edit) live in another module and their
 * highlight has to follow the pointer too. Read them in this order - step, then
 * the cell - like every other caller, so a move cannot slip between the two. */
FUNCTION HcMousePointerStep()
RETURN HcPointerStep()

FUNCTION HcMousePointerRow()
RETURN HcPointerRow()

FUNCTION HcMousePointerCol()
RETURN HcPointerCol()

STATIC FUNCTION HcPointerRow()
   LOCAL n := -1
#ifndef BP_HC_STANDALONE
   n := W32POINTERROW()
#endif
RETURN n

STATIC FUNCTION HcPointerCol()
   LOCAL n := -1
#ifndef BP_HC_STANDALONE
   n := W32POINTERCOL()
#endif
RETURN n

/* S1 of hc-editor-mouse.md: is the LEFT button held right now? The click
 * channel says where the press was; this says whether the gesture is still
 * going, which is what separates a live drag (extend the selection) from a
 * finished click (there is nothing to extend). It is a scalar getter of
 * bp_win32.c, compared against 0 because `IF <number>` kills Harbour
 * (AGENTS trap 59); without the window hook the answer is always "no". */
STATIC FUNCTION HcMouseLeftDown()
   LOCAL l := .F.
#ifndef BP_HC_STANDALONE
   l := ( W32LMOUSEDOWN() != 0 )
#endif
RETURN l

/* S8 of hc-editor-mouse.md: the cell getters of the right-button channel do not
 * clear themselves (the panel reads them while it decides the hold), so the
 * screen that has already consumed a press forgets it explicitly: otherwise the
 * same press would be read again on every idle pass and the editor's context
 * menu would reopen forever. */
STATIC PROCEDURE HcMouseRightReset()
   HcCtxRightReset()
RETURN

/* The same start-of-screen drain, for the right button: the whole gesture of
 * ANOTHER screen (its steps, its release, the cell of the press and the armed
 * plain press of right-click-esc) is forgotten. Without it a right click made
 * in the panel opened Copy / Cut / Paste the moment the editor came up, because
 * the cell getters are a PEEK and the manager never forgets its last press. */
STATIC PROCEDURE HcMouseRightDrain()
   LOCAL lDummy
   DO WHILE HcMouseRightStep()
   ENDDO
   lDummy := HcMouseRightUp()
   HcMouseRightReset()
   s_lHcRClickArmed := .F.
RETURN

/* S102 of hc-editor-mouse.md: forgets a click the screen before left unread in
 * the channel of the window hook. The row, the column and the modifiers are
 * read once each, so draining them is all it takes to start a screen with no
 * pending click (otherwise the caret of the editor would jump, on its first
 * idle pass, to the cell of a click made somewhere else). */
STATIC PROCEDURE HcMouseClickDrain()
   LOCAL x
   x := HcMouseClickRow()
   x := HcMouseClickCol()
   x := HcMouseClickDbl()
   x := HcMouseClickShift()
   x := HcMouseClickCtrl()
RETURN

/* S33: .T. when the key just read was pressed with SHIFT held. Measured on this
 * GTWVG: the key code does not say it, but HB_GTI_KBDSHIFTS does - the same
 * channel HcAltLetter() already uses for ALT (Shift+C -> Inkey() 67 with
 * HB_GTI_KBDSHIFTS = 305 = LSHIFT|SHIFT). A window-hook attempt was tried first
 * and the flag was eaten by an idle pass of the key loop; this is read straight
 * from the state of the key that just arrived. */
STATIC FUNCTION HcKeyShift( nShift )
   LOCAL l := hb_BitAnd( nShift, HB_GTI_KBD_SHIFT ) != 0
#ifndef BP_HC_STANDALONE
   /* measured: for the ARROW keys this GTWVG reports no SHIFT bit and the keys
    * do not reach the window hook, so the live state is the only source */
   l := l .OR. W32ShiftDown()
#endif
RETURN l

/* S7 of hc-clipboard-files.md: one bit of the same HB_GTI_KBDSHIFTS word. The
 * key codes of Ctrl+C and Ctrl+V ARE the ones of PgDn and Ins, so this bit is
 * the only thing that tells them apart (and why the clipboard cases of the key
 * loop run before those two). */
STATIC FUNCTION HcKeyCtrl( nShift )
RETURN hb_BitAnd( nShift, HB_GTI_KBD_CTRL ) != 0

/* S33: marks or unmarks ONE entry of a panel listing (never the ".." entry).
 * Public so the headless bank can pin it; returns .T. when the mark changed. */
FUNCTION HcToggleMarkRow( aList, nIdx )
   LOCAL aE
   IF ! HB_ISARRAY( aList ) .OR. ValType( nIdx ) != "N"
      RETURN .F.
   ENDIF
   IF nIdx < 1 .OR. nIdx > Len( aList )
      RETURN .F.
   ENDIF
   aE := aList[ nIdx ]
   IF ! HB_ISARRAY( aE ) .OR. aE[ HC_E_NAME ] == ".."
      RETURN .F.
   ENDIF
   aE[ HC_E_MARK ] := ! aE[ HC_E_MARK ]
RETURN .T.

/* S46: cursor movement of the active panel, with the SHIFT extension.
 *   plain  -> move and leave the ANCHOR on the row the cursor reached
 *   SHIFT  -> move and TOGGLE every entry the movement ENTERS; the FIRST step of
 *             a run (lRun = .F.) also toggles the row the cursor is standing on,
 *             so the selection starts where you are. Over an entry that was
 *             already selected this DESELECTS it - the user asked for exactly
 *             that: the same Shift+arrows that select must rub a selection out.
 *             ".." is never touched.
 * Returns .T. when the marks changed, so the caller repaints the whole panel. */
STATIC FUNCTION HcCursorMove( aP, nTarget, lShift, lRun )
   LOCAL nOld
   DEFAULT lRun TO .F.
   nOld := aP[ HC_P_SEL ]
   HcCursorTo( aP, nTarget )
   IF Empty( aP[ HC_P_LIST ] )
      s_lHcShiftRun := .F.
      RETURN .F.
   ENDIF
   IF ! lShift
      s_lHcShiftRun := .F.
      s_aHcAnchor[ HcActive() ] := ;
         aP[ HC_P_LIST ][ Min( aP[ HC_P_SEL ], Len( aP[ HC_P_LIST ] ) ) ][ HC_E_NAME ]
      RETURN .F.
   ENDIF
   s_lHcShiftRun := .T.
RETURN HcMarkSweep( aP[ HC_P_LIST ], nOld, aP[ HC_P_SEL ], ! lRun ) > 0

/* S32: marks every entry between two indexes of a panel listing, both ends
 * included, and NEVER the ".." entry. It only ADDS marks (unmarking is the job
 * of Ins, of the + / - masks and of the menu's Deselect group). The indexes are
 * clamped to the listing, so a stale anchor can never blow up. Public so the
 * headless bank can pin it. Returns how many entries changed. */
FUNCTION HcMarkRange( aList, nFrom, nTo )
   LOCAL n, i, nLo, nHi, nDone := 0
   IF ! HB_ISARRAY( aList )
      RETURN 0
   ENDIF
   n := Len( aList )
   IF n < 1
      RETURN 0
   ENDIF
   nLo := Min( Max( 1, Min( nFrom, nTo ) ), n )
   nHi := Min( Max( 1, Max( nFrom, nTo ) ), n )
   FOR i := nLo TO nHi
      IF HB_ISARRAY( aList[ i ] ) .AND. ! ( aList[ i ][ HC_E_NAME ] == ".." )
         IF ! aList[ i ][ HC_E_MARK ]
            aList[ i ][ HC_E_MARK ] := .T.
            nDone++
         ENDIF
      ENDIF
   NEXT
RETURN nDone

/* S46: ONE SHIFT movement toggles the entries it ENTERS, from the row after the
 * old position to the new one (both directions, the destination included); with
 * lFrom = .T. - the FIRST step of a run - the row the cursor was standing on is
 * toggled too, so a selection starts where you are. An entry flips once per
 * press, so a step over an entry that was already SELECTED deselects it. It is
 * the same rule the right-button drag applies cell by cell (S37), now for the
 * keyboard; walking back over the same rows flips them again.
 * ".." is never touched (HcToggleMarkRow refuses it) and a movement that stays
 * on the same row changes nothing. Indexes are clamped to the listing.
 * Public so the headless bank can pin it. Returns how many marks changed. */
FUNCTION HcMarkSweep( aList, nFrom, nTo, lFrom )
   LOCAL i, nStep, n := 0
   DEFAULT lFrom TO .F.
   IF ! HB_ISARRAY( aList )
      RETURN 0
   ENDIF
   IF ValType( nFrom ) != "N" .OR. ValType( nTo ) != "N"
      RETURN 0
   ENDIF
   IF Empty( aList )
      RETURN 0
   ENDIF
   nFrom := Min( Max( 1, nFrom ), Len( aList ) )
   nTo := Min( Max( 1, nTo ), Len( aList ) )
   IF nTo == nFrom
      RETURN 0
   ENDIF
   nStep := iif( nTo > nFrom, 1, -1 )
   i := iif( lFrom, nFrom, nFrom + nStep )
   DO WHILE .T.
      IF HcToggleMarkRow( aList, i )
         n++
      ENDIF
      IF i == nTo
         EXIT
      ENDIF
      i += nStep
   ENDDO
RETURN n

/* S37.6: ONE step of the sweep, from the row that was processed last to the row
 * the pointer reached now. A fast movement makes the window hook skip cells (it
 * keeps only the last one), but the entries it jumped over were still passed
 * under the PRESSED button, so they are toggled too - the user asked exactly
 * for that rule. The entry already processed (nFrom) is not touched again, the
 * ends are clamped to the listing and HcDragToggle() remembers what changed in
 * this gesture. Returns how many marks changed. Public so the bank can pin it. */
FUNCTION HcDragSweep( aList, nFrom, nTo, aDone )
   LOCAL i, nStep, n := 0
   IF ! HB_ISARRAY( aList ) .OR. ! HB_ISARRAY( aDone )
      RETURN 0
   ENDIF
   IF ValType( nFrom ) != "N" .OR. ValType( nTo ) != "N"
      RETURN 0
   ENDIF
   IF nTo == nFrom
      RETURN 0
   ENDIF
   nStep := iif( nTo > nFrom, 1, -1 )
   FOR i := nFrom + nStep TO nTo STEP nStep
      IF HcDragToggle( aList, i, aDone )
         n++
      ENDIF
   NEXT
RETURN n

/* S37: ONE step of a right-button drag over a panel listing. The entry under
 * the pointer is TOGGLED: marked when it was not marked, unmarked when it was
 * (that is the rule the user asked for), and the gesture remembers in aDone the
 * indexes it already touched, so sweeping back and forth cannot flip the same
 * entry twice. The ".." entry is never touched and neither is an index outside
 * the listing. Returns .T. when a mark changed, so the caller knows it has to
 * repaint. Public so the headless bank can pin the rule. */
FUNCTION HcDragToggle( aList, nIdx, aDone )
   LOCAL aE
   IF ! HB_ISARRAY( aList ) .OR. ! HB_ISARRAY( aDone ) .OR. ValType( nIdx ) != "N"
      RETURN .F.
   ENDIF
   IF nIdx < 1 .OR. nIdx > Len( aList )
      RETURN .F.
   ENDIF
   aE := aList[ nIdx ]
   IF ! HB_ISARRAY( aE )
      RETURN .F.
   ENDIF
   IF aE[ HC_E_NAME ] == ".."
      RETURN .F.                    /* the parent entry can never be marked */
   ENDIF
   IF AScan( aDone, nIdx ) > 0
      RETURN .F.                    /* this entry already changed in this sweep */
   ENDIF
   aE[ HC_E_MARK ] := ! aE[ HC_E_MARK ]
   AAdd( aDone, nIdx )
RETURN .T.

/* one coordinate reported by the C helper -> cell of this canvas */
/* S16: cursor index after ONE wheel notch. The panels walk file by file, so a
 * notch is exactly one entry (it used to be three, like the dot prompt), and
 * the result is clamped to the listing so a fast spin never runs past the ends.
 * A positive nNotch is the wheel turning away from the user (up). Public so the
 * headless bank can pin the step. */
FUNCTION HcWheelTarget( nSel, nNotch, nLen )
   IF ValType( nSel ) != "N" .OR. ValType( nNotch ) != "N" .OR. ValType( nLen ) != "N"
      RETURN 1
   ENDIF
   IF nLen < 1
      RETURN 1
   ENDIF
RETURN Min( Max( 1, nSel - nNotch ), nLen )

/* panel under a cell of the canvas (0 = none) */
STATIC FUNCTION HcPanelAt( nRow, nCol )
   LOCAL nId
   FOR nId := HC_PANEL_L TO HC_PANEL_R
      IF HcPanelVisible( nId ) .AND. nRow >= HC_T .AND. nRow <= HC_B .AND. ;
         nCol >= HcPanelL( nId ) .AND. nCol <= HcPanelR( nId )
         RETURN nId
      ENDIF
   NEXT
RETURN 0

/* Collects the wheel and the clicks. A click on the hotkey bar returns the key
 * of the slot, so the caller dispatches it exactly like a real key press;
 * everything else (wheel, click on a panel row) is handled here and returns 0. */
STATIC FUNCTION HcMousePoll()
   LOCAL nNotch, nRow, nCol, nId, aP, nOldSel, nOldTop, nIdx, nSlot, lSwitch := .F.
   LOCAL lShift, nFrom, lCtrl, cSortCol, lDbl := .F., nKey
   LOCAL cName := "", cId, lPair := .F.
   IF ! s_lHcHook
      /* the hook failed while the window was being created: try again */
      s_lHcHook := HcMouseHook( .T. )
   ENDIF
   /* right-click-esc (S1/S2/S7 of right-click-esc.md): in a TREE panel the
    * right button has never done anything - there are no marks and HcDragStep()
    * refuses to start the gesture - and Esc leaves the tree, so a plain right
    * click leaves it the same way. It is handed over AS the Esc key instead of
    * acting here, so the loop's one Esc branch (HcTreeKeyAct) still decides,
    * repaints the panel and lands it on the folder of the cursor. The FILE
    * panels never enter this branch: there the right button marks, opens the
    * context menu and sweeps, and that stays exactly as it is (S2). */
   IF HcPanelTree( HcPanelActive() ) .AND. HcMouseRightClick()
      RETURN K_ESC
   ENDIF
   nNotch := HcMouseWheel()
   IF nNotch != 0
      aP := HcPanelActive()
      IF HcPanelTree( aP )
         /* T4 of hc-tree-panel.md (S8): in a tree panel one notch is one VISIBLE
          * row, with the same clamping as Up/Down and the same lazy touch, and
          * a 3-notch message walks three rows (HcWheelTarget). The notch belongs
          * to the TREE: no file panel moves. */
         nOldSel := aP[ HC_P_TSEL ]
         nOldTop := aP[ HC_P_TTOP ]
         HcTreeNav( aP, HcWheelTarget( aP[ HC_P_TSEL ], nNotch, ;
                                      Len( HcTreeView( aP[ HC_P_NODES ] ) ) ) )
         IF HcTreeSync( aP, HcPanel( HcOtherPanel() ) )
            HcDrawScreen()          /* the other panel changed: full paint */
         ELSE
            HcRepaint( nOldSel, nOldTop )
         ENDIF
      ELSE
         /* ONE entry per notch (S16): the panels move file by file, not by page */
         nOldSel := aP[ HC_P_SEL ]
         nOldTop := aP[ HC_P_TOP ]
         HcCursorTo( aP, HcWheelTarget( aP[ HC_P_SEL ], nNotch, Len( aP[ HC_P_LIST ] ) ) )
         HcRepaint( nOldSel, nOldTop )
      ENDIF
   ENDIF
   /* S37: right button drag = select by sweeping the listing. The press opens
    * the gesture WITHOUT touching the listing and each move toggles the entry
    * it reaches (once per sweep); the release closes it and, when the pointer
    * never moved, toggles the entry of the press (a plain right click). */
   IF HcMouseRightStep()
      /* S6: the bar goes back FIRST. The sweep of this very step may REPAINT the
       * row the bar was drawn on (a mark changes the colour of the whole row), and
       * restoring the saved cells afterwards would put the OLD background back
       * over the new colour: twelve cells of the row left unpainted, which is
       * what the user reported and what verifica-hold-bar.ps1 measures. */
      HcCtxBarHide()
      HcDragStep()
   ENDIF
   IF HcMouseRightUp()
      /* S6: the bar goes back FIRST, because HcDragEnd() may repaint that very
       * row (a plain right click toggles the mark of the pressed entry): putting
       * the saved cells back afterwards would paint the OLD row over the new one */
      HcCtxBarHide()
      HcDragEnd()
   ENDIF
   /* S38: holding the right button still on an entry opens its panel */
   HcCtxHoldCheck()
   /* bp_win32.c already converts the client pixels of the click to the cells of
    * THIS canvas: hwbro.prg sets that grid at startup with
    * W32SetGrid( MaxRow()+1, MaxCol()+1 ). Before, the C side assumed 80x25 and
    * this map rescaled 25 rows to 44, so the click was quantised twice and
    * landed a row above or below the file the user pointed at. */
   nRow  := HcMouseClickRow()
   nCol  := HcMouseClickCol()
   lDbl  := HcMouseClickDbl()
#ifndef BP_HC_STANDALONE
   /* S39: with BP_DEBUG=1 every left click says whether the hook saw it as the
    * second one of a double click - the fastest way to tell a stale build or a
    * click that lands on another row from a broken detection */
   IF nRow >= 0
      BpLog( "S39 click row=" + LTrim( Str( nRow ) ) + " col=" + LTrim( Str( nCol ) ) + ;
             " dbl=" + iif( lDbl, "1", "0" ) )
   ENDIF
#endif
   IF nRow < 0 .OR. nCol < 0
      RETURN 0
   ENDIF
   IF nRow == HC_MENU
      /* a click on a label of the menu bar opens THAT menu (S26): the index
       * travels in s_nHcMenuStart and the bar is entered through the F9 key,
       * so the click uses the very same code as the key */
      nSlot := HcMenuAt( nCol )
      IF nSlot > 0
         s_nHcMenuStart := nSlot
         RETURN K_F9
      ENDIF
      RETURN 0
   ENDIF
   IF nRow == HC_BAR
      nSlot := HcBarSlotAt( nCol )
      IF nSlot > 0
         RETURN HcBarKeys()[ nSlot ]
      ENDIF
      RETURN 0
   ENDIF
   nId := HcPanelAt( nRow, nCol )
   IF nId == 0
      RETURN 0
   ENDIF
   aP := HcPanel( nId )
   nOldSel := aP[ HC_P_SEL ]
   nOldTop := aP[ HC_P_TOP ]
   IF nId != HcActive()
      /* a click on the other panel makes it active AND moves its cursor */
      HcSetActive( nId )
      lSwitch := .T.
   ENDIF
   /* ---------------- tree panel mouse (T4, S8) ----------------
    * A LEFT click on a tree row puts the cursor there (lazy touch included) and
    * the other panel follows it; a click on the MARKER cell toggles that folder
    * and a double click is the Enter key of the tree - the marker and the double
    * click both go through HcTreeAct(), the single place a tree action runs. The
    * header row, the CTRL/SHIFT marks and the right button gestures do NOTHING
    * here and never reach the file logic (the header branch below would sort and
    * the mark branch would mark files the tree does not have). */
   IF HcPanelTree( aP )
      nOldSel := aP[ HC_P_TSEL ]
      nOldTop := aP[ HC_P_TTOP ]
      IF nRow < HC_ROW_FIRST .OR. nRow > HC_ROW_LAST
         /* the header row (and anything above the rows): no order, no cursor */
         IF lSwitch
            HcDrawScreen()
         ENDIF
         RETURN 0
      ENDIF
      nIdx := HcTreeRowIdx( aP, nRow )
      cName := ""                    /* HC_TN_PATH of the node of that row */
      IF nIdx > 0
         cName := aP[ HC_P_NODES ][ HcTreeView( aP[ HC_P_NODES ] )[ nIdx ] ][ HC_TN_PATH ]
      ENDIF
      cId  := HcClickId( s_nHcListGen, nId, cName )
      nKey := HcTreeClickAct( aP, nRow, nCol, lDbl, cId )
      IF nKey != 0
         /* the marker or the double click: the same action as the keyboard */
         IF HcTreeAct( aP, nKey, HcPanel( HcOtherPanel() ) )
            HcDrawScreen()
         ELSE
            HcRepaint( nOldSel, nOldTop )
         ENDIF
         RETURN 0
      ENDIF
      /* a plain click: the tree cursor goes there (and the other panel follows) */
      IF HcTreeClickMove( aP, nRow )
         IF HcTreeSync( aP, HcPanel( HcOtherPanel() ) )
            HcDrawScreen()
         ELSE
            HcRepaint( nOldSel, nOldTop )
         ENDIF
      ELSEIF lSwitch
         HcDrawScreen()
      ENDIF
      RETURN 0
   ENDIF
   IF nRow == HC_ROW_HDR
      /* S4/S34: a click on the header of Name, Size or Date fixes the order of
       * the FILES of THIS panel; the column is resolved with the REAL widths
       * (the same ones HcDrawHeader paints with), so paint and click cannot
       * disagree. The same column inverts the direction, another one starts
       * ascending, and `Time` (the same timestamp as Date) does nothing. A
       * click on the header NEVER moves the entry cursor: HcSortPanel() puts it
       * back on the same entry by name. */
      cSortCol := HcHeaderSortAt( nCol - HcPanelL( nId ) - 1, HcNameW( nId ) )
      IF ! Empty( cSortCol )
         HcSortPanel( nId, cSortCol )
      ELSEIF lSwitch
         /* nothing to sort, but the click did change the active panel */
         HcDrawScreen()
      ENDIF
      RETURN 0
   ENDIF
   lShift := HcMouseClickShift()
   lCtrl := HcMouseClickCtrl()
   IF nRow >= HC_ROW_FIRST .AND. nRow <= HC_ROW_LAST
      nIdx := aP[ HC_P_TOP ] + nRow - HC_ROW_FIRST
      IF nIdx >= 1 .AND. nIdx <= Len( aP[ HC_P_LIST ] )
         /* S32/S33: the three click gestures of a file manager:
          *   plain     -> move the cursor and set the anchor
          *   CTRL      -> mark/unmark THAT entry (one by one)
          *   SHIFT     -> mark the range from the ANCHOR to this row
          */
         IF lCtrl
            IF HcToggleMarkRow( aP[ HC_P_LIST ], nIdx )
               lSwitch := .T.       /* the status row and the marks changed */
            ENDIF
         ELSEIF lShift
            /* the anchor is kept by NAME, so reloading the panel (or coming
             * back from another screen) cannot point it at another file */
            nFrom := AScan( aP[ HC_P_LIST ], ;
                            {| aE | aE[ HC_E_NAME ] == s_aHcAnchor[ nId ] } )
            IF nFrom < 1
               nFrom := aP[ HC_P_SEL ]
            ENDIF
            HcMarkRange( aP[ HC_P_LIST ], nFrom, nIdx )
            lSwitch := .T.          /* the status row and every mark changed */
         ELSE
            s_aHcAnchor[ nId ] := aP[ HC_P_LIST ][ nIdx ][ HC_E_NAME ]
         ENDIF
         HcCursorTo( aP, nIdx )
         IF ! ( lCtrl .OR. lShift )
            cName := aP[ HC_P_LIST ][ nIdx ][ HC_E_NAME ]
         ENDIF
      ENDIF
   ENDIF
   /* S39: the hook of the window only knows the ROW; the entry is what makes
    * two clicks a double click, and a CTRL/SHIFT click is a mark gesture that
    * never opens anything (see HcClickId/HcClickPair). */
   cId   := HcClickId( s_nHcListGen, nId, cName )
   lPair := HcClickPair( lDbl, cId )
   IF lSwitch
      HcDrawScreen()
   ELSE
      HcRepaint( nOldSel, nOldTop )
   ENDIF
   /* S39: a double click on a row is the Enter key on that entry */
   nKey := HcClickKey( lPair, nRow )
   IF nKey != 0
      RETURN nKey
   ENDIF
RETURN 0

/* index of the listing entry painted on a row of a panel (0 = none) */
STATIC FUNCTION HcRowIndex( aP, nRow )
   LOCAL nIdx
   IF nRow < HC_ROW_FIRST .OR. nRow > HC_ROW_LAST
      RETURN 0
   ENDIF
   nIdx := aP[ HC_P_TOP ] + nRow - HC_ROW_FIRST
   IF nIdx < 1 .OR. nIdx > Len( aP[ HC_P_LIST ] )
      RETURN 0
   ENDIF
RETURN nIdx

/* S37: ONE step of the right button gesture (the press or a move with the
 * button held).
 *   press            -> opens the gesture; the listing is NOT touched (that is
 *                       what leaves room for "hold 3 s without moving" later)
 *   first move       -> toggles the entry of the press, and then the one the
 *                       pointer reached
 *   following moves  -> toggles the entry under the pointer, once per sweep
 * The cursor follows the sweep so the user sees where it is, and the gesture
 * stays inside the panel it started in. */
STATIC FUNCTION HcDragStep()
   LOCAL nRow := HcMouseRightRow(), nCol := HcMouseRightCol(), nId, aP, nIdx
   LOCAL nOldSel, nOldTop, lChanged := .F.

   nId := HcPanelAt( nRow, nCol )
   IF ! s_lHcDrag
      /* T4 (S8): a tree panel has no marks, so the right button gesture never
       * starts on one - and without a gesture there is no context panel and no
       * sweep to leak into the file logic */
      IF nId == 0 .OR. HcPanelTree( HcPanel( nId ) )
         RETURN .F.                 /* it did not start on a panel */
      ENDIF
      s_lHcDrag     := .T.
      s_nHcDragPan  := nId
      s_aHcDragDone := {}
      s_nHcDragRow  := nRow
      s_nHcDragCol  := nCol
      s_nHcDragIdx  := HcRowIndex( HcPanel( nId ), nRow )
      s_lHcDragBody := HcCtxBodyRow( nRow )   /* S7: the menu can be asked */
      s_nHcDragLast := s_nHcDragIdx   /* last listing row already processed */
      s_nHcDragTick := Seconds()      /* S38: from here the hold is counted */
#ifndef BP_HC_STANDALONE
      BpLog( "S38 press row=" + LTrim( Str( nRow ) ) + " idx=" + ;
             LTrim( Str( s_nHcDragIdx ) ) + " tick=" + LTrim( Str( s_nHcDragTick ) ) )
#endif
      s_lHcDragMv   := .F.
      s_lHcDragMenu := .F.
      IF nId != HcActive()
         HcSetActive( nId )
         HcDrawScreen()
      ENDIF
      RETURN .F.                    /* nothing to mark until it moves */
   ENDIF
   IF s_lHcDragMenu
      RETURN .F.                     /* S38: the panel opened, nothing marks */
   ENDIF
   IF nId != s_nHcDragPan
      RETURN .F.
   ENDIF
   aP := HcPanel( nId )
   nIdx := HcRowIndex( aP, nRow )
   IF nIdx < 1
      RETURN .F.
   ENDIF
   IF ! s_lHcDragMv .AND. nRow != s_nHcDragRow
      /* the press became a sweep: everything between the pressed entry and the
       * one the pointer reached goes first (the C hook only keeps the last
       * cell, so a fast movement can jump rows and they must be swept too).
       * The pressed entry counts as passed, so the sweep starts AT it: `last`
       * is placed one row behind it, in the direction the pointer took. */
      s_lHcDragMv := .T.
      s_nHcDragLast := s_nHcDragIdx - iif( nIdx >= s_nHcDragIdx, 1, -1 )
   ENDIF
   nOldSel := aP[ HC_P_SEL ]
   nOldTop := aP[ HC_P_TOP ]
   IF s_lHcDragMv .AND. HcDragSweep( aP[ HC_P_LIST ], s_nHcDragLast, nIdx, ;
                                     s_aHcDragDone ) > 0
      lChanged := .T.
   ENDIF
   IF s_lHcDragMv
      s_nHcDragLast := nIdx
   ENDIF
   /* the anchor follows the sweep, so a later Shift+click still starts from
    * what the user was looking at */
   s_aHcAnchor[ nId ] := aP[ HC_P_LIST ][ nIdx ][ HC_E_NAME ]
   HcCursorTo( aP, nIdx )
   IF lChanged
      HcDrawScreen()                /* the marks and the status row changed */
   ELSE
      HcRepaint( nOldSel, nOldTop )
   ENDIF
RETURN .T.

/* S37: the right button was released. A gesture that never moved is a plain
 * right click on one entry, and it selects it or deselects it exactly like one
 * step of a sweep would. Returns .T. when the marks changed. */
STATIC FUNCTION HcDragEnd()
   LOCAL aP, lChanged := .F.

   IF ! s_lHcDrag
      RETURN .F.
   ENDIF
   s_lHcDrag := .F.
   /* S38: a hold that lasted the whole threshold opens the panel even if the
    * poll never ticked (the app was busy, or the release landed in the same
    * pass): the same rule as the poll, checked at the end of the gesture */
   IF HcCtxHoldDue( HcHoldElapsed(), .T., s_lHcDragMv, ;
                    s_lHcDragMenu, s_nHcDragIdx, s_lHcDragBody )
      HcCtxOpen()
      RETURN .T.
   ENDIF
   IF ! s_lHcDragMv .AND. ! s_lHcDragMenu .AND. s_nHcDragIdx >= 1
      aP := HcPanel( s_nHcDragPan )
      IF HB_ISARRAY( aP ) .AND. HB_ISARRAY( aP[ HC_P_LIST ] )
         lChanged := HcDragToggle( aP[ HC_P_LIST ], s_nHcDragIdx, s_aHcDragDone )
         IF lChanged
            HcDrawScreen()
         ENDIF
      ENDIF
   ENDIF
   s_aHcDragDone := {}
   s_nHcDragPan  := 0
   s_nHcDragIdx  := 0
   s_nHcDragLast := 0
   s_nHcDragRow  := 0
   s_nHcDragCol  := 0
   s_nHcDragTick := 0
   s_lHcDragMv   := .F.
   s_lHcDragMenu := .F.
   s_lHcDragBody := .F.
RETURN lChanged

/* =====================================================================
 *  S38: the panel of the held right button
 *
 *  Holding the right button still on an entry opens a panel; its content will
 *  depend on the kind of the entry (file or directory) and is EMPTY for now.
 *  The gesture that opened it is dead: nothing it still had pending can mark an
 *  entry, and the next press starts from scratch.
 * ===================================================================== */

/* S42.1/S1: the options of the panel that the held right button opens. The
 * list depends on the KIND of the entry: a file can be viewed, edited and
 * compared, a directory cannot, and a directory is where a new file is made.
 * Each item is { label, action } and the action is what HcCtxRun() dispatches.
 * The labels of a file list: View, Edit, Copy, Paste, Rename/Move, Delete,
 * Add to zip and Compare. The labels of a directory list: Copy, Paste,
 * Rename/Move, New file, Make dir, Delete and Add to zip.
 *
 * S98: every label carries its HOT LETTER as ~X~ inside the word, the same
 * marker the menus of the program use (UiDrawHot() paints it and UiHotKey()
 * reads it), so a plain letter runs its entry. The letters of a list never
 * repeat: V E C P R D Z M for a file and C P R N M D Z for a directory.
 * Public so the headless bank can pin both lists, their order and their codes. */
FUNCTION HcCtxItems( lIsDir )
   IF lIsDir
      RETURN { { "~C~opy",        HC_CTX_COPY }, ;
               { "~P~aste",       HC_CTX_PASTE }, ;
               { "~R~ename/Move", HC_CTX_MOVE }, ;
               { "~N~ew file",    HC_CTX_NEWFILE }, ;
               { "~M~ake dir",    HC_CTX_MKDIR }, ;
               { "~D~elete",      HC_CTX_DELETE }, ;
               { "Add to ~z~ip",  HC_CTX_ZIP } }
   ENDIF
RETURN { { "~V~iew",        HC_CTX_VIEW }, ;
         { "~E~dit",        HC_CTX_EDIT }, ;
         { "~C~opy",        HC_CTX_COPY }, ;
         { "~P~aste",       HC_CTX_PASTE }, ;
         { "~R~ename/Move", HC_CTX_MOVE }, ;
         { "~D~elete",      HC_CTX_DELETE }, ;
         { "Add to ~z~ip",  HC_CTX_ZIP }, ;
         { "Co~m~pare",     HC_CTX_CMP } }

/* S1: the widest label of the two lists, measured WITHOUT the ~X~ marks: the
 * marks are paint instructions, not letters, so counting them would widen the
 * box by two columns per label and leave the text hanging on the left. The
 * width of the box is derived from it instead of being a literal: a label that
 * does not fit would be cut, and a box wider than its content is wasted screen.
 * Public so the headless bank pins the measurement of the current lists. */
FUNCTION HcCtxLabelW()
   LOCAL aFile := HcCtxItems( .F. ), aDir := HcCtxItems( .T. )
   LOCAL n := 0, i
   FOR i := 1 TO Len( aFile )
      n := Max( n, UiHotLen( aFile[ i ][ HC_CTX_LABEL ] ) )
   NEXT
   FOR i := 1 TO Len( aDir )
      n := Max( n, UiHotLen( aDir[ i ][ HC_CTX_LABEL ] ) )
   NEXT
RETURN n

/* S6 of browse-edit-mouse.md: the RULE of a list - the row that only groups two
 * blocks of entries. It is spelled as an empty label with no action, so a list
 * that has no rules (the manager's and the editor's) behaves exactly as before:
 * every row of theirs answers .F. here. */
FUNCTION HcCtxSep( aIt )
   LOCAL x
   IF ! HB_ISARRAY( aIt ) .OR. Len( aIt ) < HC_CTX_ACT
      RETURN .T.
   ENDIF
   x := aIt[ HC_CTX_ACT ]
   IF HB_ISNIL( x )
      RETURN .T.
   ENDIF
   /* Len() and not Empty(): Empty() is also .T. for a label of blanks
    * (trap 46), and the action of a real entry is never an empty string */
RETURN ValType( x ) == "C" .AND. Len( x ) == 0

/* S6/L9 of browse-edit-mouse.md: is the item marked as NOT AVAILABLE? An item
 * may carry, as an OPTIONAL third element, the "D" of the menus of the program
 * (trap 13): a row that is PAINTED - so the user sees it and knows it exists -
 * but that cannot be chosen in this context. It is not a rule (it has a label
 * and an action of its own) and it is not an entry the cursor can stop on
 * either, so HcCtxOk() and HcCtxHotIdx() both ask THIS and nothing else has to
 * know about the flags: the arrows, the wheel, the pointer, a click, Enter and
 * the hot letter are gated in one place. An item without that third element -
 * every row of the manager's and of the editor's lists - answers .F., which is
 * what keeps those two lists byte-identical to what they were. Pure. */
FUNCTION HcCtxDis( aIt )
   IF ! HB_ISARRAY( aIt ) .OR. Len( aIt ) < 3
      RETURN .F.
   ENDIF
RETURN ValType( aIt[ 3 ] ) == "C" .AND. aIt[ 3 ] == "D"

/* S6: can the cursor stop on row nIdx? A rule, a row marked as not available
 * and anything out of range cannot.
 * Pure: the arrows, the wheel, the hot letter, the pointer and a click all ask
 * THIS, so the four ways of reaching an entry cannot disagree. */
FUNCTION HcCtxOk( aItems, nIdx )
   IF ! HB_ISARRAY( aItems ) .OR. ValType( nIdx ) != "N"
      RETURN .F.
   ENDIF
   IF nIdx < 1 .OR. nIdx > Len( aItems )
      RETURN .F.
   ENDIF
   IF HcCtxSep( aItems[ nIdx ] )
      RETURN .F.
   ENDIF
RETURN ! HcCtxDis( aItems[ nIdx ] )

/* S6: first row the cursor can reach, 0 when the list has nothing to reach */
FUNCTION HcCtxFirst( aItems )
   LOCAL i
   IF ! HB_ISARRAY( aItems )
      RETURN 0
   ENDIF
   FOR i := 1 TO Len( aItems )
      IF HcCtxOk( aItems, i )
         RETURN i
      ENDIF
   NEXT
RETURN 0

/* S6: the row the cursor reaches from nSel walking nDir (+1 down, -1 up),
 * clamped at both ends (no wrap around, which is what this popup has always
 * done). A list without rules - every list that existed before S6 - answers
 * exactly what the arrows answered before: nSel + nDir, bounded. */
FUNCTION HcCtxStep( aItems, nSel, nDir )
   LOCAL n := nSel, nLen, i, nStep
   IF ! HB_ISARRAY( aItems ) .OR. ValType( nSel ) != "N"
      RETURN nSel
   ENDIF
   nLen := Len( aItems )
   IF nLen < 1 .OR. ValType( nDir ) != "N" .OR. nDir == 0
      RETURN nSel
   ENDIF
   nStep := iif( nDir > 0, 1, -1 )
   FOR i := 1 TO nLen
      n += nStep
      IF n < 1 .OR. n > nLen
         EXIT
      ENDIF
      IF HcCtxOk( aItems, n )
         RETURN n
      ENDIF
   NEXT
RETURN nSel

/* S6: the row a wheel notch (nNotch notches) leaves the highlight on: ONE
 * reachable entry per notch, clamped like the arrows. A positive notch is the
 * wheel turning away from the user (up), the same meaning it has in the panels. */
FUNCTION HcCtxWheelSel( aItems, nSel, nNotch )
   LOCAL n, nLen, i, nStep
   IF ! HB_ISARRAY( aItems ) .OR. ValType( nSel ) != "N" .OR. ValType( nNotch ) != "N"
      RETURN iif( ValType( nSel ) == "N", nSel, 1 )
   ENDIF
   nLen := Len( aItems )
   IF nLen < 1
      RETURN 1
   ENDIF
   IF nSel < 1 .OR. nSel > nLen
      RETURN Max( 1, HcCtxFirst( aItems ) )
   ENDIF
   n := nSel
   nStep := iif( nNotch > 0, -1, 1 )
   FOR i := 1 TO Min( Abs( nNotch ), 1000 )
      n := HcCtxStep( aItems, n, nStep )
   NEXT
RETURN n

/* S6: the widest VISIBLE label of a list - the rules and the ~X~ marks do not
 * count - so the box is sized from the list it is about to paint: a label that
 * does not fit would be cut by HcCtxRow(). Pure. */
FUNCTION HcCtxListW( aItems )
   LOCAL n := 0, i
   IF ! HB_ISARRAY( aItems )
      RETURN 0
   ENDIF
   FOR i := 1 TO Len( aItems )
      IF HcCtxOk( aItems, i ) .AND. ValType( aItems[ i ][ HC_CTX_LABEL ] ) == "C"
         n := Max( n, UiHotLen( aItems[ i ][ HC_CTX_LABEL ] ) )
      ENDIF
   NEXT
RETURN n

/* S98: the row whose label carries that hot letter, or 0. The letter is read
 * from the ~X~ mark with UiHotKey() - the very same rule of the menus - and it
 * matches upper or lower case. Pure, so the headless bank can pin it. */
STATIC FUNCTION HcCtxHotIdx( aItems, nKey )
   LOCAL cKey, i
   IF ! HB_ISARRAY( aItems ) .OR. ValType( nKey ) != "N"
      RETURN 0
   ENDIF
   /* only the printable range: Esc, Enter, Tab and every arrow are below it,
    * so they can never be taken for a hot letter (the same range HcMenuHot()
    * uses for the menus of the bar) */
   IF nKey < 33 .OR. nKey > 255
      RETURN 0
   ENDIF
   cKey := Upper( Chr( nKey ) )
   FOR i := 1 TO Len( aItems )
      /* S6/L9: a row marked as not available does not answer its letter, the
       * same way it does not answer the arrows or a click */
      IF HB_ISARRAY( aItems[ i ] ) .AND. Len( aItems[ i ] ) >= HC_CTX_ACT .AND. ;
         ! HcCtxDis( aItems[ i ] ) .AND. ;
         UiHotKey( aItems[ i ][ HC_CTX_LABEL ] ) == cKey
         RETURN i
      ENDIF
   NEXT
RETURN 0

/* S98: the action a plain letter picks in the list, or "" when no entry carries
 * it. A letter that only exists in the OTHER list answers "" (the panel acts on
 * what it is showing and on nothing else), and so does any key that is not a
 * printable letter. Public so the headless bank pins the rule without a
 * window. */
FUNCTION HcCtxHot( aItems, nKey )
   LOCAL n := HcCtxHotIdx( aItems, nKey )
   IF n == 0
      RETURN ""
   ENDIF
RETURN aItems[ n ][ HC_CTX_ACT ]

/* one row of the menu: entry nIdx of the list, painted on the line of the box
 * where it falls while the window shows from nTop on, highlighted when it is
 * the one under the cursor. The label is CUT to the interior of the box: a
 * label longer than the box would otherwise paint over the right frame.
 *
 * S98 (the user: "Y que funcione el mouse y tenga la estetica de un menu
 * contextual"): a row is painted exactly like a row of a dropdown of the menu
 * bar (HcMenuRow()) - the selected one in UI_C_BOXSEL (white on brown), the hot
 * letter read from its ~X~ mark by UiDrawHot() in UI_C_HOT (yellow) over either
 * background, and one column of air before the label. Reusing those UI_C_*
 * means no new colour enters the palette (AGENTS.md 4). */
STATIC PROCEDURE HcCtxRow( aBox, aItems, nIdx, nTop, lOn )
   LOCAL nW := aBox[ 4 ] - aBox[ 2 ] - 1
   LOCAL cLabel := aItems[ nIdx ][ HC_CTX_LABEL ]
   LOCAL cRow := iif( lOn, UI_C_BOXSEL, UI_C_BOX )
   LOCAL nRow := aBox[ 1 ] + ( nIdx - nTop ) + 1
   /* a box with no interior cannot hold a label: nothing to cut, and the loop
    * below would never end on a negative width */
   IF nW < 1
      RETURN
   ENDIF
   /* S6 of browse-edit-mouse.md: the RULE that groups two blocks of entries is
    * painted like the separator of the menus of the bar - a single line in the
    * dim colour - and never highlighted, because the cursor cannot stop on it */
   IF HcCtxSep( aItems[ nIdx ] )
      SetColor( UI_C_BOXDIM )
      @ nRow, aBox[ 2 ] + 1 SAY Replicate( BP_LINE_SINGLE, nW )
      SetColor( UI_C_DESKTOP )
      RETURN
   ENDIF
   /* the cut counts the LETTERS and keeps the marks: dropping the last
    * character until the visible width fits can never cut inside a label and
    * leave half of a mark behind. One cell is the air before the label. */
   DO WHILE UiHotLen( cLabel ) > nW - 1
      cLabel := Left( cLabel, Len( cLabel ) - 1 )
   ENDDO
   /* S6/L9: a row marked as not available keeps ITS OWN LABEL - the user has
    * to see which entry exists and cannot be used -, painted whole in the dim
    * pair of the rules and never highlighted (the cursor cannot stop on it, so
    * lOn is never .T. here): no new colour enters the palette (AGENTS.md 4) */
   IF HcCtxDis( aItems[ nIdx ] )
      SetColor( UI_C_BOXDIM )
      @ nRow, aBox[ 2 ] + 1 SAY Space( nW )
      UiDrawHot( nRow, aBox[ 2 ] + 2, cLabel, UI_C_BOXDIM, UI_C_BOXDIM )
      SetColor( UI_C_DESKTOP )
      RETURN
   ENDIF
   SetColor( cRow )
   @ nRow, aBox[ 2 ] + 1 SAY Space( nW )
   UiDrawHot( nRow, aBox[ 2 ] + 2, cLabel, cRow, UI_C_HOT )
   SetColor( UI_C_BOX )
RETURN

/* =====================================================================
 *  S42: Add to zip
 *
 *  The option compresses what is MARKED in the panel, or the entry under the
 *  cursor when nothing is marked. It uses the low level of hbmzip
 *  (hb_zipOpen/hb_zipFileCreate/hb_zipFileWrite) instead of hbziparc's
 *  hb_ZipFile() because that gives control of the name of every entry inside
 *  the zip, of the level and of the password, does not change the current
 *  directory and does not clear the ARCHIVE attribute of the source files.
 * ===================================================================== */

/* S43: Del on the panels is the DELETE key: it maps to F8 and goes through the
 * same dispatcher, so the key, the menu and the bar can never diverge. The
 * command line keeps Del while it is in use (the caller asks HcCmdBusy()).
 * Pure, so the headless bank can pin it. */
FUNCTION HcKeyAlias( nKey )
   IF ValType( nKey ) == "N" .AND. nKey == K_DEL
      RETURN K_F8
   ENDIF
RETURN nKey

/* S43: the mapping as the KEY LOOP applies it: the flag the loop already knows
 * (is some command line in use?) is passed in, so this never guesses about a
 * panel it does not own. Calling this from a screen that has no panel array is
 * what crashed hwBro from inside the Add to zip dialog (an undeclared aP read
 * as a variable that does not exist -> BpFatal): keep the mapping in the loop
 * and pass the flag. Pure, so the headless bank pins both states. */
FUNCTION HcPanelKey( nKey, lCmdBusy )
   IF lCmdBusy
      RETURN nKey
   ENDIF
RETURN HcKeyAlias( nKey )

/* S42.1/S2: runs the option chosen in the panel. EVERY case calls the routine
 * its KEY calls (HcRunKey(), the Ctrl-C/Ctrl-V branch of the key loop and the
 * Shift-F2 one), never a copy of it, so the panel, the keys and the menu bar
 * cannot diverge. The panel passed in is the one the panel was opened on: the
 * clipboard actions receive it explicitly instead of re-deriving it. */
STATIC PROCEDURE HcCtxRun( cAct, aP )
   DO CASE
   CASE cAct == HC_CTX_ZIP
      HcZipStart( aP )
   CASE cAct == HC_CTX_VIEW
      HcView( HcFileAtCursor( aP ) )
      HcLoad( aP )
   CASE cAct == HC_CTX_EDIT
      HcEdit( HcFileAtCursor( aP ) )
      HcLoad( aP )
   CASE cAct == HC_CTX_COPY
      HcClipCopy( aP )
   CASE cAct == HC_CTX_PASTE
      HcClipPaste( aP )
   CASE cAct == HC_CTX_MOVE
      HcMove()
   CASE cAct == HC_CTX_DELETE
      HcDelete()
   CASE cAct == HC_CTX_MKDIR
      HcMakeDir()
   CASE cAct == HC_CTX_NEWFILE
      HcNewFile()
   CASE cAct == HC_CTX_CMP
      HcCompare()
   ENDCASE
   /* the option ran from the MOUSE POLL: no key sets the repaint flags of the
    * key loop, so the screen is painted here. Without this an option that
    * reloads a panel (a delete, a paste, a new directory) left the old rows on
    * screen until the next movement - the same reason HcZipStart() repaints. */
   HcZipSync()
   HcDrawScreen()
RETURN

/* S42.2: what Add to zip compresses, as { { cFullPath, cNameInZip }, ... }: the
 * MARKED entries when there is anything marked, or the entry under the cursor
 * when there is not. A directory brings everything inside it, recursively, and
 * the zip keeps the relative path. Public so the headless bank can pin it. */
FUNCTION HcZipTargets( aP )
   LOCAL aOut := {}, i, nMarked := 0, aE
   IF ! HB_ISARRAY( aP ) .OR. ! HB_ISARRAY( aP[ HC_P_LIST ] )
      RETURN aOut
   ENDIF
   FOR i := 1 TO Len( aP[ HC_P_LIST ] )
      IF aP[ HC_P_LIST ][ i ][ HC_E_MARK ] .AND. ;
         ! ( aP[ HC_P_LIST ][ i ][ HC_E_NAME ] == ".." )
         nMarked++
      ENDIF
   NEXT
   FOR i := 1 TO Len( aP[ HC_P_LIST ] )
      aE := aP[ HC_P_LIST ][ i ]
      IF ! ( aE[ HC_E_NAME ] == ".." ) .AND. ;
         iif( nMarked > 0, aE[ HC_E_MARK ], i == aP[ HC_P_SEL ] )
         HcZipWalk( HcJoinPath( aP[ HC_P_DIR ], aE[ HC_E_NAME ] ), aE[ HC_E_NAME ], aOut )
      ENDIF
   NEXT
RETURN aOut

/* one path and, if it is a directory, everything inside it. The entry name is
 * built with "/" because hb_zipFileCreate() does not translate the separator. */
STATIC PROCEDURE HcZipWalk( cFull, cEntry, aOut )
   LOCAL aRaw, aE, i, cN, cScan
   IF ! hb_vfDirExists( cFull )
      IF hb_vfExists( cFull )
         AAdd( aOut, { cFull, HcZipName( cEntry ) } )
      ENDIF
      RETURN
   ENDIF
   /* the same scan the panel uses (hb_vfDirectory; hb_DirScan with a full mask
    * returns nothing in this build): "HSD" brings hidden, system and DIRECTORIES.
    * It needs the directory WITH its trailing separator (the panel keeps it). */
   cScan := cFull
   IF ! ( Right( cScan, 1 ) == "\" ) .AND. ! ( Right( cScan, 1 ) == "/" )
      cScan += "\"
   ENDIF
   aRaw := hb_vfDirectory( cScan, "HSD" )
   IF ! HB_ISARRAY( aRaw )
      RETURN
   ENDIF
   FOR i := 1 TO Len( aRaw )
      aE := HcEntryNew( aRaw[ i ] )
      cN := aE[ HC_E_NAME ]
      IF ! ( cN == "." ) .AND. ! ( cN == ".." )
         HcZipWalk( cFull + "\" + cN, cEntry + "/" + cN, aOut )
      ENDIF
   NEXT
RETURN

/* the name inside the zip: separators normalised to "/" */
FUNCTION HcZipName( cEntry )
   IF ! HB_ISSTRING( cEntry )
      RETURN ""
   ENDIF
RETURN StrTran( StrTran( cEntry, "\", "/" ), "//", "/" )

/* S42.4: the name proposed in the dialog. With ONE target it is that name with
 * .zip instead of its extension; with several, the name of the panel
 * directory. Public so the bank can pin it. */
FUNCTION HcZipDefaultName( aP )
   LOCAL aTop := {}, i, nMarked := 0, aE, cBase
   IF ! HB_ISARRAY( aP ) .OR. ! HB_ISARRAY( aP[ HC_P_LIST ] )
      RETURN "archive.zip"
   ENDIF
   FOR i := 1 TO Len( aP[ HC_P_LIST ] )
      IF aP[ HC_P_LIST ][ i ][ HC_E_MARK ] .AND. ;
         ! ( aP[ HC_P_LIST ][ i ][ HC_E_NAME ] == ".." )
         nMarked++
      ENDIF
   NEXT
   FOR i := 1 TO Len( aP[ HC_P_LIST ] )
      aE := aP[ HC_P_LIST ][ i ]
      IF ! ( aE[ HC_E_NAME ] == ".." ) .AND. ;
         iif( nMarked > 0, aE[ HC_E_MARK ], i == aP[ HC_P_SEL ] )
         AAdd( aTop, aE[ HC_E_NAME ] )
      ENDIF
   NEXT
   IF Len( aTop ) == 1
      RETURN hb_FNameName( aTop[ 1 ] ) + ".zip"
   ENDIF
   cBase := hb_FNameName( HcDirNoSep( aP[ HC_P_DIR ] ) )
   IF Empty( cBase )
      cBase := "archive"
   ENDIF
RETURN cBase + ".zip"

/* a directory path without its trailing separator */
STATIC FUNCTION HcDirNoSep( cDir )
   LOCAL c := cDir
   IF ! HB_ISSTRING( c )
      RETURN ""
   ENDIF
   DO WHILE Len( c ) > 1 .AND. ( Right( c, 1 ) == "\" .OR. Right( c, 1 ) == "/" )
      c := Left( c, Len( c ) - 1 )
   ENDDO
RETURN c

/* S42.3: the level of zlib, clamped: anything outside 0..9 corrupts the entry
 * (zlib validates it AFTER writing the local header). Public for the bank. */
FUNCTION HcZipLevel( nLevel )
   IF ValType( nLevel ) != "N"
      RETURN 6
   ENDIF
RETURN Min( Max( 0, Int( nLevel ) ), 9 )

/* S42.4/S42.5: creates the zip with the given pairs. Returns how many entries
 * were added (-1 when the zip cannot be created). NO user interface here, so
 * the headless bank can build a real zip and verify it. */
FUNCTION HcZipMake( cZip, aPairs, nLevel, cPassword )
   LOCAL hZip, i, nOk := 0, c
   IF ! HB_ISSTRING( cZip ) .OR. Empty( cZip ) .OR. ! HB_ISARRAY( aPairs )
      RETURN -1
   ENDIF
   nLevel := HcZipLevel( nLevel )
   /* "" WOULD encrypt in hbmzip: only NIL means "no password" */
   c := iif( HB_ISSTRING( cPassword ) .AND. ! Empty( cPassword ), cPassword, NIL )
   IF hb_vfExists( cZip )
      hb_vfErase( cZip )
   ENDIF
   hZip := hb_zipOpen( cZip )
   IF Empty( hZip )
      RETURN -1
   ENDIF
   FOR i := 1 TO Len( aPairs )
      IF HcZipAddOne( hZip, aPairs[ i ][ 1 ], aPairs[ i ][ 2 ], nLevel, c ) == 0
         nOk++
      ENDIF
   NEXT
   hb_zipClose( hZip )
RETURN nOk

/* one file into an open zip: its own entry name, level and password. Returns
 * the hbmzip error code (0 = ok). */
STATIC FUNCTION HcZipAddOne( hZip, cFull, cEntry, nLevel, cPassword )
   LOCAL hIn, cBuf, nRead, nErr, dDate, cTime
   hIn := FOpen( cFull )
   IF hIn == F_ERROR
      RETURN -1
   ENDIF
   hb_vfTimeGet( cFull, @dDate, @cTime )
   nErr := hb_zipFileCreate( hZip, cEntry, dDate, cTime, 0, 0, 8, nLevel, ;
                             cPassword, ;
                             iif( Empty( cPassword ), NIL, hb_zipFileCRC32( cFull ) ) )
   IF nErr == 0
      cBuf := Space( 32768 )
      DO WHILE ( nRead := FRead( hIn, @cBuf, 32768 ) ) > 0
         nErr := hb_zipFileWrite( hZip, Left( cBuf, nRead ) )
         IF nErr != 0
            EXIT
         ENDIF
      ENDDO
      IF nErr == 0
         nErr := hb_zipFileClose( hZip )
      ENDIF
   ENDIF
   FClose( hIn )
RETURN nErr

/* ---------------------------------------------------------------------
 *  Zip browsing (S47..S52): the PURE and DISK-LEVEL helpers that let a panel
 *  show the CONTENT of a .zip as if it were a directory. The panel wiring
 *  (opening and closing a session, the virtual title, the operations and the
 *  dump after each change) lives in the later slices and calls only these.
 *
 *  Measured on this build (there is no C header for hbmzip installed, so the
 *  usage comes from the shipped contrib\hbmzip\tests\myunzip.prg):
 *    - hb_unzipOpen() answers a handle (type "P") or NIL for a file that does
 *      not exist or that is not a zip;
 *    - hb_unzipFileFirst() answers 0 for the first entry and
 *      hb_unzipFileNext() answers 0 while there are entries;
 *      UNZ_END_OF_LIST_OF_FILE (-100) closes the list and any other negative
 *      value is an error;
 *    - hb_unzipFileInfo( h, @cFile, @dDate, @cTime, , , , @nSize, , @lCrypt )
 *      is the by-reference signature (the date comes back as a DateTime);
 *    - hb_unzipExtractCurrentFile( h, cTarget, cPassword ) writes the entry to
 *      cTarget (with NIL it writes to <cwd>\<entry name>) and CREATES the
 *      missing parent directories; it answers 0 or a negative error. With a
 *      WRONG password it answers -3 and leaves a 0-BYTE FILE behind, so a
 *      failed entry has to be erased by the caller;
 *    - hb_GetFilesInZip( c ) answers the entry names as an array of strings;
 *      with .T. it answers one 11-element array per entry whose [10] is the
 *      crypted flag. A missing or invalid archive answers {} (an EMPTY
 *      array), never NIL;
 *    - hb_unzipClose( NIL ) raises "Argument error", so the handle is closed
 *      only when it was opened.
 * --------------------------------------------------------------------- */

/* hb_unzipFileNext() answers this when the entry list is over (measured); it
 * is UNZ_END_OF_LIST_OF_FILE of hbmzip.ch, repeated here because this module
 * does not include that header */
#define HC_UNZ_EOF  -100

/* S47: .T. when the file starts with a zip signature: "PK" followed by
 * 03 04 (a local file header) or by 05 06 (an empty archive). A missing,
 * locked or shorter-than-4-bytes file is not a zip. */
FUNCTION HcZipIsZip( cFile )
   LOCAL hIn, cBuf := Space( 4 ), nRead, cTail
   IF ValType( cFile ) != "C" .OR. Empty( AllTrim( cFile ) )
      RETURN .F.
   ENDIF
   cFile := AllTrim( cFile )
   IF ! hb_vfExists( cFile )
      RETURN .F.
   ENDIF
   hIn := FOpen( cFile, FO_READ )
   IF hIn == F_ERROR
      RETURN .F.
   ENDIF
   nRead := FRead( hIn, @cBuf, 4 )
   FClose( hIn )
   IF nRead != 4
      RETURN .F.
   ENDIF
   cTail := SubStr( cBuf, 3, 2 )
RETURN Left( cBuf, 2 ) == "PK" .AND. ;
       ( cTail == Chr( 3 ) + Chr( 4 ) .OR. cTail == Chr( 5 ) + Chr( 6 ) )

/* the relative path of a zip entry as Windows writes it: separators turned
 * into "\", no leading separator and no trailing one ("sub/three.txt" ->
 * "sub\three.txt", "sub/" -> "sub"). */
STATIC FUNCTION HcZipEntryRel( cEntry )
   LOCAL c
   IF ValType( cEntry ) != "C"
      RETURN ""
   ENDIF
   c := StrTran( AllTrim( cEntry ), "/", "\" )
   DO WHILE Left( c, 1 ) == "\"
      c := SubStr( c, 2 )
   ENDDO
   DO WHILE ! Empty( c ) .AND. Right( c, 1 ) == "\"
      c := Left( c, Len( c ) - 1 )
   ENDDO
RETURN c

/* every FILE of the tree as { { cFullPath, cNameInZip }, ... }, built on
 * HcZipWalk() and with the names relative to cRoot ("/one.txt" -> "one.txt"):
 * that is what HcZipMake() writes and what the stamp compares. Directories
 * carry no entry: a zip stores files and the paths they need. */
STATIC FUNCTION HcZipPairs( cRoot )
   LOCAL aAll := {}, aOut := {}, i, c
   HcZipWalk( cRoot, "", aAll )
   FOR i := 1 TO Len( aAll )
      c := HcZipEntryRel( aAll[ i ][ 2 ] )
      IF ! Empty( c )
         AAdd( aOut, { aAll[ i ][ 1 ], HcZipName( c ) } )
      ENDIF
   NEXT
RETURN aOut

/* S47: a stamp of the whole tree that changes whenever a file is added,
 * removed, renamed, resized or re-timestamped. It is built from the recursive
 * listing and SORTED, so the order of the directory scan cannot fake a change,
 * and it is PURE: no writes and no archive access. Empty or missing root ->
 * "" (a stable value). */
FUNCTION HcZipStamp( cRoot )
   LOCAL aPairs, aLine := {}, i, c := ""
   IF ValType( cRoot ) != "C" .OR. Empty( AllTrim( cRoot ) ) .OR. ;
      ! hb_DirExists( cRoot )
      RETURN ""
   ENDIF
   aPairs := HcZipPairs( cRoot )
   FOR i := 1 TO Len( aPairs )
      AAdd( aLine, aPairs[ i ][ 2 ] + "|" + ;
                   LTrim( Str( hb_vfSize( aPairs[ i ][ 1 ] ) ) ) + "|" + ;
                   HcFileStampKey( aPairs[ i ][ 1 ] ) )
   NEXT
   ASort( aLine )
   FOR i := 1 TO Len( aLine )
      c += aLine[ i ] + Chr( 10 )
   NEXT
RETURN c

/* S47/S48: the string the panel title shows: the path of the zip at its root
 * and the zip plus the relative part inside a subdirectory. The comparison is
 * case-insensitive and tolerates a trailing separator (HcNormPath()) and the
 * relative part keeps the case the directory really has; a directory that is
 * not inside the root answers the zip path alone. */
FUNCTION HcZipVirtualPath( cZip, cRoot, cDir )
   LOCAL cR, cD, cSep, cRel, cRootNoSep, cDirNoSep
   IF ValType( cZip ) != "C" .OR. Empty( AllTrim( cZip ) )
      RETURN ""
   ENDIF
   cZip := AllTrim( cZip )
   IF ValType( cRoot ) != "C" .OR. ValType( cDir ) != "C"
      RETURN cZip
   ENDIF
   cR := HcNormPath( cRoot )
   cD := HcNormPath( cDir )
   IF Empty( cR ) .OR. Empty( cD )
      RETURN cZip
   ENDIF
   IF cD == cR
      RETURN cZip
   ENDIF
   /* a drive root already ends with the separator, so it is not doubled */
   cSep := iif( Right( cR, 1 ) == "\", "", "\" )
   IF Left( cD, Len( cR ) + Len( cSep ) ) != cR + cSep
      RETURN cZip
   ENDIF
   cRel := SubStr( cD, Len( cR ) + Len( cSep ) + 1 )
   /* HcNormPath() uppercases, so the same substring of the REAL path is
    * preferred when the two shapes agree */
   cRootNoSep := HcDirNoSep( cRoot )
   cDirNoSep := HcDirNoSep( cDir )
   IF ! Empty( cDirNoSep ) .AND. Len( cDirNoSep ) > Len( cRootNoSep ) .AND. ;
      Upper( Left( cDirNoSep, Len( cRootNoSep ) ) ) == Upper( cRootNoSep )
      cRel := SubStr( cDirNoSep, Len( cRootNoSep ) + 2 )
   ENDIF
   IF Empty( cRel )
      RETURN cZip
   ENDIF
RETURN cZip + "\" + cRel

/* S47: .T. when cPath IS cRoot or lives below it. Textual (HcNormPath()), so
 * it needs no filesystem access and a trailing separator does not matter; a
 * sibling that only shares the name prefix is NOT inside. */
FUNCTION HcZipContains( cRoot, cPath )
   IF ValType( cRoot ) != "C" .OR. ValType( cPath ) != "C"
      RETURN .F.
   ENDIF
RETURN HcPathInsideHc( cRoot, cPath )

/* S47/S51: .T. when any entry of the archive is encrypted. A missing or
 * unreadable archive answers .T. too (there is no entry list to inspect, so
 * the caller has to ask for a password instead of guessing). */
FUNCTION HcZipCrypt( cZip )
   LOCAL aInfo, i
   IF ValType( cZip ) != "C" .OR. Empty( AllTrim( cZip ) )
      RETURN .F.
   ENDIF
   aInfo := hb_GetFilesInZip( AllTrim( cZip ), .T. )
   IF ! HB_ISARRAY( aInfo ) .OR. Empty( aInfo )
      RETURN .T.
   ENDIF
   FOR i := 1 TO Len( aInfo )
      IF HB_ISARRAY( aInfo[ i ] ) .AND. Len( aInfo[ i ] ) >= 10 .AND. aInfo[ i ][ 10 ]
         RETURN .T.
      ENDIF
   NEXT
RETURN .F.

/* S47: extracts EVERY entry of the archive into cRoot, creating the
 * subdirectories the entry names carry. Answers { lOk, cError, nFiles } and
 * never leaves the caller with a half written file: an entry that fails (a
 * wrong password, for instance) is erased and the error names it. Entries
 * whose path would escape cRoot are refused, and directory entries (a name
 * ending with the separator) only create their directory. */
FUNCTION HcZipExtract( cZip, cRoot, cPassword )
   LOCAL hUn, nErr, nFiles := 0, cFile, dDate, cTime, nSize, lCrypt
   LOCAL cRel, cTarget, nE, cPass, i
   IF ValType( cZip ) != "C" .OR. Empty( AllTrim( cZip ) ) .OR. ;
      ValType( cRoot ) != "C" .OR. Empty( AllTrim( cRoot ) )
      RETURN { .F., "No archive or destination directory given.", 0 }
   ENDIF
   cRoot := HcDirNoSep( cRoot )
   IF ! hb_DirExists( cRoot )
      hb_DirCreate( HcDirArg( cRoot ) )
      IF ! hb_DirExists( cRoot )
         RETURN { .F., "Cannot create the directory " + cRoot + ".", 0 }
      ENDIF
   ENDIF
   /* "" WOULD encrypt in hbmzip: only NIL means "no password" */
   cPass := iif( HB_ISSTRING( cPassword ) .AND. ! Empty( cPassword ), cPassword, NIL )
   hUn := hb_unzipOpen( cZip )
   IF Empty( hUn )
      RETURN { .F., "Cannot read " + cZip + " as a zip archive.", 0 }
   ENDIF
   nErr := hb_unzipFileFirst( hUn )
   DO WHILE nErr == 0
      cFile := ""
      dDate := NIL
      cTime := ""
      nSize := 0
      lCrypt := .F.
      hb_unzipFileInfo( hUn, @cFile, @dDate, @cTime, , , , @nSize, , @lCrypt )
      cRel := HcZipEntryRel( cFile )
      IF Empty( cRel )
         /* the archive entry of the root itself: nothing to write */
         nErr := hb_unzipFileNext( hUn )
         LOOP
      ENDIF
      cTarget := HcJoinPath( cRoot, cRel )
      IF ! HcZipContains( cRoot, cTarget )
         hb_unzipClose( hUn )
         RETURN { .F., "The entry " + cFile + " points outside the working directory.", nFiles }
      ENDIF
      IF Right( cFile, 1 ) == "/" .OR. Right( cFile, 1 ) == "\"
         /* a directory entry stores no data: only its directory is needed */
         IF ! hb_DirExists( HcDirArg( cTarget ) )
            hb_DirCreate( HcDirArg( cTarget ) )
         ENDIF
         nErr := hb_unzipFileNext( hUn )
         LOOP
      ENDIF
      IF ! hb_DirExists( HcParentDir( cTarget ) )
         hb_DirCreate( HcParentDir( cTarget ) )
      ENDIF
      nE := hb_unzipExtractCurrentFile( hUn, cTarget, cPass )
      IF nE != 0
         hb_unzipClose( hUn )
         /* measured: a wrong password answers -3 and leaves a 0-byte file.
          * Windows can keep that file open for a moment after the failing
          * extract, so the erase is retried a few times: the entry must not
          * survive the error (S47) and a sharing violation is not a reason to
          * leave it behind. */
         IF hb_vfExists( cTarget ) .AND. HcZipContains( cRoot, cTarget )
            FOR i := 1 TO 5
               hb_vfErase( cTarget )
               IF ! hb_vfExists( cTarget )
                  EXIT
               ENDIF
               Inkey( 0.02 )
            NEXT
         ENDIF
         RETURN { .F., "Cannot extract " + cFile + " (error " + LTrim( Str( nE ) ) + ")" + ;
                        iif( lCrypt, ": wrong password or damaged entry.", "." ), nFiles }
      ENDIF
      nFiles++
      nErr := hb_unzipFileNext( hUn )
   ENDDO
   hb_unzipClose( hUn )
   IF nErr != HC_UNZ_EOF
      RETURN { .F., "Cannot read the entry list of " + cZip + ;
                     " (error " + LTrim( Str( nErr ) ) + ").", nFiles }
   ENDIF
RETURN { .T., "", nFiles }

/* S47/S50: rewrites the WHOLE archive from the tree in cRoot. The new archive
 * is written to <zip>.$$$ and the original is replaced ONLY when it is
 * complete and closed: the old one is renamed to <zip>.$$$BAK, the temporary
 * takes its place and the backup is erased. If anything fails, the backup is
 * put back and the archive stays BYTE FOR BYTE as it was (no .$$$ and no
 * .$$$BAK are left behind on success). Answers { lOk, cError, nFiles }. */
FUNCTION HcZipRepack( cZip, cRoot, cPassword, nLevel )
   LOCAL aPairs, nFiles, cTmp, cBak
   IF ValType( cZip ) != "C" .OR. Empty( AllTrim( cZip ) ) .OR. ;
      ValType( cRoot ) != "C" .OR. Empty( AllTrim( cRoot ) )
      RETURN { .F., "No archive or source directory given.", 0 }
   ENDIF
   cZip := AllTrim( cZip )
   IF ! hb_DirExists( cRoot )
      RETURN { .F., "Cannot read the directory " + cRoot + ".", 0 }
   ENDIF
   aPairs := HcZipPairs( cRoot )
   cTmp := cZip + ".$$$"
   cBak := cZip + ".$$$BAK"
   nFiles := HcZipMake( cTmp, aPairs, nLevel, cPassword )
   IF nFiles < 0
      RETURN { .F., "Cannot write " + cTmp + ".", 0 }
   ENDIF
   IF hb_vfExists( cBak )
      hb_vfErase( cBak )
   ENDIF
   IF hb_vfExists( cZip )
      /* hb_vfRename() answers 0 on success, like hb_vfErase() (measured) */
      IF hb_vfRename( cZip, cBak ) != 0
         hb_vfErase( cTmp )
         RETURN { .F., "Cannot replace " + cZip + ": it is in use or read only.", 0 }
      ENDIF
   ENDIF
   IF hb_vfRename( cTmp, cZip ) != 0
      /* the original has to survive: put it back and drop the temporary */
      IF hb_vfExists( cBak )
         hb_vfRename( cBak, cZip )
      ENDIF
      IF hb_vfExists( cTmp )
         hb_vfErase( cTmp )
      ENDIF
      RETURN { .F., "Cannot write " + cZip + ".", 0 }
   ENDIF
   IF hb_vfExists( cBak )
      hb_vfErase( cBak )
   ENDIF
RETURN { .T., "", nFiles }

/* =====================================================================
 *  Zip browsing: the PANEL side (S47..S52)
 *
 *  A panel that browses an archive is a panel whose directory happens to be
 *  inside the working tree the archive was extracted to, so the rest of the
 *  module (navigation, marks, sorting, viewer, editor, Compare and the five
 *  file operations) needs no special case at all. What lives here is the
 *  session: open, close, the virtual path shown in the title, and the dump of
 *  the archive after every change.
 * ===================================================================== */

/* the panel id of a panel record (0 when the record is not one of the two
 * panels, e.g. the literal arrays the headless bank builds) */
STATIC FUNCTION HcZipPanelOf( aP )
   IF ! HB_ISARRAY( aP ) .OR. Len( aP ) < HC_P_ID .OR. ;
      ValType( aP[ HC_P_ID ] ) != "N"
      RETURN 0
   ENDIF
   IF aP[ HC_P_ID ] < HC_PANEL_L .OR. aP[ HC_P_ID ] > HC_PANEL_R
      RETURN 0
   ENDIF
RETURN aP[ HC_P_ID ]

/* the session stack of a panel (never NIL, so the callers can AAdd/ASize) */
STATIC FUNCTION HcZipStack( nId )
   IF ! HB_ISARRAY( s_aHcZip ) .OR. Len( s_aHcZip ) < HC_PANEL_R
      s_aHcZip := { {}, {} }
   ENDIF
   IF nId < 1 .OR. nId > HC_PANEL_R
      RETURN {}
   ENDIF
   IF ! HB_ISARRAY( s_aHcZip[ nId ] )
      s_aHcZip[ nId ] := {}
   ENDIF
RETURN s_aHcZip[ nId ]

/* the session a panel is browsing, NIL when it is a plain directory. A session
 * whose working tree disappeared (deleted outside the program) is dropped here,
 * so a panel never points into a hole. */
STATIC FUNCTION HcZipTop( nId )
   LOCAL aSt := HcZipStack( nId ), z
   DO WHILE ! Empty( aSt )
      z := aSt[ Len( aSt ) ]
      IF HB_ISARRAY( z ) .AND. hb_DirExists( z[ HC_Z_ROOT ] )
         RETURN z
      ENDIF
      ASize( aSt, Len( aSt ) - 1 )
   ENDDO
RETURN NIL

/* deletes a working tree. Windows can keep a handle for a moment (the archive
 * was just written, an editor just closed a file), so it is retried a few
 * times: a stale directory in %TEMP% is not a reason to fail the screen. */
STATIC PROCEDURE HcZipRemoveTree( cRoot )
   LOCAL i
   IF Empty( cRoot ) .OR. ! hb_DirExists( cRoot )
      RETURN
   ENDIF
   FOR i := 1 TO 5
      hb_DirRemoveAll( cRoot )
      IF ! hb_DirExists( cRoot )
         RETURN
      ENDIF
      Inkey( 0.02 )
   NEXT
RETURN

/* a fresh working directory for one session: the temporary directory of the
 * system, never a configuration file and never inside the directory of the
 * archive (S52) */
STATIC FUNCTION HcZipNewRoot()
   LOCAL cBase, cRoot, n := 0
   cBase := hb_GetEnv( "TEMP" )
   IF Empty( cBase ) .OR. ! hb_DirExists( cBase )
      cBase := hb_GetEnv( "TMP" )
   ENDIF
   IF Empty( cBase ) .OR. ! hb_DirExists( cBase )
      cBase := hb_cwd()
   ENDIF
   DO WHILE n < 1000
      n++
      cRoot := HcJoinPath( cBase, "hwbro-zip-" + ;
                           AllTrim( Str( Int( Seconds() ) ) ) + "-" + ;
                           AllTrim( Str( n ) ) )
      IF hb_DirExists( cRoot )
         LOOP
      ENDIF
      hb_DirCreate( HcDirArg( cRoot ) )
      IF hb_DirExists( cRoot )
         RETURN cRoot
      ENDIF
   ENDDO
RETURN ""

/* S51: the password of a crypted archive. NIL means "the user gave up" and the
 * caller opens nothing. It is kept in the session record (memory) and is never
 * written to the log nor to any file. ⚠ the field shows what is typed (this
 * port has no masked input), a limitation documented in the feature document. */
STATIC FUNCTION HcZipAskPass( cZipPath, nTry )
   LOCAL c
   DEFAULT nTry TO 1
   c := UiInput( iif( nTry > 1, "Wrong password. Password again for ", "Password for " ) + ;
                 hb_FNameNameExt( cZipPath ) + ":", "", 40 )
   IF hb_IsNIL( c )
      RETURN NIL
   ENDIF
   c := AllTrim( c )
   IF Empty( c )
      RETURN NIL
   ENDIF
RETURN c

/* S47/S48: opens the CONTENTS of an archive in a panel. It is the only place
 * that decides whether an archive can be browsed, in the order of S47: it is
 * a real zip, it can be REWRITTEN (an archive that cannot be updated is not
 * opened at all) and, when it is crypted, there is a password that really
 * extracts it. Any failure leaves the panel as it was and deletes whatever was
 * extracted. Returns .T. when the panel now browses the archive. */
STATIC FUNCTION HcZipOpenPanel( nId, cZipPath )
   LOCAL aP := HcPanel( nId ), z, cRoot, aRes, cPass := NIL, hChk, nTry := 0
   IF ValType( cZipPath ) != "C" .OR. Empty( AllTrim( cZipPath ) )
      RETURN .F.
   ENDIF
   cZipPath := AllTrim( cZipPath )
   IF ! HcZipIsZip( cZipPath )
      UiErr( "This file is not a zip archive:" + hb_eol() + ;
             hb_FNameNameExt( cZipPath ), "Open archive" )
      RETURN .F.
   ENDIF
   /* S47.2: no write access -> the contents would never reach the archive, so
    * it is not opened (the user chose this rule) */
   hChk := FOpen( cZipPath, FO_READWRITE )
   IF hChk == F_ERROR
      UiErr( "The archive cannot be updated (read only, or in use by another program):" + ;
             hb_eol() + hb_FNameNameExt( cZipPath ) + hb_eol() + ;
             "Make it writable or close what has it open, and try again.", ;
             "Open archive" )
      RETURN .F.
   ENDIF
   FClose( hChk )
   IF HcZipCrypt( cZipPath )
      cPass := HcZipAskPass( cZipPath )
      IF hb_IsNIL( cPass )
         RETURN .F.
      ENDIF
   ENDIF
   DO WHILE .T.
      nTry++
      cRoot := HcZipNewRoot()
      IF Empty( cRoot )
         UiErr( "There is no temporary directory to work in.", "Open archive" )
         RETURN .F.
      ENDIF
      aRes := HcZipExtract( cZipPath, cRoot, cPass )
      IF aRes[ 1 ]
         EXIT
      ENDIF
      HcZipRemoveTree( cRoot )
      IF ! hb_IsNIL( cPass ) .AND. nTry < 3
         /* the only way this build has to validate a password is extracting
          * with it, so a refusal is asked again */
         cPass := HcZipAskPass( cZipPath, nTry + 1 )
         IF hb_IsNIL( cPass )
            RETURN .F.
         ENDIF
         LOOP
      ENDIF
      UiErr( "The archive could not be opened:" + hb_eol() + aRes[ 2 ], "Open archive" )
      RETURN .F.
   ENDDO
   z := { cZipPath, cRoot, cPass, HcZipStamp( cRoot ) }
   AAdd( HcZipStack( nId ), z )
   aP[ HC_P_DIR ] := HcDirArg( cRoot )
   aP[ HC_P_SEL ] := 1
   aP[ HC_P_TOP ] := 1
   HcLoad( aP )
RETURN .T.

/* S48: `..` at the ROOT of the archive leaves the zip instead of climbing out
 * of the working tree: the session closes, its tree is deleted and the panel
 * goes back to the directory that holds the archive, with the cursor on it. */
STATIC PROCEDURE HcZipLeave( nId )
   LOCAL aSt := HcZipStack( nId ), z, aP, cDir, cName
   IF Empty( aSt )
      RETURN
   ENDIF
   z := aSt[ Len( aSt ) ]
   HcZipSync()
   ASize( aSt, Len( aSt ) - 1 )
   IF HB_ISARRAY( z )
      HcZipRemoveTree( z[ HC_Z_ROOT ] )
      cDir := HcParentDir( z[ HC_Z_FILE ] )
      cName := hb_FNameNameExt( z[ HC_Z_FILE ] )
      aP := HcPanel( nId )
      aP[ HC_P_DIR ] := HcDirArg( cDir )
      aP[ HC_P_SEL ] := 1
      aP[ HC_P_TOP ] := 1
      HcLoad( aP )
      HcGotoName( aP, cName )
   ENDIF
RETURN

/* S49/S50: writes back EVERY open archive whose working tree changed, from the
 * INNERMOST session outwards (an archive stored inside another one is a file of
 * the outer tree, so the outer one is rewritten after it). Nothing is written
 * when nothing changed, which is what keeps a copy OUT of the archive, a view
 * or a comparison from touching the archive at all. */
STATIC PROCEDURE HcZipSync()
   LOCAL nId, aSt, i, z, aRes
   FOR nId := HC_PANEL_L TO HC_PANEL_R
      aSt := HcZipStack( nId )
      FOR i := Len( aSt ) TO 1 STEP -1
         z := aSt[ i ]
         IF ! HB_ISARRAY( z )
            LOOP
         ENDIF
         IF HcZipStamp( z[ HC_Z_ROOT ] ) == z[ HC_Z_STAMP ]
            LOOP
         ENDIF
         aRes := HcZipRepack( z[ HC_Z_FILE ], z[ HC_Z_ROOT ], z[ HC_Z_PASS ], HC_Z_LEVEL )
         IF ! aRes[ 1 ]
            /* the stamp is NOT updated: the next operation tries again */
            UiErr( "The archive could not be updated:" + hb_eol() + ;
                   hb_FNameNameExt( z[ HC_Z_FILE ] ) + hb_eol() + aRes[ 2 ], "Zip" )
            RETURN
         ENDIF
         z[ HC_Z_STAMP ] := HcZipStamp( z[ HC_Z_ROOT ] )
      NEXT
   NEXT
RETURN

/* S52: closes every session and deletes its working tree. It runs when the
 * PROGRAM ends (Main()), not when the screen is left: the Commander is
 * re-entered with the browse alive (HcReuse keeps the directory). Nothing is
 * written here: write-through already happened after each operation, and a
 * failed dump was reported at that moment. */
PROCEDURE HcZipCleanupAll()
   LOCAL nId, aSt, i
   FOR nId := HC_PANEL_L TO HC_PANEL_R
      aSt := HcZipStack( nId )
      FOR i := 1 TO Len( aSt )
         IF HB_ISARRAY( aSt[ i ] )
            HcZipRemoveTree( aSt[ i ][ HC_Z_ROOT ] )
         ENDIF
      NEXT
      IF nId >= 1 .AND. nId <= Len( s_aHcZip )
         s_aHcZip[ nId ] := {}
      ENDIF
   NEXT
RETURN

/* S48/S49: the SAME path in the two languages - a path inside a working tree
 * is shown as the archive plus the relative part and the other way round. PURE
 * on one session (that is what makes it testable); the two module level
 * helpers below walk the open sessions, so a dialog speaks the language of the
 * title and a typed answer is translated back to the filesystem. */
FUNCTION HcZipMapPath( cZip, cRoot, cPath )
   LOCAL cReal, cRealR, cRealZ, cNorm, cNormR, cNormZ, cRel
   IF ValType( cZip ) != "C" .OR. ValType( cRoot ) != "C" .OR. ValType( cPath ) != "C"
      RETURN ""
   ENDIF
   IF Empty( AllTrim( cZip ) ) .OR. Empty( AllTrim( cRoot ) ) .OR. Empty( AllTrim( cPath ) )
      RETURN cPath
   ENDIF
   cReal  := HcDirNoSep( AllTrim( cPath ) )
   cNorm  := HcNormPath( cPath )
   cNormR := HcNormPath( HcDirArg( HcDirNoSep( cRoot ) ) )
   IF ! Empty( cNormR ) .AND. Left( cNorm, Len( cNormR ) ) == cNormR
      cRealR := HcDirArg( HcDirNoSep( cRoot ) )
      cRel := SubStr( cReal, Len( cRealR ) + 1 )
      RETURN iif( Empty( cRel ), HcDirNoSep( cZip ), HcDirNoSep( cZip ) + "\" + cRel )
   ENDIF
   cNormZ := HcNormPath( HcDirArg( HcDirNoSep( cZip ) ) )
   IF ! Empty( cNormZ ) .AND. Left( cNorm, Len( cNormZ ) ) == cNormZ
      cRealZ := HcDirArg( HcDirNoSep( cZip ) )
      cRel := SubStr( cReal, Len( cRealZ ) + 1 )
      RETURN iif( Empty( cRel ), HcDirNoSep( cRoot ), HcDirNoSep( cRoot ) + "\" + cRel )
   ENDIF
RETURN cPath

/* S48: a real path written the way the user sees it (dialog default) */
FUNCTION HcZipShowPath( cPath )
   LOCAL nId, aSt, i, c
   IF ValType( cPath ) != "C" .OR. Empty( cPath )
      RETURN cPath
   ENDIF
   FOR nId := HC_PANEL_L TO HC_PANEL_R
      aSt := HcZipStack( nId )
      FOR i := Len( aSt ) TO 1 STEP -1
         IF HB_ISARRAY( aSt[ i ] )
            c := HcZipMapPath( aSt[ i ][ HC_Z_FILE ], aSt[ i ][ HC_Z_ROOT ], cPath )
            IF ! ( Upper( c ) == Upper( HcDirNoSep( cPath ) ) )
               RETURN c
            ENDIF
         ENDIF
      NEXT
   NEXT
RETURN cPath

/* S48/S49: a path typed the way the user sees it, translated back to the
 * filesystem (NIL when it belongs to no open archive) */
FUNCTION HcZipRealPath( cPath )
   LOCAL nId, aSt, i, c, cNorm
   IF ValType( cPath ) != "C" .OR. Empty( cPath )
      RETURN cPath
   ENDIF
   cNorm := HcNormPath( HcDirNoSep( AllTrim( cPath ) ) )
   FOR nId := HC_PANEL_L TO HC_PANEL_R
      aSt := HcZipStack( nId )
      FOR i := Len( aSt ) TO 1 STEP -1
         IF HB_ISARRAY( aSt[ i ] )
            IF Left( cNorm, Len( HcNormPath( aSt[ i ][ HC_Z_FILE ] ) ) ) == ;
               HcNormPath( aSt[ i ][ HC_Z_FILE ] )
               c := HcZipMapPath( aSt[ i ][ HC_Z_FILE ], aSt[ i ][ HC_Z_ROOT ], cPath )
               IF ! ( Upper( c ) == Upper( HcDirNoSep( cPath ) ) )
                  RETURN c
               ENDIF
            ENDIF
         ENDIF
      NEXT
   NEXT
RETURN cPath

/* S42.6/S42.7: what a click on the Add to zip dialog means. The control comes
 * from the shared control table (HcSyncCtlAdd(), looked up with HcSyncCtlAt()):
 * a row { nRow, nCol, nW, cKind, cArg } with cKind "ZOPT" (cArg = 1..3, the
 * compression option), "ZFLD" (cArg = 2 file name, 3 password) or "ZBTN"
 * (cArg = 4 Accept, 5 Cancel). Answers { nFoc, nLvl, lEdit, lAct }: the new
 * focus, the new compression level, whether the click means "enter the editor"
 * (the same as Enter on that field) and whether it means "press the button"
 * (the same as Enter on that button). PURE and tolerant: NIL, a foreign control
 * or a nonsense option index leave the state exactly as it was, so a click
 * outside the box can never throw away a half typed password. */
FUNCTION HcZipClick( aCtl, nFoc, nLvl )
   LOCAL nCur := nFoc, nLev := nLvl, lEdit := .F., lAct := .F.
   IF ! HB_ISARRAY( aCtl ) .OR. Len( aCtl ) < 5
      RETURN { nCur, nLev, lEdit, lAct }
   ENDIF
   DO CASE
   CASE aCtl[ 4 ] == "ZOPT"
      nCur := ZF_LEVEL               /* the compression row owns the focus */
      IF ValType( aCtl[ 5 ] ) == "N" .AND. aCtl[ 5 ] >= 1 .AND. aCtl[ 5 ] <= 3
         nLev := aCtl[ 5 ]
      ENDIF
   CASE aCtl[ 4 ] == "ZFLD"
      IF aCtl[ 5 ] == ZF_NAME .OR. aCtl[ 5 ] == ZF_PASS
         /* the field that ALREADY has the focus is the one that enters the
          * editor, so this compares against the focus it was given */
         lEdit := ( aCtl[ 5 ] == nCur )
         nCur := aCtl[ 5 ]
      ENDIF
   CASE aCtl[ 4 ] == "ZBTN"
      /* S42.7: a click on a button focuses it AND presses it, exactly like
       * Enter on the focused button; the action still runs in the key DO CASE */
      IF aCtl[ 5 ] == ZF_ACCEPT .OR. aCtl[ 5 ] == ZF_CANCEL
         nCur := aCtl[ 5 ]
         lAct := .T.
      ENDIF
   ENDCASE
RETURN { nCur, nLev, lEdit, lAct }

/* S42.7: the FOCUS RING of the Add to zip dialog, in the order the user sees
 * it: the compression group, the file name, the password, Accept and Cancel.
 * ONE table, so the keys, the quick letters and the click cannot disagree. */
FUNCTION HcZipRing()
RETURN { ZF_LEVEL, ZF_NAME, ZF_PASS, ZF_ACCEPT, ZF_CANCEL }

/* S42.7: the next stop of the ring, wrapping at both ends. A nonsense nFrom
 * answers the first stop, so a key can never leave the focus in mid-air. */
FUNCTION HcZipFocusStep( nFrom, lBack )
   LOCAL aRing := HcZipRing(), i
   IF ValType( nFrom ) != "N" .OR. nFrom < 1 .OR. nFrom > Len( aRing )
      RETURN aRing[ 1 ]
   ENDIF
   FOR i := 1 TO Len( aRing )
      IF aRing[ i ] == Int( nFrom )
         IF ValType( lBack ) == "L" .AND. lBack
            RETURN aRing[ iif( i == 1, Len( aRing ), i - 1 ) ]
         ENDIF
         RETURN aRing[ iif( i == Len( aRing ), 1, i + 1 ) ]
      ENDIF
   NEXT
RETURN aRing[ 1 ]

/* S42.7: the quick letter of the dialog as the stop it activates, or 0. One
 * letter per BUTTON inside its own label (`~A~ccept`, `~C~ancel`) and the chord
 * is `Alt+<letter>`. PURE and strict: ONE character, case-insensitive, and
 * anything else (NIL, "", two characters, a number) answers 0. */
FUNCTION HcZipHot( cCh )
   LOCAL c := ""
   IF ValType( cCh ) == "C" .AND. Len( AllTrim( cCh ) ) == 1
      c := Upper( AllTrim( cCh ) )
   ENDIF
   DO CASE
   CASE c == "A"
      RETURN ZF_ACCEPT
   CASE c == "C"
      RETURN ZF_CANCEL
   ENDCASE
RETURN 0

/* ---- S42.7: the painters of the dialog --------------------------------------
 * Both REGISTER the control they paint in the shared table (HcSyncCtlAdd()), so
 * the click is the same key and there is no second copy of the geometry. The
 * colours are the ones of the form screens (odd/tasks/hc-ctx-add-zip.md):
 *   - the compression options are ONE stop of the ring painted like the
 *     checkboxes of a form: the [X] tells the level, the resting pair is flat on
 *     the box (UI_C_FLATBG for the selected one) and the focus paints the three;
 *   - a button rests flat (UI_C_FLATBG) with its letter in UI_C_HOT and the
 *     focus is UI_C_BOXSEL with the letter in UI_C_HOTSEL. */

STATIC PROCEDURE HcZipOpt( nRow, nCol, cLabel, nLvl, lOn, lFocus )
   LOCAL cTxt := "[" + iif( lOn, "X", " " ) + "] " + PadR( cLabel, 9 )
   LOCAL cCol := iif( lFocus, UI_C_LISTSEL, iif( lOn, UI_C_FLATBG, UI_C_BOX ) )
   SetColor( cCol )
   @ nRow, nCol SAY cTxt
   HcSyncCtlAdd( nRow, nCol, 13, "ZOPT", nLvl )
   SetColor( UI_C_BOX )
RETURN

/* visible width of a button: `[ ` + label + ` ]`, without the ~ marks */
STATIC FUNCTION HcZipBtnW( cLabel )
RETURN Len( StrTran( cLabel, "~", "" ) ) + 4

STATIC PROCEDURE HcZipButton( nRow, nCol, cLabel, lFocus, nStop )
   LOCAL nW := HcZipBtnW( cLabel )
   LOCAL cCol := iif( lFocus, UI_C_BOXSEL, UI_C_FLATBG )
   LOCAL cHot := iif( lFocus, UI_C_HOTSEL, UI_C_HOT )
   SetColor( cCol )
   @ nRow, nCol SAY Space( nW )
   UiDrawHot( nRow, nCol, "[ " + cLabel + " ]", cCol, cHot )
   HcSyncCtlAdd( nRow, nCol, nW, "ZBTN", nStop )
   SetColor( UI_C_BOX )
RETURN

/* S42.3/S42.7: the dialog. Returns { cName, nLevel, cPassword } or NIL if
 * cancelled. The box is 70 wide (S42.3, L3: the hint row is GONE) and now 10 tall:
 * the two buttons took the row the hints never had. The keys: Up/Down/Tab walk
 * the ring, Left/Right or Space choose the compression, Enter edits the focused
 * field or presses the focused button, Ctrl-S and the Accept button accept, Esc
 * and Cancel cancel, and Alt-A / Alt-C press the two buttons from anywhere
 * (inside a field editor too). S42.6: the options, the two fields and the two
 * buttons are clickable - they are registered in the shared control table WHILE
 * PAINTING, so there is no second copy of the geometry, and a click only sets
 * state (HcZipClick() decides). */
STATIC FUNCTION HcZipDialog( cDef )
   LOCAL cName := cDef, cPass := "", nLvl := 3, nFoc := ZF_LEVEL, nKey, lOk := .F.
   LOCAL nT, nL, nB, nR, cSave, cOldCur, i, nCol, cShow, aCtl, aHit
   LOCAL xDummy, lPaint := .T.
   LOCAL aLvl := { 0, 6, 9 }, aLbl := { "Store", "Normal", "Maximum" }
   /* S42.7: the chord of the pass, the chord a field editor closed on, the value
    * the editor answered and the ONE flag that accepts the dialog */
   LOCAL nShift, cAlt, cRing, cChord := "", cNew, lAccept := .F., nHot, nBtnW
   /* S42.7: the box is sized from the CANVAS (the 120 wide one gives the 70 it
    * always had; the floor is what the compression row needs) and it is taller
    * by the two rows of the buttons + the blank above them. */
   nR := Max( 56, UiCols() - 50 )
   nR := Min( nR, MaxCol() - 10 )
   nB := 9
   nT := UiFitRow( UiCenterRow( nB ), nB + 1 )
   nL := UiFitCol( UiCenterCol( nR ), nR + 1 )
   cOldCur := SetCursor( 0 )
   /* saved one row and one column wider than the frame: the shadow goes there */
   cSave := SaveScreen( nT, nL, nT + nB + 1, Min( nL + nR + 1, MaxCol() ) )
   /* S42.7: an Alt chord recorded BEFORE this box opened belongs to nobody */
   HcAltHookFlush()
   DO WHILE .T.
      /* S42.6: the mouse makes the loop poll, so the whole box is painted only
       * when something CHANGED (focus, level, name); painting it 20 times a
       * second would flicker and burn the CPU for nothing */
      IF lPaint
         UiPaintBegin()
         HcSyncCtlReset()            /* S42.6: the clickable controls, rebuilt */
         UiShadow( nT, nL, nT + nB, nL + nR )
         UiFillBox( nT, nL, nT + nB, nL + nR, UI_C_BOX )
         UiFrame( nT, nL, nT + nB, nL + nR, UI_C_BOX, .T. )
         SetColor( UI_C_BOX )
         @ nT, nL + 2 SAY " Add to zip "
         @ nT + 2, nL + 2 SAY "Compression:"
         nCol := nL + 16
         FOR i := 1 TO 3
            HcZipOpt( nT + 2, nCol, aLbl[ i ], i, nLvl == i, nFoc == ZF_LEVEL )
            nCol += 13
         NEXT
         SetColor( UI_C_BOX )
         @ nT + 4, nL + 2 SAY "File name:"
         @ nT + 6, nL + 2 SAY "Password:"
         /* the label AND the field are one control each: a click on either one
          * focuses that field */
         HcSyncCtlAdd( nT + 4, nL + 2, nR - 4, "ZFLD", ZF_NAME )
         HcSyncCtlAdd( nT + 6, nL + 2, nR - 4, "ZFLD", ZF_PASS )
         /* S42.7: an input rests on the soft UI_C_FIELDBG and the focus uses the
          * ONE focus colour of the program (UI_C_LISTSEL) */
         SetColor( iif( nFoc == ZF_NAME, UI_C_LISTSEL, UI_C_FIELDBG ) )
         @ nT + 4, nL + 14 SAY PadR( cName, nR - 16 )
         /* the password is shown as asterisks except while it is being edited */
         cShow := iif( nFoc == ZF_PASS, PadR( cPass, nR - 16 ), ;
                       PadR( Replicate( "*", Len( cPass ) ), nR - 16 ) )
         SetColor( iif( nFoc == ZF_PASS, UI_C_LISTSEL, UI_C_FIELDBG ) )
         @ nT + 6, nL + 14 SAY cShow
         /* S42.7: the two buttons, as a CENTRED pair on the last content row */
         nBtnW := HcZipBtnW( "~A~ccept" ) + 3 + HcZipBtnW( "~C~ancel" )
         nCol  := nL + Int( ( nR - nBtnW ) / 2 )
         HcZipButton( nT + 8, nCol, "~A~ccept", nFoc == ZF_ACCEPT, ZF_ACCEPT )
         HcZipButton( nT + 8, nCol + HcZipBtnW( "~A~ccept" ) + 3, ;
                      "~C~ancel", nFoc == ZF_CANCEL, ZF_CANCEL )
         UiPaintEnd()
         lPaint := .F.
      ENDIF
      /* S42.6: a short poll, like the right button panel, so a click is
       * noticed; 0 means "nothing was typed". The click is consumed HERE, so
       * it cannot leak into the panel behind the dialog. */
      nKey := Inkey( 0.05 )
      /* S42.7: the shift state is read IMMEDIATELY after Inkey() (trap 37) and
       * the Alt chord comes from the ring of the window hook FIRST: inside a
       * modal Inkey() may swallow the letter (trap 61). */
      nShift := HcShiftState()
      cAlt := ""
      cRing := HcHookDrain()
      IF Len( cRing ) > 0
         cAlt := Upper( Left( cRing, 1 ) )
         nKey := 0
      ELSE
         cAlt := HcAltLetter( nKey, nShift )
         IF ! Empty( cAlt )
            nKey := 0
         ENDIF
      ENDIF
      IF ! Empty( cAlt )
         nHot := HcZipHot( cAlt )
         IF nHot != 0
            nFoc := nHot
            nKey := K_ENTER             /* the button acts through the same CASE */
            lPaint := .T.
         ENDIF
      ENDIF
      /* right-click-esc (S1/S2/S7): a plain right click cancels the dialog,
       * the same as Esc and as its Cancel button */
      IF nKey == 0 .AND. HcMouseRightClick()
         nKey := K_ESC
      ENDIF
      IF nKey == 0
         aCtl := HcSyncCtlAt( HcMouseClickRow(), HcMouseClickCol() )
         xDummy := HcMouseClickDbl()      /* read once: it must not leak */
         /* the wheel does NOTHING here (the dialog has no list to scroll), but
          * the notch is CONSUMED so it cannot scroll the panel behind once the
          * dialog is gone */
         xDummy := HcMouseWheel()
         aHit := HcZipClick( aCtl, nFoc, nLvl )
         IF aHit[ 1 ] != nFoc .OR. aHit[ 2 ] != nLvl
            nFoc := aHit[ 1 ]
            nLvl := aHit[ 2 ]
            lPaint := .T.
         ENDIF
         IF aHit[ 3 ] .OR. aHit[ 4 ]
            /* S42.7: a click edits the field, or PRESSES the button, exactly
             * like Enter on it */
            nKey := K_ENTER
         ELSE
            LOOP                         /* a click outside the box changes nothing */
         ENDIF
      ENDIF

      DO CASE
      CASE nKey == K_ESC
         EXIT
      /* S42.7: Ctrl-S applies, exactly like the Accept button (the form
       * convention: the chord and the key run the SAME path) */
      CASE HcSaveKey( nKey, nShift )
         nFoc := ZF_ACCEPT
         nKey := K_ENTER
         lPaint := .T.
      CASE nKey == K_TAB .OR. nKey == K_DOWN
         nFoc := HcZipFocusStep( nFoc, .F. )
         lPaint := .T.
      CASE nKey == K_SH_TAB .OR. nKey == K_UP
         nFoc := HcZipFocusStep( nFoc, .T. )
         lPaint := .T.
      CASE nFoc == ZF_LEVEL .AND. ( nKey == K_LEFT .OR. nKey == K_RIGHT .OR. nKey == K_SPACE )
         IF nKey == K_LEFT
            nLvl := iif( nLvl == 1, 3, nLvl - 1 )
         ELSE
            nLvl := iif( nLvl == 3, 1, nLvl + 1 )
         ENDIF
         lPaint := .T.
      CASE nKey == K_ENTER .OR. ( nKey == K_SPACE .AND. nFoc >= ZF_ACCEPT )
         DO CASE
         CASE nFoc == ZF_LEVEL
            nFoc := ZF_NAME
            lPaint := .T.
         CASE nFoc == ZF_NAME
            cNew := UiLineEdit( nT + 4, nL + 14, nR - 16, cName, .F., UI_C_LISTSEL )
            /* S42.7: a chord typed INSIDE the field closes it and is served
             * HERE (UiAltChord() consumes it); the ring is flushed so a letter
             * typed in the field cannot fire a second time */
            cChord := UiAltChord()
            HcAltHookFlush()
            IF ! hb_IsNIL( cNew )
               cName := iif( Len( AllTrim( cNew ) ) == 0, cDef, cNew )
               nFoc := ZF_PASS
            ENDIF
            IF HcZipHot( cChord ) == ZF_ACCEPT
               lAccept := .T.
            ELSEIF HcZipHot( cChord ) == ZF_CANCEL
               EXIT
            ENDIF
            lPaint := .T.
         CASE nFoc == ZF_PASS
            cNew := UiLineEdit( nT + 6, nL + 14, nR - 16, cPass, .F., UI_C_LISTSEL )
            cChord := UiAltChord()
            HcAltHookFlush()
            IF ! hb_IsNIL( cNew )
               cPass   := cNew
               lAccept := .T.            /* the shortcut it always had: Enter there creates */
            ENDIF
            IF HcZipHot( cChord ) == ZF_ACCEPT
               lAccept := .T.
            ELSEIF HcZipHot( cChord ) == ZF_CANCEL
               EXIT
            ENDIF
            lPaint := .T.
         CASE nFoc == ZF_ACCEPT
            lAccept := .T.
         OTHERWISE
            EXIT                         /* the Cancel button */
         ENDCASE
      ENDCASE
      /* S42.7: ONE place where the dialog accepts. The Accept button (Enter,
       * Space, a click or Alt-A), Ctrl-S and the Enter of the password field
       * only set lAccept; this is what turns it into the answer. */
      IF lAccept
         lOk := .T.
         EXIT
      ENDIF
   ENDDO
   RestScreen( nT, nL, nT + nB + 1, Min( nL + nR + 1, MaxCol() ), cSave )
   SetCursor( cOldCur )
RETURN iif( lOk, { RTrim( cName ), aLvl[ nLvl ], RTrim( cPass ) }, NIL )

/* S42: the whole option, with its user interface: dialog, confirmation before
 * overwriting and the report of what was written. The zip ALWAYS goes to the
 * current directory of the panel. */
STATIC PROCEDURE HcZipStart( aP )
   LOCAL aPairs, aDlg, cZip, nOk
   aPairs := HcZipTargets( aP )
   IF Empty( aPairs )
      UiInfo( "There is nothing to add to a zip here.", "Add to zip" )
      RETURN
   ENDIF
   aDlg := HcZipDialog( HcZipDefaultName( aP ) )
   IF ! HB_ISARRAY( aDlg )
      RETURN
   ENDIF
   cZip := HcDirNoSep( aP[ HC_P_DIR ] ) + "\" + aDlg[ 1 ]
   IF Empty( hb_FNameExt( cZip ) )
      cZip += ".zip"
   ENDIF
   IF hb_vfExists( cZip )
      IF ! UiConfirm( "Overwrite " + hb_FNameNameExt( cZip ) + "?", "Add to zip" )
         RETURN
      ENDIF
   ENDIF
   nOk := HcZipMake( cZip, aPairs, aDlg[ 2 ], aDlg[ 3 ] )
   IF nOk <= 0
      UiErr( "The zip could not be created:" + hb_eol() + hb_FNameNameExt( cZip ), ;
             "Add to zip" )
      RETURN
   ENDIF
   /* S42: the listing is reloaded and REPAINTED here: this runs from the mouse
    * poll, so no key sets the repaint flags of the main loop and the new .zip
    * did not show up until the next movement (reported) */
   HcLoad( aP )
   HcDrawScreen()
RETURN

/* S98: the whole box, drawn in the paint block of the caller - the block
 * shadow, the interior, a SINGLE frame and the entries the window shows. It is
 * the same picture HcMenuDrawDrop() paints for a dropdown of the menu bar, with
 * the same colours: UI_C_BOX for the interior and the frame and UiShadow() for
 * the shadow, which lands OUTSIDE the rectangle HcCtxBox() returns (two cells
 * to the right and one row below, so the 15x10 footprint of S38 never moves). */
STATIC PROCEDURE HcCtxDraw( aBox, aItems, nSel, nTop )
   LOCAL i, nLast
   UiShadow( aBox[ 1 ], aBox[ 2 ], aBox[ 3 ], aBox[ 4 ] )
   UiFillBox( aBox[ 1 ], aBox[ 2 ], aBox[ 3 ], aBox[ 4 ], UI_C_BOX )
   UiFrame( aBox[ 1 ], aBox[ 2 ], aBox[ 3 ], aBox[ 4 ], UI_C_BOX, .F. )
   /* only the entries the window can show: a list longer than the box scrolls,
    * it is never painted over the bottom frame */
   nLast := Min( nTop + HcCtxRows( aBox ) - 1, Len( aItems ) )
   FOR i := nTop TO nLast
      HcCtxRow( aBox, aItems, i, nTop, i == nSel )
   NEXT
   SetColor( UI_C_DESKTOP )
RETURN

/* S98: moves the highlight to nNew and repaints ONLY what changed - the two
 * rows it leaves and reaches, or the whole body when the window scrolled (a
 * list longer than the box). One paint block, like the arrow of every screen of
 * this module. nSel and nTop come by reference: they are the state of the box. */
STATIC PROCEDURE HcCtxSelect( aBox, aItems, nNew, nSel, nTop )
   LOCAL nOld := nSel, nOldTop, i, nLast
   IF ! HB_ISARRAY( aItems ) .OR. ValType( nNew ) != "N"
      RETURN
   ENDIF
   IF nNew < 1 .OR. nNew > Len( aItems )
      RETURN
   ENDIF
   nOldTop := nTop
   nSel := nNew
   nTop := HcCtxTop( nSel, nTop, HcCtxRows( aBox ), Len( aItems ) )
   IF nSel == nOld .AND. nTop == nOldTop
      RETURN
   ENDIF
   UiPaintBegin()
   IF nTop != nOldTop
      /* the window scrolled: every visible line now shows another entry */
      nLast := Min( nTop + HcCtxRows( aBox ) - 1, Len( aItems ) )
      FOR i := nTop TO nLast
         HcCtxRow( aBox, aItems, i, nTop, i == nSel )
      NEXT
   ELSE
      HcCtxRow( aBox, aItems, nOld, nTop, .F. )
      HcCtxRow( aBox, aItems, nSel, nTop, .T. )
   ENDIF
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()
RETURN

/* S38: is the hold long enough? Pure, so the headless bank can pin the 1 s rule
 * and every case that must NEVER open the panel.
 *
 * S7: the OPTIONAL sixth argument says the press landed inside the BODY of the
 * panel (HcCtxBodyRow()), so a press on one of the EMPTY rows below the last
 * entry opens the menu of the entry under the cursor. Without it the press had
 * to be on a listed entry, which is the rule of S38 and stays untouched for the
 * callers - and the assertions - that pass five arguments. */
FUNCTION HcCtxHoldDue( nElapsed, lDrag, lMoved, lOpened, nIdx, lInBody )
   IF ! lDrag .OR. lMoved .OR. lOpened
      RETURN .F.
   ENDIF
   IF PCount() < 6 .OR. lInBody != .T.
      IF ValType( nIdx ) != "N" .OR. nIdx < 1
         RETURN .F.                  /* the press was not on a listed entry */
      ENDIF
   ENDIF
   IF ValType( nElapsed ) != "N"
      RETURN .F.
   ENDIF
RETURN nElapsed >= HC_CTX_HOLD

/* S7: is a row of the canvas inside the BODY of a panel - the entry rows and
 * the empty rows below the last entry (HC_ROW_FIRST..HC_ROW_LAST)? A right press
 * there opens the menu of the entry under the cursor; the title, the header and
 * the rule above it, and the frame rows, do not. Pure, so the headless bank
 * pins the boundaries without a window. */
FUNCTION HcCtxBodyRow( nRow )
   IF ValType( nRow ) != "N"
      RETURN .F.
   ENDIF
RETURN nRow >= HC_ROW_FIRST .AND. nRow <= HC_ROW_LAST

/* S98: how many entries the box can show - the interior of the frame. A list
 * longer than this SCROLLS (see HcCtxTop()) instead of being painted over the
 * bottom frame or past MaxRow(). Pure, so the headless bank pins it. */
FUNCTION HcCtxRows( aBox )
   IF ! HB_ISARRAY( aBox ) .OR. Len( aBox ) < 4
      RETURN 0
   ENDIF
RETURN Max( 0, aBox[ 3 ] - aBox[ 1 ] - 1 )

/* S98: first entry the box shows so that nSel is visible. The window never
 * runs past the end of the list and never jumps further than it has to: the
 * highlight walks down a scrolled list one row at a time and the body only
 * moves when the cursor reaches an edge (the same behaviour as the panels).
 * Pure, so the headless bank pins the scroll. */
FUNCTION HcCtxTop( nSel, nTop, nRows, nLen )
   LOCAL n
   IF ValType( nSel ) != "N" .OR. ValType( nTop ) != "N" .OR. ;
      ValType( nRows ) != "N" .OR. ValType( nLen ) != "N"
      RETURN 1
   ENDIF
   IF nRows < 1 .OR. nLen < 1
      RETURN 1
   ENDIF
   /* the window cannot start before the first entry nor end past the last */
   n := Min( Max( 1, nTop ), Max( 1, nLen - nRows + 1 ) )
   IF nSel < n
      n := nSel
   ELSEIF nSel > n + nRows - 1
      n := nSel - nRows + 1
   ENDIF
RETURN Min( Max( 1, n ), Max( 1, nLen ) )

/* S98: entry of the list under a screen row of the box, or 0 for a row that
 * carries no entry (the frame, an empty line of a short list). The whole
 * interior row is the target, as in Norton Commander, and the index is the very
 * one the arrows reach: the click and the key can never disagree.
 * Pure, so the headless bank pins the mapping. */
FUNCTION HcCtxHit( aBox, nTop, nLen, nRow )
   LOCAL n
   IF ! HB_ISARRAY( aBox ) .OR. Len( aBox ) < 4
      RETURN 0
   ENDIF
   IF ValType( nTop ) != "N" .OR. ValType( nLen ) != "N" .OR. ValType( nRow ) != "N"
      RETURN 0
   ENDIF
   n := nRow - aBox[ 1 ]                 /* 1 = the first interior row */
   IF n < 1 .OR. n > aBox[ 3 ] - aBox[ 1 ] - 1
      RETURN 0                           /* a frame row or outside the box */
   ENDIF
   n := n + Max( 1, nTop ) - 1
   IF n < 1 .OR. n > nLen
      RETURN 0                           /* an empty line: no entry there */
   ENDIF
RETURN n

/* S98: .T. when a cell is inside the box, its frame included. A click there is
 * "inside the menu" - only a row of it acts and anything else is ignored - and
 * a click outside closes it the way Esc does, exactly the rule the dropdowns of
 * the bar follow (HcMenuInside()). Pure, so the headless bank pins it. */FUNCTION HcCtxInside( aBox, nRow, nCol )
   IF ! HB_ISARRAY( aBox ) .OR. Len( aBox ) < 4
      RETURN .F.
   ENDIF
   IF ValType( nRow ) != "N" .OR. ValType( nCol ) != "N"
      RETURN .F.
   ENDIF
RETURN nRow >= aBox[ 1 ] .AND. nRow <= aBox[ 3 ] .AND. ;
       nCol >= aBox[ 2 ] .AND. nCol <= aBox[ 4 ]

/* S6: the entry the POINTER is over, or 0 when hovering there must change
 * nothing. It is the mapping of a pointer cell to the index to highlight and it
 * is deliberately the SAME rule the click follows (HcCtxInside + HcCtxHit), so
 * the row the mouse hovers is the row a click would run and the highlight can
 * never sit somewhere else than the pointer:
 *   - outside the box (the shadow band included), above the first entry or
 *     below the last one       -> 0
 *   - the frame rows, and the empty lines of a list shorter than the box -> 0
 *   - a line that carries an entry -> that index (with the list scrolled, the
 *     entry that line shows)
 * Pure: no window, no state - the headless bank pins every case. */
FUNCTION HcCtxHoverIdx( aBox, nTop, nLen, nRow, nCol )
   LOCAL nHit
   IF ! HcCtxInside( aBox, nRow, nCol )
      RETURN 0                        /* outside, or on the shadow: no change */
   ENDIF
   nHit := HcCtxHit( aBox, nTop, nLen, nRow )
   IF nHit < 1
      RETURN 0                        /* the frame or an empty line: no entry */
   ENDIF
RETURN nHit

/* S6/S7 of odd/tasks/commander-cleanup.md: where the highlight goes when the
 * pointer is over a row of a menu. The rule is the one every Windows menu
 * follows, and the user asked for it twice: "the selected item follows the
 * pointer".
 *   - a row WITH A LABEL is highlighted, even when it is dimmed: the pointer is
 *     honoured and the row it points at is the one that looks selected. Whether
 *     that row can be RUN is a different question, and the CLICK, the arrows,
 *     Enter and the hot letters keep asking HcCtxOk()/BpNavOk() exactly as
 *     before - a dimmed row is never executed.
 *   - a row with NO label (a separator / a rule), the frame or anything outside
 *     the box: the first row WITH A LABEL below it, and when there is none the
 *     one above. A rule is not a place where a highlight can live.
 * PURE: the popups of this module and the menus of hwbro.prg share it. */
FUNCTION HcCtxHoverSnap( aItems, nHit )
   LOCAL i
   IF ! HB_ISARRAY( aItems ) .OR. ValType( nHit ) != "N" .OR. nHit < 1
      RETURN 0
   ENDIF
   IF nHit > Len( aItems )
      RETURN 0
   ENDIF
   IF HcCtxHasLabel( aItems[ nHit ] )
      RETURN nHit
   ENDIF
   FOR i := nHit + 1 TO Len( aItems )
      IF HcCtxHasLabel( aItems[ i ] )
         RETURN i
      ENDIF
   NEXT
   FOR i := nHit - 1 TO 1 STEP -1
      IF HcCtxHasLabel( aItems[ i ] )
         RETURN i
      ENDIF
   NEXT
RETURN 0

/* .T. when the row carries a visible label - i.e. it is not a separator. It is
 * the only thing the hover asks; "can it be run" is HcCtxOk()/BpNavOk()'s job. */
FUNCTION HcCtxHasLabel( aIt )
   IF ! HB_ISARRAY( aIt )
      RETURN .F.
   ENDIF
RETURN ValType( aIt[ 1 ] ) == "C" .AND. ! Empty( aIt[ 1 ] )

/* S38/S1: the box of the panel, placed on the cell of the press and always
 * inside the canvas, so a press near the right or the bottom edge moves the
 * panel instead of cutting it. Returns { top, left, bottom, right }.
 *
 * With the TWO arguments of S38 it is the 15x10 footprint the user asked for
 * and the bank pins. The OPTIONAL third argument is the number of entries of
 * the list: the box then grows with its content - one row per entry plus the
 * two of the frame, and one column per character of the widest label plus the
 * two of the frame - instead of cutting the list or painting over the frame.
 * The height does NOT keep the 10 rows of S38: a three-entry menu is five rows
 * tall (frame + three), because the empty rows of the footprint read as a
 * broken box (reported for the Copy / Cut / Paste menu of the editor).
 *
 * The OPTIONAL fourth argument (S6 of browse-edit-mouse.md) is the width of the
 * widest label of THAT list, because the size of the third argument is measured
 * on the lists of the manager: a longer label (the record menu of the Browse
 * edit) was cut by HcCtxRow(). A row needs the label, one column of air and the
 * two of the frame.
 * Every size is clamped to the canvas, so a list that cannot fit stays inside
 * the screen (and no size here is a literal of an 80x25 grid). */
FUNCTION HcCtxBox( nRow, nCol, nCount, nLabelW )
   LOCAL nT, nL, nW := HC_CTX_W, nH := HC_CTX_H
   IF ValType( nCount ) == "N" .AND. nCount > 0
      /* the height IS the content: the 15x10 footprint of S38 is only the
       * two-argument default, measured on the lists of the manager */
      nH := nCount + 2
      nW := Max( HC_CTX_W, HcCtxLabelW() + 2 )
   ENDIF
   IF ValType( nLabelW ) == "N" .AND. nLabelW > 0
      nW := Max( nW, nLabelW + 3 )
   ENDIF
   nH := Min( nH, MaxRow() + 1 )
   nW := Min( nW, MaxCol() + 1 )
   nT := Min( Max( 0, nRow ), Max( 0, MaxRow() - ( nH - 1 ) ) )
   nL := Min( Max( 0, nCol ), Max( 0, MaxCol() - ( nW - 1 ) ) )
RETURN { nT, nL, nT + nH - 1, nL + nW - 1 }

/* S38/S7: what the panel is about, as { cName, lIsDir }.
 *
 * The PRESSED row decides when it carries a real entry: HcCtxOpen() moves the
 * cursor there before the menu is built (AGENTS trap 42), so the menu and the
 * highlighted row of the panel can never disagree.
 *
 * S7 (the user: "El click derecho ... debe funcionar haciendo click derecho
 * sobre cualquier parte del panel. Y las opciones deben ser respecto al
 * file/dir que este posicionado"): when the press did NOT land on a real entry
 * - an empty row below the last one, "..", an index outside the listing - the
 * OPTIONAL third argument is the index of the entry under the panel CURSOR and
 * THAT entry becomes the target, ".." included. ".." is a DIRECTORY, so the
 * panel shows the directory list and the entries that need a real entry keep
 * refusing it exactly as they do from the keyboard (".." is never copied,
 * renamed or deleted), while Paste, Make dir and New file work in that panel.
 * Neither of the two: {} and the caller opens nothing.
 *
 * With TWO arguments the rule of S38 is untouched, so the existing callers and
 * the S38 assertions keep their meaning. */
FUNCTION HcCtxTarget( aList, nIdx, nCur )
   LOCAL aT
   aT := HcCtxEntryAt( aList, nIdx, .F. )
   IF ! Empty( aT )
      RETURN aT
   ENDIF
   IF PCount() < 3
      RETURN {}
   ENDIF
RETURN HcCtxEntryAt( aList, nCur, .T. )

/* one entry of a listing as { cName, lIsDir }, or {} when the index does not
 * point at a listed entry. lDotDot says whether the parent entry is accepted:
 * the PRESSED row never is (S38), the entry under the CURSOR is, because ".."
 * is a directory (S7). */
STATIC FUNCTION HcCtxEntryAt( aList, nIdx, lDotDot )
   LOCAL aE
   IF ! HB_ISARRAY( aList ) .OR. ValType( nIdx ) != "N"
      RETURN {}
   ENDIF
   IF nIdx < 1 .OR. nIdx > Len( aList )
      RETURN {}
   ENDIF
   aE := aList[ nIdx ]
   IF ! HB_ISARRAY( aE ) .OR. Len( aE ) < HC_E_MARK
      RETURN {}
   ENDIF
   IF ValType( aE[ HC_E_NAME ] ) != "C"
      RETURN {}
   ENDIF
   IF ! lDotDot .AND. aE[ HC_E_NAME ] == ".."
      RETURN {}
   ENDIF
RETURN { aE[ HC_E_NAME ], HcIsDir( aE ) }

/* S6 of odd/tasks/commander-cleanup.md: how many cells of the little bar are
 * filled, out of nW, after nElapsed seconds of hold. 0 means "not on screen" -
 * before HC_CTX_BARFROM the bar does not exist - and the first filled cell
 * arrives the moment it appears, so a bar that is shown is never empty. PURE and
 * public: the painter and the headless bank read the same number.
 * The user asked for "una pequeña barra de progreso" 0,5 s into the hold, whose
 * purpose is to announce that the menu is coming, not to decorate. */
FUNCTION HcCtxBarCells( nElapsed, nHold, nW )
   LOCAL nSpan
   IF ValType( nElapsed ) != "N" .OR. ValType( nHold ) != "N" .OR. ValType( nW ) != "N"
      RETURN 0
   ENDIF
   IF nW < 1 .OR. nHold <= HC_CTX_BARFROM .OR. ;
      nElapsed < HC_CTX_BARFROM .OR. nElapsed >= nHold
      RETURN 0
   ENDIF
   nSpan := ( nElapsed - HC_CTX_BARFROM ) / ( nHold - HC_CTX_BARFROM )
RETURN Max( 1, Min( nW, Int( nSpan * nW ) + 1 ) )

/* S6: the bar as text, brackets included, or "" when it must not be on screen.
 * The glyphs are the CP437 blocks this module draws with everywhere; the COUNT is
 * the pure part (HcCtxBarCells), so the bank pins the rule and not the look. */
FUNCTION HcCtxBarText( nElapsed, nHold, nW )
   LOCAL nF := HcCtxBarCells( nElapsed, nHold, nW )
   IF nF < 1
      RETURN ""
   ENDIF
RETURN "[" + Replicate( Chr( 219 ), nF ) + Replicate( Chr( 176 ), nW - nF ) + "]"

/* S6: puts the cells the bar covered back exactly as they were and forgets it.
 * Every way out of the gesture comes through here - the menu opening, the
 * pointer moving, the release, a press that moved away - so the bar can never
 * leave a trail on the panel. */
STATIC PROCEDURE HcCtxBarHide()
   IF ! s_lHcBarOn
      RETURN
   ENDIF
   RestScreen( s_nHcBarRow, s_nHcBarCol, s_nHcBarRow, ;
               s_nHcBarCol + s_nHcBarW - 1, s_cHcBarSave )
   s_lHcBarOn   := .F.
   s_cHcBarSave := ""
   s_nHcBarRow  := 0
   s_nHcBarCol  := 0
   s_nHcBarW    := 0
RETURN

/* S6: one poll of the bar. It is painted IMMEDIATELY TO THE RIGHT OF THE
 * POINTER, on the row that was pressed (user request: "que la barra de progreso
 * apareciera al lado a la derecha del puntero del mouse"): the gesture and the
 * bar are then the same thing as far as the eye is concerned, and over the
 * padding that follows a name it covers no data at all. It is restored before
 * being redrawn, so it only ever covers the same cells.
 * It does NOTHING while there is no gesture, the pointer moved, the menu is
 * already open, or the bar has nothing to show yet (the first half second): a
 * press that ends before then never paints a single cell, which is what makes
 * the feature non invasive. */
STATIC PROCEDURE HcCtxBarStep()
   LOCAL cTxt, nRow, nCol, nId, nW
   IF ! s_lHcDrag .OR. s_lHcDragMv .OR. s_lHcDragMenu
      HcCtxBarHide()
      RETURN
   ENDIF
   cTxt := HcCtxBarText( HcHoldElapsed(), HC_CTX_HOLD, HC_CTX_BARW )
   IF Len( cTxt ) == 0
      HcCtxBarHide()
      RETURN
   ENDIF
   nW   := Len( cTxt )
   nRow := s_nHcDragRow
   nId  := HcPanelAt( nRow, s_nHcDragCol )
   IF nId == 0
      HcCtxBarHide()
      RETURN
   ENDIF
   /* the bar starts in the cell after the pointer and never leaves the panel it
    * belongs to. Pressing within the last `nW` columns of the panel - the corner
    * of the screen - cannot fit it on the right, so there it slides back just
    * enough to end on the panel's last entry column: it stays on the pointer's
    * row, which is what places it, instead of spilling over the frame or into
    * the other panel. */
   nCol := s_nHcDragCol + 1
   IF nCol + nW - 1 > HcPanelR( nId ) - 1
      nCol := HcPanelR( nId ) - nW
   ENDIF
   IF nCol < HcPanelL( nId ) + 1
      HcCtxBarHide()
      RETURN
   ENDIF
   HcCtxBarHide()                    /* the previous frame goes back first */
   s_cHcBarSave := SaveScreen( nRow, nCol, nRow, nCol + nW - 1 )
   s_nHcBarRow  := nRow
   s_nHcBarCol  := nCol
   s_nHcBarW    := nW
   s_lHcBarOn   := .T.
   SetColor( UI_C_MENUBAR )
   @ nRow, nCol SAY cTxt
   SetColor( UI_C_DESKTOP )
RETURN

/* S38/S6: the poll side. Ticks while the right button stays still on an entry
 * and, from HC_CTX_BARFROM seconds on, keeps the little bar in step with the
 * hold so the user SEES that the menu is about to open. */
STATIC FUNCTION HcCtxHoldCheck()
   IF ! HcCtxHoldDue( HcHoldElapsed(), s_lHcDrag, s_lHcDragMv, ;
                      s_lHcDragMenu, s_nHcDragIdx, s_lHcDragBody )
      HcCtxBarStep()
      RETURN .F.
   ENDIF
   HcCtxBarHide()
   HcCtxOpen()
RETURN .T.

/* S38/S7: opens the menu of the entry the menu is about and closes the gesture.
 * Everything it still had pending (the moves and the release) is dropped, so
 * opening the menu can never mark an entry nor leak into the next event.
 *
 * S7: the menu opens from a right press ANYWHERE inside the body of the panel
 * (the entry rows and the empty rows below the last entry). A press on a listed
 * row moves the cursor there first (AGENTS trap 42), so the menu and the panel
 * cursor agree; a press over EMPTY space leaves the cursor alone and the menu
 * is about the entry under it. In both cases the kind - file or directory - and
 * the target come from the entry under the CURSOR. */
STATIC FUNCTION HcCtxOpen()
   LOCAL aP := HcPanel( s_nHcDragPan ), aT, lReleased, cAct := ""
   LOCAL nCtxSel, nCtxTop

   IF ! HB_ISARRAY( aP ) .OR. ! HB_ISARRAY( aP[ HC_P_LIST ] )
      RETURN NIL
   ENDIF
   /* T4 (S8): a tree panel has no entry to open a menu for, and its marks are
    * not the tree. The gesture is left DEAD like on a linked panel, so a button
    * still held cannot open it again and its release marks nothing. */
   IF HcPanelTree( aP )
      s_lHcDragMenu := .T.
      RETURN NIL
   ENDIF
   /* S3 of commander-link.md: the panel does not open on a linked panel. The
    * gesture is left DEAD (the flag HcCtxHoldDue() reads as "already opened"),
    * so a button still held cannot open it again on the next poll and its
    * release marks nothing - the same state a KEY closing the panel leaves. */
   IF HcLinkPanel( aP )
      s_lHcDragMenu := .T.
      HcLinkGuard()
      RETURN NIL
   ENDIF
   /* S42: the menu belongs to the entry under the POINTER, so the panel cursor
    * moves there before the option runs. A held right button never moves the
    * cursor by itself (S38.6 leaves the pressed row unmarked), so without this
    * Add to zip compressed whatever row the cursor happened to be on: report
    * of a right click on a file that answered "nothing to add to a zip"
    * because the cursor was still on "..".
    * S7: only a press ON a listed row moves the cursor (the ".." row included,
    * because it is a real row of the listing); a press over EMPTY space leaves
    * the cursor where the user put it, which is exactly the entry the menu is
    * about. */
   IF s_nHcDragIdx >= 1 .AND. s_nHcDragIdx != aP[ HC_P_SEL ]
      nCtxSel := aP[ HC_P_SEL ]
      nCtxTop := aP[ HC_P_TOP ]
      HcCursorTo( aP, s_nHcDragIdx )
      HcRepaint( nCtxSel, nCtxTop )
   ENDIF
   /* S7: with the press off an entry, the target is the entry under the CURSOR
    * of the panel (".." included: it is a directory). */
   aT := HcCtxTarget( aP[ HC_P_LIST ], s_nHcDragIdx, aP[ HC_P_SEL ] )
   IF Empty( aT )
      /* nothing under the press nor under the cursor (an EMPTY listing at the
       * root of a drive, for instance): no menu. The gesture is marked as
       * opened so the poll does not ask again on every pass while the button
       * is still held, and its release marks nothing - the same state a KEY
       * closing the menu leaves. */
      s_lHcDragMenu := .T.
      RETURN NIL
   ENDIF
   cAct := ""
   HcCtxPanel( aT[ 1 ], aT[ 2 ], ;
               HcCtxBox( s_nHcDragRow, s_nHcDragCol, Len( HcCtxItems( aT[ 2 ] ) ) ), ;
               @cAct )
   lReleased := HcMouseRightUp()      /* the release that closed the button */

   DO WHILE HcMouseRightStep()       /* drop the moves of the dead gesture */
   ENDDO
   IF lReleased .OR. HcMouseRightUp()
      /* the button is already up (that is what closed the panel, or it went up
       * while it was open): no more moves can arrive, so the gesture is over */
      s_lHcDrag     := .F.
      s_lHcDragMv   := .F.
      s_lHcDragMenu := .F.
      s_lHcDragBody := .F.
      s_aHcDragDone := {}
   ELSE
      /* the panel was closed with a KEY and the button is still held: the
       * gesture stays open but DEAD (S38.4), so the moves that are still
       * coming cannot mark anything and its release closes it in HcDragEnd()
       * without marking either. The next press starts a clean gesture because
       * HcDragEnd() - or the press branch of HcDragStep() - clears the flag. */
      s_lHcDragMenu := .T.
   ENDIF
   /* S42.1: the option chosen in the panel runs AFTER the screen under it has
    * been restored, so its dialog is not painted over a half covered panel */
   IF ! Empty( cAct )
      HcCtxRun( cAct, aP )
   ENDIF
RETURN NIL

/* S38: paints the panel and waits for a key or the mouse. The content depends
 * on cName/lIsDir (file or directory) and comes from HcCtxItems(), which is
 * passed in already so this only has to paint it.
 *
 * S98 (the user: "Y que funcione el mouse y tenga la estetica de un menu
 * contextual"): the box is painted like a dropdown of the menu bar (see
 * HcCtxDraw()), the wheel moves the highlight ONE entry per notch exactly like
 * the panels (HcWheelTarget()), dragging with the right button still held moves
 * it like a real menu, a click inside runs the entry under it in ONE gesture -
 * which is what the dropdowns of the bar do (HcMenuBar()) -, a click on the
 * frame or on an empty line does nothing and a click outside closes the box
 * running nothing. Up/Down, Enter and a plain LETTER (S98) keep the meaning
 * they had, and a list taller than the box scrolls with the highlight instead
 * of being painted past MaxRow(). The screen under the box comes back
 * untouched.
 *
 * S6 (the user: "La seleccion de la opcion del menu no sigue el puntero del
 * mouse y tampoco cuando selecciono uno se posiciona mostrando que se eligio
 * esa opcion"): the highlight FOLLOWS the pointer while the box is open, with
 * no button pressed - the moves come from the pointer cell of bp_win32.c, not
 * from the right button -; the entry under the pointer is the highlighted one
 * when the box opens; and a click leaves the highlight painted on the chosen
 * row for HC_CTX_CONFIRM seconds before the action runs. */
STATIC FUNCTION HcCtxPanel( cName, lIsDir, aBox, cAct, aList )
   LOCAL cSave, cOldCur, nKey, aItems, nSel := 1, nTop, nRows
   LOCAL nRow, nCol, lDummy, nHot, nHit, nNotch
   DEFAULT cAct TO ""
   /* S42.1: the panel is the MENU of the entry: the content depends on the
    * kind of the entry and Enter runs the chosen option. S8: the editor passes
    * ITS OWN list (Copy / Cut / Paste), so the same popup serves both. */
   IF HB_ISARRAY( aList ) .AND. Len( aList ) > 0
      aItems := aList
   ELSE
      aItems := HcCtxItems( lIsDir )
   ENDIF
   nRows := HcCtxRows( aBox )
   /* S6: the first row the cursor can reach (the list of the Browse edit starts
    * with an entry, so this is 1 for every list that has no rules) */
   nSel := Max( 1, HcCtxFirst( aItems ) )
   /* S6: when the box opens, the entry under the POINTER is the highlighted
    * one. The pending move is thrown away first (it belongs to the gesture that
    * opened the box) and the cell is read as it is: opening the box can never
    * leave the highlight on an entry the mouse is not pointing at. */
   lDummy := HcPointerStep()
   nHit := HcCtxHoverIdx( aBox, 1, Len( aItems ), HcPointerRow(), HcPointerCol() )
   IF HcCtxOk( aItems, nHit )
      nSel := nHit
   ENDIF
   nTop := HcCtxTop( nSel, 1, nRows, Len( aItems ) )
   cOldCur := SetCursor( 0 )
   /* the rectangle of the box PLUS the block shadow it casts (two cells to the
    * right and one row below, outside the box): it is saved with the very same
    * rectangle it is restored with, or the shadow leaves a band behind (one
    * column of it used to stay on screen) */
   cSave := SaveScreen( aBox[ 1 ], aBox[ 2 ], Min( aBox[ 3 ] + 1, MaxRow() ), ;
                        Min( aBox[ 4 ] + 2, MaxCol() ) )
   UiPaintBegin()
   HcCtxDraw( aBox, aItems, nSel, nTop )
   UiPaintEnd()
#ifndef BP_HC_STANDALONE
   BpLog( "S42 panel open el=" + LTrim( Str( HcHoldElapsed() ) ) )
#endif
   DO WHILE .T.
      /* S42.1: a MENU does NOT close when the button is released: the user has
       * to be able to choose an option after letting go. It closes with Esc,
       * with Enter (which runs the option) or with a click. The mouse only
       * arrives through the hook of bp_win32.c, so it is polled from THIS wait,
       * with no timer and no busy loop - but with HC_CTX_POLL (10 ms) instead of
       * the 50 ms of the other screens: this wait is what moves the highlight
       * under the pointer, so its length is the delay the user feels. */
      nKey := Inkey( HC_CTX_POLL )
      IF nKey == 0
         nRow := HcMouseClickRow()
         nCol := HcMouseClickCol()
         lDummy := HcMouseClickDbl()      /* read once: it must not leak */
         IF nRow >= 0 .OR. nCol >= 0
            IF ! HcCtxInside( aBox, nRow, nCol )
               EXIT                       /* outside: closed, nothing runs */
            ENDIF
            nHit := HcCtxHit( aBox, nTop, Len( aItems ), nRow )
            IF ! HcCtxOk( aItems, nHit )
               LOOP                       /* the frame, a rule or an empty line: nothing */
            ENDIF
            /* a click on an entry highlights it AND runs it in the one gesture,
             * which is what a dropdown of the bar does (HcMenuBar(): the row is
             * selected and the menu leaves in the same click). S6: the repaint
             * comes FIRST and the action a moment later (HC_CTX_CONFIRM), so the
             * user SEES the entry that was chosen; the key read there is
             * discarded and the pause is short on purpose. */
            HcCtxSelect( aBox, aItems, nHit, @nSel, @nTop )
            nKey := Inkey( HC_CTX_CONFIRM )
            cAct := aItems[ nSel ][ HC_CTX_ACT ]
            EXIT
         ENDIF
         /* the wheel: ONE entry per notch and clamped to the list, the rule the
          * panels use (HcWheelTarget), so a fast spin never runs past the ends.
          * S6: a rule is never a destination; HcCtxWheelSel() steps over it */
         nNotch := HcMouseWheel()
         IF nNotch != 0
            HcCtxSelect( aBox, aItems, HcCtxWheelSel( aItems, nSel, nNotch ), ;
                         @nSel, @nTop )
            LOOP
         ENDIF
         /* S6: the highlight FOLLOWS the pointer, with no button pressed: the
          * hook of bp_win32.c records every move in its own cell, so after the
          * right button is released (the box stays open on purpose) hovering
          * another entry still moves the highlight, exactly like a real context
          * menu. A cell outside the box, on the frame or past the last entry
          * answers 0 and nothing changes. */
         IF HcPointerStep()
            nHit := HcCtxHoverIdx( aBox, nTop, Len( aItems ), ;
                                   HcPointerRow(), HcPointerCol() )
            /* S6: a ring or a dimmed row sends the highlight to the nearest
             * entry that can be chosen instead of leaving it still (see
             * HcCtxHoverSnap()); the click is untouched */
            nHit := HcCtxHoverSnap( aItems, nHit )
            IF nHit > 0
               HcCtxSelect( aBox, aItems, nHit, @nSel, @nTop )
            ENDIF
         ENDIF
         /* dragging with the button still held: the moves of the right button
          * are their own channel and hook cell. It never runs anything and
          * never marks an entry of the panel. */
         IF HcMouseRightStep()
            nRow := HcMouseRightRow()
            nCol := HcMouseRightCol()
            nHit := HcCtxHit( aBox, nTop, Len( aItems ), nRow )
            IF HcCtxOk( aItems, nHit )
               HcCtxSelect( aBox, aItems, nHit, @nSel, @nTop )
            ENDIF
         ENDIF
         LOOP
      ENDIF
      DO CASE
      CASE nKey == K_UP
         nHit := HcCtxStep( aItems, nSel, -1 )
         IF nHit != nSel
            HcCtxSelect( aBox, aItems, nHit, @nSel, @nTop )
         ENDIF
      CASE nKey == K_DOWN
         nHit := HcCtxStep( aItems, nSel, 1 )
         IF nHit != nSel
            HcCtxSelect( aBox, aItems, nHit, @nSel, @nTop )
         ENDIF
      CASE nKey == K_ENTER
         /* a rule can never be the highlight (HcCtxOk()), so this is always a
          * real entry */
         cAct := aItems[ nSel ][ HC_CTX_ACT ]
         EXIT
      CASE nKey >= 33 .AND. nKey <= 255
         /* S98: a plain LETTER runs the entry whose hot letter it is: the
          * cursor moves there (only the rows it leaves and reaches are
          * repainted) and the entry is accepted, exactly what Enter on that row
          * does. A letter this list does not use is NOT an action and the box
          * stays open, the same thing the bar of menus does with an unknown
          * letter; everything that is not a printable letter (Esc, Enter, Tab,
          * the arrows, the function keys) keeps the meaning it had. */
         nHot := HcCtxHotIdx( aItems, nKey )
         IF nHot > 0
            HcCtxSelect( aBox, aItems, nHot, @nSel, @nTop )
            cAct := aItems[ nSel ][ HC_CTX_ACT ]
            EXIT
         ENDIF
      OTHERWISE
         EXIT                        /* Esc and any other key close it */
      ENDCASE
   ENDDO
   /* restored exactly like UiMsg() does: the five argument form and no paint
    * block around it (with the three argument form inside a paint block the
    * box stayed on screen even though the panel had already closed) */
   RestScreen( aBox[ 1 ], aBox[ 2 ], Min( aBox[ 3 ] + 1, MaxRow() ), ;
               Min( aBox[ 4 ] + 2, MaxCol() ), cSave )
   SetCursor( cOldCur )
RETURN NIL

/* S5/S6 of browse-edit-mouse.md: runs the popup ON THE LIST THE CALLER PASSES and
 * answers the action of the entry the user picked - "" when it was closed with Esc
 * or with a click outside.
 *
 * This is the ONLY door to HcCtxPanel() from outside this module, and that is the
 * point: the manager, the text editor and the Browse edit of bp_core.prg all get
 * the SAME box, with its arrows, its hot letters, its wheel, its mouse and its
 * screen restore, so there is no second popup to keep in step. The box is sized
 * from the list itself (count of rows and width of its widest label).
 *
 * The caller is the one that decides what an action MEANS; in bp_core.prg it is
 * turned back into the key of the screen so the DO CASE of the browser runs it. */
FUNCTION HcCtxMenuRun( nRow, nCol, aItems )
   LOCAL cAct := ""
   IF ! HB_ISARRAY( aItems ) .OR. Len( aItems ) < 1
      RETURN ""
   ENDIF
   IF ValType( nRow ) != "N" .OR. ValType( nCol ) != "N"
      RETURN ""
   ENDIF
   HcCtxPanel( "", .F., HcCtxBox( nRow, nCol, Len( aItems ), HcCtxListW( aItems ) ), @cAct, aItems )
RETURN cAct

/* S8 of hc-editor-mouse.md: the three entries of the TEXT context menu (the
 * clipboard of the editor). Public because the cell of the Browse edit opens the
 * VERY SAME three entries (S5 of browse-edit-mouse.md): one list, one meaning. */
FUNCTION HcTextCtxItems()
RETURN { { "~C~opy",  HC_ED_COPY  }, ;
         { "C~u~t",   HC_ED_CUT   }, ;
         { "~P~aste", HC_ED_PASTE } }

/* S8: the KEY a choice of the text menu stands for, 0 when nothing was chosen.
 * The clipboard acts in ONE place (the DO CASE of the screen), so the menu and
 * the shortcuts Ctrl-C / Ctrl-X / Ctrl-V cannot diverge. */
FUNCTION HcTextCtxKey( cAct )
   DO CASE
   CASE cAct == HC_ED_COPY  ; RETURN K_CTRL_C
   CASE cAct == HC_ED_CUT   ; RETURN K_CTRL_X
   CASE cAct == HC_ED_PASTE ; RETURN K_CTRL_V
   ENDCASE
RETURN 0

/* =====================================================================
 *  Keys: help, menus and the dispatcher shared by F1..F9, the menu bar and
 *  the clicks on the hotkey bar (T2)
 * ===================================================================== */

/* F3 and F4 work on the file under the cursor; a directory has no file. The
 * panel is passed in by the callers that own one (the context menu opened on
 * that panel), so the answer is always about THAT panel. */
STATIC FUNCTION HcFileAtCursor( aP )
   LOCAL aE, n
   DEFAULT aP TO HcPanelActive()
   n := aP[ HC_P_SEL ]
   IF ! HB_ISARRAY( aP[ HC_P_LIST ] ) .OR. Empty( aP[ HC_P_LIST ] ) .OR. ;
      n < 1 .OR. n > Len( aP[ HC_P_LIST ] )
      RETURN ""
   ENDIF
   aE := aP[ HC_P_LIST ][ n ]
   IF HcIsDir( aE )
      RETURN ""
   ENDIF
RETURN HcJoinPath( aP[ HC_P_DIR ], aE[ HC_E_NAME ] )

/* F2: the DB MANAGER. On a database it does exactly what F4 and Enter do on
 * one - the path goes back to the caller and Main() opens the record browser -,
 * so the three doors cannot diverge. On anything else (another file, a folder,
 * `..`, an empty panel) it leaves this screen with NO path and raises the flag:
 * Main() then shows the manager WITHOUT a database (the desktop face - the menu
 * bar and the status line, no browse) instead of coming back here.
 * It replaced the panel ZOOM at F2; the zoom keeps its own key, Ctrl-O, and
 * every menu row that announces it. */
STATIC PROCEDURE HcDataManager()
   LOCAL cFile := HcFileAtCursor()
   IF ! Empty( cFile ) .AND. HcIsDbfFile( cFile )
      s_cHcOpen := cFile
      RETURN
   ENDIF
   s_lHcWantData := .T.
RETURN

/* A1: Main() asks whether the file manager sent the user to the manager without
 * a database, and consumes the answer, so it can only open once per F2. */
FUNCTION HcWantDataManager()
   LOCAL l := s_lHcWantData
   s_lHcWantData := .F.
RETURN l

/* one dispatcher: the keys, the entries of the menu bar and a click on the
 * hotkey bar all end here */
STATIC PROCEDURE HcRunKey( nKey )
   DO CASE
   CASE nKey == K_F1 ; HcHelp()
   CASE nKey == K_F2 ; HcDataManager()
   CASE nKey == K_F3
      HcView( HcFileAtCursor() )
      /* the viewer/editor may have changed a file: refresh the listing so
       * the size and the date of the entry are the real ones */
      HcLoad( HcPanelActive() )
   CASE nKey == K_F4
      HcEdit( HcFileAtCursor() )
      HcLoad( HcPanelActive() )
   CASE nKey == K_F5 ; HcCopy()
   CASE nKey == K_F6 ; HcMove()
   CASE nKey == K_F7 ; HcMakeDir()
   CASE nKey == K_F8 ; HcDelete()
   CASE nKey == K_F9 ; HcMenuBar( iif( s_nHcMenuStart > 0, s_nHcMenuStart, 1 ) )
   ENDCASE
RETURN

