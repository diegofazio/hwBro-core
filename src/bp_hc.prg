RETURN { ;
   { "~C~hange drive...", "Alt-F1", {|| HcPickDrive( HC_PANEL_L ) },        "" }, ;
   { "~Z~oom panel",      "Ctrl-O", {|| HcToggleZoom() },                  "" }, ;
   { "~T~ree panel",      "",       {|| HcTreeMenu( HC_PANEL_L ) },         ;
     HcTreeMenuFlag( HC_PANEL_L ) }, ;
   { "~R~eload panel",    "",       {|| HcLoad( HcPanelActive() ) },        "" }, ;
   { "",                  "",       NIL,                                   "" }, ;
   { "Commander ~L~ink...", "",     {|| HcLinkDialog() },                  "" }, ;
   { "D~i~sconnect link", "",       {|| HcLinkDisconnect( HC_PANEL_L ) },  ;
     iif( HcLinkPanel( HcPanel( HC_PANEL_L ) ), "", "D" ) }, ;
   { "",                  "",       NIL,                                   "" }, ;
   { "Sort by ~N~ame",    "",       {|| HcSortPanel( HC_PANEL_L, "NAME" ) }, "" }, ;
   { "Sort by ~S~ize",    "",       {|| HcSortPanel( HC_PANEL_L, "SIZE" ) }, "" }, ;
   { "Sort by ~D~ate",    "",       {|| HcSortPanel( HC_PANEL_L, "DATE" ) }, "" }, ;
   { "Re~v~erse order",   "",       {|| HcSortPanel( HC_PANEL_L, "" ) },    "" } }

/* `Right` (S29): the same entries on the right panel. */
