/*
 * bp_hc.prg -- Harbour Commander: Norton-style dual-pane file manager.
 *
 * Port of the upstream Harbour Commander project
 * (https://github.com/omm/harbour-commander, MIT license) into hwBro.
 * Feature documents: odd/tasks/hc-commander.md (specs S1..S12),
 * odd/tasks/hc-panels-overwrite.md (S13..S18), odd/tasks/hc-sync-dirs.md
 * (S19..S24) and odd/tasks/hc-menu-bar.md (specs S25..S30, the menu bar).
 *
 * Entry point contract:
 *
 *    BpHcScreen()  ->  cChosen
 *
 *    cChosen is the FULL PATH of the *.DBF the user picked with Enter, or
 *    "" when this screen is finished: the user confirmed `Exit hwBro?`
 *    (in which case BpSetExit(.T.) was called already) or there is nothing
 *    left to do. The caller re-enters the browser when a database is open.
 *
 * Colours come only from the UI_C_* defines in bp_def.ch, painting goes
 * through UiPaintBegin()/UiPaintEnd() and every geometry constant is derived
 * from UiRows()/UiCols()/MaxRow()/MaxCol().
 *
 * WHAT IS IMPLEMENTED:
 *   T1  geometry, panel listing and sorting, panel painting, cursor
 *       navigation, Tab, the `..` parent entry, Ctrl-O zoom, Alt-F1/Alt-F2
 *       drive selection, Ins and `+`/`-` marking, the quit path.
 *   T2  the three chrome rows the geometry reserves (status, command line
 *       with history, hotkey bar), F1 help, F2 zoom panel, F9 menu, the mouse
 *       wheel and clicks.
 *   T3  the full-screen viewer (F3) and editor (F4) of spec S5.
 *   T4  the file operations of F5..F8 (copy, rename/move, make directory,
 *       delete) with progress, confirmations and the self-copy guards.
 *   T5  the headless bank src/tests/test_hc.prg (`-DBP_HC_STANDALONE`).
 *   T6  the menu bar of row HC_MENU (Left Files Directories Commands Right)
 *       with its five dropdowns (S25..S30). F9 opens it and every entry runs
 *       the same routine its key reaches, so the menu cannot drift away from
 *       the keys.
 *   T7  the READ-ONLY record browser of F3 on a *.DBF (S68): it reuses the work
 *       area the file is already open in (so it also works on a base opened in
 *       EXCLUSIVE) or opens it SHARED, and it never writes. F7 searches the
 *       current field, Shift-F7 the whole record.
 */

#include "inkey.ch"
#include "fileio.ch"
#include "hbgtinfo.ch"
#include "bp_def.ch"

/* Spanish code pages of the Text viewer/editor (S4, T1 of
 * odd/tasks/hc-codepage.md). Without these REQUEST lines the modules are NOT
 * linked and hb_cdpExists( "ES850" ) answers .F., so the screen would silently
 * offer only UTF8 and EN. */
REQUEST HB_CODEPAGE_ES850
REQUEST HB_CODEPAGE_ESWIN
REQUEST HB_CODEPAGE_ESISO

/* =====================================================================
 *  Geometry (S7): every constant is anchored to the canvas.
 *
 *  On the 120x44 grid this gives exactly the values of the feature document:
 *  HC_MENU 0, HC_T 1, HC_B 40, HC_STATUS 41, HC_CMD 42, HC_BAR 43, HC_LL 2,
 *  HC_LR 59, HC_RL 60, HC_RR 117. The two panels split the width evenly and
 *  sit SIDE BY SIDE with no column between them (S14 of
 *  odd/tasks/hc-panels-overwrite.md), so a different canvas keeps the layout
 *  instead of clipping it. */
#define HC_MENU     0                    /* menu bar: row of the five labels */
#define HC_T        1                    /* top row of both panels (S25 gave
                                          * its old row 0 to the menu bar)  */
#define HC_B        ( UiRows() - 4 )     /* bottom row of both panels (40)  */
#define HC_STATUS   ( HC_B + 1 )         /* status row (41); painted in T2  */
#define HC_CMD      ( UiRows() - 2 )     /* command line (42); painted in T2 */
#define HC_BAR      ( UiRows() - 1 )     /* hotkey bar (43); painted in T2  */

#define HC_MARG     2                    /* left/right margin of the screen */
#define HC_GAP      0                    /* blank columns between panels    */
#define HC_MINW     20                   /* minimum panel width             */
#define HC_W        ( Max( HC_MINW, ( UiCols() - 2 * HC_MARG - HC_GAP ) / 2 ) )
#define HC_LL       HC_MARG                     /* left panel, left column  */
#define HC_LR       ( HC_LL + HC_W - 1 )        /* left panel, right column */
#define HC_RL       ( HC_LR + 1 + HC_GAP )      /* right panel, left column  */
#define HC_RR       ( HC_RL + HC_W - 1 )        /* right panel, right column */

/* rows INSIDE a panel (between its two frame rows) */
#define HC_ROW_TITLE  ( HC_T + 1 )       /* path/title of the panel        */
#define HC_ROW_HDR    ( HC_T + 2 )       /* Name | Size | Date             */
#define HC_ROW_SEP    ( HC_T + 3 )       /* BP_LINE_SINGLE rule            */
#define HC_ROW_FIRST  ( HC_T + 4 )       /* first listed entry             */
#define HC_ROW_LAST   ( HC_B - 1 )       /* last listed entry              */
#define HC_VIS        ( HC_ROW_LAST - HC_ROW_FIRST + 1 )   /* 35 visible rows */

/* S38: the panel that opens when the right button is held still on an entry.
 * The footprint below is the WHOLE box, frame included (interior 13x8), which
 * is the 15 columns by 10 rows the user asked for. */
#define HC_CTX_W      15                 /* columns of the panel (with frame)  */
#define HC_CTX_H      10                 /* rows of the panel (with frame)     */
#define HC_CTX_HOLD   1.00               /* seconds holding without moving     */
/* S6 of commander-cleanup.md (user: "el item seleccionado sigue el movimiento
 * del puntero ... Noto como un pequeño delay"): the WAIT of the context menu is
 * 10 ms instead of the 50 ms of the other screens. Here every pass of the loop
 * is what moves the highlight under the pointer, so the timeout IS the latency
 * the user feels; the box lives for seconds and its repaint is one block over
 * two rows, so waking up five times more often costs nothing and the highlight
 * now follows the mouse instead of chasing it. */
#define HC_CTX_POLL   0.01
/* S6 of commander-cleanup.md: from how many seconds of hold the little bar is
 * shown, and how many cells it fills (the brackets are extra). 0,5 s of silence
 * and then half a second of visible progress, which is the user's own recipe. */
#define HC_CTX_BARFROM 0.50
/* the bar was 10 cells of fill and the user asked for it 20% shorter: 8. With
 * the two brackets the whole thing measures 10 cells instead of 12, and the rule
 * of HcCtxBarCells() scales with it, so the boundaries stay where they were. */
#define HC_CTX_BARW    8
/* S5 of hc-menu-mouse.md: longest wait for the button release after a click on
 * an entry of a dropdown, counted in polls of 50 ms (20 = 1 s). It is BOUNDED
 * on purpose: a release that never arrives (a lost message, the window hook
 * gone) can leave the row highlighted but can never hang the menu. */
#define HC_MENU_HOLD  20
/* S6: how long the chosen entry stays highlighted before its action runs, so
 * the user SEES which one was picked. Short on purpose: it delays the action. */
#define HC_CTX_CONFIRM 0.15

/* S42.1: an option of the panel: its label and the action HcCtxRun() executes */
#define HC_CTX_LABEL  1
#define HC_CTX_ACT    2
/* S1 of hc-ctx-menu-clipboard.md: one action code per entry. The code is what
 * HcCtxRun() dispatches and every one of them runs THE SAME routine its key
 * runs, so the menu can never drift away from the keyboard (the rule the
 * `Files` menu already follows). */
#define HC_CTX_ZIP     "ZIP"             /* Add to zip                         */
#define HC_CTX_VIEW    "VIEW"            /* View                F3             */
#define HC_CTX_EDIT    "EDIT"            /* Edit                F4             */
#define HC_CTX_COPY    "COPY"            /* Copy to the clipboard   Ctrl-C     */
#define HC_CTX_PASTE   "PASTE"           /* Paste the clipboard     Ctrl-V     */
#define HC_CTX_MOVE    "MOVE"            /* Rename/Move         F6             */
#define HC_CTX_DELETE  "DELETE"          /* Delete              F8             */
#define HC_CTX_NEWFILE "NEWFILE"         /* New file            Shift-F4       */
/* S8 of hc-editor-mouse.md: the entries of the CONTEXT MENU OF THE EDITOR. They
 * are not panel actions: each one is turned into the key the keyboard already
 * uses (K_CTRL_C / K_CTRL_X / K_CTRL_V), so the clipboard acts in ONE place. */
#define HC_ED_COPY  "ECOPY"
#define HC_ED_CUT   "ECUT"
#define HC_ED_PASTE "EPASTE"
#define HC_CTX_MKDIR   "MKDIR"           /* Make dir            F7             */
#define HC_CTX_CMP     "CMP"             /* Compare             Shift-F2       */

/* fields of one listed entry: the name starts at the first inner column of
 * the panel (its left column + 1), the size is right-aligned in 10 cells, the
 * date comes after one separator column in 10 cells and the time (S15, HH:MM
 * 24 hours) after another separator column in the last 5 cells */
#define HC_SIZE_W    10
#define HC_DATE_W    8   /* DD/MM/YY (L24 of hc-commander.md) */
#define HC_TIME_W    5

/* S70: columns of the STATUS row (HC_STATUS). They are FIXED, so moving the
 * cursor never pushes the size, the date or the time aside when the name of the
 * entry under it changes length (the user asked for it: the row has to be read
 * as a table). The name column is wider than the name column of a panel (31
 * cells today, HcNameW()), which is what the panel itself shows, so a listed
 * name is never cut here and the row still fits (82 cells of columns plus the
 * marks note). */
#define HC_ST_NAME_W 40                   /* name of the entry under cursor   */
#define HC_ST_UNIT_W 6                    /* " bytes" / blanks for a directory */
#define HC_ST_FLAG_W 8                    /* "[marked]" / blanks              */

/* hotkey bar (S7 row HC_BAR): the ten slots of upstream, spread over the canvas */
#define HC_BAR_SLOTS   10
/* command history of the command line: in memory only, never written */
#define HC_HIST_MAX   200
/* chunk of the file copy (S4): the progress bar advances by this much */
#define HC_COPY_CHUNK 65536
/* suffix of the TEMPORARY file of a copy: the destination is only replaced
 * once the whole copy is on disk (S4: a cancelled or failed operation leaves
 * the filesystem as it was, the previous destination byte-identical) */
#define HC_COPY_TMP   ".$$$"
/* label of the incremental search painted in the status row (S13.3) */
#define HC_FIND_TAG   "Search: "
/* L6: how long the TEMPORARY notice of the status row stays on screen after a
 * copy fills the file clipboard (milliseconds of hb_MilliSeconds()). It is a
 * notice, not a dialog: no key, no box, and the row goes back on its own. */
#define HC_FLASH_MS   2000

/* ---- geometry of the viewer/editor (S5) ----
 * The whole canvas is the buffer: one title row, the text, one status row and
 * two hint rows at the bottom. */
#define HE_TITLE   0
#define HE_TOP     1
#define HE_BOTTOM  ( UiRows() - 4 )      /* last text row (40)             */
#define HE_STATUS  ( UiRows() - 3 )      /* position/modified (41)         */
#define HE_KEYS    ( UiRows() - 2 )      /* first hint row (42)            */
#define HE_KEYS2   ( UiRows() - 1 )      /* second hint row (43)           */
/* largest file the viewer/editor accepts (a text buffer of this size is
 * already ~100k lines; a binary or huge file is refused with a message) */
#define HE_MAXSIZE ( 4 * 1024 * 1024 )
/* head of the file HcCdpDetect() looks at (S1 of hc-codepage.md): 256 KiB is
 * enough for the verdict and keeps the open of a 4 MB file cheap */
#define HC_CDP_SAMPLE ( 256 * 1024 )

/* ---- session tabs of the Text editor (odd/tasks/hc-editor-tabs.md) ----
 * The editor keeps SEVERAL files open at once in a bar of tabs on row HE_TITLE.
 * The list lives in the session (a STATIC of this module, memory only, S9) and
 * each tab is ONE record with every per-file thing the screen needs to come
 * back exactly where it was. Slots first, then the geometry of the bar. */
#define HC_TB_PATH     1   /* full path of the file                            */
#define HC_TB_LINES    2   /* the line buffer the screen edits (a REFERENCE)   */
#define HC_TB_TOP      3   /* first line of the window (1-based)               */
#define HC_TB_ROW      4   /* row of the caret inside that window (0-based)    */
#define HC_TB_COL      5   /* column of the caret, in BYTES of the buffer      */
#define HC_TB_LFT      6   /* horizontal window start, in BYTES                */
#define HC_TB_MOD      7   /* .T. while the buffer has changes not saved yet   */
#define HC_TB_OVR      8   /* .T. = OVR, .F. = INS                            */
#define HC_TB_CDP      9   /* code page of the FILE                            */
#define HC_TB_VIEW    10   /* code page the screen is painted with             */
#define HC_TB_TABW    11   /* indent width of Tab (F8)                         */
#define HC_TB_SEL     12   /* the selection, NIL when there is none            */
#define HC_TB_HIST    13   /* the undo history                                 */
#define HC_TB_REDO    14   /* the redo history                                 */
#define HC_TB_UNDO    15   /* the pending bulk snapshot of the undo            */
#define HC_TB_HIT     16   /* the marked search hit { line, col, len }         */
#define HC_TB_NOTE    17   /* the one-shot note of the status row              */
#define HC_TB_FIND    18   /* the last query of the search                     */
#define HC_TB_SAV     19   /* the text as it was last SAVED (a COPY, S8)       */
/* one tab of the bar as the painter and the mouse see it (HcTabCells()) */
#define HC_TC_IDX      1   /* the 1-based tab index this cell paints           */
#define HC_TC_COL      2   /* first cell of the tab                            */
#define HC_TC_LEN      3   /* cells the whole tab takes                        */
#define HC_TC_NCOL     4   /* first cell of the name                           */
#define HC_TC_NLEN     5   /* cells of the name                                */
#define HC_TC_XCOL     6   /* the cell of the close mark, 0 when it is not painted */
/* what HcTabCells() answers: the cells, the column of the first one and the two
 * "there are more tabs that way" flags */
#define HC_TL_CELLS    1
#define HC_TL_COL0     2
#define HC_TL_CUTL     3
#define HC_TL_CUTR     4
/* the close mark of a tab. L1 asks for "alguna X en la pestaña" and L7 asks for
 * it in UPPER CASE: it is the plain ASCII letter, which paints and measures as
 * ONE cell - what the hit test of S6 needs and what Chr() cannot guarantee for
 * the bytes above 128 (trap 47). */
#define HC_TAB_X       "X"
/* the marks of a bar that is hiding tabs on that side (S3) */
#define HC_TAB_CUTL    "<"
#define HC_TAB_CUTR    ">"
/* the smallest NAME slot of a tab: below it the label says nothing at all */
#define HC_TAB_NAME_MIN  6

/* ---- geometry of the READ-ONLY record browser of a *.DBF (S68) ----
 * Same shape as the record browser of the main window: title, header row with
 * the field names, a double rule, the records, a status row and a help row.
 * Every row comes from the canvas, so nothing breaks on a different grid. */
#define DB_TITLE    0                       /* file name (cyan chip)          */
#define DB_HDR      1                       /* field names                    */
#define DB_RULE     2                       /* double horizontal rule         */
#define DB_TOP      3                       /* first record row               */
#define DB_BOTTOM   ( UiRows() - 3 )        /* last record row (41)           */
#define DB_STATUS   ( UiRows() - 2 )        /* Rec. n/total, column, message  */
#define DB_KEYS     ( UiRows() - 1 )        /* help chips                     */
#define DB_VIS      ( DB_BOTTOM - DB_TOP + 1 )   /* visible records (39)       */

/* one field of that table: name, type, length, decimals and the width of its
 * column. The first four are exactly a DbStruct() row, so the SAME array is
 * handed to HcFieldText() -> UiValToStr(), which is the value-to-text helper of
 * the record browser: what the screen paints is what the search looks at. */
#define DBF_NAME    1
#define DBF_TYPE    2
#define DBF_LEN     3
#define DBF_DEC     4
#define DBF_WID     5

/* ---- compare by content (odd/tasks/hc-compare.md, S5..S8) ---- */
#define HC_CMP_EQ    1   /* same line on both sides                      */
#define HC_CMP_DEL   2   /* line only on the left side                   */
#define HC_CMP_ADD   3   /* line only on the right side                  */
#define HC_CMP_CHG   4   /* paired change: left line nL vs right line nR */

/* one row of the diff model: { kind, left line, right line, equal leading
 * chars of the left line, equal trailing chars of the left line, and the same
 * two for the right line }. Line numbers are 1-based, 0 means "no line". */
#define HC_CMR_KIND  1
#define HC_CMR_L     2
#define HC_CMR_R     3
#define HC_CMR_LPFX  4
#define HC_CMR_LSFX  5
#define HC_CMR_RPFX  6
#define HC_CMR_RSFX  7

/* one row of the VIEW model (what the screen paints):
 * { kind, index in the diff model, hidden rows } */
#define HC_CMPV_ROW   1  /* paint diff row <idx> (unified: its left part)   */
#define HC_CMPV_FOLD  2  /* folded run of <hid> equal rows ending at <idx>  */
#define HC_CMPV_ROW2  3  /* unified only: the right part of a changed row   */
#define HC_CMPV_KIND  1
#define HC_CMPV_IDX   2
#define HC_CMPV_HID   3

/* ---- geometry of the Compare screen (S5) ---- */
#define HC_CP_TITLE  0
#define HC_CP_PATHS  1
#define HC_CP_OPT    2
#define HC_CP_HDR    3
#define HC_CP_RULE   4
#define HC_CP_FIRST  5                      /* first text row (5)         */
#define HC_CP_LAST   ( UiRows() - 4 )       /* last text row (40)         */
#define HC_CP_SUM    ( UiRows() - 3 )       /* summary (41)               */
#define HC_CP_MSG    ( UiRows() - 2 )       /* message (42)               */
#define HC_CP_KEYS   ( UiRows() - 1 )       /* keys bar (43)              */
#define HC_CP_GUT    5                      /* line-number gutter width   */
#define HC_CP_MRK    1                      /* margin bar width (S5, L6)  */
#define HC_CP_CTX    2                      /* context rows of Only differences */
/* The last column of the canvas is the scroll bar; the rest of the width is
 * the two panes of the split view (left | separator | right) or the single
 * pane of the unified one. */
#define HC_CP_SEP    Int( ( MaxCol() - 1 ) / 2 )          /* separator column */
#define HC_CP_LW     HC_CP_SEP                            /* left pane width  */
#define HC_CP_RL     ( HC_CP_SEP + 1 )                    /* right pane left  */
#define HC_CP_RW     Int( MaxCol() - 1 - HC_CP_SEP )      /* right pane width */
#define HC_CP_UW     Int( MaxCol() )                      /* unified width    */
#define HC_CP_GAP    1                      /* blank cell after the numbers */
#define HC_CP_TW     Int( HC_CP_LW - HC_CP_MRK - HC_CP_GUT - HC_CP_GAP )  /* split text cells */
#define HC_CP_TWU    Int( HC_CP_UW - HC_CP_MRK - HC_CP_GUT - HC_CP_GAP )  /* unified text     */
/* One pane, left to right: HC_CP_MRK cells of margin bar, HC_CP_GUT cells of
 * line number RIGHT aligned in them, HC_CP_GAP blank cells and the text. The
 * text of a pane therefore starts at pane-left + HC_CP_MRK + HC_CP_GUT +
 * HC_CP_GAP (column 7 for the left pane and for the unified view, 67 for the
 * right pane on the 120x44 canvas), and every painter derives its columns from
 * these numbers, never from a literal. The blank cell is what keeps a row from
 * reading "1COMMON HEADER LINE". */
#define HC_CP_TXT    ( HC_CP_MRK + HC_CP_GUT + HC_CP_GAP )    /* text column of a pane  */

/* state of the Compare screen */
#define CM_LFILE   1     /* full path of the left file                 */
#define CM_RFILE   2     /* full path of the right file                */
#define CM_LLINES  3     /* left text lines                            */
#define CM_RLINES  4     /* right text lines                           */
#define CM_LCASE   5     /* .T. = ignore case                          */
#define CM_LWS     6     /* .T. = ignore white space                   */
#define CM_LDIFF   7     /* .T. = only differences                     */
#define CM_LUNI    8     /* .T. = unified view                         */
#define CM_ROWS    9     /* diff model                                 */
#define CM_VIEW    10    /* view model                                 */
#define CM_TOP     11    /* first visible view row (1-based)           */
#define CM_SIDE    12    /* 1 = left side active, 2 = right side       */
#define CM_OFFL    13    /* horizontal offset of the left text         */
#define CM_OFFR    14    /* horizontal offset of the right text        */
#define CM_MSG     15    /* message row                                */
#define CM_BLOCK   16    /* 1-based position of the block last jumped to */

/* ---- mouse ----
 * bp_win32.c hooks the GTWVG window (this driver delivers neither the wheel
 * nor the clicks through Inkey()) and converts the client pixels of a click to
 * the CELL of the grid it was told about: hwbro.prg calls
 * W32SetGrid( MaxRow()+1, MaxCol()+1 ) once at startup, so the row and the
 * column that DotMouseClickRow()/DotMouseClickCol() return are the cells of
 * this canvas and are used as they come. */

/* =====================================================================
 *  Module state (S11: in memory only, no configuration file at all)
 * ===================================================================== */

/* { left panel, right panel, id of the active panel } */
STATIC s_aPanels := {}
/* S31: the clickable controls of the synchronize screen, rebuilt on every full
 * paint by HcSyncCtlReset()/HcSyncCtlAdd() */
STATIC s_aHcSyncCtl := {}
/* S32: the ANCHOR of the Shift+click range selection, per panel, kept by NAME
 * (so reloading a panel cannot point it at a different file) */
STATIC s_aHcAnchor := { "", "" }

/* S39: identity of the entry the LAST left click landed on, and a counter bumped
 * by EVERY listing reload (HcLoad). A double click is two clicks on the SAME
 * entry, not two clicks on the same screen row: the window hook only knows the
 * row, so after entering a directory - or coming back with ".." - the row that
 * held the clicked entry holds another one, and a single click on it was taken
 * for the pair of a double click (reported by the user: one click on ".." went
 * back). */
STATIC s_cHcClickId := ""
STATIC s_nHcListGen := 0
/* S12 of hc-tree-panel.md (reverse sync): raised by HcLoad() when the panel that
 * is NOT a tree changed directory and the tree panel followed it. The tree is not
 * the ACTIVE panel in that flow, so HcRepaint() (which only paints the active
 * one) would leave it stale on screen: the flag makes the loop do a FULL draw.
 * Read and cleared in one place, the repaint decision of BpHcScreen(). */
STATIC s_lHcTreeFollowed := .F.

/* S37: right button drag. The gesture lives while the button is held: the panel
 * it started in, the row/index of the PRESS (nothing is marked there yet) and
 * the indexes it already touched, so an entry is toggled at most ONCE per sweep
 * (wiggling over the same row cannot flip it back).
 * NOTE for the next feature (a right press held for 3 s without moving opens a
 * panel): the press does NOT touch the listing, so a timer can be watched
 * between the press and the first move; the entry is only toggled when the
 * release arrives with no move (see HcDragEnd()). */
STATIC s_lHcDrag     := .F.
STATIC s_nHcDragPan  := 0
STATIC s_aHcDragDone := {}
STATIC s_nHcDragRow  := 0     /* row of the press                          */
STATIC s_nHcDragIdx  := 0     /* listing index of the press (0 = none)      */
STATIC s_nHcDragLast := 0     /* last listing index swept (S37.6)           */
STATIC s_lHcDragMv   := .F.   /* the pointer already left the press row     */
STATIC s_nHcDragCol  := 0     /* column of the press (S38: panel position)  */
STATIC s_nHcDragTick := 0     /* Seconds() of the press (S38: the 3 s hold) */
STATIC s_lHcDragMenu := .F.   /* S38: the panel opened, the gesture is dead */
/* right-click-esc (S5/S6 of right-click-esc.md): the ARMED state of the
 * detector - "a plain press was seen and its release has not arrived yet"-.
 * It has to live between polls because the press and the release of one click
 * can land in two different passes of a 50 ms loop. */
STATIC s_lHcRClickArmed := .F.
/* S7: .T. when the press of the gesture landed inside the BODY of a panel (an
 * entry row or one of the empty rows below the last entry, HC_ROW_FIRST..
 * HC_ROW_LAST). A press there opens the menu of the entry under the CURSOR even
 * when the row it landed on carries no entry; a press on the title, the header
 * or the rule of the panel still opens nothing. */
STATIC s_lHcDragBody := .F.
/* S6 of odd/tasks/commander-cleanup.md: the LITTLE BAR that tells the user that
 * the held right button is about to open its menu. It appears after
 * HC_CTX_BARFROM seconds and fills until the hold completes, so the gesture has
 * a visible "something is coming" instead of a silent second. The four slots
 * are the paint state: whether the bar is on screen, the cells it covered (so
 * they can be put back byte for byte) and where it was drawn. */
STATIC s_lHcBarOn    := .F.
STATIC s_cHcBarSave  := ""
STATIC s_nHcBarRow   := 0
STATIC s_nHcBarCol   := 0
/* ⚠ the WIDTH has to travel on its own: `Len( cSave )` is NOT the width of the
 * saved rectangle - SaveScreen() returns a block with its own header - so
 * restoring `Len( ... )` cells put back a rectangle wider than the one saved and
 * left the row unpainted (reported by the user right after the bar shipped). */
STATIC s_nHcBarW     := 0
/* Ctrl-O: the active panel takes the whole width of the two panels */
STATIC s_lZoom := .F.
/* command history of the command line (S11: memory only) and the position
 * being shown while the user walks it with Up/Down (0 = not walking it) */
STATIC s_aHcHist := {}
STATIC s_nHcHist := 0
/* .T. once the native mouse hook of the driver window is installed */
STATIC s_lHcHook := .F.
/* confirmation hook of the file operations (NIL = ask with UiConfirm()). The
