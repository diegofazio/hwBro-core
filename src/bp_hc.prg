RETURN { ;
   { "~C~hange drive...", "Alt-F2", {|| HcPickDrive( HC_PANEL_R ) },        "" }, ;
   { "~Z~oom panel",      "Ctrl-O", {|| HcToggleZoom() },                  "" }, ;
   { "~T~ree panel",      "",       {|| HcTreeMenu( HC_PANEL_R ) },         ;
     HcTreeMenuFlag( HC_PANEL_R ) }, ;
   { "~R~eload panel",    "",       {|| HcLoad( HcPanelActive() ) },        "" }, ;
   { "",                  "",       NIL,                                   "" }, ;
   { "Commander ~L~ink...", "",     {|| HcLinkDialog() },                  "" }, ;
   { "D~i~sconnect link", "",       {|| HcLinkDisconnect( HC_PANEL_R ) },  ;
     iif( HcLinkPanel( HcPanel( HC_PANEL_R ) ), "", "D" ) }, ;
   { "",                  "",       NIL,                                   "" }, ;
