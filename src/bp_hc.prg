   { "Re~v~erse order",   "",       {|| HcSortPanel( HC_PANEL_R, "" ) },    "" } }

/* `Directories` (S29). */
STATIC FUNCTION HcMenuDirs()
RETURN { ;
   { "~M~ake directory...",           "F7", {|| HcRunKey( K_F7 ) }, "" }, ;
   { "~S~ynchronize directories...",  "",   {|| BpSyncDirs() },      "" } }

/* `Commands` (S29). S1/S2 of odd/tasks/commander-cleanup.md left it with the
 * two rows that really belong here: `Themes` and `Quit`. `Help` left because it
 * is the F1 key, `User menu` left with the user menu itself (F2 is now the
 * zoom of S4) and `Commander Link...` left because it is the action of a PANEL
 * and lives in `Left` and `Right`, where the caller already has it.
 *
 * S2/S3 of odd/tasks/hc-themes-submenu.md: the theme rows no longer sit in this
 * dropdown. It carries ONE row, `~T~hemes`, that opens a CASCADE (the optional
 * fifth element HC_MI_SUB) and the theme rows live in that cascade, still
 * GENERATED from UiThemeNames() through HcThemeHot()/HcThemeLabel()/HcThemeAct()
 * - so adding a theme to the table of bp_ui.prg adds its row and nothing else -
 * with the marker ` *` on the theme in force and a letter of its own per row,
 * unique inside the cascade (there is nothing else in it, so the letters start
 * fresh: Classic takes C and Dark takes D).
 * The row opens the dropdown, `Quit` stays last, and it carries the arrow of
 * HcMenuSubMark() as its shortcut so the user sees it opens something.
 * HcThemePick() only switches the theme and raises s_lHcThemePicked: this
 * dropdown keeps the screen saved (HcMenuSaveScr/HcMenuRestScr), so a repaint
 * from the action would be undone by the restore - the key loop does the one
 * full repaint afterwards. */
STATIC FUNCTION HcMenuCmds()
   LOCAL aItems, aName, aHot, aSub, i

   aItems := {}

   /* the cascade of `Themes`: one row per theme, with the letters handed out by
    * HcThemeHot() over an EMPTY taken list, because a cascade has a namespace of
    * its own and no other row of it spends a letter */
   aName := UiThemeNames()
   aHot  := HcThemeHot( aName, {} )
   aSub  := {}
   FOR i := 1 TO Len( aName )
      AAdd( aSub, { HcThemeLabel( aName[ i ], aHot[ i ] ), "", ;
                    HcThemeAct( aName[ i ] ), "" } )
   NEXT

   AAdd( aItems, { "~T~hemes", HcMenuSubMark(), NIL, "", aSub } )
   AAdd( aItems, { "~Q~uit", "F10", {|| HcQuit() }, "" } )

RETURN aItems

/* S4 of odd/tasks/theme-dark-mode.md: the hot letter of every theme, in the same
 * order as <aNames>, given as ONE upper case letter per name or as "" when the
 * theme has no letter left. For each name the letters are scanned left to right
 * (upper case, A..Z only) and the FIRST one that is neither in <aTaken> nor
 * already handed to an earlier theme wins; a name whose every letter is taken
 * gets "" instead of a duplicate, because a duplicate would make
 * HcMenuEntryHot() run the wrong row.
 * Pure and deterministic: it only reads its two arguments and the headless bank
 * pins every case (T3 of the same document). */
FUNCTION HcThemeHot( aNames, aTaken )
   LOCAL aHot := {}, aUsed := {}
   LOCAL cName, c
   LOCAL i, j
   LOCAL lGot

   IF ! HB_ISARRAY( aNames )
      RETURN aHot
   ENDIF

   IF HB_ISARRAY( aTaken )
      FOR i := 1 TO Len( aTaken )
         IF ValType( aTaken[ i ] ) == "C" .AND. ! Empty( aTaken[ i ] )
            AAdd( aUsed, Upper( SubStr( aTaken[ i ], 1, 1 ) ) )
         ENDIF
      NEXT
   ENDIF

   FOR i := 1 TO Len( aNames )
      lGot  := .F.
      cName := iif( ValType( aNames[ i ] ) == "C", aNames[ i ], "" )
      FOR j := 1 TO Len( cName )
         c := Upper( SubStr( cName, j, 1 ) )
         IF ! ( c >= "A" .AND. c <= "Z" )
            LOOP
         ENDIF
         IF AScan( aUsed, c ) > 0
            LOOP
         ENDIF
         /* taken by no other row and by no earlier theme: this is its letter */
         AAdd( aUsed, c )
         AAdd( aHot, c )
         lGot := .T.
         EXIT
      NEXT
      IF ! lGot
         AAdd( aHot, "" )
      ENDIF
   NEXT

RETURN aHot

/* The label of a theme row: the name with its hot letter marked as ~X~ (painted
 * by UiDrawHot, read by HcMenuEntryHot) and, for the ACTIVE theme, the marker at
 * the END, so the labels stay left aligned and the letters keep their column.
 * The mark goes around the letter INSIDE the name, never in front of it: the
 * project rule is that a hot letter lives within its own label. */
STATIC FUNCTION HcThemeLabel( cName, cHot )
   LOCAL cLbl := cName
   LOCAL n

   IF ! Empty( cHot )
      n := At( cHot, Upper( cName ) )
      IF n > 0
         cLbl := SubStr( cName, 1, n - 1 ) + "~" + SubStr( cName, n, 1 ) + "~" + ;
                 SubStr( cName, n + 1 )
      ENDIF
   ENDIF

   /* the marker of the theme in force (UiThemeName() reads the live session) */
   IF Upper( cName ) == Upper( UiThemeName() )
      cLbl += " *"
   ENDIF

RETURN cLbl

/* The action of a theme row. It is a function and not a block built in the loop
 * of HcMenuCmds() because a codeblock captures its variables BY REFERENCE: every
 * row of a loop would end up switching to the LAST theme. Here <cName> is a
 * parameter, so each block keeps its own theme name. */
STATIC FUNCTION HcThemeAct( cName )
RETURN {|| HcThemePick( cName ) }

/* Choosing a theme row: it switches the colour layer and raises the repaint flag
 * (S4). NOTHING is painted from here - the dropdown has the screen saved and its
 * restore would wipe it - and an unknown name switches nothing (S5). Answers
 * .T. when the theme was switched, so a caller (or the bank) can tell. */
FUNCTION HcThemePick( cName )
   IF UiThemeSet( cName )
      s_lHcThemePicked := .T.
      RETURN .T.
   ENDIF
RETURN .F.

/* `Files` (S28), the rows S1 of odd/tasks/commander-cleanup.md keeps: `Help`,
 * `User menu`, `Make directory` and `Quit` are gone (F1 is the help of every
 * screen and of this one, F2 is the zoom of S4, `Make directory` lives in
 * `Directories` and `Quit` in `Commands`). Everything that is left keeps its
 * text, its shortcut, its hot letter and its order. The operations run through
 * HcRunKey(), which is the dispatcher of the keys themselves; `File attributes`
 * is a real entry since S1 of odd/tasks/hc-file-attributes.md, and the two that
 * remain informative only say that they are not reconstructed.
 * Hot letters (hc-menu-hotkeys.md): `V` View, `E` Edit, `N` New file, `S`
 * Search and Replace, `M` Compare (the letter the right-button menu gives it),
 * `C` Copy, `R` Rename or move, `D` Delete, `P` Split/Merge, `F` File
 * attributes, `L` Select group, `G` Deselect group, `I` Invert selection and
 * `O` Restore selection: no letter is carried twice, because a letter resolves
 * to the FIRST row that carries it (HcMenuEntryHot()).
 * S1 of hc-file-search.md: the file search sits between `New file` and
 * `Compare` as `~S~earch and Replace` and takes `S` - a letter that is free in
 * this dropdown - so no letter the user already knows has to move. */
STATIC FUNCTION HcMenuFiles()
RETURN { ;
   { "~V~iew",               "F3",       {|| HcRunKey( K_F3 ) }, "" }, ;
   { "~E~dit",               "F4",       {|| HcRunKey( K_F4 ) }, "" }, ;
   { "~N~ew file",           "Shift-F4", {|| HcNewFile() },       "" }, ;
   { "~S~earch and Replace", "Ctrl-F",   {|| HcSearch() },        "" }, ;
   { "Co~m~pare",            "Shift-F2", {|| HcCompare() },      "" }, ;
   { "~C~opy",               "F5",       {|| HcRunKey( K_F5 ) }, "" }, ;
   { "~R~ename or move",     "F6",       {|| HcRunKey( K_F6 ) }, "" }, ;
   { "~D~elete",             "F8",       {|| HcRunKey( K_F8 ) }, "" }, ;
   { "S~p~lit/Merge",        "Ctrl-F10", {|| HcMenuMissing( "Split/Merge" ) }, "I" }, ;
   { "",                   "",         NIL, "" }, ;
   { "~F~ile attributes",    "",         {|| HcAttrDialog() },           "" }, ;
   { "",                   "",         NIL, "" }, ;
   { "Se~l~ect group",       "Gray +",   {|| HcMarkByMask( .T. ) }, "" }, ;
   { "Deselect ~g~roup",     "Gray -",   {|| HcMarkByMask( .F. ) }, "" }, ;
   { "~I~nvert selection",   "Gray *",   {|| HcInvertMarks() },     "" }, ;
   { "Rest~o~re selection",  "",         {|| HcMenuMissing( "Restore selection" ) }, "I" } }

/* An "I" row of S28: it is dimmed, it is reachable and it says the truth. */
STATIC PROCEDURE HcMenuMissing( cLabel )
   UiMsg( cLabel + ": not included in this reconstruction.", "Menu" )
RETURN

/* columns of the five slots of the bar: { first, last } each. A slot is one
 * blank column, the label and one blank column, so the labels never touch. */
STATIC FUNCTION HcMenuCols()
   LOCAL aM := HcMenuList(), a := {}, i, n := 2, nW
   /* n starts at 2: the user asked for the bar one column further RIGHT than
    * it was originally (it used to start at column 1). The painter and the
    * click hit-test (HcMenuAt) both read these spans, so they cannot disagree. */
   FOR i := 1 TO Len( aM )
      nW := UiHotLen( aM[ i ][ HC_ML_LABEL ] )
      AAdd( a, { n, n + nW + 1 } )
      n += nW + 3
   NEXT
RETURN a

/* menu of the bar under a column of the canvas (0 = none of them) */
STATIC FUNCTION HcMenuAt( nCol )
   LOCAL aC := HcMenuCols(), i
   FOR i := 1 TO Len( aC )
      IF nCol >= aC[ i ][ 1 ] .AND. nCol <= aC[ i ][ 2 ]
         RETURN i
      ENDIF
   NEXT
RETURN 0

/* S1 of hc-menu-mouse.md: menu of the bar under the column the POINTER is on,
 * 0 when it is not over any label. It is the click hit-test (HcMenuAt) behind a
 * type guard, so the highlight of the bar, a click and the paint read the very
 * same spans: the hover can never point at a label the click would not open.
 * In the headless banks there is no pointer at all and the caller only asks
 * with a number, so the guard is all the "safety" that is needed. */
FUNCTION HcMenuBarAt( nCol )
   IF ValType( nCol ) != "N"
      RETURN 0
   ENDIF
RETURN HcMenuAt( nCol )

/* menu whose label carries that hot letter (S26), 0 when the key is not one */
STATIC FUNCTION HcMenuHot( nKey )
   LOCAL aM := HcMenuList(), i, c
   IF ValType( nKey ) != "N" .OR. nKey < 32 .OR. nKey > 255
      RETURN 0
   ENDIF
   c := Upper( Chr( nKey ) )
   FOR i := 1 TO Len( aM )
      IF UiHotKey( aM[ i ][ HC_ML_LABEL ] ) == c
         RETURN i
      ENDIF
   NEXT
RETURN 0

/* S6 of hc-menu-hotkeys.md: row of a dropdown whose hot letter is nKey, 0 when
 * no reachable row carries it - so the caller can fall back to the labels of the
 * bar. Only rows HcMenuOk() accepts can answer, which leaves the unavailable
 * ("D") rows out: a letter can never run something the arrows refuse to reach.
 * Case insensitive, pure, no state: the headless bank pins every case. */
FUNCTION HcMenuEntryHot( aItems, nKey )
   LOCAL i, c
   IF ! HB_ISARRAY( aItems )
      RETURN 0
   ENDIF
   IF ValType( nKey ) != "N" .OR. nKey < 33 .OR. nKey > 255
      RETURN 0
   ENDIF
   c := Upper( Chr( nKey ) )
   FOR i := 1 TO Len( aItems )
      IF HB_ISARRAY( aItems[ i ] ) .AND. HcMenuOk( aItems[ i ] ) .AND. ;
         UiHotKey( aItems[ i ][ HC_MI_TEXT ] ) == c
         RETURN i
      ENDIF
   NEXT
RETURN 0

/* S1 of hc-menu-hotkeys.md: .T. when a row of a dropdown can react at all (not
 * a separator, not unavailable). Public, like HcMenuFirst()/HcMenuNext()/
 * HcMenuWidth(), because the headless bank has to ask the very same question
 * the arrows, the hover, the wheel and the hot letters ask. */
FUNCTION HcMenuReach( aItem )
RETURN HcMenuOk( aItem )

/* the bar of row HC_MENU: every label a chip, the one of the menu in nSel
 * inverted (UI_C_MENUBAR with UI_C_MENUKEY, S25) and 0 = none open. The caller
 * owns the UiPaintBegin()/UiPaintEnd() pair. */
STATIC PROCEDURE HcDrawMenuBar( nSel )
   LOCAL aM := HcMenuList(), aC := HcMenuCols(), i, nL, cBg, cFg, cSlave, nSlaveW
   SetColor( UI_C_MENUBAR )
   @ HC_MENU, 0 SAY Space( UiCols() )
   FOR i := 1 TO Len( aM )
      /* the label is drawn at the first column of its slot and HcMenuAt() uses
       * the very same HcMenuCols() spans, so the click and the paint can never
       * disagree */
      nL := aC[ i ][ 1 ]
      IF nL + UiHotLen( aM[ i ][ HC_ML_LABEL ] ) > MaxCol()
         EXIT
      ENDIF
      IF i == nSel
         cBg := UI_C_MENUBAR
         cFg := UI_C_MENUKEY
      ELSE
         cBg := UI_C_MENULBL
         cFg := UI_C_HOT
      ENDIF
      UiDrawHot( HC_MENU, nL, aM[ i ][ HC_ML_LABEL ], cBg, cFg )
   NEXT
   /* S9 of commander-link.md: while the Slave is serving, the right end of the
    * bar says so, so the user knows the machine is answering on that port. The
    * chip sits after the labels, which end around column 30 of the canvas. */
   cSlave := HcLinkSlaveText( iif( hb_IsNIL( s_hHcLinkListen ), 0, s_nHcLinkPort ) )
   nSlaveW := Len( cSlave ) + 1
   IF nSlaveW > 1 .AND. nSlaveW <= MaxCol() + 1
      SetColor( UI_C_BOXSEL )
      @ HC_MENU, MaxCol() + 1 - nSlaveW SAY PadR( cSlave, nSlaveW )
   ENDIF
   SetColor( UI_C_DESKTOP )
RETURN

/* geometry of the dropdown of a menu: { top, left, bottom, interior width }.
 * It hangs from its own label, its width comes from HcMenuWidth() and it is
 * pushed inside the canvas instead of being clipped. */
STATIC FUNCTION HcMenuRect( nMenu )
   LOCAL aM := HcMenuList(), aC := HcMenuCols(), nW, nT, nL, nB
   nMenu := Min( Max( nMenu, 1 ), Len( aM ) )
   nW := HcMenuWidth( aM[ nMenu ][ HC_ML_ITEMS ] )
   nT := HC_MENU + 1
   nL := UiFitCol( aC[ nMenu ][ 1 ], nW + 3 )
   nB := Min( nT + Len( aM[ nMenu ][ HC_ML_ITEMS ] ) + 1, MaxRow() )
RETURN { nT, nL, nB, nW }

/* the screen under a dropdown (its shadow included), saved and put back with
 * the same rectangle so no cell of the box can survive */
STATIC FUNCTION HcMenuSaveScr( aRect )
RETURN SaveScreen( aRect[ 1 ], aRect[ 2 ], aRect[ 3 ] + 1, ;
                   Min( aRect[ 2 ] + aRect[ 4 ] + 3, MaxCol() ) )

STATIC PROCEDURE HcMenuRestScr( aRect, cSave )
   RestScreen( aRect[ 1 ], aRect[ 2 ], aRect[ 3 ] + 1, ;
               Min( aRect[ 2 ] + aRect[ 4 ] + 3, MaxCol() ), cSave )
RETURN

/* One row of a dropdown (S27): a separator is a BP_LINE_SINGLE rule of the
 * interior width, an entry is its text with the shortcut right-aligned and a
 * dimmed row ("D"/"I") is painted in the colour of an unavailable option. The
 * row under the cursor is UI_C_BOXSEL and the others UI_C_BOX.
 * NOTE: the feature document names UI_C_DARK for the dimmed rows, but in this
 * palette UI_C_DARK is white on dark gray - the colour of the panels - so a
 * dimmed row would read as a HIGHLIGHTED band. UI_C_BOXDIM (gray on cyan) is
 * what the menus of the rest of hwBro use for their unavailable options and is
 * the "gray letters" the same paragraph of S27 asks for. */
STATIC PROCEDURE HcMenuRow( aItems, nIdx, aRect, lCur )
   LOCAL nRow, nL, nW, aIt, cBg, cText, nKeyW, lDim
   IF ! HB_ISARRAY( aItems ) .OR. nIdx < 1 .OR. nIdx > Len( aItems )
      RETURN
   ENDIF
   nRow := aRect[ 1 ] + nIdx
   nL := aRect[ 2 ]
   nW := aRect[ 4 ]
   aIt := aItems[ nIdx ]
   IF HcMenuSep( aIt )
      /* like the separator of every menu of hwBro: a rule in the dim colour */
      SetColor( UI_C_BOXDIM )
      @ nRow, nL + 1 SAY Replicate( BP_LINE_SINGLE, nW )
      SetColor( UI_C_DESKTOP )
      RETURN
   ENDIF
   lDim := ( aIt[ HC_MI_FLAG ] == "I" .OR. aIt[ HC_MI_FLAG ] == "D" )
   cBg := iif( lCur, UI_C_BOXSEL, UI_C_BOX )
   nKeyW := iif( ValType( aIt[ HC_MI_KEY ] ) == "C", Len( aIt[ HC_MI_KEY ] ), 0 )
   SetColor( cBg )
   @ nRow, nL + 1 SAY Space( nW )
   IF lDim
      IF lCur
         SetColor( UI_C_BOXSEL )
      ELSE
         SetColor( UI_C_BOXDIM )
      ENDIF
   ENDIF
   /* PadR() does not truncate: the text field is exactly what the interior
    * leaves, so a long label can never run over the frame.
    * A row whose label carries a ~X~ mark (the `Commander ~L~ink...` entry) is
    * painted by UiDrawHot(), which takes the marks out and highlights the
    * letter; only the rows that HAVE a mark go through it, because with no
    * marks that painter highlights the first character, which is not what the
    * rest of these rows look like. HcMenuWidth() already measures them with
    * UiHotLen(), so the width and the paint agree. */
   cText := Left( " " + aIt[ HC_MI_TEXT ], Max( 0, nW - nKeyW ) + 2 )
   IF At( "~", cText ) > 0
      /* S5 of hc-menu-hotkeys.md: the hot painter gets the background the row
       * REALLY has, so a dimmed or informative row keeps its dim look under the
       * highlighted letter (it used to receive UI_C_BOX always) */
      UiDrawHot( nRow, nL + 1, PadR( cText, Max( 0, nW - nKeyW ) + 2 ), ;
                 iif( lCur, UI_C_BOXSEL, iif( lDim, UI_C_BOXDIM, UI_C_BOX ) ), ;
                 UI_C_HOT )
   ELSE
      SetColor( cBg )
      @ nRow, nL + 1 SAY Left( PadR( cText, Max( 0, nW - nKeyW ) ), Max( 0, nW - nKeyW ) )
   ENDIF
   IF nKeyW > 0
      SetColor( cBg )
      @ nRow, nL + 1 + nW - nKeyW SAY aIt[ HC_MI_KEY ]
   ENDIF
   SetColor( UI_C_DESKTOP )
RETURN

/* the whole dropdown: shadow, interior, frame and every row of the menu. One
 * paint block is the caller's: this procedure only draws (S27). */
STATIC PROCEDURE HcMenuDrawDrop( aItems, nSel, aRect )
   LOCAL i, nT := aRect[ 1 ], nL := aRect[ 2 ], nB := aRect[ 3 ], nW := aRect[ 4 ]
   UiShadow( nT, nL, nB, nL + nW + 1 )
   UiFillBox( nT, nL, nB, nL + nW + 1, UI_C_BOX )
   UiFrame( nT, nL, nB, nL + nW + 1, UI_C_BOX, .F. )
   FOR i := 1 TO Len( aItems )
      HcMenuRow( aItems, i, aRect, i == nSel )
   NEXT
   SetColor( UI_C_DESKTOP )
RETURN

/* the cursor moved inside a dropdown: ONLY the two rows it left and reached
 * are repainted, in a single paint block (S27) */
STATIC PROCEDURE HcMenuPaintMove( aItems, nOld, nNew, aRect )
   UiPaintBegin()
   HcMenuRow( aItems, nOld, aRect, .F. )
   HcMenuRow( aItems, nNew, aRect, .T. )
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()
RETURN

/* Opens (or switches to) the dropdown of nMenu with the cursor on nSel: the
 * dropdown already on screen (lHad) goes back first, then the bar with its
 * label inverted and the whole box are painted in ONE block. Returns
 * { cSave, aRect } for the caller. */
STATIC FUNCTION HcMenuOpen( nMenu, nSel, aOldRect, cOldSave, lHad )
   LOCAL aRect, cSave
   IF lHad
      HcMenuRestScr( aOldRect, cOldSave )
   ENDIF
   aRect := HcMenuRect( nMenu )
   cSave := HcMenuSaveScr( aRect )
   UiPaintBegin()
   HcDrawMenuBar( nMenu )
   HcMenuDrawDrop( HcMenuList()[ nMenu ][ HC_ML_ITEMS ], nSel, aRect )
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()
RETURN { cSave, aRect }

/* puts the screen under a dropdown back and leaves the bar as it has to be:
 * nMenuSel = the label still inverted (the bar is active) or 0 (leaving) */
STATIC PROCEDURE HcMenuClose( aRect, cSave, nMenuSel )
   IF ! hb_IsNIL( aRect ) .AND. ! hb_IsNIL( cSave )
      HcMenuRestScr( aRect, cSave )
   ENDIF
   UiPaintBegin()
   HcDrawMenuBar( nMenuSel )
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()
RETURN

/* the click of this pass as { row, column }, or NIL when there was none. The C
 * hook of bp_win32.c resets both coordinates when they are read, so a click is
 * delivered exactly once. */
STATIC FUNCTION HcMenuClick()
   LOCAL nRow := HcMouseClickRow(), nCol
   IF nRow < 0
      RETURN NIL
   ENDIF
   nCol := HcMouseClickCol()
   IF nCol < 0
      RETURN NIL
   ENDIF
RETURN { nRow, nCol }

/* .T. when a click at the point { row, column } falls inside the dropdown of
 * aRect ({ top, left, bottom, interior width }, see HcMenuRect()), its frame
 * included. A click there is "inside the menu" and only a reachable row of it
 * acts; everything else closes the menu exactly like Esc (S44). */
FUNCTION HcMenuInside( aRect, aPt )
   IF ! HB_ISARRAY( aRect ) .OR. ! HB_ISARRAY( aPt )
      RETURN .F.
   ENDIF
   IF Len( aRect ) < 4 .OR. Len( aPt ) < 2
      RETURN .F.
   ENDIF
RETURN aPt[ 1 ] >= aRect[ 1 ] .AND. aPt[ 1 ] <= aRect[ 3 ] .AND. ;
       aPt[ 2 ] >= aRect[ 2 ] .AND. ;
       aPt[ 2 ] <= Min( aRect[ 2 ] + aRect[ 4 ] + 1, MaxCol() )

/* row of the dropdown under a click that runs something (0 = none): the whole
 * row is the target, as in Norton Commander */
STATIC FUNCTION HcMenuHit( aItems, aRect, nRow )
   LOCAL n := nRow - aRect[ 1 ]
   IF n < 1 .OR. n > Len( aItems )
      RETURN 0
   ENDIF
   IF ! HcMenuOk( aItems[ n ] )
      RETURN 0
   ENDIF
RETURN n

/* S1 of hc-menu-mouse.md: row of a dropdown the POINTER is over, or 0 when
 * hovering there must change nothing. The BOX is the one of HcMenuInside() and
 * the reachability is the one of HcMenuHit(), so the hover, the click and the
 * paint of a row can never disagree: the row the mouse points at is the row a
 * click would run, and a separator, a dimmed ("D") row or the frame answers 0.
 * Pure: no window, no state - the headless bank pins every case. */
FUNCTION HcMenuHoverIdx( aItems, aRect, nRow, nCol )
   IF ! HB_ISARRAY( aItems ) .OR. ! HB_ISARRAY( aRect )
      RETURN 0
   ENDIF
   IF ValType( nRow ) != "N" .OR. ValType( nCol ) != "N"
      RETURN 0
   ENDIF
   IF nRow < 0 .OR. nCol < 0
      RETURN 0
   ENDIF
   IF ! HcMenuInside( aRect, { nRow, nCol } )
      RETURN 0                        /* outside the box, or on its shadow */
   ENDIF
RETURN HcMenuHit( aItems, aRect, nRow )

/* S3 of hc-menu-mouse.md: row a wheel notch (nNotch notches) leaves the focus
 * bar on. ONE notch is ONE reachable row, the same walk the arrows do
 * (HcMenuNext), so the separators and the unavailable rows are skipped and the
 * ends wrap around; a positive notch is the wheel turning away from the user
 * (up), which is what HcWheelTarget() means for the panels. A menu with nothing
 * to reach answers 0 and a menu with a single reachable row keeps it.
 * Pure: no window, no state - the headless bank pins the walk. */
FUNCTION HcMenuWheelSel( aItems, nSel, nNotch )
   LOCAL n, i, nDir
   IF ! HB_ISARRAY( aItems )
      RETURN 0
   ENDIF
   IF ValType( nSel ) != "N" .OR. ValType( nNotch ) != "N"
      RETURN 0
   ENDIF
   IF HcMenuFirst( aItems ) == 0
      RETURN 0                        /* nothing the cursor can reach */
   ENDIF
   IF nSel < 1 .OR. nSel > Len( aItems )
      RETURN HcMenuFirst( aItems )    /* no cursor yet: land on the first row */
   ENDIF
   nDir := iif( nNotch > 0, -1, 1 )
   n := nSel
   FOR i := 1 TO Abs( nNotch )
      n := HcMenuNext( aItems, n, nDir )
   NEXT
RETURN n

/* S2/S5 of hc-menu-mouse.md: waits until the left button that clicked an entry
 * of a dropdown goes UP, so the row can be seen highlighted before its action
 * runs. The wait is BOUNDED (HC_MENU_HOLD) because a release that never arrives
 * must not hang the menu, and without the window hook of bp_win32.c
 * (-DBP_HC_STANDALONE) the answer is "not held" and it returns at once. Keys
 * that arrive during the hold are discarded: they belong to the menu that is
 * leaving. */
STATIC PROCEDURE HcMenuWaitUp()
   LOCAL n := 0
   DO WHILE HcMouseLeftDown() .AND. n < HC_MENU_HOLD
      Inkey( 0.05 )
      ++n
   ENDDO
RETURN

/* next menu of the bar walking nDir, wrapping around (S26) */
STATIC FUNCTION HcMenuStep( nMenu, nDir, nMax )
   LOCAL n := nMenu + nDir
   IF n < 1
      n := nMax
   ELSEIF n > nMax
      n := 1
   ENDIF
RETURN n

/* The CASCADE of one row (S2/S3 of odd/tasks/hc-themes-submenu.md): the child
 * list is painted next to the parent dropdown - which stays on screen, untouched
 * - and walked with its own key/mouse/wheel loop, on the very same machinery as
 * a dropdown (HcMenuDrawDrop paints it, HcMenuRow paints one row,
 * HcMenuPaintMove moves the cursor, HcMenuInside/HcMenuHit decide a click and
 * HcMenuWheelSel/HcMenuNext walk it), so a cascade looks and behaves like a
 * dropdown and cannot drift from one.
 *
 * FOUR rules (S4):
 *  - Up/Down, the wheel and a hover move ONE reachable row (separators and "D"
 *    rows skipped, the ends wrapping, exactly as in the parent);
 *  - Enter, a click on a row and the hot letter of a row CHOOSE it;
 *  - Esc, Left, Right and a click outside close the cascade and NOTHING else:
 *    the answer is NIL and the caller stays in the parent dropdown with its row
 *    still under the cursor;
 *  - the chosen row is ANSWERED, never run here: the caller's tail runs it once
 *    the whole menu is off screen, so a modal of the action is the only thing
 *    painted over the panels.
 * The screen under the cascade is saved and given back with its own rectangle,
 * so nothing of the child box survives. */
STATIC FUNCTION HcMenuSubRun( aSub, aParent, nRow )
   LOCAL aRect, cSave, aPick := NIL, aPt
   LOCAL nSel, nKey, n, nNotch
   LOCAL lLeave := .F.

   IF ! HB_ISARRAY( aSub ) .OR. HcMenuFirst( aSub ) == 0
      RETURN NIL                       /* a cascade with nothing to reach */
   ENDIF
   aRect := HcMenuSubRect( aParent, nRow, aSub )
   IF Len( aRect ) < 4
      RETURN NIL
   ENDIF

   nSel := HcMenuFirst( aSub )
   cSave := HcMenuSaveScr( aRect )
   UiPaintBegin()
   HcMenuDrawDrop( aSub, nSel, aRect )
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()

   DO WHILE ! lLeave
      nKey := Inkey( 0.05 )
      /* right-click-esc (S1/S2/S7): a plain right click closes the cascade and
       * leaves the dropdown behind it selected, exactly as Esc does here */
      IF nKey == 0 .AND. HcMouseRightClick()
         nKey := K_ESC
      ENDIF
      IF nKey == 0
         /* one notch = one reachable row of the cascade, and the notch is the
          * cascade's: it is consumed here, so it never reaches the panels */
         nNotch := HcMouseWheel()
         IF nNotch != 0
            n := HcMenuWheelSel( aSub, nSel, nNotch )
            IF n > 0 .AND. n != nSel
               HcMenuPaintMove( aSub, nSel, n, aRect )
               nSel := n
            ENDIF
            LOOP
         ENDIF
         /* the highlight follows the pointer over the cascade, and a cell
          * outside it changes nothing */
         IF HcPointerStep()
            n := HcMenuHoverIdx( aSub, aRect, HcPointerRow(), HcPointerCol() )
            IF n > 0 .AND. n != nSel
               HcMenuPaintMove( aSub, nSel, n, aRect )
               nSel := n
            ENDIF
         ENDIF
         aPt := HcMenuClick()
         IF aPt == NIL
            LOOP
         ENDIF
         IF ! HcMenuInside( aRect, aPt )
            /* outside the child box (the parent box included): the cascade
             * closes and the parent dropdown stays where it was */
            lLeave := .T.
            LOOP
         ENDIF
         n := HcMenuHit( aSub, aRect, aPt[ 1 ] )
         IF n == 0
            LOOP                         /* a separator, a "D" row or the frame */
         ENDIF
         IF n != nSel
            HcMenuPaintMove( aSub, nSel, n, aRect )
            nSel := n
         ENDIF
         HcMenuWaitUp()
         aPick := aSub[ nSel ]
         lLeave := .T.
         LOOP
      ENDIF
      DO CASE
      CASE nKey == K_UP .OR. nKey == K_DOWN
         n := HcMenuNext( aSub, nSel, iif( nKey == K_UP, -1, 1 ) )
         IF n > 0 .AND. n != nSel
            HcMenuPaintMove( aSub, nSel, n, aRect )
            nSel := n
         ENDIF
      CASE nKey == K_ENTER .OR. nKey == K_SPACE
         aPick := aSub[ nSel ]
         lLeave := .T.
      CASE nKey == K_ESC .OR. nKey == K_LEFT .OR. nKey == K_RIGHT
         /* the cascade closes ALONE: the parent dropdown keeps its row */
         lLeave := .T.
      CASE nKey >= 33 .AND. nKey <= 255
         /* a letter is first a row of the cascade; one it does not carry does
          * nothing (the bar labels are not reachable while a cascade is open) */
         n := HcMenuEntryHot( aSub, nKey )
         IF n > 0
            IF n != nSel
               HcMenuPaintMove( aSub, nSel, n, aRect )
               nSel := n
            ENDIF
            aPick := aSub[ nSel ]
            lLeave := .T.
         ENDIF
      ENDCASE
   ENDDO

   HcMenuRestScr( aRect, cSave )
RETURN aPick

/* The bar itself (S26): F9 opens it on the menu nStart (a click on a label
 * passes its index through s_nHcMenuStart and enters here as the F9 key), the * arrows and the hot letters walk it, and the entry the user picks runs the
 * routine of its key once the screen is back. A confirmed Quit raises
 * s_lHcQuit and the key loop leaves the screen. */
STATIC PROCEDURE HcMenuBar( nStart )
   LOCAL aM, aItems, aRect := NIL, aSt, aPt, aIt, cSave := NIL
   LOCAL nMenu, nSel := 0, nKey, n, cOldCur
   LOCAL nNotch, nRow, nCol
   LOCAL aSub := NIL, aRun := NIL
   LOCAL lDrop := .F., lLeave := .F., lRun := .F., lOut := .F.
   DEFAULT nStart TO s_nHcMenuStart
   s_nHcMenuStart := 0
   aM := HcMenuList()
   nMenu := Min( Max( nStart, 1 ), Len( aM ) )
   aItems := aM[ nMenu ][ HC_ML_ITEMS ]
   /* the screen draws its own cursor: the caret of the command line has no
    * business here (the same rule as every modal of this module) */
   cOldCur := SetCursor( 0 )
   /* a click on a label comes here to OPEN that menu; F9 only shows the bar */
   IF ValType( nStart ) == "N" .AND. nStart >= 1 .AND. nStart <= Len( aM )
      nSel := HcMenuFirst( aItems )
      IF nSel > 0
         aSt := HcMenuOpen( nMenu, nSel, NIL, NIL, .F. )
         cSave := aSt[ 1 ]
         aRect := aSt[ 2 ]
         lDrop := .T.
      ENDIF
   ENDIF
   IF ! lDrop
      UiPaintBegin()
      HcDrawMenuBar( nMenu )
      SetColor( UI_C_DESKTOP )
      UiPaintEnd()
   ENDIF

   DO WHILE ! lLeave
      /* the same short wait as the panels: the mouse only arrives through the
       * hook of bp_win32.c and is polled here */
      nKey := Inkey( 0.05 )
      /* right-click-esc (S1/S2/S7): a plain right click closes the dropdown,
       * the same as Esc, and a second one leaves the bar */
      IF nKey == 0 .AND. HcMouseRightClick()
         nKey := K_ESC
      ENDIF
      IF nKey == 0
         /* S3 of hc-menu-mouse.md: ONE notch of the wheel moves the focus bar
          * exactly one reachable row, the same walk as Up/Down (the rule lives
          * in HcMenuWheelSel()). The notch belongs to the MENU: it is read and
          * consumed here, with the box open or closed, so it can never reach the
          * panels afterwards and move the cursor the user did not point at. */
         nNotch := HcMouseWheel()
         IF nNotch != 0
            IF lDrop
               n := HcMenuWheelSel( aItems, nSel, nNotch )
               IF n > 0 .AND. n != nSel
                  HcMenuPaintMove( aItems, nSel, n, aRect )
                  nSel := n
               ENDIF
            ENDIF
            LOOP
         ENDIF
         /* S1 of hc-menu-mouse.md: the highlight FOLLOWS the pointer, with no
          * button pressed. Over a label of the bar it marks that label, and with
          * a dropdown open it SWITCHES the dropdown to it (the behaviour of
          * every Windows menu); over the dropdown it moves the highlight to the
          * row under the mouse, painting only the two rows involved - the very
          * same block the arrows use. A separator, a dimmed row, the frame or a
          * cell outside answers 0 and nothing changes. */
         IF HcPointerStep()
            nRow := HcPointerRow()
            nCol := HcPointerCol()
            IF nRow == HC_MENU
               n := HcMenuBarAt( nCol )
               IF n > 0 .AND. n != nMenu
                  nMenu := n
                  aItems := aM[ nMenu ][ HC_ML_ITEMS ]
                  IF lDrop
                     nSel := HcMenuFirst( aItems )
                     aSt := HcMenuOpen( nMenu, nSel, aRect, cSave, .T. )
                     cSave := aSt[ 1 ]
                     aRect := aSt[ 2 ]
                  ELSE
                     nSel := 0
                     UiPaintBegin()
                     HcDrawMenuBar( nMenu )
                     SetColor( UI_C_DESKTOP )
                     UiPaintEnd()
                  ENDIF
               ENDIF
            ELSEIF lDrop
               n := HcMenuHoverIdx( aItems, aRect, nRow, nCol )
               IF n > 0 .AND. n != nSel
                  HcMenuPaintMove( aItems, nSel, n, aRect )
                  nSel := n
               ENDIF
            ENDIF
         ENDIF
         aPt := HcMenuClick()
         IF aPt == NIL
            LOOP
         ENDIF
         lOut := .F.
         IF aPt[ 1 ] == HC_MENU
            /* S26: a click on a label of row 0 opens that menu */
            n := HcMenuAt( aPt[ 2 ] )
            IF n > 0
               nMenu := n
               aItems := aM[ nMenu ][ HC_ML_ITEMS ]
               nSel := HcMenuFirst( aItems )
               aSt := HcMenuOpen( nMenu, nSel, aRect, cSave, lDrop )
               cSave := aSt[ 1 ]
               aRect := aSt[ 2 ]
               lDrop := .T.
            ELSE
               /* the blank part of the bar is already outside the menu */
               lOut := .T.
            ENDIF
         ELSEIF lDrop .AND. HcMenuInside( aRect, aPt )
            /* inside the box only an entry runs; a separator or a dimmed row
             * leaves everything as it is, as in Norton Commander */
            n := HcMenuHit( aItems, aRect, aPt[ 1 ] )
            IF n > 0
               /* S2 of hc-menu-mouse.md: the entry is painted with the colour
                * of the keyboard selection BEFORE the box closes, and it runs
                * once the button goes UP, so the effect of the selection is
                * seen (a fast click finds the button already released and the
                * wait costs nothing) */
               IF n != nSel
                  HcMenuPaintMove( aItems, nSel, n, aRect )
                  nSel := n
               ENDIF
               HcMenuWaitUp()
               /* S2 of hc-themes-submenu.md: a row with a cascade OPENS it
                * instead of running, and only a row of the cascade can leave
                * the menu with something to run */
               aSub := HcMenuSubAt( aItems, nSel )
               IF ! hb_IsNIL( aSub )
                  aRun := HcMenuSubRun( aSub, aRect, nSel )
                  IF ! hb_IsNIL( aRun )
                     lRun := .T.
                     lLeave := .T.
                  ENDIF
               ELSE
                  lRun := .T.
                  lLeave := .T.
               ENDIF
            ENDIF
         ELSE
            /* S44: a click anywhere outside the menu closes it the way Esc
             * does - but in ONE step, because the click was meant for what is
             * underneath: the dropdown goes away AND the bar loses the focus
             * (Esc needs two presses: first the dropdown, then the bar). */
            lOut := .T.
         ENDIF
         IF lOut
            IF lDrop
               HcMenuClose( aRect, cSave, nMenu )
               lDrop := .F.
            ENDIF
            EXIT
         ENDIF
         LOOP
      ENDIF
      DO CASE
      CASE lDrop .AND. ( nKey == K_UP .OR. nKey == K_DOWN )
         /* separators and unavailable rows are skipped, the ends wrap */
         n := HcMenuNext( aItems, nSel, iif( nKey == K_UP, -1, 1 ) )
         IF n > 0 .AND. n != nSel
            HcMenuPaintMove( aItems, nSel, n, aRect )
            nSel := n
         ENDIF
      CASE lDrop .AND. ( nKey == K_ENTER .OR. nKey == K_SPACE )
         /* a row that opens a CASCADE opens it; the menu is left only when a
          * row of the cascade was chosen (S2 of hc-themes-submenu.md) */
         aSub := HcMenuSubAt( aItems, nSel )
         IF ! hb_IsNIL( aSub )
            aRun := HcMenuSubRun( aSub, aRect, nSel )
            IF ! hb_IsNIL( aRun )
               lRun := .T.
               lLeave := .T.
            ENDIF
         ELSE
            lRun := nSel > 0
            lLeave := .T.
         ENDIF
      CASE ! lDrop .AND. ( nKey == K_DOWN .OR. nKey == K_ENTER .OR. nKey == K_SPACE )
         /* down drops into the dropdown on its first reachable row */
         nSel := HcMenuFirst( aItems )
         IF nSel > 0
            aSt := HcMenuOpen( nMenu, nSel, NIL, NIL, .F. )
            cSave := aSt[ 1 ]
            aRect := aSt[ 2 ]
            lDrop := .T.
         ENDIF
      CASE nKey == K_ESC
         IF lDrop
            /* the dropdown closes and the bar stays active (S26) */
            HcMenuClose( aRect, cSave, nMenu )
            lDrop := .F.
         ELSE
            lLeave := .T.
         ENDIF
      CASE nKey == K_LEFT .OR. nKey == K_RIGHT
         nMenu := HcMenuStep( nMenu, iif( nKey == K_LEFT, -1, 1 ), Len( aM ) )
         aItems := aM[ nMenu ][ HC_ML_ITEMS ]
         IF lDrop
            nSel := HcMenuFirst( aItems )
            aSt := HcMenuOpen( nMenu, nSel, aRect, cSave, .T. )
            cSave := aSt[ 1 ]
            aRect := aSt[ 2 ]
         ELSE
            nSel := 0
            UiPaintBegin()
            HcDrawMenuBar( nMenu )
            SetColor( UI_C_DESKTOP )
            UiPaintEnd()
         ENDIF
      CASE nKey >= 33 .AND. nKey <= 255
         /* S3/S4 of hc-menu-hotkeys.md: with a dropdown open the letter belongs
          * to THAT dropdown -the accelerators of the open menu own the
          * keyboard, as in every menu- and it runs its row exactly like Enter.
          * A letter no row carries is still the label of the bar (S26), so `D`
          * in `Left` opens `Directories` and `D` in `Files` is `Delete`. */
         IF lDrop
            n := HcMenuEntryHot( aItems, nKey )
         ELSE
            n := 0
         ENDIF
         IF n > 0
            IF n != nSel
               HcMenuPaintMove( aItems, nSel, n, aRect )
               nSel := n
            ENDIF
            /* the letter of a cascade row OPENS the cascade (the same road as
             * Enter on it), so what runs is always a row of a list */
            aSub := HcMenuSubAt( aItems, nSel )
            IF ! hb_IsNIL( aSub )
               aRun := HcMenuSubRun( aSub, aRect, nSel )
               IF ! hb_IsNIL( aRun )
                  lRun := .T.
                  lLeave := .T.
               ENDIF
            ELSE
               lRun := .T.
               lLeave := .T.
            ENDIF
         ELSE
            /* the hot letter of a label opens that menu (S26) */
            n := HcMenuHot( nKey )
            IF n > 0
               nMenu := n
               aItems := aM[ nMenu ][ HC_ML_ITEMS ]
               nSel := HcMenuFirst( aItems )
               aSt := HcMenuOpen( nMenu, nSel, aRect, cSave, lDrop )
               cSave := aSt[ 1 ]
               aRect := aSt[ 2 ]
               lDrop := .T.
            ENDIF
         ENDIF
      ENDCASE
   ENDDO

   /* everything back on screen BEFORE the entry runs: its own box (a UiMsg, a
    * pick list, the viewer...) is then the only thing painted over the panels */
   IF lDrop
      HcMenuRestScr( aRect, cSave )
      lDrop := .F.
   ENDIF
   UiPaintBegin()
   HcDrawMenuBar( 0 )
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()
   SetCursor( cOldCur )
   /* S2/S3 of hc-themes-submenu.md: what runs is the row of the CASCADE that was
    * chosen when there is one (aRun) and, if not, the row of the dropdown under
    * the cursor. A row that OPENS a cascade is never an action: its fifth
    * element is the list, and Eval() of a list is not something that may ever
    * happen, so the row is skipped if a cascade row somehow got here. */
   IF lRun
      IF ! hb_IsNIL( aRun )
         aIt := aRun
         aRun := NIL
      ELSEIF nSel > 0 .AND. nSel <= Len( aItems )
         aIt := aItems[ nSel ]
      ELSE
         aIt := NIL
      ENDIF
      IF HB_ISARRAY( aIt ) .AND. hb_IsNIL( HcMenuRowSub( aIt ) )
         IF ! hb_IsNIL( aIt[ HC_MI_ACT ] )
            Eval( aIt[ HC_MI_ACT ] )
         ELSEIF aIt[ HC_MI_FLAG ] == "I"
            /* an informative row without its own action still tells the truth */
            HcMenuMissing( aIt[ HC_MI_TEXT ] )
         ENDIF
      ENDIF
   ENDIF
RETURN

/* =====================================================================
 *  Viewer (F3) and editor (F4) - spec S5
 *
 *  A keystroke NEVER writes to disk: the buffer is saved with F2 and, when it
 *  was modified, when leaving with Esc after the confirmation. Binary files
 *  are refused instead of shown.
 * ===================================================================== */

/* =====================================================================
 *  Hex viewer (S61..S63): F3 on a BINARY file
 *
 *  Classic layout, the one the user showed in the reference picture:
 *
 *    Offset(h)  00 01 02 03 ... 0F   ASCII
 *    00000000   EB 52 90 2E 2E 2E ...  .R.....
 *
 *  The dump and the ASCII column are two blocks side by side, a match of a
 *  search is highlighted in BOTH of them, and the search can be made in plain
 *  text (ASCII, F7) or in bytes (hex, Shift-F7). F3 on a TEXT file still opens
 *  the normal viewer: this screen is only for content that cannot be shown as
 *  text. It is read only. Colours: the body is UI_C_DARK (the same white on dark
 *  gray of the panels), the header and the title are the cyan chip and the match
 *  is UI_C_LISTSEL, so no new colour enters the palette.
 * ===================================================================== */

#define HX_HDR      1                         /* column header row        */
#define HX_TOP      2                         /* first row of the dump    */
#define HX_BOTTOM   HE_BOTTOM                 /* last row of the dump     */
/* bytes per row: NOT a constant. The user asked the viewer to use the WHOLE
 * width of the canvas, so the count is derived from it (27 on the 120x44
 * canvas) and the table ends exactly at the last column; HcHexRow() and
 * HcHexRows() take it as a parameter, with 16 as the default for the tests. */
#define HX_OFFW     10                        /* "00000000  "             */
#define HX_MINCOLS  8
#define HX_MAXCOLS  32
#define HX_MAXSIZE  ( 4 * 1024 * 1024 )       /* what the viewer will read */

/* S61: bytes per row for the canvas in use: the offset column, three cells per
 * byte, two of air and one ASCII cell per byte have to fit in the width */
FUNCTION HcHexCols()
RETURN Max( HX_MINCOLS, Min( HX_MAXCOLS, Int( ( ( MaxCol() + 1 ) - HX_OFFW - 2 ) / 4 ) ) )

/* S61: first column of the ASCII block for a given row width */
FUNCTION HcHexAscCol( nCols )
   DEFAULT nCols TO 16
RETURN HX_OFFW + nCols * 3 + 2

/* S61: .T. when a byte has a readable representation: the usual rule of a hex
 * dump (32..126, everything else a dot) */
FUNCTION HcHexPrintable( nByte )
   IF ValType( nByte ) != "N"
      RETURN .F.
   ENDIF
RETURN nByte >= 32 .AND. nByte <= 126

/* S61: one row of the dump as { cHex, cAscii }: cHex is the fixed 48 cells
 * ("EB 52 90 " per byte, three spaces for a byte that is not there, so the
 * columns never shift on the last row) and cAscii the 16 characters, with a dot
 * for anything that is not printable and a space where there is no byte. */
FUNCTION HcHexRow( cChunk, nCols )
   LOCAL cHex := "", cAsc := "", i, n
   DEFAULT nCols TO 16
   nCols := Max( 1, nCols )
   IF ValType( cChunk ) != "C"
      cChunk := ""
   ENDIF
   cChunk := Left( cChunk, nCols )
   FOR i := 1 TO nCols
      IF i <= Len( cChunk )
         n := Asc( SubStr( cChunk, i, 1 ) )
         cHex += Upper( hb_NumToHex( n, 2 ) ) + " "
         cAsc += iif( HcHexPrintable( n ), SubStr( cChunk, i, 1 ), "." )
      ELSE
         cHex += "   "
         cAsc += " "
      ENDIF
   NEXT
RETURN { cHex, cAsc }

/* S62: the bytes a search asks for. With lHex the query is read as hex (spaces,
 * commas and dashes are ignored: "EB 52 90" and "EB5290" are the same, and an
 * odd number of digits or a character that is not hex answers "" = invalid).
 * Without lHex the query is taken as text and its characters are the bytes. */
FUNCTION HcHexQuery( cQuery, lHex )
   LOCAL c, cOut := "", i, j, cPair
   IF ValType( cQuery ) != "C"
      RETURN ""
   ENDIF
   IF ! lHex
      RETURN cQuery
   ENDIF
   c := ""
   FOR i := 1 TO Len( cQuery )
      IF ! ( SubStr( cQuery, i, 1 ) $ " ,;:-\t" )
         c += SubStr( cQuery, i, 1 )
      ENDIF
   NEXT
   IF Empty( c ) .OR. Len( c ) % 2 != 0
      RETURN ""
   ENDIF
   FOR i := 1 TO Len( c ) STEP 2
      cPair := Upper( SubStr( c, i, 2 ) )
      FOR j := 1 TO 2
         IF ! ( SubStr( cPair, j, 1 ) $ "0123456789ABCDEF" )
            RETURN ""
         ENDIF
      NEXT
      // the raw byte: Chr() can go through the code page and drop a byte >= 128
      // (measured in the bank), hb_HexToStr() never does
      cOut += hb_HexToStr( cPair )
   NEXT
RETURN cOut

/* S62: first byte offset (1 based) of cQuery in cData at or after nFrom, or 0
 * when there is no match. It never wraps: the caller decides where to continue,
 * so the search of the screen can start at the top or after the last match. */
FUNCTION HcHexFind( cData, cQuery, nFrom )
   LOCAL nHit
   // a query of blanks is a legitimate text search, so Empty() is not the test
   IF ValType( cData ) != "C" .OR. ValType( cQuery ) != "C" .OR. Len( cQuery ) == 0
      RETURN 0
   ENDIF
   DEFAULT nFrom TO 1
   IF ValType( nFrom ) != "N"
      nFrom := 1
   ENDIF
   IF nFrom > Len( cData )
      RETURN 0
   ENDIF
   nFrom := Max( 1, nFrom )
   // Harbour3.2 does not accept At() with a start offset, so the tail is taken
   // first and the offset added back
   nHit := At( cQuery, SubStr( cData, nFrom ) )
RETURN iif( nHit > 0, nHit + nFrom - 1, 0 )

/* S61: .T. when the file has BINARY content (the probe reads at most 256 KB).
 * F3 uses it to decide between the text viewer and the hex viewer. */
FUNCTION HcIsBinaryFile( cFile )
   LOCAL hIn, nSize, cData := ""
   IF ValType( cFile ) != "C" .OR. ! hb_vfExists( cFile )
      RETURN .F.
   ENDIF
   hIn := FOpen( cFile, FO_READ )
   IF hIn == F_ERROR
      RETURN .F.
   ENDIF
   nSize := Min( 262144, Max( 0, hb_vfSize( cFile ) ) )
   IF nSize > 0
      cData := Space( nSize )
      nSize := FRead( hIn, @cData, nSize )
      IF ValType( nSize ) != "N" .OR. nSize <= 0
         cData := ""
      ELSE
         cData := Left( cData, nSize )
      ENDIF
   ENDIF
   FClose( hIn )
RETURN HcIsBinaryText( cData )

/* the whole file for the viewer, up to HX_MAXSIZE: { lOk, cData, cError } */
STATIC FUNCTION HcReadBytes( cFile )
   LOCAL hIn, nSize, cData
   IF ! hb_vfExists( cFile )
      RETURN { .F., "", "File not found:" + hb_eol() + cFile }
   ENDIF
   hIn := FOpen( cFile, FO_READ )
   IF hIn == F_ERROR
      RETURN { .F., "", "Cannot open " + cFile + ;
                          " (error " + LTrim( Str( FError() ) ) + ")" }
   ENDIF
   nSize := Min( HX_MAXSIZE, Max( 0, hb_vfSize( cFile ) ) )
   cData := Space( nSize )
   IF nSize > 0
      nSize := FRead( hIn, @cData, nSize )
      IF ValType( nSize ) != "N" .OR. nSize < 0
         nSize := 0
      ENDIF
   ENDIF
   FClose( hIn )
RETURN { .T., Left( cData, nSize ), "" }

/* one row of the dump on screen: the body colour first and, on top, the bytes
 * of the current match in the highlight colour (both in the hex block and in
 * the ASCII one, so a match is seen in the two views, S63) */
STATIC PROCEDURE HcHexPaintRow( nAbs, nOff, cChunk, nMFrom, nMTo )
   LOCAL nCols := HcHexCols()
   LOCAL aRow := HcHexRow( cChunk, nCols ), i, n
   SetColor( UI_C_DARK )
   @ nAbs, 0 SAY PadR( Upper( hb_NumToHex( nOff, 8 ) ) + "  " + aRow[ 1 ] + "  " + aRow[ 2 ], MaxCol() + 1 )
   IF nMFrom <= 0 .OR. nMTo < nOff .OR. nMFrom > ( nOff + Len( cChunk ) )
      RETURN
   ENDIF
   SetColor( UI_C_LISTSEL )
   FOR i := 1 TO Len( cChunk )
      n := nOff + i
      IF n >= nMFrom .AND. n <= nMTo
         @ nAbs, HX_OFFW + ( i - 1 ) * 3 SAY SubStr( aRow[ 1 ], ( i - 1 ) * 3 + 1, 2 )
         @ nAbs, HcHexAscCol( nCols ) + ( i - 1 ) SAY SubStr( aRow[ 2 ], i, 1 )
      ENDIF
   NEXT
RETURN

/* the whole hex screen in ONE paint block (no flicker) */
STATIC PROCEDURE HcHexDraw( cFile, cData, nTop, nCur, nMFrom, nMTo, cNote )
   LOCAL i, nAbs, nOff, nW := MaxCol() + 1, nCols := HcHexCols()
   LOCAL nRows := HcHexRows( cData, nCols )
   LOCAL cSt, cHex := "", cHdr := "", nC
   UiPaintBegin()
   SetColor( UI_C_CHIP )
   @ HE_TITLE, 0 SAY PadR( Left( cFile + "   [hex]", nW ), nW )
   // the column labels follow the width of the canvas (S64)
   FOR i := 1 TO nCols
      cHdr += Upper( hb_NumToHex( i - 1, 2 ) ) + " "
   NEXT
   @ HX_HDR, 0 SAY PadR( "Offset(h)  " + cHdr + "  ASCII", nW )
   FOR i := 0 TO ( HX_BOTTOM - HX_TOP )
      nAbs := HX_TOP + i
      IF nTop + i > nRows
         SetColor( UI_C_DARK )
         @ nAbs, 0 SAY Space( nW )
      ELSE
         nOff := ( nTop + i - 1 ) * nCols
         HcHexPaintRow( nAbs, nOff, SubStr( cData, nOff + 1, nCols ), nMFrom, nMTo )
      ENDIF
   NEXT
   cHex := ""
   IF nMFrom > 0
      cHex := "  [match " + Upper( hb_NumToHex( nMFrom - 1, 8 ) ) + "]"
   ENDIF
   cSt := " Offset(h) " + Upper( hb_NumToHex( ( nTop + nCur - 1 ) * nCols, 8 ) ) + ;
          "/" + Upper( hb_NumToHex( Max( 0, Len( cData ) ), 8 ) ) + ;
          "  Row(" + LTrim( Str( nTop + nCur ) ) + "/" + LTrim( Str( nRows ) ) + ")" + ;
          "  Size(" + LTrim( Str( Len( cData ) ) ) + ")" + cHex
   IF ! Empty( cNote )
      cSt += "  " + cNote
   ENDIF
   SetColor( UI_C_HINT )
   @ HE_STATUS, 0 SAY PadR( Left( cSt, nW ), nW )
   SetColor( UI_C_MENUBAR )
   @ HE_KEYS, 0 SAY Space( nW )
   @ HE_KEYS2, 0 SAY Space( nW )
   // S65: the chips are CHAINED with the column HcHintKey() returns, never
   // placed at fixed columns: the widths of "<Close>", "<Shift-F7>" and the
   // rest depend on the labels, and with fixed columns they were painted one
   // on top of the other (the user saw them all bunched together)
   nC := HcHintKey( HE_KEYS, 1, "F7", "=Find text" )
   nC := HcHintKey( HE_KEYS, nC, "Shift-F7", "=Find hex" )
   nC := HcHintKey( HE_KEYS, nC, "Esc", "=Leave" )
   nC := HcHintKey( HE_KEYS2, 1, "Up/Down", "=Row" )
   nC := HcHintKey( HE_KEYS2, nC, "PgUp/PgDn", "=Page" )
   nC := HcHintKey( HE_KEYS2, nC, "Home/End", "=Top/End" )
   nC := HcHintKey( HE_KEYS2, nC, "Wheel", "=Scroll" )
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()
RETURN

/* number of rows of the dump */
FUNCTION HcHexRows( cData, nCols )
   // NOTE: Empty() is .T. for a string of BLANKS too, so a buffer of spaces
   // would count as zero bytes: the length is what decides here
   DEFAULT nCols TO 16
   IF ValType( cData ) != "C" .OR. Len( cData ) == 0
      RETURN 1
   ENDIF
   nCols := Max( 1, nCols )
RETURN Int( ( Len( cData ) + nCols - 1 ) / nCols )

/* S61/S62/S63: the hex viewer of F3 */
STATIC PROCEDURE HcHexScreen( cFile )
   LOCAL aRes := HcReadBytes( cFile ), cData, nRows, nTop := 1, nCur := 1
   LOCAL nMFrom := 0, nMTo := 0, nKey, nWheel, cNote := ""
   LOCAL cLastTxt := "", cLastHex := "", cIn, cQ, nHit, nVis, nCols
   LOCAL lLeave := .F., lDraw := .T., cPrev
   IF ! aRes[ 1 ]
      UiErr( aRes[ 2 ], BP_APPNAME )
      RETURN
   ENDIF
   cData := aRes[ 2 ]
   nCols := HcHexCols()
   nRows := HcHexRows( cData, nCols )
   nVis := HX_BOTTOM - HX_TOP + 1
   IF Len( cData ) >= HX_MAXSIZE
      cNote := "[first " + LTrim( Str( Int( HX_MAXSIZE / 1024 ) ) ) + " KiB]"
   ENDIF
   cPrev := SetCursor( 0 )
   DO WHILE ! lLeave
      IF lDraw
         HcHexDraw( cFile, cData, nTop, nCur, nMFrom, nMTo, cNote )
         lDraw := .F.
      ENDIF
      nKey := Inkey( 0.05 )
      /* right-click-esc (S1/S2/S7): a plain right click leaves the hex viewer,
       * the same as Esc and F10 */
      IF nKey == 0 .AND. HcMouseRightClick()
         nKey := K_ESC
      ENDIF
      IF nKey == 0
         nWheel := HcMouseWheel()
         IF nWheel != 0
            nTop := Max( 1, Min( nRows - nVis + 1, nTop + nWheel * 3 ) )
            nCur := Max( 1, Min( nRows - nTop + 1, nCur ) )
            lDraw := .T.
         ENDIF
         LOOP
      ENDIF
      DO CASE
      CASE nKey == K_ESC .OR. nKey == K_F10
         lLeave := .T.
      CASE nKey == K_UP .OR. nKey == K_DOWN
         IF nKey == K_UP
            IF nCur > 1
               nCur--
            ELSE
               nTop := Max( 1, nTop - 1 )
            ENDIF
         ELSE
            IF nCur < nVis .AND. nTop + nCur <= nRows
               nCur++
            ELSE
               nTop := Min( Max( 1, nRows - nVis + 1 ), nTop + 1 )
            ENDIF
         ENDIF
         lDraw := .T.
      CASE nKey == K_PGUP .OR. nKey == K_PGDN
         IF nKey == K_PGUP
            nTop := Max( 1, nTop - nVis )
         ELSE
            nTop := Min( Max( 1, nRows - nVis + 1 ), nTop + nVis )
         ENDIF
         lDraw := .T.
      CASE nKey == K_HOME .OR. nKey == K_CTRL_HOME
         nTop := 1 ; nCur := 1 ; lDraw := .T.
      CASE nKey == K_END .OR. nKey == K_CTRL_END
         nTop := Max( 1, nRows - nVis + 1 ) ; nCur := nRows - nTop + 1 ; lDraw := .T.
      CASE nKey == K_F7 .OR. nKey == K_SH_F7
         /* S62: F7 searches TEXT, Shift-F7 searches BYTES (hex). The input is
          * prefilled with the last query of that kind, so pressing Enter again
          * is "find next" */
         IF nKey == K_F7
            cIn := UiInput( "Find text:", cLastTxt, 40 )
            cQ := HcHexQuery( iif( hb_IsNIL( cIn ), "", cIn ), .F. )
            IF ! hb_IsNIL( cIn ) .AND. ! Empty( cQ )
               cLastTxt := cIn
            ENDIF
         ELSE
            cIn := UiInput( "Find hex (e.g. EB 52 90):", cLastHex, 40 )
            cQ := HcHexQuery( iif( hb_IsNIL( cIn ), "", cIn ), .T. )
            IF ! hb_IsNIL( cIn ) .AND. ! Empty( cIn )
               cLastHex := cIn
            ENDIF
            IF ! hb_IsNIL( cIn ) .AND. Empty( cQ )
               UiMsg( "The hex text is not valid: use an even number of hex digits.", ;
                      BP_APPNAME )
               cQ := ""
            ENDIF
         ENDIF
         IF ! Empty( cQ )
            /* from the byte after the current match, and from the top again
             * when there is nothing left (the status says "wrapped") */
            nHit := HcHexFind( cData, cQ, iif( nMFrom > 0, nMTo + 1, 1 ) )
            cNote := ""
            IF nHit == 0
               nHit := HcHexFind( cData, cQ, 1 )
               cNote := "[wrapped]"
            ENDIF
            IF nHit == 0
               nMFrom := 0 ; nMTo := 0
               UiMsg( "Not found.", BP_APPNAME )
            ELSE
               nMFrom := nHit ; nMTo := nHit + Len( cQ ) - 1
               nTop := Max( 1, Min( nRows - nVis + 1, Int( ( nHit - 1 ) / nCols ) + 1 - Int( nVis / 2 ) ) )
               nCur := Int( ( nHit - 1 ) / nCols ) + 1 - nTop + 1
            ENDIF
            lDraw := .T.
         ENDIF
      ENDCASE
   ENDDO
   SetCursor( cPrev )
RETURN

STATIC PROCEDURE HcView( cFile )
   /* S3 of commander-link.md: nothing of a linked panel is viewed, edited or
    * run, and a *.DBF is never opened (no remote Browse view / Browse edit) */
   IF HcLinkGuard()
      RETURN
   ENDIF
   IF Empty( cFile )
      UiMsg( "Select a file to view.", BP_APPNAME )
      RETURN
   ENDIF
   /* S68: a DATABASE opens the read-only record browser. The test has to come
    * BEFORE the binary one: a .DBF is binary content, so it used to fall into
    * the hex viewer. One entry point only (HcView), which is what the F3 key,
    * the `Files > View` entry and the `F3 View` chip of the bottom bar reach. */
   IF HcIsDbfFile( cFile )
      HcDbfBrowse( cFile )
      RETURN
   ENDIF
   /* S61: BINARY content goes to the HEX viewer (the reference picture of the
    * user); a text file still opens the normal viewer */
   IF HcIsBinaryFile( cFile )
      HcHexScreen( cFile )
      RETURN
   ENDIF
   HcFileScreen( cFile, .F. )
RETURN

/* =====================================================================
 *  S68 -- READ-ONLY record browser: F3 on a *.DBF
 *
 *  A SIMPLE browser of the records of a database, with no editing at all:
 *  Enter, Ins and Del do nothing here. It exists because F3 on a .DBF used to
 *  fall into the hex viewer (a database is binary content).
 *
 *  It is READ-ONLY on purpose and that is what makes it work on a base that
 *  the main window already has open in EXCLUSIVE: the screen FIRST looks for a
 *  work area with that file (CoreAreaByFile()) and reuses it WITHOUT closing
 *  it, so no second `USE ... EXCLUSIVE` is ever attempted (that one fails with
 *  "Open error", measured). Only when the file is not open anywhere does the
 *  screen open it itself, and then SHARED: the screen never writes, and another
 *  process may be using the file. That area is closed again on exit; a reused
 *  one is left exactly as it was found (nothing is set, closed or moved).
 *
 *  Keys: arrows/Tab move the column, Up/Down the record, PgUp/PgDn a page,
 *  Home/End and Ctrl-PgUp/Ctrl-PgDn the first/last record, Ctrl-Home/Ctrl-End
 *  the first/last column, Esc leaves. F7 (or Ctrl-F) searches the text in the
 *  CURRENT field, Shift-F7 (or Ctrl-Shift-F) in ALL fields of the record,
 *  always from the record after
 *  the current one and wrapping once (the status row says `[wrapped]`), and
 *  the cursor moves to the field that matched. A record marked as deleted
 *  never matches: with SET DELETED ON it is not even visited, with SET DELETED
 *  OFF it is walked but skipped, so the position count stays the same as the
 *  one the walk from the top produces (it is never compared with a live one).
 * ===================================================================== */

/* S68: one field value as TEXT, exactly as the record browser paints it. The
 * screen and the headless bank both come through here, so "what you see is what
 * the search looks at" is ONE rule (UiValToStr()). aField is a DBF_* row:
 * { name, type, length, decimals, width }. */
FUNCTION HcFieldText( xVal, aField )
   IF ! HB_ISARRAY( aField ) .OR. Len( aField ) < DBF_DEC
      RETURN ""
   ENDIF
RETURN UiValToStr( xVal, aField[ DBF_TYPE ], aField[ DBF_LEN ], aField[ DBF_DEC ] )

/* S68: PURE search of the record browser. aTexts is ONE record with its values
 * already converted to text with HcFieldText(), which is what the screen paints.
 * The comparison is a case-insensitive SUBSTRING and the answer is the 1-based
 * index of the first field that contains cText, or 0 when none does.
 *   nOnlyField > 0  -> look at that field only (F7, the current column)
 *   nOnlyField == 0 -> walk every field (Shift-F7, the whole record)
 * An empty (or missing) query never matches: the caller cancels with it. */
FUNCTION DbfFindInFields( aTexts, cText, nOnlyField )
   LOCAL i, cWhat
   DEFAULT nOnlyField TO 0
   IF ! HB_ISARRAY( aTexts ) .OR. ValType( cText ) != "C" .OR. Len( cText ) == 0
      RETURN 0
   ENDIF
   IF ValType( nOnlyField ) != "N" .OR. nOnlyField < 0
      nOnlyField := 0
   ENDIF
   cWhat := Upper( cText )
   FOR i := 1 TO Len( aTexts )
      IF nOnlyField > 0 .AND. i != nOnlyField
         LOOP
      ENDIF
      /* a value that is not text can never contain the query (memo fields are
       * painted as <memo>, so <memo> is what they are searched as) */
      IF At( cWhat, Upper( iif( ValType( aTexts[ i ] ) == "C", aTexts[ i ], "" ) ) ) > 0
         RETURN i
      ENDIF
   NEXT
RETURN 0

/* the table of the open database: one DBF_* row per field of DbStruct().
 * NOTE: CoreView() is NOT used here: it belongs to the browser's global state
 * (column order, selected fields, locks) and this screen must show the fields
 * of the file, all of them and in file order. The width is Max( name, length )
 * because the browser's CoreColumnWidth() is STATIC in bp_core.prg.
 * S69: the 6th element is the FIELD NUMBER, which is what lets the search read
 * the same columns this table paints (all of them, in file order, here). */
STATIC FUNCTION HcDbFields()
   LOCAL aSt, a := {}, i
   IF ! Used()
      RETURN a
   ENDIF
   aSt := DbStruct()
   FOR i := 1 TO Len( aSt )
      AAdd( a, { aSt[ i ][ DBF_NAME ], aSt[ i ][ DBF_TYPE ], aSt[ i ][ DBF_LEN ], ;
                  aSt[ i ][ DBF_DEC ], Max( 1, Max( Len( aSt[ i ][ DBF_NAME ] ), aSt[ i ][ DBF_LEN ] ) ), ;
                  i } )
   NEXT
RETURN a

/* =====================================================================
 *  S69 -- the record search keys, SHARED by BOTH record browsers
 *
 *  MEASURED on this GTWVG with a throwaway probe that logged Inkey() and
 *  hb_gtInfo( HB_GTI_KBDSHIFTS ) for real key presses injected with
 *  keybd_event (NOT SendKeys, which does not hold the modifier):
 *
 *    press           Inkey()  HB_GTI_KBDSHIFTS     CTRL  SHIFT
 *    Ctrl+F            6      1186 = 0x4A2 (LCTRL)  yes   no
 *    Ctrl+Shift+F      6      1443 = 0x5A3          yes   yes (LSHIFT)
 *    plain f         102       160 = 0xA0 (INS+NUMLK) no   no
 *    End               6       160 = 0xA0          no    no
 *    Ctrl+H            8      1186 = 0x4A2          yes   no
 *    Ctrl+End         23      1186 = 0x4A2          yes   no
 *
 *  Two facts come out of it, and both are the reason for this table:
 *   - K_CTRL_F and K_END are the SAME code (6) in inkey.ch ("Ctrl-F, End"), so
 *     the key code ALONE cannot tell a Ctrl+F from an End. Only the CTRL bit of
 *     HB_GTI_KBDSHIFTS tells them apart, read right after Inkey() - the same
 *     channel the Alt+<letter> search of the panels uses (AGENTS.md traps
 *     37/38: this driver hands Alt+<letter> over as the plain letter too).
 *     Consequence for the key loops: the CASE of the search must come BEFORE
 *     the CASE of K_END, and the CTRL bit is what keeps End working as End.
 *   - the value is the LIVE modifier state, not a snapshot of the key: the
 *     probe saw it change while a modifier was held down and NO key was
 *     pressed. So it has to be read immediately after Inkey(); a tap that
 *     releases Ctrl in the same instant as the letter reads as plain key 6,
 *     which is End and behaves exactly as it did before this change.
 *
 *  The search itself is DbfFindInFields() (S68, PURE) over the record converted
 *  with DbfRecordText(), and the walk is DbfSearchRecords(). Both screens call
 *  the same three functions, so they cannot diverge; the only difference is the
 *  key table: the read-only browser has F7/Shift-F7 as well (DbfBrowseMode()).
 * ===================================================================== */

/* one bit of an HB_GTI_KBDSHIFTS value; a value that is not a number set no bit */
STATIC FUNCTION DbfShiftOn( nShift, nBit )
   IF ValType( nShift ) != "N"
      RETURN .F.
   ENDIF
RETURN hb_bitAnd( nShift, nBit ) != 0

/* S69: the search a key asks for, if any. PURE (the modifier state is passed in)
 * so the headless bank checks the whole rule without a window.
 *   ""       not a search key
 *   "FIELD"  the CURRENT column only (Ctrl-F)
 *   "RECORD" every field of the record (Ctrl-Shift-F)
 * The keys are Ctrl-F and Ctrl-Shift-F; F7/Shift-F7 belong to the read-only
 * screen only (DbfBrowseMode()) because in the main browser F1..F8 are menus. */
FUNCTION DbfSearchMode( nKey, nShift )
   IF ValType( nKey ) != "N"
      RETURN ""
   ENDIF
   /* K_CTRL_F IS K_END here: without the CTRL bit this is a plain End and it has
    * to stay one (End = last record of the order is an existing behaviour) */
   IF nKey != K_CTRL_F .OR. ! DbfShiftOn( nShift, HB_GTI_KBD_CTRL )
      RETURN ""
   ENDIF
   IF DbfShiftOn( nShift, HB_GTI_KBD_SHIFT )
      RETURN "RECORD"
   ENDIF
RETURN "FIELD"

/* S69: the whole key table of the READ-ONLY browser: its historical F7 (this
 * field) and Shift-F7 (the whole record) plus the Ctrl-F pair of both screens.
 * PURE, same answer shape as DbfSearchMode(). */
FUNCTION DbfBrowseMode( nKey, nShift )
   DO CASE
   CASE ValType( nKey ) == "N" .AND. nKey == K_F7
      RETURN "FIELD"
   CASE ValType( nKey ) == "N" .AND. nKey == K_SH_F7
      RETURN "RECORD"
   ENDCASE
RETURN DbfSearchMode( nKey, nShift )

/* S69: the FIELD NUMBER of one column of a table row { name, type, len, dec,
 * width [, field number] }. The number is carried in the 6th element because the
 * browser shows the fields in ITS order (CoreView()) and can hide some, so the
 * position in the table is not the field of the record; when the caller does not
 * carry one (the headless bank, a plain table) the position is the answer. */
STATIC FUNCTION DbfRowField( aRow, i )
   IF HB_ISARRAY( aRow ) .AND. Len( aRow ) >= 6 .AND. ValType( aRow[ 6 ] ) == "N"
      RETURN aRow[ 6 ]
   ENDIF
RETURN i

/* S69: the values of the CURRENT record as TEXT, exactly as painted: no row is
 * converted here by hand, HcFieldText() is the one conversion (UiValToStr()), so
 * "what you see is what the search looks at" still holds for both screens.
 * A row whose field number is 0 (the "(no fields)" placeholder of the browser)
 * answers "" and can never match. */
FUNCTION DbfRecordText( aFld )
   LOCAL a := {}, i, nF
   FOR i := 1 TO Len( aFld )
      nF := DbfRowField( aFld[ i ], i )
      IF nF >= 1
         AAdd( a, HcFieldText( FieldGet( nF ), aFld[ i ] ) )
      ELSE
         AAdd( a, "" )
      ENDIF
   NEXT
RETURN a

/* S69: the walk of the record search, shared by BOTH browsers. It starts at the
 * record AFTER nFrom and wraps ONCE to the top (the answer carries the note
 * "[wrapped]"); it stops on the first record where DbfFindInFields() answers a
 * field. A record marked as deleted is never a match (with SET DELETED ON it is
 * not even visited, with SET DELETED OFF it is walked and skipped, so the
 * position count is the same one a walk from the top produces).
 * Answers { position, field, note }; position 0 = not found, and then the pointer
 * is left on the record it started from. It only SKIPs: never writes. */
FUNCTION DbfSearchRecords( aFld, cText, nOnlyField, nFrom )
   LOCAL aRes := { 0, 0, "" }, nField, n, nPass
   IF ! Used() .OR. ! HB_ISARRAY( aFld )
      RETURN aRes
   ENDIF
   nFrom := Max( 1, nFrom )
   FOR nPass := 1 TO 2
      IF nPass == 1
         HcDbGotoPos( nFrom + 1 )
         n := nFrom + 1
      ELSE
         dbGoTop()
         n := 1
      ENDIF
      DO WHILE ! Eof()
         IF nPass == 2 .AND. n > nFrom
            EXIT
         ENDIF
         IF ! Deleted()
            nField := DbfFindInFields( DbfRecordText( aFld ), cText, nOnlyField )
            IF nField > 0
               aRes := { n, nField, iif( nPass == 2, "[wrapped]", "" ) }
               EXIT
            ENDIF
         ENDIF
         SKIP 1
         n++
      ENDDO
      IF aRes[ 1 ] > 0
         EXIT
      ENDIF
   NEXT
   IF aRes[ 1 ] == 0
      HcDbGotoPos( nFrom )
   ENDIF
RETURN aRes

/* S68: the work area in which the file is ALREADY open, or 0. CoreAreaByFile()
 * is the program's own test (it compares the base name, which is what makes an
 * already open database usable); the headless bank of T5 links this module
 * without bp_core.prg, so without the real program nothing is ever reused
 * (and this screen is never entered there). */
STATIC FUNCTION HcAreaByFile( cFile )
   LOCAL n := 0
#ifndef BP_HC_STANDALONE
   n := CoreAreaByFile( cFile )
#endif
RETURN n

/* .T. when that alias is already in use by some work area. Alias( n ) is "" for
 * a free one, which is the documented way to ask (AGENTS.md trap 25). */
STATIC FUNCTION HcAliasUsed( cAlias )
   LOCAL i
   FOR i := 1 TO 64
      IF Upper( Alias( i ) ) == Upper( cAlias )
         RETURN .T.
      ENDIF
   NEXT
RETURN .F.

/* an alias for the file we are about to open: the clean stem of the file name
 * plus a counter when it is taken (a second open in another area would fail with
 * "Alias already in use") */
STATIC FUNCTION HcFreeAlias( cFile )
   LOCAL cBase := "", c, i, ch, n := 0
   c := Upper( HcStem( cFile ) )
   FOR i := 1 TO Len( c )
      ch := SubStr( c, i, 1 )
      IF ( ch >= "A" .AND. ch <= "Z" ) .OR. ( ch >= "0" .AND. ch <= "9" ) .OR. ch == "_"
         cBase += ch
      ENDIF
   NEXT
   IF Empty( cBase )
      cBase := "HCDB"
   ENDIF
   cBase := Left( cBase, 6 )
   c := cBase
   DO WHILE HcAliasUsed( c )
      n++
      c := cBase + LTrim( Str( n ) )
   ENDDO
RETURN c

/* close the area only when THIS screen opened it; the SELECT is wrapped because
 * an area number that is no longer valid must never take the screen down */
STATIC PROCEDURE HcDbCloseArea( nArea )
   IF nArea <= 0
      RETURN
   ENDIF
   BEGIN SEQUENCE WITH {| e | Break( e ) }
      SELECT ( nArea )
      IF Used()
         dbCloseArea()
      ENDIF
   RECOVER
   END SEQUENCE
RETURN

/* leave the caller's work area selected again (0 or a stale number: nothing to do) */
STATIC PROCEDURE HcSelectArea( nArea )
   IF nArea <= 0
      RETURN
   ENDIF
   BEGIN SEQUENCE WITH {| e | Break( e ) }
      SELECT ( nArea )
   RECOVER
   END SEQUENCE
RETURN

/* 1-based position of the record the pointer is on, walking the ACTIVE order.
 * Bof()/Eof() are PHYSICAL (AGENTS.md trap 18), so the position cannot be read
 * from the engine; this is the same walk the browser does in CorePosFromRec(),
 * which is STATIC in bp_core.prg and therefore cannot be called from here.
 * It leaves the pointer on that same record. */
STATIC FUNCTION HcDbPosFromRec()
   LOCAL n := 0, nRec := RecNo()
   IF LastRec() <= 0
      RETURN 1
   ENDIF
   dbGoTop()
   DO WHILE ! Eof()
      n++
      IF RecNo() == nRec
         EXIT
      ENDIF
      SKIP 1
   ENDDO
   IF Eof()
      IF n > 0
         SKIP -1
      ENDIF
   ENDIF
RETURN Max( 1, n )

/* put the pointer on the n-th record of the active order */
STATIC PROCEDURE HcDbGotoPos( nPos )
   dbGoTop()
   IF nPos > 1
      SKIP ( nPos - 1 )
   ENDIF
   IF Eof() .AND. LastRec() > 0
      dbGoBottom()
   ENDIF
RETURN

/* window top that keeps the current record visible: the ONE rule every move
 * uses, so the cursor can never leave the record area */
STATIC FUNCTION HcDbTop( nPos, nTop, nVis )
   IF nTop < 1
      nTop := 1
   ENDIF
   IF nPos < nTop
      nTop := nPos
   ENDIF
   IF nPos > nTop + nVis - 1
      nTop := nPos - nVis + 1
   ENDIF
   IF nTop < 1
      nTop := 1
   ENDIF
RETURN nTop

/* S1 of browse-edit-mouse.md: the body of the ^ and v keys as ONE helper, so the
 * wheel of the read-only browser walks exactly the same steps and clamps as the
 * keyboard (it used to translate a notch into a key code and got the direction
 * backwards). nDelta < 0 is the previous record, > 0 the next one. Bof()/Eof()
 * are PHYSICAL (trap 18), so what stops the walk is the LOGICAL position nPos on
 * the way up and Eof() on the way down, like the screen always did.
 * Answers { nPos, nTop, lDraw }: lDraw says the record moved and the screen has
 * to be repainted. */
STATIC FUNCTION HcDbMove( nDelta, nPos, nTop, nVis )
   LOCAL lDraw := .F.
   IF ValType( nDelta ) != "N" .OR. nDelta == 0
      RETURN { nPos, nTop, .F. }
   ENDIF
   IF nDelta < 0
      IF nPos > 1
         SKIP -1
         IF Bof()
            SKIP 1
         ELSE
            nPos--
            nTop := HcDbTop( nPos, nTop, nVis )
            lDraw := .T.
         ENDIF
      ENDIF
   ELSE
      SKIP 1
      IF Eof()
         SKIP -1
      ELSE
         nPos++
         nTop := HcDbTop( nPos, nTop, nVis )
         lDraw := .T.
      ENDIF
   ENDIF
RETURN { nPos, nTop, lDraw }

/* first column of the table that still fits the selected one. Same idea as the
 * browser's CoreCol1() (STATIC there), with the browser's step: the width of
 * the field plus three gap cells, the middle one being the │ separator. */
STATIC FUNCTION HcDbCol1( aFld, nSel )
   LOCAL nCol1 := 1, nAvail := MaxCol() + 1 - BP_COL_BASE, nW, i
   DO WHILE nCol1 < nSel
      nW := 0
      FOR i := nCol1 TO nSel
         nW += aFld[ i ][ DBF_WID ] + 3
      NEXT
      IF nW > nAvail
         nCol1++
      ELSE
         EXIT
      ENDIF
   ENDDO
RETURN nCol1

/* one record row: the current record in RED with the cursor cell in GREEN (the
 * same pair as the main browser), a deleted one DIM, a live one normal. The │
 * separators are painted over the row colour. */
STATIC PROCEDURE HcDbPaintRow( nAbs, aFld, nSel, nCol1, lCur, lDel )
   LOCAL i, nUsedW := 0, cTxt, nSeg
   SetColor( UI_C_DESKTOP )
   @ nAbs, 0 SAY Space( MaxCol() + 1 )
   FOR i := nCol1 TO Len( aFld )
      IF BP_COL_BASE + nUsedW + aFld[ i ][ DBF_WID ] - 1 > MaxCol()
         EXIT
      ENDIF
      cTxt := HcFieldText( FieldGet( i ), aFld[ i ] )
      IF i > nCol1
         SetColor( UI_C_DESKTOP )
         @ nAbs, BP_COL_BASE + nUsedW - 2 SAY BP_SEP_VERT
      ENDIF
      IF lCur
         nSeg := Max( 1, Min( aFld[ i ][ DBF_LEN ], aFld[ i ][ DBF_WID ] ) )
         SetColor( iif( i == nSel, UI_C_CURSEL, UI_C_RECSEL ) )
         @ nAbs, BP_COL_BASE + nUsedW SAY PadR( Left( cTxt, nSeg ), nSeg )
      ELSE
         SetColor( iif( lDel, UI_C_RECDEL, UI_C_REC ) )
         @ nAbs, BP_COL_BASE + nUsedW SAY PadR( Left( cTxt, aFld[ i ][ DBF_WID ] ), aFld[ i ][ DBF_WID ] )
      ENDIF
      nUsedW += aFld[ i ][ DBF_WID ] + 3
   NEXT
   SetColor( UI_C_DESKTOP )
RETURN

/* the whole screen in ONE paint block (no flicker) */
STATIC PROCEDURE HcDbDraw( cFile, aFld, nSel, nTop, nPos, cMsg )
   LOCAL nW := MaxCol() + 1, i, nUsedW := 0, nAbs, nRow, nCol1 := HcDbCol1( aFld, nSel )
   LOCAL cSt, nC, cTit
   cTit := cFile + "   [browse]"
   UiPaintBegin()
   SetColor( UI_C_CHIP )
   @ DB_TITLE, 0 SAY PadR( Left( cTit, nW ), nW )
   /* header row with the field names, and the rule under it */
   SetColor( UI_C_HDR )
   @ DB_HDR, 0 SAY Space( nW )
   FOR i := nCol1 TO Len( aFld )
      IF BP_COL_BASE + nUsedW + aFld[ i ][ DBF_WID ] - 1 > MaxCol()
         EXIT
      ENDIF
      @ DB_HDR, BP_COL_BASE + nUsedW SAY PadR( Left( aFld[ i ][ DBF_NAME ], aFld[ i ][ DBF_WID ] ), ;
                                              aFld[ i ][ DBF_WID ] )
      nUsedW += aFld[ i ][ DBF_WID ] + 3
   NEXT
   SetColor( UI_C_DESKTOP )
   @ DB_RULE, 0 SAY Replicate( BP_LINE_DOUBLE, nW )
   /* the records, walking from the top of the window */
   dbGoTop()
   IF nTop > 1
      SKIP ( nTop - 1 )
   ENDIF
   FOR nRow := 1 TO DB_VIS
      nAbs := DB_TOP + nRow - 1
      IF Eof()
         SetColor( UI_C_DESKTOP )
         @ nAbs, 0 SAY Space( nW )
      ELSE
         HcDbPaintRow( nAbs, aFld, nSel, nCol1, ( nTop + nRow - 1 == nPos ), Deleted() )
         SKIP 1
      ENDIF
   NEXT
   /* the pointer has walked past the window: put it back on the current record,
    * which is where every navigation and the status row expect it */
   HcDbGotoPos( Max( 1, nPos ) )
   /* status row: the record counter of the main browser, the current column and
    * the answer of a search (`[wrapped]`, `Not found.`) */
   cSt := " Rec. " + LTrim( Str( RecNo() ) ) + "/" + LTrim( Str( LastRec() ) ) + ;
          "  Col " + aFld[ nSel ][ DBF_NAME ] + "  [read-only]"
   IF ! Empty( cMsg )
      cSt += "  " + cMsg
   ENDIF
   SetColor( UI_C_HINT )
   @ DB_STATUS, 0 SAY PadR( Left( cSt, nW ), nW )
   /* help row: the chips are CHAINED (AGENTS.md: fixed columns put them one on
    * top of the other as soon as a label grows) */
   SetColor( UI_C_MENUBAR )
   @ DB_KEYS, 0 SAY Space( nW )
   /* S69: Ctrl-F does the same as F7 in the current field and Ctrl-Shift-F the
    * same as Shift-F7 in the whole record, and the row SAYS so (a screen that
    * keeps its shortcuts to itself leaves them unfindable). Both key labels go
    * in one chip, so the row still ends at cell 118 of 120. */
   nC := HcHintKey( DB_KEYS, 1, "F7/C-F", "=Find field" )
   nC := HcHintKey( DB_KEYS, nC, "S-F7/C-S-F", "=Find record" )
   nC := HcHintKey( DB_KEYS, nC, "Esc", "=Leave" )
   nC := HcHintKey( DB_KEYS, nC, "Arrows", "=Move" )
   nC := HcHintKey( DB_KEYS, nC, "PgUp/PgDn", "=Page" )
   nC := HcHintKey( DB_KEYS, nC, "Ctl-PgUp/Dn", "=Top/Bottom" )
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()
RETURN

/* S68: the screen. READ-ONLY: Enter, Ins and Del are deliberately not handled. */
STATIC PROCEDURE HcDbfBrowse( cFile )
   LOCAL nPrevArea := Select(), nArea := 0, lOpened := .F., cAlias
   LOCAL aFld, nSel := 1, nTop := 1, nPos := 1, nVis := DB_VIS
   LOCAL nKey, nShift := 0, cMode := "", nWheel, lLeave := .F., lDraw := .T., cPrevCur
   LOCAL cLast := "", cIn, aRes, cMsg := "", i, nOld, oErr
   LOCAL aMvD := { 1, 1, .F. }
   LOCAL nMsgPos := 0, nMsgSel := 0

   /* 1) the area that ALREADY has this file open is reused and NEVER closed:
    * this is what makes the screen work on a base the main window opened in
    * EXCLUSIVE (a second USE in EXCLUSIVE fails with "Open error"). */
   nArea := HcAreaByFile( cFile )
   IF nArea == 0
      /* 2) not open anywhere: open it here, SHARED (the screen does not write
       * and another process may be using the file) and close it on exit */
      cAlias := HcFreeAlias( cFile )
      BEGIN SEQUENCE WITH {| e | Break( e ) }
         dbUseArea( .T., "DBFCDX", cFile, cAlias, .T. )
         nArea := Select()
         lOpened := .T.
      RECOVER USING oErr
         nArea := 0
      END SEQUENCE
      IF nArea == 0
         UiErr( "Cannot open " + cFile + hb_eol() + ;
                "(it may be held in EXCLUSIVE by another process)" + hb_eol() + ;
                oErr:Description, BP_APPNAME )
         RETURN
      ENDIF
   ENDIF
   IF nArea <= 0
      UiErr( "Cannot open " + cFile, BP_APPNAME )
      RETURN
   ENDIF
   HcSelectArea( nArea )
   IF ! Used()
      UiErr( "Cannot open " + cFile, BP_APPNAME )
      RETURN
   ENDIF
   aFld := HcDbFields()
   IF Empty( aFld )
      UiErr( cFile + hb_eol() + "No fields in this database.", BP_APPNAME )
      HcDbCloseArea( nArea )
      HcSelectArea( nPrevArea )
      RETURN
   ENDIF
   nPos := Max( 1, HcDbPosFromRec() )
   nTop := HcDbTop( nPos, nPos, nVis )

   /* the screen paints its own cursor cell, so the SYSTEM caret is hidden for
    * the whole time it is up (UiPaintBegin/End restores it after every paint and
    * it would blink in the wrong place, see AGENTS.md "Repintado") */
   cPrevCur := SetCursor( 0 )

   DO WHILE ! lLeave
      /* a message of a search belongs to the record and the column where it was
       * produced: moving away from them clears it. A key that changes NOTHING
       * (Enter, Del, Ins, a modifier of its own...) leaves it on screen, so the
       * answer of the search does not vanish the moment it is given. */
      IF ! Empty( cMsg ) .AND. ( nPos != nMsgPos .OR. nSel != nMsgSel )
         cMsg := ""
         lDraw := .T.
      ENDIF
      IF lDraw
         HcDbDraw( cFile, aFld, nSel, nTop, nPos, cMsg )
         lDraw := .F.
      ENDIF
      nKey := Inkey( 0.05 )
      /* right-click-esc (S1/S2/S7): a plain right click leaves the Browse view
       * and goes back to the panels, the same as Esc. This screen read no click
       * at all before; the grid of the Browse edit is a different screen and
       * keeps its record menu (S8). */
      IF nKey == 0 .AND. HcMouseRightClick()
         nKey := K_ESC
      ENDIF
      IF nKey == 0
         /* S1 of browse-edit-mouse.md: ONE record per notch and a POSITIVE
          * notch (the wheel turning away from the user) goes to the PREVIOUS
          * record - the same convention as the panels of the manager
          * (HcWheelTarget() answers nSel - nNotch). This mapping used to be
          * inverted, so the screen scrolled the wrong way, and it collapsed a
          * spin of several notches into a single record: both are fixed here by
          * walking the same helper the ^ and v keys use. */
         nWheel := HcMouseWheel()
         IF nWheel == 0
            LOOP
         ENDIF
         FOR i := 1 TO Min( Abs( nWheel ), 1000 )
            aMvD := HcDbMove( iif( nWheel > 0, -1, 1 ), nPos, nTop, nVis )
            nPos := aMvD[ 1 ]
            nTop := aMvD[ 2 ]
            IF aMvD[ 3 ]
               lDraw := .T.
            ENDIF
         NEXT
         /* nothing to dispatch: the wheel already moved the record, and it is
          * not a search key either - drop what the LAST key asked for, or a
          * search would fire again on the next notch */
         nKey := 0
         nShift := 0
         cMode := ""
      ELSE
         /* the modifier state of the key just read, IMMEDIATELY after Inkey()
          * and before anything else touches the driver (S69: this is the only
          * way to tell Ctrl-F from End) */
         nShift := HcShiftState()
         cMode := DbfBrowseMode( nKey, nShift )
      ENDIF
      DO CASE
      CASE nKey == K_ESC .OR. nKey == K_F10
         lLeave := .T.

      /* --- the COLUMN --- */
      CASE nKey == K_RIGHT .OR. nKey == K_TAB
         nSel := Min( Len( aFld ), nSel + 1 )
         lDraw := .T.
      CASE nKey == K_LEFT .OR. nKey == K_SH_TAB
         nSel := Max( 1, nSel - 1 )
         lDraw := .T.
      CASE nKey == K_CTRL_HOME
         nSel := 1
         lDraw := .T.
      CASE nKey == K_CTRL_END
         nSel := Len( aFld )
         lDraw := .T.

      /* --- the SEARCH: F7 / Ctrl-F = this field, Shift-F7 / Ctrl-Shift-F =
       * the whole record (S69). This CASE MUST come before the K_END one
       * below: K_CTRL_F and K_END are the same code (6) and what keeps End
       * working as End is the CTRL bit, not the order of the CASEs - but a
       * plain End must fall through to K_END, and it does because cMode is
       * empty for it. --- */
      CASE ! Empty( cMode )
         cIn := UiInput( iif( cMode == "FIELD", "Find in this field:", "Find in the record:" ), ;
                         cLast, 40 )
         IF hb_IsNIL( cIn ) .OR. Len( AllTrim( cIn ) ) == 0
            /* Esc (NIL) or an empty query cancels: nothing moves */
            cMsg := ""
            lDraw := .T.
         ELSE
            /* the last text is proposed again, so Enter searches the next one */
            cLast := cIn
            aRes := DbfSearchRecords( aFld, cIn, iif( cMode == "FIELD", nSel, 0 ), nPos )
            IF aRes[ 1 ] == 0
               /* a NEGATIVE answer is a MODAL BOX, like in the Browse edit:
                * the note of the status row was too small to be read
                * (reported). Nothing moves and the note stays empty. */
               cMsg := ""
               UiMsg( "Not found.", BP_APPNAME )
            ELSE
               nPos := aRes[ 1 ]
               nSel := aRes[ 2 ]
               cMsg := aRes[ 3 ]
               HcDbGotoPos( nPos )
               nTop := HcDbTop( nPos, nPos - Int( nVis / 2 ), nVis )
            ENDIF
            /* the message belongs to THIS record and column */
            nMsgPos := nPos ; nMsgSel := nSel
         ENDIF
         lDraw := .T.

      /* --- the RECORD --- */
      CASE nKey == K_UP
         aMvD := HcDbMove( -1, nPos, nTop, nVis )
         nPos := aMvD[ 1 ]
         nTop := aMvD[ 2 ]
         IF aMvD[ 3 ]
            lDraw := .T.
         ENDIF
      CASE nKey == K_DOWN
         aMvD := HcDbMove( 1, nPos, nTop, nVis )
         nPos := aMvD[ 1 ]
         nTop := aMvD[ 2 ]
         IF aMvD[ 3 ]
            lDraw := .T.
         ENDIF
      CASE nKey == K_PGDN
         /* one page, keeping the screen row of the cursor (like the main
          * browser): the window moves by the same amount as the record */
         nOld := nPos
         FOR i := 1 TO nVis
            SKIP 1
            IF Eof()
               SKIP -1
               EXIT
            ENDIF
            nPos++
         NEXT
         nTop := HcDbTop( nPos, nTop + ( nPos - nOld ), nVis )
         lDraw := .T.
      CASE nKey == K_PGUP
         nOld := nPos
         FOR i := 1 TO nVis
            IF nPos <= 1
               EXIT
            ENDIF
            SKIP -1
            IF Bof()
               SKIP 1
               EXIT
            ENDIF
            nPos--
         NEXT
         nTop := HcDbTop( nPos, nTop + ( nPos - nOld ), nVis )
         lDraw := .T.
      CASE nKey == K_HOME .OR. nKey == K_CTRL_PGUP
         dbGoTop()
         nPos := 1
         nTop := 1
         lDraw := .T.
      CASE nKey == K_END .OR. nKey == K_CTRL_PGDN
         dbGoBottom()
         nPos := HcDbPosFromRec()
         nTop := HcDbTop( nPos, nPos - nVis + 1, nVis )
         lDraw := .T.

      /* everything else (Enter, Ins, Del, menus, F-keys) does NOTHING: the
       * screen is read-only and has no menus */
      ENDCASE
   ENDDO

   /* only what this screen opened is closed; a reused area is left untouched
    * (still open, still selected where the caller had it) */
   IF lOpened
      HcDbCloseArea( nArea )
   ENDIF
   HcSelectArea( nPrevArea )
   SetCursor( cPrevCur )
RETURN

STATIC PROCEDURE HcEdit( cFile )
   IF HcLinkGuard()
      RETURN
   ENDIF
   IF Empty( cFile )
      UiMsg( "Select a file to edit.", BP_APPNAME )
      RETURN
   ENDIF
   /* S66: F4 on a database does EXACTLY what Enter does - the path goes back to
    * the caller and the record browser opens instead of the editor. Only the
    * flag is set here: the key loop reads it and leaves the screen, so the F4
    * key, the `Files > Edit` entry and the `F4` chip behave the same. */
   IF HcIsDbfFile( cFile )
      s_cHcOpen := cFile
      RETURN
   ENDIF
   HcFileScreen( cFile, .T. )
RETURN

/* reads the file into a line array: { lOk, aLines, cError } */
STATIC FUNCTION HcReadText( cFile )
   LOCAL nHandle, nSize, nRead, cData
   IF ! hb_vfExists( cFile )
      RETURN { .F., {}, "File not found:" + hb_eol() + cFile }
   ENDIF
   nHandle := FOpen( cFile, FO_READ )
   IF nHandle < 0
      RETURN { .F., {}, "Cannot open " + cFile + hb_eol() + ;
                        "(error " + LTrim( Str( FError() ) ) + ")" }
   ENDIF
   nSize := FSeek( nHandle, 0, FS_END )
   FSeek( nHandle, 0, FS_SET )
   IF nSize > HE_MAXSIZE
      FClose( nHandle )
      RETURN { .F., {}, "File too large for this screen:" + hb_eol() + cFile + hb_eol() + ;
                        "(" + LTrim( Str( Int( nSize / 1024 ) ) ) + " KiB, limit " + ;
                        LTrim( Str( Int( HE_MAXSIZE / 1024 ) ) ) + " KiB)" }
   ENDIF
   cData := Space( Max( 0, nSize ) )
   IF nSize > 0
      nRead := FRead( nHandle, @cData, nSize )
      IF ValType( nRead ) != "N" .OR. nRead < 0
         nRead := 0
      ENDIF
      IF nRead != nSize
         cData := Left( cData, nRead )
      ENDIF
   ENDIF
   FClose( nHandle )
   IF HcIsBinaryText( cData )
      RETURN { .F., {}, "Binary file: it is not shown." + hb_eol() + cFile }
   ENDIF
   /* S60: a DOS text file may end with Ctrl-Z (the old end-of-file marker); it
    * is not shown, it is not part of the text */
   DO WHILE ! Empty( cData ) .AND. Right( cData, 1 ) == Chr( 26 )
      cData := Left( cData, Len( cData ) - 1 )
   ENDDO
RETURN { .T., HcSplitLines( cData ), "" }

/* writes the buffer back: { lOk, cError } */
STATIC FUNCTION HcWriteText( cFile, aLines )
   LOCAL nHandle, cData, nWritten
   cData := HcJoinLines( aLines )
   nHandle := FCreate( cFile )
   IF nHandle < 0
      RETURN { .F., "Cannot create " + cFile + hb_eol() + ;
                     "(error " + LTrim( Str( FError() ) ) + ")" }
   ENDIF
   nWritten := FWrite( nHandle, cData )
   FClose( nHandle )
   IF ValType( nWritten ) != "N" .OR. nWritten != Len( cData )
      RETURN { .F., "Cannot write " + cFile + hb_eol() + ;
                     "(error " + LTrim( Str( FError() ) ) + ")" }
   ENDIF
RETURN { .T., "" }

STATIC FUNCTION HcSaveBuffer( cFile, aLines )
   LOCAL aRes := HcWriteText( cFile, aLines )
   IF ! aRes[ 1 ]
      UiErr( aRes[ 2 ], "Editor" )
      RETURN .F.
   ENDIF
   /* S49: F4 saved a file; if it belongs to the working tree of an open
    * archive, the archive is rewritten now */
   HcZipSync()
RETURN .T.

/* S8 of hc-editor-tabs.md: the ONE save of the editor. Both keys that write the
 * buffer - the K_F2 CASE of the loop and the Ctrl+S one (HcSaveKey()) - come
 * through here, so the write, the moved baseline and the cleared `modified` flag
 * cannot drift apart: a failed write leaves the tab modified AND its baseline
 * where it was, which is the truth (the file did not change). `aTab` is the
 * record of the ACTIVE tab (HcTabAt()) or NIL in the read-only viewer, where the
 * two keys do nothing at all. */
STATIC FUNCTION HcSaveTab( cFile, aLines, aTab )
   IF ! HcSaveBuffer( cFile, aLines )
      RETURN .F.
   ENDIF
   HcTabSnap( aTab, aLines )
RETURN .T.

/* Esc with a modified buffer: ONE question, and the answer is the end of it.
 * Yes = save and leave (a failed write keeps the editor open, because the work
 * is still there to be saved again). No = leave WITHOUT saving and without a
 * second "Discard the changes?" ask: the user asked for exactly that ("le digo
 * que no al guardar, que no me vuelva a preguntar"), so "No" now means "go out
 * and drop the changes" instead of "ask me again". */
STATIC FUNCTION HcAskSave( cFile, aLines )
   IF UiConfirm( "Save the changes to" + hb_eol() + cFile + "?", "Editor" )
      RETURN HcSaveBuffer( cFile, aLines )
   ENDIF
RETURN .T.

/* keeps the caret inside the visible window of a long line */
STATIC FUNCTION HcFixLeft( nCol, nLft, nW )
   IF nCol < nLft
      RETURN nCol
   ENDIF
   IF nCol >= nLft + nW
      RETURN nCol - nW + 1
   ENDIF
RETURN nLft

/* one row of the hint lines: <key>=action, keys in the bar colours */
STATIC FUNCTION HcHintKey( nRow, nCol, cKey, cAct )
   SetColor( UI_C_MENUKEY )
   @ nRow, nCol SAY "<" + cKey + ">"
   SetColor( UI_C_MENUBAR )
   @ nRow, nCol + Len( cKey ) + 2 SAY cAct
RETURN nCol + Len( cKey ) + 2 + Len( cAct ) + 2

/* =====================================================================
 *  S122 -- SESSION TABS OF THE TEXT EDITOR (odd/tasks/hc-editor-tabs.md)
 *
 *  The editor (`F4`) keeps several files open at once: a bar of tabs on row
 *  HE_TITLE, the full path of the active one on the status row, and ONE record
 *  per file with everything the screen needs to come back exactly where it was.
 *  The list is a STATIC of this module (session state, S9: no file is written
 *  and closing hwBro loses it, which is what the user asked for).
 *
 *  Everything below is PURE and public, like the rest of the helpers the
 *  headless bank pins: no window, no driver, no disk. The screen only provides
 *  the numbers.
 *
 *  The buffer travels as a REFERENCE (Harbour arrays are references, AGENTS
 *  trap 67), so a tab switch copies nothing and, above all, the buffer of the
 *  tab that is left is NEVER read from the disk again (S2: switching tabs must
 *  not throw away unsaved work). The only disk question the model asks is the
 *  one of S11: is the file still there?
 * ===================================================================== */

/* S1: a fresh tab for a path, with EVERY slot present. The code pages are
 * filled in by HcFileScreen() when it stores the screen the first time; these
 * are the values a record that has not been painted yet can safely use. The
 * saved-text baseline (HC_TB_SAV) is EMPTY: a record that was never painted has
 * no save behind it, and an empty array never equals a real buffer. */
FUNCTION HcTabNew( cPath )
   IF ValType( cPath ) != "C"
      cPath := ""
   ENDIF
RETURN { cPath, { "" }, 1, 0, 0, 0, .F., .F., "", "", 4, ;
         NIL, {}, {}, NIL, { 0, 0, 0 }, "", "", {} }

/* S1: the tab of a path (1-based) or 0 when the session has none. The compare is
 * case-INSENSITIVE, like every other path compare of the manager: a Windows path
 * is not case sensitive, so C:\A.TXT and c:\a.txt are the same tab and opening
 * the second one must not create a duplicate. `==` is the exact operator on
 * purpose (AGENTS trap 20: with SET EXACT OFF `=` pads, so an empty right side
 * matches anything). */
FUNCTION HcTabIndex( aTabs, cPath )
   LOCAL i, c := iif( ValType( cPath ) == "C", Upper( AllTrim( cPath ) ), "" )
   IF ! HB_ISARRAY( aTabs ) .OR. Len( c ) == 0
      RETURN 0
   ENDIF
   FOR i := 1 TO Len( aTabs )
      IF HB_ISARRAY( aTabs[ i ] ) .AND. Len( aTabs[ i ] ) >= HC_TB_FIND .AND. ;
         ValType( aTabs[ i ][ HC_TB_PATH ] ) == "C" .AND. ;
         Upper( aTabs[ i ][ HC_TB_PATH ] ) == c
         RETURN i
      ENDIF
   NEXT
RETURN 0

/* S1: the record of a tab, or NIL when nSel is not one (index 0, an index past
 * the end, a NIL array). It is the ONE door to the session, so a caller holding
 * a stale index cannot index the array itself. */
FUNCTION HcTabAt( aTabs, nSel )
   IF ! HB_ISARRAY( aTabs ) .OR. ValType( nSel ) != "N"
      RETURN NIL
   ENDIF
   IF nSel < 1 .OR. nSel > Len( aTabs ) .OR. ! HB_ISARRAY( aTabs[ nSel ] )
      RETURN NIL
   ENDIF
RETURN aTabs[ nSel ]

/* S1: add the tab of a path when it is NOT there and answer its index. An
 * existing tab is never duplicated and its buffer is kept - that is the whole
 * point of S1: `F4` on a file that already has a tab ACTIVATES it. The array is
 * the caller's (Harbour arrays are references), so this is the ONE place the
 * session grows. */
FUNCTION HcTabAdd( aTabs, cPath )
   LOCAL nIdx
   IF ! HB_ISARRAY( aTabs )
      RETURN 0
   ENDIF
   nIdx := HcTabIndex( aTabs, cPath )
   IF nIdx > 0
      RETURN nIdx
   ENDIF
   AAdd( aTabs, HcTabNew( cPath ) )
RETURN Len( aTabs )

/* S6: the tab that has to be active when the one at nIdx is closed, counted on
 * the array WITHOUT it: the next one takes its place and, when the LAST one
 * closes, the one before it, so the bar never jumps to the other end. Answers
 * -1 for an index that is not a tab and 0 when nothing would be left. */
FUNCTION HcTabAfter( aTabs, nIdx )
   LOCAL n
   IF ! HB_ISARRAY( aTabs )
      RETURN -1
   ENDIF
   n := Len( aTabs )
   IF ValType( nIdx ) != "N" .OR. nIdx < 1 .OR. nIdx > n
      RETURN -1
   ENDIF
   IF n <= 1
      RETURN 0
   ENDIF
RETURN iif( nIdx < n, nIdx, nIdx - 1 )

/* S6: close one tab. It answers { aNewTabs, nSel }: a NEW array - the caller's
 * one is not touched, so a close that ends half way cannot leave the session
 * half closed - and the tab that has to be active afterwards. nSel is the active
 * index BEFORE the close:
 *   the closed tab was not the active -> the same one, shifted when the closed
 *                                       one was in front of it
 *   the closed tab WAS the active     -> its neighbour (HcTabAfter())
 *   nothing is left                   -> 0, and the screen goes back (S6)
 */
FUNCTION HcTabClose( aTabs, nIdx, nSel )
   LOCAL aNew := {}, nNew := 0, i
   IF ! HB_ISARRAY( aTabs )
      RETURN { {}, 0 }
   ENDIF
   FOR i := 1 TO Len( aTabs )
      IF i != nIdx
         AAdd( aNew, aTabs[ i ] )
      ENDIF
   NEXT
   IF ValType( nIdx ) != "N" .OR. nIdx < 1 .OR. nIdx > Len( aTabs )
      /* nothing was closed: the session comes back exactly as it was */
      IF ValType( nSel ) == "N"
         RETURN { aNew, Max( 0, Min( nSel, Len( aNew ) ) ) }
      ENDIF
      RETURN { aNew, 0 }
   ENDIF
   DO CASE
   CASE Len( aNew ) == 0
      nNew := 0
   CASE ValType( nSel ) != "N" .OR. nSel < 1 .OR. nSel > Len( aTabs )
      nNew := 1                        /* no usable cursor: the first tab */
   CASE nIdx == nSel
      nNew := HcTabAfter( aTabs, nIdx )
   CASE nIdx < nSel
      nNew := nSel - 1
   OTHERWISE
      nNew := nSel
   ENDCASE
RETURN { aNew, nNew }

/* S5: the tab nDir steps away from nIdx, wrapping at both ends (the bar walks
 * them that way); 0 when there is no other tab to go to. */
FUNCTION HcTabStep( aTabs, nIdx, nDir )
   LOCAL n
   IF ! HB_ISARRAY( aTabs )
      RETURN 0
   ENDIF
   n := Len( aTabs )
   IF n <= 1 .OR. ValType( nDir ) != "N" .OR. nDir == 0
      RETURN 0
   ENDIF
   IF ValType( nIdx ) != "N" .OR. nIdx < 1 .OR. nIdx > n
      RETURN 1                       /* no cursor: start at the first one */
   ENDIF
   IF nDir > 0
      RETURN iif( nIdx >= n, 1, nIdx + 1 )
   ENDIF
RETURN iif( nIdx <= 1, n, nIdx - 1 )

/* S4/L6: the room the NUMBER of a tab took is GONE -the label carries no
 * number any more- and with it HcTabNumW(), which existed only to measure it. */

/* S4: the name of a tab, cut with `...` when it does not fit in nW cells. A name
 * that fits comes back untouched; one too wide for even the dots is cut plain,
 * so the answer NEVER passes nW - PadR() does not truncate, so the cut has to
 * happen here (AGENTS, the UiInput() note). */
FUNCTION HcTabCut( cName, nW )
   IF ValType( cName ) != "C"
      RETURN ""
   ENDIF
   IF ValType( nW ) != "N" .OR. nW <= 0
      RETURN ""
   ENDIF
   nW := Int( nW )
   IF Len( cName ) <= nW
      RETURN cName
   ENDIF
   IF nW <= 3
      RETURN Left( cName, nW )
   ENDIF
RETURN Left( cName, nW - 3 ) + "..."

/* S4: the display name of a tab: the file name WITH its extension, so a folder
 * holding two files that only differ in the extension does not paint two
 * identical tabs. */
FUNCTION HcTabName( aTab )
   IF ! HB_ISARRAY( aTab ) .OR. Len( aTab ) < HC_TB_PATH .OR. ;
      ValType( aTab[ HC_TB_PATH ] ) != "C"
      RETURN ""
   ENDIF
RETURN hb_FNameNameExt( aTab[ HC_TB_PATH ] )

/* S13/L10: how many cells the LABEL of a tab takes, and the ONLY thing a tab
 * spends because the tabs are JOINED (L12: no separator cell of any kind):
 *      "[" " " <name slot> " " <X> " " "]"   =   nNameW + 6
 * There is NO tab number (L6) and nothing else is added here, so the painter
 * can never write past what the geometry gave it. */
FUNCTION HcTabLabelW( nNameW )
   IF ValType( nNameW ) != "N" .OR. nNameW < 0
      nNameW := 0
   ENDIF
RETURN Int( nNameW ) + 6

/* S13/L10: what a tab paints, in EXACTLY HcTabLabelW() cells:
 *      "[" " " <name cut to nNameW> " " <X> " " "]"
 * The name is cut with `...` when it does not fit and the close mark owns a cell
 * of its own - two cells before it and one after it -, so a click on the name or
 * on a bracket can never be taken for a click on the mark (S5/S6). The brackets
 * and the mark are plain ASCII: Chr() can drop a byte >= 128 (trap 47). */
FUNCTION HcTabLabel( cPath, nNameW )
   LOCAL cName
   IF ValType( nNameW ) != "N" .OR. nNameW < 0
      nNameW := 0
   ENDIF
   cName := HcTabCut( hb_FNameNameExt( iif( ValType( cPath ) == "C", cPath, "" ) ), nNameW )
RETURN "[" + " " + PadR( cName, Int( nNameW ) ) + " " + HC_TAB_X + " " + "]"

/* S3/S4: the widest NAME slot a bar of nW cells gives a tab: a quarter of the
 * bar, so several tabs always fit and a single long name cannot swallow the row.
 * Below HC_TAB_NAME_MIN a tab says nothing, so the minimum wins and a bar that is
 * really too narrow cuts the tab itself (HcTabCells()). Derived from the canvas,
 * never from a literal of 120. */
FUNCTION HcTabNameMax( nW )
   IF ValType( nW ) != "N" .OR. nW <= 0
      RETURN 0
   ENDIF
RETURN Max( HC_TAB_NAME_MIN, Int( Int( nW ) / 4 ) )

/* S3: the run of tabs a bar of nBudget cells can show around the ACTIVE one, as
 * { nFrom, nTo }. It grows OUT from the active tab - the right side first - so
 * the active tab is always in the window and the tabs nearest to it are the ones
 * that stay. Neither end is ever crossed. */
FUNCTION HcTabWindow( aW, nSel, nBudget )
   LOCAL n, nFrom, nTo, nUsed, lGrew
   IF ! HB_ISARRAY( aW )
      RETURN { 0, 0 }
   ENDIF
   n := Len( aW )
   IF n == 0
      RETURN { 0, 0 }
   ENDIF
   IF ValType( nSel ) != "N" .OR. nSel < 1 .OR. nSel > n
      nSel := 1
   ENDIF
   IF ValType( nBudget ) != "N"
      nBudget := 0
   ENDIF
   nFrom := nSel
   nTo   := nSel
   nUsed := aW[ nSel ]
   DO WHILE .T.
      lGrew := .F.
      IF nTo < n .AND. nUsed + aW[ nTo + 1 ] <= nBudget
         nTo++
         nUsed += aW[ nTo ]
         lGrew := .T.
      ENDIF
      IF nFrom > 1 .AND. nUsed + aW[ nFrom - 1 ] <= nBudget
         nFrom--
         nUsed += aW[ nFrom ]
         lGrew := .T.
      ENDIF
      IF ! lGrew
         EXIT
      ENDIF
   ENDDO
RETURN { nFrom, nTo }

/* S3/S4: the geometry of the bar for a bar of nW cells:
 *      { aCells, nCol0, lCutL, lCutR }
 * `aCells` is one HC_TC_* row per VISIBLE tab, in bar order; nCol0 is the cell
 * where the first one starts (1 when the left mark is painted there) and the two
 * flags say the bar is hiding tabs on that side, which is what the marks of
 * HC_TAB_CUTL/HC_TAB_CUTR announce. One cell per hidden side is RESERVED, so a
 * mark never paints over a tab.
 * A tab that does not fit in what is left is CUT, never dropped, so the active
 * one is always on screen, even in a bar narrower than its own label. */
FUNCTION HcTabCells( aTabs, nSel, nW )
   LOCAL aCells := {}, aW := {}, nTab, nNameMax, aWin, nFrom, nTo
   LOCAL lCutL, lCutR, nCol0, nUsable, nCol, nLen, nNameW, nXCol, i

   nTab := iif( HB_ISARRAY( aTabs ), Len( aTabs ), 0 )
   IF ValType( nW ) != "N" .OR. nW <= 0 .OR. nTab == 0
      RETURN { aCells, 0, .F., .F. }
   ENDIF
   nW := Int( nW )
   IF ValType( nSel ) != "N" .OR. nSel < 1 .OR. nSel > nTab
      nSel := 1
   ENDIF
   /* the natural width of every tab, with the name slot capped by the canvas.
    * It is the label and nothing else: two tabs are painted back to back, so the
    * closing bracket of one touches the opening bracket of the next (L12) */
   nNameMax := HcTabNameMax( nW )
   FOR i := 1 TO nTab
      AAdd( aW, HcTabLabelW( Min( Len( HcTabName( aTabs[ i ] ) ), nNameMax ) ) )
   NEXT
   /* pass 1: nothing reserved for the marks */
   aWin  := HcTabWindow( aW, nSel, nW )
   lCutL := aWin[ 1 ] > 1
   lCutR := aWin[ 2 ] < nTab
   IF ! lCutL .AND. ! lCutR
      nFrom   := aWin[ 1 ]
      nTo     := aWin[ 2 ]
      nCol0   := 0
      nUsable := nW
   ELSE
      nCol0   := iif( lCutL, 1, 0 )
      nUsable := nW - iif( lCutL, 1, 0 ) - iif( lCutR, 1, 0 )
      aWin    := HcTabWindow( aW, nSel, nUsable )
      nFrom   := aWin[ 1 ]
      nTo     := aWin[ 2 ]
      /* reserving the marks can only hide MORE tabs, never fewer */
      lCutL   := nFrom > 1
      lCutR   := nTo < nTab
   ENDIF
   nCol := nCol0
   FOR i := nFrom TO nTo
      /* the label has to fit, or the tab is not painted: `[ X ]` is the
       * smallest label there is (S13/L10) */
      IF nCol + HcTabLabelW( 0 ) > nW
         EXIT
      ENDIF
      nNameW := Min( Len( HcTabName( aTabs[ i ] ) ), nNameMax )
      nLen   := HcTabLabelW( nNameW )
      IF nCol + nLen > nW
         /* what is left of the bar: the name slot is the only slack the label
          * has */
         nNameW := nW - nCol - 6
         IF nNameW < 0
            nNameW := 0
         ENDIF
         nLen := HcTabLabelW( nNameW )
      ENDIF
      IF nLen <= 0
         EXIT
      ENDIF
      /* S13/L10: the label is `[ <name>  X ]` - bracket, space, the name, a
       * space, the mark on its own cell, a space and the closing bracket -, so
       * the name starts TWO cells into the tab and the mark sits nNameW + 3
       * cells in. The label is ALL a tab spends (L12): the cell right after it
       * is the opening bracket of the next tab, never a pad of nobody */
      nXCol := nCol + nNameW + 3
      IF nXCol >= nCol + nLen
         nXCol := 0                    /* the mark did not fit: not painted */
      ENDIF
      AAdd( aCells, { i, nCol, nLen, nCol + 2, nNameW, nXCol } )
      nCol += nLen
   NEXT
RETURN { aCells, nCol0, lCutL, lCutR }

/* S5: the tab under a cell of the bar, 0 when that cell is not a tab (a cut
 * mark, the empty rest of the row). The tabs are JOINED (L12), so the cell right
 * after a tab is the opening bracket of the NEXT one and answers that tab.
 * PURE: it only walks the geometry. */
FUNCTION HcTabHit( aCells, nCol )
   LOCAL i, a
   IF ! HB_ISARRAY( aCells ) .OR. ValType( nCol ) != "N"
      RETURN 0
   ENDIF
   nCol := Int( nCol )
   FOR i := 1 TO Len( aCells )
      a := aCells[ i ]
      IF HB_ISARRAY( a ) .AND. Len( a ) >= HC_TC_XCOL .AND. ;
         nCol >= a[ HC_TC_COL ] .AND. nCol < a[ HC_TC_COL ] + a[ HC_TC_LEN ]
         RETURN a[ HC_TC_IDX ]
      ENDIF
   NEXT
RETURN 0

/* S6: the tab whose CLOSE MARK is under that cell, 0 when the cell is not one.
 * The mark is ONE cell - the one HcTabLabel() paints it on -, so a click on the
 * name, on a bracket or on the bracket of the next tab never closes it (S5/S6). */
FUNCTION HcTabXHit( aCells, nCol )
   LOCAL i, a
   IF ! HB_ISARRAY( aCells ) .OR. ValType( nCol ) != "N"
      RETURN 0
   ENDIF
   nCol := Int( nCol )
   FOR i := 1 TO Len( aCells )
      a := aCells[ i ]
      IF HB_ISARRAY( a ) .AND. Len( a ) >= HC_TC_XCOL .AND. ;
         a[ HC_TC_XCOL ] > 0 .AND. a[ HC_TC_XCOL ] == nCol
         RETURN a[ HC_TC_IDX ]
      ENDIF
   NEXT
RETURN 0

/* S13/L10: the tab whose close mark the POINTER is over, 0 when the pointer is
 * somewhere else on the screen or on a cell that is not a mark. PURE, so the
 * bank pins it: it is the same geometry the painter and the click use (no second
 * copy of the bar), and the row of the bar is the one constant the bar has. */
FUNCTION HcTabHover( aTabs, nSel, nW, nRow, nCol )
   LOCAL aLay
   IF ValType( nRow ) != "N" .OR. nRow != HE_TITLE
      RETURN 0
   ENDIF
   aLay := HcTabCells( aTabs, nSel, nW )
RETURN HcTabXHit( aLay[ HC_TL_CELLS ], nCol )

/* S13/L10: the colour of the close mark, one of the SIX pairs the bar has.
 * Decided by the `modified` of THAT tab, by whether it is the ACTIVE one and by
 * whether the pointer is over the mark:
 *   - the buffer of that tab was modified and not saved (S8/L2): the DIR pair,
 *     which WINS over the hover - the red is the state of the file and the
 *     hover is only a hint, so it is seen on the CLEAN tabs;
 *   - the pointer is over the mark: the HOV pair of that tab;
 *   - otherwise: the pair of the tab at rest.
 * Every pair is a LETTER over the background the tab ALREADY has, so the mark
 * never carries a background of its own and there is no band in the bar (L7). */
FUNCTION HcTabXColor( lMod, lActive, lHover )
   LOCAL lM := ValType( lMod ) == "L" .AND. lMod
   LOCAL lA := ValType( lActive ) == "L" .AND. lActive
   LOCAL lH := ValType( lHover ) == "L" .AND. lHover

   IF lM
      RETURN iif( lA, UI_C_TABXDIRA, UI_C_TABXDIRO )
   ENDIF
   IF lH
      RETURN iif( lA, UI_C_TABXHOVA, UI_C_TABXHOVO )
   ENDIF
RETURN iif( lA, UI_C_TABXACT, UI_C_TABXOFF )

/* S2/S8: write the state of the screen into a tab of the session. `aTab` is the
 * RECORD (HcTabAt() answers it), never a copy: the buffer is stored as the same
 * reference, which is what makes a tab switch free. A NIL record does nothing,
 * so the viewer - which has no tabs - can call it with NIL. */
FUNCTION HcTabStore( aTab, aLines, nTop, nRow, nCol, nLft, lMod, lOvr, cCdp, ;
                     cView, nTabW, aSel, aHist, aRedo, aUndo, aHit, cNote, ;
                     cLastFind )
   IF ! HB_ISARRAY( aTab ) .OR. Len( aTab ) < HC_TB_FIND
      RETURN .F.
   ENDIF
   aTab[ HC_TB_LINES ] := aLines
   aTab[ HC_TB_TOP   ] := nTop
   aTab[ HC_TB_ROW   ] := nRow
   aTab[ HC_TB_COL   ] := nCol
   aTab[ HC_TB_LFT   ] := nLft
   aTab[ HC_TB_MOD   ] := ValType( lMod ) == "L" .AND. lMod
   aTab[ HC_TB_OVR   ] := ValType( lOvr ) == "L" .AND. lOvr
   aTab[ HC_TB_CDP   ] := cCdp
   aTab[ HC_TB_VIEW  ] := cView
   aTab[ HC_TB_TABW  ] := nTabW
   aTab[ HC_TB_SEL   ] := aSel
   aTab[ HC_TB_HIST  ] := aHist
   aTab[ HC_TB_REDO  ] := aRedo
   aTab[ HC_TB_UNDO  ] := aUndo
   aTab[ HC_TB_HIT   ] := aHit
   aTab[ HC_TB_NOTE  ] := cNote
   aTab[ HC_TB_FIND  ] := cLastFind
RETURN .T.

/* S8: .T. only when the two buffers are the SAME TEXT - both arrays, of the
 * same length, with equal lines. Two non-arrays are equal (nothing differs) and
 * an array against NIL is not. It is the rule that turns "an edit happened"
 * into "the buffer differs from the last save" (L14), and it compares with `==`
 * on purpose: with SET EXACT OFF `=` pads, so `"AB" = "A"` would be true and a
 * shortened line would read as unchanged (AGENTS trap 20). PURE, so the bank
 * pins it without a window. */
FUNCTION HcSameText( aLines, aOther )
   LOCAL i
   IF ! HB_ISARRAY( aLines ) .AND. ! HB_ISARRAY( aOther )
      RETURN .T.
   ENDIF
   IF ! HB_ISARRAY( aLines ) .OR. ! HB_ISARRAY( aOther )
      RETURN .F.
   ENDIF
   IF Len( aLines ) != Len( aOther )
      RETURN .F.
   ENDIF
   FOR i := 1 TO Len( aLines )
      IF ! ( aLines[ i ] == aOther[ i ] )
         RETURN .F.
      ENDIF
   NEXT
RETURN .T.

/* S8: the saved-text baseline of a tab ("the file as the disk has it"). A NIL
 * record or one without a usable slot answers an EMPTY array, which is what
 * HcTabNew() puts there and never equals a real buffer: the caller then reads
 * "modified", which is the honest answer when there is no baseline. */
FUNCTION HcTabSaved( aTab )
   IF ! HB_ISARRAY( aTab ) .OR. Len( aTab ) < HC_TB_SAV
      RETURN {}
   ENDIF
RETURN iif( HB_ISARRAY( aTab[ HC_TB_SAV ] ), aTab[ HC_TB_SAV ], {} )

/* S8: the ONE moment the baseline of a tab moves - the text was just read from
 * the disk or just written to it. The snapshot is a REAL COPY (HcCopyLines()),
 * because Harbour arrays are references (trap 67) and storing the buffer itself
 * would make every later edit "already saved". A NIL record (the viewer) does
 * nothing. */
FUNCTION HcTabSnap( aTab, aLines )
   IF ! HB_ISARRAY( aTab ) .OR. Len( aTab ) < HC_TB_SAV
      RETURN .F.
   ENDIF
   aTab[ HC_TB_SAV ] := HcCopyLines( aLines )
RETURN .T.

/* S7/S10: .T. while the record still OWNS a buffer. A tab whose unsaved changes
 * were saved or discarded drops it (HcTabAsk()), and from then on the text is
 * read from the disk, so what the screen shows is what the file has. */
FUNCTION HcTabHasBuf( aTab )
   IF ! HB_ISARRAY( aTab ) .OR. Len( aTab ) < HC_TB_FIND
      RETURN .F.
   ENDIF
RETURN HB_ISARRAY( aTab[ HC_TB_LINES ] )

/* S7/S10: the DISK half of the same rule. A record that does not own a buffer
 * (its changes were saved or discarded, or it is a brand new record) gets the
 * text of its file HERE, before anything reads its slots: switching to it with
 * the buffer of the tab being left still live would paint one file's text under
 * another file's path and F2 would write it to the wrong name (measured). The
 * caret is clamped to the new text and the horizontal window goes home, because
 * those columns belonged to what is no longer there. */
STATIC FUNCTION HcTabPreload( aTab )
   LOCAL aRes
   IF HcTabHasBuf( aTab )
      RETURN .T.
   ENDIF
   IF ! HB_ISARRAY( aTab ) .OR. Len( aTab ) < HC_TB_FIND
      RETURN .F.
   ENDIF
   aRes := HcReadText( aTab[ HC_TB_PATH ] )
   IF ! aRes[ 1 ]
      RETURN .F.
   ENDIF
   aTab[ HC_TB_LINES ] := iif( Empty( aRes[ 2 ] ), { "" }, aRes[ 2 ] )
   /* S8: the text just read IS the last saved one, so the baseline moves here
    * too - a tab whose buffer was dropped and is read again comes back clean
    * and an undo of its first edits can bring it back to clean. */
   HcTabSnap( aTab, aTab[ HC_TB_LINES ] )
   aTab[ HC_TB_TOP ] := Max( 1, Min( iif( ValType( aTab[ HC_TB_TOP ] ) == "N", ;
                                        aTab[ HC_TB_TOP ], 1 ), ;
                                  Len( aTab[ HC_TB_LINES ] ) ) )
   aTab[ HC_TB_ROW ] := Max( 0, Min( iif( ValType( aTab[ HC_TB_ROW ] ) == "N", ;
                                        aTab[ HC_TB_ROW ], 0 ), ;
                                  Len( aTab[ HC_TB_LINES ] ) - aTab[ HC_TB_TOP ] ) )
   aTab[ HC_TB_COL ] := 0
   aTab[ HC_TB_LFT ] := 0
RETURN .T.

/* S2: the other way round - the record puts the screen back where it was. Every
 * output comes by reference, exactly like HcFindBulk(). A record that is not one
 * changes NOTHING, so a stale index cannot wipe the editor. */
FUNCTION HcTabRead( aTab, aLines, nTop, nRow, nCol, nLft, lMod, lOvr, cCdp, ;
                    cView, nTabW, aSel, aHist, aRedo, aUndo, aHit, cNote, ;
                    cLastFind )
   IF ! HB_ISARRAY( aTab ) .OR. Len( aTab ) < HC_TB_FIND
      RETURN .F.
   ENDIF
   IF HB_ISARRAY( aTab[ HC_TB_LINES ] )
      aLines := aTab[ HC_TB_LINES ]
   ENDIF
   nTop  := Max( 1, iif( ValType( aTab[ HC_TB_TOP ] ) == "N", aTab[ HC_TB_TOP ], 1 ) )
   nRow  := Max( 0, iif( ValType( aTab[ HC_TB_ROW ] ) == "N", aTab[ HC_TB_ROW ], 0 ) )
   nCol  := Max( 0, iif( ValType( aTab[ HC_TB_COL ] ) == "N", aTab[ HC_TB_COL ], 0 ) )
   nLft  := Max( 0, iif( ValType( aTab[ HC_TB_LFT ] ) == "N", aTab[ HC_TB_LFT ], 0 ) )
   lMod  := ValType( aTab[ HC_TB_MOD ] ) == "L" .AND. aTab[ HC_TB_MOD ]
   lOvr  := ValType( aTab[ HC_TB_OVR ] ) == "L" .AND. aTab[ HC_TB_OVR ]
   cCdp  := iif( ValType( aTab[ HC_TB_CDP ] ) == "C", aTab[ HC_TB_CDP ], "" )
   cView := iif( ValType( aTab[ HC_TB_VIEW ] ) == "C", aTab[ HC_TB_VIEW ], "" )
   nTabW := iif( ValType( aTab[ HC_TB_TABW ] ) == "N", aTab[ HC_TB_TABW ], 4 )
   aSel  := aTab[ HC_TB_SEL ]
   aHist := iif( HB_ISARRAY( aTab[ HC_TB_HIST ] ), aTab[ HC_TB_HIST ], {} )
   aRedo := iif( HB_ISARRAY( aTab[ HC_TB_REDO ] ), aTab[ HC_TB_REDO ], {} )
   aUndo := aTab[ HC_TB_UNDO ]
   aHit  := iif( HB_ISARRAY( aTab[ HC_TB_HIT ] ), aTab[ HC_TB_HIT ], { 0, 0, 0 } )
   cNote := iif( ValType( aTab[ HC_TB_NOTE ] ) == "C", aTab[ HC_TB_NOTE ], "" )
   cLastFind := iif( ValType( aTab[ HC_TB_FIND ] ) == "C", aTab[ HC_TB_FIND ], "" )
RETURN .T.

/* S7/S10: the ONE question a tab with unsaved changes gets - the same
 * HcAskSave() Esc always asked (S7: "pregunta igual que salir"). .T. when the
 * tab can be closed or left (it was saved, or the user discarded the changes),
 * .F. when the write failed and the work is still there. */
STATIC FUNCTION HcTabAsk( aTab )
   IF ! HB_ISARRAY( aTab ) .OR. Len( aTab ) < HC_TB_FIND
      RETURN .T.
   ENDIF
   IF ! ( ValType( aTab[ HC_TB_MOD ] ) == "L" .AND. aTab[ HC_TB_MOD ] )
      RETURN .T.
   ENDIF
   IF ! HcAskSave( aTab[ HC_TB_PATH ], aTab[ HC_TB_LINES ] )
      RETURN .F.
   ENDIF
   /* S7/S10: saved or discarded, the record does NOT keep the buffer: the two
    * outcomes were decided by the user and the disk is now the truth (the saved
    * text is there, the discarded one must not come back). Keeping it would let
    * a tab show discarded text with the mark of a clean one. */
   aTab[ HC_TB_MOD   ] := .F.
   aTab[ HC_TB_LINES ] := NIL
   /* S8: with no buffer there is no baseline either - HcTabPreload() sets the
    * new one when the text is read again */
   aTab[ HC_TB_SAV   ] := {}
RETURN .T.

/* S10: the order in which the tabs of a session are asked when the screen is
 * LEFT: the ACTIVE one first and then in the order of the bar. PURE, so the
 * headless bank pins the rule the static HcTabsAsk() only walks. */
FUNCTION HcTabAskOrder( aTabs, nSel )
   LOCAL a := {}, i, n
   n := iif( HB_ISARRAY( aTabs ), Len( aTabs ), 0 )
   IF ValType( nSel ) == "N" .AND. nSel >= 1 .AND. nSel <= n
      AAdd( a, nSel )
   ENDIF
   FOR i := 1 TO n
      IF i != nSel
         AAdd( a, i )
      ENDIF
   NEXT
RETURN a

/* S10: leaving the editor asks ONCE PER TAB with unsaved changes - the ACTIVE
 * one first and then in the order of the bar -, so no buffer is lost in silence.
 * .F. as soon as one save fails: the editor stays open with the work in it. */
STATIC FUNCTION HcTabsAsk( aTabs, nSel )
   LOCAL aOrd, i
   IF ! HB_ISARRAY( aTabs ) .OR. Len( aTabs ) == 0
      RETURN .T.
   ENDIF
   aOrd := HcTabAskOrder( aTabs, nSel )
   FOR i := 1 TO Len( aOrd )
      IF ! HcTabAsk( aTabs[ aOrd[ i ] ] )
         RETURN .F.
      ENDIF
   NEXT
RETURN .T.

/* S13/L10: the tab bar of the editor, on the row the viewer uses for its title
 * chip. It paints INSIDE the one paint block of HcFileDraw() - it opens none - and
 * REGISTERS every tab and every close mark in the shared control table while it
 * paints, so a click produces the same action as the keyboard and there is no
 * second copy of the geometry (§6 of AGENTS).
 * `nHov` is the tab whose close mark the POINTER is over (0 = none), read once
 * per pass by the loop: it only changes the pair of that mark. */
STATIC PROCEDURE HcTabBar( aTabs, nSel, lMod, nW, nHov )
   LOCAL aLay, aCells, lCutL, lCutR, aTab, a, cLbl, cIdx, lAct, i
   IF ! HB_ISARRAY( aTabs ) .OR. Len( aTabs ) == 0
      RETURN
   ENDIF
   IF ValType( nW ) != "N" .OR. nW <= 0
      RETURN
   ENDIF
   /* S8: the bar paints the `modified` of EVERY tab from its own record, so the
    * one of the ACTIVE tab - the only one that can have changed since the record
    * was written, because the others are stored when they are left - is written
    * here, by the painter that paints it. */
   IF ValType( nSel ) == "N" .AND. nSel >= 1 .AND. nSel <= Len( aTabs ) .AND. ;
      HB_ISARRAY( aTabs[ nSel ] )
      aTabs[ nSel ][ HC_TB_MOD ] := ValType( lMod ) == "L" .AND. lMod
   ENDIF
   aLay   := HcTabCells( aTabs, nSel, nW )
   aCells := aLay[ HC_TL_CELLS ]
   lCutL  := aLay[ HC_TL_CUTL ]
   lCutR  := aLay[ HC_TL_CUTR ]
   HcSyncCtlReset()                   /* the controls of THIS paint */
   /* S13/L10: the rest of the row is the BLACK body of the screen (`N/N`), so an
    * inactive tab reads by its brackets and not by a band of its own */
   SetColor( UI_C_TABBAR )
   @ HE_TITLE, 0 SAY Space( nW )
   IF lCutL
      SetColor( UI_C_DIM )
      @ HE_TITLE, 0 SAY HC_TAB_CUTL
   ENDIF
   IF lCutR
      SetColor( UI_C_DIM )
      @ HE_TITLE, nW - 1 SAY HC_TAB_CUTR
   ENDIF
   FOR i := 1 TO Len( aCells )
      a    := aCells[ i ]
      aTab := aTabs[ a[ HC_TC_IDX ] ]
      lAct := ValType( nSel ) == "N" .AND. a[ HC_TC_IDX ] == nSel
      cIdx := LTrim( Str( a[ HC_TC_IDX ] ) )
      cLbl := HcTabLabel( aTab[ HC_TB_PATH ], a[ HC_TC_NLEN ] )
      SetColor( iif( lAct, UI_C_TABLBLON, UI_C_TABLBLOFF ) )
      @ HE_TITLE, a[ HC_TC_COL ] SAY cLbl
      /* L17: the two brackets of the ACTIVE tab are a slot of their own. In
       * `Classic` it is the same pair as the label, so nothing changes there;
       * in `Dark` it is the amber accent, because the band of the active tab
       * (`B` = 40,40,46) and the one of the others (`N` = 18,18,22) are almost
       * the same grey and the bright name alone did not tell them apart. */
      IF lAct
         SetColor( UI_C_TABBRKON )
         @ HE_TITLE, a[ HC_TC_COL ] SAY Left( cLbl, 1 )
         @ HE_TITLE, a[ HC_TC_COL ] + a[ HC_TC_LEN ] - 1 SAY Right( cLbl, 1 )
      ENDIF
      /* S8/S13: the close mark says whether THAT tab was saved and whether the
       * pointer is over it. The pair is a LETTER over the background the tab
       * already has (HcTabXColor()), so the bar never shows a band of its own */
      IF a[ HC_TC_XCOL ] > 0
         SetColor( HcTabXColor( aTab[ HC_TB_MOD ], lAct, a[ HC_TC_IDX ] == nHov ) )
         @ HE_TITLE, a[ HC_TC_XCOL ] SAY HC_TAB_X
      ENDIF
      /* S5/S6: the mark is registered FIRST, because HcSyncCtlAt() answers the
       * first control whose span holds the cell and the span of the tab covers
       * the mark's cell too */
      IF a[ HC_TC_XCOL ] > 0
         HcSyncCtlAdd( HE_TITLE, a[ HC_TC_XCOL ], 1, "HTABX", cIdx )
      ENDIF
      HcSyncCtlAdd( HE_TITLE, a[ HC_TC_COL ], a[ HC_TC_LEN ], "HTAB", cIdx )
   NEXT
   SetColor( UI_C_DARK )
RETURN

/* S12/L8: the FIRST ROW OF TEXT of the viewer/editor. The editor paints a rule
 * in HE_TOP (just under the bar of tabs) and the text begins one row lower, so
 * the two screens do not share that row any more. The viewer has no rule and
 * keeps HE_TOP as its first text row, byte for byte. ONE function, so the
 * painter, the number of visible lines, the caret, the mouse and the scrolling of
 * the Find dialog can never disagree about where the text starts. */
FUNCTION HcTextTop( lEdit )
RETURN HE_TOP + iif( ValType( lEdit ) == "L" .AND. lEdit, 1, 0 )

/* S12: how many rows of text the screen has. The editor loses the row the rule
 * takes and the viewer keeps all of them. Derived from the canvas (HE_BOTTOM
 * comes from UiRows()), never from a literal. */
FUNCTION HcTextRows( lEdit )
RETURN HE_BOTTOM - HcTextTop( lEdit ) + 1

/* full screen buffer: title, text, status and hints, in ONE paint block.
 * lOvr is the OVERWRITE mode (the editor starts in INSERT, as it always did).
 * S7: aSel is the selection of the editor ({ line1, col1, line2, col2 }); the
 * read-only viewer passes NIL and paints exactly what it always painted.
 * cView and cCdpF (S1/S4 of hc-codepage.md, NEW LAST parameters so the order
 * of the rest does not change) are the two code pages of L5: cView is the one
 * the screen is PAINTED with (F6 moves it and nothing else) and cCdpF is the
 * one of the FILE (the bytes of the buffer; only F9 in the editor moves it).
 * The buffer columns of aSel, aHit, nCol and nLft are BYTES of cCdpF, but what
 * this painter needs is the CELL of each one, and the cells are those of the
 * DISPLAY line, so every mapping goes through cView (which is the same id as
 * cCdpF until F6 changes the view). One byte per cell, which is what the
 * driver decodes. With the file in the code page of the screen (an ASCII
 * file) both helpers are the identity and this paints exactly what it painted
 * before.
 * cPKind and lPretty (S1/S2 of hc-pretty-print.md, NEW LAST parameters) are the
 * kind of the file ("json"/"xml", "" when it cannot be pretty printed) and
 * whether the VIEWER is showing the formatted text: the first paints the chip of
 * the Alt-P key and the second the `[pretty]` mark of the status row, so a
 * screen that is not showing the file as it is never looks like one that is.
 * aTabs and nSel (S4 of hc-editor-tabs.md, NEW LAST parameters again) are the
 * session tabs of the editor and which one is active: they turn row HE_TITLE into
 * the bar of tabs, put the full path of the active one on the status row and
 * leave the rest of the painter alone. The VIEWER passes NIL and paints exactly
 * what it always painted, byte for byte.
 * nHov (S13/L10, NEW LAST parameter too) is the tab whose close mark the pointer
 * is over (0 = none): the bar paints that mark with the hover pair and nothing
 * else changes. The viewer ignores it, like the tabs it does not have. */
STATIC PROCEDURE HcFileDraw( aLines, cTitle, nTop, nRow, nCol, nLft, lEdit, lMod, lOvr, aHit, cNote, cLang, nTabW, aSel, cView, cCdpF, cPKind, lPretty, aTabs, nSel, nHov )
   LOCAL nW := MaxCol() + 1, nTextTop := HcTextTop( lEdit )
   LOCAL nVis := HE_BOTTOM - nTextTop + 1
   LOCAL i, nLine, c, cSt, nC, cRow, nFrom, nSpan, cCell
   LOCAL cRaw, cShow, nCellLft, nCell, cCur
   LOCAL aS := HcSelNorm( aLines, aSel ), aSp, nSFrom, nSTo, nRest
   UiPaintBegin()
   /* S4 of hc-editor-tabs.md: the editor paints the BAR of tabs on the row the
    * viewer uses for its title chip. The viewer (lEdit = .F.) has no tabs and
    * keeps the chip it always had. */
   IF lEdit .AND. HB_ISARRAY( aTabs ) .AND. Len( aTabs ) > 0
      HcTabBar( aTabs, nSel, lMod, nW, nHov )
   ELSE
      SetColor( UI_C_CHIP )
      @ HE_TITLE, 0 SAY PadR( Left( cTitle, nW ), nW )
   ENDIF
   /* S12/L8: in the EDITOR the row under the bar is a full-width rule in the dim
    * pair, so the bar and the text are not the same block of colour. The viewer
    * has no rule: its text starts on HE_TOP as it always did. */
   IF lEdit
      SetColor( UI_C_DIM )
      @ HE_TOP, 0 SAY Replicate( BP_LINE_SINGLE, nW )
   ENDIF
   /* the line of the caret, read once: the cursor block and the status row
    * both map its BYTES to cells (never NIL: HcCdpCell() takes a string) */
   cCur := iif( nTop + nRow >= 1 .AND. nTop + nRow <= Len( aLines ) .AND. ;
                ValType( aLines[ nTop + nRow ] ) == "C", aLines[ nTop + nRow ], "" )
   FOR i := 0 TO nVis - 1
      nLine := nTop + i
      IF nLine >= 1 .AND. nLine <= Len( aLines ) .AND. ValType( aLines[ nLine ] ) == "C"
         cRaw := aLines[ nLine ]
      ELSE
         cRaw := ""
      ENDIF
      /* S4: the painted line is ONE BYTE PER CELL and the horizontal window is
       * opened in cells, so a UTF-8 accent (two bytes of the buffer) takes ONE
       * cell of the screen and nothing after it moves */
      cShow    := HcCdpShow( cRaw, cView )
      nCellLft := HcCdpCell( cRaw, nLft, cView )
      c := SubStr( cShow, nCellLft + 1, nW )
      IF Empty( cLang )
         /* a plain text file keeps the colours it always had. The line of the
          * caret is shaded ONLY in the read-only VIEW: in the editor it is not
          * (pedido del usuario) because the cursor block of INS and the system
          * caret of OVR already say where the typing goes, and a yellow band
          * over the line being edited distracts from the text itself */
         cRow := iif( i == nRow .AND. ! lEdit, UI_C_LISTSEL, UI_C_DARK )
         SetColor( cRow )
         @ nTextTop + i, 0 SAY PadR( c, nW )
      ELSE
         /* S79: a code file goes segment by segment, and the line of the caret
          * does NOT get a stripe of its own: in the dark scheme "you are here"
          * is the cursor block (INS) or the system caret (OVR). The tokenizer
          * works on the DISPLAY line (one byte per cell) and the window start
          * is the CELL column, so both sides speak the same units. */
         HcCodeRow( cShow, nTextTop + i, nCellLft, nW, cLang )
         cRow := UI_C_DARK
      ENDIF
      /* S7: the selected span of this line, painted with the two colours of
       * the row SWAPPED - the same language the search mark speaks, so no new
       * UI_C_* and no new RGB (§4). It goes ON TOP of the code highlighting of
       * S79 (which was just painted) and BEFORE the mark of the search, so a
       * hit is never hidden by a selection. HC_SEL_EOL is the exclusive end of
       * a span that runs to the end of its line: this painter owns the text, so
       * here it becomes Len(). */
      IF HB_ISARRAY( aS )
         aSp := HcSelSpan( aS, nLine )
         IF HB_ISARRAY( aSp )
            /* the span comes in BYTES of the buffer: its two ends are where the
             * character that starts there sits on the screen, and HC_SEL_EOL
             * (which no text can measure) becomes the full cell count of the
             * line, which is exactly HcCdpCell( Len( line ) ) */
            nSFrom := Max( 0, HcCdpCell( cRaw, aSp[ 1 ], cView ) - nCellLft )
            nSTo   := Min( nW, HcCdpCell( cRaw, iif( aSp[ 2 ] == HC_SEL_EOL, ;
                                                 Len( cRaw ), aSp[ 2 ] ), cView ) - nCellLft )
            IF nSTo > nSFrom
               SetColor( UiSwapColor( cRow ) )
               /* padded, so the span is seen past the end of the text (a
                * selection that reaches the end of the line keeps going) */
               @ nTextTop + i, nSFrom SAY ;
                  PadR( SubStr( c, nSFrom + 1, nSTo - nSFrom ), nSTo - nSFrom )
            ENDIF
         ENDIF
      ENDIF
      /* S77: the span of the current search hit is painted with the two colours
       * of the row SWAPPED, so the match stands out from the row of the caret
       * without spending a colour (no new UI_C_*, §4) and it is visible even on
       * the read-only screen, where the system caret is hidden */
      IF HB_ISARRAY( aHit ) .AND. Len( aHit ) >= 3 .AND. aHit[ 1 ] == nLine .AND. aHit[ 3 ] > 0
         /* the hit is a BYTE column and a BYTE length (HcTextFind() searches
          * the buffer as it is): both ends are mapped to cells and the slice
          * comes out of the DISPLAY line, so a hit over a UTF-8 accent marks
          * the one cell the accent occupies */
         nFrom := HcCdpCell( cRaw, aHit[ 2 ], cView ) - nCellLft
         IF nFrom >= 0 .AND. nFrom < nW
            nSpan := HcCdpCell( cRaw, aHit[ 2 ] + aHit[ 3 ], cView ) - ;
                     HcCdpCell( cRaw, aHit[ 2 ], cView )
            nSpan := Min( nSpan, nW - nFrom )
            IF nSpan > 0
               SetColor( UiSwapColor( cRow ) )
               @ nTextTop + i, nFrom SAY SubStr( c, nFrom + 1, nSpan )
            ENDIF
         ENDIF
      ENDIF
   NEXT
   /* S5 of hc-code-highlight.md: in INSERT mode the system caret is hidden and
    * the cell under it is a BLOCK painted with the edit cell of the theme, the
    * same language UiLineEdit() speaks in the dialogs (S5/L12 of
    * hc-editor-tabs.md); in OVERWRITE the platform caret shows where the next
    * character lands and nothing is painted here */
   IF lEdit .AND. ! lOvr
      /* S4: the block is painted on the CELL the caret sits on, and it is that
       * cell of the DISPLAY line, so the caret over a UTF-8 accent is the one
       * cell of the accent and not the first byte of two.
       * S5/L12: the pair is the EDIT CELL of the theme (`N/RB` in both), the same
       * one UiLineEdit() and the Browse edit speak for "this is the cell you are
       * editing": a FILLED block of dark letter on the amber of the theme,
       * for plain text and for code alike. Measured what the old swap did: over
       * `UI_C_LISTSEL` (`N/RB`) it answered `RB/N` = amber letter on the BLACK
       * `N`, and in `Dark` the body is (18,18,22), so the block was invisible and
       * only the amber letter showed - it read like code colouring. */
      nCell := HcCdpCell( cCur, nCol, cView )
      cCell := SubStr( HcCdpShow( cCur, cView ), nCell + 1, 1 )
      IF Empty( cCell )
         cCell := " "
      ENDIF
      SetColor( UI_C_EDIT )
      @ nTextTop + nRow, Max( 0, nCell - HcCdpCell( cCur, nLft, cView ) ) SAY cCell
   ENDIF
   SetColor( UI_C_DARK )
   /* S4: Col() is the SCREEN column (the cell the caret occupies), so the
    * number the user reads is the one under the block/caret, not a byte count */
   cSt := " Row(" + LTrim( Str( nTop + nRow ) ) + ")" + ;
          " Col(" + LTrim( Str( HcCdpCell( cCur, nCol, cView ) + 1 ) ) + ")" + ;
          " Lines(" + LTrim( Str( Len( aLines ) ) ) + ")"
   /* S7: the size of the selection, one character per line break (Sel(n)) */
   IF lEdit .AND. HB_ISARRAY( aS )
      cSt += "  Sel(" + LTrim( Str( HcSelChars( aLines, aS ) ) ) + ")"
   ENDIF
   IF lEdit
      cSt += "  <" + iif( lOvr, "OVR", "INS" ) + ">"
      cSt += "  Tab(" + LTrim( Str( nTabW ) ) + ")"
   ELSE
      cSt += "  [read only]"
   ENDIF
   IF ! Empty( cLang )
      cSt += "  [" + cLang + "]"
   ENDIF
   /* S1: the code page of the FILE is ALWAYS on the status row, next to the
    * language chip, so a wrong detection is seen and fixed with F6 (the view)
    * or with F9 (the file). L5: the view is added to the chip only when it
    * differs from the file - `[UTF8>ES850]` says "this file is UTF-8 and it is
    * being painted as ES850" - so with both equal (which is how a screen opens,
    * and what the viewer keeps showing until F6 moves its view) the chip is the
    * plain `[UTF8]` it always was. */
   IF ! Empty( cCdpF )
      cSt += "  [" + cCdpF
      IF ! Empty( cView ) .AND. ! ( cView == cCdpF )
         cSt += ">" + cView
      ENDIF
      cSt += "]"
   ENDIF
   IF lMod
      cSt += "  [modified]"
   ENDIF
   /* S2 of hc-pretty-print.md: the VIEWER is showing the formatted text, not
    * the file, and that has to be visible (the editor cannot be here: there the
    * buffer really is the formatted text and `[modified]` already says so) */
   IF ValType( lPretty ) == "L" .AND. lPretty
      cSt += "  [pretty]"
   ENDIF
   /* S4 of hc-editor-tabs.md: the bar only shows the NAME of each tab, so the
    * full path of the ACTIVE one is read here, at the end of the status row and
    * before the note. When it does not fit it is cut with HcPathTitle() - head
    * plus tail - so the file name is never the part that disappears. The viewer
    * has no tabs and adds nothing. */
   IF lEdit .AND. HB_ISARRAY( aTabs ) .AND. ValType( nSel ) == "N" .AND. ;
      nSel >= 1 .AND. nSel <= Len( aTabs ) .AND. ;
      HB_ISARRAY( aTabs[ nSel ] ) .AND. ValType( aTabs[ nSel ][ HC_TB_PATH ] ) == "C"
      nRest := nW - Len( cSt ) - 2
      IF nRest >= 8
         cSt += "  " + HcPathTitle( aTabs[ nSel ][ HC_TB_PATH ], nRest )
      ENDIF
   ENDIF
   IF ! Empty( cNote )
      cSt += "  " + cNote
   ENDIF
   SetColor( UI_C_HINT )
   @ HE_STATUS, 0 SAY PadR( Left( cSt, nW ), nW )
   SetColor( UI_C_MENUBAR )
   @ HE_KEYS, 0 SAY Space( nW )
   @ HE_KEYS2, 0 SAY Space( nW )
   /* L5 of hc-codepage.md: only the ACTION keys are advertised. The movement
    * keys (`Up/Down`, `PgUp/PgDn`, `Home/End`, `Ctl+Home/End`, `Shift+arrows`,
    * `Ins`) and the clipboard (`Ctl-C/X/V`) LOSE their chips because they were
    * noise next to the actions: the second hint row is cleared and left EMPTY
    * in both screens, and the first one carries F1/F2/F7/F8/Esc/F6/F9 only. The
    * F9 chip is the TRANSFORM (`CdpTransf`), which exists only in the editor,
    * and F6 is the VIEW (`CdpView`), which exists in both. Chained with
    * HcHintKey(), never at a fixed column, so nothing passes MaxCol()+1. */
   nC := 1
   /* L7 of hc-codepage.md: `F1` opens the help of THIS screen, so it is the
    * first chip of the row (the keys it lists are the same ones the chips
    * advertise, plus the movement and clipboard keys that are not chips) */
   nC := HcHintKey( HE_KEYS, nC, "F1", "=Help" )
   IF lEdit
      nC := HcHintKey( HE_KEYS, nC, "F2", "=Save" )
   ENDIF
   /* S2: in the editor the same key opens the Find / Replace dialog, so its
    * chip says so; the read-only viewer keeps the plain prompt and its label */
   nC := HcHintKey( HE_KEYS, nC, "F7/Ctrl-F", iif( lEdit, "=Find/Repl", "=Find" ) )
   IF lEdit
      nC := HcHintKey( HE_KEYS, nC, "F8", "=Tab width" )
   ENDIF
   nC := HcHintKey( HE_KEYS, nC, "Esc", "=Leave" )
   /* S1 of hc-pretty-print.md: the Alt-P chip exists ONLY for a JSON or XML file
    * (for the rest the key answers a note and is not advertised) */
   IF ! Empty( cPKind )
      nC := HcHintKey( HE_KEYS, nC, "Alt-P", "=Pretty" )
   ENDIF
   nC := HcHintKey( HE_KEYS, nC, "F6", "=CdpView" )
   IF lEdit
      nC := HcHintKey( HE_KEYS, nC, "F9", "=CdpTransf" )
      /* S5/S6 of hc-editor-tabs.md: the switcher and the closer of the tabs.
       * The SECOND hint row was left EMPTY by L5 of hc-codepage.md, so the new
       * keys go there - no existing chip is removed and no third row is added -
       * and only in the editor, which is the only screen that has tabs. L6: the
       * switcher is Ctrl-PgUp / Ctrl-PgDn, not Alt+<number>. */
      nC := HcHintKey( HE_KEYS2, 1, "Ctrl-PgUp/PgDn", "=Tab" )
      nC := HcHintKey( HE_KEYS2, nC, "Alt-W", "=Close tab" )
   ENDIF
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()
RETURN

/* F1 of the Text viewer and the Text editor: the keys of THAT screen, and
 * nothing else. The two screens share the loop of HcFileScreen(), so a key that
 * one of them gates with `IF lEdit` must not be listed by the other - the user
 * reads this list as the truth. Every line here was checked against the DO CASE
 * of that loop (see the comments of each CASE), and each description is kept
 * VERY short on purpose. It answers the array UiTextWin() paints; the viewer
 * says out loud that it never writes.
 * cPKind (S1 of hc-pretty-print.md, optional SECOND parameter) is the kind of
 * the file: the Alt-P line is listed ONLY for a JSON or XML file, because for
 * the rest the key has nothing to do. The signature grew at the END, so a
 * caller that passes only lEdit keeps exactly the list it had. */
FUNCTION HcFileHelp( lEdit, cPKind )
   LOCAL a := { ;
      iif( lEdit, ;
           "The buffer is written only by F2 or Ctrl-S, or by the question of Esc.", ;
           "Read only: the file is never modified." ), ;
      "", ;
      "  F1             this help", ;
      "  F6             CdpView: code page used to paint the file (never writes)", ;
      iif( lEdit, ;
           "  F7 / Ctrl-F    Find / Replace", ;
           "  F7 / Ctrl-F    find text" ), ;
      iif( Empty( cPKind ), ;
           "", ;
           iif( lEdit, ;
                "  Alt-P          pretty print the JSON / XML (one Ctrl-Z undoes it)", ;
                "  Alt-P          pretty print the JSON / XML; Alt-P again shows the file" ) ), ;
      "  Ctrl-G         go to a line", ;
      "  Up / Down      one line up / down", ;
      "  PgUp / PgDn    one page up / down", ;
      "  Home / End     start / end of the line", ;
      "  Ctrl-Home/End  start / end of the file", ;
      "  Left / Right   one column left / right (scrolls a long line)", ;
      "  Ctrl-Left/Right  one word / symbol left / right", ;
      "  Mouse wheel    scroll the text", ;
      "  Esc            leave" }

   IF ! ( ValType( lEdit ) == "L" .AND. lEdit )
      RETURN a
   ENDIF

   /* the editor only: every key below is inside an `IF lEdit` in the loop */
   AAdd( a, "  F2             save the file" )
   AAdd( a, "  Ctrl-S         save the file (the same as F2)" )
   AAdd( a, "  F9             CdpTransf: convert the file to another code page" )
   AAdd( a, "                 (it marks the file modified; F2 writes it)" )
   AAdd( a, "  F8             tab width: the spaces Tab inserts" )
   AAdd( a, "  Ins            INS / OVR" )
   AAdd( a, "  Enter          split the line at the caret" )
   AAdd( a, "  Backspace      delete the character before (or join with the line above)" )
   AAdd( a, "  Del            delete the character at the caret (or join with the line below)" )
   AAdd( a, "  Tab            insert the indent" )
   AAdd( a, "  Ctrl-Z         undo" )
   AAdd( a, "  Ctrl-Shift-Z   redo" )
   AAdd( a, "  Shift+arrows   select" )
   AAdd( a, "  Ctrl-C/X/V     copy / cut / paste" )
   AAdd( a, "  Ctrl-Ins       copy     Shift-Ins  paste" )
   /* S5/L6 of hc-editor-tabs.md: the tab keys of this screen. They are listed
    * here and nowhere else, and (like every line above) only in the editor: the
    * read-only viewer returns before this point. There is NO Alt+<number>
    * shortcut (L6): the tabs are walked with Ctrl-PgUp / Ctrl-PgDn, which in the
    * editor no longer mean "first/last line of the buffer" (that stays on
    * Ctrl-Home / Ctrl-End). */
   AAdd( a, "  Ctrl-PgUp/PgDn previous / next tab of the bar" )
   AAdd( a, "  Alt-W          close the active tab (asks to save when it changed)" )
   AAdd( a, "  click          on a tab it activates it, on its X it closes it" )
   AAdd( a, "  Esc            leave and ask to save when the buffer changed" )
RETURN a

/* =====================================================================
 *  S102 -- the mouse of the Text editor (S1 of hc-editor-mouse.md)
 *
 *  A click on the text puts the caret and a drag with the left button held
 *  EXTENDS the selection - the same aSel that Shift+arrows, Ctrl-C/X/V and
 *  Sel(n) already use, so nothing else in the editor has to learn a second
 *  notion of "selected".
 *
 *  The buffer counts BYTES and the screen counts CELLS (the code page), so the
 *  click is translated by the inverse of HcCdpCell(): HcCdpByte(). The two
 *  helpers below are PURE (no window, no driver) and that is what the headless
 *  bank pins; the screen only feeds them the cells the window hook hands over.
 *  The viewer (F3) does not read a single click: selecting is the editor's
 *  job, exactly as it is on the read-only screens of the rest of the program.
 * ===================================================================== */

/* S102: is that cell inside the TEXT AREA of the screen? Columns 0..MaxCol()
 * and rows from the first row of TEXT to HE_BOTTOM: the title, the rule of S12,
 * the status row and the two rows of hints are NOT text, so a click there never
 * moves the caret and never selects.
 * nTop (S12 of hc-editor-tabs.md, optional THIRD parameter) is that first row of
 * text, which HcTextTop() answers: the editor's is one row lower than the
 * viewer's because of the rule it paints under the bar. Absent, it is HE_TOP -
 * the viewer's row, which is what the screen has always been asked with. */
FUNCTION HcInTextArea( nRow, nCol, nTop )
   IF ValType( nRow ) != "N" .OR. ValType( nCol ) != "N"
      RETURN .F.
   ENDIF
   IF ValType( nTop ) != "N"
      nTop := HE_TOP
   ENDIF
RETURN Int( nRow ) >= Int( nTop ) .AND. Int( nRow ) <= HE_BOTTOM .AND. ;
       Int( nCol ) >= 0 .AND. Int( nCol ) <= MaxCol()

/* S102: the caret a click (or a drag step) on the text area lands on, as
 * { line, byteColumn } of the buffer, or NIL when the arguments are not usable.
 * nRow is the row of the AREA (0-based, so it is `screen row - the first text
 * row`, which HcTextTop() answers), nLft is the BYTE column the horizontal window
 * starts at and nCell is the 0-based column of the screen.
 *
 * The window is opened in CELLS by the painter (it paints from the cell of
 * nLft), so the click maps to the CELL `HcCdpCell( nLft ) + nCell` of the line
 * and the byte is HcCdpByte() of that cell. Everything is clamped: the row to
 * the lines of the buffer and the column to the length of the line, so a click
 * below the last line or right of the text always gives a usable caret (that
 * is also what makes a drag safe: it cannot leave the buffer). */
FUNCTION HcMouseCaret( aLines, nTop, nRow, nLft, nCell, cView )
   LOCAL nTot, nLine, cLine, nCell0

   IF ! HB_ISARRAY( aLines ) .OR. Len( aLines ) < 1
      RETURN NIL
   ENDIF
   IF ValType( nTop ) != "N" .OR. ValType( nRow ) != "N" .OR. ;
      ValType( nLft ) != "N" .OR. ValType( nCell ) != "N"
      RETURN NIL
   ENDIF
   nTot  := Len( aLines )
   nLine := Min( Max( 1, Int( nTop ) + Int( nRow ) ), nTot )
   cLine := iif( ValType( aLines[ nLine ] ) == "C", aLines[ nLine ], "" )
   /* the cell of the line where the window starts (a byte offset that landed
    * inside a character still gives the cell of THAT character) */
   nCell0 := HcCdpCell( cLine, Max( 0, Int( nLft ) ), cView ) + Max( 0, Int( nCell ) )
RETURN { nLine, HcCdpByte( cLine, nCell0, cView ) }

/* S102: ONE pass of the editor's mouse. It reads the click channel of the
 * window hook and, while the LEFT button is held, the pointer cell; everything
 * it changes arrives by reference, so the locals of the screen keep being the
 * only state of the editor (no new module statics).
 *
 *   a press inside the text area -> caret there and the selection collapsed
 *                                  (the anchor of the gesture)
 *   a press outside             -> nothing at all (no caret move, no change)
 *   a held button               -> the pointer cell EXTENDS the selection from
 *                                  the anchor; a pointer outside the area is
 *                                  ignored, and the gesture ends the moment the
 *                                  button is up (the next move is not a drag)
 *
 * It repaints through lDraw like every other action of this screen (the
 * selection can span ANY rows, so a two-row repaint would be wrong) and only
 * when the character under the pointer actually changed, so a fast drag does
 * not repaint twice for the same cell.
 *
 * nClickR / nClickC (S5 of hc-editor-tabs.md, NEW LAST optional parameters) are
 * the click the CALLER already read: the channel of the window hook empties when
 * it is read (trap 65), and the tab bar of row 0 needs the same press the text
 * does. With them absent (NIL) the screen reads the channel itself, exactly as
 * it did before. */
STATIC PROCEDURE HcEditorMouse( aLines, nTop, nLft, cView, nRow, nCol, aSel, lDraw, lDrag, nDragL, nDragC, nClickR, nClickC )
   LOCAL nR, nC, aMC, nTextTop := HcTextTop( .T. )    /* S12: the editor's row */

   IF ValType( nClickR ) == "N" .AND. ValType( nClickC ) == "N"
      nR := nClickR
      nC := nClickC
   ELSE
      nR := HcMouseClickRow()
      nC := HcMouseClickCol()
   ENDIF
   IF nR >= 0 .AND. nC >= 0
      lDrag := .F.
      IF HcInTextArea( nR, nC, nTextTop )
         aMC := HcMouseCaret( aLines, nTop, nR - nTextTop, nLft, nC, cView )
         IF HB_ISARRAY( aMC )
            nRow   := aMC[ 1 ] - nTop
            nCol   := aMC[ 2 ]
            aSel   := NIL                   /* a click collapses the selection */
            nDragL := aMC[ 1 ]              /* the anchor of the gesture       */
            nDragC := aMC[ 2 ]
            lDrag  := .T.
            lDraw  := .T.
         ENDIF
      ENDIF
      RETURN
   ENDIF

   IF ! ( ValType( lDrag ) == "L" .AND. lDrag )
      RETURN
   ENDIF
   IF ! HcMouseLeftDown()
      /* the button went up (or the capture did): the gesture is over and the
       * next move is not a drag any more, exactly like a finished sweep of
       * the panels (S37) */
      lDrag := .F.
      RETURN
   ENDIF
   nR := HcPointerRow()
   nC := HcPointerCol()
   IF ! HcInTextArea( nR, nC, nTextTop )
      /* the pointer left the text: the caret and the selection stay where
       * they were (a drag outside selects nothing) */
      RETURN
   ENDIF
   aMC := HcMouseCaret( aLines, nTop, nR - nTextTop, nLft, nC, cView )
   IF ! HB_ISARRAY( aMC )
      RETURN
   ENDIF
   IF aMC[ 1 ] == nDragL .AND. aMC[ 2 ] == nDragC
      RETURN                              /* the same character: no change    */
   ENDIF
   /* the SAME selection the keyboard builds: HcSelExtend() keeps the anchor of
    * a selection that already exists, so a drag can go back and forth without
    * the anchor walking away */
   aSel := HcSelExtend( aSel, nDragL, nDragC, aMC[ 1 ], aMC[ 2 ] )
   nRow := aMC[ 1 ] - nTop
   nCol := aMC[ 2 ]
   lDraw := .T.
RETURN

/* S8 of hc-editor-mouse.md: the right button on the TEXT opens the Copy / Cut /
 * Paste menu of the editor, at the cell that was pressed. The answer is turned
 * into the KEY the keyboard uses, so the DO CASE of the screen keeps being the
 * only place where an action runs (no second copy of the clipboard logic).
 * Returns 0 when there is no right press pending or it fell outside the text. */
STATIC FUNCTION HcEditPopupKey()
   LOCAL nR, nC, aItems, cAct
   nR := HcMouseRightRow()
   nC := HcMouseRightCol()
   IF nR < 0 .OR. nC < 0
      RETURN 0                          /* no right press: nothing to do */
   ENDIF
   /* the press is CONSUMED - its moves, its release and the cell of the press -
    * so the next idle pass does not open the same menu again (measured) */
   HcMouseRightDrain()
   IF ! HcInTextArea( nR, nC, HcTextTop( .T. ) )
      RETURN 0                          /* outside the text: the menu does not open */
   ENDIF
   /* the list and the key each entry stands for live in HcTextCtxItems() /
    * HcTextCtxKey(), so the cell of the Browse edit opens the same three */
   aItems := HcTextCtxItems()
   cAct := HcCtxMenuRun( nR, nC, aItems )
RETURN HcTextCtxKey( cAct )

STATIC PROCEDURE HcFileScreen( cFile, lEdit )
   LOCAL aRes, aLines, cTitle, cPrev
   LOCAL lLeave := .F., lMod := .F., lOvr := .F., lDraw := .T.
   LOCAL nTop := 1, nRow := 0, nCol := 0, nLft := 0
   LOCAL nTextTop := HcTextTop( lEdit ), nVis := HcTextRows( lEdit ), nW := MaxCol() + 1
   LOCAL nKey, nAbs, cLine, nWheel, cLang, nTabW
   /* S77: the search: the last query (the input is prefilled with it, so Enter
    * again is "find next"), the hit that is highlighted { line, col, len } and
    * the one-shot note of the status row (`[wrapped]`) */
   LOCAL cLastFind := "", aHit := { 0, 0, 0 }, cNote := "", cIn, aFound, nShift
   /* S13: lCtrl is the CTRL bit of the key just read (the codes of Ctrl+C/X/V
    * are the ones of PgDn/Down/Ins) and nClip is the chord the window hook
    * recorded for the four combos this driver delivers without its modifier */
   LOCAL lCtrl := .F., nClip := 0, lPopup := .F.
   /* S2 of editor-ctrl-chords.md: what the WORD chord means for this pass
    * (-1 / +1 / 0, from HcWordKey()) */
   LOCAL nWord := 0
   /* S7/S6: the selection of the editor (NIL = nothing selected), the snapshot
    * that Ctrl-Z restores after a Replace All and the two blocks of the dialog,
    * which are built DOWN HERE because they close over the locals above. */
   LOCAL aSel := NIL, aUndo := NIL, bPaint, bRun
   /* S1/S2 of editor-undo-redo.md: the WHOLE history of the session - undo and
    * redo - with no level cap, the caret the pass started with (the "before"
    * side of every record) and the row an edit is about to rewrite. */
   LOCAL aHist := {}, aRedo := {}, nRow0 := 0, nCol0 := 0, cOld := "", cAct2, cMsg2
   LOCAL aRec, aOut, nGoto
   /* S7: the anchor of a Shift+arrow run: the column the caret had before the
    * move (the line is nAbs, which never moves inside one pass) */
   LOCAL lSh, nAncCol
   /* S1/S2/S4 of hc-codepage.md: the code page of the FILE (`cCdp`: the bytes
    * of the buffer, what F2 writes, what every editing helper talks about) and
    * the one the screen is PAINTED with (`cView`, L5: F6 moves only this one),
    * the list and index of the picker and the two scratch columns of the
    * multi-byte editing (nSt: where the character before the caret starts;
    * cIns: the bytes of the key just typed) */
   LOCAL cCdp, cView, aCdp, nCdp, nSt, cIns
   /* S3 of hc-codepage.md, T4: the F9 Transform - the target of the picker, the
    * buffer converted line by line, whether the user accepts the loss of
    * characters and the converted query of the VIEWER search (what is typed is a
    * SCREEN code page string and the buffer holds the one of the FILE) */
   LOCAL cTo, aConv, lLoss, lAsk, cQry
   /* S102 of hc-editor-mouse.md: the drag of the editor - whether THIS screen
    * installed the window hook (so it does not remove the one the manager was
    * already using), whether a left-button gesture is live and the anchor it
    * started on { line, byte } */
   LOCAL lHookMine := .F., lDrag := .F., nDragL := 0, nDragC := 0
   /* S1..S3 of hc-pretty-print.md: the kind of the file ("" = it is not JSON
    * or XML, so the key is not offered), whether the VIEWER is showing the
    * formatted text and the text it showed before, the Alt chord of the pass
    * (the window hook is the source, Inkey() the fallback, like the incremental
    * search of the panels), the note that has to survive its own chord and the
    * packet HcPrettyText() answers */
   LOCAL cPKind, lPretty := .F., aRaw, cAlt, cRing, lAltSrc := .F.
   LOCAL cAltDrop := "", lNoteKeep := .F., aPk
   /* S1/S2/S5/S6 of hc-editor-tabs.md: the session tabs of the editor. `aTabs`
    * is the module array, `lResume` says this screen is opening on a tab that
    * already existed (so NOTHING is read from the disk), `nTabGo`/`nTabKill` are
    * what a click or an Alt chord asked for in this pass and `nClickR`/`nClickC`
    * are the click of the pass, read ONCE because the channel empties. */
   LOCAL aTabs, nTabIdx, nTabGo := 0, nTabKill := 0, lResume := .F., lAct := .F.
   LOCAL nClickR, nClickC, aCtl, lTabDrop := .F.
   /* S13/L10: the tab whose CLOSE MARK the pointer is over (0 = none) and the
    * cell read of the pass. It is a local of the screen like the caret, so a
    * repaint started from anywhere (the Find dialog included) paints the same
    * mark. */
   LOCAL nTabHov := 0, nHov

   /* ==== S1/S2/S11 of hc-editor-tabs.md: the editor works on a TAB of the
    * session and the viewer keeps exactly what it had. A tab that is already in
    * the session is RESUMED from its own record, so its buffer is NEVER read from
    * the disk again (S2: the whole point of the feature); the only disk question
    * asked is the S11 one - is the file still there? - and a tab whose file is
    * gone is dropped instead of being left dead. */
   IF lEdit
      aTabs   := s_aHcEditTabs
      nTabIdx := HcTabIndex( aTabs, cFile )
      IF nTabIdx > 0
         IF ! hb_vfExists( aTabs[ nTabIdx ][ HC_TB_PATH ] )
            /* S11: the tab is closed and the manager comes back with ONE
             * message: opening the file again would only fail again */
            UiErr( "The file is not there any more:" + hb_eol() + cFile, BP_APPNAME )
            aRes := HcTabClose( aTabs, nTabIdx, s_nHcEditSel )
            s_aHcEditTabs := aRes[ 1 ]
            s_nHcEditSel  := aRes[ 2 ]
            RETURN
         ENDIF
         lResume := .T.
      ENDIF
   ENDIF

   IF lResume
      /* S7/S10: a tab whose unsaved changes were SAVED or DISCARDED owns no
       * buffer any more, so its text is read from the DISK here (HcTabPreload)
       * before anything reads its slots: the screen cannot show what the user
       * just threw away, and it cannot show another tab's text either. The
       * caret, the code pages and the histories of the record are restored
       * below. */
      IF ! HcTabPreload( aTabs[ nTabIdx ] )
         UiErr( "The file is not there any more:" + hb_eol() + ;
                aTabs[ nTabIdx ][ HC_TB_PATH ], BP_APPNAME )
         aRes          := HcTabClose( aTabs, nTabIdx, s_nHcEditSel )
         s_aHcEditTabs := aRes[ 1 ]
         s_nHcEditSel  := aRes[ 2 ]
         RETURN
      ENDIF
      aRes := { .T., aTabs[ nTabIdx ][ HC_TB_LINES ], "" }
   ELSE
      aRes := HcReadText( cFile )
   ENDIF
   IF ! aRes[ 1 ]
      UiErr( aRes[ 3 ], BP_APPNAME )
      RETURN
   ENDIF
   aLines := aRes[ 2 ]
   IF Empty( aLines )
      aLines := { "" }
   ENDIF
   cTitle := cFile + iif( lEdit, "   [edit]", "   [view]" )
   /* S78/S80: the language of the file ("" = plain text) and the indent width
    * the file already uses -- detected once, changeable with F8. Both are PURE
    * functions of the path, so a resumed tab gets them for free. */
   cLang  := HcLangOf( cFile )
   cPKind := HcPrettyKind( cFile )
   IF lResume
      /* S2: the tab comes back exactly where it was left - the buffer above,
       * then its caret, its window, its flags, its code pages, its indent, its
       * selection, its two histories and the pending undo snapshot */
      HcTabRead( aTabs[ nTabIdx ], @aLines, @nTop, @nRow, @nCol, @nLft, @lMod, ;
                 @lOvr, @cCdp, @cView, @nTabW, @aSel, @aHist, @aRedo, @aUndo, ;
                 @aHit, @cNote, @cLastFind )
      IF Len( cCdp ) == 0
         cCdp := HcCdpDetect( HcJoinLines( aLines ) )
      ENDIF
      IF Len( cView ) == 0
         cView := cCdp
      ENDIF
   ELSE
      /* S1: the code page is DETECTED once, when the file is opened, and from
       * then on it belongs to the tab. L5: the detection fills BOTH code pages
       * - the FILE one (cCdp: what the bytes are, what is typed and what is
       * saved) and the VIEW one (cView: how they are painted), which are the
       * same id until F6 moves the view - and it never writes: it only changes
       * how the bytes are interpreted and painted. The verdict is always on the
       * status row, so a wrong one is seen and fixed with F6 (the view) or with
       * F9 (the file). */
      cCdp  := HcCdpDetect( HcJoinLines( aLines ) )
      cView := cCdp
      nTabW := HcIndentDetect( aLines, iif( cPKind == "json", 2, 4 ) )
   ENDIF
   cPrev := SetCursor( 0 )

   /* S102: the EDITOR reads the mouse, so the window hook has to be installed
    * here. It is installed only when it was not there already - the manager
    * that opened this screen installs it and keeps using it afterwards - and it
    * is removed only when THIS screen installed it: removing the manager's hook
    * on the way out would leave it without a mouse. The viewer installs
    * nothing, exactly as it did before. */
   IF lEdit
      IF ! s_lHcHook
         s_lHcHook := HcMouseHook( .T. )
         lHookMine := s_lHcHook
      ENDIF
      /* the click that opened this screen (the context menu of the manager
       * runs its action on a click) is not a click ON the text: it is drained
       * here so the caret does not jump to a cell of another screen */
      HcMouseClickDrain()
      /* the RIGHT channel is a PEEK and the manager never forgets the cell of
       * its last press, so a right click made before opening this screen opened
       * Copy / Cut / Paste on the first idle pass (reported: "apenas ingresa a
       * la pantalla de edicion me aparece el cuadro"). A gesture of another
       * screen is not a gesture here. */
      HcMouseRightDrain()
      /* S2 of editor-ctrl-chords.md: the same for the word chords - one recorded
       * in another screen cannot move the caret of THIS one */
      HcWordFlush()
   ENDIF

   /* S1 of hc-editor-tabs.md: `F4` is an ADD - the tab of this file is created
    * when it is not there and, when it IS there, the one that already exists is
    * ACTIVATED (HcTabAdd() answers its index and never duplicates). From here on
    * this record and the locals below are the same state: the painter keeps the
    * `modified` of the active one and the rest is stored when the tab is left. */
   IF lEdit
      nTabIdx      := HcTabAdd( s_aHcEditTabs, cFile )
      aTabs        := s_aHcEditTabs
      s_nHcEditSel := nTabIdx
      /* S8: a NEW tab starts clean against the text that was just read from the
       * disk, so its baseline is a copy of that buffer. A RESUMED tab keeps the
       * baseline it already carries in its record (its unsaved changes are still
       * unsaved, and an undo has to be able to take them back to the saved text). */
      IF ! lResume
         HcTabSnap( HcTabAt( aTabs, nTabIdx ), aLines )
      ENDIF
   ENDIF

   /* S2/S9: the two blocks the Find / Replace dialog drives. They are built
    * HERE, inside the procedure, because they close over its locals: bPaint
    * repaints this screen exactly as the loop does (so the editor is visible
    * around the box and around every change the dialog makes) and bRun runs
    * ONE action through the pure HcFindRun() and copies the packet back. */
   bPaint := {|| HcFileDraw( aLines, cTitle, nTop, nRow, nCol, nLft, lEdit, lMod, ;
                             lOvr, aHit, cNote, cLang, nTabW, aSel, cView, cCdp, ;
                             cPKind, lPretty, aTabs, s_nHcEditSel, nTabHov ) }
   /* S3: an Alt chord recorded BEFORE this screen opened (a letter typed with
    * Alt in the panel, the gesture that opened the file) is not a chord here */
   HcAltHookFlush()
   bRun := {| cAct2, aSt | HcFindBulk( cAct2, aSt, @aLines, @aSel, @nRow, @nCol, @nTop, ;
                                      @nLft, @aUndo, @aHist, @aRedo, @lMod, @cNote, ;
                                      @aHit, nVis, nW, cCdp ) }

   DO WHILE ! lLeave
      IF lDraw
         HcFileDraw( aLines, cTitle, nTop, nRow, nCol, nLft, lEdit, lMod, lOvr, ;
                     aHit, cNote, cLang, nTabW, aSel, cView, cCdp, cPKind, lPretty, ;
                     aTabs, s_nHcEditSel, nTabHov )
         lDraw := .F.
      ENDIF
      /* S5: INS hides the platform caret and HcFileDraw paints the block in its
       * place; OVR keeps the caret where the next character will land */
      IF lEdit .AND. lOvr
         SetCursor( 1 )
      ELSE
         SetCursor( 0 )
      ENDIF
      /* S4: the caret is placed on a CELL, not on a byte: the byte column of the
       * buffer and the byte column of the window are mapped to cells first */
      DevPos( nTextTop + nRow, Min( HcCdpPos( aLines[ nTop + nRow ], nCol, nLft, cView ), MaxCol() ) )
      lPopup := .F.
      /* S5/S6 of hc-editor-tabs.md: what a click or an Alt chord asks for the
       * tabs belongs to ONE pass only, so it is cleared here and not inside the
       * mouse branch (a pass with a key never enters it and would inherit the
       * order of the previous one) */
      nTabGo   := 0
      nTabKill := 0
      nKey := Inkey( 0.05 )
      /* S3 of hc-pretty-print.md / trap 61: with ALT held this driver can SWALLOW
       * the letter from Inkey() - the window hook records it anyway - so the ring
       * is read on every pass, also the ones that would LOOP, and the hook is the
       * source of the Alt chords from the first letter it delivers. */
      cRing := HcHookDrain()
      /* right-click-esc (S1/S2/S7): the VIEWER leaves with a plain right click,
       * the same as Esc; the EDITOR does NOT come through here, because there
       * the right button opens its Copy/Cut/Paste menu and that stays (S2). */
      IF nKey == 0 .AND. ! lEdit .AND. HcMouseRightClick()
         nKey := K_ESC
      ENDIF
      IF nKey == 0
         /* the wheel scrolls here */
         nWheel := HcMouseWheel()
         IF nWheel != 0
            nTop := HcFixTop( nTop - nWheel * 3, Len( aLines ), nVis )
            nRow := Min( nRow, Max( 0, Len( aLines ) - nTop ) )
            nCol := HcCdpSnap( aLines[ nTop + nRow ], ;
                               Min( nCol, Len( aLines[ nTop + nRow ] ) ), cCdp )
            nLft := HcFixLeft( nCol, nLft, nW )
            lDraw := .T.
         ENDIF
         /* S13/L10 of hc-editor-tabs.md: the MARK of a tab under the pointer is
          * painted with the hover pair. The cell is read ONCE per pass with the
          * same channel the menu bar of the manager uses: HcPointerStep() is what
          * EMPTIES the step, so a move is never read twice and the cell cannot
          * leak into the CLICK path (which is another channel, the one the tab
          * is activated and closed with). Only a change of the hovered tab
          * repaints, and it repaints through the same `lDraw` the rest of the
          * loop uses - there is no second paint path. */
         IF lEdit .AND. HcPointerStep()
            nHov := HcTabHover( aTabs, s_nHcEditSel, nW, HcPointerRow(), HcPointerCol() )
            IF nHov != nTabHov
               nTabHov := nHov
               lDraw   := .T.
            ENDIF
         ENDIF
         /* S102 of hc-editor-mouse.md: in the EDITOR a click puts the caret and
          * a drag with the button held extends the selection; the viewer reads
          * no click at all, exactly as before. S5/S6 of hc-editor-tabs.md: the
          * bar of row HE_TITLE needs the SAME press, and the channel of the hook
          * empties when it is read (trap 65), so the click is read ONCE here and
          * handed to both readers. */
         IF lEdit
            nClickR := HcMouseClickRow()
            nClickC := HcMouseClickCol()
            IF nClickR == HE_TITLE .AND. nClickC >= 0
               /* the cell belongs to the control the painter registered: a
                * click on a tab means "go to it" and one on its mark means
                * "close it", the same two actions Ctrl-PgUp/PgDn and Alt-W run */
               aCtl := HcSyncCtlAt( nClickR, nClickC )
               IF HB_ISARRAY( aCtl )
                  IF aCtl[ 4 ] == "HTAB"
                     nTabGo := Val( aCtl[ 5 ] )
                  ELSEIF aCtl[ 4 ] == "HTABX"
                     nTabKill := Val( aCtl[ 5 ] )
                  ENDIF
               ENDIF
            ENDIF
            HcEditorMouse( aLines, nTop, nLft, cView, @nRow, @nCol, @aSel, ;
                           @lDraw, @lDrag, @nDragL, @nDragC, nClickR, nClickC )
            /* S8: the right button on the text opens Copy / Cut / Paste; the
             * chosen entry becomes the KEY the keyboard uses, so the DO CASE
             * below stays the only place where the clipboard acts */
            nKey := HcEditPopupKey()
            IF nKey != 0
               lPopup := .T.
            ENDIF
         ENDIF
         IF nKey == 0 .AND. Empty( cRing ) .AND. nTabGo == 0 .AND. nTabKill == 0
            LOOP
         ENDIF
      ENDIF

      /* S77: the modifier state of the key just read, IMMEDIATELY after Inkey()
       * and before anything else touches the driver: K_CTRL_F and K_END are the
       * same code 6 and this is the only way to tell Ctrl-F from End (trap 37) */
      nShift := HcShiftState()
      lCtrl := HcKeyCtrl( nShift )
      /* S3 of hc-pretty-print.md: the Alt+<letter> of this pass. Until the hook
       * delivers a letter Inkey() is the channel (a K_ALT_* code or the bare
       * letter plus the ALT bit, trap 37); from then on the hook is the ONLY
       * source, so the same stroke cannot arrive twice. AltGr is Ctrl+Alt and
       * HcAltLetter() rejects it (trap 38), so a character typed with AltGr is
       * still typed. An Alt chord is NEVER written into the buffer. */
      cAlt := ""
      IF ! lAltSrc
         cAlt := HcAltLetter( nKey, nShift )
         IF ! Empty( cAlt )
            nKey := 0
            cAltDrop := Upper( Left( cAlt, 1 ) )   /* this stroke's hook copy */
         ENDIF
      ENDIF
      /* S5 of hc-editor-tabs.md / L6: Alt+<digit> USED to be a chord of this
       * screen and no longer is. This driver hands a bare digit with ALT over as
       * the DIGIT (HcAltLetter() only knows letters) and the ring of the hook
       * records it like any other printable, so the digit is claimed and zeroed
       * here: it activates no tab and it is not typed into the buffer. */
      IF Empty( cAlt ) .AND. lEdit .AND. nKey >= Asc( "1" ) .AND. ;
         nKey <= Asc( "9" ) .AND. HcShiftAlt( nShift ) .AND. ! HcKeyCtrl( nShift )
         cAltDrop := Chr( nKey )
         nKey     := 0
      ENDIF
      IF ! Empty( cRing )
         IF Empty( cAltDrop ) .OR. ! ( Upper( Left( cRing, 1 ) ) == cAltDrop )
            cAlt := Upper( Left( cRing, 1 ) )
            nKey := 0
         ENDIF
         lAltSrc  := .T.
         cAltDrop := ""
      ENDIF
      /* S5/S6 of hc-editor-tabs.md: Alt-W CLOSES the active tab, and it becomes
       * the same order a click on the mark sets (nTabKill), so the first two
       * CASEs of the DO CASE below are shared by the mouse and the keyboard.
       * Alt-P is untouched: it is not a W. L6 took Alt+<digit> out: the tabs are
       * walked with Ctrl-PgUp / Ctrl-PgDn, so a bare digit with ALT is claimed by
       * nobody and no longer types itself either. */
      IF lEdit .AND. ! Empty( cAlt )
         IF cAlt == "W" .AND. s_nHcEditSel >= 1
            nTabKill := s_nHcEditSel
         ENDIF
      ENDIF
      /* S8: the key chosen in the context menu of the editor is a CHORD, and
       * this driver does not report the modifier of a real one (trap 58) */
      IF lPopup
         lCtrl := .T.
      ENDIF
      /* S13: Ctrl+C, Ctrl+X and Shift+Ins do NOT arrive here with their
       * modifier (measured, AGENTS trap 58), so they come from the window
       * hook - the second channel the panels already use. The chord is turned
       * into its canonical key code HERE, which means one branch per action in
       * the loop, and the Inkey() copy of the same stroke is dropped by
       * overwriting nKey: one keystroke, one action.
       * Shift+Del USED to come through here as clip code 4 (cut); since S3 of
       * recycle-bin-delete.md it is no longer a clipboard chord - the hook
       * records it on its own channel (W32HardDelStep) and the panels use it as
       * "delete without the Recycle Bin". The OTHERWISE branch is still
       * reachable with Ctrl+X (code 3). */
      nClip := HcClipDrain()
      IF nClip != 0
         DO CASE
         CASE nClip == 1
            nKey := K_CTRL_C                       /* copy  */
         CASE nClip == 2
            nKey := K_CTRL_V                       /* paste */
         OTHERWISE
            nKey := K_CTRL_X                       /* cut   */
         ENDCASE
         lCtrl := .T.
      ENDIF

      /* S2/S4 of editor-ctrl-chords.md: the WORD chords of this screen.
       * MEASURED: Ctrl+Left arrives as the code of Ctrl-Z (26) and both come with
       * the CTRL bit, so the window hook - which sees the ARROW - is what tells
       * them apart; Ctrl+Right is code 2 and needs no help. `nKey` is ZEROED when
       * it is a word chord, so the Inkey() copy of the SAME stroke cannot act a
       * second time (code 26 would undo, code 2 is Ctrl-Right again): one
       * keystroke, one action, exactly like the clipboard channel above. */
      nWord := HcWordKey( nKey, nShift, HcWordDrain() )
      IF nWord != 0
         nKey := 0
      ENDIF

      /* S5/L6 of hc-editor-tabs.md: Ctrl-PgUp / Ctrl-PgDn walk the tabs - the
       * previous one and the next one, wrapping at both ends, through the SAME
       * pure HcTabStep() the rest of the bar uses - and produce the SAME order a
       * click sets (nTabGo), so the switch is ONE piece of code. In the editor
       * those two keys STOPPED meaning "first/last line of the buffer": that is
       * Ctrl-Home / Ctrl-End, which are gated below. nKey is zeroed so the
       * movement CASE of the same stroke cannot act a second time, and the
       * VIEWER (which has no tabs) keeps the old meaning untouched. */
      IF lEdit .AND. ( nKey == K_CTRL_PGUP .OR. nKey == K_CTRL_PGDN )
         nTabGo := HcTabStep( aTabs, s_nHcEditSel, iif( nKey == K_CTRL_PGDN, 1, -1 ) )
         nKey   := 0
      ENDIF

      nAbs := nTop + nRow
      /* S2 (editor-undo-redo.md): the same diagnostic the panels and the dialog
       * already print with BP_DEBUG=1 - what the driver delivered, the bits and
       * how deep the two histones are, in one line of hwbro.err. */
#ifndef BP_HC_STANDALONE
      BpLog( "HcEdit key=" + LTrim( Str( nKey ) ) + " shift=" + LTrim( Str( nShift ) ) + ;
             " undo=" + iif( HcUndoKey( nKey, nShift ), "1", "0" ) + ;
             " redo=" + iif( HcRedoKey( nKey, nShift ), "1", "0" ) + ;
             " word=" + LTrim( Str( nWord ) ) + ;
             " hist=" + LTrim( Str( Len( aHist ) ) ) + ;
             " rdo=" + LTrim( Str( Len( aRedo ) ) ) )
#endif
      /* S2: the caret this pass STARTS with is the "before" side of the record
       * of any edit below (the loop has already moved it by the time an edit
       * runs, so it has to be taken here) */
      nRow0 := nRow
      nCol0 := nCol
      /* S7: SHIFT is not part of the key code of the arrows in this driver, so
       * it is read with the helper (which also reads the LIVE state, measured
       * and needed for the arrows), and the column the caret is standing on is
       * the anchor a Shift+move extends the selection from. The viewer has no
       * selection at all. */
      lSh := lEdit .AND. HcKeyShift( nShift )
      nAncCol := nCol
      /* S2 of hc-pretty-print.md: the note of the Alt chord has to survive its
       * own key (the key code is zeroed), exactly like the note of the search */
      lNoteKeep := .F.

      DO CASE
      /* --- S5/S6 of hc-editor-tabs.md: the TABS of the editor. They come FIRST
       * because a click on the bar and an Alt chord both arrive with nKey
       * already zero (nothing below could claim them) and because activating or
       * closing a tab REPLACES the whole state the rest of the pass would work
       * on. `nTabGo` and `nTabKill` are the two things a click and a key have in
       * common: the click sets them from the shared control table, the keyboard
       * from the chord, and from here on the two paths are THE SAME code. */
      CASE lEdit .AND. nTabGo != 0
         nTabIdx := nTabGo
         /* S13/L10: the tab the pointer was over is not the one that was there
          * before a switch, so the hover starts over (the next move sets it) */
         nTabHov := 0
         IF nTabIdx >= 1 .AND. nTabIdx <= Len( aTabs ) .AND. nTabIdx != s_nHcEditSel
            IF ! hb_vfExists( aTabs[ nTabIdx ][ HC_TB_PATH ] ) .OR. ;
               ! HcTabPreload( aTabs[ nTabIdx ] )
               /* S11: the file of that tab cannot be reached any more, so the
                * tab is DROPPED instead of being left dead: one message and the
                * screen stays on the tab it was working on. The preload is part
                * of the same test because a tab that owns no buffer has to read
                * its file BEFORE its slots are used (S6/S7). */
               UiErr( "The file is not there any more:" + hb_eol() + ;
                      aTabs[ nTabIdx ][ HC_TB_PATH ], BP_APPNAME )
               aRes          := HcTabClose( aTabs, nTabIdx, s_nHcEditSel )
               aTabs         := aRes[ 1 ]
               s_aHcEditTabs := aTabs
               s_nHcEditSel  := aRes[ 2 ]
               IF s_nHcEditSel == 0
                  lLeave := .T.
               ENDIF
            ELSE
               /* S2: the tab being left keeps its buffer, its caret and its
                * whole history - they are written into its record - and nothing
                * is read from the disk when it comes back */
               HcTabStore( HcTabAt( aTabs, s_nHcEditSel ), aLines, nTop, nRow, ;
                           nCol, nLft, lMod, lOvr, cCdp, cView, nTabW, aSel, ;
                           aHist, aRedo, aUndo, aHit, cNote, cLastFind )
               s_nHcEditSel := nTabIdx
               HcTabRead( aTabs[ nTabIdx ], @aLines, @nTop, @nRow, @nCol, @nLft, ;
                          @lMod, @lOvr, @cCdp, @cView, @nTabW, @aSel, @aHist, ;
                          @aRedo, @aUndo, @aHit, @cNote, @cLastFind )
               /* S2: the path travels with the tab - F2 and Ctrl-S write
                * `cFile`, so leaving it on the file this session was opened
                * with would save the buffer of the new tab over THAT file
                * (measured: the write really goes to the wrong name) */
               cFile  := aTabs[ nTabIdx ][ HC_TB_PATH ]
               cTitle := aTabs[ nTabIdx ][ HC_TB_PATH ] + "   [edit]"
               cLang  := HcLangOf( aTabs[ nTabIdx ][ HC_TB_PATH ] )
               cPKind := HcPrettyKind( aTabs[ nTabIdx ][ HC_TB_PATH ] )
            ENDIF
         ENDIF
         lDraw := .T.

      CASE lEdit .AND. nTabKill != 0
         /* S6/S7: closing a tab asks the SAME question Esc asks when the buffer
          * of THAT tab changed (HcAskSave(), once, and "No" discards). A save
          * that fails leaves the editor exactly as it is. */
         nTabIdx := nTabKill
         nTabHov := 0                 /* S13/L10: the bar changed under the pointer */
         IF nTabIdx >= 1 .AND. nTabIdx <= Len( aTabs )
            /* the ACTIVE tab is the one held by the locals: its record is
             * written first, so the question is about what is on screen */
            HcTabStore( HcTabAt( aTabs, s_nHcEditSel ), aLines, nTop, nRow, ;
                        nCol, nLft, lMod, lOvr, cCdp, cView, nTabW, aSel, ;
                        aHist, aRedo, aUndo, aHit, cNote, cLastFind )
            IF HcTabAsk( aTabs[ nTabIdx ] )
               lAct := ( nTabIdx == s_nHcEditSel )
               aRes          := HcTabClose( aTabs, nTabIdx, s_nHcEditSel )
               aTabs         := aRes[ 1 ]
               s_aHcEditTabs := aTabs
               s_nHcEditSel  := aRes[ 2 ]
               IF s_nHcEditSel == 0
                  /* S6: the LAST tab is gone -> back to the manager */
                  lLeave := .T.
               ELSEIF lAct
                  /* S6: the ACTIVE tab went, so its neighbour takes over with
                   * ITS OWN buffer. A neighbour that owns no buffer (its changes
                   * were saved or discarded) reads its file from the disk first:
                   * taking over with the buffer of the tab that just went would
                   * paint one file's text under another file's name. */
                  IF ! HcTabPreload( aTabs[ s_nHcEditSel ] )
                     UiErr( "The file is not there any more:" + hb_eol() + ;
                            aTabs[ s_nHcEditSel ][ HC_TB_PATH ], BP_APPNAME )
                     lLeave := .T.
                  ELSE
                     HcTabRead( aTabs[ s_nHcEditSel ], @aLines, @nTop, @nRow, ;
                                @nCol, @nLft, @lMod, @lOvr, @cCdp, @cView, @nTabW, ;
                                @aSel, @aHist, @aRedo, @aUndo, @aHit, @cNote, ;
                                @cLastFind )
                     /* S2: the path of the tab that takes over, for the same
                      * reason as in the switch above (F2 writes `cFile`) */
                     cFile  := aTabs[ s_nHcEditSel ][ HC_TB_PATH ]
                     cTitle := aTabs[ s_nHcEditSel ][ HC_TB_PATH ] + "   [edit]"
                     cLang  := HcLangOf( aTabs[ s_nHcEditSel ][ HC_TB_PATH ] )
                     cPKind := HcPrettyKind( aTabs[ s_nHcEditSel ][ HC_TB_PATH ] )
                  ENDIF
               ENDIF
            ENDIF
         ENDIF
         lDraw := .T.

      /* --- S1..S3 of hc-pretty-print.md: Alt-P pretty prints the JSON or XML
       * text. It comes FIRST because nKey is already zero when the chord came
       * from the window hook, so nothing below can claim it.
       *   VIEWER  the buffer is replaced in MEMORY and Alt-P again puts the text
       *           back: the file is never written, so the toggle is free.
       *   EDITOR  the buffer really becomes the formatted text: it is marked
       *           modified, F2 saves it and ONE Ctrl-Z puts the old text back
       *           (the same shape as F9 CdpTransf).
       * A file that is already formatted changes nothing (no undo step, no
       * modified flag); invalid content is refused in a box and nothing is
       * touched; only JSON and XML answer, and the chip of the key is not even
       * painted for the rest. */
      CASE ! Empty( cAlt ) .AND. cAlt == "P"
         lNoteKeep := .T.
         IF Empty( cPKind )
            cNote := "Only JSON and XML files can be pretty printed."
         ELSEIF ! lEdit .AND. lPretty
            /* the VIEWER toggle comes FIRST (and costs nothing): with the
             * formatted text on screen the formatter is idempotent, so asking
             * `already formatted?` before the toggle would never let the user
             * back to the file */
            aLines  := aRaw
            aRaw    := NIL
            lPretty := .F.
            cNote   := "Original text."
            aHit    := { 0, 0, 0 }
            nTop    := 1
            nRow    := 0
            nCol    := 0
            nLft    := 0
         ELSE
            aPk := HcPrettyText( aLines, cPKind, nTabW )
            IF ! aPk[ 1 ]
               UiErr( aPk[ 3 ], "Pretty print" )
            ELSEIF Len( aPk[ 2 ] ) == 0
               cNote := "Nothing to format."
            ELSEIF HcJoinLines( aPk[ 2 ] ) == HcJoinLines( aLines )
               cNote := "Already formatted."
            ELSEIF lEdit
               /* S2 of editor-undo-redo.md: the whole reformat is ONE step */
               aUndo  := HcCopyLines( aLines )
               aLines := aPk[ 2 ]
               lMod   := .T.
               aSel   := NIL
               aHit   := { 0, 0, 0 }
               nTop   := Max( 1, Min( nTop, Len( aLines ) ) )
               nRow   := Max( 0, Min( nRow, Len( aLines ) - nTop ) )
               nCol   := HcCdpSnap( aLines[ nTop + nRow ], ;
                                    Min( nCol, Len( aLines[ nTop + nRow ] ) ), cCdp )
               nLft   := HcFixLeft( nCol, nLft, nW )
               HcUndoBulk( @aHist, @aRedo, @aUndo, aLines, nRow0, nCol0, nRow, nCol )
               cNote  := "Pretty printed."
            ELSE
               aRaw    := aLines
               aLines  := aPk[ 2 ]
               lPretty := .T.
               cNote   := "Pretty printed (Alt-P back)."
               aHit    := { 0, 0, 0 }
               nTop    := 1
               nRow    := 0
               nCol    := 0
               nLft    := 0
            ENDIF
         ENDIF
         lDraw := .T.

      CASE nKey == K_ESC
         IF lEdit
            /* S10 of hc-editor-tabs.md: Esc does NOT close the tabs, it goes
             * back to the manager as always - and asks ONCE PER TAB with
             * unsaved changes (the ACTIVE one first, then in the order of the
             * bar) with the same question it always asked, so no buffer is lost
             * in silence. The record of the active tab is written first: the
             * question is about what is on screen. */
            HcTabStore( HcTabAt( aTabs, s_nHcEditSel ), aLines, nTop, nRow, ;
                        nCol, nLft, lMod, lOvr, cCdp, cView, nTabW, aSel, ;
                        aHist, aRedo, aUndo, aHit, cNote, cLastFind )
            IF HcTabsAsk( aTabs, s_nHcEditSel )
               /* S7/S10: each tab that had changes was SAVED or DISCARDED and
                * HcTabAsk() dropped its buffer, so storing again at the bottom
                * of this procedure would put the live buffer - the text the
                * user just discarded - back into the record. Leaving by Esc
                * does not store. */
               lTabDrop := .T.
               lLeave   := .T.
            ELSE
               lDraw := .T.
            ENDIF
         ELSE
            lLeave := .T.
         ENDIF

      CASE nKey == K_F1
         /* the keys of THIS screen: HcFileHelp() lists the editor ones only
          * when the screen is the editor. The box is the one F1 of the file
          * manager already uses, and it restores the screen when it closes, so
          * the whole screen is painted again afterwards. */
         UiTextWin( HcFileHelp( lEdit, cPKind ), ;
                    iif( lEdit, "Text editor - keys", "Text viewer - keys" ) )
         lDraw := .T.

      CASE nKey == K_F2
         IF lEdit
            IF HcSaveTab( cFile, aLines, HcTabAt( aTabs, s_nHcEditSel ) )
               lMod := .F.
            ENDIF
            lDraw := .T.
         ENDIF

      /* --- S1/S3 of editor-ctrl-chords.md: Ctrl+S saves, with EXACTLY the same
       * effect as F2 (the same HcSaveTab(), the modified flag cleared only
       * when the write worked, and nothing at all in the read-only viewer, where
       * F2 does nothing either). This CASE MUST come before the K_LEFT one (and
       * before every movement): MEASURED, Ctrl+S arrives as code 19, which is
       * the code of Left, and only the CTRL bit tells them apart (trap 37). */
      CASE HcSaveKey( nKey, nShift )
         IF lEdit
            IF HcSaveTab( cFile, aLines, HcTabAt( aTabs, s_nHcEditSel ) )
               lMod := .F.
            ENDIF
            lDraw := .T.
         ENDIF

      /* --- S13: the clipboard of the selection. These CASEs MUST come before
       * K_PGUP / K_DOWN / K_INS: K_CTRL_C == K_PGDN (3), K_CTRL_X == K_DOWN
       * (24) and K_CTRL_V == K_INS (22), so only the CTRL bit tells them apart
       * (trap 37), and the chords the driver eats were translated to these
       * codes from the window hook above. */
      CASE ( nKey == K_CTRL_C .AND. lCtrl ) .OR. nKey == K_CTRL_INS
         IF lEdit
            cNote := HcEditClipAct( "copy", @aLines, @aSel, @nRow, @nTop, @nCol, ;
                                    @nLft, @aUndo, @lMod, @cNote, nVis, nW, cCdp )
            lDraw := .T.
         ENDIF
      CASE nKey == K_CTRL_X .AND. lCtrl
         IF lEdit
            cNote := HcEditClipAct( "cut", @aLines, @aSel, @nRow, @nTop, @nCol, ;
                                    @nLft, @aUndo, @lMod, @cNote, nVis, nW, cCdp )
            /* S2: the record of the cut is the snapshot the action answered */
            HcUndoBulk( @aHist, @aRedo, @aUndo, aLines, nRow0, nCol0, nRow, nCol )
            lDraw := .T.
         ENDIF

      CASE nKey == K_CTRL_V .AND. lCtrl
         IF lEdit
            cNote := HcEditClipAct( "paste", @aLines, @aSel, @nRow, @nTop, @nCol, ;
                                    @nLft, @aUndo, @lMod, @cNote, nVis, nW, cCdp )
            HcUndoBulk( @aHist, @aRedo, @aUndo, aLines, nRow0, nCol0, nRow, nCol )
            lDraw := .T.
         ENDIF

      CASE nKey == K_UP
         IF nRow > 0
            nRow--
         ELSEIF nTop > 1
            nTop--
         ENDIF
         /* S4 of hc-codepage.md: the clamp is by BYTES, so in a multi-byte code
          * page it can land in the middle of a character; HcCdpSnap() takes it
          * back to the start of that character */
         nCol := HcCdpSnap( aLines[ nTop + nRow ], ;
                            Min( nCol, Len( aLines[ nTop + nRow ] ) ), cCdp )
         nLft := HcFixLeft( nCol, nLft, nW )
         lDraw := .T.

      CASE nKey == K_DOWN
         IF nTop + nRow < Len( aLines )
            IF nRow < nVis - 1
               nRow++
            ELSE
               nTop++
            ENDIF
         ENDIF
         nCol := HcCdpSnap( aLines[ nTop + nRow ], ;
                            Min( nCol, Len( aLines[ nTop + nRow ] ) ), cCdp )
         nLft := HcFixLeft( nCol, nLft, nW )
         lDraw := .T.

      CASE nKey == K_PGUP
         nTop := Max( 1, nTop - nVis )
         nRow := Min( nRow, Max( 0, Len( aLines ) - nTop ) )
         nCol := HcCdpSnap( aLines[ nTop + nRow ], ;
                            Min( nCol, Len( aLines[ nTop + nRow ] ) ), cCdp )
         nLft := HcFixLeft( nCol, nLft, nW )
         lDraw := .T.

      CASE nKey == K_PGDN
         nTop := HcFixTop( nTop + nVis, Len( aLines ), nVis )
         nRow := Min( nRow, Max( 0, Len( aLines ) - nTop ) )
         nCol := HcCdpSnap( aLines[ nTop + nRow ], ;
                            Min( nCol, Len( aLines[ nTop + nRow ] ) ), cCdp )
         nLft := HcFixLeft( nCol, nLft, nW )
         lDraw := .T.

      CASE nKey == K_CTRL_HOME .OR. ( ! lEdit .AND. nKey == K_CTRL_PGUP )
         nTop := 1
         nRow := 0
         nCol := 0
         nLft := 0
         lDraw := .T.

      /* S5/L6: in the EDITOR Ctrl-PgDn walks to the next tab (the tab CASEs, up
       * there, already consumed it: this branch is the VIEWER's, where the two
       * keys keep meaning "first/last line of the buffer") */
      CASE nKey == K_CTRL_END .OR. ( ! lEdit .AND. nKey == K_CTRL_PGDN )
         nTop := HcFixTop( Len( aLines ), Len( aLines ), nVis )
         nRow := Max( 0, Len( aLines ) - nTop )
         nCol := Len( aLines[ nTop + nRow ] )
         nLft := HcFixLeft( nCol, nLft, nW )
         lDraw := .T.

      CASE nKey == K_HOME
         nCol := 0
         nLft := 0
         lDraw := .T.

      /* --- S2/S77: the SEARCH. This CASE MUST come before the K_END one below:
       * K_CTRL_F and K_END are the same code 6, and HcTextFindKey() is what
       * tells them apart (the CTRL bit); a plain End falls through to K_END.
       * In the EDITOR the key opens the Find / Replace dialog (S2), which drives
       * this buffer through bRun and repaints the screen through bPaint; the
       * read-only VIEWER keeps the plain `Find text:` prompt of S77 untouched,
       * byte for byte (its bank block has to keep passing).
       * Neither path saves: only F2 and the `save?` question on Esc do that. */
      CASE HcTextFindKey( nKey, nShift )
         IF lEdit
            HcFindDlg( HcFindState( ! HcSelEmpty( aSel ) ), bPaint, bRun )
         ELSE
            cIn := UiInput( "Find text:", cLastFind, 40 )
            cNote := ""
            aHit := { 0, 0, 0 }
            IF ! hb_IsNIL( cIn ) .AND. Len( cIn ) > 0
               cLastFind := cIn
               /* S3 of hc-codepage.md: the typed text arrives in the code page of
                * the SCREEN and the buffer holds the one of the FILE, so the
                * query is CONVERTED before it is searched - without this an
                * accent never matches a UTF-8 file. The prompt keeps what the
                * user typed (cLastFind) and the hit carries the length of the
                * converted text, in BYTES of the buffer, which is what the
                * painter maps to cells (HcFileDraw). */
               cQry := HcCdpConv( cIn, HcCdpScreen(), cCdp )
               /* from the column AFTER the caret, so Enter again finds the next */
               aFound := HcTextFind( aLines, cQry, nAbs, nCol + 1 )
               IF aFound[ 1 ] == 0
                  /* wrap ONCE from the top of the buffer, and say so */
                  aFound := HcTextFind( aLines, cQry, 1, 0 )
                  cNote := "[wrapped]"
               ENDIF
               IF aFound[ 1 ] == 0
                  UiMsg( "Not found.", BP_APPNAME )
               ELSE
                  aHit := { aFound[ 1 ], aFound[ 2 ], Len( cQry ) }
                  nTop := HcFixTop( aFound[ 1 ] - Int( nVis / 2 ), Len( aLines ), nVis )
                  nRow := Min( nVis - 1, aFound[ 1 ] - nTop )
                  nCol := aFound[ 2 ]
                  nLft := HcFixLeft( nCol, nLft, nW )
               ENDIF
            ENDIF
         ENDIF
         lDraw := .T.

      /* --- S2/S4 of editor-ctrl-chords.md: Ctrl-Left / Ctrl-Right move the
       * caret one WORD or SYMBOL, with the SAME rule the dialog fields use
       * (UiWordLeft() / UiWordRight(): a run of letters, digits and underscore,
       * every other cell its own stop, a run of blanks crossed in one step). The
       * caret never leaves the line - the helpers are clamped to its length, so
       * there is no wrap to the line above or below.
       * This CASE MUST come before HcUndoKey(): the code of Ctrl+Left IS the code
       * of Ctrl+Z (26, measured), so the word chord was already told apart by the
       * window hook and nKey zeroed; a Ctrl+Z reaches this point with nWord == 0
       * and keeps undoing. A movement extends the selection with SHIFT and
       * collapses it without it, exactly like an arrow (S7 rule), and it keeps
       * the note and the mark of the status row (S5, HcNoteKey()). */
      CASE nWord != 0
         /* the SAME word rule the dialogs use, with the cell of the field
          * translated to the insertion point of the editor (HcWordCaret), and
          * the byte column snapped to the start of a character */
         nCol := HcWordCaret( aLines[ nTop + nRow ], nCol, nWord, cCdp )
         nLft := HcFixLeft( nCol, nLft, nW )
         IF lEdit
            aSel := HcSelAfter( aSel, lSh, nAbs, nAncCol, nTop + nRow, nCol )
         ENDIF
         lDraw := .T.

      /* S1/S6: Ctrl-Z UNDOES and Ctrl-Shift-Z REDOES, on an unlimited history
       * (S2). The chords are recognised by the pure HcUndoKey()/HcRedoKey(),
       * because this driver hands Ctrl-Z over as the bare letter with the CTRL
       * bit instead of its key code and, with SHIFT down, as an uppercase Z. */
      CASE HcUndoKey( nKey, nShift )
         IF lEdit
            aUndo := NIL                  /* a pending bulk snapshot is not a step */
            aRec := HcUndoPop( aHist )
            IF HB_ISARRAY( aRec[ 1 ] )
               aHist := aRec[ 2 ]
               aRec  := aRec[ 1 ]
               /* put the BEFORE side back and keep the record to redo it */
               aRedo := HcUndoPush( aRedo, aRec )
               aLines := HcUndoSplice( aLines, aRec[ HU_AT ], Len( aRec[ HU_IN ] ), aRec[ HU_OUT ] )
               nTop := Max( 1, Min( nTop, Len( aLines ) ) )
               nRow := Max( 0, Min( aRec[ HU_ROW_B ], Len( aLines ) - nTop ) )
               nCol := Max( 0, Min( aRec[ HU_COL_B ], Len( aLines[ nTop + nRow ] ) ) )
               nLft := HcFixLeft( nCol, nLft, nW )
               aSel := NIL
               aHit := { 0, 0, 0 }
               /* S8/L14: `modified` is not "an edit happened" but "the buffer
                * DIFFERS from the text that was saved last", so undoing back to
                * the saved text makes the tab CLEAN again (the X of the bar goes
                * back to its rest colour and Esc does not ask to save) and
                * undoing past it - or redoing forward - keeps it modified. The
                * edits themselves still set lMod := .T.; only undo and redo pay
                * for the compare. */
               lMod := ! HcSameText( aLines, ;
                              HcTabSaved( HcTabAt( aTabs, s_nHcEditSel ) ) )
               cNote := "Undo."
            ELSE
               cNote := "Nothing to undo."
            ENDIF
            lDraw := .T.
         ENDIF

      /* S11: Ctrl+G asks for a number of line and jumps there. It works in the
       * editor AND in the viewer, because it only moves the caret. */
      CASE HcGotoKey( nKey, nShift )
         cIn := UiInput( "Go to line (1-" + LTrim( Str( Len( aLines ) ) ) + "):", "", 8 )
         IF ! hb_IsNIL( cIn )
            nGoto := HcGotoLine( cIn, Len( aLines ), nTop + nRow )
            nTop  := HcFixTop( nGoto - Int( nVis / 2 ), Len( aLines ), nVis )
            nRow  := Min( nVis - 1, nGoto - nTop )
            nCol  := 0
            nLft  := 0
            aSel  := NIL
            aHit  := { 0, 0, 0 }
            cNote := "Line " + LTrim( Str( nGoto ) )
         ENDIF
         lDraw := .T.

      /* S1: Ctrl-Shift-Z redoes the step the last Ctrl-Z took back */
      CASE HcRedoKey( nKey, nShift )
         IF lEdit
            aRec := HcUndoPop( aRedo )
            IF HB_ISARRAY( aRec[ 1 ] )
               aRedo := aRec[ 2 ]
               aRec  := aRec[ 1 ]
               aHist := HcUndoPush( aHist, aRec )
               aLines := HcUndoSplice( aLines, aRec[ HU_AT ], Len( aRec[ HU_OUT ] ), aRec[ HU_IN ] )
               nTop := Max( 1, Min( nTop, Len( aLines ) ) )
               nRow := Max( 0, Min( aRec[ HU_ROW_A ], Len( aLines ) - nTop ) )
               nCol := Max( 0, Min( aRec[ HU_COL_A ], Len( aLines[ nTop + nRow ] ) ) )
               nLft := HcFixLeft( nCol, nLft, nW )
               aSel := NIL
               aHit := { 0, 0, 0 }
               /* S8/L14: the same rule as the undo above - redoing forward to
                * something that is not the saved text is modified, and redoing
                * back onto it is clean */
               lMod := ! HcSameText( aLines, ;
                              HcTabSaved( HcTabAt( aTabs, s_nHcEditSel ) ) )
               cNote := "Redo."
            ELSE
               cNote := "Nothing to redo."
            ENDIF
            lDraw := .T.
         ENDIF

      /* S13: Ctrl-Insert is wired with the other two chords, UP HERE, because
       * its code is the one of PgDn (see the clipboard CASEs above). */

      CASE nKey == K_END
         nCol := Len( aLines[ nAbs ] )
         nLft := HcFixLeft( nCol, nLft, nW )
         lDraw := .T.

      CASE nKey == K_LEFT
         /* S4: one CHARACTER back, not one byte: HcCdpPrev() lands on the start
          * of the UTF-8 sequence instead of inside it */
         nCol := HcCdpPrev( aLines[ nAbs ], nCol, cCdp )
         nLft := HcFixLeft( nCol, nLft, nW )
         lDraw := .T.

      CASE nKey == K_RIGHT
         nCol := Min( Len( aLines[ nAbs ] ), ;
                      nCol + HcCdpCharLen( aLines[ nAbs ], nCol, cCdp ) )
         nLft := HcFixLeft( nCol, nLft, nW )
         lDraw := .T.

      CASE nKey == K_INS
         IF lEdit
            lOvr := ! lOvr
            lDraw := .T.
         ENDIF

      CASE nKey == K_ENTER
         IF lEdit
            /* S7: an editing key with a selection removes the selection FIRST
             * and leaves the caret where the deletion ended, so the typing
             * lands there (the rule of S7, the same for all the editing keys). */
            HcSelDropEdit( @aHist, @aRedo, @aLines, @aSel, @nTop, @nRow, @nCol, @nLft, @lMod, nVis, nW )
            nAbs := nTop + nRow
            /* split the line at the caret */
            cLine := aLines[ nAbs ]
            ASize( aLines, Len( aLines ) + 1 )   /* AIns() drops the last one */
            AIns( aLines, nAbs + 1 )
            aLines[ nAbs + 1 ] := SubStr( cLine, nCol + 1 )
            aLines[ nAbs ] := Left( cLine, nCol )
            IF nRow < nVis - 1
               nRow++
            ELSE
               nTop := HcFixTop( nTop + 1, Len( aLines ), nVis )
            ENDIF
            nCol := 0
            nLft := 0
            /* S2: parting a line is ONE step (two rows become two rows) */
            HcUndoRows( @aHist, @aRedo, nAbs, { cLine }, ;
                        { aLines[ nAbs ], aLines[ nAbs + 1 ] }, ;
                        nRow0, nCol0, nRow, 0 )
            lMod := .T.
            lDraw := .T.
         ENDIF

      CASE nKey == K_BS
         IF lEdit
            HcSelDropEdit( @aHist, @aRedo, @aLines, @aSel, @nTop, @nRow, @nCol, @nLft, @lMod, nVis, nW )
            nAbs := nTop + nRow
            IF nCol > 0
               cOld := aLines[ nAbs ]
               /* S4: the whole CHARACTER before the caret goes, so a two-byte
                * UTF-8 accent is not left as half a sequence */
               nSt := HcCdpPrev( aLines[ nAbs ], nCol, cCdp )
               aLines[ nAbs ] := Stuff( aLines[ nAbs ], nSt + 1, nCol - nSt, "" )
               nCol := nSt
               nLft := HcFixLeft( nCol, nLft, nW )
               HcUndoLine( @aHist, @aRedo, nAbs, cOld, aLines[ nAbs ], ;
                           nRow0, nCol0, nRow, nCol )
               lMod := .T.
            ELSEIF nAbs > 1
               /* join with the line above */
               cOld := aLines[ nAbs - 1 ] + Chr( 13 ) + aLines[ nAbs ]
               aOut := HcLinesCopy( aLines, nAbs - 1, nAbs )
               nCol := Len( aLines[ nAbs - 1 ] )
               aLines[ nAbs - 1 ] += aLines[ nAbs ]
               ADel( aLines, nAbs )
               ASize( aLines, Len( aLines ) - 1 )
               IF nRow > 0
                  nRow--
               ELSE
                  nTop := Max( 1, nTop - 1 )
               ENDIF
               nLft := HcFixLeft( nCol, nLft, nW )
               HcUndoRows( @aHist, @aRedo, nAbs - 1, aOut, ;
                           { aLines[ nAbs - 1 ] }, nRow0, nCol0, nRow, nCol )
               lMod := .T.
            ENDIF
            lDraw := .T.
         ENDIF

      CASE nKey == K_DEL
         IF lEdit
            HcSelDropEdit( @aHist, @aRedo, @aLines, @aSel, @nTop, @nRow, @nCol, @nLft, @lMod, nVis, nW )
            nAbs := nTop + nRow
            IF nCol >= Len( aLines[ nAbs ] )
               /* join with the line below */
               IF nAbs < Len( aLines )
                  aOut := HcLinesCopy( aLines, nAbs, nAbs + 1 )
                  aLines[ nAbs ] += aLines[ nAbs + 1 ]
                  ADel( aLines, nAbs + 1 )
                  ASize( aLines, Len( aLines ) - 1 )
                  HcUndoRows( @aHist, @aRedo, nAbs, aOut, ;
                              { aLines[ nAbs ] }, nRow0, nCol0, nRow, nCol )
                  lMod := .T.
               ENDIF
            ELSE
               cOld := aLines[ nAbs ]
               /* S4: Del takes the whole character at the caret */
               aLines[ nAbs ] := Stuff( aLines[ nAbs ], nCol + 1, ;
                                        HcCdpCharLen( aLines[ nAbs ], nCol, cCdp ), "" )
               HcUndoLine( @aHist, @aRedo, nAbs, cOld, aLines[ nAbs ], ;
                           nRow0, nCol0, nRow, nCol )
               lMod := .T.
            ENDIF
            lDraw := .T.
         ENDIF

      CASE nKey == K_TAB
         IF lEdit
            HcSelDropEdit( @aHist, @aRedo, @aLines, @aSel, @nTop, @nRow, @nCol, @nLft, @lMod, nVis, nW )
            nAbs := nTop + nRow
            /* S80: Tab inserts ALWAYS spaces (user decision), as many as the
             * width detected when the file was opened or set with F8 */
            cOld := aLines[ nAbs ]
            aLines[ nAbs ] := Stuff( aLines[ nAbs ], nCol + 1, 0, Space( nTabW ) )
            nCol += nTabW
            nLft := HcFixLeft( nCol, nLft, nW )
            HcUndoLine( @aHist, @aRedo, nAbs, cOld, aLines[ nAbs ], ;
                        nRow0, nCol0, nRow, nCol )
            lMod := .T.
            lDraw := .T.
         ENDIF

      CASE nKey == K_F8
         /* S80: the indent width is DETECTED from the file, but it can be
          * changed here; the answer is validated by HcTabWidth() */
         IF lEdit
            cIn := UiInput( "Tab width (spaces):", LTrim( Str( nTabW ) ), 2 )
            IF ! hb_IsNIL( cIn )
               nTabW := HcTabWidth( cIn, nTabW )
            ENDIF
            lDraw := .T.
         ENDIF

      /* --- S2 of hc-codepage.md: F6 changes the code page the screen is
       * PAINTED with (cView), in the VIEWER and in the EDITOR. L5: it does not
       * touch the code page of the FILE (cCdp), so in the editor the bytes of
       * the buffer, what is typed into them and what F2 saves keep the file's
       * own code page - F9 is the key that CONVERTS. The buffer is not decoded,
       * nothing is written and lMod is not touched (Esc afterwards does not ask
       * to save anything). The note says what was chosen and the status row adds
       * `>cp` to the chip of the file while the two differ. */
      CASE nKey == K_F6
         aCdp := HcCdpCommon()
         nCdp := AScan( aCdp, cView )
         nCdp := UiPick( aCdp, "Code page", Max( 1, nCdp ) )
         IF ValType( nCdp ) == "N" .AND. nCdp >= 1 .AND. nCdp <= Len( aCdp )
            cView := aCdp[ nCdp ]
            cNote := "View " + cView
         ENDIF
         lDraw := .T.

      /* --- S3 of hc-codepage.md: F9 TRANSFORMS the whole buffer from the code
       * page of the FILE (cCdp) to another one. It exists ONLY in the editor
       * (the read-only viewer has nothing to transform) and it goes right next
       * to K_F6 because it uses the same curated picker. NOTHING is written
       * here: the buffer is converted, the code page of the FILE becomes the
       * target, the VIEW follows it (the screen now paints what the file now
       * is) and the file is marked modified, so F2 saves it and Esc offers to -
       * exactly like every other edit. When the target cannot represent some
       * characters the question is asked ONCE, BEFORE the buffer is touched. A
       * conversion that changes no byte (an ASCII file between two one-byte
       * code pages) marks NOTHING: it only declares the code page of the file
       * and aligns the view with it. */
      CASE nKey == K_F9 .AND. lEdit
         aCdp := HcCdpCommon()
         nCdp := AScan( aCdp, cCdp )
         nCdp := UiPick( aCdp, "Transform from " + cCdp + " to", Max( 1, nCdp ) )
         IF ValType( nCdp ) == "N" .AND. nCdp >= 1 .AND. nCdp <= Len( aCdp )
            cTo := aCdp[ nCdp ]
            IF cTo == cCdp
               /* nothing to do: same code page, no buffer, no disk, no ask -
                * only the view is aligned with the file */
               cView := cTo
               cNote := "Already " + cCdp + "."
            ELSE
               lLoss := .F.
               aConv := HcCdpConvLines( aLines, cCdp, cTo, @lLoss )
               IF HcJoinLines( aConv ) == HcJoinLines( aLines )
                  /* an ASCII file moved between two one-byte code pages converts
                   * to the SAME bytes: nothing was written, so the file is NOT
                   * marked as modified and no undo step is pushed - only the
                   * code pages become the target, view included */
                  cCdp  := cTo
                  cView := cTo
                  cNote := "Nothing to convert."
               ELSE
                  lAsk := ! lLoss
                  IF lLoss
                     lAsk := UiConfirm( "Some characters are not representable in " + ;
                                        cTo + " and become '?'." + hb_eol() + ;
                                        "Transform the buffer to " + cTo + "?", ;
                                        "Code page" )
                  ENDIF
                  IF lAsk
                     /* S2 of editor-undo-redo.md: the whole transform is ONE step.
                      * aUndo is the snapshot of the buffer BEFORE the change - the
                      * same "before" side the bulk actions of the dialog and of the
                      * clipboard hand to HcUndoBulk() - so Ctrl-Z puts every line
                      * back in one go. */
                     aUndo := HcCopyLines( aLines )
                     aLines := aConv
                     cCdp := cTo
                     /* L5: the display follows the file that was just converted */
                     cView := cTo
                     lMod := .T.
                     aSel := NIL
                     aHit := { 0, 0, 0 }
                     nTop := Max( 1, Min( nTop, Len( aLines ) ) )
                     nRow := Max( 0, Min( nRow, Len( aLines ) - nTop ) )
                     nCol := HcCdpSnap( aLines[ nTop + nRow ], nCol, cCdp )
                     nLft := HcFixLeft( nCol, nLft, nW )
                     HcUndoBulk( @aHist, @aRedo, @aUndo, aLines, nRow0, nCol0, nRow, nCol )
                     cNote := "Transformed to " + cCdp
                  ELSE
                     cNote := "Transform cancelled."
                  ENDIF
               ENDIF
            ENDIF
         ENDIF
         lDraw := .T.

      CASE nKey >= 32 .AND. nKey <= 126
         IF lEdit
            HcSelDropEdit( @aHist, @aRedo, @aLines, @aSel, @nTop, @nRow, @nCol, @nLft, @lMod, nVis, nW )
            nAbs := nTop + nRow
            cOld := aLines[ nAbs ]
            /* S4: the key is a byte of the SCREEN code page and the buffer holds
             * the code page of the file, so it is ENCODED first (one byte in an
             * 850 file, two in a UTF-8 one) and the caret advances by what was
             * really inserted */
            cIns := HcCdpKeyChar( nKey, cCdp )
            aLines[ nAbs ] := HcEditorPut( aLines[ nAbs ], nCol, cIns, lOvr, ;
                                           HcCdpCharLen( aLines[ nAbs ], nCol, cCdp ) )
            nCol += Len( cIns )
            nLft := HcFixLeft( nCol, nLft, nW )
            /* S2/S4: one typed character is one step, and a run of them on the
             * same line groups into ONE step (HcUndoPush()) */
            HcUndoLine( @aHist, @aRedo, nAbs, cOld, aLines[ nAbs ], ;
                        nRow0, nCol0, nRow, nCol )
            lMod := .T.
            lDraw := .T.
         ENDIF

      CASE nKey >= 160 .AND. nKey <= 255
         IF lEdit
            HcSelDropEdit( @aHist, @aRedo, @aLines, @aSel, @nTop, @nRow, @nCol, @nLft, @lMod, nVis, nW )
            nAbs := nTop + nRow
            cOld := aLines[ nAbs ]
            cIns := HcCdpKeyChar( nKey, cCdp )
            aLines[ nAbs ] := HcEditorPut( aLines[ nAbs ], nCol, cIns, lOvr, ;
                                           HcCdpCharLen( aLines[ nAbs ], nCol, cCdp ) )
            nCol += Len( cIns )
            nLft := HcFixLeft( nCol, nLft, nW )
            HcUndoLine( @aHist, @aRedo, nAbs, cOld, aLines[ nAbs ], ;
                        nRow0, nCol0, nRow, nCol )
            lMod := .T.
            lDraw := .T.
         ENDIF

      ENDCASE

      /* S7: the selection follows the caret. A MOVEMENT key with SHIFT extends
       * it from where the caret stood (nAbs/nAncCol, read before the move), a
       * plain movement collapses it; the editing keys dropped it in their own
       * branch, and no other key touches it. One rule, here, so the ten
       * movement branches cannot disagree. */
      IF HcNavKey( nKey, nShift ) .AND. lEdit
         aSel := HcSelAfter( aSel, lSh, nAbs, nAncCol, nTop + nRow, nCol )
      ENDIF

      /* S77: the highlighted hit and the `[wrapped]` note belong to the last
       * search only: any other key drops them (a stale position would paint the
       * mark over text that has already moved). The notes of the undo (S6) and
       * of the copy (S7) survive their own key, and the dialog keeps its message
       * because the F7 key is one of these. */
      /* S2 of hc-pretty-print.md: the note of the Alt chord survives its own
       * key too (that key has no code to recognise: lNoteKeep says so) */
      IF ! HcNoteKey( nKey, nShift, lEdit, nWord ) .AND. ! lNoteKeep
         aHit := { 0, 0, 0 }
         cNote := ""
      ENDIF

   ENDDO

   /* S2 of hc-editor-tabs.md: the tab takes its FINAL state with it, so the next
    * `F4` on this file resumes exactly here (the caret, the buffer with the
    * changes it still has, the code pages, the histories). A close that left the
    * session empty has no tab to write, which is why this is guarded. */
   IF ! lTabDrop
      HcTabStore( HcTabAt( aTabs, s_nHcEditSel ), aLines, nTop, nRow, nCol, nLft, ;
                  lMod, lOvr, cCdp, cView, nTabW, aSel, aHist, aRedo, aUndo, ;
                  aHit, cNote, cLastFind )
   ENDIF

   /* S102: the hook is removed only when this screen installed it */
   IF lHookMine
      HcMouseHook( .F. )
      s_lHcHook := .F.
      lHookMine := .F.
   ENDIF

   SetCursor( cPrev )
   SetColor( UI_C_DESKTOP )
RETURN

/* =====================================================================
 *  S77 -- F7 / Ctrl-F (search) in the Text viewer and the Text editor
 *
 *  The two full-screen screens of S5 (`HcFileScreen`, view and edit) get the
 *  same search the hex viewer and the read-only record browser already have
 *  (S62/S69): F7 or Ctrl-F asks for the text, jumps to the first hit at or
 *  after the caret, wraps ONCE around the end of the buffer (the status row
 *  then says `[wrapped]`) and says `Not found.` in a box when there is none.
 *  The input is prefilled with the last query, so pressing Enter again means
 *  "find the next one" - the same convention as the hex viewer.
 *
 *  It is only for TEXT: a binary file never reaches this screen, it opens the
 *  hex viewer (`HcView`, S61) or the record browser (S68).
 *
 *  The search does NOT touch the buffer: it moves the caret and, when the file
 *  is edited, nothing is marked as modified. Both rules are the PURE part here
 *  (`HcTextFindKey` and `HcTextFind`), which is what the headless bank checks.
 * ===================================================================== */

/* S77: did this key ask for a search? PURE (the modifier state is passed in) so
 * the headless bank checks the whole rule without a window. K_CTRL_F and K_END
 * are the SAME code 6 (trap 37), and the CTRL bit is what tells them apart, the
 * same trick the record browser uses: read it IMMEDIATELY after Inkey(). */
FUNCTION HcTextFindKey( nKey, nShift )
   IF ValType( nKey ) != "N"
      RETURN .F.
   ENDIF
   IF nKey == K_F7
      RETURN .T.
   ENDIF
RETURN nKey == K_CTRL_F .AND. DbfShiftOn( nShift, HB_GTI_KBD_CTRL )

/* S77: PURE substring search of the viewer/editor buffer. aLines is the line
 * array the screen paints, cText the query (case-insensitive) and nLine/nCol the
 * position where the search STARTS (1-based line, 0-based column): the answer is
 * the first hit that begins AT or AFTER that position, as { line, column } in
 * the same units, or { 0, 0 } when the text is not there.
 * It never wraps by itself: the caller wraps so the `[wrapped]` note is its
 * decision. An empty query never matches, and a query of spaces is a real query
 * (Len(), never Empty(): trap 46). At() of this build takes no start offset, so
 * the tail of the line is searched and the offset added back. */
FUNCTION HcTextFind( aLines, cText, nLine, nCol )
   LOCAL i, cWhat, nAt, nFrom
   IF ! HB_ISARRAY( aLines ) .OR. ValType( cText ) != "C" .OR. Len( cText ) == 0
      RETURN { 0, 0 }
   ENDIF
   IF ValType( nLine ) != "N" .OR. nLine < 1
      nLine := 1
   ENDIF
   IF ValType( nCol ) != "N" .OR. nCol < 0
      nCol := 0
   ENDIF
   cWhat := Upper( cText )
   FOR i := nLine TO Len( aLines )
      IF ValType( aLines[ i ] ) != "C"
         LOOP
      ENDIF
      nFrom := iif( i == nLine, Min( nCol, Len( aLines[ i ] ) ), 0 )
      nAt := At( cWhat, Upper( SubStr( aLines[ i ], nFrom + 1 ) ) )
      IF nAt > 0
         RETURN { i, nFrom + nAt - 1 }
      ENDIF
   NEXT
RETURN { 0, 0 }

/* =====================================================================
 *  S82..S84 -- Find & Replace engine of the Text editor
 *
 *  The engine is PURE over ( aLines, matcher, options, scope ) and lives
 *  here, so the headless bank checks the whole rule without a window and the
 *  future Files > Find and Replace (S9) reuses it unchanged: the dialog only
 *  drives it, and knows nothing about the editor's locals or its buffer.
 *
 *    HcMatcher()      one query -> matcher array (the regex is compiled ONCE)
 *    HcLineMatches()  one line  -> { 0-based start, length, groups } of every
 *                       match, left to right and non-overlapping
 *    HcWordOk()       is one hit a whole word? ([A-Za-z0-9_] at both sides)
 *    HcFindScope()    options + caret + selection -> the { L1, C1, L2, C2 }
 *                       rectangle the search may not leave
 *    HcFindNext()     the next hit, in one direction, wrapping once inside
 *                       the same scope
 *    HcReplaceLine()  one hit -> the line with that hit replaced
 *    HcReplaceAll()   the whole scope -> a NEW buffer and the number of hits
 *
 *  Two measured facts shape it (feature doc, L2). The regex API of this build
 *  (hbrtl, no REQUEST) is
 *
 *    hb_regexComp( cPat, lCaseSensitive ) -> pointer, NIL when it is invalid
 *    hb_regexAll( pRe, cString, .T., .F., 0, 0, .F. )
 *         -> per match, { text, start, end } per group, 1-BASED and with the
 *            end INCLUSIVE (length = end - start + 1); {} when there is no
 *            match, and a runtime error if it is handed a pattern that does
 *            not compile - which is why the handle is compiled here, once,
 *            and never per line.
 *
 *  A match of length ZERO is dropped: replacing it would insert text without
 *  consuming any, so it has no place to advance to. And because the engine
 *  searches the TAIL of the line for the following matches (there is no
 *  NOTBOL), a pattern that starts with `^` would also match after every hit;
 *  HcReAnchored() is what limits it to column 0 of the line.
 * ===================================================================== */

/* S82: a flag of the options array (HF_*). A missing entry is OFF, so a
 * caller that only sets the two or three flags it cares about is valid. */
FUNCTION HcOptOn( aOpt, nId )
   IF ! HB_ISARRAY( aOpt ) .OR. ValType( nId ) != "N" .OR. nId < 1 .OR. nId > Len( aOpt )
      RETURN .F.
   ENDIF
RETURN ValType( aOpt[ nId ] ) == "L" .AND. aOpt[ nId ]

/* S82: the options array with all eight slots present, copied from aOpt when it
 * is one (Array( 8, x ) does NOT fill: trap 26). The engine never writes into
 * the caller's array, so turning a flag on locally is always a copy. */
FUNCTION HcOptNew( aOpt )
   LOCAL aNew := { .F., .F., .F., .F., .F., .F., "", "" }, i
   IF HB_ISARRAY( aOpt )
      FOR i := 1 TO Min( Len( aOpt ), Len( aNew ) )
         aNew[ i ] := aOpt[ i ]
      NEXT
   ENDIF
RETURN aNew

/* S83: a selection -> the { L1, C1, L2, C2 } rectangle, in reading order and
 * whatever order the two ends were given in, or {} when there is no text
 * selected (an empty selection is not a selection). It is the same shape and
 * the same units the scope of the search uses, so `In selection` is a copy.
 * S85: the rule itself lives in HcSelNorm() and this is the engine's view of it
 * (an empty ARRAY instead of NIL), so the editor and the search can never
 * disagree about what is selected. */
FUNCTION HcScopeNorm( aSel )
   LOCAL aS := HcSelNorm( NIL, aSel )
   IF ! HB_ISARRAY( aS )
      RETURN {}
   ENDIF
RETURN aS

/* S82: the query -> matcher array { query, case, word, regex, handle, bad }.
 * The regex is compiled ONCE, here, and the pointer travels in the array (a
 * pattern per line would be thousands of compilations for one search).
 * `Whole words only` is normalised OFF in regex mode: in a regex the word
 * boundaries are the pattern's own business (\b), and applying the literal
 * rule on top of it would fight it. An empty or invalid pattern sets the BAD
 * flag instead of throwing: `hb_regexComp` answers NIL for an invalid one but
 * a runtime Argument error for an empty one (measured, L2). */
FUNCTION HcMatcher( cWhat, lCase, lWord, lRe )
   LOCAL aMt, pRe, lOk := .F.
   IF ValType( cWhat ) != "C"
      cWhat := ""
   ENDIF
   lRe := ValType( lRe ) == "L" .AND. lRe
   aMt := { cWhat, ValType( lCase ) == "L" .AND. lCase, ;
            ValType( lWord ) == "L" .AND. lWord, lRe, NIL, .F. }
   IF ! lRe
      RETURN aMt
   ENDIF
   aMt[ HM_WORD ] := .F.
   IF Len( cWhat ) == 0
      aMt[ HM_BAD ] := .T.
      RETURN aMt
   ENDIF
   BEGIN SEQUENCE WITH {| o | Break( o ) }
      pRe := hb_regexComp( cWhat, aMt[ HM_CASE ] )
      lOk := HB_ISPOINTER( pRe ) .AND. ! Empty( pRe )
   RECOVER
      lOk := .F.
   END SEQUENCE
   IF lOk
      aMt[ HM_HANDLE ] := pRe
   ELSE
      aMt[ HM_BAD ] := .T.
   ENDIF
RETURN aMt

/* S82: does this pattern anchor itself to the start of the line? A leading `^`
 * is an anchor for the reader, but hb_regexAll() searches the tail of the
 * string for the following matches without NOTBOL, so it would report another
 * match right after every hit (measured: `^a` on "aa" gives two, L2.6). The
 * leading inline flags of PCRE - (?i), (?-i)a, (?m) - are skipped, because
 * they come before the anchor. */
FUNCTION HcReAnchored( cPat )
   LOCAL c := cPat, nEnd
   IF ValType( cPat ) != "C"
      RETURN .F.
   ENDIF
   DO WHILE Left( c, 2 ) == "(?"
      nEnd := At( ")", c )
      IF nEnd == 0
         EXIT
      ENDIF
      c := SubStr( c, nEnd + 1 )
   ENDDO
RETURN Left( c, 1 ) == "^"

/* S82: is the character a word character? The set is the one S4 names, nothing
 * else (an accented byte is NOT a word character). */
FUNCTION HcIsWordCh( cCh )
   IF ValType( cCh ) != "C" .OR. Len( cCh ) != 1
      RETURN .F.
   ENDIF
RETURN cCh $ "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_"

/* S82: `Whole words only` for a hit of the LITERAL path: neither the character
 * before it nor the one after it may be a word character, so `start` is not a
 * word inside `starter`, `mystart` or `_start`, and it is one in `(start)` and
 * `start.`. The ends of the line are not word characters. */
FUNCTION HcWordOk( cLine, nStart0, nLen )
   IF ValType( cLine ) != "C" .OR. ValType( nStart0 ) != "N" .OR. ValType( nLen ) != "N"
      RETURN .F.
   ENDIF
   IF nStart0 > 0 .AND. HcIsWordCh( SubStr( cLine, nStart0, 1 ) )
      RETURN .F.
   ENDIF
RETURN ! HcIsWordCh( SubStr( cLine, nStart0 + nLen + 1, 1 ) )

/* S82: every match of one line as { 0-based start, length, { whole, $1.. } },
 * left to right and NON-overlapping (so `aa` in `aaaa` is two hits, not three).
 * The regex path asks the engine for all the matches of the line at once; the
 * literal path walks the line with At() - which in this build takes no start
 * offset (trap), so the tail is searched and the offset added back. A case the
 * engine refuses to compile gives no hits at all instead of throwing. */
FUNCTION HcLineMatches( cLine, aMt )
   LOCAL aOut := {}, cWhat, cHay, cFind, nFrom, nAt, nLen
   IF ValType( cLine ) != "C" .OR. ! HB_ISARRAY( aMt ) .OR. Len( aMt ) < HM_BAD
      RETURN aOut
   ENDIF
   IF aMt[ HM_RE ] == .T.
      IF aMt[ HM_BAD ] .OR. ! HB_ISPOINTER( aMt[ HM_HANDLE ] )
         RETURN aOut
      ENDIF
      RETURN HcReMatches( cLine, aMt )
   ENDIF
   cWhat := aMt[ HM_PAT ]
   IF ValType( cWhat ) != "C" .OR. Len( cWhat ) == 0
      RETURN aOut
   ENDIF
   nLen  := Len( cWhat )
   cFind := iif( aMt[ HM_CASE ], cWhat, Upper( cWhat ) )
   cHay  := iif( aMt[ HM_CASE ], cLine, Upper( cLine ) )
   nFrom := 0
   DO WHILE nFrom + nLen <= Len( cHay )
      nAt := At( cFind, SubStr( cHay, nFrom + 1 ) )
      IF nAt == 0
         EXIT
      ENDIF
      nAt := nFrom + nAt - 1
      IF aMt[ HM_WORD ] .AND. ! HcWordOk( cLine, nAt, nLen )
         /* the candidate is inside a bigger word: the next one may start one
          * character later (`starter` still holds `start`) */
         nFrom := nAt + 1
         LOOP
      ENDIF
      AAdd( aOut, { nAt, nLen, {} } )
      nFrom := nAt + nLen
   ENDDO
RETURN aOut

/* S82: the regex half of HcLineMatches(). One call gives every match of the
 * line with its positions; the groups of each match become the `{ whole, $1.. }`
 * array HcReplaceExpr() expands, so a `$` in the replacement does not depend on
 * a second search. */
FUNCTION HcReMatches( cLine, aMt )
   LOCAL aOut := {}, aAll := {}, aOne, aGrp, i, j, nStart0, nLen, lAnch
   lAnch := HcReAnchored( aMt[ HM_PAT ] )
   BEGIN SEQUENCE WITH {| o | Break( o ) }
      aAll := hb_regexAll( aMt[ HM_HANDLE ], cLine, .T., .F., 0, 0, .F. )
   RECOVER
      aAll := {}
   END SEQUENCE
   IF ! HB_ISARRAY( aAll )
      RETURN aOut
   ENDIF
   FOR i := 1 TO Len( aAll )
      aOne := aAll[ i ]
      IF ! HB_ISARRAY( aOne ) .OR. Len( aOne ) < 1 .OR. ! HB_ISARRAY( aOne[ 1 ] )
         LOOP
      ENDIF
      IF ValType( aOne[ 1 ][ 2 ] ) != "N" .OR. ValType( aOne[ 1 ][ 3 ] ) != "N"
         LOOP
      ENDIF
      nStart0 := aOne[ 1 ][ 2 ] - 1
      nLen    := aOne[ 1 ][ 3 ] - aOne[ 1 ][ 2 ] + 1
      IF nLen <= 0
         LOOP             /* a zero length match has nowhere to advance to */
      ENDIF
      IF lAnch .AND. nStart0 != 0
         EXIT             /* `^` is the start of the LINE (L2.6) */
      ENDIF
      aGrp := {}
      FOR j := 1 TO Len( aOne )
         AAdd( aGrp, iif( HB_ISARRAY( aOne[ j ] ) .AND. ValType( aOne[ j ][ 1 ] ) == "C", ;
                          aOne[ j ][ 1 ], "" ) )
      NEXT
      AAdd( aOut, { nStart0, nLen, aGrp } )
   NEXT
RETURN aOut

/* S83: the rectangle the search may not leave, from the options, the caret and
 * the selection. `In selection` wins when it is on AND there is something
 * selected (an `In selection` with an empty selection would search nowhere, so
 * it falls back to the normal scope). `Whole document` on means the whole
 * buffer - that is also the only case that wraps (S4); off means from the caret
 * to the end of the buffer, or from the start of the buffer to the caret when
 * the search is Backwards. */
FUNCTION HcFindScope( aLines, nLine, nCol, aOpt, aSel )
   LOCAL aSc, nTot := 0, nLast := 0
   IF HB_ISARRAY( aLines )
      nTot := Len( aLines )
      IF nTot > 0 .AND. ValType( aLines[ nTot ] ) == "C"
         nLast := Len( aLines[ nTot ] )
      ENDIF
   ENDIF
   IF HcOptOn( aOpt, HF_INSEL )
      aSc := HcScopeNorm( aSel )
      IF Len( aSc ) == HS_C2          /* 4: a real rectangle, see HcScopeNorm */
         RETURN aSc
      ENDIF
   ENDIF
   IF ValType( nLine ) != "N" .OR. nLine < 1
      nLine := 1
   ENDIF
   IF nTot > 0
      nLine := Min( nLine, nTot )
   ENDIF
   IF ValType( nCol ) != "N" .OR. nCol < 0
      nCol := 0
   ENDIF
   IF HcOptOn( aOpt, HF_WHOLE )
      RETURN { 1, 0, nTot, nLast }
   ENDIF
   IF HcOptOn( aOpt, HF_BACK )
      RETURN { 1, 0, nLine, nCol }
   ENDIF
RETURN { nLine, nCol, nTot, nLast }

/* S83: does this hit fit ENTIRELY inside the scope? On the last line of the
 * scope that means `start + length <= C2`, so a hit that only half fits is
 * rejected - never truncated and never taken from beyond the selection. */
FUNCTION HcInScope( nLine, nStart0, nLen, aScope )
   IF ! HB_ISARRAY( aScope ) .OR. Len( aScope ) < HS_C2
      RETURN .F.
   ENDIF
   IF ValType( nLine ) != "N" .OR. ValType( nStart0 ) != "N" .OR. ValType( nLen ) != "N"
      RETURN .F.
   ENDIF
   IF ValType( aScope[ HS_L1 ] ) != "N" .OR. ValType( aScope[ HS_C1 ] ) != "N" .OR. ;
      ValType( aScope[ HS_L2 ] ) != "N" .OR. ValType( aScope[ HS_C2 ] ) != "N"
      RETURN .F.
   ENDIF
   IF nLine < aScope[ HS_L1 ] .OR. nLine > aScope[ HS_L2 ]
      RETURN .F.
   ENDIF
   IF nLine == aScope[ HS_L1 ] .AND. nStart0 < aScope[ HS_C1 ]
      RETURN .F.
   ENDIF
   IF nLine == aScope[ HS_L2 ] .AND. nStart0 + nLen > aScope[ HS_C2 ]
      RETURN .F.
   ENDIF
RETURN .T.

/* S83: every hit of the scope in reading order, as { line, start0, length,
 * groups }. It is what both directions of HcFindNext() read, so going forward
 * and going backwards can never disagree about where a hit is. */
FUNCTION HcScopeMatches( aLines, aMt, aScope )
   LOCAL aOut := {}, aM, i, j
   IF ! HB_ISARRAY( aLines ) .OR. ! HB_ISARRAY( aScope ) .OR. Len( aScope ) < HS_C2
      RETURN aOut
   ENDIF
   IF ValType( aScope[ HS_L1 ] ) != "N" .OR. ValType( aScope[ HS_L2 ] ) != "N"
      RETURN aOut
   ENDIF
   FOR i := Max( 1, aScope[ HS_L1 ] ) TO Min( Len( aLines ), aScope[ HS_L2 ] )
      IF ValType( aLines[ i ] ) != "C"
         LOOP
      ENDIF
      aM := HcLineMatches( aLines[ i ], aMt )
      FOR j := 1 TO Len( aM )
         IF HcInScope( i, aM[ j ][ HM_START ], aM[ j ][ HM_LEN ], aScope )
            AAdd( aOut, { i, aM[ j ][ HM_START ], aM[ j ][ HM_LEN ], aM[ j ][ HM_GROUPS ] } )
         ENDIF
      NEXT
   NEXT
RETURN aOut

/* S83: the next hit from ( nLine, nCol ) - 1-based line, 0-based column - in
 * the direction of `Backwards`, inside the scope only. The answer is
 * { line, column, length, groups, wrapped } or { 0, 0, 0, {}, .F. }.
 *
 * Forward takes a hit that starts AT or AFTER the caret and backwards one that
 * starts BEFORE it: that is what makes pressing the key again move instead of
 * returning the same hit, because the dialog leaves the caret on the hit it
 * just found. When `Whole document` is on and the direction runs out, the
 * search wraps ONCE inside the same scope and says so, so the dialog can print
 * `[wrapped]`. */
FUNCTION HcFindNext( aLines, aMt, aOpt, aSel, nLine, nCol )
   LOCAL aSc, aAll, i, nPick := 0, lBack, lWrapped := .F.
   IF ValType( nLine ) != "N" .OR. nLine < 1
      nLine := 1
   ENDIF
   IF ValType( nCol ) != "N" .OR. nCol < 0
      nCol := 0
   ENDIF
   aSc  := HcFindScope( aLines, nLine, nCol, aOpt, aSel )
   aAll := HcScopeMatches( aLines, aMt, aSc )
   IF Len( aAll ) == 0
      RETURN { 0, 0, 0, {}, .F. }
   ENDIF
   lBack := HcOptOn( aOpt, HF_BACK )
   IF lBack
      FOR i := Len( aAll ) TO 1 STEP -1
         IF aAll[ i ][ 1 ] < nLine .OR. ;
            ( aAll[ i ][ 1 ] == nLine .AND. aAll[ i ][ 2 ] < nCol )
            nPick := i
            EXIT
         ENDIF
      NEXT
   ELSE
      FOR i := 1 TO Len( aAll )
         IF aAll[ i ][ 1 ] > nLine .OR. ;
            ( aAll[ i ][ 1 ] == nLine .AND. aAll[ i ][ 2 ] >= nCol )
            nPick := i
            EXIT
         ENDIF
      NEXT
   ENDIF
   IF nPick == 0
      IF ! HcOptOn( aOpt, HF_WHOLE )
         RETURN { 0, 0, 0, {}, .F. }
      ENDIF
      nPick    := iif( lBack, Len( aAll ), 1 )
      lWrapped := .T.
   ENDIF
RETURN { aAll[ nPick ][ 1 ], aAll[ nPick ][ 2 ], aAll[ nPick ][ 3 ], ;
         aAll[ nPick ][ 4 ], lWrapped }

/* S84: one group of a match, or "" when the pattern has no such group (a `$5`
 * in a pattern with two groups must not leave the text `$5` behind). The array
 * is the one the engine answers - element 1 is the WHOLE match - so `$1` is
 * element 2 here; HcReplaceExpr() does that shift. */
FUNCTION HcGroupAt( aGroups, nId )
   IF ! HB_ISARRAY( aGroups ) .OR. ValType( nId ) != "N" .OR. nId < 1 .OR. nId > Len( aGroups )
      RETURN ""
   ENDIF
RETURN iif( ValType( aGroups[ nId ] ) == "C", aGroups[ nId ], "" )

/* S84: the replacement text of a REGEX substitution: `$1`..`$9` are the groups
 * of that match, `$0` and `&` are the whole match, `$$` is a literal dollar and
 * a `$` before anything else stays literal (`$x`, and a `$` at the end). A
 * group the pattern does not have expands to nothing. Pure, so the bank pins
 * every one of those cases. */
FUNCTION HcReplaceExpr( cRepl, aGroups )
   LOCAL cOut := "", cCh, cNext, i := 1
   IF ValType( cRepl ) != "C"
      RETURN ""
   ENDIF
   DO WHILE i <= Len( cRepl )
      cCh := SubStr( cRepl, i, 1 )
      IF cCh == "&"
         cOut += HcGroupAt( aGroups, 1 )
         i++
      ELSEIF cCh == "$"
         cNext := SubStr( cRepl, i + 1, 1 )
         IF cNext == "$"
            cOut += "$"
            i += 2
         ELSEIF Len( cNext ) == 1 .AND. cNext $ "0123456789"
            /* `$0` is the whole match (element 1) and `$1` is the first group
             * (element 2): the array keeps the whole match in front */
            cOut += HcGroupAt( aGroups, iif( cNext == "0", 1, Val( cNext ) + 1 ) )
            i += 2
         ELSE
            cOut += "$"
            i++
         ENDIF
      ELSE
         cOut += cCh
         i++
      ENDIF
   ENDDO
RETURN cOut

/* S84: the line with ONE hit replaced. Literal mode inserts the replacement
 * verbatim; regex mode expands it (`$1`, `&`, see HcReplaceExpr). The hit is
 * the { start0, length, groups } HcLineMatches/HcFindNext answered, and the
 * length is the one of the ORIGINAL text, so the rest of the line stays right
 * even when the replacement is longer. */
FUNCTION HcReplaceLine( cLine, aMt, aMatch, cRepl )
   LOCAL nStart, nLen, cNew, aGroups
   IF ValType( cLine ) != "C" .OR. ! HB_ISARRAY( aMatch ) .OR. Len( aMatch ) < HM_LEN
      RETURN cLine
   ENDIF
   IF ValType( aMatch[ HM_START ] ) != "N" .OR. ValType( aMatch[ HM_LEN ] ) != "N"
      RETURN cLine
   ENDIF
   nStart := aMatch[ HM_START ]
   nLen   := aMatch[ HM_LEN ]
   IF nStart < 0 .OR. nLen < 0 .OR. nStart + nLen > Len( cLine )
      RETURN cLine
   ENDIF
   IF ValType( cRepl ) != "C"
      cRepl := ""
   ENDIF
   aGroups := iif( Len( aMatch ) >= HM_GROUPS, aMatch[ HM_GROUPS ], {} )
   IF HB_ISARRAY( aMt ) .AND. Len( aMt ) >= HM_RE .AND. aMt[ HM_RE ] == .T.
      cNew := HcReplaceExpr( cRepl, aGroups )
   ELSE
      cNew := cRepl
   ENDIF
RETURN SubStr( cLine, 1, nStart ) + cNew + SubStr( cLine, nStart + nLen + 1 )

/* S84: Replace All -> { NEW buffer, number of hits replaced }. The caller's
 * array is never written (it is a copy), and the matches are the ones of the
 * ORIGINAL lines while the text is assembled with a running "already copied"
 * column, so a replacement is never rescanned: `a` -> `aa` does not loop and a
 * longer replacement does not shift the following hits. Every hit obeys the
 * same scope rule as the search, and Replace All works on the whole buffer (or
 * on the selection), never on the half of the file left by the caret. */
FUNCTION HcReplaceAll( aLines, aMt, aOpt, aSel, cRepl )
   LOCAL aOut := {}, aOp, aSc, aM, i, j, nCount := 0, cLine, cNew, nCopied, nL1, nL2
   IF ! HB_ISARRAY( aLines )
      RETURN { aOut, 0 }
   ENDIF
   FOR i := 1 TO Len( aLines )
      AAdd( aOut, aLines[ i ] )
   NEXT
   IF ValType( cRepl ) != "C"
      cRepl := ""
   ENDIF
   aOp := HcOptNew( aOpt )
   aOp[ HF_WHOLE ] := .T.
   aSc := HcFindScope( aLines, 1, 0, aOp, aSel )
   IF ! HB_ISARRAY( aSc ) .OR. Len( aSc ) < HS_C2
      RETURN { aOut, 0 }
   ENDIF
   IF ValType( aSc[ HS_L1 ] ) != "N" .OR. ValType( aSc[ HS_L2 ] ) != "N"
      RETURN { aOut, 0 }
   ENDIF
   nL1 := Max( 1, aSc[ HS_L1 ] )
   nL2 := Min( Len( aOut ), aSc[ HS_L2 ] )
   FOR i := nL1 TO nL2
      IF ValType( aOut[ i ] ) != "C"
         LOOP
      ENDIF
      cLine := aOut[ i ]
      aM    := HcLineMatches( cLine, aMt )
      cNew     := ""
      nCopied  := 0
      FOR j := 1 TO Len( aM )
         IF ! HcInScope( i, aM[ j ][ HM_START ], aM[ j ][ HM_LEN ], aSc )
            LOOP
         ENDIF
         cNew    += SubStr( cLine, nCopied + 1, aM[ j ][ HM_START ] - nCopied )
         IF HB_ISARRAY( aMt ) .AND. Len( aMt ) >= HM_RE .AND. aMt[ HM_RE ] == .T.
            cNew += HcReplaceExpr( cRepl, aM[ j ][ HM_GROUPS ] )
         ELSE
            cNew += cRepl
         ENDIF
         nCopied := aM[ j ][ HM_START ] + aM[ j ][ HM_LEN ]
         nCount++
      NEXT
      IF nCopied > 0
         aOut[ i ] := cNew + SubStr( cLine, nCopied + 1 )
      ENDIF
   NEXT
RETURN { aOut, nCount }

/* =====================================================================
 *  S7 / S85 -- the SELECTION MODEL of the editor
 *
 *  A selection travels as { line1, col1, line2, col2 } with 1-based lines and
 *  0-based columns, the same shape and units as the scope of the engine above,
 *  so `In selection` is a copy of it. The two ends are stored as the user gave
 *  them: the ANCHOR stays in slots 1/2 while HcSelExtend() moves the other end
 *  over it, which is what lets a selection be built backwards. Reading order is
 *  what HcSelNorm() answers, and every function here goes through it, so there
 *  is ONE normaliser and the editor cannot disagree with the search engine
 *  about what is selected (HcScopeNorm() is that same rule).
 *
 *    HcSelNorm()    the two ends in reading order, or NIL
 *    HcSelEmpty()   is there nothing selected?
 *    HcSelSpan()    the { from, to } of one line, 0-based, `to` EXCLUSIVE
 *    HcSelText()    the selected text with the lines joined by CRLF
 *    HcSelChars()   how many characters, one per line break
 *    HcSelExtend()  the selection with its moving end replaced
 *    HcSelDrop()    the buffer without the selection, and the new caret
 *
 *  No colour is spent here (§4): the editor paints the selection with the two
 *  colours of the row swapped (UiSwapColor()).
 * ===================================================================== */

/* S85: the norm. Whatever order the two ends were given in, the answer is
 * { L1, C1, L2, C2 } in READING order, or NIL when aSel is not a selection at
 * all: NIL, something that is not an array, a bad type in any slot, a line
 * below 1, a negative column, or two ends that collapse to nothing (a click
 * without dragging). When aLines is an array the selection is additionally held
 * inside the buffer: one that starts past the last line is not usable and the
 * end column cannot run past the line it lands on. HcScopeNorm() passes NIL and
 * turns the NIL into its own empty array, so the search engine keeps exactly the
 * rule it always had. */
FUNCTION HcSelNorm( aLines, aSel )
   LOCAL nL1, nC1, nL2, nC2, nTmp, nTot := 0
   IF ! HB_ISARRAY( aSel ) .OR. Len( aSel ) < HS_C2
      RETURN NIL
   ENDIF
   IF ValType( aSel[ HS_L1 ] ) != "N" .OR. ValType( aSel[ HS_C1 ] ) != "N" .OR. ;
      ValType( aSel[ HS_L2 ] ) != "N" .OR. ValType( aSel[ HS_C2 ] ) != "N"
      RETURN NIL
   ENDIF
   nL1 := Int( aSel[ HS_L1 ] )
   nC1 := Int( aSel[ HS_C1 ] )
   nL2 := Int( aSel[ HS_L2 ] )
   nC2 := Int( aSel[ HS_C2 ] )
   IF nL1 < 1 .OR. nL2 < 1 .OR. nC1 < 0 .OR. nC2 < 0
      RETURN NIL
   ENDIF
   IF nL2 < nL1 .OR. ( nL2 == nL1 .AND. nC2 < nC1 )
      nTmp := nL1
      nL1  := nL2
      nL2  := nTmp
      nTmp := nC1
      nC1  := nC2
      nC2  := nTmp
   ENDIF
   IF HB_ISARRAY( aLines )
      nTot := Len( aLines )
      IF nL1 > nTot
         RETURN NIL                 /* it starts past the end of the buffer */
      ENDIF
      nL2 := Min( nL2, nTot )
      IF ValType( aLines[ nL1 ] ) == "C"
         nC1 := Min( nC1, Len( aLines[ nL1 ] ) )
      ENDIF
      IF ValType( aLines[ nL2 ] ) == "C"
         nC2 := Min( nC2, Len( aLines[ nL2 ] ) )
      ENDIF
   ENDIF
   IF nL1 == nL2 .AND. nC1 == nC2
      RETURN NIL
   ENDIF
RETURN { nL1, nC1, nL2, nC2 }

/* S85: is there nothing selected? NIL, something that is not an array, or two
 * ends on the same cell - the state after a click that did not drag. */
FUNCTION HcSelEmpty( aSel )
   IF ! HB_ISARRAY( aSel ) .OR. Len( aSel ) < HS_C2
      RETURN .T.
   ENDIF
   IF ValType( aSel[ HS_L1 ] ) != "N" .OR. ValType( aSel[ HS_C1 ] ) != "N" .OR. ;
      ValType( aSel[ HS_L2 ] ) != "N" .OR. ValType( aSel[ HS_C2 ] ) != "N"
      RETURN .T.
   ENDIF
RETURN Int( aSel[ HS_L1 ] ) == Int( aSel[ HS_L2 ] ) .AND. ;
       Int( aSel[ HS_C1 ] ) == Int( aSel[ HS_C2 ] )

/* S85: the span of the selection on ONE 1-based line, as { from, to } with
 * 0-based columns and `to` EXCLUSIVE, or NIL when that line holds no selected
 * text. The first line runs from its column to the end of the line, the ones in
 * between are whole, and the last one stops at its column - so a selection that
 * ENDS at column 0 of a line does not paint that line at all, which is how
 * `Shift+Down` from the start of a line reads on screen. `to` is HC_SEL_EOL
 * when the span runs to the end of the line: this function has no text in hand,
 * so the painter (which does) turns that into Len( cLine ). */
FUNCTION HcSelSpan( aSel, nLine )
   LOCAL aN, nFrom, nTo
   aN := HcSelNorm( NIL, aSel )
   IF ! HB_ISARRAY( aN ) .OR. ValType( nLine ) != "N"
      RETURN NIL
   ENDIF
   nLine := Int( nLine )
   IF nLine < aN[ HS_L1 ] .OR. nLine > aN[ HS_L2 ]
      RETURN NIL
   ENDIF
   nFrom := iif( nLine == aN[ HS_L1 ], aN[ HS_C1 ], 0 )
   nTo   := iif( nLine == aN[ HS_L2 ], aN[ HS_C2 ], HC_SEL_EOL )
   IF nTo != HC_SEL_EOL .AND. nTo <= nFrom
      RETURN NIL                  /* the line ends where the selection starts */
   ENDIF
RETURN { nFrom, nTo }

/* S85: the selected text as ONE string, the lines joined with CRLF - that is
 * exactly what Ctrl-C puts on the Windows clipboard (S7). The trailing spaces of
 * every line are trimmed (RTrim), the LEADING spaces of the middle lines are
 * not: the text has to read the way it reads in the file. "" when there is no
 * selection. */
FUNCTION HcSelText( aLines, aSel )
   LOCAL aN, i, cOut, cLine
   IF ! HB_ISARRAY( aLines )
      RETURN ""
   ENDIF
   aN := HcSelNorm( aLines, aSel )
   IF ! HB_ISARRAY( aN )
      RETURN ""
   ENDIF
   cLine := iif( ValType( aLines[ aN[ HS_L1 ] ] ) == "C", aLines[ aN[ HS_L1 ] ], "" )
   IF aN[ HS_L1 ] == aN[ HS_L2 ]
      RETURN RTrim( SubStr( cLine, aN[ HS_C1 ] + 1, aN[ HS_C2 ] - aN[ HS_C1 ] ) )
   ENDIF
   cOut := RTrim( SubStr( cLine, aN[ HS_C1 ] + 1 ) )
   FOR i := aN[ HS_L1 ] + 1 TO aN[ HS_L2 ]
      cOut += Chr( 13 ) + Chr( 10 )
      cLine := iif( ValType( aLines[ i ] ) == "C", aLines[ i ], "" )
      cOut += RTrim( iif( i == aN[ HS_L2 ], SubStr( cLine, 1, aN[ HS_C2 ] ), cLine ) )
   NEXT
RETURN cOut

/* S85: how many characters the selection covers, counting ONE per line break
 * (S7: the status row prints Sel(n)). The count is of the text the BUFFER has,
 * so a line selected whole counts its trailing spaces while the clipboard text
 * does not: the status row says how much is selected and HcSelText() says what
 * is copied. The per-line spans come from HcSelSpan(), so the count can never
 * disagree with what the screen paints. */
FUNCTION HcSelChars( aLines, aSel )
   LOCAL aN, i, nTot := 0, aSp, cLine
   IF ! HB_ISARRAY( aLines )
      RETURN 0
   ENDIF
   aN := HcSelNorm( aLines, aSel )
   IF ! HB_ISARRAY( aN )
      RETURN 0
   ENDIF
   FOR i := aN[ HS_L1 ] TO aN[ HS_L2 ]
      aSp := HcSelSpan( aN, i )
      IF HB_ISARRAY( aSp )
         cLine := iif( ValType( aLines[ i ] ) == "C", aLines[ i ], "" )
         nTot += iif( aSp[ 2 ] == HC_SEL_EOL, Len( cLine ) - aSp[ 1 ], aSp[ 2 ] - aSp[ 1 ] )
      ENDIF
   NEXT
RETURN nTot + ( aN[ HS_L2 ] - aN[ HS_L1 ] )

/* S85: the selection with its MOVING end replaced by ( nLine, nCol ). The
 * anchor is the end the user started from: while a selection exists it already
 * lives in slots 1/2 - that is the shape this function leaves behind - so the
 * caller passes NIL/0 for it; on the first extension there is no aSel yet and
 * the anchor arrives in the two arguments. The answer is NOT normalised: the
 * moving end may be above and to the left of the anchor (dragging backwards),
 * which is exactly what HcSelNorm() exists to read. */
FUNCTION HcSelExtend( aSel, nAnchorLine, nAnchorCol, nLine, nCol )
   LOCAL nA1, nA2
   IF HB_ISARRAY( aSel ) .AND. Len( aSel ) >= HS_C2 .AND. ;
      ValType( aSel[ HS_L1 ] ) == "N" .AND. ValType( aSel[ HS_C1 ] ) == "N"
      nA1 := Int( aSel[ HS_L1 ] )
      nA2 := Int( aSel[ HS_C1 ] )
   ELSE
      nA1 := iif( ValType( nAnchorLine ) == "N", Int( nAnchorLine ), 1 )
      nA2 := iif( ValType( nAnchorCol ) == "N", Int( nAnchorCol ), 0 )
   ENDIF
   IF ValType( nLine ) != "N"
      nLine := nA1
   ENDIF
   IF ValType( nCol ) != "N"
      nCol := nA2
   ENDIF
RETURN { Max( 1, nA1 ), Max( 0, nA2 ), Max( 1, Int( nLine ) ), Max( 0, Int( nCol ) ) }

/* S85: the buffer with the selection REMOVED and the caret where the deletion
 * started: { new buffer, line, column }. The two ends are joined into one line
 * and the lines in between disappear; the caller's array is never written (the
 * answer is a copy, and a copy is what the editor installs). Selecting the whole
 * buffer leaves ONE empty line, never an empty buffer. Without a usable
 * selection nothing is dropped and the caret goes to the top of the buffer. */
FUNCTION HcSelDrop( aLines, aSel )
   LOCAL aOut := {}, aN, i, cLeft, cRight
   IF ! HB_ISARRAY( aLines )
      RETURN { { "" }, 1, 0 }
   ENDIF
   FOR i := 1 TO Len( aLines )
      AAdd( aOut, aLines[ i ] )
   NEXT
   aN := HcSelNorm( aLines, aSel )
   IF ! HB_ISARRAY( aN )
      RETURN { aOut, 1, 0 }
   ENDIF
   cLeft := iif( ValType( aOut[ aN[ HS_L1 ] ] ) == "C", aOut[ aN[ HS_L1 ] ], "" )
   IF aN[ HS_L1 ] == aN[ HS_L2 ]
      aOut[ aN[ HS_L1 ] ] := SubStr( cLeft, 1, aN[ HS_C1 ] ) + SubStr( cLeft, aN[ HS_C2 ] + 1 )
   ELSE
      cRight := iif( ValType( aOut[ aN[ HS_L2 ] ] ) == "C", aOut[ aN[ HS_L2 ] ], "" )
      aOut[ aN[ HS_L1 ] ] := SubStr( cLeft, 1, aN[ HS_C1 ] ) + SubStr( cRight, aN[ HS_C2 ] + 1 )
      /* ADel() does not shrink the array in this Harbour (trap 27): the size is
       * taken down by hand, and from the END so the indexes stay valid */
      FOR i := aN[ HS_L2 ] TO aN[ HS_L1 ] + 1 STEP -1
         ADel( aOut, i )
         ASize( aOut, Len( aOut ) - 1 )
      NEXT
   ENDIF
   IF Len( aOut ) == 0
      AAdd( aOut, "" )
   ENDIF
RETURN { aOut, aN[ HS_L1 ], aN[ HS_C1 ] }

/* =====================================================================
 *  S3 / S4 / S5 / S8 / S86 -- the Find / Replace DIALOG
 *
 *  The dialog is a DRIVER (S9): it knows nothing about the editor's locals or
 *  its buffer. It receives
 *
 *    aSt     the state array of HcFindState() (fields, checkboxes, message)
 *    bPaint  {|| ... } repaints the screen BEHIND the box (one paint block)
 *    bRun    {| cAct, aSt | ... } performs an action and answers the message to
 *            show; cAct is one of "find", "replace", "all", "close"
 *
 *  so a later `Files > Find and Replace` reuses the same screen with another
 *  bRun. The pure parts - the focus order, what a click means, what Enter does,
 *  the history list - live next to it and are what the headless bank (S86)
 *  pins: no window is needed to know how the dialog behaves.
 *
 *  Every clickable control registers itself WHILE IT IS PAINTED in the shared
 *  control table (S8) and a click produces exactly the action of its key, so
 *  there is no second copy of the geometry (AGENTS, code conventions).
 *
 *  The answer is NIL: everything the dialog knows lives in aSt, which it
 *  updates IN PLACE (fields, checkboxes, message), so the caller keeps using
 *  the same array and the session memory is written on the way out.
 * ===================================================================== */

/* S86: the state array the dialog works on. `Whole document` starts ON (S4) and
 * the rest off; the six checkboxes come from s_aHfChk (the only thing the dialog
 * remembers, S10/S16). The fields always start EMPTY (S16: no history and no
 * last query), the message starts empty, and `In selection` can only be on when
 * the caller says there IS a selection. */
FUNCTION HcFindState( lHasSel )
   LOCAL aSt := { "", "", .F., .F., .F., .F., .F., .T., .F., "" }, i
   IF HB_ISARRAY( s_aHfChk )
      FOR i := 1 TO Min( 6, Len( s_aHfChk ) )
         aSt[ FS_CASE + i - 1 ] := ( ValType( s_aHfChk[ i ] ) == "L" .AND. s_aHfChk[ i ] )
      NEXT
   ENDIF
   aSt[ FS_HASEL ] := ( ValType( lHasSel ) == "L" .AND. lHasSel )
   IF ! aSt[ FS_HASEL ]
      aSt[ FS_INSEL ] := .F.
   ENDIF
RETURN aSt

/* S86: the list after pushing cText. PURE - the answer is a NEW array and the
 * caller's is not touched - so the bank pins the whole rule: newest first,
 * HF_HIST_MAX entries at most, an empty text never stored (Len(), never
 * Empty(): a query of spaces is a query, trap 46) and an entry that is ALREADY
 * in the list is moved to the top instead of being repeated, which is the "no
 * consecutive duplicates" of S10 read as "the list holds each query once".
 * S16: the dialog no longer has a `[v]` history drop-down, so nothing calls
 * this from the UI; the rule stays because it is pure, banked (S86.14..18) and
 * the `Files > Find and Replace` of the manager will want it back. */
FUNCTION HcFindHist( aList, cText )
   LOCAL aNew := {}, i
   IF HB_ISARRAY( aList )
      FOR i := 1 TO Len( aList )
         IF ValType( cText ) != "C" .OR. ValType( aList[ i ] ) != "C" .OR. ! ( aList[ i ] == cText )
            AAdd( aNew, aList[ i ] )
         ENDIF
      NEXT
   ENDIF
   IF ValType( cText ) != "C" .OR. Len( cText ) == 0
      RETURN aNew
   ENDIF
   /* AIns() does not grow the array in this Harbour (trap 27): make room first */
   ASize( aNew, Len( aNew ) + 1 )
   AIns( aNew, 1 )
   aNew[ 1 ] := cText
   IF Len( aNew ) > HF_HIST_MAX
      ASize( aNew, HF_HIST_MAX )
   ENDIF
RETURN aNew

/* S10: what the dialog was left with is what it reopens with: the SIX
 * CHECKBOXES (S16 removed the query/replacement memory with the history).
 * Nothing goes to disk. */
STATIC PROCEDURE HcFindSaveState( aSt )
   LOCAL i, aChk := {}
   FOR i := 1 TO 6
      AAdd( aChk, ( ValType( aSt[ FS_CASE + i - 1 ] ) == "L" .AND. aSt[ FS_CASE + i - 1 ] ) )
   NEXT
   s_aHfChk := aChk
RETURN

/* S86: the next focus stop in 1..FD_STOP_MAX, wrapping in both directions and
 * SKIPPING `In selection` while the editor has no selection (S4: the option is
 * not focusable then). */
FUNCTION HcFindFocusStep( nFrom, lBack, aSt )
   LOCAL n, nDir, lHasSel, i
   IF ValType( nFrom ) != "N"
      nFrom := FD_STOP_FIND
   ENDIF
   nFrom := Int( nFrom )
   IF nFrom < 1 .OR. nFrom > FD_STOP_MAX
      nFrom := FD_STOP_FIND
   ENDIF
   lHasSel := HB_ISARRAY( aSt ) .AND. Len( aSt ) >= FS_HASEL .AND. ;
              ValType( aSt[ FS_HASEL ] ) == "L" .AND. aSt[ FS_HASEL ]
   nDir := iif( ValType( lBack ) == "L" .AND. lBack, -1, 1 )
   n := nFrom
   FOR i := 1 TO FD_STOP_MAX
      n += nDir
      IF n > FD_STOP_MAX
         n := 1
      ENDIF
      IF n < 1
         n := FD_STOP_MAX
      ENDIF
      IF n == FD_STOP_INSEL .AND. ! lHasSel
         LOOP
      ENDIF
      RETURN n
   NEXT
RETURN nFrom

/* S86: what a click on a control means: { kind, index } with 1 = text field,
 * 3 = checkbox and 4 = button, or NIL when the control is not one of this
 * dialog. Kind 2 was the `[v]` history drop-down and no longer exists (S16).
 * The array is the one HcSyncCtlAt() answers while the box is painted, so the
 * click and the key can never point at two different things. */
FUNCTION HcFindClick( aCtl )
   LOCAL cKind, nIdx
   IF ! HB_ISARRAY( aCtl ) .OR. Len( aCtl ) < 5
      RETURN NIL
   ENDIF
   cKind := aCtl[ 4 ]
   nIdx  := aCtl[ 5 ]
   IF ValType( cKind ) != "C" .OR. ValType( nIdx ) != "N"
      RETURN NIL
   ENDIF
   DO CASE
   CASE cKind == "HFFLD" .AND. ( nIdx == 1 .OR. nIdx == 2 )
      RETURN { 1, nIdx }
   CASE cKind == "HFCHK" .AND. nIdx >= 1 .AND. nIdx <= 6
      RETURN { 3, nIdx }
   CASE cKind == "HFBTN" .AND. nIdx >= 1 .AND. nIdx <= 4
      RETURN { 4, nIdx }
   ENDCASE
RETURN NIL

/* S86: the ACTION `Enter` runs on that focus stop: "find", "replace", "all",
 * "close", or "" when Enter is not an engine action there (a checkbox, an
 * invalid stop). The two fields and their drop-downs map to their own action,
 * so Enter on `Replace with:` replaces, and one click on that drop-down opens
 * the replacement history and then does the same. aSt is accepted so the dialog
 * and the future Files menu (S9) hand their state the same way. */
FUNCTION HcFindEnter( aSt, nFocus )
   IF ValType( nFocus ) != "N"
      RETURN ""
   ENDIF
   nFocus := Int( nFocus )
   DO CASE
   CASE nFocus == FD_STOP_FIND .OR. nFocus == FD_STOP_BTFIND
      RETURN "find"
   CASE nFocus == FD_STOP_REPL .OR. nFocus == FD_STOP_BTREPL
      RETURN "replace"
   CASE nFocus == FD_STOP_BTALL
      RETURN "all"
   CASE nFocus == FD_STOP_BTCLOSE
      RETURN "close"
   ENDCASE
RETURN ""

/* S14: the label of button n with its quick key marked (`~X~`, the convention
 * of the menus, and the letter always INSIDE its own word). ONE source of
 * truth: the paint reads it and the bank checks that the letter it marks is the
 * letter HcFindHot() answers for that button. Without the marks the label still
 * fits the FD_BTN_W cells of a button. */
FUNCTION HcFindBtnLabel( nBtn )
   LOCAL aLbl := { "~F~ind Next", "~R~eplace", "Replace ~A~ll", "~C~lose" }
   IF ValType( nBtn ) != "N" .OR. nBtn < 1 .OR. nBtn > 4
      RETURN ""
   ENDIF
RETURN aLbl[ Int( nBtn ) ]

/* S14: which button a key runs, 0 when it runs none. ALT makes the letter valid
 * from ANY stop of the box, which is the only spelling that works over a text
 * field: there a bare letter starts editing that field (S3) and cannot also run
 * a button (measured: before S14 an Alt-F over `Find what:` typed an `f`).
 * Without ALT the letter works as long as the focus is NOT a text field, so
 * `F`, `R`, `A` and `C` work on the checkboxes and on the buttons.
 * CTRL refuses the whole thing: on a Spanish keyboard AltGr IS Ctrl+Alt (AGENTS
 * trap 38), so AltGr+C cannot close the box. */
FUNCTION HcFindHot( nKey, nShift, nFoc )
   LOCAL cCh, lAlt, lCtl
   IF ValType( nKey ) != "N"
      RETURN 0
   ENDIF
   nKey := Int( nKey )
   /* a letter lives well below 127: anything else is not a quick key, and this
    * build can drop a byte >= 128 through Chr() (AGENTS trap 47) */
   IF nKey < 32 .OR. nKey > 126
      RETURN 0
   ENDIF
   cCh := Upper( Chr( nKey ) )
   IF ! ( cCh == "F" .OR. cCh == "R" .OR. cCh == "A" .OR. cCh == "C" )
      RETURN 0
   ENDIF
   lAlt := ValType( nShift ) == "N" .AND. hb_BitAnd( nShift, HB_GTI_KBD_ALT ) != 0
   lCtl := ValType( nShift ) == "N" .AND. hb_BitAnd( nShift, HB_GTI_KBD_CTRL ) != 0
   IF lCtl
      RETURN 0
   ENDIF
   IF ! lAlt .AND. ( nFoc == FD_STOP_FIND .OR. nFoc == FD_STOP_REPL )
      RETURN 0
   ENDIF
   DO CASE
   CASE cCh == "F"
      RETURN 1
   CASE cCh == "R"
      RETURN 2
   CASE cCh == "A"
      RETURN 3
   CASE cCh == "C"
      RETURN 4
   ENDCASE
RETURN 0

/* S15: where the focus goes when a field editor of the box closes: Tab walks
 * forward, Shift+Tab walks back (both with the same skipping rules as the Tab of
 * the box, HcFindFocusStep) and Enter or Esc leave the focus where it was -
 * Enter is the ACTION of that field (S3) and Esc cancelled the edit. PURE, so
 * the bank can check the rule without a window. */
FUNCTION HcFindEditExit( nFoc, nExit, aSt )
   IF ValType( nFoc ) != "N" .OR. ValType( nExit ) != "N"
      RETURN nFoc
   ENDIF
   DO CASE
   CASE nExit == K_TAB
      RETURN HcFindFocusStep( nFoc, .F., aSt )
   CASE nExit == K_SH_TAB
      RETURN HcFindFocusStep( nFoc, .T., aSt )
   ENDCASE
RETURN nFoc

/* small helper: a string of the state array, whatever the caller left there */
STATIC FUNCTION HcFindStr( x )
RETURN iif( ValType( x ) == "C", x, "" )

/* S3: the editor of one field. A NIL answer is the Esc of the field editor and
 * CANCELS the edit (the text it had stays); anything else is kept and goes to
 * that field's history. cSeed is the character that started the edit by being
 * typed on the focused field: it overwrites the first cell and the rest of the
 * old text is kept, which is the "teclear directamente" rule of the structure
 * editor (and what lets ENTER mean "do" on a field). */
STATIC FUNCTION HcFindEdit( nRow, cValue, cSeed )
   LOCAL cNew, cOld := cValue
   DEFAULT cSeed TO ""
   IF Len( cSeed ) > 0
      /* S15: a character typed on the focused field starts a NEW query. Before,
       * it seeded the FIRST CELL and kept the rest of the old text, so typing
       * `d` over `start` searched `dart` and the box looked like it was still
       * showing the data of the previous search (reported). Enter / Ins on the
       * field still open the editor WITH its text, which is the way to edit it. */
      cValue := Left( cSeed, 1 )
   ENDIF
   /* S15: the field is ONE yellow block while it is focused, so the editor opens
    * in the same colours that say "this is where you are" */
   cNew := UiLineEdit( nRow, FD_COL_FLD, FD_FLD_W, cValue, .F., UI_C_LISTSEL, .F., .T. )
   IF hb_IsNIL( cNew )
      /* Esc CANCELS: the field keeps the value it had, seed included */
      RETURN cOld
   ENDIF
RETURN cNew

/* S3/S14/S15: one button of the box, with its quick key highlighted. The pair
 * of the focused one is UI_C_LISTSEL -the same yellow as a focused field or a
 * focused checkbox, ONE language for the focus-, and the hot letter takes
 * UI_C_HOTSEL, the pair this program already uses for a hot key inside the
 * selected item. */
STATIC PROCEDURE HcFindBtn( nRow, nCol, cLabel, lOn )
   LOCAL cColor := iif( lOn, UI_C_LISTSEL, UI_C_MENUKEY )
   LOCAL cPlain := StrTran( cLabel, "~", "" )
   LOCAL nPad   := Int( ( FD_BTN_W - Len( cPlain ) ) / 2 )
   SetColor( cColor )
   @ nRow, nCol SAY Space( FD_BTN_W )
   UiDrawHot( nRow, nCol + nPad, cLabel, cColor, iif( lOn, UI_C_HOTSEL, UI_C_HOTON ) )
RETURN

/* S15: ONE row of the form. The FOCUS is painted on the field itself, never on
 * the label: the yellow block covers exactly the cells of the input (the label
 * and the gap keep the colours of the box), which is what the user asked for -
 * "se enciende toda la fila y no el input en si, no quiero eso". Label and field
 * are still ONE click target (AGENTS §6), that part does not change. */
STATIC PROCEDURE HcFindRowPaint( nRow, cLbl, cText, lFoc )
   SetColor( UI_C_BOX )
   @ nRow, FD_COL_LBL SAY cLbl
   SetColor( iif( lFoc, UI_C_LISTSEL, UI_C_INPUT ) )
   @ nRow, FD_COL_FLD SAY PadR( Left( cText, FD_FLD_W ), FD_FLD_W )
RETURN

/* S3/S8: one checkbox. lDim is the option that is not available right now (no
 * selection): painted with UI_C_BOXDIM and NOT registered in the control table,
 * so a click on it does nothing at all, exactly like the key. */
STATIC PROCEDURE HcFindCheck( nRow, nCol, cLabel, lOn, lFoc, lDim, nIdx )
   IF lDim
      SetColor( UI_C_BOXDIM )
   ELSE
      SetColor( iif( lFoc, UI_C_LISTSEL, UI_C_BOX ) )
   ENDIF
   @ nRow, nCol SAY "[" + iif( lOn, "X", " " ) + "] " + PadR( cLabel, 18 )
   IF ! lDim
      HcSyncCtlAdd( nRow, nCol, 4 + Len( cLabel ), "HFCHK", nIdx )
   ENDIF
RETURN

/* S3: the whole box: shadow, frame, the two fields (S16: no `[v]` drop-downs),
 * the six checkboxes, the message row, the four buttons and the hint row. It is
 * painted INSIDE the caller's UiPaintBegin()/UiPaintEnd(), and it is where the
 * controls of S8 are registered. */
/* The caret of the box: the stop that is a TEXT FIELD (`Find what:`,
 * `Replace with:`) shows the SYSTEM caret, blinking, on its first cell - the
 * yellow band alone does not say "type here" (reported: the focus is on
 * `Find what:` and the caret is nowhere, so the box looks read-only). Every
 * other stop hides it, and DevPos() is what MOVES it: this driver parks the
 * caret where the last SAY left it (the same lesson as the dot prompt). */
STATIC PROCEDURE HcFindCaret( nFoc )
   IF nFoc == FD_STOP_FIND
      SetCursor( 1 )
      DevPos( FD_ROW_FIND, FD_COL_FLD )
   ELSEIF nFoc == FD_STOP_REPL
      SetCursor( 1 )
      DevPos( FD_ROW_REPL, FD_COL_FLD )
   ELSE
      SetCursor( 0 )
   ENDIF
RETURN

/* S3: the whole box: shadow, frame, the two fields (S16: no `[v]` drop-downs),
 * the six checkboxes, the message row, the four buttons and the hint row. It is
 * painted INSIDE the caller's UiPaintBegin()/UiPaintEnd(), and it is where the
 * controls of S8 are registered. */
STATIC PROCEDURE HcFindPaint( aSt, nFoc )
   LOCAL i, nCol, nW, lHasSel
   lHasSel := ( ValType( aSt[ FS_HASEL ] ) == "L" .AND. aSt[ FS_HASEL ] )
   UiShadow( FD_T, FD_L, FD_B, FD_L + FD_W - 1 )
   UiFillBox( FD_T, FD_L, FD_B, FD_L + FD_W - 1, UI_C_BOX )
   UiFrame( FD_T, FD_L, FD_B, FD_L + FD_W - 1, UI_C_BOX, .T. )
   SetColor( UI_C_BOX )
   @ FD_T, FD_L + 2 SAY " Find / Replace "
   /* S15: the field with the focus is ONE yellow block -label, gap and field-,
    * the same language the checkboxes and the buttons speak. Before, the FOCUSED
    * field was painted with the dull pair and the UNFOCUSED one with the bright
    * green, so the field in use looked disabled and the other one looked active
    * (reported: "no se entiende donde esta el foco"). */
   HcFindRowPaint( FD_ROW_FIND, "Find what:", HcFindStr( aSt[ FS_FIND ] ), nFoc == FD_STOP_FIND )
   HcFindRowPaint( FD_ROW_REPL, "Replace with:", HcFindStr( aSt[ FS_REPL ] ), nFoc == FD_STOP_REPL )
   /* the label AND the field are ONE control each, so a click anywhere on that
    * row focuses the field */
   nW := FD_COL_FLD - FD_COL_LBL + FD_FLD_W
   HcSyncCtlAdd( FD_ROW_FIND, FD_COL_LBL, nW, "HFFLD", 1 )
   HcSyncCtlAdd( FD_ROW_REPL, FD_COL_LBL, nW, "HFFLD", 2 )
   /* S16: there are NO `[v]` history drop-downs any more. The user asked for the
    * history to be removed, so each field is one single control and Tab goes
    * from a field straight to the next one. */
   /* the six checkboxes in the two columns of S3. `In selection` is the 4th of
    * the list: dimmed and NOT registered while there is no selection. The flags
    * are read with HcOptOn(), the engine's flag reader, so a slot that is not a
    * logical paints as OFF instead of blowing the paint up. */
   HcFindCheck( FD_ROW_OPT1, FD_COL_CHK1, "Match case", HcOptOn( aSt, FS_CASE ), ;
                nFoc == FD_STOP_CASE, .F., 1 )
   HcFindCheck( FD_ROW_OPT1, FD_COL_CHK2, "Whole words only", HcOptOn( aSt, FS_WORD ), ;
                nFoc == FD_STOP_WORD, .F., 2 )
   HcFindCheck( FD_ROW_OPT2, FD_COL_CHK1, "Regular expression", HcOptOn( aSt, FS_RE ), ;
                nFoc == FD_STOP_RE, .F., 3 )
   HcFindCheck( FD_ROW_OPT2, FD_COL_CHK2, "In selection", HcOptOn( aSt, FS_INSEL ), ;
                nFoc == FD_STOP_INSEL, ! lHasSel, 4 )
   HcFindCheck( FD_ROW_OPT3, FD_COL_CHK1, "Backwards", HcOptOn( aSt, FS_BACK ), ;
                nFoc == FD_STOP_BACK, .F., 5 )
   HcFindCheck( FD_ROW_OPT3, FD_COL_CHK2, "Whole document", HcOptOn( aSt, FS_WHOLE ), ;
                nFoc == FD_STOP_WHOLE, .F., 6 )
   /* the message row (the answer of bRun, `Not found.`, `[wrapped]`) */
   SetColor( UI_C_HOT )
   @ FD_ROW_MSG, FD_COL_LBL SAY PadR( Left( HcFindStr( aSt[ FS_MSG ] ), FD_W - 4 ), FD_W - 4 )
   /* the four buttons, side by side with a two column gap */
   FOR i := 1 TO 4
      nCol := FD_COL_BTN + ( i - 1 ) * ( FD_BTN_W + FD_BTN_GAP )
      HcFindBtn( FD_ROW_BTN, nCol, HcFindBtnLabel( i ), nFoc == FD_STOP_BTFIND + i - 1 )
      HcSyncCtlAdd( FD_ROW_BTN, nCol, FD_BTN_W, "HFBTN", i )
   NEXT
   /* the hints, CHAINED from the column the previous chip ended on (S65): the
    * widths depend on the label, so fixed columns would overlap them */
   nCol := HcHintKey( FD_ROW_HINT, FD_COL_LBL, "Tab", "=Next" )
   nCol := HcHintKey( FD_ROW_HINT, nCol, "Enter", "=Do" )
   nCol := HcHintKey( FD_ROW_HINT, nCol, "Ins", "=Edit" )
   nCol := HcHintKey( FD_ROW_HINT, nCol, "Esc", "=Close" )
   nCol := HcHintKey( FD_ROW_HINT, nCol, "Alt-F/R/A/C", "=Button" )
   SetColor( UI_C_DESKTOP )
RETURN

/* S3/S9: the dialog itself. It paints bPaint() and the box in the SAME paint
 * block, polls for a key and for a click (the modals of this program have to
 * POLL: this driver never delivers a click through Inkey()) and leaves every
 * action to bRun, which owns the engine and the buffer. */
FUNCTION HcFindDlg( aSt, bPaint, bRun )
   LOCAL nFoc := FD_STOP_FIND, lPaint := .T., lDone := .F., nKey, aCtl, aHit
   LOCAL nShift := 0, nHot := 0
   /* cChord starts EMPTY, not NIL: it is read at the bottom of every pass
    * (`Len( cChord )`, S14) and a LOCAL without a value is NIL, so
    * Len( NIL ) threw an Argument error on the FIRST key - any key - and
    * BpFatal() took the whole program down (trap 77). */
   LOCAL cAltCh, cChord := ""
   LOCAL xDummy, cOldCur, cSave, cAct, cMsg, i, nStop
   IF ! HB_ISARRAY( aSt )
      aSt := HcFindState( .F. )
   ENDIF
   /* the selection flag is the truth: `In selection` cannot be ON without one */
   IF ValType( aSt[ FS_HASEL ] ) != "L" .OR. ! aSt[ FS_HASEL ]
      aSt[ FS_INSEL ] := .F.
   ENDIF
   cOldCur := SetCursor( 0 )
   /* one row and one column wider than the frame: the shadow goes there */
   cSave := SaveScreen( FD_T, FD_L, Min( FD_B + 1, MaxRow() ), Min( FD_L + FD_W, MaxCol() ) )
   /* S14: whatever the hook recorded BEFORE the box opened is not a quick key
    * here (an Alt+<letter> of the panel left pending), so it is discarded once */
   HcAltHookFlush()
   DO WHILE ! lDone
      IF lPaint
         UiPaintBegin()
         /* S8: the clickable controls are rebuilt on EVERY paint, so a click
          * can never land on a control that moved or is there no more */
         HcSyncCtlReset()
         IF HB_ISBLOCK( bPaint )
            Eval( bPaint )
         ENDIF
         HcFindPaint( aSt, nFoc )
         UiPaintEnd()
         /* AFTER the paint block: UiPaintEnd() is what ends the deferred paint
          * and restores the caret it hid, so the box marks its own one here. */
         HcFindCaret( nFoc )
         lPaint := .F.
      ENDIF
      nKey := Inkey( 0.05 )
      /* S14: what this driver answers is the LIVE keyboard state, not a snapshot
       * of the key, so it has to be read immediately after Inkey() (see the
       * comment of HcShiftState()) */
      nShift := HcShiftState()
      /* S14: with ALT held this driver can SWALLOW the letter from Inkey() -the
       * window hook records it anyway, and that is the failure trap 37 measured
       * on the name panels-, so the recorded ALT letters are the source of truth
       * here too: what the hook kept WINS over what Inkey() delivered. One
       * keystroke is one character, so the first pending letter stands in for
       * the key, with the ALT bit it was typed with. */
      cAltCh := HcHookDrain()
      IF Len( cAltCh ) > 0
         nKey   := Asc( Left( cAltCh, 1 ) )
         nShift := HB_GTI_KBD_ALT
      ENDIF
      /* right-click-esc (S1/S2/S7): a plain right click closes this box, the
       * same as Esc. Only a press and its release with no move in between fire
       * it, so a drag or a gesture the window hook force-closes never does. */
      IF nKey == 0 .AND. HcMouseRightClick()
         nKey := K_ESC
      ENDIF
      IF nKey == 0
         aCtl := HcSyncCtlAt( HcMouseClickRow(), HcMouseClickCol() )
         xDummy := HcMouseClickDbl()   /* read once: it must not leak */
         /* the wheel does NOTHING here (there is no list to scroll) but the
          * notch is CONSUMED, so it cannot scroll the editor behind the box */
         xDummy := HcMouseWheel()
         aHit := HcFindClick( aCtl )
         IF ! HB_ISARRAY( aHit )
            LOOP                       /* a click outside the controls: nothing */
         ENDIF
         DO CASE
         CASE aHit[ 1 ] == 1           /* a text field: focus it, or edit it */
            nStop := FD_STOP_FIND + 2 * ( aHit[ 2 ] - 1 )
            IF nFoc == nStop
               nKey := K_INS             /* the click on the focused field edits */
            ELSE
               nFoc := nStop
               lPaint := .T.
               LOOP
            ENDIF
         CASE aHit[ 1 ] == 3           /* a checkbox toggles by itself */
            i := FS_CASE + aHit[ 2 ] - 1
            aSt[ i ] := ! ( ValType( aSt[ i ] ) == "L" .AND. aSt[ i ] )
            nFoc := FD_STOP_CASE + aHit[ 2 ] - 1
            lPaint := .T.
            LOOP
         CASE aHit[ 1 ] == 4           /* a button runs the same Enter */
            nFoc := FD_STOP_BTFIND + aHit[ 2 ] - 1
            nKey := K_ENTER
         ENDCASE
      ENDIF
      IF nKey == 0
         LOOP
      ENDIF
      /* S14: the quick key of a button becomes the SAME K_ENTER that a click
       * on it produces (the HFBTN branch above), so key, click and Enter run
       * ONE path: move the focus there and let the case below do the work. */
      nHot := HcFindHot( nKey, nShift, nFoc )
      IF nHot > 0
         nFoc := FD_STOP_BTFIND + nHot - 1
         nKey := K_ENTER
         lPaint := .T.
      ENDIF
#ifndef BP_HC_STANDALONE
      /* the same diagnostic as the key loop of the panels: with BP_DEBUG=1,
       * hwbro.err says what the driver delivered, what the window hook recorded
       * and which button the quick key ran (S14), so a report from a user
       * machine shows exactly where a key went. */
      BpLog( "HcFind key=" + LTrim( Str( nKey ) ) + " shift=" + LTrim( Str( nShift ) ) + ;
             " ring=[" + cAltCh + "] hot=" + LTrim( Str( nHot ) ) + ;
             " foc=" + LTrim( Str( nFoc ) ) + " hc=" + LTrim( Str( HcAltHookTotal() ) ) )
#endif

      DO CASE
      CASE nKey == K_ESC
         lDone := .T.
      CASE nKey == K_TAB .OR. nKey == K_DOWN .OR. nKey == K_RIGHT
         nFoc := HcFindFocusStep( nFoc, .F., aSt )
         lPaint := .T.
      CASE nKey == K_SH_TAB .OR. nKey == K_UP .OR. nKey == K_LEFT
         nFoc := HcFindFocusStep( nFoc, .T., aSt )
         lPaint := .T.
      /* the checkbox stops toggle with Space (on them Enter is not an engine
       * action: HcFindEnter() answers "", see S86) */
      CASE nFoc >= FD_STOP_CASE .AND. nFoc <= FD_STOP_WHOLE .AND. nKey == K_SPACE
         i := FS_CASE + nFoc - FD_STOP_CASE
         aSt[ i ] := ! ( ValType( aSt[ i ] ) == "L" .AND. aSt[ i ] )
         lPaint := .T.
      /* S3: a character typed on a focused text field starts editing it with
       * that very character (the "teclear directamente" rule of the structure
       * editor) and `Ins` opens it without typing. That is what lets ENTER mean
       * "do" on a field, as the hint row says: Find Next from `Find what:` and
       * Replace from `Replace with:` (HcFindEnter()). */
      CASE ( nFoc == FD_STOP_FIND .OR. nFoc == FD_STOP_REPL ) .AND. nKey == K_INS
         aSt[ iif( nFoc == FD_STOP_FIND, FS_FIND, FS_REPL ) ] := ;
            HcFindEdit( iif( nFoc == FD_STOP_FIND, FD_ROW_FIND, FD_ROW_REPL ), ;
                        HcFindStr( aSt[ iif( nFoc == FD_STOP_FIND, FS_FIND, FS_REPL ) ] ) )
         /* S14: the Alt chord the field editor closed on is taken BEFORE the
          * flush -it is pending in bp_ui.prg, not in the ring any more- and the
          * pass ends by running the button it names. Whatever else was typed
          * inside the field is not a quick key of the box afterwards */
         cChord := UiAltChord()
         HcAltHookFlush()
         /* S15: Tab / Shift+Tab inside the field CONFIRM it and walk the form */
         nFoc := HcFindEditExit( nFoc, UiEditExit(), aSt )
         lPaint := .T.
      CASE ( nFoc == FD_STOP_FIND .OR. nFoc == FD_STOP_REPL ) .AND. ;
           nKey >= 32 .AND. nKey <= 255
         aSt[ iif( nFoc == FD_STOP_FIND, FS_FIND, FS_REPL ) ] := ;
            HcFindEdit( iif( nFoc == FD_STOP_FIND, FD_ROW_FIND, FD_ROW_REPL ), ;
                        HcFindStr( aSt[ iif( nFoc == FD_STOP_FIND, FS_FIND, FS_REPL ) ] ), ;
                        Chr( nKey ) )
         cChord := UiAltChord()
         HcAltHookFlush()
         nFoc := HcFindEditExit( nFoc, UiEditExit(), aSt )
         lPaint := .T.
      CASE nKey == K_ENTER
         cAct := HcFindEnter( aSt, nFoc )
         IF Len( cAct ) > 0
            IF HB_ISBLOCK( bRun )
               cMsg := Eval( bRun, cAct, aSt )
               aSt[ FS_MSG ] := iif( ValType( cMsg ) == "C", cMsg, "" )
            ENDIF
            lPaint := .T.
            IF cAct == "close"
               lDone := .T.
            ENDIF
         ENDIF
      ENDCASE
      /* S14: an Alt chord typed INSIDE a text field of the box lands here. The
       * field editor of bp_ui.prg closes on the chord and hands it over
       * (UiAltChord()), and this box runs the button it names - the letter is
       * looked up with HcFindHot() and the action is the SAME HcFindEnter() +
       * bRun() pair of the K_ENTER case -, so `Alt-R` over `Replace with:`
       * replaces instead of typing an `r`, which is what S14 always wanted. A
       * chord this box does not know runs nothing at all. */
      IF Len( cChord ) > 0
         nHot := HcFindHot( Asc( Left( cChord, 1 ) ), HB_GTI_KBD_ALT, nFoc )
         cChord := ""
         IF nHot > 0
            nFoc := FD_STOP_BTFIND + nHot - 1
            cAct := HcFindEnter( aSt, nFoc )
            IF Len( cAct ) > 0
               IF HB_ISBLOCK( bRun )
                  cMsg := Eval( bRun, cAct, aSt )
                  aSt[ FS_MSG ] := iif( ValType( cMsg ) == "C", cMsg, "" )
               ENDIF
               IF cAct == "close"
                  lDone := .T.
               ENDIF
            ENDIF
            lPaint := .T.
         ENDIF
      ENDIF
   ENDDO
   /* S10: the dialog reopens with what it was left with */
   HcFindSaveState( aSt )
   RestScreen( FD_T, FD_L, Min( FD_B + 1, MaxRow() ), Min( FD_L + FD_W, MaxCol() ), cSave )
   SetCursor( cOldCur )
   SetColor( UI_C_DESKTOP )
RETURN NIL

/* =====================================================================
 *  S2 / S6 / S7 -- the editor side of Find & Replace, and the selection keys
 *
 *  HcFindRun() applies ONE action of the dialog to the editor and is PURE: it
 *  takes the state and answers the WHOLE new state packet, without a single
 *  UiMsg() and without painting anything, so the headless bank checks the rule
 *  and the dialog only has to show the message it answers:
 *
 *    { cMsg, aLines, aSel, nRow, nTop, nCol, nLft, aUndo, lMod }      (FF_*)
 *
 *  nRow is the 0-based screen row of the caret, nTop the 1-based first visible
 *  line, nCol the 0-based column, nLft the horizontal offset of a window nW wide
 *  and aUndo the snapshot Ctrl-Z restores. `close` never reaches it: the box,
 *  not the buffer, is the dialog's business.
 *
 *  The rest of this block is the glue the editor screen needs, kept pure where
 *  it can be: HcFindTop() (the window that keeps the caret out from under the
 *  box), HcNavKey()/HcUndoKey() (what a key means) and the workers that only
 *  touch what their caller handed over with @.
 * ===================================================================== */

/* S7: did this key MOVE the caret? It is the whole rule the selection needs: a
 * movement extends the selection while SHIFT is down and collapses it when it
 * is up, and no other key touches it (the editing keys drop it themselves).
 * K_CTRL_F and K_END are the SAME code 6 in this driver (trap 37), so the
 * search key is taken out FIRST and a plain End stays a movement. */
FUNCTION HcNavKey( nKey, nShift )
   IF ValType( nKey ) != "N"
      RETURN .F.
   ENDIF
   IF HcTextFindKey( nKey, nShift )
      RETURN .F.
   ENDIF
RETURN nKey == K_UP .OR. nKey == K_DOWN .OR. nKey == K_LEFT .OR. nKey == K_RIGHT .OR. ;
       nKey == K_PGUP .OR. nKey == K_PGDN .OR. nKey == K_HOME .OR. nKey == K_END .OR. ;
       nKey == K_CTRL_HOME .OR. nKey == K_CTRL_END .OR. ;
       nKey == K_CTRL_PGUP .OR. nKey == K_CTRL_PGDN

/* S6/S7: the undo/redo CHORDS. MEASURED on this driver: a Ctrl+<letter> does not
 * arrive as its key code, it arrives as the BARE letter with the CTRL bit in
 * HcShiftState() (AGENTS trap 58/60), and with SHIFT down the letter arrives
 * UPPERCASE, so every spelling is accepted and the BITS decide which chord it is:
 * CTRL alone = undo, CTRL+SHIFT = redo. ALT refuses both, because in a Spanish
 * keyboard AltGr IS Ctrl+Alt and AltGr+Z types a character of the layout.
 * ⚠ K_CTRL_Z and K_CTRL_LEFT are the same code 26 in inkey.ch, so a Ctrl+Left
 * the driver did report as a key code would undo as well: the editor gives no
 * meaning to Ctrl+Left, so nothing is taken away from the user. */
FUNCTION HcUndoKey( nKey, nShift )
RETURN HcUndoChord( nKey, nShift, .F. )

/* S1 of editor-undo-redo.md: Ctrl+Shift+Z redoes */
FUNCTION HcRedoKey( nKey, nShift )
RETURN HcUndoChord( nKey, nShift, .T. )

STATIC FUNCTION HcUndoChord( nKey, nShift, lRedo )
   LOCAL lAlt := .F., lCtl := .F., lShf := .F., lRedoOn := ( ValType( lRedo ) == "L" .AND. lRedo )
   LOCAL lUp := .F.
   IF ValType( nKey ) != "N"
      RETURN .F.
   ENDIF
   IF ValType( nShift ) == "N"
      lAlt := hb_BitAnd( nShift, HB_GTI_KBD_ALT ) != 0
      lCtl := hb_BitAnd( nShift, HB_GTI_KBD_CTRL ) != 0
      lShf := hb_BitAnd( nShift, HB_GTI_KBD_SHIFT ) != 0
   ENDIF
   IF lAlt
      RETURN .F.
   ENDIF
   /* the KEY-CODE form (trap 60: this driver may not send it, another one does).
    * The code is the same with and without SHIFT, so the BIT is what decides */
   IF nKey == K_CTRL_Z
      RETURN lShf == lRedoOn
   ENDIF
   IF nKey < 32 .OR. nKey > 126
      RETURN .F.
   ENDIF
   /* this driver spells SHIFT down as an UPPERCASE letter, so that is a second
    * (and measured) signal of the redo chord */
   lUp := ( Chr( nKey ) == "Z" )
   IF ! lCtl
      RETURN .F.
   ENDIF
   IF lRedoOn != ( lShf .OR. lUp )
      RETURN .F.
   ENDIF
RETURN Upper( Chr( nKey ) ) == "Z"

/* S1/S3 of editor-ctrl-chords.md: Ctrl+S SAVES the buffer, with the same call
 * the F2 key makes. MEASURED on this driver: it arrives as the KEY CODE 19 with
 * the CTRL bit, and 19 is ALSO `K_LEFT`/`K_CTRL_S` (the same number), so the
 * CTRL bit is the only thing that tells them apart and a plain Left never
 * saves, Ctrl+S never moves a column. The letter form is accepted too (another
 * driver hands a Ctrl+<letter> over as the bare letter, trap 58/60), uppercase
 * because this driver spells SHIFT down that way, and ALT refuses both because
 * in a Spanish keyboard AltGr IS Ctrl+Alt (trap 38): AltGr+S types a character
 * of the layout and must never write the file. */
FUNCTION HcSaveKey( nKey, nShift )
   LOCAL lAlt := .F., lCtl := .F.
   IF ValType( nKey ) != "N"
      RETURN .F.
   ENDIF
   IF ValType( nShift ) == "N"
      lAlt := hb_BitAnd( nShift, HB_GTI_KBD_ALT ) != 0
      lCtl := hb_BitAnd( nShift, HB_GTI_KBD_CTRL ) != 0
   ENDIF
   IF lAlt .OR. ! lCtl
      RETURN .F.
   ENDIF
   IF nKey == K_CTRL_S                 /* == K_LEFT (19) with CTRL held */
      RETURN .T.
   ENDIF
   IF nKey < 32 .OR. nKey > 126
      RETURN .F.
   ENDIF
RETURN Upper( Chr( nKey ) ) == "S"

/* S2/S4 of editor-ctrl-chords.md: what a WORD chord means - -1 one word/symbol
 * back, +1 one word/symbol forward, 0 no chord at all. The movement itself is
 * the SAME rule the dialog fields use (UiWordLeft() / UiWordRight()), so the
 * editor owns no second notion of "word".
 *
 * nHook is the verdict of the window hook (bp_win32.c): 1 = Ctrl+Left,
 * 2 = Ctrl+Right, 0 = the hook saw no word chord. It is NIL when this build has
 * no hook (the headless bank, BP_HC_STANDALONE), and then the KEY CODE decides.
 *
 * WHY THE HOOK: MEASURED, Ctrl+Left arrives as code 26 with the CTRL bit, which
 * is the code of Ctrl-Z (K_CTRL_LEFT == K_CTRL_Z), so the code alone cannot be
 * read as a movement without stealing the undo. When the hook is there its
 * verdict is AUTHORITATIVE and the code form of 26 is NOT applied (nHook == 0
 * with code 26 is Ctrl+Z and it goes on undoing); the code form is the fallback
 * of a build without the hook, where nothing can undo with 26 by hand anyway
 * (the bank exercises exactly that). Ctrl+Right is code 2, unique here, so it
 * needs no hook - and it answers the same either way.
 * ALT disqualifies the chord (AltGr is Ctrl+Alt, trap 38); SHIFT is ignored
 * here because the movement uses it to extend the selection. */
FUNCTION HcWordKey( nKey, nShift, nHook )
   LOCAL lAlt := .F., lCtl := .F., lHook := ( ValType( nHook ) == "N" )
   IF ValType( nShift ) == "N"
      lAlt := hb_BitAnd( nShift, HB_GTI_KBD_ALT ) != 0
      lCtl := hb_BitAnd( nShift, HB_GTI_KBD_CTRL ) != 0
   ENDIF
   IF lAlt
      RETURN 0
   ENDIF
   IF lHook
      /* the hook pressed the ARROW with CTRL held, so this is the chord */
      DO CASE
      CASE nHook == 1
         RETURN -1
      CASE nHook == 2
         RETURN 1
      ENDCASE
      /* no chord: the hook looked and what arrived is NOT a word key */
      RETURN 0
   ENDIF
   IF ValType( nKey ) != "N" .OR. ! lCtl
      RETURN 0
   ENDIF
   IF nKey == K_CTRL_LEFT              /* == K_CTRL_Z (26): no hook, no undo */
      RETURN -1
   ENDIF
   IF nKey == K_CTRL_RIGHT             /* 2: unique in this driver */
      RETURN 1
   ENDIF
RETURN 0

/* S2 of editor-ctrl-chords.md: the COLUMN a word jump lands on in the editor.
 * The two helpers the dialog fields use speak the caret of a FIELD, which RESTS
 * on the cell it is going to overwrite: UiWordLeft() answers the FIRST cell of
 * the previous word (which for an insertion point is already the right place)
 * and UiWordRight() answers the LAST cell of the word, so in the editor - whose
 * caret sits BETWEEN two bytes - that stop is one character short. The rule is
 * the same one (same word, same stops) with the cell of the field translated to
 * the insertion point of the editor: forward, the caret goes AFTER the character
 * the helper answered. Nothing wraps to another line: both ends of the line are
 * borders, so the answer is always between 0 and Len( cLine ).
 * The column is a BYTE column of the code page of the file, so the answer is
 * snapped to the start of a character (S4 of hc-codepage.md) and the advance
 * moves ONE character, not one byte. PURE. */
FUNCTION HcWordCaret( cLine, nCol, nDir, cCdp )
   LOCAL nPos, nLen
   IF ValType( cLine ) != "C"
      cLine := ""
   ENDIF
   nLen := Len( cLine )
   nCol := Max( 0, Min( iif( ValType( nCol ) == "N", Int( nCol ), 0 ), nLen ) )
   IF ValType( nDir ) != "N" .OR. nDir == 0
      RETURN nCol
   ENDIF
   IF nDir > 0
      IF nCol >= nLen
         RETURN nCol                      /* end of the line: no wrap */
      ENDIF
      nPos := UiWordRight( cLine, nCol )
      IF nPos > nCol
         nPos += HcCdpCharLen( cLine, nPos, cCdp )
      ENDIF
   ELSE
      IF nCol == 0
         RETURN 0                         /* start of the line: no wrap */
      ENDIF
      nPos := UiWordLeft( cLine, nCol )
   ENDIF
RETURN HcCdpSnap( cLine, Max( 0, Min( nPos, nLen ) ), cCdp )

/* ---- the undo/redo history of the editor (S2..S5) ------------------------
 * ONE step is a LINE-SPLICE record (the HU_* slots of bp_def.ch): the rows that
 * started at line nAt BEFORE the edit, the rows that start there AFTER it, and
 * the caret on both sides. Undo puts aOut back and redo puts aIn back, so a
 * typed character costs ONE LINE and only a bulk action (paste, cut, Replace
 * All) stores a whole block. There is no level cap. */

/* S2: one record, ready to push. lMerge marks a step that is only the FIRST
 * HALF of the edit the user sees (deleting the selection before the key that
 * overwrote it), so HcUndoPush() lets the next edit absorb it: a selection
 * deleted with Del is ONE step, not two. */
FUNCTION HcUndoRec( nAt, aOut, aIn, nRowB, nColB, nRowA, nColA, lMerge )
   DEFAULT nAt   TO 1
   DEFAULT nRowB TO 0 ; DEFAULT nColB TO 0
   DEFAULT nRowA TO 0 ; DEFAULT nColA TO 0
   DEFAULT lMerge TO .F.
RETURN { Max( 1, nAt ), aOut, aIn, nRowB, nColB, nRowA, nColA, ;
         ( ValType( lMerge ) == "L" .AND. lMerge ) }

/* S2: a copy of rows nFrom..nTo of the buffer (an array of COPIES of the
 * strings, so the record never shares storage with the live buffer) */
FUNCTION HcLinesCopy( aLines, nFrom, nTo )
   LOCAL aOut := {}, i, nTot
   IF ! HB_ISARRAY( aLines )
      RETURN { "" }
   ENDIF
   nTot := Len( aLines )
   nFrom := Max( 1, Min( iif( ValType( nFrom ) == "N", nFrom, 1 ), nTot ) )
   nTo   := Max( nFrom, Min( iif( ValType( nTo ) == "N", nTo, nFrom ), nTot ) )
   FOR i := nFrom TO nTo
      AAdd( aOut, SubStr( aLines[ i ], 1 ) + "" )
   NEXT
RETURN aOut

/* S2: the buffer with nCount rows replaced by aIn starting at line nAt. PURE:
 * the answer is a NEW array and the caller's is never written (the same rule as
 * HcTextPaste()). It never answers an empty buffer: a file always has a line. */
FUNCTION HcUndoSplice( aLines, nAt, nCount, aIn )
   LOCAL aNew := {}, i, nTot, nKeep
   IF ! HB_ISARRAY( aLines )
      aLines := { "" }
   ENDIF
   nTot  := Len( aLines )
   nAt   := Max( 1, Min( iif( ValType( nAt ) == "N", nAt, 1 ), nTot ) )
   nCount := Max( 0, iif( ValType( nCount ) == "N", nCount, 0 ) )
   FOR i := 1 TO nAt - 1
      AAdd( aNew, aLines[ i ] )
   NEXT
   IF HB_ISARRAY( aIn )
      FOR i := 1 TO Len( aIn )
         AAdd( aNew, iif( ValType( aIn[ i ] ) == "C", aIn[ i ], "" ) )
      NEXT
   ENDIF
   FOR i := nAt + nCount TO nTot
      AAdd( aNew, aLines[ i ] )
   NEXT
   IF Len( aNew ) == 0
      AAdd( aNew, "" )
   ENDIF
RETURN aNew

/* S4: push one step on the history, GROUPING a run of typing. Two records
 * coalesce when both touch the SAME line, the caret of the new one starts where
 * the previous one ended, and the step is one column wide (typing one character,
 * inserting or overwriting). Anything else - Enter, Del, a paste, a move - opens
 * a new step, because the record of the top is then a different shape.
 * PURE: the answer is a NEW history array and the caller's is not touched. */
FUNCTION HcUndoPush( aHist, aRec )
   LOCAL aNew := {}, aTop, i, aM
   IF ! HB_ISARRAY( aHist )
      aHist := {}
   ENDIF
   FOR i := 1 TO Len( aHist )
      AAdd( aNew, aHist[ i ] )
   NEXT
   IF ! HB_ISARRAY( aRec ) .OR. Len( aRec ) < HU_LEN
      RETURN aNew
   ENDIF
   IF Len( aNew ) > 0
      aTop := aNew[ Len( aNew ) ]
      /* S2b: the step that is only the first half of the edit (the selection
       * being deleted) is absorbed by the edit that follows it */
      aM := HcUndoMergeDrop( aTop, aRec )
      IF HB_ISARRAY( aM )
         aNew[ Len( aNew ) ] := aM
         RETURN aNew
      ENDIF
      IF HcUndoMergeable( aTop, aRec )
         /* extend the top: it keeps its BEFORE side and takes the new AFTER
          * side and caret, so the whole run undoes as one step */
         aNew[ Len( aNew ) ] := HcUndoRec( aTop[ HU_AT ], aTop[ HU_OUT ], aRec[ HU_IN ], ;
                                            aTop[ HU_ROW_B ], aTop[ HU_COL_B ], ;
                                            aRec[ HU_ROW_A ], aRec[ HU_COL_A ] )
         RETURN aNew
      ENDIF
   ENDIF
   AAdd( aNew, aRec )
RETURN aNew

/* S4: the pair rule of HcUndoPush(), on its own so the bank can pin it */
FUNCTION HcUndoMergeable( aTop, aRec )
   IF ! HB_ISARRAY( aTop ) .OR. ! HB_ISARRAY( aRec )
      RETURN .F.
   ENDIF
   IF Len( aTop ) < HU_LEN .OR. Len( aRec ) < HU_LEN
      RETURN .F.
   ENDIF
   /* one line on each side: everything but a bulk action */
   IF ! HB_ISARRAY( aTop[ HU_OUT ] ) .OR. ! HB_ISARRAY( aTop[ HU_IN ] ) .OR. ;
      ! HB_ISARRAY( aRec[ HU_OUT ] ) .OR. ! HB_ISARRAY( aRec[ HU_IN ] )
      RETURN .F.
   ENDIF
   IF Len( aTop[ HU_OUT ] ) != 1 .OR. Len( aTop[ HU_IN ] ) != 1 .OR. ;
      Len( aRec[ HU_OUT ] ) != 1 .OR. Len( aRec[ HU_IN ] ) != 1
      RETURN .F.
   ENDIF
   IF aTop[ HU_AT ] != aRec[ HU_AT ]
      RETURN .F.
   ENDIF
   /* the caret of the new step continues where the previous one ended */
   IF aTop[ HU_ROW_A ] != aRec[ HU_ROW_B ] .OR. aTop[ HU_COL_A ] != aRec[ HU_COL_B ]
      RETURN .F.
   ENDIF
   /* and the step is ONE column wide (typing) */
RETURN aRec[ HU_COL_A ] == aTop[ HU_COL_A ] + 1

/* S2b: a step marked HU_MERGE (the selection that an edit is about to replace)
 * absorbed by the edit that follows in the SAME pass. The two are consecutive
 * when the row the edit starts from IS the row the drop left, and then their
 * regions join into one: the edit is on that row (one row each), it joins with
 * the row below (two rows) or with the row above. Answers the merged record, or
 * NIL when they are not consecutive (two separate steps). PURE. */
FUNCTION HcUndoMergeDrop( aTop, aRec )
   LOCAL aOut := {}, aIn, i, lType := .F.
   IF ! HB_ISARRAY( aTop ) .OR. ! HB_ISARRAY( aRec )
      RETURN NIL
   ENDIF
   IF Len( aTop ) < HU_LEN .OR. Len( aRec ) < HU_LEN
      RETURN NIL
   ENDIF
   IF ValType( aTop[ HU_MERGE ] ) != "L" .OR. ! aTop[ HU_MERGE ]
      RETURN NIL
   ENDIF
   IF ! HB_ISARRAY( aTop[ HU_OUT ] ) .OR. ! HB_ISARRAY( aTop[ HU_IN ] ) .OR. ;
      ! HB_ISARRAY( aRec[ HU_OUT ] ) .OR. ! HB_ISARRAY( aRec[ HU_IN ] )
      RETURN NIL
   ENDIF
   /* the drop leaves ONE row and the edit has to start from it */
   IF Len( aTop[ HU_IN ] ) != 1 .OR. Len( aRec[ HU_OUT ] ) < 1 .OR. ;
      Len( aRec[ HU_OUT ] ) > 2
      RETURN NIL
   ENDIF
   /* the CASE tells WHICH of the edit's rows is the row the drop left behind:
    * the only one (the key rewrote it), the FIRST (Del joined the row below) or
    * the LAST (Backspace joined the row above). Validating the wrong element was
    * the bug reported after S2b: a selection deleted with Del over the END of
    * the collapsed row needed two Ctrl-Z. */
   aOut := HcLinesCopy( aTop[ HU_OUT ], 1, Len( aTop[ HU_OUT ] ) )
   DO CASE
   CASE aRec[ HU_AT ] == aTop[ HU_AT ] .AND. Len( aRec[ HU_OUT ] ) == 1
      IF ! ( aRec[ HU_OUT ][ 1 ] == aTop[ HU_IN ][ 1 ] )
         RETURN NIL
      ENDIF
   CASE aRec[ HU_AT ] == aTop[ HU_AT ] .AND. Len( aRec[ HU_OUT ] ) == 2
      /* Del at the end of the dropped row: it also ate the row below */
      IF ! ( aRec[ HU_OUT ][ 1 ] == aTop[ HU_IN ][ 1 ] )
         RETURN NIL
      ENDIF
      AAdd( aOut, aRec[ HU_OUT ][ 2 ] )
   CASE aRec[ HU_AT ] == aTop[ HU_AT ] - 1 .AND. Len( aRec[ HU_OUT ] ) == 2
      /* Backspace at the start of the dropped row: it ate the row above */
      IF ! ( aRec[ HU_OUT ][ 2 ] == aTop[ HU_IN ][ 1 ] )
         RETURN NIL
      ENDIF
      aIn := { aRec[ HU_OUT ][ 1 ] }
      FOR i := 1 TO Len( aOut )
         AAdd( aIn, aOut[ i ] )
      NEXT
      aOut := aIn
   OTHERWISE
      RETURN NIL
   ENDCASE
   /* a step that INSERTED one character keeps the flag, so typing over a
    * selection is one step and not one per character; Del does not propagate it,
    * because two consecutive Deletes are two steps */
   lType := ( Len( aRec[ HU_OUT ] ) == 1 .AND. Len( aRec[ HU_IN ] ) == 1 .AND. ;
              ValType( aRec[ HU_IN ][ 1 ] ) == "C" .AND. ;
              Len( aRec[ HU_IN ][ 1 ] ) == Len( aRec[ HU_OUT ][ 1 ] ) + 1 )
RETURN HcUndoRec( Min( aTop[ HU_AT ], aRec[ HU_AT ] ), aOut, aRec[ HU_IN ], ;
                  aTop[ HU_ROW_B ], aTop[ HU_COL_B ], aRec[ HU_ROW_A ], aRec[ HU_COL_A ], ;
                  lType )

/* S11: Ctrl+G, the classic "go to line". MEASURED: this driver delivers it as the
 * KEY CODE 7 with the CTRL bit, and 7 is ALSO `K_DEL`/`K_CTRL_G` in inkey.ch (the
 * same number). The CTRL bit checked above is the only thing that tells them
 * apart, so a plain Del never jumps and Ctrl+G never deletes. ALT disqualifies it
 * (AltGr is Ctrl+Alt, trap 38); SHIFT is ignored, so Ctrl+Shift+G works too. */
FUNCTION HcGotoKey( nKey, nShift )
   IF ValType( nKey ) != "N" .OR. ValType( nShift ) != "N"
      RETURN .F.
   ENDIF
   IF hb_BitAnd( nShift, HB_GTI_KBD_ALT ) != 0
      RETURN .F.
   ENDIF
   IF hb_BitAnd( nShift, HB_GTI_KBD_CTRL ) == 0
      RETURN .F.
   ENDIF
   IF nKey == K_DEL                  /* == K_CTRL_G (7) with CTRL held */
      RETURN .T.
   ENDIF
   IF nKey < 32 .OR. nKey > 126
      RETURN .F.
   ENDIF
RETURN Upper( Chr( nKey ) ) == "G"

/* S11: the line a `Go to line` answer means. Only the DIGITS are read ("12",
 * " 12 " and "12a" all mean 12), the answer is clamped to 1..nLines and
 * anything without a digit (empty, "abc", NIL) answers nFrom, the line the
 * caret is already on, so Enter on an empty box changes nothing. PURE. */
FUNCTION HcGotoLine( cIn, nLines, nFrom )
   LOCAL c := "", i, cCh, nCur
   IF ValType( nLines ) != "N" .OR. nLines < 1
      nLines := 1
   ENDIF
   nCur := iif( ValType( nFrom ) == "N", nFrom, 1 )
   nCur := Max( 1, Min( nCur, nLines ) )
   IF ValType( cIn ) == "N"
      cIn := LTrim( Str( cIn ) )
   ENDIF
   IF ValType( cIn ) != "C"
      RETURN nCur
   ENDIF
   FOR i := 1 TO Len( cIn )
      cCh := SubStr( cIn, i, 1 )
      IF cCh >= "0" .AND. cCh <= "9"
         c += cCh
      ENDIF
   NEXT
   IF Len( c ) == 0
      RETURN nCur
   ENDIF
RETURN Max( 1, Min( Val( c ), nLines ) )

/* S2/S5: the step to apply and the history without it. Answers
 * { aRec, aHist } and { NIL, aHist } when there is nothing to undo. PURE. */
FUNCTION HcUndoPop( aHist )
   LOCAL aNew := {}, i, n
   IF ! HB_ISARRAY( aHist ) .OR. Len( aHist ) == 0
      RETURN { NIL, {} }
   ENDIF
   n := Len( aHist )
   FOR i := 1 TO n - 1
      AAdd( aNew, aHist[ i ] )
   NEXT
RETURN { aHist[ n ], aNew }

/* S2: ONE place turns "the buffer changed" into a step of the history for a BULK
 * action. `aUndo` is the snapshot of the buffer BEFORE it, which the packet of
 * HcFindRun() and the clipboard actions already answer with; the buffer as it is
 * now is the AFTER side. A whole-buffer record is the honest price of a bulk
 * action - it is exactly what used to be kept, now with unlimited depth - and a
 * no-snapshot answer (an action that changed nothing) pushes nothing. */
STATIC PROCEDURE HcUndoBulk( aHist, aRedo, aUndo, aLines, nRowB, nColB, nRowA, nColA )
   IF ! HB_ISARRAY( aUndo )
      RETURN
   ENDIF
   aHist := HcUndoPush( aHist, HcUndoRec( 1, aUndo, HcCopyLines( aLines ), ;
                                          nRowB, nColB, nRowA, nColA ) )
   aRedo := {}
   aUndo := NIL
RETURN

/* S2: the step of ONE line-level edit (typing, Tab, Backspace or Del inside the
 * line): the row before and the row after, with the caret on both sides. A step
 * that leaves the row equal pushes nothing. */
STATIC PROCEDURE HcUndoLine( aHist, aRedo, nAt, cBefore, cAfter, nRowB, nColB, nRowA, nColA )
   IF ValType( cBefore ) != "C" .OR. ValType( cAfter ) != "C" .OR. cBefore == cAfter
      RETURN
   ENDIF
   aHist := HcUndoPush( aHist, HcUndoRec( nAt, { cBefore }, { cAfter }, ;
                                          nRowB, nColB, nRowA, nColA ) )
   aRedo := {}
RETURN

/* S2: the step of an edit that RESHAPES the rows (Enter splits a line, Backspace
 * and Del join two): the rows that were there and the rows that are there now,
 * starting at nAt. A step that leaves them equal pushes nothing. */
STATIC PROCEDURE HcUndoRows( aHist, aRedo, nAt, aOut, aIn, nRowB, nColB, nRowA, nColA, lMerge )
   LOCAL lSame := .F., i
   DEFAULT lMerge TO .F.
   IF ! HB_ISARRAY( aOut ) .OR. ! HB_ISARRAY( aIn )
      RETURN
   ENDIF
   lSame := ( Len( aOut ) == Len( aIn ) )
   IF lSame
      FOR i := 1 TO Len( aOut )
         IF ! ( aOut[ i ] == aIn[ i ] )
            lSame := .F.
            EXIT
         ENDIF
      NEXT
   ENDIF
   IF lSame
      RETURN
   ENDIF
   aHist := HcUndoPush( aHist, HcUndoRec( nAt, aOut, aIn, nRowB, nColB, nRowA, nColA, lMerge ) )
   aRedo := {}
RETURN

/* S2: bRun of the dialog seen from the editor, with the history on top: it runs
 * ONE action through HcFindAct() and, if that action left a snapshot of the
 * buffer (the Replace All does), pushes it as a step. */
STATIC FUNCTION HcFindBulk( cAct, aSt, aLines, aSel, nRow, nCol, nTop, nLft, aUndo, aHist, aRedo, lMod, cNote, aHit, nVis, nW, cCdp )
   LOCAL cMsg, nRowB := nRow, nColB := nCol
   cMsg := HcFindAct( cAct, aSt, @aLines, @aSel, @nRow, @nCol, @nTop, @nLft, ;
                      @aUndo, @lMod, @cNote, @aHit, nVis, nW, cCdp )
   HcUndoBulk( @aHist, @aRedo, @aUndo, aLines, nRowB, nColB, nRow, nCol )
RETURN cMsg

/* S6/S7: which keys KEEP the note and the mark of the status row. The notes of
 * the dialog, of the undo and of the copy belong to their own key; every other
 * key drops them, because a stale mark would paint over text that has moved
 * (the S77 rule). */
STATIC FUNCTION HcNoteKey( nKey, nShift, lEdit, nWord )
   IF HcTextFindKey( nKey, nShift )
      RETURN .T.
   ENDIF
   /* S2 of hc-codepage.md: F6 reports the code page it chose on the status row,
    * and that note is in BOTH screens (the viewer is read-only and still has the
    * key), so it survives its own key like the search does */
   IF nKey == K_F6
      RETURN .T.
   ENDIF
   IF ! ( ValType( lEdit ) == "L" .AND. lEdit )
      RETURN .F.
   ENDIF
   /* S3 of hc-codepage.md: F9 transforms the code page of the buffer and reports
    * it on the status row, so its own note survives its own key like the search */
   IF nKey == K_F9
      RETURN .T.
   ENDIF
   /* S5 of editor-ctrl-chords.md: the two SAVE keys behave the same on this row,
    * which is what the request asks for - and the cheapest way to be the same is
    * to leave F2 exactly as it was: a save writes no note of its own, so both of
    * them drop the pending one (F2 is NOT listed here on purpose). The word
    * movements keep it for the same reason Ctrl-Z does (S5): moving the caret
    * does not move the mark, which is a position of the buffer. */
   IF ValType( nWord ) == "N" .AND. nWord != 0
      RETURN .T.
   ENDIF
RETURN HcUndoKey( nKey, nShift ) .OR. HcRedoKey( nKey, nShift ) .OR. ;
       HcGotoKey( nKey, nShift ) .OR. nKey == K_CTRL_INS

/* S6: the window top that keeps line nLine VISIBLE and OUT FROM UNDER the box
 * of the dialog (rows FD_T..FD_B) on a window of nVis rows. The caret row is
 * nTextRow + ( nLine - nTop ), so when it lands inside the box the window moves:
 * ABOVE the box while there is room (the line goes to the row just over FD_T),
 * and BELOW it otherwise (the row just under FD_B). Everything is clamped to the
 * buffer, so a short file or a line at its end can only leave the caret where it
 * is. PURE: the bank pins the three cases.
 *
 * nTextRow (S12 of hc-editor-tabs.md, optional FIFTH parameter) is the first row
 * of TEXT of the screen, which HcTextTop() answers: the editor paints a rule
 * under the bar of tabs, so its text starts one row lower than the viewer's.
 * Absent, it is HE_TOP - the row this rule has always been computed with -, so a
 * caller that does not care keeps exactly the answer it had. */
FUNCTION HcFindTop( nLine, nTop, nVis, nLines, nTextRow )
   LOCAL nMax, nWant, nRow
   IF ValType( nVis ) != "N" .OR. nVis < 1
      nVis := HE_BOTTOM - HE_TOP + 1
   ENDIF
   IF ValType( nTextRow ) != "N"
      nTextRow := HE_TOP
   ENDIF
   IF ValType( nLines ) != "N" .OR. nLines < 1
      nLines := 1
   ENDIF
   nLine := iif( ValType( nLine ) == "N", Int( nLine ), 1 )
   nLine := Max( 1, Min( nLine, nLines ) )
   nTop  := iif( ValType( nTop ) == "N", Int( nTop ), 1 )
   nMax  := Max( 1, nLines - nVis + 1 )
   nTop  := Max( 1, Min( nTop, nMax ) )
   nTop  := Min( nTop, nLine )      /* the line itself has to be in the window */
   nRow  := nLine - nTop
   IF nTextRow + nRow >= FD_T .AND. nTextRow + nRow <= FD_B .AND. FD_T - 1 > nTextRow
      nWant := nLine - ( FD_T - 1 - nTextRow )
      IF nWant >= 1 .AND. nWant <= nMax
         RETURN nWant
      ENDIF
      nWant := nLine - ( FD_B + 1 - nTextRow )
      IF nWant >= 1 .AND. nWant <= nMax
         RETURN nWant
      ENDIF
   ENDIF
RETURN nTop

/* S6: the length of one line of a buffer, and 0 for a slot that is not a
 * string (a buffer of this program is always full of strings, but the rule is
 * pure and a bad array must not blow the function up) */
STATIC FUNCTION HcLenAt( aLines, nLine )
   IF ! HB_ISARRAY( aLines ) .OR. ValType( nLine ) != "N"
      RETURN 0
   ENDIF
   IF nLine < 1 .OR. nLine > Len( aLines )
      RETURN 0
   ENDIF
RETURN iif( ValType( aLines[ nLine ] ) == "C", Len( aLines[ nLine ] ), 0 )

/* S4 of hc-codepage.md: the caret of line nLine is a BYTE column of the buffer,
 * so a bulk action (Find / Replace, paste, cut) can leave it inside a multi-byte
 * character; this takes it back to the start of that character with
 * HcCdpSnap(). A line that is not there leaves the column alone, so the answer
 * is always a usable caret. */
STATIC FUNCTION HcCdpCaret( aLines, nLine, nCol, cCdp )
   IF ! HB_ISARRAY( aLines ) .OR. ValType( nLine ) != "N"
      RETURN nCol
   ENDIF
   IF nLine < 1 .OR. nLine > Len( aLines ) .OR. ValType( aLines[ nLine ] ) != "C"
      RETURN nCol
   ENDIF
RETURN HcCdpSnap( aLines[ nLine ], nCol, cCdp )

/* S6: a COPY of a buffer (same length, same strings). Array( n, x ) does not
 * fill and ACopy() into a {} copies nothing at all (trap 33), so the shape is
 * made first and then filled. */
STATIC FUNCTION HcCopyLines( aLines )
   LOCAL aOut
   IF ! HB_ISARRAY( aLines )
      RETURN { "" }
   ENDIF
   aOut := Array( Len( aLines ) )
   ACopy( aLines, aOut )
RETURN aOut

/* S6: the packet of HcFindRun() with the horizontal offset that keeps the caret
 * inside a window nW wide. HcFindRun() does not receive the offset the screen
 * is using (the packet is what the dialog drives), so one is DERIVED here: 0
 * while the caret fits, the least scroll that brings it back otherwise. The
 * editor keeps its own offset and takes only the column from the packet, so
 * accepting a jump never re-scrolls more than it has to. */
STATIC FUNCTION HcFindPk( cMsg, aLines, aSel, nRow, nTop, nCol, nW, aUndo, lMod )
   LOCAL nLft := Max( 0, iif( ValType( nCol ) == "N", Int( nCol ), 0 ) - nW + 1 )
RETURN { iif( ValType( cMsg ) == "C", cMsg, "" ), aLines, aSel, nRow, nTop, nCol, ;
         nLft, aUndo, lMod }

/* S2/S6: ONE action of the Find / Replace dialog applied to the editor.
 *   cAct   "find" | "replace" | "all"  (`close` is the dialog's own business)
 *   aSt    the dialog state (HcFindState()), only read
 *   aLines the buffer - NEVER written: the actions that change the text work on
 *          a copy and hand the copy back in the packet
 *   aSel   the current selection, or NIL
 * The answer is the packet of FF_*. A bad pattern and a query shorter than one
 * character leave EVERYTHING as it was (the packet is the state unchanged) and
 * only say why: an invalid regex is never a crash and never a half search.
 *
 * The caret is left where the NEXT search has to start - the END of the match
 * going forward and its START going backwards - so pressing the key again
 * advances instead of finding the same text over and over. */
FUNCTION HcFindRun( cAct, aSt, aLines, aSel, nRow, nCol, nTop, nVis, nW, lMod )
   LOCAL cMsg := "", aL2, aSel2, aUndo := NIL, lMod2, aMt, aOpt, aHit, aRes
   LOCAL nRow2, nTop2, nCol2, nSeekLine, nSeekCol, nIns, i, cLine, cQuery, cRepl
   LOCAL aN, aM, aMatch, lReplaced := .F.

   IF ! HB_ISARRAY( aLines ) .OR. Len( aLines ) == 0
      aLines := { "" }
   ENDIF
   aL2   := aLines
   aSel2 := aSel
   lMod2 := ( ValType( lMod ) == "L" .AND. lMod )
   IF ValType( nVis ) != "N" .OR. nVis < 1
      nVis := HcTextRows( .T. )       /* S12: the editor's text rows */
   ENDIF
   IF ValType( nW ) != "N" .OR. nW < 1
      nW := MaxCol() + 1
   ENDIF
   nTop2 := Max( 1, Min( iif( ValType( nTop ) == "N", Int( nTop ), 1 ), Len( aL2 ) ) )
   nRow2 := Max( 0, Min( iif( ValType( nRow ) == "N", Int( nRow ), 0 ), Len( aL2 ) - nTop2 ) )
   nCol2 := Max( 0, iif( ValType( nCol ) == "N", Int( nCol ), 0 ) )
   nCol2 := Min( nCol2, HcLenAt( aL2, nTop2 + nRow2 ) )

   IF ! HB_ISARRAY( aSt ) .OR. Len( aSt ) < FS_MSG
      RETURN HcFindPk( "", aL2, aSel2, nRow2, nTop2, nCol2, nW, NIL, lMod2 )
   ENDIF
   cAct   := iif( ValType( cAct ) == "C", Lower( cAct ), "" )
   cQuery := iif( ValType( aSt[ FS_FIND ] ) == "C", aSt[ FS_FIND ], "" )
   cRepl  := iif( ValType( aSt[ FS_REPL ] ) == "C", aSt[ FS_REPL ], "" )
   /* Len(), never Empty(): a query of spaces IS a query (trap 46) */
   IF Len( cQuery ) == 0
      RETURN HcFindPk( "Not found.", aL2, aSel2, nRow2, nTop2, nCol2, nW, NIL, lMod2 )
   ENDIF
   aMt := HcMatcher( cQuery, aSt[ FS_CASE ], aSt[ FS_WORD ], aSt[ FS_RE ] )
   IF aMt[ HM_BAD ]
      RETURN HcFindPk( "Invalid regular expression.", aL2, aSel2, nRow2, nTop2, nCol2, ;
                       nW, NIL, lMod2 )
   ENDIF
   /* the six boxes in the order of HF_*, so the engine reads what was ticked */
   aOpt := { aSt[ FS_CASE ], aSt[ FS_WORD ], aSt[ FS_RE ], ;
             aSt[ FS_BACK ], aSt[ FS_WHOLE ], aSt[ FS_INSEL ] }

   IF cAct == "all"
      aRes := HcReplaceAll( aLines, aMt, aOpt, aSel, cRepl )
      IF aRes[ 2 ] > 0
         /* the snapshot Ctrl-Z restores is the buffer as it was BEFORE this */
         aUndo := HcCopyLines( aLines )
         aL2   := aRes[ 1 ]
         lMod2 := .T.
         aSel2 := NIL               /* what it covered is not the same text now */
         nTop2 := Max( 1, Min( nTop2, Len( aL2 ) ) )
         nRow2 := Max( 0, Min( nRow2, Len( aL2 ) - nTop2 ) )
         nCol2 := Min( nCol2, HcLenAt( aL2, nTop2 + nRow2 ) )
         cMsg  := LTrim( Str( aRes[ 2 ] ) ) + " occurrence(s) replaced."
      ELSE
         /* nothing replaced: buffer, caret and modified flag stay as they
          * were, and there is nothing to undo */
         cMsg := "Not found."
      ENDIF

   ELSEIF cAct == "find" .OR. cAct == "replace"
      nSeekLine := nTop2 + nRow2
      nSeekCol  := nCol2
      IF cAct == "replace"
         /* the selection is the last match ONLY when it starts and ends where
          * the engine puts one; the match is asked from the engine again, so a
          * regex replacement keeps its groups ($1..) */
         aN := HcSelNorm( aLines, aSel )
         aMatch := NIL
         IF HB_ISARRAY( aN ) .AND. aN[ HS_L1 ] == aN[ HS_L2 ]
            aM := HcLineMatches( aLines[ aN[ HS_L1 ] ], aMt )
            FOR i := 1 TO Len( aM )
               IF aM[ i ][ HM_START ] == aN[ HS_C1 ] .AND. ;
                  aM[ i ][ HM_LEN ] == aN[ HS_C2 ] - aN[ HS_C1 ]
                  aMatch := aM[ i ]
                  EXIT
               ENDIF
            NEXT
         ENDIF
         IF HB_ISARRAY( aMatch )
            cLine := aLines[ aN[ HS_L1 ] ]
            aL2 := HcCopyLines( aLines )   /* the caller's array is never written */
            aL2[ aN[ HS_L1 ] ] := HcReplaceLine( cLine, aMt, aMatch, cRepl )
            /* how much text the replacement INSERTED: the next search starts at
             * its end, so the same text is never replaced twice */
            nIns := Len( aL2[ aN[ HS_L1 ] ] ) - Len( cLine ) + aMatch[ HM_LEN ]
            lMod2  := .T.
            lReplaced := .T.
            aSel2  := NIL                  /* that match is not there any more */
            nSeekLine := aN[ HS_L1 ]
            nSeekCol  := aN[ HS_C1 ] + nIns
         ENDIF
      ENDIF
      /* the find step of both actions. `In selection` limits it to aSel; after a
       * replacement that selection was the match that just disappeared, so the
       * dead rectangle is not offered as the scope of the next search. */
      aHit := HcFindNext( aL2, aMt, aOpt, iif( lReplaced, NIL, aSel ), nSeekLine, nSeekCol )
      IF aHit[ 1 ] == 0
         cMsg := "Not found."
         IF lReplaced
            /* the replacement STANDS: the caret is left after the new text */
            nTop2 := Max( 1, Min( nTop2, nSeekLine ) )
            IF nSeekLine - nTop2 > nVis - 1
               nTop2 := Max( 1, nSeekLine - nVis + 1 )
            ENDIF
            nRow2 := nSeekLine - nTop2
            nCol2 := Min( nSeekCol, HcLenAt( aL2, nSeekLine ) )
         ENDIF
      ELSE
         /* the hit becomes the selection of the editor (S7: the match is what
          * `Replace` and `In selection` work on) and the caret goes to its end,
          * or to its start when the search goes backwards */
         aSel2 := { aHit[ 1 ], aHit[ 2 ], aHit[ 1 ], aHit[ 2 ] + aHit[ 3 ] }
         nCol2 := iif( HcOptOn( aOpt, HF_BACK ), aHit[ 2 ], aHit[ 2 ] + aHit[ 3 ] )
         nTop2 := HcFindTop( aHit[ 1 ], nTop2, nVis, Len( aL2 ), HcTextTop( .T. ) )
         nRow2 := aHit[ 1 ] - nTop2
         cMsg  := iif( aHit[ 5 ], "[wrapped]", "" )
      ENDIF
   ENDIF
RETURN HcFindPk( cMsg, aL2, aSel2, nRow2, nTop2, nCol2, nW, aUndo, lMod2 )

/* S7: the selection after ONE movement. With SHIFT down it is EXTENDED from the
 * anchor the caret stood on before the move (HcSelExtend() keeps the anchor of a
 * selection that already exists, which is what lets a run of Shift+arrows grow
 * and shrink again); without SHIFT any plain movement COLLAPSES it. */
STATIC FUNCTION HcSelAfter( aSel, lShift, nAncLine, nAncCol, nLine, nCol )
   IF ! ( ValType( lShift ) == "L" .AND. lShift )
      RETURN NIL
   ENDIF
RETURN HcSelExtend( aSel, nAncLine, nAncCol, nLine, nCol )

/* S7: an EDITING key with a selection active removes the selection FIRST and
 * leaves the caret where the deletion ended, so the key then does exactly what
 * it always did, at the place the text now is. Everything arrives by reference
 * (@) from HcFileScreen(), its only caller: the buffer it installs is the copy
 * HcSelDrop() answered (the array the screen had is never written) and the
 * deletion counts as a modification. Without a selection nothing is touched. */
STATIC PROCEDURE HcSelDropEdit( aHist, aRedo, aLines, aSel, nTop, nRow, nCol, nLft, lMod, nVis, nW )
   LOCAL aDrop, nL, aN, aOut, nRowB, nColB
   IF HcSelEmpty( aSel )
      aSel := NIL
      RETURN
   ENDIF
   /* S2: delete the selection is a STEP of its own, so the first Ctrl-Z brings
    * back the block before anything typed after it is undone */
   aN    := HcSelNorm( aLines, aSel )
   aOut  := NIL
   nRowB := nRow
   nColB := nCol
   IF HB_ISARRAY( aN ) .AND. Len( aN ) >= 4 .AND. aN[ HS_L2 ] >= aN[ HS_L1 ]
      aOut := HcLinesCopy( aLines, aN[ HS_L1 ], aN[ HS_L2 ] )
   ENDIF
   aDrop  := HcSelDrop( aLines, aSel )
   aLines := aDrop[ 1 ]
   nL     := aDrop[ 2 ]
   nTop   := Max( 1, Min( nTop, nL ) )
   IF nL - nTop > nVis - 1
      nTop := Max( 1, nL - nVis + 1 )
   ENDIF
   nRow  := nL - nTop
   nCol  := aDrop[ 3 ]
   nLft  := HcFixLeft( nCol, nLft, nW )
   aSel  := NIL
   lMod  := .T.
   IF HB_ISARRAY( aOut )
      HcUndoRows( @aHist, @aRedo, aN[ HS_L1 ], aOut, HcLinesCopy( aLines, nL, nL ), ;
                  nRowB, nColB, nRow, nCol, .T. )
   ENDIF
RETURN

/* S2/S9: bRun of the dialog seen from the editor. It runs ONE action through
 * the pure HcFindRun(), copies the packet back into the locals of the Editor
 * screen (they arrive by reference, so the block that owns them hands them over)
 * and answers the message the dialog paints. The match is ALSO marked with aHit,
 * so the painter of S77 keeps working over the selection. */
STATIC FUNCTION HcFindAct( cAct, aSt, aLines, aSel, nRow, nCol, nTop, nLft, aUndo, lMod, cNote, aHit, nVis, nW, cCdp )
   LOCAL aPk := HcFindRun( cAct, aSt, aLines, aSel, nRow, nCol, nTop, nVis, nW, lMod )
   LOCAL aN
   aLines := aPk[ FF_A_LINES ]
   aSel   := aPk[ FF_A_SEL ]
   nRow   := aPk[ FF_N_ROW ]
   nTop   := aPk[ FF_N_TOP ]
   nCol   := aPk[ FF_N_COL ]
   /* S4 of hc-codepage.md: the column the engine answers is a BYTE column and in
    * a multi-byte code page it can land inside a character; normalising it HERE
    * is what keeps OVERWRITE from replacing one byte of an accent */
   nCol   := HcCdpCaret( aLines, nTop + nRow, nCol, cCdp )
   /* the offset of the window belongs to the SCREEN: it moves the least it has
    * to, so accepting a jump does not re-scroll a whole long line */
   nLft   := HcFixLeft( nCol, nLft, nW )
   aUndo  := aPk[ FF_A_UNDO ]
   lMod   := aPk[ FF_L_MOD ]
   cNote  := aPk[ FF_MSG ]
   /* S77: the mark of the search over the match the dialog left selected */
   aN := HcSelNorm( aLines, aSel )
   IF HB_ISARRAY( aN ) .AND. aN[ HS_L1 ] == aN[ HS_L2 ]
      aHit := { aN[ HS_L1 ], aN[ HS_C1 ], aN[ HS_C2 ] - aN[ HS_C1 ] }
   ELSE
      aHit := { 0, 0, 0 }
   ENDIF
RETURN cNote

/* =====================================================================
 *  S13 -- the clipboard of the editor selection: copy, cut and paste
 *
 *  The three actions live in `HcEditClipAct()`, which takes the locals of the
 *  screen by reference exactly like `HcFindAct()`, so the key loop has ONE
 *  implementation of each and the rule that can be checked without a window is
 *  pure (`HcTextPaste()`).
 *
 *  The clipboard itself is `bp_win32.c` (`W32ClipPut()` / the new
 *  `W32ClipGet()`); the headless bank does not link it, so both wrappers answer
 *  "nothing" there and the actions only set their note. That is also why the
 *  paste rule is a separate public function: the bank drives it directly.
 * ===================================================================== */

/* S13: text -> the Windows clipboard. This is the only place that decides what
 * "no clipboard" means in the headless bank: nothing was copied. */
STATIC FUNCTION HcClipPutText( cText )
#ifdef BP_HC_STANDALONE
   HB_SYMBOL_UNUSED( cText )
RETURN .F.
#else
RETURN W32ClipPut( cText )
#endif

/* S13: the Windows clipboard -> text ("" when there is none) */
STATIC FUNCTION HcClipGetText()
#ifdef BP_HC_STANDALONE
RETURN ""
#else
RETURN W32ClipGet()
#endif

/* S13: the window top that keeps nLine visible with the LEAST movement (the
 * rule of the navigation keys: the page does not move while the caret is
 * already inside it). */
STATIC FUNCTION HcCaretTop( nTop, nLine, nLines, nVis )
   IF ValType( nLine ) != "N" .OR. ValType( nLines ) != "N" .OR. ValType( nTop ) != "N"
      RETURN 1
   ENDIF
   IF nLine < nTop
      RETURN Max( 1, Min( nLine, Max( 1, nLines ) ) )
   ENDIF
   IF nLine > nTop + nVis - 1
      RETURN HcFixTop( nLine - nVis + 1, nLines, nVis )
   ENDIF
RETURN nTop

/* S13: the clipboard text inserted at the caret or over the selection.
 *   aLines  the buffer - NEVER written: the answer carries a new array
 *   aSel    the selection to replace, or NIL to insert at ( nLine, nCol )
 *   nLine   1-based line of the caret; nCol 0-based column
 *   cText   what Windows gave us: its breaks are CRLF (Windows), LF (a Unix
 *           tool) or a bare CR (an old Mac), and all three are ONE break here
 * Answers { aLines2, nLine2, nCol2 } with the caret right AFTER the pasted text,
 * or { NIL, nLine, nCol } when there is nothing to paste (no text, only breaks).
 * NIL is the flag the caller uses: two arrays are not compared by identity in
 * this code base, so the "nothing changed" answer must be a different value.
 * A text that ends with a break pastes exactly ONE break - the trailing empty
 * piece is the end of the last line, not a line of its own - while a blank line
 * in the middle IS kept. */
FUNCTION HcTextPaste( aLines, aSel, nLine, nCol, cText )
   LOCAL aOut, aRows, aSp, nL1, nC1, nL2, nC2, cHead, cTail, cNorm, i
   IF ! HB_ISARRAY( aLines ) .OR. Len( aLines ) == 0
      RETURN { NIL, nLine, nCol }
   ENDIF
   IF ValType( cText ) != "C" .OR. Len( cText ) == 0
      RETURN { NIL, nLine, nCol }
   ENDIF
   cNorm := StrTran( cText, Chr( 13 ) + Chr( 10 ), Chr( 10 ) )
   cNorm := StrTran( cNorm, Chr( 13 ), Chr( 10 ) )
   IF Right( cNorm, 1 ) == Chr( 10 )
      cNorm := Left( cNorm, Len( cNorm ) - 1 )
   ENDIF
   IF Len( cNorm ) == 0
      RETURN { NIL, nLine, nCol }
   ENDIF
   /* where it lands: the selection when there is one, the caret otherwise */
   nL1 := iif( ValType( nLine ) == "N", Int( nLine ), 1 )
   nL2 := nL1
   nC1 := iif( ValType( nCol ) == "N", Int( nCol ), 0 )
   nC2 := nC1
   aSp := HcSelNorm( aLines, aSel )
   IF HB_ISARRAY( aSp )
      nL1 := aSp[ HS_L1 ]
      nC1 := aSp[ HS_C1 ]
      nL2 := aSp[ HS_L2 ]
      nC2 := aSp[ HS_C2 ]
   ENDIF
   nL1 := Max( 1, Min( nL1, Len( aLines ) ) )
   nL2 := Max( 1, Min( nL2, Len( aLines ) ) )
   nC1 := Max( 0, Min( nC1, HcLenAt( aLines, nL1 ) ) )
   nC2 := Max( 0, Min( nC2, HcLenAt( aLines, nL2 ) ) )
   aRows := hb_ATokens( cNorm, Chr( 10 ) )
   cHead := Left( aLines[ nL1 ], nC1 )
   cTail := SubStr( aLines[ nL2 ], nC2 + 1 )
   /* the new buffer, piece by piece: what is above, the paste, what is below */
   aOut := {}
   FOR i := 1 TO nL1 - 1
      AAdd( aOut, aLines[ i ] )
   NEXT
   IF Len( aRows ) == 1
      AAdd( aOut, cHead + aRows[ 1 ] + cTail )
      nLine := Len( aOut )
      nCol := nC1 + Len( aRows[ 1 ] )
   ELSE
      AAdd( aOut, cHead + aRows[ 1 ] )
      FOR i := 2 TO Len( aRows ) - 1
         AAdd( aOut, aRows[ i ] )
      NEXT
      AAdd( aOut, aRows[ Len( aRows ) ] + cTail )
      nLine := Len( aOut )
      nCol := Len( aRows[ Len( aRows ) ] )
   ENDIF
   FOR i := nL2 + 1 TO Len( aLines )
      AAdd( aOut, aLines[ i ] )
   NEXT
RETURN { aOut, nLine, nCol }

/* S13: ONE clipboard action applied to the editor. The locals of the screen
 * come by reference (the shape of HcFindAct()), so the key loop calls this and
 * the answer is the note of the status row. Nothing is removed when the copy
 * failed, and nothing is marked as modified when the paste changed nothing. */
STATIC FUNCTION HcEditClipAct( cAct, aLines, aSel, nRow, nTop, nCol, nLft, aUndo, lMod, cNote, nVis, nW, cCdp )
   LOCAL cText, aRes, nLine
   IF ! HB_ISARRAY( aLines )
      RETURN cNote
   ENDIF
   DO CASE
   CASE cAct == "copy"
      IF HcSelEmpty( aSel )
         cNote := "Nothing to copy."
      ELSE
         /* the selection is FILE bytes and the clipboard speaks the code page
          * of the SCREEN (W32ClipPut() runs OemToCharA on what it receives),
          * so a UTF-8 file is converted before it leaves the buffer */
         cNote := iif( HcClipPutText( HcCdpConv( HcSelText( aLines, aSel ), ;
                                                cCdp, HcCdpScreen() ) ), ;
                       "Selection copied.", "Cannot copy." )
      ENDIF

   CASE cAct == "cut"
      IF HcSelEmpty( aSel )
         cNote := "Nothing to cut."
      ELSEIF ! HcClipPutText( HcCdpConv( HcSelText( aLines, aSel ), ;
                                         cCdp, HcCdpScreen() ) )
         /* it did not reach the clipboard, so it is NOT removed */
         cNote := "Cannot cut."
      ELSE
         aUndo := HcCopyLines( aLines )
         aRes := HcSelDrop( aLines, aSel )
         aLines := aRes[ 1 ]
         nLine  := aRes[ 2 ]
         nCol   := aRes[ 3 ]
         nTop   := HcCaretTop( nTop, nLine, Len( aLines ), nVis )
         nRow   := Max( 0, Min( nLine - nTop, nVis - 1 ) )
         nRow   := Max( 0, Min( nRow, Len( aLines ) - nTop ) )
         nCol   := Min( nCol, HcLenAt( aLines, nTop + nRow ) )
         nCol   := HcCdpCaret( aLines, nTop + nRow, nCol, cCdp )
         nLft   := HcFixLeft( nCol, nLft, nW )
         aSel   := NIL
         lMod   := .T.
         cNote  := "Selection cut."
      ENDIF

   CASE cAct == "paste"
      cText := HcClipGetText()
      IF Len( cText ) == 0
         cNote := "The clipboard has no text."
      ELSE
         /* the clipboard holds bytes of the code page of the SCREEN and the
          * buffer holds the one of the FILE, so what is pasted is ENCODED
          * first, exactly like a typed key (HcCdpKeyChar) - without this an
          * accent pasted into a UTF-8 file would leave a byte that is not
          * UTF-8. Nothing else changes: the undo record, the caret and the
          * modified flag below are the ones this action always had. */
         cText := HcCdpConv( cText, HcCdpScreen(), cCdp )
         aRes := HcTextPaste( aLines, aSel, nTop + nRow, nCol, cText )
         IF ! HB_ISARRAY( aRes[ 1 ] )
            cNote := "Nothing to paste."
         ELSE
            aUndo := HcCopyLines( aLines )
            aLines := aRes[ 1 ]
            nLine  := aRes[ 2 ]
            nCol   := aRes[ 3 ]
            nTop   := HcCaretTop( nTop, nLine, Len( aLines ), nVis )
            nRow   := Max( 0, Min( nLine - nTop, nVis - 1 ) )
            nRow   := Max( 0, Min( nRow, Len( aLines ) - nTop ) )
            nCol   := Min( nCol, HcLenAt( aLines, nTop + nRow ) )
            nCol   := HcCdpCaret( aLines, nTop + nRow, nCol, cCdp )
            nLft   := HcFixLeft( nCol, nLft, nW )
            aSel   := NIL
            lMod   := .T.
            cNote  := "Pasted."
         ENDIF
      ENDIF
   ENDCASE
RETURN cNote

/* =====================================================================
 *  S78..S80 -- code files: language, syntax colouring and indentation
 *
 *  The viewer and the editor of S5 (`HcFileScreen`) paint a CODE file with the
 *  dark scheme of S79 and leave a plain text file exactly as it always was.
 *  Everything with a rule in it is PURE and lives here, so the headless bank
 *  checks the whole model without a window:
 *
 *    HcLangOf()        the language, from the extension ("" = not code)
 *    HcCodeTokens()    one line -> { start 1-based, length, kind } segments
 *    HcIndentDetect()  the indent width the file already uses
 *    HcTabWidth()      the width the user typed in the F8 box
 *
 *  No RGB is added (§4): the seven pairs of S79 are built from palette entries
 *  that were already measured, the same way the Compare screen did it.
 * ===================================================================== */

/* S78: the language of a file, from its extension: case-insensitive and taken
 * after the LAST dot of the FILE NAME -- never of the path, because a folder
 * may have dots in it (C:\dir.v2\file.py is python). "" means "not code" and
 * the screen keeps the plain colours it always had. */
FUNCTION HcLangOf( cFile )
   LOCAL cName, nDot, cExt
   IF ValType( cFile ) != "C" .OR. Len( cFile ) == 0
      RETURN ""
   ENDIF
   cName := SubStr( cFile, Rat( "\", cFile ) + 1 )
   nDot := Rat( ".", cName )
   IF nDot == 0
      RETURN ""
   ENDIF
   cExt := Lower( SubStr( cName, nDot + 1 ) )
   DO CASE
   CASE cExt == "prg" .OR. cExt == "ch" .OR. cExt == "hb"
      RETURN "harbour"
   CASE cExt == "py" .OR. cExt == "pyw"
      RETURN "python"
   CASE cExt == "c" .OR. cExt == "h"
      RETURN "c"
   CASE cExt == "cpp" .OR. cExt == "cxx" .OR. cExt == "cc" .OR. ;
        cExt == "hpp" .OR. cExt == "hh" .OR. cExt == "hxx"
      RETURN "c++"
   CASE cExt == "js" .OR. cExt == "mjs" .OR. cExt == "json"
      RETURN "javascript"
   CASE cExt == "sql"
      RETURN "sql"
   CASE cExt == "bat" .OR. cExt == "cmd"
      RETURN "batch"
   ENDCASE
RETURN ""

/* S79: the reserved words of a language as ",WORD,WORD," (uppercase, the comma
 * at both ends is what makes the membership test exact: ",IF," is not in
 * ",ENDIF,"). Kept short on purpose: what an IDE user recognises at a glance,
 * not the complete grammar (the user asked for something simple). */
STATIC FUNCTION HcCodeKeywords( cLang )
   DO CASE
   CASE cLang == "harbour"
      RETURN ",IF,ELSE,ELSEIF,ENDIF,DO,WHILE,ENDDO,FOR,NEXT,STEP,TO,CASE,OTHERWISE," + ;
             "ENDCASE,SWITCH,ENDSWITCH,EXIT,LOOP,RETURN,FUNCTION,PROCEDURE,METHOD,CLASS," + ;
             "ENDCLASS,INIT,DATA,LOCAL,STATIC,PRIVATE,PUBLIC,MEMVAR,FIELD,DECLARE,WITH," + ;
             "ENDWITH,BEGIN,SEQUENCE,END,RECOVER,ALWAYS,DEFAULT,SET,USE,SELECT,STORE," + ;
             "EXTERNAL,REQUEST,AND,OR,NOT,NIL,TRUE,FALSE,IN,"
   CASE cLang == "python"
      RETURN ",AND,AS,ASSERT,ASYNC,AWAIT,BREAK,CLASS,CONTINUE,DEF,DEL,ELIF,ELSE,EXCEPT," + ;
             "FINALLY,FOR,FROM,GLOBAL,IF,IMPORT,IN,IS,LAMBDA,NONLOCAL,NOT,OR,PASS,RAISE," + ;
             "RETURN,TRY,WHILE,WITH,YIELD,TRUE,FALSE,NONE,SELF,PRINT,"
   CASE cLang == "c" .OR. cLang == "c++"
      RETURN ",AUTO,BREAK,CASE,CHAR,CONST,CONTINUE,DEFAULT,DO,DOUBLE,ELSE,ENUM,EXTERN," + ;
             "FLOAT,FOR,GOTO,IF,INT,LONG,REGISTER,RETURN,SHORT,SIGNED,SIZEOF,STATIC," + ;
             "STRUCT,SWITCH,TYPEDEF,UNION,UNSIGNED,VOID,VOLATILE,WHILE,CLASS,NAMESPACE," + ;
             "PUBLIC,PRIVATE,PROTECTED,TEMPLATE,TYPENAME,USING,VIRTUAL,NEW,DELETE," + ;
             "OPERATOR,EXPLICIT,BOOL,NULLPTR,CONSTEXPR,OVERRIDE,FRIEND,INLINE,THIS,TRUE,FALSE,"
   CASE cLang == "javascript"
      RETURN ",VAR,LET,CONST,FUNCTION,RETURN,IF,ELSE,FOR,WHILE,DO,SWITCH,CASE,BREAK," + ;
             "CONTINUE,NEW,DELETE,TYPEOF,INSTANCEOF,IN,OF,CLASS,EXTENDS,THIS,NULL," + ;
             "UNDEFINED,TRUE,FALSE,TRY,CATCH,FINALLY,THROW,ASYNC,AWAIT,IMPORT,FROM," + ;
             "EXPORT,DEFAULT,YIELD,VOID,"
   CASE cLang == "sql"
      RETURN ",SELECT,FROM,WHERE,INSERT,INTO,VALUES,UPDATE,SET,DELETE,CREATE,TABLE,DROP," + ;
             "ALTER,ADD,JOIN,LEFT,RIGHT,INNER,OUTER,ON,GROUP,BY,ORDER,HAVING,AS,AND,OR," + ;
             "NOT,NULL,IS,LIKE,BETWEEN,DISTINCT,COUNT,SUM,AVG,MIN,MAX,INDEX,PRIMARY,KEY," + ;
             "FOREIGN,REFERENCES,UNION,ALL,CASE,WHEN,THEN,ELSE,END,BEGIN,COMMIT,ROLLBACK," + ;
             "DESC,ASC,"
   CASE cLang == "batch"
      RETURN ",ECHO,OFF,ON,IF,EXIST,GOTO,CALL,SET,FOR,IN,DO,REM,EXIT,PAUSE,CD,DIR,COPY," + ;
             "DEL,MKDIR,RMDIR,ERRORLEVEL,NOT,DEFINED,ELSE,START,SHIFT,CHOICE,"
   ENDCASE
RETURN ""

STATIC FUNCTION HcIsDigit( cCh )
RETURN cCh >= "0" .AND. cCh <= "9"

STATIC FUNCTION HcIsHex( cCh )
   cCh := Upper( cCh )
RETURN HcIsDigit( cCh ) .OR. ( cCh >= "A" .AND. cCh <= "F" )

STATIC FUNCTION HcIsAlpha( cCh )
   cCh := Upper( cCh )
RETURN ( cCh >= "A" .AND. cCh <= "Z" ) .OR. cCh == "_"

STATIC FUNCTION HcIsIdentCh( cCh )
RETURN HcIsAlpha( cCh ) .OR. HcIsDigit( cCh )

/* S79: add { start, length, kind } to aOut, first flushing the pending PLAIN
 * run that started at nPlain (0 = none). nTo/nToEnd are 1-based and inclusive. */
STATIC FUNCTION HcTokAdd( aOut, nPlain, nTo, nToEnd, nKind )
   IF nPlain > 0 .AND. nTo > nPlain
      AAdd( aOut, { nPlain, nTo - nPlain, HC_TOK_PLAIN } )
   ENDIF
   IF nToEnd >= nTo
      AAdd( aOut, { nTo, nToEnd - nTo + 1, nKind } )
   ENDIF
RETURN aOut

/* S79: two touching tokens of the same kind become one, so the painter paints
 * one run instead of two and the bank can pin the shape of the whole line */
STATIC FUNCTION HcTokMerge( aOut )
   LOCAL i, aRes := {}
   FOR i := 1 TO Len( aOut )
      IF Len( aRes ) > 0 .AND. ;
         aRes[ Len( aRes ) ][ 3 ] == aOut[ i ][ 3 ] .AND. ;
         aRes[ Len( aRes ) ][ 1 ] + aRes[ Len( aRes ) ][ 2 ] == aOut[ i ][ 1 ]
         aRes[ Len( aRes ) ][ 2 ] += aOut[ i ][ 2 ]
      ELSE
         AAdd( aRes, { aOut[ i ][ 1 ], aOut[ i ][ 2 ], aOut[ i ][ 3 ] } )
      ENDIF
   NEXT
RETURN aRes

/* S79: ONE line of code as coloured segments: { start 1-based, length, kind }
 * covering the whole line, in order and without gaps -- which is what makes the
 * painting a simple walk. cLang is the answer of HcLangOf(); an empty or unknown
 * language gives the single PLAIN segment, so the caller needs no special case.
 *
 * It is a PER LINE scanner (S4): a block comment that opens and does not close
 * on the same line colours up to the end of THAT line and does not go on, and an
 * unterminated string does the same. Carrying that state across lines would mean
 * walking the buffer on every keystroke, and the user asked for something simple.
 */
FUNCTION HcCodeTokens( cLine, cLang )
   LOCAL nLen, nI, nPlain, j, c, nTo, nPos, cWord, nAfter, cKw, cLit1, cLit2, aOut
   LOCAL lStar, lRem, lBlock, lPre
   IF ValType( cLine ) != "C" .OR. Len( cLine ) == 0
      RETURN {}
   ENDIF
   nLen := Len( cLine )
   cLang := iif( ValType( cLang ) == "C", Lower( cLang ), "" )
   cKw := HcCodeKeywords( cLang )
   IF Empty( cKw )
      RETURN { { 1, nLen, HC_TOK_PLAIN } }
   ENDIF
   /* the markers of each language, once per call instead of per character */
   cLit1 := ""        /* the 1-char line comment            */
   cLit2 := ""        /* the 2-char line comment            */
   lStar := .F.       /* '*' in the first column            */
   lRem  := .F.       /* the REM word in the first column    */
   lBlock := .F.      /* the slash-star block comments       */
   lPre  := .F.       /* '#' in the first column is a directive */
   DO CASE
   CASE cLang == "harbour"
      cLit2 := "//" ; lStar := .T. ; lBlock := .T.
      /* Harbour also has '&&' as an inline marker: it is tested in the scan */
   CASE cLang == "python"
      cLit1 := "#"
   CASE cLang == "c" .OR. cLang == "c++" .OR. cLang == "javascript"
      cLit2 := "//" ; lBlock := .T. ; lPre := ( cLang != "javascript" )
   CASE cLang == "sql"
      cLit2 := "--"
   CASE cLang == "batch"
      cLit2 := "::" ; lRem := .T.
   ENDCASE

   aOut := {}
   nPlain := 0
   nI := 1
   DO WHILE nI <= nLen
      c := SubStr( cLine, nI, 1 )

      /* 1) a directive: the '#' of the first column in C takes the line */
      IF lPre .AND. nI == 1 .AND. c == "#"
         RETURN { { 1, nLen, HC_TOK_PRE } }
      ENDIF

      /* 2) a line comment takes the rest of the line */
      IF ( ! Empty( cLit1 ) .AND. c == cLit1 ) .OR. ;
         ( ! Empty( cLit2 ) .AND. SubStr( cLine, nI, 2 ) == cLit2 ) .OR. ;
         ( cLang == "harbour" .AND. SubStr( cLine, nI, 2 ) == "&&" ) .OR. ;
         ( lStar .AND. nI == 1 .AND. c == "*" ) .OR. ;
         ( lRem .AND. nI == 1 .AND. Upper( SubStr( cLine, 1, 3 ) ) == "REM" )
         RETURN HcTokMerge( HcTokAdd( aOut, nPlain, nI, nLen, HC_TOK_CMT ) )
      ENDIF

      /* 3) a block comment, when it closes on this line (S79 limitation) */
      IF lBlock .AND. SubStr( cLine, nI, 2 ) == "/*"
         nPos := At( "*/", SubStr( cLine, nI + 2 ) )
         nTo := iif( nPos == 0, nLen, nI + nPos + 2 )
         aOut := HcTokAdd( aOut, nPlain, nI, nTo, HC_TOK_CMT )
         nPlain := 0
         nI := nTo + 1
         LOOP
      ENDIF

      /* 4) a string: to its closing quote (a backslash escapes it) */
      IF c == Chr( 34 ) .OR. c == Chr( 39 ) .OR. ;
         ( c == Chr( 96 ) .AND. cLang == "javascript" )
         nTo := nI
         j := nI + 1
         DO WHILE j <= nLen
            IF SubStr( cLine, j, 1 ) == c
               nTo := j
               EXIT
            ENDIF
            j += iif( SubStr( cLine, j, 1 ) == "\" .AND. j < nLen, 2, 1 )
         ENDDO
         IF nTo == nI
            nTo := nLen          /* unterminated: to the end of the line */
         ENDIF
         aOut := HcTokAdd( aOut, nPlain, nI, nTo, HC_TOK_STR )
         nPlain := 0
         nI := nTo + 1
         LOOP
      ENDIF

      /* 5) a number: decimal with dots, or 0x hex */
      IF HcIsDigit( c )
         IF Upper( SubStr( cLine, nI, 2 ) ) == "0X"
            j := nI + 2
            DO WHILE j <= nLen .AND. HcIsHex( SubStr( cLine, j, 1 ) )
               j++
            ENDDO
         ELSE
            j := nI
            DO WHILE j <= nLen .AND. ;
               ( HcIsDigit( SubStr( cLine, j, 1 ) ) .OR. SubStr( cLine, j, 1 ) == "." )
               j++
            ENDDO
         ENDIF
         aOut := HcTokAdd( aOut, nPlain, nI, j - 1, HC_TOK_NUM )
         nPlain := 0
         nI := j
         LOOP
      ENDIF

      /* 6) a word: reserved word, function name (it opens a parenthesis) or
       *    just another identifier of the plain run */
      IF HcIsAlpha( c )
         j := nI + 1
         DO WHILE j <= nLen .AND. HcIsIdentCh( SubStr( cLine, j, 1 ) )
            j++
         ENDDO
         cWord := Upper( SubStr( cLine, nI, j - nI ) )
         IF ( "," + cWord + "," ) $ cKw
            aOut := HcTokAdd( aOut, nPlain, nI, j - 1, HC_TOK_KEY )
            nPlain := 0
         ELSE
            nAfter := j
            DO WHILE nAfter <= nLen .AND. SubStr( cLine, nAfter, 1 ) == " "
               nAfter++
            ENDDO
            IF nAfter <= nLen .AND. SubStr( cLine, nAfter, 1 ) == "("
               aOut := HcTokAdd( aOut, nPlain, nI, j - 1, HC_TOK_FUNC )
               nPlain := 0
            ELSEIF nPlain == 0
               nPlain := nI
            ENDIF
         ENDIF
         nI := j
         LOOP
      ENDIF

      /* 7) anything else belongs to the plain run */
      IF nPlain == 0
         nPlain := nI
      ENDIF
      nI++
   ENDDO
   IF nPlain > 0
      AAdd( aOut, { nPlain, nLen - nPlain + 1, HC_TOK_PLAIN } )
   ENDIF
RETURN HcTokMerge( aOut )

/* S79: the colour of one kind of token. All of them keep the dark background,
 * so a line never looks like a patchwork. */
STATIC FUNCTION HcCodePair( nKind )
   DO CASE
   CASE nKind == HC_TOK_KEY  ; RETURN UI_C_CODEKEY
   CASE nKind == HC_TOK_STR  ; RETURN UI_C_CODESTR
   CASE nKind == HC_TOK_CMT  ; RETURN UI_C_CODECMT
   CASE nKind == HC_TOK_NUM  ; RETURN UI_C_CODENUM
   CASE nKind == HC_TOK_FUNC ; RETURN UI_C_CODEFUNC
   CASE nKind == HC_TOK_PRE  ; RETURN UI_C_CODEPRE
   ENDCASE
RETURN UI_C_DARK

/* S79: one row of a code file. The line is painted segment by segment and only
 * what falls inside the horizontal window (nLft) is drawn; the tail is filled
 * with the body colour so a short line covers the row like the plain screen.
 * S4 of hc-codepage.md: cLine is the DISPLAY line (already translated by
 * HcCdpShow(), one byte per cell) and nLft is a CELL column, so the token
 * offsets, the window and the SAY columns are all in the same units. */
STATIC PROCEDURE HcCodeRow( cLine, nRow, nLft, nW, cLang )
   LOCAL aTok := HcCodeTokens( cLine, cLang ), i, nA, nB, nDrawn := 0
   FOR i := 1 TO Len( aTok )
      nA := Max( aTok[ i ][ 1 ], nLft + 1 )
      nB := Min( aTok[ i ][ 1 ] + aTok[ i ][ 2 ] - 1, nLft + nW )
      IF nB >= nA
         SetColor( HcCodePair( aTok[ i ][ 3 ] ) )
         @ nRow, nA - nLft - 1 SAY SubStr( cLine, nA, nB - nA + 1 )
         nDrawn := nB - nLft
      ENDIF
   NEXT
   IF nDrawn < nW
      SetColor( UI_C_DARK )
      @ nRow, nDrawn SAY Space( nW - nDrawn )
   ENDIF
RETURN

/* S80: the indent width a file already uses, so `Tab` continues what it has.
 * Only lines indented with SPACES are evidence: the smallest positive prefix
 * wins (a 4-space file whose continuation lines carry 5 or 6 spaces is still
 * 4), clamped to 1..8. A file indented only with tabs, or one with nothing
 * indented, keeps the default. The buffer is never touched. */
FUNCTION HcIndentDetect( aLines, nDefault )
   LOCAL i, cLine, n, nBest := 0
   IF ValType( nDefault ) != "N" .OR. nDefault < 1 .OR. nDefault > 8
      nDefault := 4
   ENDIF
   IF ! HB_ISARRAY( aLines )
      RETURN nDefault
   ENDIF
   FOR i := 1 TO Len( aLines )
      IF ValType( aLines[ i ] ) != "C" .OR. Len( aLines[ i ] ) == 0
         LOOP
      ENDIF
      cLine := aLines[ i ]
      IF Left( cLine, 1 ) == Chr( 9 )
         LOOP                      /* tab-indented: no evidence of a width */
      ENDIF
      n := 0
      DO WHILE n < Len( cLine ) .AND. SubStr( cLine, n + 1, 1 ) == " "
         n++
      ENDDO
      IF n == 0 .OR. n == Len( cLine )
         LOOP                      /* not indented, or a blank line */
      ENDIF
      IF nBest == 0 .OR. n < nBest
         nBest := n
      ENDIF
   NEXT
   IF nBest == 0
      RETURN nDefault
   ENDIF
RETURN Min( 8, nBest )

/* S80: the width the user typed in the F8 box. Only 1..8 is accepted; an empty
 * answer, something that is not a number or anything out of range keeps the
 * value the screen already had (so a typo never sets a 0-space indent). */
FUNCTION HcTabWidth( cIn, nOld )
   IF ValType( nOld ) != "N" .OR. nOld < 1 .OR. nOld > 8
      nOld := 4
   ENDIF
   IF ValType( cIn ) != "C"
      RETURN nOld
   ENDIF
   cIn := AllTrim( cIn )
   IF Len( cIn ) == 0 .OR. ! ( cIn $ "12345678" )
      RETURN nOld
   ENDIF
RETURN Val( cIn )

/* one typed character: inserted, or overwriting the one under the caret when
 * the buffer is in insert-overwrite mode. nBytes (S4 of hc-codepage.md, optional
 * and 1 by default, which is what every older caller gets) is how many BYTES the
 * character under the caret takes: in a multi-byte code page overwriting replaces
 * the WHOLE character, so a two-byte UTF-8 accent becomes the one typed and not
 * a lead byte followed by the tail of the old one. */
STATIC FUNCTION HcEditorPut( cLine, nCol, cChar, lOver, nBytes )
   IF ValType( nBytes ) != "N" .OR. nBytes < 1
      nBytes := 1
   ENDIF
   IF lOver .AND. nCol < Len( cLine )
      RETURN Stuff( cLine, nCol + 1, nBytes, cChar )
   ENDIF
RETURN Stuff( cLine, nCol + 1, 0, cChar )

/* =====================================================================
 *  Pretty print of JSON and XML (S1..S9 of odd/tasks/hc-pretty-print.md)
 *
 *  The viewer and the editor of S5 reformat a JSON or an XML text so a person
 *  can read it. Everything here is PURE - strings and arrays, no window, no
 *  disk, no global state - so the headless bank checks the whole model:
 *
 *    HcPrettyKind()  the kind of a file from its extension ("" = not one)
 *    HcPrettyText()  the lines of the buffer -> the formatted lines
 *
 *  The rules that make it safe:
 *    - the content is PRESERVED byte by byte: JSON strings and numbers are
 *      copied verbatim (no unescaping, no re-escaping) and so are XML
 *      attributes, comments, CDATA, entities and text nodes; only the
 *      INSIGNIFICANT whitespace between tokens is rewritten, plus the
 *      whitespace-only text of an element that has children (which is the
 *      whitespace a pretty printer introduces in the first place);
 *    - an element with MIXED content (text AND children) is copied as an
 *      OPAQUE block - exactly as it was - because re-indenting it would change
 *      what a browser paints;
 *    - anything invalid is refused with a message that says where, and the
 *      buffer is not touched by the caller.
 * ===================================================================== */

/* how deep a document may nest before the formatter refuses. A 4 MB file of
 * `[[[[ ...` would otherwise produce an output that grows with the SQUARE of
 * the depth and eat all memory, so the cap is the guard, not a style rule. */
#define HP_MAXDEPTH 400
/* and how many lines the answer may have (HE_MAXSIZE / a short line) */
#define HP_MAXLINES 400000

/* the state array both formatters share: where the scan stands, the line being
 * built, the lines finished, the error, the depth, the source and the width.
 * Arrays are REFERENCES in Harbour (trap 67), so the helpers below modify the
 * caller's state on purpose - that is the whole design. */
#define HP_POS   1
#define HP_CUR   2
#define HP_OUT   3
#define HP_ERR   4
#define HP_DEP   5
#define HP_SRC   6
#define HP_W     7

/* one XML token: what it is, its raw source text, the element name, the two
 * source offsets and the index of its matching END (0 = not an element) */
#define HX_KIND  1
#define HX_TEXT  2
#define HX_NAME  3
#define HX_FROM  4
#define HX_TO    5
#define HX_END   6

/* S1: the kind of a file, from its extension: case-insensitive and taken after
 * the LAST dot of the FILE NAME - never of the path, exactly like HcLangOf().
 * Only the two the user asked for; adding another one is one CASE here. */
FUNCTION HcPrettyKind( cFile )
   LOCAL cName, nDot, cExt
   IF ValType( cFile ) != "C" .OR. Len( cFile ) == 0
      RETURN ""
   ENDIF
   cName := SubStr( cFile, Rat( "\", cFile ) + 1 )
   nDot := Rat( ".", cName )
   IF nDot == 0
      RETURN ""
   ENDIF
   cExt := Lower( SubStr( cName, nDot + 1 ) )
   DO CASE
   CASE cExt == "json"
      RETURN "json"
   CASE cExt == "xml"
      RETURN "xml"
   ENDCASE
RETURN ""

/* S2: the buffer of lines -> { lOk, aLines, cError }. PURE: the answer is a NEW
 * array and the caller's is never written. `aLines` EMPTY on success means
 * "there is nothing to format" (a blank file), which the caller reports without
 * a box. `nWidth` is the indent width (1..8; anything else is 4) and comes from
 * the screen (the same number F8 moves).
 *
 * The buffer holds the bytes of the file in its own code page. JSON and XML are
 * ASCII-structural, and every byte >= 128 is outside the ASCII range, so the
 * scan sees the same delimiters in UTF-8, ES850 or any other code page and the
 * bytes of the text are copied untouched. */
FUNCTION HcPrettyText( aLines, cKind, nWidth )
   LOCAL cSrc, cBom := "", aRes
   IF ! HB_ISARRAY( aLines ) .OR. Len( aLines ) == 0
      aLines := { "" }
   ENDIF
   IF ValType( nWidth ) != "N" .OR. nWidth < 1 .OR. nWidth > 8
      nWidth := 4
   ENDIF
   cKind := iif( ValType( cKind ) == "C", Lower( AllTrim( cKind ) ), "" )
   IF ! ( cKind == "json" ) .AND. ! ( cKind == "xml" )
      RETURN { .F., {}, "Only JSON and XML files can be pretty printed." }
   ENDIF
   cSrc := HcJoinLines( aLines )
   /* a UTF-8 BOM is not part of the document: it is taken out of the scan and
    * put back on the first line, so the file keeps its bytes */
   IF Left( cSrc, 3 ) == hb_HexToStr( "EFBBBF" )
      cBom := Left( cSrc, 3 )
      cSrc := SubStr( cSrc, 4 )
   ENDIF
   IF cKind == "json"
      aRes := HcJsonPretty( cSrc, nWidth )
   ELSE
      aRes := HcXmlPretty( cSrc, nWidth )
   ENDIF
   IF aRes[ 1 ] .AND. ! Empty( cBom ) .AND. Len( aRes[ 2 ] ) > 0
      aRes[ 2 ][ 1 ] := cBom + aRes[ 2 ][ 1 ]
   ENDIF
RETURN aRes

/* ---- shared helpers ---------------------------------------------------- */

/* S8: " at line N, column M" for an error, " at the end of the data" when the
 * scan ran past the source. Only errors pay this walk. */
STATIC FUNCTION HcPrettyWhere( cSrc, nPos )
   LOCAL nLine := 1, nLast := 0, i, nCol
   IF ValType( cSrc ) != "C" .OR. Len( cSrc ) == 0
      RETURN ""
   ENDIF
   IF ValType( nPos ) != "N" .OR. nPos > Len( cSrc )
      RETURN " at the end of the data"
   ENDIF
   FOR i := 1 TO nPos
      IF SubStr( cSrc, i, 1 ) == Chr( 10 )
         nLine++
         nLast := i
      ENDIF
   NEXT
   nCol := nPos - nLast
RETURN " at line " + LTrim( Str( nLine ) ) + ", column " + LTrim( Str( nCol ) )

/* S2: the lines the formatter answers are cut with the same rule the viewer
 * uses, so a token that carries line breaks of its own (a multi-line comment, a
 * CDATA block, an opaque mixed element) becomes several rows of the buffer and
 * never a line with control characters inside. */
STATIC PROCEDURE HcPrettyAdd( aOut, cText, nIndent )
   LOCAL a := HcSplitLines( cText ), k
   IF ValType( cText ) != "C" .OR. Len( cText ) == 0
      RETURN
   ENDIF
   AAdd( aOut, Space( nIndent ) + a[ 1 ] )
   FOR k := 2 TO Len( a )
      AAdd( aOut, a[ k ] )
   NEXT
RETURN

/* =====================================================================
 *  JSON
 * ===================================================================== */

STATIC FUNCTION HcJpPeek( aSt )
   IF aSt[ HP_POS ] > Len( aSt[ HP_SRC ] )
      RETURN ""
   ENDIF
RETURN SubStr( aSt[ HP_SRC ], aSt[ HP_POS ], 1 )

STATIC FUNCTION HcJpIsWs( c )
   IF ValType( c ) != "C"
      RETURN .F.
   ENDIF
RETURN c == " " .OR. c == Chr( 9 ) .OR. c == Chr( 10 ) .OR. c == Chr( 13 )

STATIC PROCEDURE HcJpSkipWs( aSt )
   LOCAL cSrc := aSt[ HP_SRC ]
   DO WHILE aSt[ HP_POS ] <= Len( cSrc )
      IF ! HcJpIsWs( SubStr( cSrc, aSt[ HP_POS ], 1 ) )
         EXIT
      ENDIF
      aSt[ HP_POS ]++
   ENDDO
RETURN

STATIC FUNCTION HcJpErr( aSt, cWhat )
   IF Empty( aSt[ HP_ERR ] )
      aSt[ HP_ERR ] := "Invalid JSON: " + cWhat + ;
                       HcPrettyWhere( aSt[ HP_SRC ], aSt[ HP_POS ] ) + "."
   ENDIF
RETURN .F.

STATIC PROCEDURE HcJpEndLine( aSt )
   LOCAL aOut := aSt[ HP_OUT ]
   AAdd( aOut, aSt[ HP_CUR ] )
   aSt[ HP_OUT ] := aOut
   aSt[ HP_CUR ] := ""
RETURN

/* S5: the cap of the output, checked in every loop that can add lines */
STATIC FUNCTION HcJpRoom( aSt )
   IF Len( aSt[ HP_OUT ] ) > HP_MAXLINES
      RETURN HcJpErr( aSt, "the formatted text is too large for this screen" )
   ENDIF
RETURN .T.

/* the raw text of a JSON string INCLUDING its quotes, or NIL when it is not
 * one. Escapes are validated (the six short ones and \uXXXX) but never
 * rewritten: what the file says is what comes out. */
STATIC FUNCTION HcJpStr( aSt )
   LOCAL cSrc := aSt[ HP_SRC ], nStart := aSt[ HP_POS ], c, c2, k
   aSt[ HP_POS ]++
   DO WHILE aSt[ HP_POS ] <= Len( cSrc )
      c := SubStr( cSrc, aSt[ HP_POS ], 1 )
      IF c == '"'
         aSt[ HP_POS ]++
         RETURN SubStr( cSrc, nStart, aSt[ HP_POS ] - nStart )
      ENDIF
      IF c == "\"
         aSt[ HP_POS ]++
         c2 := SubStr( cSrc, aSt[ HP_POS ], 1 )
         IF Empty( c2 )
            HcJpErr( aSt, "unterminated string" )
            RETURN NIL
         ENDIF
         IF c2 == "u"
            FOR k := 1 TO 4
               IF ! HcIsHex( SubStr( cSrc, aSt[ HP_POS ] + k, 1 ) )
                  HcJpErr( aSt, "invalid \u escape" )
                  RETURN NIL
               ENDIF
            NEXT
            aSt[ HP_POS ] += 5
         ELSEIF c2 == '"' .OR. c2 == "\" .OR. c2 == "/" .OR. c2 == "b" .OR. ;
                c2 == "f" .OR. c2 == "n" .OR. c2 == "r" .OR. c2 == "t"
            aSt[ HP_POS ]++
         ELSE
            HcJpErr( aSt, "invalid escape" )
            RETURN NIL
         ENDIF
      ELSEIF Asc( c ) < 32
         HcJpErr( aSt, "control character in a string" )
         RETURN NIL
      ELSE
         aSt[ HP_POS ]++
      ENDIF
   ENDDO
   HcJpErr( aSt, "unterminated string" )
RETURN NIL

/* a number, verbatim: -?(0|[1-9]\d*)(\.\d+)?([eE][+-]?\d+)? -- 1.50 stays 1.50 */
STATIC FUNCTION HcJpNum( aSt )
   LOCAL cSrc := aSt[ HP_SRC ], nStart := aSt[ HP_POS ], c
   c := SubStr( cSrc, aSt[ HP_POS ], 1 )
   IF c == "-"
      aSt[ HP_POS ]++
      c := SubStr( cSrc, aSt[ HP_POS ], 1 )
   ENDIF
   IF c == "0"
      aSt[ HP_POS ]++
      c := SubStr( cSrc, aSt[ HP_POS ], 1 )
      IF HcIsDigit( c )
         HcJpErr( aSt, "a number cannot start with a zero" )
         RETURN NIL
      ENDIF
   ELSEIF c >= "1" .AND. c <= "9"
      DO WHILE HcIsDigit( SubStr( cSrc, aSt[ HP_POS ], 1 ) )
         aSt[ HP_POS ]++
      ENDDO
   ELSE
      HcJpErr( aSt, "invalid number" )
      RETURN NIL
   ENDIF
   IF SubStr( cSrc, aSt[ HP_POS ], 1 ) == "."
      aSt[ HP_POS ]++
      IF ! HcIsDigit( SubStr( cSrc, aSt[ HP_POS ], 1 ) )
         HcJpErr( aSt, "invalid number" )
         RETURN NIL
      ENDIF
      DO WHILE HcIsDigit( SubStr( cSrc, aSt[ HP_POS ], 1 ) )
         aSt[ HP_POS ]++
      ENDDO
   ENDIF
   c := SubStr( cSrc, aSt[ HP_POS ], 1 )
   IF c == "e" .OR. c == "E"
      aSt[ HP_POS ]++
      c := SubStr( cSrc, aSt[ HP_POS ], 1 )
      IF c == "+" .OR. c == "-"
         aSt[ HP_POS ]++
      ENDIF
      IF ! HcIsDigit( SubStr( cSrc, aSt[ HP_POS ], 1 ) )
         HcJpErr( aSt, "invalid number" )
         RETURN NIL
      ENDIF
      DO WHILE HcIsDigit( SubStr( cSrc, aSt[ HP_POS ], 1 ) )
         aSt[ HP_POS ]++
      ENDDO
   ENDIF
RETURN SubStr( cSrc, nStart, aSt[ HP_POS ] - nStart )

/* true / false / null */
STATIC FUNCTION HcJpLit( aSt )
   LOCAL cSrc := aSt[ HP_SRC ], aOpt := { "true", "false", "null" }, i, cWord
   FOR i := 1 TO Len( aOpt )
      cWord := aOpt[ i ]
      IF SubStr( cSrc, aSt[ HP_POS ], Len( cWord ) ) == cWord
         aSt[ HP_POS ] += Len( cWord )
         IF HcIsIdentCh( SubStr( cSrc, aSt[ HP_POS ], 1 ) )
            HcJpErr( aSt, "unexpected character after '" + cWord + "'" )
            RETURN NIL
         ENDIF
         RETURN cWord
      ENDIF
   NEXT
   HcJpErr( aSt, "unexpected '" + HcJpPeek( aSt ) + "'" )
RETURN NIL

/* one value. `lInline` says the line has already been started (a member of an
 * object writes `  "key": ` before calling this). The value LEAVES the line
 * open: the caller adds the comma and closes it, which is what makes a nested
 * container land on the line of its key. */
STATIC FUNCTION HcJpValue( aSt, nInd, lInline )
   LOCAL c, cTok
   /* the whitespace is skipped HERE, because the value can follow a ':' with a
    * space between them (`"key": [`), which is exactly what the formatter
    * itself writes */
   HcJpSkipWs( aSt )
   c := HcJpPeek( aSt )
   DO CASE
   CASE c == "{"
      RETURN HcJpObj( aSt, nInd, lInline )
   CASE c == "["
      RETURN HcJpArr( aSt, nInd, lInline )
   CASE c == '"'
      cTok := HcJpStr( aSt )
   CASE c == "-" .OR. HcIsDigit( c )
      cTok := HcJpNum( aSt )
   CASE c == "t" .OR. c == "f" .OR. c == "n"
      cTok := HcJpLit( aSt )
   OTHERWISE
      IF Empty( c )
         RETURN HcJpErr( aSt, "unexpected end of the data" )
      ENDIF
      RETURN HcJpErr( aSt, "unexpected character '" + c + "'" )
   ENDCASE
   IF ! HB_ISSTRING( cTok )
      RETURN .F.
   ENDIF
   IF ! lInline
      aSt[ HP_CUR ] := Space( nInd )
   ENDIF
   aSt[ HP_CUR ] += cTok
RETURN .T.

STATIC FUNCTION HcJpObj( aSt, nInd, lInline )
   LOCAL cKey, c
   aSt[ HP_POS ]++                        /* the '{' */
   aSt[ HP_DEP ]++
   IF aSt[ HP_DEP ] > HP_MAXDEPTH
      RETURN HcJpErr( aSt, "the text is nested too deeply" )
   ENDIF
   IF ! lInline
      aSt[ HP_CUR ] := Space( nInd )
   ENDIF
   aSt[ HP_CUR ] += "{"
   HcJpSkipWs( aSt )
   IF HcJpPeek( aSt ) == "}"
      aSt[ HP_POS ]++
      aSt[ HP_DEP ]--
      aSt[ HP_CUR ] += "}"
      RETURN .T.
   ENDIF
   HcJpEndLine( aSt )
   DO WHILE .T.
      IF ! HcJpRoom( aSt )
         RETURN .F.
      ENDIF
      HcJpSkipWs( aSt )
      IF HcJpPeek( aSt ) != '"'
         RETURN HcJpErr( aSt, "a member name has to be in double quotes" )
      ENDIF
      cKey := HcJpStr( aSt )
      IF ! HB_ISSTRING( cKey )
         RETURN .F.
      ENDIF
      HcJpSkipWs( aSt )
      IF HcJpPeek( aSt ) != ":"
         RETURN HcJpErr( aSt, "expected ':'" )
      ENDIF
      aSt[ HP_POS ]++
      aSt[ HP_CUR ] := Space( nInd + aSt[ HP_W ] ) + cKey + ": "
      IF ! HcJpValue( aSt, nInd + aSt[ HP_W ], .T. )
         RETURN .F.
      ENDIF
      HcJpSkipWs( aSt )
      c := HcJpPeek( aSt )
      IF c == ","
         aSt[ HP_CUR ] += ","
         aSt[ HP_POS ]++
         HcJpEndLine( aSt )
         LOOP
      ENDIF
      IF c == "}"
         aSt[ HP_POS ]++
         aSt[ HP_DEP ]--
         HcJpEndLine( aSt )
         aSt[ HP_CUR ] := Space( nInd ) + "}"
         RETURN .T.
      ENDIF
      RETURN HcJpErr( aSt, "expected ',' or '}'" )
   ENDDO
RETURN .T.

STATIC FUNCTION HcJpArr( aSt, nInd, lInline )
   LOCAL c
   aSt[ HP_POS ]++                        /* the '[' */
   aSt[ HP_DEP ]++
   IF aSt[ HP_DEP ] > HP_MAXDEPTH
      RETURN HcJpErr( aSt, "the text is nested too deeply" )
   ENDIF
   IF ! lInline
      aSt[ HP_CUR ] := Space( nInd )
   ENDIF
   aSt[ HP_CUR ] += "["
   HcJpSkipWs( aSt )
   IF HcJpPeek( aSt ) == "]"
      aSt[ HP_POS ]++
      aSt[ HP_DEP ]--
      aSt[ HP_CUR ] += "]"
      RETURN .T.
   ENDIF
   HcJpEndLine( aSt )
   DO WHILE .T.
      IF ! HcJpRoom( aSt )
         RETURN .F.
      ENDIF
      HcJpSkipWs( aSt )
      IF ! HcJpValue( aSt, nInd + aSt[ HP_W ], .F. )
         RETURN .F.
      ENDIF
      HcJpSkipWs( aSt )
      c := HcJpPeek( aSt )
      IF c == ","
         aSt[ HP_CUR ] += ","
         aSt[ HP_POS ]++
         HcJpEndLine( aSt )
         LOOP
      ENDIF
      IF c == "]"
         aSt[ HP_POS ]++
         aSt[ HP_DEP ]--
         HcJpEndLine( aSt )
         aSt[ HP_CUR ] := Space( nInd ) + "]"
         RETURN .T.
      ENDIF
      RETURN HcJpErr( aSt, "expected ',' or ']'" )
   ENDDO
RETURN .T.

STATIC FUNCTION HcJsonPretty( cSrc, nW )
   LOCAL aSt := { 1, "", {}, "", 0, cSrc, nW }
   HcJpSkipWs( aSt )
   IF HcJpPeek( aSt ) == ""
      RETURN { .T., {}, "" }              /* nothing but whitespace */
   ENDIF
   IF ! HcJpValue( aSt, 0, .F. )
      RETURN { .F., {}, aSt[ HP_ERR ] }
   ENDIF
   HcJpSkipWs( aSt )
   IF ! Empty( HcJpPeek( aSt ) )
      HcJpErr( aSt, "unexpected character '" + HcJpPeek( aSt ) + "' after the value" )
      RETURN { .F., {}, aSt[ HP_ERR ] }
   ENDIF
   HcJpEndLine( aSt )
   IF ! HcJpRoom( aSt )
      RETURN { .F., {}, aSt[ HP_ERR ] }
   ENDIF
RETURN { .T., aSt[ HP_OUT ], "" }

/* =====================================================================
 *  XML
 * ===================================================================== */

STATIC FUNCTION HcXmlWhy( cSrc, nPos, cWhat )
RETURN "Invalid XML: " + cWhat + HcPrettyWhere( cSrc, nPos ) + "."

/* position of cWhat at or after nFrom, or 0. At() has no start offset in this
 * build, so the tail is searched and the offset added back. */
STATIC FUNCTION HcXmlFind( cSrc, cWhat, nFrom )
   LOCAL n
   IF nFrom < 1
      nFrom := 1
   ENDIF
   IF nFrom > Len( cSrc )
      RETURN 0
   ENDIF
   n := At( cWhat, SubStr( cSrc, nFrom ) )
   IF n == 0
      RETURN 0
   ENDIF
RETURN nFrom + n - 1

STATIC FUNCTION HcXmlSkipWs( cSrc, nPos )
   DO WHILE nPos <= Len( cSrc )
      IF ! HcJpIsWs( SubStr( cSrc, nPos, 1 ) )
         EXIT
      ENDIF
      nPos++
   ENDDO
RETURN nPos

/* the position of the '>' that closes the tag that starts at nPos, honoring
 * quotes and the [ ... ] of a DOCTYPE internal subset; 0 when it never closes */
STATIC FUNCTION HcXmlTagEnd( cSrc, nPos )
   LOCAL nLen := Len( cSrc ), i := nPos, c, lQ := .F., cQ := "", nBr := 0
   DO WHILE i <= nLen
      c := SubStr( cSrc, i, 1 )
      IF lQ
         IF c == cQ
            lQ := .F.
         ENDIF
      ELSEIF c == '"' .OR. c == "'"
         lQ := .T.
         cQ := c
      ELSEIF c == "["
         nBr++
      ELSEIF c == "]"
         nBr := Max( 0, nBr - 1 )
      ELSEIF c == ">"
         IF nBr == 0
            RETURN i
         ENDIF
      ENDIF
      i++
   ENDDO
RETURN 0

/* an XML name from nPos: { name, position after it }; name is "" when the
 * character there cannot start one */
STATIC FUNCTION HcXmlName( cSrc, nPos )
   LOCAL nLen := Len( cSrc ), n, c
   IF nPos < 1 .OR. nPos > nLen
      RETURN { "", nPos }
   ENDIF
   c := SubStr( cSrc, nPos, 1 )
   IF ! ( HcIsAlpha( c ) .OR. c == ":" )
      RETURN { "", nPos }
   ENDIF
   n := nPos + 1
   DO WHILE n <= nLen
      c := SubStr( cSrc, n, 1 )
      IF HcIsIdentCh( c ) .OR. c == ":" .OR. c == "-" .OR. c == "."
         n++
      ELSE
         EXIT
      ENDIF
   ENDDO
RETURN { SubStr( cSrc, nPos, n - nPos ), n }

/* does this text carry anything but XML whitespace? Spaces inside a text node
 * ARE content, so only the four whitespace characters are ignored. */
STATIC FUNCTION HcXmlTextOn( cText )
   LOCAL i, c
   IF ValType( cText ) != "C"
      RETURN .F.
   ENDIF
   FOR i := 1 TO Len( cText )
      c := SubStr( cText, i, 1 )
      IF ! ( c == " " .OR. c == Chr( 9 ) .OR. c == Chr( 10 ) .OR. c == Chr( 13 ) )
         RETURN .T.
      ENDIF
   NEXT
RETURN .F.

/* the source as a flat array of tokens: { kind, raw text, name, from, to, end }.
 * Kinds: T text, S start tag, E end tag, Z self-closing tag, C comment, D CDATA,
 * P processing instruction, O declaration (DOCTYPE). A malformed document is
 * refused HERE, with the position of the problem. */
STATIC FUNCTION HcXmlTokens( cSrc )
   LOCAL aTok := {}, nPos := 1, nLen := Len( cSrc ), nFrom, nTo, nNext
   LOCAL cName, cKind, aNm, c

   DO WHILE nPos <= nLen
      /* S7: the tokens are arrays, so a pathological document (a million empty
       * tags) is refused BEFORE the list eats the memory */
      IF Len( aTok ) > HP_MAXLINES * 2
         RETURN { .F., {}, "Invalid XML: the formatted text is too large for this screen." }
      ENDIF
      IF SubStr( cSrc, nPos, 1 ) != "<"
         nFrom := nPos
         nTo := HcXmlFind( cSrc, "<", nPos )
         IF nTo == 0
            nTo := nLen + 1
         ENDIF
         AAdd( aTok, { "T", SubStr( cSrc, nFrom, nTo - nFrom ), "", nFrom, nTo - 1, 0 } )
         nPos := nTo
         LOOP
      ENDIF
      nFrom := nPos
      IF SubStr( cSrc, nPos, 4 ) == "<!--"
         nTo := HcXmlFind( cSrc, "-->", nPos + 4 )
         IF nTo == 0
            RETURN { .F., {}, HcXmlWhy( cSrc, nFrom, "unterminated comment" ) }
         ENDIF
         AAdd( aTok, { "C", SubStr( cSrc, nFrom, nTo + 2 - nFrom + 1 ), "", nFrom, nTo + 2, 0 } )
         nPos := nTo + 3
      ELSEIF SubStr( cSrc, nPos, 9 ) == "<![CDATA["
         nTo := HcXmlFind( cSrc, "]]>", nPos + 9 )
         IF nTo == 0
            RETURN { .F., {}, HcXmlWhy( cSrc, nFrom, "unterminated CDATA section" ) }
         ENDIF
         AAdd( aTok, { "D", SubStr( cSrc, nFrom, nTo + 2 - nFrom + 1 ), "", nFrom, nTo + 2, 0 } )
         nPos := nTo + 3
      ELSEIF SubStr( cSrc, nPos, 2 ) == "<?"
         nTo := HcXmlFind( cSrc, "?>", nPos + 2 )
         IF nTo == 0
            RETURN { .F., {}, HcXmlWhy( cSrc, nFrom, "unterminated processing instruction" ) }
         ENDIF
         AAdd( aTok, { "P", SubStr( cSrc, nFrom, nTo + 1 - nFrom + 1 ), "", nFrom, nTo + 1, 0 } )
         nPos := nTo + 2
      ELSEIF SubStr( cSrc, nPos, 2 ) == "<!"
         nTo := HcXmlTagEnd( cSrc, nPos + 2 )
         IF nTo == 0
            RETURN { .F., {}, HcXmlWhy( cSrc, nFrom, "unterminated declaration" ) }
         ENDIF
         AAdd( aTok, { "O", SubStr( cSrc, nFrom, nTo - nFrom + 1 ), "", nFrom, nTo, 0 } )
         nPos := nTo + 1
      ELSEIF SubStr( cSrc, nPos, 2 ) == "</"
         aNm   := HcXmlName( cSrc, nPos + 2 )
         cName := aNm[ 1 ]
         nNext := HcXmlSkipWs( cSrc, aNm[ 2 ] )
         IF Empty( cName )
            RETURN { .F., {}, HcXmlWhy( cSrc, nFrom, "invalid end tag" ) }
         ENDIF
         IF SubStr( cSrc, nNext, 1 ) != ">"
            RETURN { .F., {}, HcXmlWhy( cSrc, nNext, "expected '>'" ) }
         ENDIF
         AAdd( aTok, { "E", SubStr( cSrc, nFrom, nNext - nFrom + 1 ), cName, nFrom, nNext, 0 } )
         nPos := nNext + 1
      ELSE
         aNm   := HcXmlName( cSrc, nPos + 1 )
         cName := aNm[ 1 ]
         IF Empty( cName )
            RETURN { .F., {}, HcXmlWhy( cSrc, nFrom, "invalid tag name" ) }
         ENDIF
         nTo := HcXmlTagEnd( cSrc, aNm[ 2 ] )
         IF nTo == 0
            RETURN { .F., {}, HcXmlWhy( cSrc, nFrom, "unterminated tag" ) }
         ENDIF
         /* the last non-blank before the '>' decides whether it closes itself */
         nNext := nTo - 1
         c := SubStr( cSrc, nNext, 1 )
         DO WHILE nNext > nFrom .AND. HcJpIsWs( c )
            nNext--
            c := SubStr( cSrc, nNext, 1 )
         ENDDO
         cKind := iif( c == "/", "Z", "S" )
         AAdd( aTok, { cKind, SubStr( cSrc, nFrom, nTo - nFrom + 1 ), cName, nFrom, nTo, 0 } )
         nPos := nTo + 1
      ENDIF
   ENDDO
RETURN { .T., aTok, "" }

/* pairs the tags and decides, for every element, whether it is SIMPLE (text and
 * nothing else, or nothing at all) or MIXED (text AND children). Answers
 * { lOk, cError, aMixed } where aMixed holds the indexes of the START tags whose
 * element has to be copied as an opaque block. */
STATIC FUNCTION HcXmlCheck( aTok )
   LOCAL aStk := {}, aMixed := {}, i, aT, aRow, nTop
   FOR i := 1 TO Len( aTok )
      aT := aTok[ i ]
      nTop := Len( aStk )
      DO CASE
      CASE aT[ HX_KIND ] == "T"
         IF HcXmlTextOn( aT[ HX_TEXT ] )
            IF nTop == 0
               RETURN { .F., "Invalid XML: text outside an element.", {} }
            ENDIF
            aStk[ nTop ][ 2 ] := .T.
         ENDIF
      CASE aT[ HX_KIND ] == "S"
         IF nTop > 0
            aStk[ nTop ][ 3 ] := .T.
         ENDIF
         IF nTop >= HP_MAXDEPTH
            RETURN { .F., "Invalid XML: the text is nested too deeply.", {} }
         ENDIF
         AAdd( aStk, { aT[ HX_NAME ], .F., .F., i } )
      CASE aT[ HX_KIND ] == "E"
         IF nTop == 0
            RETURN { .F., "Invalid XML: the end tag </" + aT[ HX_NAME ] + ;
                            "> has no open element.", {} }
         ENDIF
         aRow := aStk[ nTop ]
         IF ! ( aRow[ 1 ] == aT[ HX_NAME ] )
            RETURN { .F., "Invalid XML: the end tag </" + aT[ HX_NAME ] + ;
                            "> does not match <" + aRow[ 1 ] + ">.", {} }
         ENDIF
         IF aRow[ 2 ] .AND. aRow[ 3 ]
            AAdd( aMixed, aRow[ 4 ] )
         ENDIF
         aTok[ aRow[ 4 ] ][ HX_END ] := i
         ASize( aStk, nTop - 1 )
         IF nTop > 1
            aStk[ nTop - 1 ][ 3 ] := .T.
         ENDIF
      OTHERWISE
         IF nTop > 0
            aStk[ nTop ][ 3 ] := .T.
         ENDIF
      ENDCASE
   NEXT
   IF Len( aStk ) > 0
      RETURN { .F., "Invalid XML: <" + aStk[ Len( aStk ) ][ 1 ] + ;
                      "> is never closed.", {} }
   ENDIF
RETURN { .T., "", aMixed }

/* the lines of the document: one node per row at its depth. An element that is
 * only text stays on ONE row and its text is copied exactly; an element with
 * mixed content is copied from the source as it was. Everything that carries
 * its own line breaks is cut with HcPrettyAdd(), never left inside one row. */
STATIC FUNCTION HcXmlEmit( cSrc, aTok, aMixed, nW )
   LOCAL aOut := {}, i := 1, nDepth := 0, aT, cChunk, nEnd
   DO WHILE i <= Len( aTok )
      IF Len( aOut ) > HP_MAXLINES
         RETURN { .F., {} }
      ENDIF
      aT := aTok[ i ]
      DO CASE
      CASE aT[ HX_KIND ] == "S"
         nEnd := aT[ HX_END ]
         IF AScan( aMixed, i ) > 0 .AND. nEnd > i
            /* MIXED: the whole element, byte for byte */
            cChunk := SubStr( cSrc, aT[ HX_FROM ], aTok[ nEnd ][ HX_TO ] - aT[ HX_FROM ] + 1 )
            HcPrettyAdd( aOut, cChunk, nDepth * nW )
            i := nEnd + 1
         ELSEIF nEnd == i + 1
            /* EMPTY (<a></a>): the two tags on one row */
            HcPrettyAdd( aOut, aT[ HX_TEXT ] + aTok[ nEnd ][ HX_TEXT ], nDepth * nW )
            i := nEnd + 1
         ELSEIF nEnd == i + 2 .AND. aTok[ i + 1 ][ HX_KIND ] == "T"
            /* TEXT-ONLY (<a>text</a>): one row, and the text exactly as it was
             * authored (no trimming, so nothing changes). A text that is only
             * whitespace is dropped: it is the indentation a pretty printer adds
             * in the first place. */
            cChunk := aT[ HX_TEXT ]
            IF HcXmlTextOn( aTok[ i + 1 ][ HX_TEXT ] )
               cChunk += aTok[ i + 1 ][ HX_TEXT ]
            ENDIF
            cChunk += aTok[ nEnd ][ HX_TEXT ]
            HcPrettyAdd( aOut, cChunk, nDepth * nW )
            i := nEnd + 1
         ELSE
            HcPrettyAdd( aOut, aT[ HX_TEXT ], nDepth * nW )
            nDepth++
            i++
         ENDIF
      CASE aT[ HX_KIND ] == "E"
         nDepth := Max( 0, nDepth - 1 )
         HcPrettyAdd( aOut, aT[ HX_TEXT ], nDepth * nW )
         i++
      CASE aT[ HX_KIND ] == "T"
         i++                             /* whitespace between nodes: dropped */
      OTHERWISE
         HcPrettyAdd( aOut, aT[ HX_TEXT ], nDepth * nW )
         i++
      ENDCASE
   ENDDO
RETURN { .T., aOut }

STATIC FUNCTION HcXmlPretty( cSrc, nW )
   LOCAL aTk, aChk, aOut
   aTk := HcXmlTokens( cSrc )
   IF ! aTk[ 1 ]
      RETURN { .F., {}, aTk[ 3 ] }
   ENDIF
   IF Len( aTk[ 2 ] ) == 0
      RETURN { .T., {}, "" }              /* nothing but whitespace */
   ENDIF
   aChk := HcXmlCheck( aTk[ 2 ] )
   IF ! aChk[ 1 ]
      RETURN { .F., {}, aChk[ 2 ] }
   ENDIF
   aOut := HcXmlEmit( cSrc, aTk[ 2 ], aChk[ 3 ], nW )
   IF ! aOut[ 1 ]
      RETURN { .F., {}, "Invalid XML: the formatted text is too large for this screen." }
   ENDIF
RETURN { .T., aOut[ 2 ], "" }

/* =====================================================================
 *  Code pages of the Text viewer and the Text editor (S1..S4, T1 of
 *  odd/tasks/hc-codepage.md)
 *
 *  The BUFFER always holds the bytes of the file in its own code page. The
 *  SCREEN side is what the GTWVG driver decodes with the code page Harbour has
 *  selected, which in this program is EN (CP-437): so a line is painted with
 *  HcCdpShow( cLine, cId ), the screen column of a line is a CHARACTER while
 *  the buffer column is a BYTE, and HcCdpCell() maps one onto the other.
 *
 *  Everything here is pure (no window, no file, no global state) so the
 *  headless bank pins it (block S93). Every RTL call that raises a recoverable
 *  EG_ARG 1302 for an unknown id (hb_cdpIsUTF8, hb_Translate, ...) is reached
 *  only with an id validated against hb_cdpList(), and still inside a BEGIN
 *  SEQUENCE, so a bad id can never end up in the fatal handler.
 * ===================================================================== */

/* the code pages the two screens offer, in the order they are shown. It is a
 * local literal and NOT a STATIC ... INIT declaration on purpose: AGENTS trap
 * 7. The list is filtered with HcCdpExists() because DE850/FR850 only exist
 * when their module is linked, and adding one is one line of this list. */
FUNCTION HcCdpCommon()
   LOCAL aAll := { "UTF8", "EN", "ES850", "ESWIN", "ESISO", "DE850", "FR850" }
   LOCAL aOut := {}
   LOCAL i

   FOR i := 1 TO Len( aAll )
      IF HcCdpExists( aAll[ i ] )
         AAdd( aOut, aAll[ i ] )
      ENDIF
   NEXT
RETURN aOut

/* the canonical spelling of a code page id, or "" when this build does not
 * have it. The membership test is case-insensitive and never throws: the RTL
 * call is wrapped because in a bank without ErrorBlock() a thrown error would
 * leave the process waiting for a key. */
STATIC FUNCTION HcCdpCanon( cId )
   LOCAL aIds
   LOCAL i

   IF ! HB_ISSTRING( cId )
      RETURN ""
   ENDIF
   cId := AllTrim( cId )
   IF Len( cId ) == 0
      RETURN ""
   ENDIF
   aIds := {}
   BEGIN SEQUENCE WITH {| e | Break( e ) }
      aIds := hb_cdpList()
   RECOVER
      aIds := {}
   END SEQUENCE
   IF ! HB_ISARRAY( aIds )
      RETURN ""
   ENDIF
   FOR i := 1 TO Len( aIds )
      IF HB_ISSTRING( aIds[ i ] ) .AND. Upper( aIds[ i ] ) == Upper( cId )
         RETURN aIds[ i ]
      ENDIF
   NEXT
RETURN ""

/* is that code page in this build? (S1: the curated list is filtered with it) */
FUNCTION HcCdpExists( cId )
RETURN Len( HcCdpCanon( cId ) ) > 0

/* the default the user asked for: UTF-8 unless the file says otherwise (S1) */
FUNCTION HcCdpDefault()
RETURN "UTF8"

/* the code page Harbour itself is using to decode what is written to the
 * screen. hb_cdpSelect() WITHOUT an argument answers the id in force (hb_cdpID()
 * is not reachable from PRG; measured in the Harbour sources). The answer is
 * validated, so a driver or a build without any code page falls back to EN. */
FUNCTION HcCdpScreen()
   LOCAL cId := ""

   BEGIN SEQUENCE WITH {| e | Break( e ) }
      cId := hb_cdpSelect()
   RECOVER
      cId := ""
   END SEQUENCE
   IF ! HB_ISSTRING( cId ) .OR. Len( HcCdpCanon( cId ) ) == 0
      RETURN "EN"
   ENDIF
RETURN HcCdpCanon( cId )

/* is the code page multi-byte? An unknown id is not (so the byte and the
 * character column are the same thing, which is the safe answer). */
FUNCTION HcCdpIsMulti( cId )
   LOCAL cCdp := HcCdpCanon( cId )
   LOCAL lMulti := .F.

   IF Len( cCdp ) == 0
      RETURN .F.
   ENDIF
   BEGIN SEQUENCE WITH {| e | Break( e ) }
      lMulti := hb_cdpIsUTF8( cCdp )
      IF ! HB_ISLOGICAL( lMulti )
         lMulti := .F.
      ENDIF
   RECOVER
      lMulti := .F.
   END SEQUENCE
RETURN lMulti

/* hb_Translate() guarded. It answers the input untouched when an id is
 * unknown, but a bad id must not be able to reach the fatal handler either. */
STATIC FUNCTION HcCdpTranslate( cText, cFrom, cTo )
   LOCAL cOut := cText

   BEGIN SEQUENCE WITH {| e | Break( e ) }
      cOut := hb_Translate( cText, cFrom, cTo )
      IF ! HB_ISSTRING( cOut )
         cOut := cText
      ENDIF
   RECOVER
      cOut := cText
   END SEQUENCE
RETURN cOut

/* .T. when every sequence of the string is well formed UTF-8: a lead byte
 * 0xC2..0xF4 with its 0x80..0xBF continuation bytes. Pure ASCII is well formed,
 * 0xC0/0xC1 (overlong), 0xF5..0xFF, a stray continuation byte and a truncated
 * tail are not. */
STATIC FUNCTION HcCdpUtf8Ok( cText, lPartial )
   LOCAL i := 1
   LOCAL nLen := Len( cText )
   LOCAL nNeed, n, b

   /* lPartial: the string is the HEAD of a longer buffer, so a sequence that
    * does not fit at its end is the cut and not a malformed file */
   IF ValType( lPartial ) != "L"
      lPartial := .F.
   ENDIF
   DO WHILE i <= nLen
      b := Asc( SubStr( cText, i, 1 ) )
      IF b < 0x80
         i++
         LOOP
      ENDIF
      DO CASE
      CASE b >= 0xC2 .AND. b <= 0xDF
         nNeed := 2
      CASE b >= 0xE0 .AND. b <= 0xEF
         nNeed := 3
      CASE b >= 0xF0 .AND. b <= 0xF4
         nNeed := 4
      OTHERWISE
         RETURN .F.
      ENDCASE
      IF i + nNeed - 1 > nLen
         RETURN lPartial                /* truncated tail (or the cut) */
      ENDIF
      FOR n := 1 TO nNeed - 1
         b := Asc( SubStr( cText, i + n, 1 ) )
         IF b < 0x80 .OR. b > 0xBF
            RETURN .F.
         ENDIF
      NEXT
      i += nNeed
   ENDDO
RETURN .T.

/* .T. when the string has a byte in 0x80..0x9F, which is what tells
 * Windows-1252 apart from the OEM code page (S1, rule c) */
STATIC FUNCTION HcCdpHasWin( cText )
   LOCAL i, b

   FOR i := 1 TO Len( cText )
      b := Asc( SubStr( cText, i, 1 ) )
      IF b >= 0x80 .AND. b <= 0x9F
         RETURN .T.
      ENDIF
   NEXT
RETURN .F.

/* S1: the code page of a text file, in the order of the feature document —
 * UTF-8 BOM, well-formed UTF-8 (pure ASCII included), a byte in 0x80..0x9F
 * (Windows-1252) and otherwise OEM Spanish. The verdict is checked against this
 * build: a code page that is not linked falls back to the one on screen instead
 * of painting garbage. Empty data is UTF-8, the default.
 * SAMPLE CAP: only the first HC_CDP_SAMPLE bytes (256 KiB) are examined, so
 * opening a 4 MB file does not walk it byte by byte; a UTF-8 sequence that the
 * cap cuts in half is tolerated (HcCdpUtf8Ok() with lPartial), so a valid file
 * is never reported invalid because of the cut. */
FUNCTION HcCdpDetect( cData )
   LOCAL cId
   LOCAL lCut := .F.

   IF ! HB_ISSTRING( cData )
      cData := ""
   ENDIF
   IF Len( cData ) > HC_CDP_SAMPLE
      cData := Left( cData, HC_CDP_SAMPLE )
      lCut := .T.
   ENDIF
   IF Left( cData, 3 ) == hb_HexToStr( "EFBBBF" )
      cId := "UTF8"
   ELSEIF HcCdpUtf8Ok( cData, lCut )
      cId := "UTF8"
   ELSEIF HcCdpHasWin( cData )
      cId := "ESWIN"
   ELSE
      cId := "ES850"
   ENDIF
   IF ! HcCdpExists( cId )
      RETURN HcCdpScreen()
   ENDIF
RETURN cId

/* the line as it has to be written to the screen with SAY: from the file code
 * page to the one Harbour decodes with, so the painted line is ONE BYTE PER
 * CELL. An unknown id, an empty line or the code page already on screen leaves
 * the bytes untouched (nothing to convert). */
FUNCTION HcCdpShow( cLine, cId )
   LOCAL cFrom, cScr

   IF ! HB_ISSTRING( cLine )
      RETURN ""
   ENDIF
   IF Len( cLine ) == 0
      RETURN cLine
   ENDIF
   cFrom := HcCdpCanon( cId )
   IF Len( cFrom ) == 0
      RETURN cLine
   ENDIF
   cScr := HcCdpCanon( HcCdpScreen() )
   IF Len( cScr ) == 0 .OR. cFrom == cScr
      RETURN cLine
   ENDIF
RETURN HcCdpTranslate( cLine, cFrom, cScr )

/* the number of BYTES the character that starts at the 0-based byte offset
 * nAt takes, or 0 when nAt is outside the line. One byte per character in a
 * single-byte code page; in UTF-8 it never answers more bytes than remain, so
 * a truncated tail is still one advance. */
FUNCTION HcCdpCharLen( cLine, nAt, cId )
   LOCAL nLen, nNeed, b

   IF ! HB_ISSTRING( cLine )
      RETURN 0
   ENDIF
   nLen := Len( cLine )
   IF ! HB_ISNUMERIC( nAt ) .OR. nAt < 0 .OR. nAt >= nLen
      RETURN 0
   ENDIF
   IF ! HcCdpIsMulti( cId )
      RETURN 1
   ENDIF
   b := Asc( SubStr( cLine, Int( nAt ) + 1, 1 ) )
   DO CASE
   CASE b >= 0xC2 .AND. b <= 0xDF
      nNeed := 2
   CASE b >= 0xE0 .AND. b <= 0xEF
      nNeed := 3
   CASE b >= 0xF0 .AND. b <= 0xF4
      nNeed := 4
   OTHERWISE
      nNeed := 1                        /* a stray byte is one character */
   ENDCASE
RETURN Min( nNeed, nLen - Int( nAt ) )

/* how many CHARACTERS the first nBytes bytes of the line hold: the 0-based
 * screen cell where byte offset nBytes sits (S4). It is the identity in a
 * single-byte code page and it is always monotonic: a character that does not
 * fit in the bytes asked for does not count. */
FUNCTION HcCdpCell( cLine, nBytes, cId )
   LOCAL nLen, nPos := 0
   LOCAL nCount := 0
   LOCAL n

   IF ! HB_ISSTRING( cLine )
      RETURN 0
   ENDIF
   IF ! HB_ISNUMERIC( nBytes ) .OR. nBytes <= 0
      RETURN 0
   ENDIF
   nLen := Len( cLine )
   nBytes := Min( Int( nBytes ), nLen )
   IF ! HcCdpIsMulti( cId )
      RETURN nBytes
   ENDIF
   DO WHILE nPos < nBytes
      n := HcCdpCharLen( cLine, nPos, cId )
      IF n <= 0 .OR. nPos + n > nBytes
         EXIT
      ENDIF
      nCount++
      nPos += n
   ENDDO
RETURN nCount

/* the 0-based byte offset where the character painted on the 0-based screen
 * CELL nCell STARTS - the inverse of HcCdpCell() (S102 of hc-editor-mouse.md:
 * the mouse of the editor lands on a cell and the buffer is counted in bytes).
 * It is clamped on both sides: cell 0 is byte 0 and a cell past the last
 * character of the line is Len( cLine ), so a click below or right of the text
 * always gives a usable caret. A cell can never fall INSIDE a multi-byte
 * character: the walk advances character by character, so the answer is always
 * either the start of a character or the end of the line. The identity in a
 * single-byte code page (and in an unknown one, which is not multi-byte). */
FUNCTION HcCdpByte( cLine, nCell, cId )
   LOCAL nLen, nPos := 0, nCount := 0, n

   IF ! HB_ISSTRING( cLine )
      RETURN 0
   ENDIF
   IF ! HB_ISNUMERIC( nCell ) .OR. nCell <= 0
      RETURN 0
   ENDIF
   nLen  := Len( cLine )
   nCell := Int( nCell )
   IF ! HcCdpIsMulti( cId )
      RETURN Min( nCell, nLen )
   ENDIF
   DO WHILE nPos < nLen .AND. nCount < nCell
      n := HcCdpCharLen( cLine, nPos, cId )
      IF n <= 0
         EXIT                           /* a truncated tail: stop at nPos */
      ENDIF
      nPos += n
      nCount++
   ENDDO
RETURN Min( nPos, nLen )

/* the 0-based byte offset where the character that ENDS just before nAt starts:
 * the target of `<-` and Backspace, so a multi-byte character is never split. */
FUNCTION HcCdpPrev( cLine, nAt, cId )
   LOCAL nLen, nPos := 0
   LOCAL nPrev := 0
   LOCAL n

   IF ! HB_ISSTRING( cLine )
      RETURN 0
   ENDIF
   nLen := Len( cLine )
   IF ! HB_ISNUMERIC( nAt ) .OR. nAt <= 0
      RETURN 0
   ENDIF
   nAt := Min( Int( nAt ), nLen )
   IF ! HcCdpIsMulti( cId )
      RETURN Max( 0, nAt - 1 )
   ENDIF
   DO WHILE nPos < nAt
      n := HcCdpCharLen( cLine, nPos, cId )
      IF n <= 0
         RETURN Max( 0, nAt - 1 )
      ENDIF
      nPrev := nPos
      nPos += n
   ENDDO
RETURN nPrev

/* cData converted from cFrom to cTo (S3, the Transform of the editor).
 * lLost is by reference: .T. when the conversion loses characters, which is
 * decided by converting back and comparing with the original; an unknown id
 * cannot be converted, so the bytes are returned untouched and it counts as a
 * loss. hb_Translate() maps what the target code page cannot represent to
 * '?' (0x3F), and that is exactly what the round trip detects. */
FUNCTION HcCdpConv( cData, cFrom, cTo, lLost )
   LOCAL cIn, cOut, cRes, cBack

   lLost := .F.
   IF ! HB_ISSTRING( cData )
      cData := ""
   ENDIF
   cIn := HcCdpCanon( cFrom )
   cOut := HcCdpCanon( cTo )
   IF Len( cIn ) == 0 .OR. Len( cOut ) == 0
      lLost := .T.
      RETURN cData
   ENDIF
   IF cIn == cOut .OR. Len( cData ) == 0
      RETURN cData
   ENDIF
   cRes := HcCdpTranslate( cData, cIn, cOut )
   cBack := HcCdpTranslate( cRes, cOut, cIn )
   lLost := ! ( cBack == cData )
RETURN cRes

/* S3 of hc-codepage.md, T4: the WHOLE buffer converted from cFrom to cTo, line
 * by line, keeping the number of lines (changing the code page of a file never
 * adds or drops one). lLost is by reference and ACCUMULATES: it is .T. as soon as
 * ANY line loses characters, because a transform that mangles one line of a
 * hundred is still a loss and the user has to be asked about it - taking only
 * the verdict of the last line would hide it. An unknown id makes HcCdpConv()
 * answer the line untouched and count it as a loss, so that case is caught here
 * too. PURE: the answer is a NEW array and aLines is never written. */
FUNCTION HcCdpConvLines( aLines, cFrom, cTo, lLost )
   LOCAL aOut := {}, i, lLine := .F., cLine

   IF ! ( ValType( lLost ) == "L" .AND. lLost )
      lLost := .F.
   ENDIF
   IF ! HB_ISARRAY( aLines )
      RETURN { "" }
   ENDIF
   FOR i := 1 TO Len( aLines )
      cLine := iif( ValType( aLines[ i ] ) == "C", aLines[ i ], "" )
      /* one verdict per line, ORed into the running one: HcCdpConv() resets its
       * own flag on every call, so it cannot be the accumulator itself */
      cLine := HcCdpConv( cLine, cFrom, cTo, @lLine )
      IF lLine
         lLost := .T.
      ENDIF
      AAdd( aOut, cLine )
   NEXT
   IF Len( aOut ) == 0
      AAdd( aOut, "" )
   ENDIF
RETURN aOut

/* T3 of hc-codepage.md: the BYTES one typed key puts in the buffer. Inkey()
 * hands over a byte of the code page of the SCREEN (that is what the keyboard
 * produces here) and the buffer holds the code page of the FILE, so the same key
 * is one byte in an 850 file and two in a UTF-8 one: a CP-437 'a' with an acute
 * is 0xA0 on the screen and C3 A1 in the file. An id this build does not have
 * cannot be encoded in, and HcCdpConv() then answers the bytes untouched. */
FUNCTION HcCdpKeyChar( nKey, cCdp )
   IF ValType( nKey ) != "N" .OR. nKey < 0 .OR. nKey > 255
      RETURN ""
   ENDIF
RETURN HcCdpConv( Chr( Int( nKey ) ), HcCdpScreen(), cCdp )

/* T3: nCol moved BACK to the start of the character it falls in. The vertical
 * movements (Up/Down/PgUp/PgDn/wheel) clamp the caret with the byte length of the
 * line, which can land it in the middle of a multi-byte character; snapping it
 * here is what keeps every later edit from splitting one. The identity in a
 * single-byte code page (and outside the line, or in an unknown one). */
FUNCTION HcCdpSnap( cLine, nCol, cCdp )
   LOCAL nLen, nPos := 0, n

   IF ! HB_ISSTRING( cLine )
      RETURN 0
   ENDIF
   nLen := Len( cLine )
   IF ValType( nCol ) != "N" .OR. nCol <= 0
      RETURN 0
   ENDIF
   nCol := Min( Int( nCol ), nLen )
   IF ! HcCdpIsMulti( cCdp )
      RETURN nCol
   ENDIF
   DO WHILE nPos < nCol
      n := HcCdpCharLen( cLine, nPos, cCdp )
      IF n <= 0
         RETURN nPos
      ENDIF
      IF nPos + n > nCol
         RETURN nPos                  /* nCol falls INSIDE this character */
      ENDIF
      nPos += n
   ENDDO
RETURN nPos

/* T2: the screen column where the caret goes. PUBLIC (and next to the other
 * HcCdp* helpers) because the bank pins it: it is the CELL of the caret minus
 * the CELL of the window start, and never negative - a caret left of the window
 * sits on its first cell. Identity arithmetic in a single-byte code page. */
FUNCTION HcCdpPos( cLine, nCol, nLft, cCdp )
   IF ! HB_ISSTRING( cLine )
      cLine := ""
   ENDIF
RETURN Max( 0, HcCdpCell( cLine, nCol, cCdp ) - HcCdpCell( cLine, nLft, cCdp ) )

/* first line of the window, clamped so the buffer always fills the screen */
STATIC FUNCTION HcFixTop( nTop, nLines, nVis )
RETURN Max( 1, Min( nTop, Max( 1, nLines - nVis + 1 ) ) )

/* =====================================================================
 *  Incremental search of the active panel (S13): Alt+<letter>
 *
 *  MEASURED on this GTWVG: Alt+<letter> does NOT arrive as K_ALT_A..K_ALT_Z.
 *  Inkey() returns the PLAIN letter (Alt+C -> 99 == 'c') and the ALT state is
 *  reported by hb_gtInfo( HB_GTI_KBDSHIFTS ) right after the key is read
 *  (Alt+C -> 4148 = 0x1034, plain c -> 48). Alt+F1/Alt+F2 DO arrive as
 *  K_ALT_F1/K_ALT_F2 (-30/-31), so the K_ALT_* table is handled as well: with
 *  both channels every letter does something, whichever way the driver
 *  reports the modifier.
 *
 *  A THIRD channel is the window hook of bp_win32.c, which records every
 *  character typed while ALT is held: on the user's machine holding Alt and
 *  typing swallowed the letters, so the search no longer depends on what GTWVG
 *  hands to Inkey(). See HcHookDrain() below.
 *
 *  POLICY of the input (what the user sees): it only owns LETTERS, Backspace,
 *  Enter and Esc. Anything else CLOSES it and then acts as usual (F10 asks
 *  Exit hwBro?, the arrows move the cursor, Ctrl-O zooms, Alt-F1/F2 pick the
 *  drives): the key is carried over as a pending key in BpHcScreen() instead of
 *  being duplicated here.
 * ===================================================================== */

/* modifier state of the key just read; 0 when the driver does not report it.
 * PUBLIC because the record browser of bp_core.prg reads it with the same rule
 * (S69: Ctrl-F / Ctrl-Shift-F). It must be read IMMEDIATELY after Inkey(): what
 * this driver answers is the LIVE keyboard state, not a snapshot of the key
 * (measured; see DbfSearchMode()). */
FUNCTION HcShiftState()
   LOCAL n := 0
   BEGIN SEQUENCE WITH {| e | Break( e ) }
      n := hb_gtInfo( HB_GTI_KBDSHIFTS )
      IF ValType( n ) != "N"
         n := 0
      ENDIF
   RECOVER
      n := 0
   END SEQUENCE
RETURN n

/* ---- second channel: the Alt characters recorded by bp_win32.c ----------
 * The window hook of the driver (see the comment in bp_win32.c) stores every
 * character typed while ALT is held, so the search does not depend on what
 * GTWVG hands to Inkey(): on the user's machine holding Alt and typing swallowed
 * the letters. The headless bank of tests does NOT link bp_win32.c, so the
 * calls are compiled out with the same guard used for BpSetExit() and are also
 * checked with hb_IsFunction() (a build without the extension answers 0). */

STATIC FUNCTION HcAltHookTotal()
   LOCAL n := 0
#ifndef BP_HC_STANDALONE
   IF hb_IsFunction( "W32ALTKEYS" )
      n := W32ALTKEYS()
      IF ValType( n ) != "N"
         n := 0
      ENDIF
   ENDIF
#endif
RETURN n

STATIC FUNCTION HcAltHookChar( n )
   LOCAL c := ""
#ifndef BP_HC_STANDALONE
   IF hb_IsFunction( "W32ALTKEY" )
      c := W32ALTKEY( n )
      IF ValType( c ) != "C"
         c := ""
      ENDIF
   ENDIF
#endif
RETURN c

STATIC PROCEDURE HcAltHookReset()
#ifndef BP_HC_STANDALONE
   IF hb_IsFunction( "W32ALTRESET" )
      W32ALTRESET()
   ENDIF
#endif
   s_nHcHookSeen := 0
RETURN

/* Consume (discard) everything the hook recorded so far WITHOUT resetting the
 * counter: the numbering keeps growing, so the trace shows one increment per
 * keystroke (hc=1, hc=2, hc=3) while a new search still starts clean. */
STATIC PROCEDURE HcAltHookFlush()
   LOCAL nTotal := HcAltHookTotal()
   IF nTotal > 0
      s_lHcHookSource := .T.
      s_nHcHookSeen := nTotal
   ENDIF
RETURN

/* everything the hook recorded and nobody consumed yet, as one string; the
 * characters outside the printable range are dropped (a search pattern is a
 * file name prefix). Recording anything makes the hook the ONLY source of the
 * Alt-held letters from then on (see s_lHcHookSource). */
STATIC FUNCTION HcHookDrain()
   LOCAL nTotal := HcAltHookTotal(), c := "", x
   IF nTotal > 0
      s_lHcHookSource := .T.
   ENDIF
   DO WHILE s_nHcHookSeen < nTotal
      s_nHcHookSeen++
      x := HcAltHookChar( s_nHcHookSeen )
      IF ! Empty( x ) .AND. Asc( x ) >= 32 .AND. Asc( x ) <= 126
         c += x
      ENDIF
   ENDDO
RETURN c

/* S13.7 (hc-file-search.md) / trap 61: the PENDING Alt chord of the window
 * hook, for the opt-in editor hook of bp_ui.prg (UiSetAltHook()). It drains the
 * same ALT ring the loops of this file drain and answers its FIRST printable
 * letter in upper case, or "". That module never calls the W32* helpers itself
 * (it is linked into the three headless banks), so Main() installs
 * {| | HcAltChord() } and the chord travels from the window hook to any field
 * editor: without the extension -the banks- the ring is always empty, so the
 * hook answers "" and nothing changes. */
FUNCTION HcAltChord()
   LOCAL c := HcHookDrain()
   IF Len( c ) > 0
      RETURN Upper( Left( c, 1 ) )
   ENDIF
RETURN ""

/* The K_ALT_A..K_ALT_Z codes of inkey.ch are NOT contiguous (they follow the
 * keyboard scancodes: 286, 304, 302, 288...), so the table is explicit. */
STATIC FUNCTION HcAltCodeLetter( nKey )
   LOCAL aCodes := { K_ALT_A, K_ALT_B, K_ALT_C, K_ALT_D, K_ALT_E, K_ALT_F, K_ALT_G, ;
                     K_ALT_H, K_ALT_I, K_ALT_J, K_ALT_K, K_ALT_L, K_ALT_M, ;
                     K_ALT_N, K_ALT_O, K_ALT_P, K_ALT_Q, K_ALT_R, K_ALT_S, ;
                     K_ALT_T, K_ALT_U, K_ALT_V, K_ALT_W, K_ALT_X, K_ALT_Y, K_ALT_Z }
   LOCAL i
   FOR i := 1 TO Len( aCodes )
      IF aCodes[ i ] == nKey
         RETURN Chr( 64 + i )
      ENDIF
   NEXT
RETURN ""

/* ALT bit of a shift state (the one HcShiftState() returned for the key) */
STATIC FUNCTION HcShiftAlt( nShift )
   IF ValType( nShift ) != "N"
      RETURN .F.
   ENDIF
RETURN hb_bitAnd( nShift, HB_GTI_KBD_ALT ) != 0

/* The LETTER of a key: the character as pressed for a printable letter, the
 * letter of a K_ALT_A..K_ALT_Z code, and "" when the key is not a letter.
 * This is the ONLY place where "is this key a letter?" is decided. */
STATIC FUNCTION HcLetterOf( nKey )
   LOCAL c := HcAltCodeLetter( nKey )
   IF ! Empty( c )
      RETURN c
   ENDIF
   IF nKey >= 65 .AND. nKey <= 90
      RETURN Chr( nKey )
   ENDIF
   IF nKey >= 97 .AND. nKey <= 122
      RETURN Chr( nKey )
   ENDIF
RETURN ""

/* What the incremental input does with a key while it is open (S13/S13b).
 * PURE, so the headless bank can check it without a window:
 *   nKey        the key Inkey() delivered
 *   cLetter     HcLetterOf( nKey ), the letter of the key ("" when it is not one)
 *   lHookSource the window hook is the source of the Alt-held letters
 *   lAlt        the ALT bit of the key
 * Returns "ENTER", "ESC", "BS", "APPEND", "LETTER" or "CLOSE":
 *   APPEND  the letter adds to the pattern (no ALT, or ALT with Inkey() as the source)
 *   LETTER  a letter with ALT while the hook is the source: IGNORED, the hook
 *           copy appends it; the input STAYS OPEN (a letter never closes it)
 *   CLOSE   anything that is not a letter: the input closes and the key is
 *           handled normally (Enter/Esc/Backspace keep their own meaning)
 * NOTE: a letter is a letter whether Inkey() reports the printable code or an
 * ALT code, and whether the ALT bit is set or not. */
FUNCTION HcFindKeyAction( nKey, cLetter, lHookSource, lAlt )
   DO CASE
   CASE nKey == K_ENTER
      RETURN "ENTER"
   CASE nKey == K_ESC
      RETURN "ESC"
   CASE nKey == K_BS
      RETURN "BS"
   CASE Empty( cLetter )
      RETURN "CLOSE"
   CASE lHookSource .AND. lAlt
      RETURN "LETTER"
   ENDCASE
RETURN "APPEND"

/* The key carried over after the incremental input closes (S13/S13b).
 * While the input is open a function key closes it and then acts ONCE in the
 * screen, and with ALT still held the driver delivers the K_ALT_F<n> code
 * instead of the plain one (trap 37 of AGENTS.md), which no CASE of the screen
 * handles: the key used to die silently. Here it gets its plain meaning back,
 * so F4 edits the entry the search found without the user having to release
 * Alt or close the input first. Alt-F1/Alt-F2 are DELIBERATELY left alone: they
 * are the drive pickers of the panels and keep working as such, also from
 * inside the search. Anything that is not an Alt+function key goes through
 * untouched. PURE, so the headless bank can check it. */
FUNCTION HcFindPendKey( nKey )
   /* the K_ALT_F<n> codes of inkey.ch DECREASE as n grows (K_ALT_F3 = -32 ...
    * K_ALT_F10 = -39), so the range is written from F10 up to F3 */
   IF nKey <= K_ALT_F3 .AND. nKey >= K_ALT_F10
      RETURN nKey - K_ALT_F3 + K_F3
   ENDIF
RETURN nKey

/* Letter of an Alt+<letter> press, in upper case; "" when the key is not one.
 * It accepts both channels: a K_ALT_* code, or a plain letter with the ALT bit
 * set in the shift state (what this GTWVG delivers). */
/* The LETTER of an Alt+<key> press, or "" when the key is not one.
 * PUBLIC (U1) because the record browser handles the same shortcuts the manager
 * does, and both have to read the modifier state the same way: Alt+<letter>
 * arrives as the bare letter plus the ALT bit (trap 37), AltGr is Ctrl+Alt and
 * carries CTRL, so it is rejected (trap 38). */
FUNCTION HcAltLetter( nKey, nShift )
   LOCAL c := HcAltCodeLetter( nKey )
   IF ! Empty( c )
      RETURN c
   ENDIF
   IF ! HcShiftAlt( nShift )
      RETURN ""
   ENDIF
   /* AltGr is Ctrl+Alt on a Spanish keyboard, and that combination carries the
    * CTRL bit: it is not Alt+<letter> (and it is what the CANCEL handler of the
    * runtime watches for), so a CTRL bit disqualifies the key. A real Alt+C
    * reports 4148 (0x1034): ALT plus the lock bits, no CTRL. */
   IF hb_bitAnd( nShift, HB_GTI_KBD_CTRL ) != 0
      RETURN ""
   ENDIF
   IF nKey >= 65 .AND. nKey <= 90
      RETURN Chr( nKey )
   ENDIF
   IF nKey >= 97 .AND. nKey <= 122
      RETURN Upper( Chr( nKey ) )
   ENDIF
RETURN ""

/* Where the cursor goes for a search (S13.1/S13.4). PURE: it only looks at the
 * names array (no panel and no disk access), so the headless bank can call it.
 *   aNames   names of the entries, in the order the panel shows them
 *   nAnchor  1-based entry the cursor was on when the search started
 *   cPattern text typed so far
 * It searches FORWARD from the anchor (the anchor itself is the first
 * candidate, so an entry that still matches does not move the cursor), wraps
 * around the end of the listing and keeps going up to the anchor. Returns the
 * 1-based index to move to, or nAnchor when nothing matches, when the pattern
 * is empty or when the list is empty. The ".." entry never matches and the
 * comparison is a case-insensitive prefix match. */
FUNCTION HcFindFrom( aNames, nAnchor, cPattern )
   LOCAL n := iif( HB_ISARRAY( aNames ), Len( aNames ), 0 )
   LOCAL nIdx, i, cPat := Upper( cPattern )
   IF n < 1
      RETURN Max( 1, nAnchor )
   ENDIF
   nAnchor := Max( 1, Min( nAnchor, n ) )
   IF Empty( cPat )
      RETURN nAnchor
   ENDIF
   FOR i := 0 TO n - 1
      nIdx := nAnchor + i
      DO WHILE nIdx > n
         nIdx -= n
      ENDDO
      IF ! ( aNames[ nIdx ] == ".." )
         IF Left( Upper( aNames[ nIdx ] ), Len( cPat ) ) == cPat
            RETURN nIdx
         ENDIF
      ENDIF
   NEXT
RETURN nAnchor

/* names of the listing of a panel, for HcFindFrom() */
STATIC FUNCTION HcFindNames( aP )
   LOCAL a := {}, i
   FOR i := 1 TO Len( aP[ HC_P_LIST ] )
      AAdd( a, aP[ HC_P_LIST ][ i ][ HC_E_NAME ] )
   NEXT
RETURN a

/* moves the cursor of the panel to the match, always from the same anchor.
 * The arithmetic is guarded: a key that put the module in an unexpected state
 * must not bring the program down (the caller only loses the jump). */
STATIC PROCEDURE HcFindApply( aP, nAnchor, cPattern )
   BEGIN SEQUENCE WITH {| e | Break( e ) }
      HcCursorTo( aP, HcFindFrom( HcFindNames( aP ), nAnchor, cPattern ) )
   RECOVER
   END SEQUENCE
RETURN

/* open/close the input: the module state feeds HcDrawStatus() and HcCaretOn() */
STATIC PROCEDURE HcFindOpen( cPattern )
   s_lHcFindOn := .T.
   s_cHcFindPat := cPattern
   /* a fresh start: anything the hook recorded before the search belongs to
    * nobody (the letters already taken into the seed were consumed above).
    * The counter is NOT reset here, so the trace shows one increment per
    * keystroke for the whole session.
    * NOTE: s_cHcHookDrop is NOT cleared here either: when the search was opened
    * by the Inkey() fallback it still has to drop the hook copy of that same
    * stroke, which may land in a later pass. It is cleared when it closes. */
   HcAltHookFlush()
RETURN

STATIC PROCEDURE HcFindClose()
   s_lHcFindOn := .F.
   s_cHcFindPat := ""
   /* nothing leaks into a later search */
   HcAltHookReset()
   s_cHcHookDrop := ""
RETURN

/* Repaint while the incremental search is open (and when it closes): the rows
 * the cursor left and reached, only if it moved, plus the status row, in ONE
 * paint block. */
STATIC PROCEDURE HcPaintFind( nOldSel, nOldTop )
   LOCAL aP := HcPanelActive(), nRow
   LOCAL nSel := aP[ HC_P_SEL ], nTop := aP[ HC_P_TOP ]
   UiPaintBegin()
   IF nTop != nOldTop
      HcDrawRows( HcActive(), HC_ROW_FIRST, HC_ROW_LAST )
   ELSEIF nSel != nOldSel
      nRow := HC_ROW_FIRST + ( nOldSel - nTop )
      IF nRow >= HC_ROW_FIRST .AND. nRow <= HC_ROW_LAST
         HcDrawRow( HcActive(), nRow )
      ENDIF
      nRow := HC_ROW_FIRST + ( nSel - nTop )
      IF nRow >= HC_ROW_FIRST .AND. nRow <= HC_ROW_LAST
         HcDrawRow( HcActive(), nRow )
      ENDIF
   ENDIF
   HcDrawStatus()
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()
   HcCaretOn()
RETURN

/* L6: the status row ALONE, in ONE paint block, for the temporary notice of a
 * copy (when it appears and when it expires). HcCaretOn() puts the system
 * caret back in the command line, where it lives, so the SAY of the row does
 * not leave it parked over the status text. */
STATIC PROCEDURE HcFlashRow()
   UiPaintBegin()
   HcDrawStatus()
   SetColor( UI_C_DESKTOP )
   UiPaintEnd()
   HcCaretOn()
RETURN

/* =====================================================================
 *  File operations - spec S4
 *
 *  F5 copy, F6 rename/move, F7 make directory and F8 delete. The OPERATION
 *  helpers (HcCopyAnyHc, HcMoveHc, HcMakeDirHc, HcDeleteHc, ...) are public
 *  and return arrays, so the headless bank of src\tests\test_hc.prg can call
 *  them; the F-key handlers below are STATIC and only do the dialogs, the
 *  progress and the repaint.
 *
 *  Confirmations: EVERY one goes through HcConfirm(), which uses the hook set
 *  with HcSetConfirmHook() when there is one and UiConfirm() otherwise. With
 *  BP_HC_STANDALONE and no hook it answers NO, so a headless run can never
 *  delete anything by accident. When a hook is set the progress UI is skipped.
 *
 *  Return conventions:
 *     HcCopyAnyHc / HcCountTreeHc  ->  { lOk, cError, nFiles, nBytes, lCancelled }
 *                                      (HcCountTreeHc: { nFiles, nBytes })
 *     HcMoveHc                     ->  { lOk, cError, lCancelled }
 *     HcMakeDirHc / HcDeleteHc     ->  { lOk, cError }
 *     HcPathInsideHc               ->  .T. when the child is the parent or below it
 * ===================================================================== */

/* the confirmation hook of the headless bank: {| cText, cTitle | lYes } */
FUNCTION HcSetConfirmHook( bBlock )
   s_bHcConfirm := bBlock
RETURN NIL

/* Overwrite hook of the headless bank (S17): {| cName, cSrc, cDst | nChoice },
 * where the choice is 1..7 as listed by HcOwDecide(). NIL removes it. Across
 * the copy api it is the ONLY way a headless run answers the overwrite dialog:
 * with no hook the dialog cannot be drawn and the answer is always Skip.
 * (Kept separate from HcSetConfirmHook() because that one is a yes/no answer
 * and an overwrite needs seven of them.) */
FUNCTION HcSetOverwriteHook( bBlock )
   s_bHcOverwrite := bBlock
RETURN NIL

/* Cancellation hook of the headless bank: {| nDone | lCancel }. It replaces
 * the <Esc> of the progress bar so a test can drive the cancel path of a copy
 * (FIX 2: a cancelled overwrite leaves the previous destination untouched).
 * NIL removes it. */
FUNCTION HcSetCancelHook( bBlock )
   s_bHcCancel := bBlock
RETURN NIL

/* .T. when a hook is set: no window at all (no dialogs, no progress box) */
STATIC FUNCTION HcHeadless()
RETURN ! hb_IsNIL( s_bHcConfirm ) .OR. ! hb_IsNIL( s_bHcCancel )

/* the only place of this module where a destructive action is confirmed */
STATIC FUNCTION HcConfirm( cText, cTitle )
   LOCAL x
   DEFAULT cTitle TO "Confirm"
   IF ! hb_IsNIL( s_bHcConfirm )
      x := Eval( s_bHcConfirm, cText, cTitle )
      RETURN ValType( x ) == "L" .AND. x
   ENDIF
#ifdef BP_HC_STANDALONE
   /* headless without a hook: never answer yes */
   RETURN .F.
#else
   RETURN UiConfirm( cText, cTitle )
#endif

/* ---- progress of the operations (skipped when headless) ---- */

STATIC PROCEDURE HcProgBegin( cTitle, nTotal )
   s_nHcProgDone  := 0
   s_nHcProgTotal := Max( 0, nTotal )
   s_lHcProgEsc   := .F.
   IF ! HcHeadless()
      UiProgBegin( cTitle, s_nHcProgTotal )
   ENDIF
RETURN

/* adds nAdd to the progress; .T. means the operation was cancelled (the
 * injected hook of a test, or <Esc> on the progress bar). NOTE: without a
 * cancel hook and without a window nothing can cancel, so the (possibly stale)
 * value of the previous run is not reused here: the API can be driven directly
 * (headless bank) any number of times. */
STATIC FUNCTION HcProgStep( nAdd )
   LOCAL x
   s_nHcProgDone += nAdd
   IF ! hb_IsNIL( s_bHcCancel )
      x := Eval( s_bHcCancel, s_nHcProgDone )
      RETURN ValType( x ) == "L" .AND. x
   ENDIF
   IF HcHeadless()
      RETURN .F.
   ENDIF
   s_lHcProgEsc := UiProgUpdate( s_nHcProgDone, s_nHcProgTotal )
RETURN s_lHcProgEsc

STATIC PROCEDURE HcProgEnd()
   IF ! HcHeadless()
      UiProgEnd()
   ENDIF
   s_lHcProgEsc := .F.
RETURN

/* ---- paths ---- */

/* a directory argument that hb_vfDirectory() accepts: it needs the trailing
 * separator (measured: without it the listing comes back with ONE element) */
STATIC FUNCTION HcDirArg( cDir )
   LOCAL c := AllTrim( cDir )
   IF Empty( c )
      RETURN ""
   ENDIF
   IF ! ( Right( c, 1 ) == "\" ) .AND. ! ( Right( c, 1 ) == "/" )
      c += "\"
   ENDIF
RETURN c

/* one form for comparisons: backslashes, no duplicate or trailing separator,
 * upper case (a trailing separator is kept on a drive root) */
/* One form for comparisons: backslashes, no duplicated, "." or ".."
 * components and no trailing separator, upper case. It is PURELY TEXTUAL (no
 * filesystem access) and it never climbs above the drive root or the UNC
 * prefix, so "C:\a\..\b" and "C:\b" compare equal, "C:\.." is "C:\" and
 * "C:\foo\..\foo2" is NOT inside "C:\foo". The paths handed to the
 * filesystem are never rewritten: this is only for containment judgements. */
STATIC FUNCTION HcNormPath( cPath )
   LOCAL c := AllTrim( cPath ), cPrefix := "", aPart, aOut := {}
   LOCAL i, cPart
   IF Empty( c )
      RETURN ""
   ENDIF
   c := StrTran( c, "/", "\" )
   /* the root is kept apart and rebuilt at the end, so that nothing can
    * climb over it */
   IF Left( c, 2 ) == "\\"
      cPrefix := "\\"
      c := SubStr( c, 3 )
   ELSEIF Len( c ) >= 2 .AND. SubStr( c, 2, 1 ) == ":"
      cPrefix := Upper( Left( c, 2 ) ) + "\"
      c := SubStr( c, 3 )
   ENDIF
   aPart := hb_ATokens( c, "\" )
   FOR i := 1 TO Len( aPart )
      cPart := aPart[ i ]
      DO CASE
      CASE Empty( cPart ) .OR. cPart == "."
         /* "" and "." are the current directory: they vanish */
      CASE cPart == ".."
         /* climbs one level, but never above the root: "C:\.." stays "C:\" */
         IF ! Empty( aOut )
            ASize( aOut, Len( aOut ) - 1 )
         ENDIF
      OTHERWISE
         AAdd( aOut, cPart )
      ENDCASE
   NEXT
   c := ""
   FOR i := 1 TO Len( aOut )
      c += iif( Empty( c ), "", "\" ) + aOut[ i ]
   NEXT
   IF Empty( c )
      /* "." and ".." of a root collapse to the root itself */
      RETURN cPrefix
   ENDIF
RETURN cPrefix + Upper( c )

/* .T. when cChild IS cParent or lives below it. The check is done on whole
 * path components (a trailing separator is required), so "C:\a\fb.txt" is not
 * "inside" "C:\a\f". */
FUNCTION HcPathInsideHc( cParent, cChild )
   LOCAL cP := HcNormPath( cParent ), cC := HcNormPath( cChild ), cSep
   IF Empty( cP ) .OR. Empty( cC )
      RETURN .F.
   ENDIF
   IF cC == cP
      RETURN .T.
   ENDIF
   /* a drive root (or a UNC prefix) already ends with the separator, so it is
    * not doubled when the prefix is compared */
   cSep := iif( Right( cP, 1 ) == "\", "", "\" )
RETURN Left( cC, Len( cP ) + Len( cSep ) ) == cP + cSep

/* .T. for "C:" / "C:" with nothing else: the file operations refuse it */
STATIC FUNCTION HcIsRootPath( cPath )
   LOCAL c := HcNormPath( cPath )
   IF Len( c ) == 2 .AND. Right( c, 1 ) == ":"
      RETURN .T.
   ENDIF
   IF Len( c ) == 3 .AND. Right( c, 1 ) == "\" .AND. SubStr( c, 2, 1 ) == ":"
      RETURN .T.
   ENDIF
RETURN Empty( c )

/* .T. when the path names ".", ".." or a drive root: the operations refuse it
 * on their own, so the API is safe even when it is not driven by the panel
 * (the panel already filters ".." out of the source set). */
STATIC FUNCTION HcIsBadTarget( cPath )
   LOCAL cNorm := HcNormPath( cPath )
   IF Empty( cNorm ) .OR. cNorm == "." .OR. cNorm == ".."
      RETURN .T.
   ENDIF
RETURN HcIsRootPath( cNorm )

/* ---- operations ---- */

/* { nFiles, nBytes } of a file or of a whole tree */
FUNCTION HcCountTreeHc( cPath )
   LOCAL aRaw, aE, aRes, i, nFiles := 0, nBytes := 0
   IF hb_DirExists( cPath )
      aRaw := hb_vfDirectory( HcDirArg( cPath ), "HSD" )
      IF ! HB_ISARRAY( aRaw )
         aRaw := {}
      ENDIF
      FOR i := 1 TO Len( aRaw )
         aE := aRaw[ i ]
         IF ! ( aE[ 1 ] == "." ) .AND. ! ( aE[ 1 ] == ".." )
            aRes := HcCountTreeHc( HcJoinPath( cPath, aE[ 1 ] ) )
            nFiles += aRes[ 1 ]
            nBytes += aRes[ 2 ]
         ENDIF
      NEXT
      RETURN { nFiles, nBytes }
   ENDIF
   IF hb_vfExists( cPath )
      RETURN { 1, hb_vfSize( cPath ) }
   ENDIF
RETURN { 0, 0 }

/* copies ONE file in chunks. { lOk, cError, lCancelled }. A cancelled copy
 * removes the partial destination: a half written file is not a completed
 * step of the operation. */
/* copies ONE file in chunks THROUGH A TEMPORARY ("<dst>.$$$"): the
 * destination is only replaced when the whole copy is on disk, so a cancel or
 * an error leaves the previous destination byte-identical (S4). A stale
 * temporary from an interrupted run is removed first.
 * { lOk, cError, lCancelled }. */
STATIC FUNCTION HcCopyOneFile( cSrc, cDst )
   LOCAL nIn, nOut, nRead, nWritten, cBuf, cTmp, cErr := "", lCancel := .F.
   cTmp := cDst + HC_COPY_TMP
   nIn := FOpen( cSrc, FO_READ )
   IF nIn < 0
      RETURN { .F., "Cannot open " + cSrc, .F. }
   ENDIF
   IF hb_vfExists( cTmp )
      hb_vfErase( cTmp )
   ENDIF
   nOut := FCreate( cTmp )
   IF nOut < 0
      FClose( nIn )
      RETURN { .F., "Cannot create " + cTmp, .F. }
   ENDIF
   cBuf := Space( HC_COPY_CHUNK )
   nRead := FRead( nIn, @cBuf, HC_COPY_CHUNK )
   DO WHILE nRead > 0
      nWritten := FWrite( nOut, Left( cBuf, nRead ) )
      IF ValType( nWritten ) != "N" .OR. nWritten != nRead
         cErr := "Cannot write " + cTmp
         EXIT
      ENDIF
      IF HcProgStep( nRead )
         lCancel := .T.
         EXIT
      ENDIF
      nRead := FRead( nIn, @cBuf, HC_COPY_CHUNK )
   ENDDO
   FClose( nIn )
   FClose( nOut )
   IF ! Empty( cErr ) .OR. lCancel
      /* nothing of the previous destination was touched */
      hb_vfErase( cTmp )
      RETURN { .F., cErr, lCancel }
   ENDIF
   /* the copy is complete: replace the destination with it. hb_vfRename()
    * returns 0 when it worked (like the other hb_vf* file functions). */
   IF hb_vfExists( cDst ) .AND. hb_vfErase( cDst ) != 0
      hb_vfErase( cTmp )
      RETURN { .F., "Cannot replace " + cDst, .F. }
   ENDIF
   IF hb_vfRename( cTmp, cDst ) != 0
      hb_vfErase( cTmp )
      RETURN { .F., "Cannot rename " + cTmp + " to " + cDst, .F. }
   ENDIF
RETURN { .T., "", .F. }

/* Copies a file or a whole directory tree. For a directory cDst is the NEW
 * directory (it is created when it does not exist).
 * { lOk, cError, nFiles, nBytes, lCancelled } */
FUNCTION HcCopyAnyHc( cSrc, cDst )
   LOCAL aRaw, aE, aRes, i, lOk := .T., cErr := "", nFiles := 0, nBytes := 0
   IF Empty( cSrc ) .OR. Empty( cDst )
      RETURN { .F., "The source and the destination cannot be empty.", 0, 0, .F. }
   ENDIF
   /* ".", ".." and a drive root are never a source or a destination */
   IF HcIsBadTarget( cSrc )
      RETURN { .F., "Refusing to copy a drive root, the current or the parent directory: " + cSrc, 0, 0, .F. }
   ENDIF
   IF HcIsBadTarget( cDst )
      RETURN { .F., "Refusing to copy to a drive root, the current or the parent directory: " + cDst, 0, 0, .F. }
   ENDIF
   IF ! hb_DirExists( cSrc ) .AND. ! hb_vfExists( cSrc )
      RETURN { .F., "Not found: " + cSrc, 0, 0, .F. }
   ENDIF
   /* a file can never be copied onto itself: FCreate() would truncate the
    * source while it is being read (both panels are often in the same
    * directory and the destination is proposed from the other one) */
   IF ! hb_DirExists( cSrc ) .AND. HcNormPath( cSrc ) == HcNormPath( cDst )
      RETURN { .F., "Cannot copy a file onto itself: " + cSrc, 0, 0, .F. }
   ENDIF
   IF hb_DirExists( cSrc )
      /* a tree can never be copied into itself: the listing would keep
       * finding the copy that is being written */
      IF HcPathInsideHc( cSrc, cDst )
         RETURN { .F., "Cannot copy a directory into itself: " + cDst, 0, 0, .F. }
      ENDIF
      IF ! hb_DirExists( cDst )
         IF hb_DirCreate( cDst ) != 0
            RETURN { .F., "Cannot create the directory " + cDst, 0, 0, .F. }
         ENDIF
      ENDIF
      aRaw := hb_vfDirectory( HcDirArg( cSrc ), "HSD" )
      IF ! HB_ISARRAY( aRaw )
         aRaw := {}
      ENDIF
      FOR i := 1 TO Len( aRaw )
         aE := aRaw[ i ]
         IF ! ( aE[ 1 ] == "." ) .AND. ! ( aE[ 1 ] == ".." )
            aRes := HcCopyAnyHc( HcJoinPath( cSrc, aE[ 1 ] ), HcJoinPath( cDst, aE[ 1 ] ) )
            nFiles += aRes[ 3 ]
            nBytes += aRes[ 4 ]
            IF ! aRes[ 1 ]
               IF aRes[ 5 ]
                  RETURN { .F., "", nFiles, nBytes, .T. }
               ENDIF
               IF Empty( cErr )
                  cErr := aRes[ 2 ]
               ENDIF
               lOk := .F.
            ENDIF
         ENDIF
      NEXT
      RETURN { lOk, cErr, nFiles, nBytes, .F. }
   ENDIF
   /* one file */
   aRes := HcCopyOneFile( cSrc, cDst )
   IF ! aRes[ 1 ]
      RETURN { .F., aRes[ 2 ], 0, 0, aRes[ 3 ] }
   ENDIF
RETURN { .T., "", 1, hb_vfSize( cDst ), .F. }

/* { lOk, cError, lCancelled }: copies and then removes the source (the way
 * upstream moves). A directory that would land inside itself is refused before
 * anything is copied, and the source is only removed once the copy is there. */
FUNCTION HcMoveHc( cSrc, cDst )
   LOCAL aRes, lDir
   IF Empty( cSrc ) .OR. Empty( cDst )
      RETURN { .F., "The source and the destination cannot be empty.", .F. }
   ENDIF
   /* ".", ".." and a drive root are never moved */
   IF HcIsBadTarget( cSrc )
      RETURN { .F., "Refusing to move a drive root, the current or the parent directory: " + cSrc, .F. }
   ENDIF
   IF HcIsBadTarget( cDst )
      RETURN { .F., "Refusing to move to a drive root, the current or the parent directory: " + cDst, .F. }
   ENDIF
   IF ! hb_vfExists( cSrc ) .AND. ! hb_DirExists( cSrc )
      RETURN { .F., "Not found: " + cSrc, .F. }
   ENDIF
   IF HcPathInsideHc( cSrc, cDst )
      RETURN { .F., "Cannot move a directory into itself or into one of its descendants: " + cDst, .F. }
   ENDIF
   lDir := hb_DirExists( cSrc )
   aRes := HcCopyAnyHc( cSrc, cDst )
   IF ! aRes[ 1 ]
      RETURN { .F., aRes[ 2 ], aRes[ 5 ] }
   ENDIF
   IF lDir
      IF ! hb_DirRemoveAll( cSrc )
         RETURN { .F., "Copied, but the source directory could not be removed: " + cSrc, .F. }
      ENDIF
   ELSE
      IF ! hb_vfExists( cDst ) .OR. hb_vfSize( cDst ) != hb_vfSize( cSrc )
         RETURN { .F., "Copied, but the source file could not be verified and removed: " + cSrc, .F. }
      ENDIF
      IF hb_vfErase( cSrc ) != 0
         RETURN { .F., "Copied, but the source file could not be removed: " + cSrc, .F. }
      ENDIF
   ENDIF
RETURN { .T., "", .F. }

/* { lOk, cError }: creates one directory (hb_DirCreate returns the OS error
 * code, 0 when it worked) */
FUNCTION HcMakeDirHc( cDir )
   LOCAL c := AllTrim( cDir ), nErr
   IF Empty( c )
      RETURN { .F., "The name cannot be empty." }
   ENDIF
   IF hb_DirExists( c ) .OR. hb_vfExists( c )
      RETURN { .F., "It already exists: " + c }
   ENDIF
   nErr := hb_DirCreate( c )
   IF nErr != 0
      RETURN { .F., "Cannot create " + c + " (error " + LTrim( Str( nErr ) ) + ")" }
   ENDIF
RETURN { .T., "" }

/* { lOk, cError }: deletes a file or a whole tree. ".", ".." and a drive
 * root are refused HERE, not only by the panel that builds the list. This is
 * the PERMANENT delete: it is what Shift+Del asks for, and what the Recycle
 * Bin path falls back to when this build has no bin (S2/S6 of
 * recycle-bin-delete.md). */
FUNCTION HcDeleteHc( cPath )
   LOCAL c := AllTrim( cPath )
   IF Empty( c )
      RETURN { .F., "The name cannot be empty." }
   ENDIF
   IF HcIsBadTarget( c )
      RETURN { .F., "Refusing to delete a drive root, the current or the parent directory: " + c }
   ENDIF
   IF hb_DirExists( c )
      IF ! hb_DirRemoveAll( c )
         RETURN { .F., "Cannot delete the directory " + c }
      ENDIF
      RETURN { .T., "" }
   ENDIF
   IF hb_vfExists( c )
      IF hb_vfErase( c ) != 0
         RETURN { .F., "Cannot delete " + c }
      ENDIF
      RETURN { .T., "" }
   ENDIF
RETURN { .F., "Not found: " + c }

/* ---- S1/S2/S5/S7 of recycle-bin-delete.md: where a delete goes ----
 *
 *  Del and F8 send the entry to the Windows Recycle Bin, Shift+Del deletes it
 *  for ever. The RULE lives in the pure helpers below (HcDeleteMode() says the
 *  mode of one stroke as text, HcDeleteAsk() builds the text with it) and the
 *  ONE place that decides the mode of a single entry is HcDeleteOneHc(), so
 *  the panel, the key loop and the synchronizer cannot disagree. */

/* S2: the mode of ONE stroke as text: "hard" for Shift+Del, "recycle" for
 * everything else. Pure, so the headless bank pins it. */
FUNCTION HcDeleteMode( lHard )
   IF ValType( lHard ) == "L" .AND. lHard
      RETURN "hard"
   ENDIF
RETURN "recycle"

/* S4: the confirmation text of a delete, in the THREE shapes the screen has
 * always had (one directory / only files / a mix, whose second line spells the
 * counts out) and, since recycle-bin-delete.md, it always says WHERE the
 * entries go: " permanently" for Shift+Del and " to the Recycle Bin" for Del
 * and F8. Pure and public, so the text and the behaviour cannot diverge.
 *   nItems      entries of the set
 *   nFiles      how many of them are files
 *   nDirs       how many of them are directories
 *   cSingleDir  name of the directory when the set is EXACTLY one directory
 *               ("" otherwise; with no name the mix shape is used)
 *   lHard       .T. for Shift+Del */
FUNCTION HcDeleteAsk( nItems, nFiles, nDirs, cSingleDir, lHard )
   LOCAL cWhere := iif( HcDeleteMode( lHard ) == "hard", ;
                        " permanently", " to the Recycle Bin" )
   DEFAULT nItems TO 0, nFiles TO 0, nDirs TO 0, cSingleDir TO ""
   IF nItems == 1 .AND. nDirs == 1 .AND. ! Empty( cSingleDir )
      RETURN "Delete directory " + cSingleDir + " and all its contents" + cWhere + "?"
   ENDIF
   IF nDirs == 0
      RETURN "Delete " + LTrim( Str( nFiles ) ) + " file(s)" + cWhere + "?"
   ENDIF
RETURN "Delete " + LTrim( Str( nItems ) ) + " item(s)" + cWhere + "?" + hb_eol() + ;
       "(" + LTrim( Str( nFiles ) ) + " file(s) and " + ;
       LTrim( Str( nDirs ) ) + " director(ies) with their contents)"

/* S1 of recycle-bin-delete.md: the Windows Recycle Bin, for a whole list.
 *    1  the shell took every path to the bin
 *    0  the shell refused (S5: the caller must NOT delete those paths)
 *   -1  this build has no bin, and then the permanent delete is what is left
 * The headless bank never reaches the native side: it answers -1 and therefore
 * exercises the permanent path it always exercised (S6). */
STATIC FUNCTION HcRecycleHc( aPaths )
#ifdef BP_HC_STANDALONE
   /* the headless bank must NEVER touch the Recycle Bin of the machine that
    * runs it: there is no window and no shell here, so the answer is "not
    * available" and the caller falls back to the permanent delete (S6) */
   HB_SYMBOL_UNUSED( aPaths )
RETURN -1
#else
RETURN W32Recycle( aPaths )
#endif

/* S1/S2/S5/S7: ONE entry, through the mode that stroke asked for, as
 * { lOk, cError }. This is the only place that decides it, so the panel, the
 * synchronizer and anything else that deletes an entry share one rule.
 * With lHard the permanent delete of HcDeleteHc() runs directly; without it
 * the entry goes to the Recycle Bin and only a "not available in this build"
 * answer (-1) falls back to the permanent one. A shell refusal (0) is a
 * FAILURE with the path in the message: never a silent permanent delete (S5). */
STATIC FUNCTION HcDeleteOneHc( cPath, lHard )
   LOCAL nBin
#ifndef BP_HC_STANDALONE
   /* BP_DEBUG=1 trace: the MODE each entry was deleted with is what tells a
    * Recycle Bin delete from a permanent one when the shell is the observer */
   BpLog( "HC delete=" + HcDeleteMode( lHard ) + " " + cPath )
#endif
   IF ValType( lHard ) == "L" .AND. lHard
      RETURN HcDeleteHc( cPath )
   ENDIF
   nBin := HcRecycleHc( { cPath } )
   IF nBin == 1
      RETURN { .T., "" }
   ENDIF
   IF nBin == -1
      /* no Recycle Bin in this build (headless bank): the permanent delete,
       * which is exactly what this program did before this change (S6) */
      RETURN HcDeleteHc( cPath )
   ENDIF
RETURN { .F., "Cannot move to the Recycle Bin: " + cPath }

/* Deletes a whole set AFTER ONE confirmation whose text the caller builds (it
 * names the count and the target). Returns
 *    { lOk, cError, nDeleted, lCancelled }
 * With lCancelled the filesystem was not touched at all, which is what the
 * headless bank checks with a hook that answers .F.
 *
 * S1/S2/S5 of recycle-bin-delete.md: lHard (optional, .F. by default) chooses
 * the mode of EVERY entry of the set. Without it the entries go to the Windows
 * Recycle Bin and, when the shell refuses one, that entry is reported as a
 * failure and is NOT deleted for ever behind the user's back (S5). */
FUNCTION HcDeleteSetHc( aPaths, cText, lHard )
   LOCAL i, aRes, cErr := "", nDeleted := 0, lOk := .T.
   DEFAULT lHard TO .F.
   IF Empty( aPaths )
      RETURN { .F., "Nothing to delete.", 0, .F. }
   ENDIF
   IF ! HcConfirm( cText, "Delete" )
      RETURN { .T., "", 0, .T. }
   ENDIF
   FOR i := 1 TO Len( aPaths )
      aRes := HcDeleteOneHc( aPaths[ i ], lHard )
      IF aRes[ 1 ]
         nDeleted++
      ELSE
         lOk := .F.
         IF Empty( cErr )
            cErr := aRes[ 2 ]
         ENDIF
      ENDIF
   NEXT
RETURN { lOk, cErr, nDeleted, .F. }

/* ---- the F-key handlers ---- */

STATIC FUNCTION HcOtherPanel()
RETURN iif( HcActive() == HC_PANEL_L, HC_PANEL_R, HC_PANEL_L )

/* the entries an operation acts on: the marked ones, or the entry under the
 * cursor when nothing is marked (never the ".." entry) */
STATIC FUNCTION HcSourceSet( aP )
   LOCAL a := {}, i, n
   FOR i := 1 TO Len( aP[ HC_P_LIST ] )
      IF aP[ HC_P_LIST ][ i ][ HC_E_MARK ] .AND. ;
         ! ( aP[ HC_P_LIST ][ i ][ HC_E_NAME ] == ".." )
         AAdd( a, aP[ HC_P_LIST ][ i ] )
      ENDIF
   NEXT
   IF Empty( a )
      n := aP[ HC_P_SEL ]
      IF n >= 1 .AND. n <= Len( aP[ HC_P_LIST ] ) .AND. ;
         ! ( aP[ HC_P_LIST ][ n ][ HC_E_NAME ] == ".." )
         AAdd( a, aP[ HC_P_LIST ][ n ] )
      ENDIF
   ENDIF
RETURN a

/* reloads BOTH panels (the reload clears the marks of the acted-on entries)
 * and leaves the cursor on cWantName when it landed in cWantDir, or on the
 * same index as before (the closest surviving entry) otherwise */
STATIC PROCEDURE HcReloadPanels( cWantDir, cWantName )
   LOCAL nId, aP, nSel
   FOR nId := HC_PANEL_L TO HC_PANEL_R
      aP := HcPanel( nId )
      nSel := aP[ HC_P_SEL ]
      HcLoad( aP )
      IF ! Empty( cWantName ) .AND. HcNormPath( aP[ HC_P_DIR ] ) == HcNormPath( cWantDir )
         HcGotoName( aP, cWantName )
      ELSE
         HcCursorTo( aP, nSel )
      ENDIF
   NEXT
RETURN

/* name typed in the F7 dialog: the characters Windows refuses are refused
 * here first, with a message */
STATIC FUNCTION HcNameOk( cName )
   LOCAL aBad := { "\", "/", ":", "*", "?", Chr( 34 ), "<", ">", "|" }, i
   FOR i := 1 TO Len( aBad )
      IF aBad[ i ] $ cName
         RETURN .F.
      ENDIF
   NEXT
RETURN .T.

/* =====================================================================
 *  S17: the overwrite dialog of F5
 *
 *  When the destination of a copy already exists, a 3x3 grid of SEVEN buttons
 *  decides what happens with THAT conflict (odd/tasks/hc-panels-overwrite.md,
 *  S17):
 *
 *     Replace          Replace All      Skip
 *     Cancel           Replace Older    Skip All
 *     Rename
 *
 *  One copy operation is one session of decisions: "Replace All" / "Skip All"
 *  answer the rest of the conflicts of the SAME operation without asking. That
 *  sticky state is a LOCAL of HcCopy(), so nothing survives the operation, and
 *  the pure HcOwDecide()/HcOwResolve() pair below is what translates a button
 *  (plus the state) into an action.
 *
 *  Headless: with HcSetOverwriteHook() the dialog is not drawn and the hook
 *  answers the choice; with NO hook and NO window (BP_HC_STANDALONE) the answer
 *  is always "Skip", so a headless run can never overwrite anything behind the
 *  caller's back (the same rule HcConfirm() follows by answering "No").
 * ===================================================================== */

/* The seven buttons in their grid: { label with ~X~ hot letter, row, column }.
 * The two last cells of the 3x3 grid stay empty on purpose.
 *
 * ENGLISH LABELS (the project rule of AGENTS.md section 6: every UI text goes in
 * English like BRO.EXE), so each hot letter is a letter OF ITS OWN WORD:
 * Replace (R), Replace All (A for "All"), Skip (S), Cancel (C), Replace Older
 * (O), Skip All (L for "aLL") and Rename (N). */
STATIC FUNCTION HcOwButtons()
RETURN { { "~R~eplace", 1, 1 }, { "Replace ~A~ll", 1, 2 }, { "~S~kip", 1, 3 }, ;
         { "~C~ancel", 2, 1 }, { "Replace ~O~lder", 2, 2 }, { "Skip A~l~l", 2, 3 }, ;
         { "Re~n~ame", 3, 1 } }

/* The S17 table as a PURE function: { cAction, nState }.
 *
 *   cAction  "REPLACE" | "SKIP" | "CANCEL" | "RENAME"
 *   nState   0 = ask again on the next conflict
 *            1 = replace the rest of THIS copy operation
 *            2 = skip the rest of THIS copy operation
 *
 * lOlder is only looked at by "Replace Older" (choice 5): .T. means the
 * DESTINATION is strictly older than the source. An equal or newer destination
 * is skipped, exactly like an unknown timestamp (see HcOwOlder()). */
FUNCTION HcOwDecide( nChoice, lOlder )
   DEFAULT lOlder TO .F.
   DO CASE
   CASE nChoice == 1                    /* Replace                          */
      RETURN { "REPLACE", 0 }
   CASE nChoice == 2                    /* Replace All                      */
      RETURN { "REPLACE", 1 }
   CASE nChoice == 3                    /* Skip                             */
      RETURN { "SKIP", 0 }
   CASE nChoice == 4                    /* Cancel                           */
      RETURN { "CANCEL", 0 }
   CASE nChoice == 5                    /* Replace Older                    */
      IF lOlder
         RETURN { "REPLACE", 0 }
      ENDIF
      RETURN { "SKIP", 0 }
   CASE nChoice == 6                    /* Skip All                         */
      RETURN { "SKIP", 2 }
   CASE nChoice == 7                    /* Rename                           */
      RETURN { "RENAME", 0 }
   ENDCASE
   /* an answer outside 1..7 is NEVER a decision to overwrite: the entry is
    * skipped, the rest of the operation keeps going and nothing is touched */
RETURN { "SKIP", 0 }

/* The sticky state of the operation plus the choice just made (pure). With a
 * state of 1 or 2 the question is not asked again: the first "replace/skip the
 * rest" answer decides for every following conflict of the same operation. */
FUNCTION HcOwResolve( nState, nChoice, lOlder )
   IF nState == 1
      RETURN { "REPLACE", 1 }
   ELSEIF nState == 2
      RETURN { "SKIP", 2 }
   ENDIF
RETURN HcOwDecide( nChoice, lOlder )

/* { hh, mm, ss } of the "HH:MM:SS" (or "HHMMSS") string hb_vfTimeGet() hands
 * over; { 0, 0, 0 } when it cannot be read. Hour()/Minute() do NOT exist in
 * this build, so the time is taken from the string. */
STATIC FUNCTION HcOwClock( cTime )
   LOCAL c, aPart
   IF ValType( cTime ) != "C"
      RETURN { 0, 0, 0 }
   ENDIF
   c := AllTrim( cTime )
   IF Empty( c )
      RETURN { 0, 0, 0 }
   ENDIF
   IF ":" $ c
      aPart := hb_ATokens( c, ":" )
      DO WHILE Len( aPart ) < 3
         AAdd( aPart, "0" )
      ENDDO
      RETURN { Int( Val( aPart[ 1 ] ) ), Int( Val( aPart[ 2 ] ) ), Int( Val( aPart[ 3 ] ) ) }
   ENDIF
   c := StrZero( Int( Val( c ) ), 6 )
RETURN { Val( Left( c, 2 ) ), Val( SubStr( c, 3, 2 ) ), Val( Right( c, 2 ) ) }

/* Sortable timestamp of a file as 14 characters "YYYYMMDDHHMMSS", or "" when
 * the file cannot be read: it is the comparison key of "Replace Older".
 * Measured on this build: hb_vfTimeGet() is the by-reference API
 * ( hb_vfTimeGet( cFile, @dDate, @cTime ) -> lOk ), so the date comes back as a
 * Date and the time as an "HH:MM:SS" string. */
FUNCTION HcFileStampKey( cFile )
   LOCAL dDate, cTime, lOk, aT
   IF ValType( cFile ) != "C" .OR. Empty( AllTrim( cFile ) )
      RETURN ""
   ENDIF
   dDate := CToD( "" )
   cTime := ""
   lOk := hb_vfTimeGet( cFile, @dDate, @cTime )
   IF ! ( ValType( lOk ) == "L" ) .OR. ! lOk
      RETURN ""
   ENDIF
   /* a build that answers a timestamp instead of a Date is accepted too */
   IF ValType( dDate ) == "T"
      dDate := hb_TToD( dDate )
   ENDIF
   IF ValType( dDate ) != "D" .OR. Empty( dDate )
      RETURN ""
   ENDIF
   aT := HcOwClock( cTime )
RETURN StrZero( Year( dDate ), 4 ) + StrZero( Month( dDate ), 2 ) + ;
       StrZero( Day( dDate ), 2 ) + StrZero( aT[ 1 ], 2 ) + ;
       StrZero( aT[ 2 ], 2 ) + StrZero( aT[ 3 ], 2 )

/* .T. only when BOTH timestamps are known and the destination is STRICTLY
 * older than the source: an equal, newer or unreadable timestamp is never
 * taken as older, so "Replace Older" leaves the file alone. */
STATIC FUNCTION HcOwOlder( cSrc, cDst )
   LOCAL cS := HcFileStampKey( cSrc ), cD := HcFileStampKey( cDst )
   IF Empty( cS ) .OR. Empty( cD )
      RETURN .F.
   ENDIF
RETURN cD < cS

/* the timestamp the dialog shows, so the user can see what "older" means */
STATIC FUNCTION HcOwStampText( cFile )
   LOCAL cKey := HcFileStampKey( cFile )
   IF Empty( cKey )
      RETURN "(no timestamp)"
   ENDIF
RETURN Left( cKey, 4 ) + "-" + SubStr( cKey, 5, 2 ) + "-" + SubStr( cKey, 7, 2 ) + ;
       " " + SubStr( cKey, 9, 2 ) + ":" + SubStr( cKey, 11, 2 ) + ":" + SubStr( cKey, 13, 2 )

/* The size to show next to each timestamp, so the two files can be compared
 * before answering: "3 bytes", "DIR" for a directory and "?" when the file
 * cannot be read. Public so the headless bank can pin it. */
FUNCTION HcOwSizeText( cFile )
   LOCAL n
   IF Empty( cFile )
      RETURN "?"
   ENDIF
   IF hb_DirExists( cFile )
      RETURN "DIR"
   ENDIF
   IF ! hb_vfExists( cFile )
      RETURN "?"
   ENDIF
   n := hb_vfSize( cFile )
   IF ValType( n ) != "N" .OR. n < 0
      RETURN "?"
   ENDIF
RETURN HcSizeText( n ) + " bytes"

/* offsets and widths of the three button columns (0 based, inside the box):
 * { aColOff, aColW, nTotalW }. One space each side of every label and three
 * columns between two buttons. */
STATIC FUNCTION HcOwGrid()
   LOCAL aB := HcOwButtons(), aW := { 0, 0, 0 }, aOfs := {}
   LOCAL i, n := 0
   FOR i := 1 TO Len( aB )
      aW[ aB[ i ][ 3 ] ] := Max( aW[ aB[ i ][ 3 ] ], UiHotLen( aB[ i ][ 1 ] ) )
   NEXT
   FOR i := 1 TO 3
      AAdd( aOfs, n )
      n += aW[ i ] + 2 + 3
   NEXT
RETURN { aOfs, aW, n - 3 }

/* one button: the focused one in the colour of UiConfirmBtn() and the hot key
 * in its own colour, so the user sees where the focus is. The label is padded
 * so the background covers the whole cell. */
STATIC PROCEDURE HcOwBtn( nRow, nCol, cLabel, nW, lOn )
   LOCAL c := " " + cLabel + Space( nW - UiHotLen( cLabel ) + 1 )
   UiDrawHot( nRow, nCol, c, iif( lOn, UI_C_BOXSEL, UI_C_MENUKEY ), ;
              iif( lOn, UI_C_HOTSEL, UI_C_HOTON ) )
RETURN

/* The seven buttons of the grid. The caller owns the paint block, so moving the
 * focus repaints only these three rows. */
STATIC PROCEDURE HcOwBtns( nT, nL, nI, nSel )
   LOCAL aB := HcOwButtons(), aG := HcOwGrid(), aOfs := aG[ 1 ], aW := aG[ 2 ]
   LOCAL i, nCol := nL + 1 + Max( 0, Int( ( nI - aG[ 3 ] ) / 2 ) )
   FOR i := 1 TO Len( aB )
      HcOwBtn( nT + 8 + aB[ i ][ 2 ], nCol + aOfs[ aB[ i ][ 3 ] ], ;
               aB[ i ][ 1 ], aW[ aB[ i ][ 3 ] ], i == nSel )
   NEXT
   SetColor( UI_C_DESKTOP )
RETURN

/* <key>=action chip on the background of the box (the house style of
 * HcHintKey(), on the dialog background instead of the screen one) */
STATIC FUNCTION HcOwHint( nRow, nCol, cKey, cAct )
   SetColor( UI_C_MENUKEY )
   @ nRow, nCol SAY "<" + cKey + ">"
   SetColor( UI_C_BOX )
   @ nRow, nCol + Len( cKey ) + 2 SAY cAct
RETURN nCol + Len( cKey ) + 2 + Len( cAct ) + 2

/* one labelled line: the label in the box colour and the value in yellow, cut
 * so it never runs out of the frame */
STATIC PROCEDURE HcOwLine( nRow, nL, nI, cLabel, cValue )
   LOCAL nLabW := 18, nValW := nI - 18
   IF nValW < 1
      RETURN
   ENDIF
   SetColor( UI_C_BOX )
   @ nRow, nL + 1 SAY PadR( cLabel, nLabW )
   SetColor( UI_C_HOT )
   @ nRow, nL + 1 + nLabW SAY PadR( HcPathTitle( cValue, nValW ), nValW )
   SetColor( UI_C_BOX )
RETURN

/* the whole dialog. The caller owns the paint block.
 * <aInfo> is NIL for a LOCAL copy: the two timestamps and the two sizes are then
 * read from the disk with HcOwStampText()/HcOwSizeText(). A copy across the
 * link has a side that is NOT on this disk, and a remote path must never reach
 * hb_vfTimeGet()/hb_vfSize(), so that caller hands the four texts over instead:
 * { source time, source size, destination time, destination size }, where a NIL
 * element still means "ask the disk". */
STATIC PROCEDURE HcOwPaint( nT, nL, nI, nSel, cName, cSrc, cTo, aInfo )
   LOCAL nB := nT + 14, nR := nL + nI + 1, nCol, nW, i
   LOCAL aHint := { { "Arrows", "=Move" }, { "Enter", "=Select" }, { "Esc", "=Cancel" } }
   LOCAL cStS := NIL, cStZ := NIL, cDstS := NIL, cDstZ := NIL
   IF HB_ISARRAY( aInfo ) .AND. Len( aInfo ) >= 4
      cStS := aInfo[ 1 ] ; cStZ := aInfo[ 2 ]
      cDstS := aInfo[ 3 ] ; cDstZ := aInfo[ 4 ]
   ENDIF
   IF ValType( cStS ) != "C"
      cStS := HcOwStampText( cSrc )
   ENDIF
   IF ValType( cStZ ) != "C"
      cStZ := HcOwSizeText( cSrc )
   ENDIF
   IF ValType( cDstS ) != "C"
      cDstS := HcOwStampText( cTo )
   ENDIF
   IF ValType( cDstZ ) != "C"
      cDstZ := HcOwSizeText( cTo )
   ENDIF
   UiShadow( nT, nL, nB, nR )
   UiFillBox( nT, nL, nB, nR, UI_C_BOX )
   UiFrame( nT, nL, nB, nR, UI_C_BOX, .T. )
   SetColor( UI_C_BOX )
   /* the title goes as a chip over the top border without eating its end */
   @ nT, nL + 2 SAY " Overwrite "
   HcOwLine( nT + 1, nL, nI, "File:",              cName )
   HcOwLine( nT + 2, nL, nI, "Source:",            cSrc )
   HcOwLine( nT + 3, nL, nI, "Destination:",       cTo )
   HcOwLine( nT + 4, nL, nI, "Source time:",       cStS )
   HcOwLine( nT + 5, nL, nI, "Source size:",       cStZ )
   HcOwLine( nT + 6, nL, nI, "Destination time:",  cDstS )
   HcOwLine( nT + 7, nL, nI, "Destination size:",  cDstZ )
   HcOwBtns( nT, nL, nI, nSel )
   /* the hint chips are CENTRED inside the frame and ONE BLANK ROW below the
    * last row of buttons (they used to sit glued to it, starting at the left
    * edge and leaving a long empty tail on the right) */
   nW := 0
   FOR i := 1 TO Len( aHint )
      nW += Len( aHint[ i ][ 1 ] ) + 2 + Len( aHint[ i ][ 2 ] )
      IF i < Len( aHint )
         nW += 2
      ENDIF
   NEXT
   nCol := nL + 1 + Max( 0, Int( ( nI - nW ) / 2 ) )
   FOR i := 1 TO Len( aHint )
      nCol := HcOwHint( nT + 13, nCol, aHint[ i ][ 1 ], aHint[ i ][ 2 ] )
   NEXT
   SetColor( UI_C_DESKTOP )
RETURN

/* index of the button at (row, column) of the grid, or 0 when that cell is one
 * of the two empty ones */
STATIC FUNCTION HcOwIndex( aB, nRow, nCol )
   LOCAL i
   FOR i := 1 TO Len( aB )
      IF aB[ i ][ 2 ] == nRow .AND. aB[ i ][ 3 ] == nCol
         RETURN i
      ENDIF
   NEXT
RETURN 0

/* The button the arrows move to: the nearest existing one in that direction
 * inside the grid (a cell that does not exist keeps the focus where it is). */
STATIC FUNCTION HcOwMove( nSel, nKey )
   LOCAL aB := HcOwButtons(), nRow, nCol, i, n
   IF nSel < 1 .OR. nSel > Len( aB )
      RETURN 1
   ENDIF
   nRow := aB[ nSel ][ 2 ]
   nCol := aB[ nSel ][ 3 ]
   DO CASE
   CASE nKey == K_LEFT .OR. nKey == K_SH_TAB
      FOR i := nCol - 1 TO 1 STEP -1
         n := HcOwIndex( aB, nRow, i )
         IF n > 0
            RETURN n
         ENDIF
      NEXT
   CASE nKey == K_RIGHT .OR. nKey == K_TAB
      FOR i := nCol + 1 TO 3
         n := HcOwIndex( aB, nRow, i )
         IF n > 0
            RETURN n
         ENDIF
      NEXT
   CASE nKey == K_UP
      FOR i := nRow - 1 TO 1 STEP -1
         n := HcOwIndex( aB, i, nCol )
         IF n > 0
            RETURN n
         ENDIF
      NEXT
   CASE nKey == K_DOWN
      FOR i := nRow + 1 TO 3
         n := HcOwIndex( aB, i, nCol )
         IF n > 0
            RETURN n
         ENDIF
      NEXT
   ENDCASE
RETURN nSel

/* the button whose hot letter was typed, or 0 (the letters are R, A, S, C, O,
 * L, N and they come from the ~X~ marks of the labels) */
STATIC FUNCTION HcOwHot( nKey )
   LOCAL aB := HcOwButtons(), i, c
   IF nKey < 32 .OR. nKey > 255
      RETURN 0
   ENDIF
   c := Upper( Chr( nKey ) )
   FOR i := 1 TO Len( aB )
      IF UiHotKey( aB[ i ][ 1 ] ) == c
         RETURN i
      ENDIF
   NEXT
RETURN 0

/* S17: the button a typed key activates, 0 when that key is not a hot letter.
 * Public so the headless bank can pin the letters R/A/S/C/O/L/N.
 */
FUNCTION HcOwHotKey( nKey )
RETURN HcOwHot( nKey )

/* The dialog itself: 7 buttons of the S17 grid, the file and the two paths with
 * their timestamps above them. Returns 1..7 (see HcOwDecide()). <aInfo> is the
 * optional hand-over of the four texts of HcOwPaint(): a copy across the link
 * needs it because one of the two sides is not on this disk. */
/* =====================================================================
 * Windows FILE clipboard (odd/tasks/hc-clipboard-files.md, S1-S9)
 *
 * Ctrl+C / Ctrl+Ins leave the marked entries (or the cursor entry) in the
 * clipboard as a CF_HDROP list, so the desktop and Explorer PASTE the files.
 * Ctrl+V / Shift+Ins copy the clipboard list into the directory of the active
 * panel, with the very same engine as F5: atomic write, overwrite dialog,
 * progress bar and reload. The native side lives in bp_win32.c
 * (W32ClipFilesPut/Count/At); the extension never returns an array, hence the
 * count + accessor pair.
 * ===================================================================== */

/* The destinations of a paste, worked out from TEXT only, so the headless bank
 * can pin it: { { cSrc, cDst, cFlag } } with cFlag "" (copy it), "SAME" (the
 * destination IS the source) or "INSIDE" (a directory into itself). Whether
 * the source still exists is decided by the caller, which has the disk. */
FUNCTION HcClipTargets( aPaths, cDest )
   LOCAL aOut := {}, cSrc, cName, cDst, i
   IF ! HB_ISARRAY( aPaths )
      RETURN aOut
   ENDIF
   FOR i := 1 TO Len( aPaths )
      cSrc := iif( ValType( aPaths[ i ] ) == "C", AllTrim( aPaths[ i ] ), "" )
      /* a directory can come with a trailing separator; a drive root keeps it */
      IF Len( cSrc ) > 3 .AND. Right( cSrc, 1 ) == "\"
         cSrc := Left( cSrc, Len( cSrc ) - 1 )
      ENDIF
      IF ! Empty( cSrc )
         cName := hb_FNameNameExt( cSrc )
         cDst  := HcJoinPath( cDest, cName )
         AAdd( aOut, { cSrc, cDst, iif( HcNormPath( cSrc ) == HcNormPath( cDst ), "SAME", ;
                          iif( HcPathInsideHc( cSrc, cDst ), "INSIDE", "" ) ) } )
      ENDIF
   NEXT
RETURN aOut

/* the two sentences of the feature, in one place (the bank asserts them) */
FUNCTION HcClipCopyMsg( n )
RETURN "Copied to the clipboard: " + LTrim( Str( n ) ) + iif( n == 1, " entry", " entries" )

/* L6: the WHOLE rule of the temporary notice of the status row, and it is PURE
 * so the headless bank pins it (S117): the row shows cMsg while the clock has
 * not reached the deadline (nNow < nUntil) and its own text again from the
 * deadline on. An empty (or non-character) message never shows, and a deadline
 * that was never armed (0, negative, NIL) shows nothing. cMsg comes back
 * UNTOUCHED: cutting it to the width of the row is the painter's job. */
FUNCTION HcFlashText( cMsg, nUntil, nNow )
   IF ValType( cMsg ) != "C" .OR. Empty( cMsg )
      RETURN ""
   ENDIF
   IF ValType( nUntil ) != "N" .OR. ValType( nNow ) != "N"
      RETURN ""
   ENDIF
   IF nUntil <= 0 .OR. nNow >= nUntil
      RETURN ""
   ENDIF
RETURN cMsg

/* L6: arm the notice of the status row for HC_FLASH_MS. It lives in ONE place,
 * so the three entry points of the copy (Ctrl+C, Ctrl+Ins and Ctrl+X, which
 * copies) cannot drift. The key loop paints it in the same pass and HcDrawStatus
 * paints it again only while it is alive (s_cHcFlashShown). */
STATIC PROCEDURE HcFlashSet( cMsg )
   s_cHcFlash := cMsg
   s_nHcFlashUntil := hb_MilliSeconds() + HC_FLASH_MS
RETURN

FUNCTION HcClipPasteMsg( nCopied, nSkipped )
   LOCAL c := "Pasted: " + LTrim( Str( nCopied ) ) + " copied"
   IF nSkipped > 0
      c += ", " + LTrim( Str( nSkipped ) ) + " skipped"
   ENDIF
RETURN c + "."

/* the clipboard itself is native: in the headless bank bp_win32.c is NOT
 * linked (BP_HC_STANDALONE), so the three calls go through these thin wrappers
 * instead of breaking the link. The bank still pins HcClipTargets() and the two
 * sentences, which is the part that can be wrong about paths. */
STATIC FUNCTION HcClipPut( aPaths )
#ifdef BP_HC_STANDALONE
   HB_SYMBOL_UNUSED( aPaths )
   RETURN .F.
#else
RETURN W32ClipFilesPut( aPaths )
#endif

STATIC FUNCTION HcClipCount()
#ifdef BP_HC_STANDALONE
RETURN 0
#else
RETURN W32ClipFilesCount()
#endif

STATIC FUNCTION HcClipAt( n )
#ifdef BP_HC_STANDALONE
   HB_SYMBOL_UNUSED( n )
   RETURN ""
#else
RETURN W32ClipFilesAt( n )
#endif

/* S2 of recycle-bin-delete.md: the Shift+Del step recorded by the window hook
 * of bp_win32.c (0 = none, 1 = a Shift+Del stroke). Taking it clears it. In
 * the headless bank there is no hook, so the answer is always 0 and the
 * fallback of the key loop never fires. */
STATIC FUNCTION HcHardDelDrain()
#ifdef BP_HC_STANDALONE
RETURN 0
#else
   /* the "!= 0" is NOT cosmetic: this Harbour raises "Argument error:
    * conditional" on IF <number>, and the native side returns a number
    * (trap 59) */
   IF W32HardDelStep() != 0
      RETURN 1
   ENDIF
RETURN 0
#endif

/* throw away a Shift+Del step the hook recorded, so the fallback of the key
 * loop (a Del code with SHIFT held) cannot act on the same stroke twice */
STATIC PROCEDURE HcHardDelReset()
#ifndef BP_HC_STANDALONE
   W32HardDelReset()
#endif
RETURN

/* S2: the LIVE SHIFT state, for the Shift+Del fallback of the key loop. The
 * headless bank has no hook and no window, so it answers .F. */
STATIC FUNCTION HcShiftLive()
#ifdef BP_HC_STANDALONE
RETURN .F.
#else
RETURN W32ShiftDown()
#endif

/* S7: the combos recorded by the window hook (Ctrl+C, Shift+Ins): 0 = none,
 * 1 = copy, 2 = paste. Taking one clears it. In the headless bank there is no
 * hook, so the answer is always 0. */
STATIC FUNCTION HcClipDrain()
#ifdef BP_HC_STANDALONE
RETURN 0
#else
   /* the "!= 0" is NOT cosmetic: this Harbour raises "Argument error:
    * conditional" on IF <number>, and the native side returns a number (it
    * killed hwBro on the first key of the panel) */
   IF W32ClipKeyStep() != 0
      RETURN W32ClipKey()
   ENDIF
RETURN 0
#endif

/* S2/S4 of editor-ctrl-chords.md: the word chords recorded by the window hook.
 * MEASURED: Ctrl+Left and Ctrl+Z are the SAME code in this driver (26), so the
 * hook is the only source that can tell them apart; it answers 1 for Ctrl+Left
 * and 2 for Ctrl+Right. Taking one clears it. NIL means "this build has no
 * hook" (the headless bank), and then the pure code form of HcWordKey() decides. */
STATIC FUNCTION HcWordDrain()
#ifdef BP_HC_STANDALONE
RETURN NIL
#else
   /* the "!= 0" is NOT cosmetic: this Harbour raises "Argument error:
    * conditional" on IF <number> (trap 59) */
   IF W32WordKeyStep() != 0
      RETURN W32WordKey()
   ENDIF
RETURN 0
#endif

/* S2: throw away a chord the hook recorded while the user was elsewhere, so it
 * cannot move the caret of this screen. Called when the screen opens. */
STATIC PROCEDURE HcWordFlush()
#ifndef BP_HC_STANDALONE
   W32WordKeyReset()
#endif
RETURN

/* S1/S2/S6: the marked entries (or the cursor entry) to the clipboard. The
 * panel is an OPTIONAL argument (the context menu passes the panel it was
 * opened on); every keyboard caller keeps using the active one. */
STATIC PROCEDURE HcClipCopy( aP )
   LOCAL aSel, aPaths := {}, i
   DEFAULT aP TO HcPanelActive()
   IF HcLinkPanel( aP )
      /* a remote entry has no local path to leave in the clipboard */
      UiErr( "Commander Link: the remote panel is read-only, that action is not available.", ;
             BP_APPNAME )
      RETURN
   ENDIF
   aSel := HcSourceSet( aP )
   IF Empty( aSel )
      UiMsg( "There is nothing to copy to the clipboard.", BP_APPNAME )
      RETURN
   ENDIF
   FOR i := 1 TO Len( aSel )
      AAdd( aPaths, HcJoinPath( aP[ HC_P_DIR ], aSel[ i ][ HC_E_NAME ] ) )
   NEXT
   IF ! HcClipPut( aPaths )
      UiErr( "The clipboard could not be filled.", BP_APPNAME )
   ELSE
      /* L6: the copy leaves a TEMPORARY notice in the status row (no box, no
       * key to press: the row goes back to its own text by itself). A FAILED
       * copy keeps its UiErr() and gets no notice, so the two never fight. */
      HcFlashSet( HcClipCopyMsg( Len( aPaths ) ) )
   ENDIF
RETURN

/* S3/S4/S6: the clipboard list copied into the panel directory (the active
 * one, or the panel the context menu was opened on) */
STATIC PROCEDURE HcClipPaste( aP )
   LOCAL aPaths := {}, aT, i, n, cSrc, cTo, cDest
   LOCAL aRes, aCnt, nCopied := 0, nSkipped := 0, nTotal := 0, cErr := ""
   LOCAL cLastName := ""
   LOCAL nOwState := 0, nChoice, cAction, aDec, lDo, lCancel := .F., cNew
   DEFAULT aP TO HcPanelActive()
   IF HcLinkPanel( aP )
      UiErr( "Commander Link: that action works on the local panels only.", BP_APPNAME )
      RETURN
   ENDIF
   n := HcClipCount()
   FOR i := 1 TO n
      AAdd( aPaths, HcClipAt( i ) )
   NEXT
   IF Empty( aPaths )
      UiMsg( "The clipboard does not have files.", BP_APPNAME )
      RETURN
   ENDIF
   /* a zip panel works on a real directory (S47), so its virtual path is
    * translated back to the working tree, exactly like F5 does */
   cDest := HcZipRealPath( aP[ HC_P_DIR ] )
   aT := HcClipTargets( aPaths, cDest )
   FOR i := 1 TO Len( aT )
      IF Empty( aT[ i ][ 3 ] ) .AND. ;
         ( hb_DirExists( aT[ i ][ 1 ] ) .OR. hb_vfExists( aT[ i ][ 1 ] ) )
         aCnt := HcCountTreeHc( aT[ i ][ 1 ] )
         nTotal += aCnt[ 2 ]
      ENDIF
   NEXT
   HcProgBegin( "Pasting", nTotal )
   FOR i := 1 TO Len( aT )
      cSrc := aT[ i ][ 1 ]
      cTo  := aT[ i ][ 2 ]
      IF ! Empty( aT[ i ][ 3 ] )
         /* the destination is the source itself or a directory inside it */
         nSkipped++
         LOOP
      ENDIF
      IF ! hb_DirExists( cSrc ) .AND. ! hb_vfExists( cSrc )
         /* copied, and deleted before the paste */
         nSkipped++
         LOOP
      ENDIF
      lDo := .T.
      DO WHILE hb_DirExists( cTo ) .OR. hb_vfExists( cTo )
         nChoice := iif( nOwState == 0, HcOwAsk( hb_FNameNameExt( cTo ), cSrc, cTo ), 0 )
         aDec := HcOwResolve( nOwState, nChoice, HcOwOlder( cSrc, cTo ) )
         nOwState := aDec[ 2 ]
         cAction  := aDec[ 1 ]
         IF cAction == "CANCEL"
            lCancel := .T.
         ELSEIF cAction == "SKIP"
            lDo := .F.
         ELSEIF cAction == "RENAME"
            cNew := UiInput( "New destination name:", hb_FNameNameExt( cTo ), 60 )
            IF hb_IsNIL( cNew ) .OR. Empty( AllTrim( cNew ) )
               lDo := .F.
            ELSE
               cTo := HcOwRename( cDest, AllTrim( cNew ) )
               /* and if THAT name exists too, the question comes again */
               LOOP
            ENDIF
         ENDIF
         EXIT
      ENDDO
      IF lCancel
         EXIT
      ENDIF
      IF ! lDo
         nSkipped++
         LOOP
      ENDIF
      aRes := HcCopyAnyHc( cSrc, cTo )
      IF aRes[ 5 ]
         lCancel := .T.
         EXIT
      ENDIF
      IF ! aRes[ 1 ]
         IF Empty( cErr )
            cErr := aRes[ 2 ]
         ENDIF
         nSkipped++
      ELSE
         nCopied++
         /* the entry the user just pasted is the one the cursor should land
          * on when the panel is reloaded below */
         cLastName := hb_FNameNameExt( cTo )
      ENDIF
   NEXT
   HcProgEnd()
   /* S49: an open archive is rewritten before the panels are reloaded */
   HcZipSync()
   HcReloadPanels( cDest, cLastName )
   IF ! Empty( cErr )
      UiErr( cErr, BP_APPNAME )
   ELSEIF nCopied == 0
      /* nothing landed on disk, so the silence of a successful copy would
       * read as "it did nothing": say it, with the count of what was skipped */
      UiMsg( HcClipPasteMsg( 0, nSkipped ), BP_APPNAME )
   ENDIF
   /* L22/L23: a successful operation reports nothing; the reloaded panel
    * already shows the files the user pasted */
RETURN

STATIC FUNCTION HcOwDialog( cName, cSrc, cTo, aInfo )
   LOCAL aG := HcOwGrid()
   LOCAL nValW, nI, nW, nH, nT, nL, nR, nKey, nHot
   LOCAL nSel := 1, lLeave := .F., cSave, cOldCur
   /* interior width: the button grid, or the widest of the labelled lines */
   nValW := Max( Len( cName ), Max( Len( cSrc ), Len( cTo ) ) )
   nValW := Max( nValW, Max( Len( HcOwStampText( cSrc ) ), Len( HcOwStampText( cTo ) ) ) )
   nValW := Min( nValW, Max( 12, UiCols() - 28 ) )
   nI := Max( aG[ 3 ] + 2, 18 + nValW )
   nI := Min( nI, UiCols() - 8 )
   nW := nI + 2
   nH := 15                                     /* rows nT .. nT + 14          */
   nT := UiFitRow( UiCenterRow( nH ), nH + 1 )
   nL := UiFitCol( UiCenterCol( nW ), nW + 2 )
   nR := nL + nI + 1
   /* the system cursor stays hidden while the box waits for a key: it is hidden
    * BEFORE the first UiPaintBegin(), so the paint block saves/restores the
    * already hidden state (the trap of UiConfirm()/UiMsg()) */
   cOldCur := SetCursor( 0 )
   cSave := SaveScreen( nT, nL, nT + nH, Min( nR + 2, MaxCol() ) )
   UiPaintBegin()
   HcOwPaint( nT, nL, nI, nSel, cName, cSrc, cTo, aInfo )
   UiPaintEnd()
   DO WHILE ! lLeave
      /* right-click-esc (S1/S7): the box waits in 50 ms slices instead of a
       * blocking Inkey( 0 ) so a plain right click, which cancels like Esc, is
       * seen at all; a slice with no key does not repaint, so the box stays
       * exactly as it was painted. */
      DO WHILE .T.
         nKey := Inkey( 0.05 )
         IF nKey != 0
            EXIT
         ENDIF
         IF HcMouseRightClick()
            nKey := K_ESC
            EXIT
         ENDIF
      ENDDO
      DO CASE
      CASE nKey == K_ESC
         /* Esc = Cancel */
         nSel := 4
         lLeave := .T.
      CASE nKey == K_ENTER .OR. nKey == K_SPACE
         lLeave := .T.
      CASE nKey == K_LEFT .OR. nKey == K_RIGHT .OR. nKey == K_UP .OR. ;
           nKey == K_DOWN .OR. nKey == K_TAB .OR. nKey == K_SH_TAB
         nHot := HcOwMove( nSel, nKey )
         IF nHot != nSel
            nSel := nHot
            /* only the buttons are repainted (never the whole box) */
            UiPaintBegin()
            HcOwBtns( nT, nL, nI, nSel )
            UiPaintEnd()
         ENDIF
      OTHERWISE
         nHot := HcOwHot( nKey )
         IF nHot > 0
            nSel := nHot
            lLeave := .T.
         ENDIF
      ENDCASE
   ENDDO
   RestScreen( nT, nL, nT + nH, Min( nR + 2, MaxCol() ), cSave )
   SetCursor( cOldCur )
RETURN nSel

/* The choice of ONE conflict: 1..7 as HcOwDecide() reads them. The hook of the
 * headless bank replaces the dialog; with no hook and no window the answer is
 * always "Skip" (3), the only one that touches nothing. <aInfo> carries the
 * four texts of HcOwPaint() when one side of the conflict is not on this disk
 * (a copy across the Commander Link). */
STATIC FUNCTION HcOwAsk( cName, cSrc, cTo, aInfo )
   LOCAL x
   IF ! hb_IsNIL( s_bHcOverwrite )
      x := Eval( s_bHcOverwrite, cName, cSrc, cTo )
      IF ValType( x ) == "N" .AND. x >= 1 .AND. x <= 7
         RETURN Int( x )
      ENDIF
      /* a hook that answers something unexpected is never a decision to
       * overwrite (same rule as HcConfirm(), which answers "No") */
      RETURN 3
   ENDIF
#ifdef BP_HC_STANDALONE
   /* Headless without a hook: there is no window where to draw the dialog and
    * a run with nobody in front of it must NEVER overwrite a file, so the
    * answer is "Skip". Nothing can be clicked and nothing is replaced. */
   RETURN 3
#else
RETURN HcOwDialog( cName, cSrc, cTo, aInfo )
#endif

/* destination of a Rename: a bare name lands in the directory of this copy
 * operation, a name with a path is used as typed */
STATIC FUNCTION HcOwRename( cDst, cNew )
   IF At( "\", cNew ) == 0 .AND. At( "/", cNew ) == 0 .AND. At( ":", cNew ) == 0
      RETURN HcJoinPath( cDst, cNew )
   ENDIF
RETURN cNew

/* F5: where one copy lands. The dialog PROPOSES the destination panel plus the
 * SAME file name, so pressing Enter copies the file there; erasing the path
 * down to a bare name copies the file inside the ORIGIN directory under the new
 * name (the same rule as HcMoveTarget() for F6). A directory (existing, or
 * written with a trailing separator) receives the file keeping its name and
 * anything else is the full destination path as typed. The `..` components are
 * NOT resolved here: the guard of the copy compares with HcNormPath().
 * lSingle = .T. only when ONE FILE is being copied, and then the answer is the
 * FULL destination path (the name is part of it). With several entries, or with
 * a whole directory, there is no single name, so the answer is the destination
 * DIRECTORY and the caller keeps joining the entry name.
 * PURE on purpose: the dialog and the headless bank share one implementation. */
FUNCTION HcCopyTarget( cInput, cOriginDir, cName, lSingle )
   IF ValType( cInput ) != "C"
      RETURN ""
   ENDIF
   IF ! lSingle
      /* the whole set (or a directory) is copied INSIDE the typed directory */
      IF hb_DirExists( cInput ) .OR. Right( cInput, 1 ) == "\" .OR. Right( cInput, 1 ) == "/"
         RETURN HcDirArg( cInput )
      ENDIF
      RETURN cInput
   ENDIF
   IF At( "\", cInput ) == 0 .AND. At( "/", cInput ) == 0 .AND. At( ":", cInput ) == 0
      /* a bare name is a NEW name inside the origin directory */
      RETURN HcJoinPath( cOriginDir, cInput )
   ENDIF
   IF hb_DirExists( cInput ) .OR. Right( cInput, 1 ) == "\" .OR. Right( cInput, 1 ) == "/"
      /* a directory receives the file keeping its name */
      RETURN HcJoinPath( HcDirArg( cInput ), cName )
   ENDIF
RETURN cInput

/* F5: copy the marked set (or the entry under the cursor) to a directory */
STATIC PROCEDURE HcCopy()
   LOCAL aP := HcPanelActive(), aSel := HcSourceSet( aP )
   LOCAL cDst, cSrc, cTo, cErr := "", cFocusDir := "", cFocusName := ""
   LOCAL i, aE, aRes, aCnt, nTotal := 0
   LOCAL lCancel := .F.
   /* S17: the sticky answers of THIS operation (0 = ask, 1 = replace the rest,
    * 2 = skip the rest). A local on purpose: nothing survives the copy. */
   LOCAL nOwState := 0, nChoice, cAction, cNew, lDo, aDec
   LOCAL cDstProp, nDstW, cDstIn, cName, lSingle
   /* S6 of commander-link.md: with a panel linked the copy crosses the link,
    * and WHICH WAY is decided there: the linked ACTIVE panel downloads,
    * the linked OTHER panel uploads. The command key, the `Copy to:` prompt,
    * the overwrite dialog and its sticky answers are the same code. */
   IF HcLinkTouch( .T. )
      HcLinkCopy()
      RETURN
   ENDIF
   IF Empty( aSel )
      UiMsg( "Select the file(s) or directory(ies) to copy.", "Copy" )
      RETURN
   ENDIF
   /* ONE FILE has a destination NAME, so the proposal is the destination panel
    * plus that same name: accepting it copies the file there, and erasing the
    * path down to a bare name copies it in the ORIGIN directory under the new
    * name (HcCopyTarget() decides, like the F6 proposal). With several entries,
    * or with a directory, there is no single name: the proposal is the
    * destination DIRECTORY, as it always was. The field is as wide as the
    * canvas allows (60 used to CUT any deeper path in silence and the copy then
    * failed with "does not exist"); see below for the paths longer than it. */
   lSingle := Len( aSel ) == 1 .AND. ! HcIsDir( aSel[ 1 ] )
   cName := iif( Len( aSel ) == 1, aSel[ 1 ][ HC_E_NAME ], "" )
   cDstProp := iif( lSingle, ;
                    HcJoinPath( HcPanel( HcOtherPanel() )[ HC_P_DIR ], cName ), ;
                    HcPanel( HcOtherPanel() )[ HC_P_DIR ] )
   cDstProp := HcZipShowPath( cDstProp )
   nDstW := Min( 96, UiCols() - 16 )
   cDst := UiInput( "Copy to:", cDstProp, nDstW )
   IF hb_IsNIL( cDst )
      RETURN
   ENDIF
   cDst := AllTrim( cDst )
   /* A field can only SHOW nDstW cells, so a longer proposal comes back cut. If
    * the answer is exactly that cut, the user pressed Enter without editing and
    * the FULL proposal is used: accepting the proposal works for any path
    * depth. */
   IF Len( cDst ) == nDstW .AND. Len( cDstProp ) > nDstW .AND. ;
      Left( cDstProp, nDstW ) == cDst
      cDst := cDstProp
   ENDIF
   IF Empty( cDst )
      UiErr( "The destination cannot be empty.", "Copy" )
      RETURN
   ENDIF
   /* S48: an answer written the way the title shows it (the archive plus the
    * relative part) is translated back to the working tree */
   cDstIn := HcZipRealPath( cDst )
   cDst := HcCopyTarget( cDstIn, aP[ HC_P_DIR ], cName, lSingle )
   IF lSingle
      /* the answer is the whole destination FILE, so the directory that has to
       * exist is the one holding it */
      IF ! hb_DirExists( HcParentDir( cDst ) )
         UiErr( "The destination directory does not exist:" + hb_eol() + ;
                HcParentDir( cDst ), "Copy" )
         RETURN
      ENDIF
   ELSEIF ! hb_DirExists( cDst )
      UiErr( "The destination directory does not exist:" + hb_eol() + cDst, "Copy" )
      RETURN
   ENDIF
   FOR i := 1 TO Len( aSel )
      aCnt := HcCountTreeHc( HcJoinPath( aP[ HC_P_DIR ], aSel[ i ][ HC_E_NAME ] ) )
      nTotal += aCnt[ 2 ]
   NEXT
   HcProgBegin( "Copying", nTotal )
   FOR i := 1 TO Len( aSel )
      aE := aSel[ i ]
      cSrc := HcJoinPath( aP[ HC_P_DIR ], aE[ HC_E_NAME ] )
      /* a single file goes to the resolved FULL path (the name is part of it)
       * and the set goes INSIDE the resolved directory keeping its name */
      cTo  := iif( lSingle, cDst, HcJoinPath( cDst, aE[ HC_E_NAME ] ) )
      IF ! HcIsDir( aE ) .AND. HcNormPath( cSrc ) == HcNormPath( cTo )
         /* asked BEFORE the overwrite question: the destination is the source
          * itself (both panels in the same directory) */
         cErr := "Cannot copy a file onto itself:" + hb_eol() + cSrc
      ELSEIF HcIsDir( aE ) .AND. HcPathInsideHc( cSrc, cTo )
         cErr := "Cannot copy a directory into itself:" + hb_eol() + cTo
      ELSE
         /* S17: an existing destination is decided by the 7 button dialog. Only
          * the entries IN CONFLICT are asked about (one that is not there is
          * simply copied, whatever the sticky answer is), and Rename changes the
          * destination and asks again when that name exists too. */
         lDo := .T.
         DO WHILE hb_DirExists( cTo ) .OR. hb_vfExists( cTo )
            IF nOwState == 0
               nChoice := HcOwAsk( aE[ HC_E_NAME ], cSrc, cTo )
            ELSE
               /* Replace All / Skip All: no question for the rest */
               nChoice := 0
            ENDIF
            aDec := HcOwResolve( nOwState, nChoice, HcOwOlder( cSrc, cTo ) )
            nOwState := aDec[ 2 ]
            cAction := aDec[ 1 ]
            IF cAction == "CANCEL"
               /* the whole operation stops: what is already copied stays */
               lCancel := .T.
            ELSEIF cAction == "SKIP"
               lDo := .F.
            ELSEIF cAction == "RENAME"
               cNew := UiInput( "New destination name:", aE[ HC_E_NAME ], 60 )
               IF hb_IsNIL( cNew ) .OR. Empty( AllTrim( cNew ) )
                  /* Esc or an empty name: nothing is copied for this entry */
                  lDo := .F.
               ELSE
                  cTo := HcOwRename( cDst, AllTrim( cNew ) )
                  /* and if THAT name exists too, the question comes again */
                  LOOP
               ENDIF
            ENDIF
            EXIT
         ENDDO
         IF lCancel
            EXIT
         ENDIF
         IF ! lDo
            /* skipped: the rest of the set continues */
            LOOP
         ENDIF
         aRes := HcCopyAnyHc( cSrc, cTo )
         IF aRes[ 5 ]
            lCancel := .T.
            EXIT
         ENDIF
         IF ! aRes[ 1 ]
            cErr := aRes[ 2 ]
         ELSE
            cFocusDir := cDst
            cFocusName := aE[ HC_E_NAME ]
            IF lSingle
               /* the resolved destination is the FILE, not a directory */
               cFocusDir := HcParentDir( cDst )
               cFocusName := HcDirName( cDst )
            ENDIF
         ENDIF
      ENDIF
   NEXT
   HcProgEnd()
   /* S49: the archive is rewritten HERE, before the panels are reloaded, when
    * the copy changed the working tree of an open archive */
   HcZipSync()
   HcReloadPanels( cFocusDir, cFocusName )
   IF ! Empty( cErr )
      UiErr( cErr, "Copy" )
   ENDIF
   /* L22/L23: an operation that ENDS reports nothing: the panels are reloaded
    * and the destination already shows the files, so a "Copied N file(s)..."
    * box (and the "copy cancelled" one) only costed an extra Enter. Failures
    * still speak through UiErr(). */
RETURN

/* F6: where a rename or move lands. A bare name renames inside the directory
 * of this panel; a directory (existing, or written with a trailing separator)
 * receives the entry keeping its name; anything else is the new FULL name.
 * PURE on purpose: the dialog and the headless bank share one implementation. */
FUNCTION HcMoveTarget( cInput, cPanelDir, cName )
   IF ValType( cInput ) != "C"
      RETURN ""
   ENDIF
   IF At( "\", cInput ) == 0 .AND. At( "/", cInput ) == 0 .AND. At( ":", cInput ) == 0
      RETURN HcJoinPath( cPanelDir, cInput )
   ENDIF
   IF hb_DirExists( cInput ) .OR. Right( cInput, 1 ) == "\" .OR. Right( cInput, 1 ) == "/"
      RETURN HcJoinPath( HcDirArg( cInput ), cName )
   ENDIF
RETURN cInput

/* F6: rename inside the panel directory, or move to the typed path */
STATIC PROCEDURE HcMove()
   LOCAL aP := HcPanelActive(), aSel := HcSourceSet( aP )
   LOCAL aE, cName, cSrc, cDst, cInput, aRes, aCnt
   LOCAL cProp, nW
   /* S6: on a linked panel the rename/move is a RENAME of the peer's tree */
   IF HcLinkPanel( HcPanelActive() )
      HcLinkMove()
      RETURN
   ENDIF
   IF HcLinkTouch()
      /* the proposal of the destination would be a REMOTE path and a local
       * entry cannot be moved over the link (F5 copies it, F8 deletes the
       * source) */
      UiMsg( "Commander Link: Rename/Move only acts inside the remote tree of a" + ;
             hb_eol() + "linked panel. Copy the entry across with F5 instead.", BP_APPNAME )
      RETURN
   ENDIF
   IF Len( aSel ) != 1
      UiMsg( "Select ONE entry to rename or move.", "Rename/Move" )
      RETURN
   ENDIF
   aE := aSel[ 1 ]
   cName := aE[ HC_E_NAME ]
   cSrc := HcJoinPath( aP[ HC_P_DIR ], cName )
   /* the DESTINATION panel is the proposal: pressing Enter moves the entry
    * there, and erasing the path down to a bare name renames it in place. The
    * field is as wide as the canvas allows, so a deep path is not cut in
    * silence (60 used to do it); see below for what does not fit. */
   cProp := HcZipShowPath( HcJoinPath( HcPanel( HcOtherPanel() )[ HC_P_DIR ], cName ) )
   nW := Min( 96, UiCols() - 16 )
   cInput := UiInput( "Rename or move to:", cProp, nW )
   IF hb_IsNIL( cInput )
      RETURN
   ENDIF
   cInput := AllTrim( cInput )
   /* A field can only SHOW nW cells, so a longer proposal comes back cut. If
    * the answer is exactly that cut, the user pressed Enter without editing
    * and the FULL proposal is used (same rule as the `Copy to:` of F5). */
   IF Len( cInput ) == nW .AND. Len( cProp ) > nW .AND. Left( cProp, nW ) == cInput
      cInput := cProp
   ENDIF
   cInput := HcZipRealPath( cInput )
   IF Empty( cInput )
      UiErr( "The name cannot be empty.", "Rename/Move" )
      RETURN
   ENDIF
   /* a bare name renames in place, a directory means "move into it" and
    * anything else is the new full name (HcMoveTarget() decides, so the bank
    * covers exactly what the dialog does) */
   cDst := HcMoveTarget( cInput, aP[ HC_P_DIR ], cName )
   IF HcNormPath( cDst ) == HcNormPath( cSrc )
      UiMsg( "The name is the same.", "Rename/Move" )
      RETURN
   ENDIF
   IF HcPathInsideHc( cSrc, cDst )
      UiErr( "Cannot move a directory into itself or into one of its descendants:" + ;
             hb_eol() + cDst, "Rename/Move" )
      RETURN
   ENDIF
   IF ( hb_vfExists( cDst ) .OR. hb_DirExists( cDst ) ) .AND. ;
      ! HcConfirm( "Overwrite " + cDst + "?", "Rename/Move" )
      RETURN
   ENDIF
   aCnt := HcCountTreeHc( cSrc )
   HcProgBegin( "Moving", aCnt[ 2 ] )
   aRes := HcMoveHc( cSrc, cDst )
   HcProgEnd()
   /* S49: a move that changed the working tree of an open archive is written
    * back now, whatever the outcome (a partial move changed it too) */
   HcZipSync()
   IF aRes[ 3 ]
      HcReloadPanels( "", "" )
   ELSEIF ! aRes[ 1 ]
      HcReloadPanels( "", "" )
      UiErr( aRes[ 2 ], "Rename/Move" )
   ELSE
      /* L22: no result box for a successful move either: the cursor is left on
       * the moved entry and the panel shows it where it is now */
      HcReloadPanels( HcParentDir( cDst ), HcDirName( cDst ) )
   ENDIF
RETURN

/* =====================================================================
 *  S4: Shift-F4, a NEW file
 *
 *  The key asks for a name, creates an EMPTY file in the directory of the
 *  active panel and opens it in the editor. The name is answered by a PURE
 *  helper (the only question it cannot answer alone is "does it already
 *  exist?", which is the disk), so the headless bank can pin every refusal
 *  without a window, and a name that is not good creates NOTHING.
 * ===================================================================== */

/* S4: the full path of the new file, or "" when the name must not be created.
 * A name that is empty, that carries a separator or any character Windows
 * refuses (the same HcNameOk() rule F7 uses), that is "."/".." or that already
 * exists is refused; the answer is always INSIDE the directory of the panel. */
FUNCTION HcNewPath( aP, cName )
   LOCAL cName2, cDir, cFull
   IF ! HB_ISARRAY( aP ) .OR. ValType( cName ) != "C"
      RETURN ""
   ENDIF
   cName2 := AllTrim( cName )
   IF Len( cName2 ) == 0
      RETURN ""
   ENDIF
   IF ! HcNameOk( cName2 ) .OR. cName2 == "." .OR. cName2 == ".."
      RETURN ""
   ENDIF
   cDir  := HcDirNoSep( aP[ HC_P_DIR ] )
   cFull := HcJoinPath( cDir, cName2 )
   IF hb_vfExists( cFull ) .OR. hb_DirExists( cFull )
      RETURN ""
   ENDIF
   /* the answer has to live inside the panel directory: a name that climbs
    * out of it is refused here, not normalised behind the user's back */
   IF ! HcPathInsideHc( cDir, cFull ) .OR. HcNormPath( cFull ) == HcNormPath( cDir )
      RETURN ""
   ENDIF
RETURN cFull

/* S4: WHY the name was refused, in English, one sentence: the caller shows
 * exactly one box. "" when HcNewPath() accepts the name (it is derived from
 * the same checks in the same order, so the two can never disagree). */
FUNCTION HcNewFileErr( aP, cName )
   LOCAL cName2, cFull
   IF ! Empty( HcNewPath( aP, cName ) )
      RETURN ""
   ENDIF
   cName2 := iif( ValType( cName ) == "C", AllTrim( cName ), "" )
   IF Len( cName2 ) == 0
      RETURN "The name cannot be empty."
   ENDIF
   IF ! HcNameOk( cName2 ) .OR. cName2 == "." .OR. cName2 == ".."
      RETURN "A file name cannot contain any of these characters:" + hb_eol() + ;
             "    \  /  :  *  ?  " + Chr( 34 ) + "  <  >  |"
   ENDIF
   IF HB_ISARRAY( aP )
      cFull := HcJoinPath( HcDirNoSep( aP[ HC_P_DIR ] ), cName2 )
      IF hb_vfExists( cFull ) .OR. hb_DirExists( cFull )
         RETURN "That name already exists:" + hb_eol() + cName2
      ENDIF
   ENDIF
RETURN "The file cannot be created in this directory:" + hb_eol() + cName2

/* S4: an EMPTY file, or .F. when it could not be created */
STATIC FUNCTION HcCreateEmpty( cFile )
   LOCAL nOut := FCreate( cFile )
   IF nOut < 0
      RETURN .F.
   ENDIF
   FClose( nOut )
RETURN hb_vfExists( cFile )

/* S4: Shift-F4. It is not offered on a linked panel (a remote entry has no
 * local path to create) and it refuses it the same way the other actions that
 * only exist for local panels do. */
STATIC PROCEDURE HcNewFile()
   LOCAL aP := HcPanelActive(), cName, cFull, cErr
   IF HcLinkPanel( aP )
      UiErr( "Commander Link: the remote panel is read-only, that action is not available.", ;
             BP_APPNAME )
      RETURN
   ENDIF
   /* the file is created in the DIRECTORY of the active panel (the same place
    * F7 makes its directory in), whatever the command line says */
   cName := UiInput( "New file name:", "", 60 )
   IF hb_IsNIL( cName )
      RETURN
   ENDIF
   cFull := HcNewPath( aP, cName )
   IF Empty( cFull )
      cErr := HcNewFileErr( aP, cName )
      IF ! Empty( cErr )
         UiErr( cErr, "New file" )
      ENDIF
      RETURN
   ENDIF
   IF ! HcCreateEmpty( cFull )
      UiErr( "The file could not be created:" + hb_eol() + cFull, "New file" )
      RETURN
   ENDIF
   /* S49: the empty file is in the working tree of an open archive now, so the
    * archive is rewritten before the editor opens the file */
   HcZipSync()
   HcLoad( aP )
   HcDrawScreen()
   HcEdit( cFull )
   HcLoad( aP )
   HcDrawScreen()
RETURN

/* F7: create a directory inside the active panel */
STATIC PROCEDURE HcMakeDir()
   LOCAL aP := HcPanelActive(), cName, cDir, aRes
   /* S6: on a linked panel the directory is created on the peer */
   IF HcLinkPanel( aP )
      HcLinkMakeDir()
      RETURN
   ENDIF
   cName := UiInput( "Make directory:", "", 60 )
   IF hb_IsNIL( cName )
      RETURN
   ENDIF
   cName := AllTrim( cName )
   IF Empty( cName )
      UiErr( "The name cannot be empty.", "Make directory" )
      RETURN
   ENDIF
   IF ! HcNameOk( cName )
      UiErr( "A directory name cannot contain any of these characters:" + hb_eol() + ;
             "    \  /  :  *  ?  " + Chr( 34 ) + "  <  >  |", "Make directory" )
      RETURN
   ENDIF
   cDir := HcJoinPath( aP[ HC_P_DIR ], cName )
   aRes := HcMakeDirHc( cDir )
   IF ! aRes[ 1 ]
      UiErr( aRes[ 2 ], "Make directory" )
   ELSE
      /* L23: no result box either (the new directory is in the listing) */
      HcZipSync()
      HcReloadPanels( aP[ HC_P_DIR ], cName )
   ENDIF
RETURN

/* F8: delete the marked set (or the entry under the cursor); the
 * confirmation names the count, the target and WHERE the entries go, and a No
 * changes nothing. S1/S2 of recycle-bin-delete.md: with lHard (.F. by default)
 * it is the Shift+Del delete, with no Recycle Bin; without it the entries go
 * to the bin. The text and the mode both come from HcDeleteAsk(). */
STATIC PROCEDURE HcDelete( lHard )
   LOCAL aP := HcPanelActive(), aSel := HcSourceSet( aP )
   LOCAL aPaths := {}, i, cText, aRes, nFiles := 0, nDirs := 0, cOnlyDir := ""
   DEFAULT lHard TO .F.
   /* S6: on a linked panel the entries are deleted on the peer, with ONE
    * confirmation that names it */
   IF HcLinkPanel( aP )
      HcLinkDelete()
      RETURN
   ENDIF
   IF Empty( aSel )
      UiMsg( "Select the file(s) or directory(ies) to delete.", "Delete" )
      RETURN
   ENDIF
   FOR i := 1 TO Len( aSel )
      IF HcIsDir( aSel[ i ] )
         nDirs++
      ELSE
         nFiles++
      ENDIF
      AAdd( aPaths, HcJoinPath( aP[ HC_P_DIR ], aSel[ i ][ HC_E_NAME ] ) )
   NEXT
   IF Len( aSel ) == 1 .AND. nDirs == 1
      cOnlyDir := aSel[ 1 ][ HC_E_NAME ]
   ENDIF
   cText := HcDeleteAsk( Len( aSel ), nFiles, nDirs, cOnlyDir, lHard )
   /* the confirmation (and the whole loop) lives in HcDeleteSetHc(), so the
    * headless bank exercises exactly this path */
   aRes := HcDeleteSetHc( aPaths, cText, lHard )
   IF aRes[ 4 ]
      /* the user said no: nothing was touched and nothing is repainted */
      RETURN
   ENDIF
   /* S49: a delete inside an open archive rewrites it now */
   HcZipSync()
   HcReloadPanels( "", "" )
   IF ! aRes[ 1 ]
      UiErr( aRes[ 2 ], "Delete" )
   ENDIF
   /* L23: no "Deleted N item(s)." box: the entries are gone from the listing */
RETURN

/* =====================================================================
 *  S18/S19/S23: the "Synchronize directories" screen
 *
 *  The screen compares the CURRENT directory of the left panel with the
 *  current directory of the right one (S20: no recursion) and offers the
 *  copies of S22, asking the seven button dialog of S17 (HcOwAsk) for every
 *  destination that already exists.
 *
 *  The comparison is decided in ONE place, the pure core of S24, which is
 *  public so the headless bank can pin it without a window:
 *
 *    HcSyncScan( cLeftDir, cRightDir, cMask, lByContent, lIgnoreDate )
 *       -> one row per name matched by cMask present on either side
 *    HcSyncDir( aRow, lAsymmetric )                  -> "=>" | "<=" | ""
 *    HcSyncLine( aRow, nNameW )                      -> one table line
 *    HcSyncView( aRows, lDup, lSing, lL2R, lR2L )    -> the rows on screen
 *    HcSyncPlan( aRows, lMarked, lAsymmetric, lDeleteExtras )
 *       -> { aCopy, aDel } with FULL paths ({ cSrc, cDst } pairs and paths)
 *
 *  A row is an array. S24 documents the first eight elements; the rest is the
 *  bookkeeping the plan and the screen need:
 *
 *     1 cName        2 lLeft         3 lRight       4 nLeftSize
 *     5 nRightSize   6 cLeftStamp   7 cRightStamp  8 lSameContent
 *     9 lLeftDir    10 lRightDir   11 lMark       12 cLeftPath
 *    13 cRightPath  14 cAction
 *
 *  cAction is decided by HcSyncScan() (it is where lByContent and lIgnoreDate
 *  live) and HcSyncDir() only adds the Asymmetric rule on top of it. The two
 *  path fields are the path that name HAS in each directory (for a name that
 *  exists on one side only, the other field is where the copy would go) and
 *  both are empty for a directory row, because a directory is listed as DIR
 *  but is NEVER copied nor deleted (S20).
 *
 *  The criterion is the one the user chose (L10.4): size + date + CONTENT.
 *  When the size matches and the date does not, both files are READ in 64 KB
 *  blocks and, if the bytes are the same, the row is not a difference at all.
 *  A read error is "different", never "equal".
 * ===================================================================== */

/* fields of a scan row (see the header above) */
#define SY_NAME      1
#define SY_LEFT      2
#define SY_RIGHT     3
#define SY_LSIZE     4
#define SY_RSIZE     5
#define SY_LSTAMP    6
#define SY_RSTAMP    7
#define SY_SAME      8
#define SY_LDIR      9
#define SY_RDIR      10
#define SY_MARK      11
#define SY_LPATH     12
#define SY_RPATH     13
#define SY_ACT       14

/* rows of the screen (S19). Every one of them is derived from UiRows(), so a
 * different canvas keeps the layout instead of clipping it. */
#define SY_TITLE     0
#define SY_ROWL      1
#define SY_ROWR      2
#define SY_ROWMASK   3
#define SY_OPT1      4
#define SY_OPT2      5
#define SY_SHOW      6
#define SY_HDR       8
#define SY_RUL1      9
#define SY_FIRST     10
#define SY_LAST      ( UiRows() - 6 )
#define SY_RUL2      ( UiRows() - 5 )
#define SY_SUMROW    ( UiRows() - 4 )
#define SY_MSGROW    ( UiRows() - 3 )
#define SY_KEYS      ( UiRows() - 2 )
#define SY_KEYS2     ( UiRows() - 1 )
#define SY_VIS       ( SY_LAST - SY_FIRST + 1 )

/* columns of the table: the two halves are mirrored around the direction */
#define SY_MARG      2
#define SY_SIZE_W    10
#define SY_DATE_W    8   /* DD/MM/YY (L24) */
#define SY_TIME_W    5   /* HH:MM, 24 hours (L24) */
#define SY_DIR_W     6
#define SY_LAB_W     9
#define SY_COLS      3

/* state of the screen (the array the painters and the keys share) */
#define SC_L          1    /* directory of the left panel  */
#define SC_R          2    /* directory of the right panel */
#define SC_MASK       3
#define SC_ONLYSEL    4
#define SC_ASYM       5
#define SC_SUBDIRS    6
#define SC_BYCONT     7
#define SC_IGNOREDATE 8
#define SC_DELEXTRA   9
#define SC_SHDUP      10   /* Show: duplicates                  */
#define SC_SHSING     11   /* Show: singles                     */
#define SC_SHL2R      12   /* Show: left -> right               */
#define SC_SHR2L      13   /* Show: right -> left               */
#define SC_ROWS       14   /* every row of the comparison       */
#define SC_VIEW       15   /* the rows the table shows          */
#define SC_SEL        16   /* cursor, index inside SC_VIEW      */
#define SC_TOP        17   /* first visible row of SC_VIEW      */
#define SC_MSG        18   /* row SY_MSGROW                     */
#define SC_NCOPY      19   /* the summary of row SY_SUMROW      */
#define SC_NDEL       20

/* ------------------------------------------------------------------ S18 ---- */

/* Entry point of the screen; the `Directories` menu calls it. */
FUNCTION BpSyncDirs()
   /* S3 of commander-link.md: the synchronizer compares and COPIES the files of
    * the two panels, so it is one of the operations a linked panel refuses */
   IF HcLinkGuard( .T., .T. )
      RETURN NIL
   ENDIF
   HcSyncScreen()
RETURN NIL

/* ------------------------------------------------------------------ S24 ---- */

/* The listing of one directory as { cName, nSize, cStamp, lDir }. The stamp is
 * the 14 sortable characters of HcFileStampKey() ("YYYYMMDDHHMMSS") and the
 * hidden entries "." and ".." are not listed. A directory that cannot be read
 * is simply empty, so the caller sees every name of the other side as a copy
 * instead of an error. */
STATIC FUNCTION HcSyncList( cDir )
   LOCAL aOut := {}, aRaw, i, aE, cAttr, lDir, cFull
   IF Empty( cDir ) .OR. ! hb_DirExists( cDir )
      RETURN aOut
   ENDIF
   aRaw := hb_vfDirectory( HcDirArg( cDir ), "HSD" )
   IF ! HB_ISARRAY( aRaw )
      aRaw := {}
   ENDIF
   FOR i := 1 TO Len( aRaw )
      aE := aRaw[ i ]
      IF ( aE[ 1 ] == "." ) .OR. ( aE[ 1 ] == ".." )
         LOOP
      ENDIF
      cAttr := "A"
      IF Len( aE ) >= 5 .AND. ValType( aE[ 5 ] ) == "C"
         cAttr := aE[ 5 ]
      ENDIF
      lDir := "D" $ Upper( cAttr )
      cFull := HcJoinPath( cDir, aE[ 1 ] )
      IF lDir
         AAdd( aOut, { aE[ 1 ], 0, "", .T. } )
      ELSE
         AAdd( aOut, { aE[ 1 ], aE[ 2 ], HcFileStampKey( cFull ), .F. } )
      ENDIF
   NEXT
RETURN aOut

/* .T. when cName is one of the names of the array (case-insensitive) */
STATIC FUNCTION HcSyncNameIn( aNames, cName )
   LOCAL i, c := Upper( cName )
   FOR i := 1 TO Len( aNames )
      IF Upper( aNames[ i ] ) == c
         RETURN .T.
      ENDIF
   NEXT
RETURN .F.

/* the element of a listing whose name is cName, NIL when it is not there */
STATIC FUNCTION HcSyncFind( aList, cName )
   LOCAL i, c := Upper( cName )
   FOR i := 1 TO Len( aList )
      IF Upper( aList[ i ][ 1 ] ) == c
         RETURN aList[ i ]
      ENDIF
   NEXT
RETURN NIL

/* Direction of a pair of files of the same name, decided by the DATE first and
 * by the SIZE when the date cannot decide (the same stamp, or no stamp at all).
 * The empty-string cases are handled explicitly: with SET EXACT OFF a ">"
 * against "" is not a meaningful comparison (AGENTS.md, trap 20). */
STATIC FUNCTION HcSyncNewer( cLSt, cRSt, nLS, nRS )
   IF Empty( cLSt ) .AND. Empty( cRSt )
      /* no timestamp on either side: the size decides */
   ELSEIF Empty( cRSt )
      RETURN "=>"
   ELSEIF Empty( cLSt )
      RETURN "<="
   ELSEIF cLSt > cRSt
      RETURN "=>"
   ELSEIF cRSt > cLSt
      RETURN "<="
   ENDIF
   IF nLS > nRS
      RETURN "=>"
   ENDIF
   IF nRS > nLS
      RETURN "<="
   ENDIF
RETURN ""

/* .T. only when the two files hold the same bytes. The sizes are compared
 * first and then both files are read in 64 KB blocks: a huge file is never
 * loaded whole, and an error (cannot open, short read) means DIFFERENT - never
 * equal, because pretending two files are the same is what would lose data. */
STATIC FUNCTION HcSyncSameContent( cA, cB )
   LOCAL nA, nB, nRA, nRB, cBufA, cBufB, lSame := .T.
   IF Empty( cA ) .OR. Empty( cB )
      RETURN .F.
   ENDIF
   IF hb_vfSize( cA ) != hb_vfSize( cB )
      RETURN .F.
   ENDIF
   nA := FOpen( cA, FO_READ )
   IF nA < 0
      RETURN .F.
   ENDIF
   nB := FOpen( cB, FO_READ )
   IF nB < 0
      FClose( nA )
      RETURN .F.
   ENDIF
   cBufA := Space( HC_COPY_CHUNK )
   cBufB := Space( HC_COPY_CHUNK )
   DO WHILE .T.
      nRA := FRead( nA, @cBufA, HC_COPY_CHUNK )
      nRB := FRead( nB, @cBufB, HC_COPY_CHUNK )
      IF ValType( nRA ) != "N" .OR. ValType( nRB ) != "N" .OR. nRA < 0 .OR. nRB < 0
         lSame := .F.
         EXIT
      ENDIF
      IF nRA != nRB
         lSame := .F.
         EXIT
      ENDIF
      IF nRA == 0
         EXIT
      ENDIF
      IF ! ( Left( cBufA, nRA ) == Left( cBufB, nRA ) )
         lSame := .F.
         EXIT
      ENDIF
   ENDDO
   FClose( nA )
   FClose( nB )
RETURN lSame

/* S20/S24: one row per name matched by cMask that exists on either side, in
 * name order. The action of every row is decided HERE, because this is where
 * lByContent and lIgnoreDate live. */
FUNCTION HcSyncScan( cLeftDir, cRightDir, cMask, lByContent, lIgnoreDate )
   LOCAL aL, aR, aNames := {}, aOut := {}
   LOCAL i, cName, aLe, aRi, lL, lR, nLS, nRS, cLSt, cRSt
   LOCAL lLDir, lRDir, lSame, cAct, cLPath, cRPath
   DEFAULT cMask TO "*.*"
   DEFAULT lByContent TO .T.
   DEFAULT lIgnoreDate TO .F.
   aL := HcSyncList( cLeftDir )
   aR := HcSyncList( cRightDir )
   FOR i := 1 TO Len( aL )
      IF ! HcSyncNameIn( aNames, aL[ i ][ 1 ] )
         AAdd( aNames, aL[ i ][ 1 ] )
      ENDIF
   NEXT
   FOR i := 1 TO Len( aR )
      IF ! HcSyncNameIn( aNames, aR[ i ][ 1 ] )
         AAdd( aNames, aR[ i ][ 1 ] )
      ENDIF
   NEXT
   IF Len( aNames ) > 1
      ASort( aNames, 1, Len( aNames ), {| x, y | Upper( x ) < Upper( y ) } )
   ENDIF
   FOR i := 1 TO Len( aNames )
      cName := aNames[ i ]
      /* the mask filters the NAMES; a directory that does not match is not
       * listed either (so "*.txt" shows files only) */
      IF ! HcMaskMatch( cMask, cName )
         LOOP
      ENDIF
      aLe := HcSyncFind( aL, cName )
      aRi := HcSyncFind( aR, cName )
      lL := ! hb_IsNIL( aLe )
      lR := ! hb_IsNIL( aRi )
      nLS := 0 ; nRS := 0 ; cLSt := "" ; cRSt := ""
      lLDir := .F. ; lRDir := .F.
      IF lL
         nLS := aLe[ 2 ]
         cLSt := aLe[ 3 ]
         lLDir := aLe[ 4 ]
      ENDIF
      IF lR
         nRS := aRi[ 2 ]
         cRSt := aRi[ 3 ]
         lRDir := aRi[ 4 ]
      ENDIF
      /* the path that name has on each side; a name that exists on one side
       * only still gets the path it WOULD have on the other one, because that
       * is the destination of its copy. A directory row keeps both empty. */
      cLPath := ""
      cRPath := ""
      IF ! lLDir .AND. ! Empty( cLeftDir )
         cLPath := HcJoinPath( cLeftDir, cName )
      ENDIF
      IF ! lRDir .AND. ! Empty( cRightDir )
         cRPath := HcJoinPath( cRightDir, cName )
      ENDIF
      lSame := .F.
      cAct := ""
      IF lLDir .OR. lRDir
         /* S20: a directory is listed as DIR and never copied nor deleted */
         cAct := ""
      ELSEIF lL .AND. lR
         IF lIgnoreDate
            /* Ignore date: the SIZE decides, the date does not count and the
             * content is not read */
            IF nLS > nRS
               cAct := "=>"
            ELSEIF nRS > nLS
               cAct := "<="
            ENDIF
         ELSEIF nLS != nRS
            cAct := HcSyncNewer( cLSt, cRSt, nLS, nRS )
         ELSEIF cLSt == cRSt
            /* same size and same timestamp: the same file. It is NOT read
             * ("By content" is exactly for a size that matches and a date
             * that does not). L12 of hc-sync-dirs.md: it is listed as IDENTICAL ("==") so both
             * halves can be compared at a glance, but it is still no
             * difference: nothing is copied */
            cAct := "=="
         ELSE
            IF lByContent
               lSame := HcSyncSameContent( cLPath, cRPath )
            ENDIF
            IF lSame
               /* read and equal: the same file, listed as identical (L12 sync doc) */
               cAct := "=="
            ELSE
               cAct := HcSyncNewer( cLSt, cRSt, nLS, nRS )
            ENDIF
         ENDIF
      ELSEIF lL
         cAct := "=>"
      ELSE
         cAct := "<="
      ENDIF
      AAdd( aOut, { cName, lL, lR, nLS, nRS, cLSt, cRSt, lSame, ;
                    lLDir, lRDir, .F., cLPath, cRPath, cAct } )
   NEXT
RETURN aOut

/* S24: the direction of a row: "=>", "<=", "==" for a pair that exists on both
 * sides and is identical (L12 of hc-sync-dirs.md), and "" when there is
 * nothing to do with it
 * (directories). Asymmetric turns every "<-" into "" (only left -> right is
 * synchronized) and leaves "==" alone, because there is nothing to copy
 * either way; the row is still LISTED, which is what the Show filter R uses. */
FUNCTION HcSyncDir( aRow, lAsymmetric )
   LOCAL c
   DEFAULT lAsymmetric TO .F.
   IF ! HB_ISARRAY( aRow ) .OR. Len( aRow ) < SY_ACT
      RETURN ""
   ENDIF
   IF aRow[ SY_LDIR ] .OR. aRow[ SY_RDIR ]
      RETURN ""
   ENDIF
   c := aRow[ SY_ACT ]
   IF ValType( c ) != "C"
      RETURN ""
   ENDIF
   IF lAsymmetric .AND. c == "<="
      RETURN ""
   ENDIF
RETURN c

/* centre a text inside nW cells (PadC() is not used: the widths are the
 * ones of this table and they are always ASCII) */
STATIC FUNCTION HcSyncCenter( cText, nW )
   LOCAL c := cText, nPad
   IF Len( c ) >= nW
      RETURN Left( c, nW )
   ENDIF
   nPad := Int( ( nW - Len( c ) ) / 2 )
RETURN Space( nPad ) + c + Space( nW - nPad - Len( c ) )

/* the size field of one half: "DIR" for a directory, the size for a file and
 * blanks when the name does not exist on that side */
STATIC FUNCTION HcSyncSizeField( aRow, lLeft )
   IF lLeft
      IF aRow[ SY_LDIR ]
         RETURN PadL( "DIR", SY_SIZE_W )
      ENDIF
      IF aRow[ SY_LEFT ]
         RETURN PadL( HcSizeText( aRow[ SY_LSIZE ] ), SY_SIZE_W )
      ENDIF
   ELSE
      IF aRow[ SY_RDIR ]
         RETURN PadL( "DIR", SY_SIZE_W )
      ENDIF
      IF aRow[ SY_RIGHT ]
         RETURN PadL( HcSizeText( aRow[ SY_RSIZE ] ), SY_SIZE_W )
      ENDIF
   ENDIF
RETURN Space( SY_SIZE_W )

/* the date field of one half, "DD/MM/YY" out of the 14 character stamp
 * ("YYYYMMDDHHMMSS"): L24, the same format as the panels */
STATIC FUNCTION HcSyncDateField( aRow, lLeft )
   LOCAL cSt := ""
   IF lLeft
      IF ! aRow[ SY_LDIR ]
         cSt := aRow[ SY_LSTAMP ]
      ENDIF
   ELSE
      IF ! aRow[ SY_RDIR ]
         cSt := aRow[ SY_RSTAMP ]
      ENDIF
   ENDIF
   IF ValType( cSt ) != "C" .OR. Len( cSt ) < 8
      RETURN Space( SY_DATE_W )
   ENDIF
RETURN PadR( SubStr( cSt, 7, 2 ) + "/" + SubStr( cSt, 5, 2 ) + "/" + ;
             SubStr( cSt, 3, 2 ), SY_DATE_W )

/* the time field of one half, "HH:MM" in 24 hours out of the same stamp
 * (characters 9..12 are HHMM, L24) */
STATIC FUNCTION HcSyncTimeField( aRow, lLeft )
   LOCAL cSt := ""
   IF lLeft
      IF ! aRow[ SY_LDIR ]
         cSt := aRow[ SY_LSTAMP ]
      ENDIF
   ELSE
      IF ! aRow[ SY_RDIR ]
         cSt := aRow[ SY_RSTAMP ]
      ENDIF
   ENDIF
   IF ValType( cSt ) != "C" .OR. Len( cSt ) < 12
      RETURN Space( SY_TIME_W )
   ENDIF
RETURN PadR( SubStr( cSt, 9, 2 ) + ":" + SubStr( cSt, 11, 2 ), SY_TIME_W )

/* total width of a table line for a name field of nNameW cells */
STATIC FUNCTION HcSyncTableW( nNameW )
RETURN 2 * ( nNameW + SY_SIZE_W + 1 + SY_DATE_W + 1 + SY_TIME_W ) + SY_DIR_W

/* the name field the canvas can hold: the two halves and the direction column
 * take the width, and what is left is split in two equal name fields */
STATIC FUNCTION HcSyncNameW()
   LOCAL n := ( UiCols() - 2 * SY_MARG - SY_DIR_W ) / 2 - ;
              ( SY_SIZE_W + 1 + SY_DATE_W + 1 + SY_TIME_W )
RETURN Max( 8, Int( n ) )

/* S24: one line of the table. BOTH halves have the SAME column order (name,
 * size, date; the user asked for it that way, so the right side is not
 * mirrored): the middle holds the direction and is enclosed in two vertical
 * rules, so the table reads as two boxes side by side with the direction
 * between them (the width of SY_DIR_W does not change: the two dividers take
 * its first and last cell and the direction keeps 4). */
FUNCTION HcSyncLine( aRow, nNameW )
   LOCAL nN, cL, cR
   DEFAULT nNameW TO 20
   nN := Max( 4, nNameW )
   IF ! HB_ISARRAY( aRow ) .OR. Len( aRow ) < SY_ACT
      RETURN Space( HcSyncTableW( nN ) )
   ENDIF
   cL := PadR( iif( aRow[ SY_LEFT ], aRow[ SY_NAME ], "" ), nN ) + ;
         HcSyncSizeField( aRow, .T. ) + " " + HcSyncDateField( aRow, .T. ) + ;
         " " + HcSyncTimeField( aRow, .T. )
   cR := PadR( iif( aRow[ SY_RIGHT ], aRow[ SY_NAME ], "" ), nN ) + ;
         HcSyncSizeField( aRow, .F. ) + " " + HcSyncDateField( aRow, .F. ) + ;
         " " + HcSyncTimeField( aRow, .F. )
RETURN cL + HcSyncDivider( HcSyncDir( aRow, .F. ) ) + cR

/* the middle column: a vertical rule, the direction centred in the cells that
 * are left and another vertical rule */
STATIC FUNCTION HcSyncDivider( cDir )
RETURN BP_SEP_VERT + HcSyncCenter( cDir, SY_DIR_W - 2 ) + BP_SEP_VERT

/* S19/S20: the rows the table SHOWS. L12 of hc-sync-dirs.md: an identical pair (a "==" row, by
 * date+size or by content) IS listed, marked in the middle column, so the two
 * halves can be compared at a glance; it is not a difference and the plan
 * never copies it. The Show filters still decide: "==" rows are names present
 * on both sides, so Duplicates shows or hides them and the All chip turn every
 * filter on. */
FUNCTION HcSyncView( aRows, lDup, lSing, lL2R, lR2L )
   LOCAL aOut := {}, i, aR, cDir, lShow
   LOCAL lL, lR
   DEFAULT lDup TO .T.
   DEFAULT lSing TO .T.
   DEFAULT lL2R TO .T.
   DEFAULT lR2L TO .T.
   IF ! HB_ISARRAY( aRows )
      RETURN aOut
   ENDIF
   FOR i := 1 TO Len( aRows )
      aR := aRows[ i ]
      IF ! HB_ISARRAY( aR ) .OR. Len( aR ) < SY_ACT
         LOOP
      ENDIF
      lL := aR[ SY_LEFT ]
      lR := aR[ SY_RIGHT ]
      lShow := .F.
      IF lL .AND. lR
         lShow := lDup
      ELSEIF lL .OR. lR
         lShow := lSing
      ENDIF
      cDir := HcSyncDir( aR, .F. )
      IF ! lShow .AND. cDir == "=>" .AND. lL2R
         lShow := .T.
      ENDIF
      IF ! lShow .AND. cDir == "<=" .AND. lR2L
         lShow := .T.
      ENDIF
      IF lShow
         AAdd( aOut, aR )
      ENDIF
   NEXT
RETURN aOut

/* S21/S22: the plan. lMarked = "there is at least one marked row", which is
 * what makes Synchronize act ONLY on the marked rows; without marks it acts on
 * every actionable row. lDeleteExtras turns the names that exist on one side
 * only into DELETIONS instead of copies (that is what the box decides, L10.1),
 * and under Asymmetric only the destination side (the right one) can lose a
 * file: a left extra is the source, so it is copied over instead. A directory
 * is never planned and a file is never planned onto itself. */
FUNCTION HcSyncPlan( aRows, lMarked, lAsymmetric, lDeleteExtras )
   LOCAL aCopy := {}, aDel := {}, i, aR, cDir, lL, lR
   DEFAULT lMarked TO .F.
   DEFAULT lAsymmetric TO .F.
   DEFAULT lDeleteExtras TO .F.
   IF ! HB_ISARRAY( aRows )
      RETURN { aCopy, aDel }
   ENDIF
   FOR i := 1 TO Len( aRows )
      aR := aRows[ i ]
      IF ! HB_ISARRAY( aR ) .OR. Len( aR ) < SY_ACT
         LOOP
      ENDIF
      IF lMarked .AND. ! aR[ SY_MARK ]
         LOOP
      ENDIF
      IF aR[ SY_SAME ] .OR. aR[ SY_LDIR ] .OR. aR[ SY_RDIR ]
         LOOP
      ENDIF
      IF HcSyncDir( aR, .F. ) == "=="
         /* L12 of hc-sync-dirs.md: identical on both sides, listed but not a copy
          * and it is not an extra (so Delete extras never touches it) */
         LOOP
      ENDIF
      lL := aR[ SY_LEFT ]
      lR := aR[ SY_RIGHT ]
      IF lL .AND. lR
         /* on both sides: the row decides the direction */
         cDir := HcSyncDir( aR, lAsymmetric )
         IF cDir == "=>"
            HcSyncAddCopy( aCopy, aR[ SY_LPATH ], aR[ SY_RPATH ] )
         ELSEIF cDir == "<="
            HcSyncAddCopy( aCopy, aR[ SY_RPATH ], aR[ SY_LPATH ] )
         ENDIF
      ELSEIF lDeleteExtras .AND. lR
         /* a name of the right side only: it is an extra, and Delete extras
          * DELETES it (it is off at the start, L10.1) */
         AAdd( aDel, aR[ SY_RPATH ] )
      ELSEIF lDeleteExtras .AND. lL
         /* a name of the left side only. Under Asymmetric the left is the
          * source, so it is copied over instead of being deleted: only the
          * destination side can lose a file */
         IF lAsymmetric
            HcSyncAddCopy( aCopy, aR[ SY_LPATH ], aR[ SY_RPATH ] )
         ELSE
            AAdd( aDel, aR[ SY_LPATH ] )
         ENDIF
      ELSEIF lL
         HcSyncAddCopy( aCopy, aR[ SY_LPATH ], aR[ SY_RPATH ] )
      ELSEIF lR .AND. ! lAsymmetric
         HcSyncAddCopy( aCopy, aR[ SY_RPATH ], aR[ SY_LPATH ] )
      ENDIF
   NEXT
RETURN { aCopy, aDel }

/* one copy of the plan, unless the source and the destination are the same
 * file (the same directory on both panels, or a destination written with ".."
 * that lands on the source): HcCopyAnyHc() refuses it too, but a plan that
 * asks for it is a lie */
STATIC PROCEDURE HcSyncAddCopy( aCopy, cSrc, cDst )
   IF Empty( cSrc ) .OR. Empty( cDst )
      RETURN
   ENDIF
   IF HcNormPath( cSrc ) == HcNormPath( cDst )
      RETURN
   ENDIF
   AAdd( aCopy, { cSrc, cDst } )
RETURN

/* ------------------------------------------------------------------ S19 ---- */

/* initial state of the screen: both directories as they are NOW, the mask of
 * S19, and the boxes. "Only selected" starts OFF because that is what the user
 * asked for in L9: "I can select files and it will synchronize only those, or
 * if I select nothing the system will take everything to compare". With the box
 * ON and nothing marked, S21 applies: the message row says
 * "No entries are marked in the panel." and nothing is compared. "By content"
 * starts ON (the user's criterion, L10.4) and "Delete extras" starts OFF
 * (L10.1). Show starts at A, i.e. all four filters on. */
STATIC FUNCTION HcSyncState( cL, cR )
RETURN { cL, cR, "*.*", .F., .F., .F., .T., .F., .F., ;
         .T., .T., .T., .T., {}, {}, 1, 1, "Press <F4> to compare", 0, 0 }

STATIC FUNCTION HcSyncAnyMark( aRows )
   LOCAL i
   FOR i := 1 TO Len( aRows )
      IF aRows[ i ][ SY_MARK ]
         RETURN .T.
      ENDIF
   NEXT
RETURN .F.

/* the names MARKED in the active panel (S21, "Only selected") */
STATIC FUNCTION HcSyncPanelMarks()
   LOCAL aP := HcPanelActive(), a := {}, i
   FOR i := 1 TO Len( aP[ HC_P_LIST ] )
      IF aP[ HC_P_LIST ][ i ][ HC_E_MARK ] .AND. ;
         ! ( aP[ HC_P_LIST ][ i ][ HC_E_NAME ] == ".." )
         AAdd( a, aP[ HC_P_LIST ][ i ][ HC_E_NAME ] )
      ENDIF
   NEXT
RETURN a

/* S19: the header line, built with the same widths and the same column order
 * as the rows */
STATIC FUNCTION HcSyncHeadLine( nNameW )
RETURN PadR( "Name", nNameW ) + PadL( "Size", SY_SIZE_W ) + " " + ;
       PadR( "Date", SY_DATE_W ) + " " + PadR( "Time", SY_TIME_W ) + ;
       HcSyncDivider( "<==>" ) + ;
       PadR( "Name", nNameW ) + PadL( "Size", SY_SIZE_W ) + " " + ;
       PadR( "Date", SY_DATE_W ) + " " + PadR( "Time", SY_TIME_W )

/* one labelled line of the head area (Left / Right / Mask) */
STATIC PROCEDURE HcSyncField( nRow, cLabel, cValue )
   LOCAL nW := Max( 4, UiCols() - 2 - SY_LAB_W )
   SetColor( UI_C_DESKTOP )
   @ nRow, 0 SAY Space( UiCols() )
   SetColor( UI_C_CHIP )
   @ nRow, 1 SAY PadR( " " + cLabel + " :", SY_LAB_W )
   SetColor( UI_C_HOT )
   @ nRow, 1 + SY_LAB_W SAY PadR( HcPathTitle( cValue, nW ), nW )
   SetColor( UI_C_DESKTOP )
RETURN

/* one checkbox of the two option rows. The label carries its ~X~ mark, so the
 * letter that toggles it is visible; a label without a mark (Subdirs: it has
 * no key yet) is painted WITHOUT a fake hot letter. */
/* =====================================================================
 *  Mouse (S31): EVERY clickable control of the synchronize screen registers
 *  itself while it is painted.
 *
 *  That is the rule for this screen and for anything added later: a painter
 *  pushes the row/column span it just drew plus the input it stands for
 *  (an Alt letter, a plain letter or a key), a click on that span is translated
 *  to EXACTLY the same keystroke the keyboard produces, and the key handling
 *  that already exists does the work. There is no second copy of the layout to
 *  keep in sync, so a new option becomes mouse-enabled by construction as long
 *  as it is painted through HcSyncCheck()/HcSyncShowChip()/HcHintKey() and has
 *  its key.
 * ===================================================================== */
/* NOT static: the Replace form of bp_cmds.prg paints its controls with this
 * very table too, so one click and the keyboard can never disagree about what
 * is under the pointer (odd/tasks/replace-form.md S7). */
PROCEDURE HcSyncCtlReset()
   s_aHcSyncCtl := {}
RETURN

/* { nRow, nCol, nW, cKind, cArg } with cKind "KEY" (cArg = the chip name, like
 * "F4" or "Alt-S"), "ALT" (cArg = the Alt letter) or "CHAR" (a plain letter) */
PROCEDURE HcSyncCtlAdd( nRow, nCol, nW, cKind, cArg )
   AAdd( s_aHcSyncCtl, { nRow, nCol, Max( 1, nW ), cKind, cArg } )
RETURN

/* the control under a cell, or NIL */
FUNCTION HcSyncCtlAt( nRow, nCol )
   LOCAL i, a
   FOR i := 1 TO Len( s_aHcSyncCtl )
      a := s_aHcSyncCtl[ i ]
      IF a[ 1 ] == nRow .AND. nCol >= a[ 2 ] .AND. nCol < a[ 2 ] + a[ 3 ]
         RETURN a
      ENDIF
   NEXT
RETURN NIL

/* the input a chip name stands for: { nKey, cAlt }. It is the ONE table of chip
 * names: the sync screen and the Find and Replace screen both read it, so the
 * two cannot disagree about what a chip means, and the bank pins it. An unknown
 * name answers { 0, "" } (no key, no Alt letter). */
FUNCTION HcSyncChipInput( cName )
   DO CASE
   CASE cName == "F1"  ; RETURN { K_F1,  "" }
   CASE cName == "F3"  ; RETURN { K_F3,  "" }
   CASE cName == "F4"  ; RETURN { K_F4,  "" }
   CASE cName == "F5"  ; RETURN { K_F5,  "" }
   CASE cName == "F7"  ; RETURN { K_F7,  "" }
   CASE cName == "F8"  ; RETURN { K_F8,  "" }
   CASE cName == "Enter" ; RETURN { K_ENTER, "" }
   CASE cName == "Esc" ; RETURN { K_ESC, "" }
   CASE cName == "Ins" ; RETURN { K_INS, "" }
   CASE cName == "Tab" ; RETURN { K_TAB, "" }
   CASE cName == "Ctrl-O" ; RETURN { K_CTRL_O, "" }
   /* K_CTRL_F and K_END are the same code 6 in this driver (AGENTS trap 37):
    * the caller that needs them apart reads the CTRL bit itself, and a screen
    * that runs one action with both (the File search: Ctrl-F and F5 search)
    * simply has to treat this code as that action */
   CASE cName == "Ctrl-F" ; RETURN { K_CTRL_F, "" }
   ENDCASE
   IF Left( cName, 4 ) == "Alt-" .AND. Len( cName ) == 5
      RETURN { 0, Upper( SubStr( cName, 5, 1 ) ) }
   ENDIF
   IF Len( cName ) == 1
      RETURN { Asc( Upper( cName ) ), "" }
   ENDIF
RETURN { 0, "" }

/* Reads the mouse for this screen: the wheel moves the table one row per notch
 * (like the panels) and a click becomes the input of the control it hit, or
 * moves the cursor when it lands on a result row. Returns { nKey, cAlt } and an
 * empty array when there was nothing to do. */
STATIC FUNCTION HcSyncMouseInput( st )
   LOCAL nNotch, nRow, nCol, nIdx, nOld, nOldTop, aC
   nNotch := HcMouseWheel()
   IF nNotch != 0
      nOld := st[ SC_SEL ]
      nOldTop := st[ SC_TOP ]
      IF HcSyncMove( st, -nNotch )
         HcSyncPaintMoved( st, nOld, nOldTop )
      ENDIF
      RETURN { 0, "" }
   ENDIF
   nRow := HcMouseClickRow()
   nCol := HcMouseClickCol()
   IF nRow < 0 .OR. nCol < 0
      RETURN {}
   ENDIF
   /* a result row: the click puts the cursor there (marks are the job of Ins) */
   IF nRow >= SY_FIRST .AND. nRow <= SY_LAST
      nIdx := st[ SC_TOP ] + ( nRow - SY_FIRST )
      IF nIdx >= 1 .AND. nIdx <= Len( st[ SC_VIEW ] )
         nOld := st[ SC_SEL ]
         nOldTop := st[ SC_TOP ]
         IF HcSyncMove( st, nIdx - st[ SC_SEL ] )
            HcSyncPaintMoved( st, nOld, nOldTop )
         ENDIF
      ENDIF
      RETURN { 0, "" }
   ENDIF
   aC := HcSyncCtlAt( nRow, nCol )
   IF hb_IsNIL( aC )
      RETURN {}
   ENDIF
   DO CASE
   CASE aC[ 4 ] == "KEY"
      RETURN HcSyncChipInput( aC[ 5 ] )
   CASE aC[ 4 ] == "ALT"
      RETURN { 0, aC[ 5 ] }
   ENDCASE
RETURN { Asc( Upper( aC[ 5 ] ) ), "" }

STATIC PROCEDURE HcSyncCheck( nRow, nCol, lOn, cLabel, nW, lAlt )
   LOCAL cCol := iif( lOn, UI_C_BOXSEL, UI_C_DESKTOP )
   LOCAL cHot := iif( lOn, UI_C_HOTSEL, UI_C_HOT )
   LOCAL nLab := Max( 4, nW - 4 )
   DEFAULT lAlt TO .T.
   SetColor( cCol )
   @ nRow, nCol SAY "[" + iif( lOn, "X", " " ) + "]"
   IF Empty( UiHotKey( cLabel ) )
      UiWrite( nRow, nCol + 4, PadR( cLabel, nLab ), cCol )
   ELSE
      /* +2 for the two "~" marks UiDrawHot() removes */
      UiDrawHot( nRow, nCol + 4, PadR( cLabel, nLab + 2 ), cCol, cHot )
   ENDIF
   SetColor( UI_C_DESKTOP )
   /* the whole control (checkbox + label) answers the mouse */
   HcSyncCtlAdd( nRow, nCol, 4 + nLab, iif( lAlt, "ALT", "CHAR" ), UiHotKey( cLabel ) )
RETURN

/* one chip of the Show row; returns the column of the next one */
STATIC FUNCTION HcSyncShowChip( nRow, nCol, lOn, cLabel )
   UiDrawHot( nRow, nCol, cLabel, iif( lOn, UI_C_BOXSEL, UI_C_DESKTOP ), ;
              iif( lOn, UI_C_HOTSEL, UI_C_HOT ) )
   /* the chip answers the mouse with its own letter */
   HcSyncCtlAdd( nRow, nCol, UiHotLen( cLabel ) + 2, "CHAR", UiHotKey( cLabel ) )
RETURN nCol + UiHotLen( cLabel ) + 2

/* S19 rows 4..6: the options and the Show filters */
STATIC PROCEDURE HcSyncDrawOptions( st )
   LOCAL nColW := Max( 14, Int( ( UiCols() - 2 * SY_MARG ) / SY_COLS ) )
   LOCAL nC1 := SY_MARG, nC2 := nC1 + nColW, nC3 := nC2 + nColW, nCol
   SetColor( UI_C_DESKTOP )
   @ SY_OPT1, 0 SAY Space( UiCols() )
   @ SY_OPT2, 0 SAY Space( UiCols() )
   HcSyncCheck( SY_OPT1, nC1, st[ SC_ONLYSEL ], "Only ~s~elected", nColW )
   HcSyncCheck( SY_OPT1, nC2, st[ SC_ASYM ], "~A~symmetric", nColW )
   HcSyncCheck( SY_OPT1, nC3, st[ SC_SUBDIRS ], "Sub~u~dirs", nColW, .F. )
   HcSyncCheck( SY_OPT2, nC1, st[ SC_BYCONT ], "By ~c~ontent", nColW )
   HcSyncCheck( SY_OPT2, nC2, st[ SC_IGNOREDATE ], "~I~gnore date", nColW )
   HcSyncCheck( SY_OPT2, nC3, st[ SC_DELEXTRA ], "~D~elete extras", nColW )
   /* the Show filters of row SY_SHOW */
   SetColor( UI_C_DESKTOP )
   @ SY_SHOW, 0 SAY Space( UiCols() )
   SetColor( UI_C_CHIP )
   @ SY_SHOW, SY_MARG SAY "Show:"
   nCol := SY_MARG + 6
   nCol := HcSyncShowChip( SY_SHOW, nCol, st[ SC_SHDUP ], "[~D~]uplicates" )
   nCol := HcSyncShowChip( SY_SHOW, nCol, st[ SC_SHSING ], "[~S~]ingles" )
   nCol := HcSyncShowChip( SY_SHOW, nCol, st[ SC_SHL2R ], "[~L~]eft->right" )
   nCol := HcSyncShowChip( SY_SHOW, nCol, st[ SC_SHR2L ], "[~R~]ight->left" )
   HcSyncShowChip( SY_SHOW, nCol, st[ SC_SHDUP ] .AND. st[ SC_SHSING ] .AND. ;
                   st[ SC_SHL2R ] .AND. st[ SC_SHR2L ], "[~A~]ll" )
   SetColor( UI_C_DESKTOP )
RETURN

/* the summary and the message rows, and the two rows of key chips */
STATIC PROCEDURE HcSyncDrawSum( st )
   LOCAL c := " " + LTrim( Str( st[ SC_NCOPY ] ) ) + " to copy, " + ;
              LTrim( Str( st[ SC_NDEL ] ) ) + " to delete"
   IF st[ SC_NCOPY ] + st[ SC_NDEL ] == 0
      c += "   (nothing to do)"
   ENDIF
   SetColor( UI_C_HINT )
   @ SY_SUMROW, 0 SAY PadR( Left( c, UiCols() ), UiCols() )
   SetColor( UI_C_DESKTOP )
RETURN

STATIC PROCEDURE HcSyncDrawMsg( st )
   SetColor( UI_C_STATUSBAR )
   @ SY_MSGROW, 0 SAY PadR( Left( " " + st[ SC_MSG ], UiCols() ), UiCols() )
   SetColor( UI_C_DESKTOP )
RETURN

/* the key chips of rows SY_KEYS/SY_KEYS2: they flow from left to right and
 * move to the second row when the first one is full (a narrower canvas keeps
 * the text inside instead of running off the screen) */
STATIC PROCEDURE HcSyncDrawKeys()
   LOCAL aAll := { { "F4", "=Compare" }, { "F5", "=Synchronize" }, ;
                   { "F1", "=Help" }, { "Esc", "=Close" }, ;
                   { "Ins", "=Mark" }, { "Alt-F", "=Mask" }, ;
                   { "Alt-S", "=Only sel" }, { "Alt-A", "=Asymmetric" }, ;
                   { "Alt-C", "=Content" }, { "Alt-I", "=Ign.date" }, ;
                   { "Alt-D", "=Del.extras" }, { "U", "=Subdirs" } }
   LOCAL i, nRow := SY_KEYS, nCol := 1, nW
   SetColor( UI_C_MENUBAR )
   @ SY_KEYS, 0 SAY Space( UiCols() )
   @ SY_KEYS2, 0 SAY Space( UiCols() )
   FOR i := 1 TO Len( aAll )
      nW := Len( aAll[ i ][ 1 ] ) + 2 + Len( aAll[ i ][ 2 ] ) + 2
      IF nCol + nW > UiCols() .AND. nRow == SY_KEYS .AND. SY_KEYS2 > SY_KEYS
         nRow := SY_KEYS2
         nCol := 1
      ENDIF
      IF nCol + nW > UiCols()
         EXIT
      ENDIF
      /* the chip answers the mouse with the very key it announces */
      HcSyncCtlAdd( nRow, nCol, nW, "KEY", aAll[ i ][ 1 ] )
      nCol := HcHintKey( nRow, nCol, aAll[ i ][ 1 ], aAll[ i ][ 2 ] )
   NEXT
   SetColor( UI_C_DESKTOP )
RETURN

/* one row of the results, painted from its index inside SC_VIEW (rows off the
 * window are not painted at all, and an index with no row blanks the cells).
 * The CALLER owns the paint block, so moving the cursor repaints only the two
 * rows that changed. */
STATIC PROCEDURE HcSyncDrawViewRow( st, nIdx )
   LOCAL nNameW := HcSyncNameW(), nW := Min( HcSyncTableW( nNameW ), UiCols() - SY_MARG )
   LOCAL nScr := SY_FIRST + nIdx - st[ SC_TOP ], cLine
   IF nScr < SY_FIRST .OR. nScr > SY_LAST
      RETURN
   ENDIF
   SetColor( UI_C_DESKTOP )
   IF nIdx < 1 .OR. nIdx > Len( st[ SC_VIEW ] )
      @ nScr, SY_MARG SAY Space( Max( 0, nW ) )
      RETURN
   ENDIF
   cLine := HcSyncLine( st[ SC_VIEW ][ nIdx ], nNameW )
   IF nIdx == st[ SC_SEL ]
      SetColor( UI_C_LISTSEL )
   ELSEIF st[ SC_VIEW ][ nIdx ][ SY_MARK ]
      SetColor( UI_C_RECSEL )
   ELSE
      SetColor( UI_C_DESKTOP )
   ENDIF
   @ nScr, SY_MARG SAY PadR( Left( cLine, nW ), Max( 0, nW ) )
   SetColor( UI_C_DESKTOP )
RETURN

/* the whole results area, in ONE paint block (a scrolled window) */
STATIC PROCEDURE HcSyncDrawTable( st )
   LOCAL i
   FOR i := 1 TO SY_VIS
      HcSyncDrawViewRow( st, st[ SC_TOP ] + i - 1 )
   NEXT
RETURN

/* everything of S19, inside the caller's paint block */
STATIC PROCEDURE HcSyncDrawScreen( st )
   LOCAL i, nNameW := HcSyncNameW()
   LOCAL nW := Min( HcSyncTableW( nNameW ), UiCols() - SY_MARG ), cHead
   /* the clickable controls are rebuilt with every full paint (S31) */
   HcSyncCtlReset()
   UiCls()
   SetColor( UI_C_DESKTOP )
   FOR i := SY_TITLE TO MaxRow()
      @ i, 0 SAY Space( UiCols() )
   NEXT
   /* row 0: the title, in the chip colour of the rest of the program */
   SetColor( UI_C_CHIP )
   @ SY_TITLE, 0 SAY PadR( " Synchronize directories", UiCols() )
   HcSyncField( SY_ROWL, "Left", st[ SC_L ] )
   HcSyncField( SY_ROWR, "Right", st[ SC_R ] )
   HcSyncField( SY_ROWMASK, "Mask", st[ SC_MASK ] )
   HcSyncDrawOptions( st )
   /* the header and the two rules */
   cHead := HcSyncHeadLine( nNameW )
   SetColor( UI_C_HDR )
   @ SY_HDR, SY_MARG SAY PadR( Left( cHead, nW ), Max( 0, nW ) )
   SetColor( UI_C_DESKTOP )
   @ SY_RUL1, SY_MARG SAY Replicate( BP_LINE_SINGLE, Max( 0, nW ) )
   HcSyncDrawTable( st )
   @ SY_RUL2, SY_MARG SAY Replicate( BP_LINE_SINGLE, Max( 0, nW ) )
   HcSyncDrawSum( st )
   HcSyncDrawMsg( st )
   HcSyncDrawKeys()
   SetColor( UI_C_DESKTOP )
RETURN

STATIC PROCEDURE HcSyncPaint( st )
   UiPaintBegin()
   HcSyncDrawScreen( st )
   UiPaintEnd()
RETURN

/* only the two rows the cursor left and reached (no full repaint); when the
 * window scrolled, the whole visible area is repainted in ONE block */
STATIC PROCEDURE HcSyncPaintMoved( st, nOld, nOldTop )
   UiPaintBegin()
   IF st[ SC_TOP ] != nOldTop
      HcSyncDrawTable( st )
   ELSE
      HcSyncDrawViewRow( st, nOld )
      HcSyncDrawViewRow( st, st[ SC_SEL ] )
   ENDIF
   UiPaintEnd()
RETURN

/* the row whose mark changed, plus the summary it feeds */
STATIC PROCEDURE HcSyncPaintMarked( st )
   UiPaintBegin()
   HcSyncDrawViewRow( st, st[ SC_SEL ] )
   HcSyncDrawSum( st )
   UiPaintEnd()
RETURN

/* ------------------------------------------------------------------ S20/S21 - */

/* keeps the cursor inside the visible window of the table */
STATIC PROCEDURE HcSyncFixTop( st )
   IF st[ SC_SEL ] < st[ SC_TOP ]
      st[ SC_TOP ] := st[ SC_SEL ]
   ENDIF
   IF st[ SC_SEL ] > st[ SC_TOP ] + SY_VIS - 1
      st[ SC_TOP ] := st[ SC_SEL ] - SY_VIS + 1
   ENDIF
   st[ SC_TOP ] := Max( 1, st[ SC_TOP ] )
RETURN

/* rebuilds SC_VIEW out of SC_ROWS (Show filters and hidden pairs) and keeps
 * the cursor inside it */
STATIC PROCEDURE HcSyncRebuild( st )
   st[ SC_VIEW ] := HcSyncView( st[ SC_ROWS ], st[ SC_SHDUP ], st[ SC_SHSING ], ;
                               st[ SC_SHL2R ], st[ SC_SHR2L ] )
   IF st[ SC_SEL ] < 1
      st[ SC_SEL ] := 1
   ENDIF
   IF st[ SC_SEL ] > Len( st[ SC_VIEW ] )
      st[ SC_SEL ] := Max( 1, Len( st[ SC_VIEW ] ) )
   ENDIF
   HcSyncFixTop( st )
RETURN

/* the counts of the summary row, always from the PLAN, so what the row says is
 * exactly what F5 would do (never a guess) */
STATIC PROCEDURE HcSyncCount( st )
   LOCAL aPlan
   IF Empty( st[ SC_ROWS ] )
      st[ SC_NCOPY ] := 0
      st[ SC_NDEL ] := 0
      RETURN
   ENDIF
   aPlan := HcSyncPlan( st[ SC_ROWS ], HcSyncAnyMark( st[ SC_ROWS ] ), ;
                        st[ SC_ASYM ], st[ SC_DELEXTRA ] )
   st[ SC_NCOPY ] := Len( aPlan[ 1 ] )
   st[ SC_NDEL ] := Len( aPlan[ 2 ] )
RETURN

/* F4: the comparison of S20. With "Only selected" it is limited to the entries
 * marked in the ACTIVE panel (S21), and with no marks it says so and compares
 * nothing. "Subdirs" is visible but not implemented yet: the row of S20 says
 * so instead of pretending (L10.3). */
STATIC PROCEDURE HcSyncCompare( st )
   LOCAL aRows, aMarks := {}, aOut := {}, i, aR
   IF st[ SC_ONLYSEL ]
      aMarks := HcSyncPanelMarks()
      IF Empty( aMarks )
         st[ SC_ROWS ] := {}
         st[ SC_VIEW ] := {}
         st[ SC_SEL ] := 1
         st[ SC_TOP ] := 1
         st[ SC_NCOPY ] := 0
         st[ SC_NDEL ] := 0
         st[ SC_MSG ] := "No entries are marked in the panel."
         RETURN
      ENDIF
   ENDIF
   aRows := HcSyncScan( st[ SC_L ], st[ SC_R ], st[ SC_MASK ], ;
                        st[ SC_BYCONT ], st[ SC_IGNOREDATE ] )
   IF ! Empty( aMarks )
      FOR i := 1 TO Len( aRows )
         aR := aRows[ i ]
         IF HcSyncNameIn( aMarks, aR[ SY_NAME ] )
            AAdd( aOut, aR )
         ENDIF
      NEXT
      aRows := aOut
   ENDIF
   st[ SC_ROWS ] := aRows
   st[ SC_SEL ] := 1
   st[ SC_TOP ] := 1
   HcSyncRebuild( st )
   HcSyncCount( st )
   IF st[ SC_SUBDIRS ]
      st[ SC_MSG ] := "Subdirectories: not included yet"
   ELSE
      st[ SC_MSG ] := LTrim( Str( Len( st[ SC_VIEW ] ) ) ) + " row(s) in the table."
   ENDIF
RETURN

/* moves the cursor; .T. when it really moved */
STATIC FUNCTION HcSyncMove( st, nDelta )
   LOCAL nOld := st[ SC_SEL ], n
   IF Empty( st[ SC_VIEW ] )
      RETURN .F.
   ENDIF
   n := Max( 1, Min( Len( st[ SC_VIEW ] ), nOld + nDelta ) )
   IF n == nOld
      RETURN .F.
   ENDIF
   st[ SC_SEL ] := n
   HcSyncFixTop( st )
RETURN .T.

/* S21: Ins / Space / Enter mark and unmark the row under the cursor */
STATIC FUNCTION HcSyncToggleMark( st )
   LOCAL n := st[ SC_SEL ]
   IF n < 1 .OR. n > Len( st[ SC_VIEW ] )
      RETURN .F.
   ENDIF
   st[ SC_VIEW ][ n ][ SY_MARK ] := ! st[ SC_VIEW ][ n ][ SY_MARK ]
RETURN .T.

/* Alt+<letter> of S23. .T. when the screen has to be repainted. The options
 * that change the COMPARISON compare again at once, so the table never shows
 * the result of the previous settings. */
STATIC PROCEDURE HcSyncAlt( st, cLetter, lRedraw )
   LOCAL cNew
   DO CASE
   CASE cLetter == "S"
      st[ SC_ONLYSEL ] := ! st[ SC_ONLYSEL ]
      HcSyncCompare( st )
      lRedraw := .T.
   CASE cLetter == "A"
      st[ SC_ASYM ] := ! st[ SC_ASYM ]
      HcSyncCount( st )
      lRedraw := .T.
   CASE cLetter == "C"
      st[ SC_BYCONT ] := ! st[ SC_BYCONT ]
      HcSyncCompare( st )
      lRedraw := .T.
   CASE cLetter == "I"
      st[ SC_IGNOREDATE ] := ! st[ SC_IGNOREDATE ]
      HcSyncCompare( st )
      lRedraw := .T.
   CASE cLetter == "D"
      st[ SC_DELEXTRA ] := ! st[ SC_DELEXTRA ]
      HcSyncCount( st )
      lRedraw := .T.
   CASE cLetter == "F"
      cNew := UiInput( "Mask:", st[ SC_MASK ], 40 )
      IF ! hb_IsNIL( cNew ) .AND. ! Empty( AllTrim( cNew ) )
         st[ SC_MASK ] := AllTrim( cNew )
         HcSyncCompare( st )
         lRedraw := .T.
      ENDIF
   ENDCASE
RETURN

/* the D/S/L/R/A filters of the Show row: they only change what is SEEN */
STATIC FUNCTION HcSyncFilter( st, cLetter )
   DO CASE
   CASE cLetter == "D"
      st[ SC_SHDUP ] := ! st[ SC_SHDUP ]
   CASE cLetter == "S"
      st[ SC_SHSING ] := ! st[ SC_SHSING ]
   CASE cLetter == "L"
      st[ SC_SHL2R ] := ! st[ SC_SHL2R ]
   CASE cLetter == "R"
      st[ SC_SHR2L ] := ! st[ SC_SHR2L ]
   CASE cLetter == "A"
      st[ SC_SHDUP ] := .T.
      st[ SC_SHSING ] := .T.
      st[ SC_SHL2R ] := .T.
      st[ SC_SHR2L ] := .T.
   CASE cLetter == "U"
      /* The Subdirs box has no key of its own in S23, but S20 asks for the
       * notice when it is ticked, so it is toggled here with its own letter and
       * the message row says the truth: the comparison is still of the current
       * directories only (L10.3) */
      st[ SC_SUBDIRS ] := ! st[ SC_SUBDIRS ]
      IF st[ SC_SUBDIRS ]
         st[ SC_MSG ] := "Subdirectories: not included yet"
      ELSE
         st[ SC_MSG ] := "Subdirectories off: the current directories only"
      ENDIF
   OTHERWISE
      RETURN .F.
   ENDCASE
   HcSyncRebuild( st )
RETURN .T.

/* ------------------------------------------------------------------ S22 ---- */

/* F5: Synchronize. The flow of S22, in order: the plan, ONE confirmation
 * (through HcConfirm, so a headless run can never touch anything), the copies
 * with HcCopyAnyHc() asking the seven buttons of S17 for every destination
 * that already exists, the deletions of "Delete extras" with HcDeleteHc(),
 * the progress bar, and at the end the panels are reloaded, the comparison is
 * redone and the message row keeps the summary of what really happened. */
STATIC PROCEDURE HcSyncRun( st )
   LOCAL aPlan, aCopy, aDel, i, aRes, cErr := ""
   LOCAL nCopied := 0, nDeleted := 0, nSkipped := 0, nTotal := 0
   LOCAL cSrc, cDst, cNew, lCancel := .F., lDo, nOwState := 0, nChoice, aDec, cAction
   IF Empty( st[ SC_ROWS ] )
      st[ SC_MSG ] := "Press <F4> to compare first."
      RETURN
   ENDIF
   aPlan := HcSyncPlan( st[ SC_ROWS ], HcSyncAnyMark( st[ SC_ROWS ] ), ;
                        st[ SC_ASYM ], st[ SC_DELEXTRA ] )
   aCopy := aPlan[ 1 ]
   aDel := aPlan[ 2 ]
   IF Empty( aCopy ) .AND. Empty( aDel )
      st[ SC_MSG ] := "Nothing to synchronize."
      RETURN
   ENDIF
   IF ! HcConfirm( LTrim( Str( Len( aCopy ) ) ) + " file(s) to copy, " + ;
                   LTrim( Str( Len( aDel ) ) ) + " to delete." + hb_eol() + ;
                   st[ SC_L ] + " -> " + st[ SC_R ], "Synchronize" )
      st[ SC_MSG ] := "Synchronization cancelled."
      RETURN
   ENDIF
   FOR i := 1 TO Len( aCopy )
      nTotal += Max( 0, hb_vfSize( aCopy[ i ][ 1 ] ) )
   NEXT
   HcProgBegin( "Synchronizing", nTotal )
   FOR i := 1 TO Len( aCopy )
      cSrc := aCopy[ i ][ 1 ]
      cDst := aCopy[ i ][ 2 ]
      lDo := .T.
      /* S17: only the entries IN CONFLICT are asked about, with the sticky
       * answers of THIS synchronization (Replace All / Skip All) */
      DO WHILE hb_vfExists( cDst ) .OR. hb_DirExists( cDst )
         IF nOwState == 0
            nChoice := HcOwAsk( HcDirName( cDst ), cSrc, cDst )
         ELSE
            nChoice := 0
         ENDIF
         aDec := HcOwResolve( nOwState, nChoice, HcOwOlder( cSrc, cDst ) )
         nOwState := aDec[ 2 ]
         cAction := aDec[ 1 ]
         IF cAction == "CANCEL"
            /* the whole synchronization stops: what is already copied stays */
            lCancel := .T.
         ELSEIF cAction == "SKIP"
            lDo := .F.
            nSkipped++
         ELSEIF cAction == "RENAME"
            cNew := UiInput( "New destination name:", HcDirName( cDst ), 60 )
            IF hb_IsNIL( cNew ) .OR. Empty( AllTrim( cNew ) )
               lDo := .F.
               nSkipped++
            ELSE
               cDst := HcOwRename( HcParentDir( cDst ), AllTrim( cNew ) )
               /* if THAT name exists too the dialog comes again */
               LOOP
            ENDIF
         ENDIF
         EXIT
      ENDDO
      IF lCancel
         EXIT
      ENDIF
      IF ! lDo
         LOOP
      ENDIF
      aRes := HcCopyAnyHc( cSrc, cDst )
      IF aRes[ 5 ]
         lCancel := .T.
         EXIT
      ENDIF
      IF aRes[ 1 ]
         nCopied++
      ELSE
         nSkipped++
         IF Empty( cErr )
            cErr := aRes[ 2 ]
         ENDIF
      ENDIF
   NEXT
   IF ! lCancel
      FOR i := 1 TO Len( aDel )
         /* the progress bar of the deletions is the <Esc> checkpoint: with a
          * cancel hook or the key the loop stops here */
         IF HcProgStep( 0 )
            lCancel := .T.
            EXIT
         ENDIF
         aRes := HcDeleteOneHc( aDel[ i ], .F. )
         IF aRes[ 1 ]
            nDeleted++
         ELSE
            nSkipped++
            IF Empty( cErr )
               cErr := aRes[ 2 ]
            ENDIF
         ENDIF
      NEXT
   ENDIF
   HcProgEnd()
   /* S49: the synchronize screen copies files too, so a working tree of an
    * open archive may have changed under it */
   HcZipSync()
   HcReloadPanels( "", "" )
   /* the comparison is redone, so the table shows what is left */
   HcSyncCompare( st )
   HcSyncCount( st )
   IF Empty( cErr )
      st[ SC_MSG ] := "Synchronized: " + LTrim( Str( nCopied ) ) + " copied, " + ;
                      LTrim( Str( nDeleted ) ) + " deleted, " + ;
                      LTrim( Str( nSkipped ) ) + " skipped."
   ELSE
      /* an error is never hidden behind a count: the row says what failed */
      st[ SC_MSG ] := cErr
   ENDIF
RETURN

/* F1 of the screen: the keys of S23, the ones that really work */
STATIC PROCEDURE HcSyncHelp()
   LOCAL a := { ;
      "Synchronize directories", ;
      "", ;
      "  The table compares the CURRENT directory of the left panel with", ;
      "  the current directory of the right one. Subdirectories are not", ;
      "  included yet (the box is there, the comparison is not).", ;
      "", ;
      "  One row per name, with the size and the date of each side and the", ;
      "  direction of the copy in the middle:", ;
      "     =>   copy left -> right      <=   copy right -> left", ;
      "     ==   identical on both sides (listed, nothing to copy)", ;
      "", ;
      "  F4   Compare", ;
      "  F5   Synchronize (it asks first and says how many files)", ;
      "  Ins / Space / Enter   mark / unmark the row under the cursor", ;
      "  Up/Down, PgUp/PgDn, Home/End   move inside the table", ;
      "  Alt-F   the mask (FileSpec)", ;
      "  Alt-S   Only selected    Alt-A   Asymmetric", ;
      "  Alt-C   By content      Alt-I   Ignore date", ;
      "  Alt-D   Delete extras   F1      this help", ;
      "  Esc / F10   close and go back to the panels", ;
      "", ;
      "  Show: D duplicates, S singles, L left->right, R right->left and", ;
      "  A all of them. U toggles Subdirs, which is NOT implemented yet:", ;
      "  the box is there so the next batch can fill it in, and until then", ;
      "  the message row says that only the current directories are", ;
      "  compared. The Show filters only change what is SEEN: the", ;
      "  synchronization always uses every row.", ;
      "", ;
      "  Only selected limits the comparison to the entries MARKED in the", ;
      "  active panel of the Commander. Asymmetric only copies left ->", ;
      "  right. By content reads both files when the size matches and the", ;
      "  date does not, and hides the pairs that are the same file.", ;
      "  Delete extras DELETES the names that exist on one side only", ;
      "  instead of copying them over: it is off at the start, and the", ;
      "  summary row always says how many files it would delete.", ;
      "", ;
      "  A destination that already exists asks with the seven buttons of", ;
      "  Copy (Replace, Replace All, Skip, Cancel, Replace Older, Skip", ;
      "  All, Rename). Without a marked row Synchronize acts on every", ;
      "  actionable row, and nothing is touched without the confirmation." }
   UiTextWin( a, "Synchronize directories" )
RETURN

/* -------------------------------------------------------------- S19 keys ---- */

STATIC PROCEDURE HcSyncScreen()
   LOCAL st := HcSyncState( HcPanel( HC_PANEL_L )[ HC_P_DIR ], HcPanel( HC_PANEL_R )[ HC_P_DIR ] )
   LOCAL nKey, nShift, cAlt, lLeave := .F., lFull := .T., nOld, nOldTop, cOldCur, aIn
   cOldCur := SetCursor( 0 )
   DO WHILE ! lLeave
      IF lFull
         HcSyncPaint( st )
         lFull := .F.
      ENDIF
      nKey := Inkey( 0.05 )
      /* the ALT state has to be read right after Inkey() (measured: this
       * GTWVG hands Alt+<letter> over as the plain letter plus this state) */
      nShift := HcShiftState()
      cAlt := HcAltLetter( nKey, nShift )
      /* right-click-esc (S1/S2/S7): a plain right click leaves the
       * Synchronize screen, the same as Esc */
      IF nKey == 0 .AND. HcMouseRightClick()
         nKey := K_ESC
      ENDIF
      IF nKey == 0
         /* S31: no key, so the mouse gets its turn. A click resolves to the
          * control it hit and becomes the SAME input the keyboard produces, so
          * the whole DO CASE below is the only place where an option acts. */
         aIn := HcSyncMouseInput( st )
         IF ! Empty( aIn )
            nKey := aIn[ 1 ]
            IF ! Empty( aIn[ 2 ] )
               cAlt := aIn[ 2 ]
            ENDIF
         ENDIF
      ENDIF
      nOld := st[ SC_SEL ]
      nOldTop := st[ SC_TOP ]
      DO CASE
      CASE nKey == K_ESC .OR. nKey == K_F10
         lLeave := .T.
      CASE nKey == K_F1
         HcSyncHelp()
         lFull := .T.
      CASE nKey == K_F4
         HcSyncCompare( st )
         lFull := .T.
      CASE nKey == K_F5
         HcSyncRun( st )
         lFull := .T.
      CASE nKey == K_UP
         IF HcSyncMove( st, -1 )
            HcSyncPaintMoved( st, nOld, nOldTop )
         ENDIF
      CASE nKey == K_DOWN
         IF HcSyncMove( st, 1 )
            HcSyncPaintMoved( st, nOld, nOldTop )
         ENDIF
      CASE nKey == K_PGUP
         IF HcSyncMove( st, -SY_VIS )
            HcSyncPaint( st )
         ENDIF
      CASE nKey == K_PGDN
         IF HcSyncMove( st, SY_VIS )
            HcSyncPaint( st )
         ENDIF
      CASE nKey == K_HOME
         IF HcSyncMove( st, -Len( st[ SC_VIEW ] ) )
            HcSyncPaint( st )
         ENDIF
      CASE nKey == K_END
         IF HcSyncMove( st, Len( st[ SC_VIEW ] ) )
            HcSyncPaint( st )
         ENDIF
      CASE nKey == K_INS .OR. nKey == K_SPACE .OR. nKey == K_ENTER
         IF HcSyncToggleMark( st )
            HcSyncCount( st )
            HcSyncPaintMarked( st )
         ENDIF
      CASE ! Empty( cAlt )
         HcSyncAlt( st, cAlt, @lFull )
      CASE nKey >= 65 .AND. nKey <= 90 .OR. nKey >= 97 .AND. nKey <= 122
         IF HcSyncFilter( st, Upper( Chr( nKey ) ) )
            lFull := .T.
         ENDIF
      ENDCASE
   ENDDO
   SetCursor( cOldCur )
   SetColor( UI_C_DESKTOP )
RETURN

/* =====================================================================
 *  Compare by content (S2, S3, S5, S8, S11): pure core
 *
 *  No window and no disk here: the screen of T3 paints what these functions
 *  return and the headless bank of T2 checks them. The diff model of
 *  HcCmpRows() has one row per line of BOTH files, in file order, so a side
 *  is painted by walking the rows that carry a left (or right) line number.
 *
 *  The helpers at the end of the section (collapse, range, anchor, LCS, pair,
 *  span, kind, file/marked test, counts) are internal to it; they are plain
 *  FUNCTIONs because this file keeps STATIC for the screen state only.
 * ===================================================================== */

/* TAB -> four spaces (S4). It is the only transformation the diff, the pad and
 * the mark share, so a mark computed on it lands on the cell that is painted. */
FUNCTION HcCmpExpand( cText )
   IF ValType( cText ) != "C"
      RETURN ""
   ENDIF
RETURN StrTran( cText, Chr( 9 ), Space( 4 ) )

/* Alt-W (S7): trim both ends and collapse every run of spaces into ONE. It is
 * written by hand because hb_ATokens() only drops the empty pieces of a run
 * with a flag, and the rule here has to be exact and independent of it. */
FUNCTION HcCmpCollapse( cLine )
   LOCAL cIn := HcCmpExpand( cLine ), cOut := "", lSpace := .F., i, c
   FOR i := 1 TO Len( cIn )
      c := SubStr( cIn, i, 1 )
      IF c == " "
         IF ! lSpace
            cOut += " "
            lSpace := .T.
         ENDIF
      ELSE
         cOut += c
         lSpace := .F.
      ENDIF
   NEXT
RETURN AllTrim( cOut )

/* Normalized form of one line, the only thing the diff compares. White space
 * first and case second, so the two flags of S7 stay independent. */
FUNCTION HcCmpNormalize( cLine, lIgnoreCase, lIgnoreWs )
   LOCAL c := HcCmpExpand( cLine )
   IF lIgnoreWs == .T.
      c := HcCmpCollapse( c )
   ENDIF
   IF lIgnoreCase == .T.
      c := Upper( c )
   ENDIF
RETURN c

/* Diff of two arrays of lines (S5/S6). The result covers every line of both
 * files exactly once and in file order: the rows with HC_CMR_L > 0 carry left
 * lines 1..N ascending and the rows with HC_CMR_R > 0 carry right lines 1..M
 * ascending, which is what lets the screen paint one side on its own. */
FUNCTION HcCmpRows( aLeft, aRight, lIgnoreCase, lIgnoreWs )
   LOCAL aL := {}, aR := {}, aNL := {}, aNR := {}, aRows := {}, i
   FOR i := 1 TO iif( HB_ISARRAY( aLeft ), Len( aLeft ), 0 )
      AAdd( aL, iif( ValType( aLeft[ i ] ) == "C", aLeft[ i ], "" ) )
   NEXT
   FOR i := 1 TO iif( HB_ISARRAY( aRight ), Len( aRight ), 0 )
      AAdd( aR, iif( ValType( aRight[ i ] ) == "C", aRight[ i ], "" ) )
   NEXT
   FOR i := 1 TO Len( aL )
      AAdd( aNL, HcCmpNormalize( aL[ i ], lIgnoreCase, lIgnoreWs ) )
   NEXT
   FOR i := 1 TO Len( aR )
      AAdd( aNR, HcCmpNormalize( aR[ i ], lIgnoreCase, lIgnoreWs ) )
   NEXT
   HcCmpRange( aNL, aNR, 1, Len( aL ), 1, Len( aR ), aRows, 0 )
   /* a run of removals followed by a run of additions is the same edit seen
    * from both sides: it becomes one change per pair, so ~ counts lines */
   aRows := HcCmpPair( aRows )
   /* the marked span of a change is measured on the RAW expanded lines (the
    * normalized one would not map back to columns) */
   HcCmpSpan( aRows, aL, aR, lIgnoreCase )
RETURN aRows

/* One range of the recursion: equal top, buffered equal bottom, then the
 * middle as an anchor split, an LCS or a plain block of removals + additions. */
PROCEDURE HcCmpRange( aNL, aNR, nL1, nL2, nR1, nR2, aOut, nDepth )
   LOCAL aTail := {}, aAnc := {}, i
   /* (a) the equal lines at the top are equal on both sides */
   DO WHILE nL1 <= nL2 .AND. nR1 <= nR2 .AND. aNL[ nL1 ] == aNR[ nR1 ]
      AAdd( aOut, { HC_CMP_EQ, nL1, nR1, 0, 0, 0, 0 } )
      nL1++
      nR1++
   ENDDO
   /* (b) the equal lines at the bottom are buffered BACKWARDS and appended
    * after the middle, so the row order follows both files */
   DO WHILE nL1 <= nL2 .AND. nR1 <= nR2 .AND. aNL[ nL2 ] == aNR[ nR2 ]
      AAdd( aTail, { HC_CMP_EQ, nL2, nR2, 0, 0, 0, 0 } )
      nL2--
      nR2--
   ENDDO
   IF nL1 > nL2
      /* (c) the left side is exhausted: the rest of the right is an addition */
      FOR i := nR1 TO nR2
         AAdd( aOut, { HC_CMP_ADD, 0, i, 0, 0, 0, 0 } )
      NEXT
   ELSEIF nR1 > nR2
      FOR i := nL1 TO nL2
         AAdd( aOut, { HC_CMP_DEL, i, 0, 0, 0, 0, 0 } )
      NEXT
   ELSE
      IF nDepth < 64
         /* (d) a line that appears exactly ONCE on each side is a safe anchor:
          * what surrounds it is a diff of its own, so a small change in the
          * middle of a big file costs a small diff instead of a whole block */
         aAnc := HcCmpAnchor( aNL, aNR, nL1, nL2, nR1, nR2 )
      ENDIF
      IF ! Empty( aAnc )
         HcCmpRange( aNL, aNR, nL1, aAnc[ 1 ] - 1, nR1, aAnc[ 2 ] - 1, aOut, nDepth + 1 )
         AAdd( aOut, { HC_CMP_EQ, aAnc[ 1 ], aAnc[ 2 ], 0, 0, 0, 0 } )
         HcCmpRange( aNL, aNR, aAnc[ 1 ] + 1, nL2, aAnc[ 2 ] + 1, nR2, aOut, nDepth + 1 )
      ELSEIF nDepth < 64 .AND. ( nL2 - nL1 + 1 ) * ( nR2 - nR1 + 1 ) <= 40000
         /* (e) a middle small enough for the exact LCS: it produces the
          * shortest diff and its cost is bounded by the 40000 cells */
         HcCmpLcs( aNL, aNR, nL1, nL2, nR1, nR2, aOut )
      ELSE
         /* (f) too big or too deep: one block of removals and one of additions
          * (the 64 levels of recursion keep a pathological input off the
          * stack). The pairing step turns them into changes. */
         FOR i := nL1 TO nL2
            AAdd( aOut, { HC_CMP_DEL, i, 0, 0, 0, 0, 0 } )
         NEXT
         FOR i := nR1 TO nR2
            AAdd( aOut, { HC_CMP_ADD, 0, i, 0, 0, 0, 0 } )
         NEXT
      ENDIF
   ENDIF
   /* (g) the buffered tail comes back in forward order */
   FOR i := Len( aTail ) TO 1 STEP -1
      AAdd( aOut, aTail[ i ] )
   NEXT
RETURN

/* The anchor of a range: the FIRST line of the left range that appears exactly
 * once in that left range and exactly once in the right range, with the right
 * line it matches. {} when there is no such line. */
FUNCTION HcCmpAnchor( aNL, aNR, nL1, nL2, nR1, nR2 )
   LOCAL i, j, nLeft, nRight, nAt
   FOR i := nL1 TO nL2
      nLeft := 0
      FOR j := nL1 TO nL2
         IF aNL[ j ] == aNL[ i ]
            nLeft++
            IF nLeft > 1
               EXIT
            ENDIF
         ENDIF
      NEXT
      IF nLeft == 1
         nRight := 0
         nAt := 0
         FOR j := nR1 TO nR2
            IF aNR[ j ] == aNL[ i ]
               nRight++
               IF nRight > 1
                  EXIT
               ENDIF
               nAt := j
            ENDIF
         NEXT
         IF nRight == 1
            RETURN { i, nAt }
         ENDIF
      ENDIF
   NEXT
RETURN {}

/* (e) Exact LCS of one range, walked forward so the rows keep the order of
 * both files. The matrix is the length of the LCS of the SUFFIXES, so the walk
 * can decide without backtracking over the whole table. */
PROCEDURE HcCmpLcs( aNL, aNR, nL1, nL2, nR1, nR2, aOut )
   LOCAL n := nL2 - nL1 + 1, m := nR2 - nR1 + 1, aD, i, j
   aD := Array( n + 1, m + 1 )
   /* Array() leaves NILs behind: every cell is written before it is read */
   FOR i := 1 TO n + 1
      FOR j := 1 TO m + 1
         aD[ i ][ j ] := 0
      NEXT
   NEXT
   FOR i := n TO 1 STEP -1
      FOR j := m TO 1 STEP -1
         IF aNL[ nL1 + i - 1 ] == aNR[ nR1 + j - 1 ]
            aD[ i ][ j ] := aD[ i + 1 ][ j + 1 ] + 1
         ELSE
            aD[ i ][ j ] := Max( aD[ i + 1 ][ j ], aD[ i ][ j + 1 ] )
         ENDIF
      NEXT
   NEXT
   i := 1
   j := 1
   DO WHILE i <= n .AND. j <= m
      IF aNL[ nL1 + i - 1 ] == aNR[ nR1 + j - 1 ]
         AAdd( aOut, { HC_CMP_EQ, nL1 + i - 1, nR1 + j - 1, 0, 0, 0, 0 } )
         i++
         j++
      ELSEIF aD[ i + 1 ][ j ] >= aD[ i ][ j + 1 ]
         AAdd( aOut, { HC_CMP_DEL, nL1 + i - 1, 0, 0, 0, 0, 0 } )
         i++
      ELSE
         AAdd( aOut, { HC_CMP_ADD, 0, nR1 + j - 1, 0, 0, 0, 0 } )
         j++
      ENDIF
   ENDDO
   DO WHILE i <= n
      AAdd( aOut, { HC_CMP_DEL, nL1 + i - 1, 0, 0, 0, 0, 0 } )
      i++
   ENDDO
   DO WHILE j <= m
      AAdd( aOut, { HC_CMP_ADD, 0, nR1 + j - 1, 0, 0, 0, 0 } )
      j++
   ENDDO
RETURN

/* Every maximal run of removals IMMEDIATELY followed by a run of additions
 * becomes one change per pair; the k-th removed line pairs with the k-th added
 * one and the leftovers stay as they are, so the run keeps its position and
 * both files stay ordered. */
FUNCTION HcCmpPair( aRows )
   LOCAL aOut := {}, i := 1, j, k, nDel, nAdd, nPair, n
   DO WHILE i <= Len( aRows )
      IF HcCmpKind( aRows[ i ] ) != HC_CMP_DEL
         AAdd( aOut, aRows[ i ] )
         i++
         LOOP
      ENDIF
      j := i
      DO WHILE j <= Len( aRows ) .AND. HcCmpKind( aRows[ j ] ) == HC_CMP_DEL
         j++
      ENDDO
      nDel := j - i
      k := j
      DO WHILE k <= Len( aRows ) .AND. HcCmpKind( aRows[ k ] ) == HC_CMP_ADD
         k++
      ENDDO
      nAdd := k - j
      IF nAdd == 0
         FOR n := i TO j - 1
            AAdd( aOut, aRows[ n ] )
         NEXT
      ELSE
         nPair := Min( nDel, nAdd )
         FOR n := 1 TO nPair
            AAdd( aOut, { HC_CMP_CHG, aRows[ i + n - 1 ][ HC_CMR_L ], ;
                          aRows[ j + n - 1 ][ HC_CMR_R ], 0, 0, 0, 0 } )
         NEXT
         FOR n := nPair + 1 TO nDel
            AAdd( aOut, aRows[ i + n - 1 ] )
         NEXT
         FOR n := nPair + 1 TO nAdd
            AAdd( aOut, aRows[ j + n - 1 ] )
         NEXT
      ENDIF
      i := k
   ENDDO
RETURN aOut

/* Equal leading/trailing CHARACTER counts of every change, measured on the raw
 * expanded lines and compared case-insensitively when Alt-C is on. The same
 * two counts describe both sides (they are the characters the two lines share),
 * so the screen can mark each side with its own copy. */
PROCEDURE HcCmpSpan( aRows, aL, aR, lIgnoreCase )
   LOCAL i, cA, cB, nMax, nPfx, nSfx
   FOR i := 1 TO Len( aRows )
      IF HcCmpKind( aRows[ i ] ) == HC_CMP_CHG
         cA := HcCmpExpand( aL[ aRows[ i ][ HC_CMR_L ] ] )
         cB := HcCmpExpand( aR[ aRows[ i ][ HC_CMR_R ] ] )
         IF lIgnoreCase == .T.
            cA := Upper( cA )
            cB := Upper( cB )
         ENDIF
         nMax := Min( Len( cA ), Len( cB ) )
         nPfx := 0
         DO WHILE nPfx < nMax .AND. SubStr( cA, nPfx + 1, 1 ) == SubStr( cB, nPfx + 1, 1 )
            nPfx++
         ENDDO
         nSfx := 0
         /* the suffix can never reach the prefix: the two spans must not
          * overlap or the marked middle would be empty on one side */
         DO WHILE nSfx < nMax - nPfx .AND. ;
                 SubStr( cA, Len( cA ) - nSfx, 1 ) == SubStr( cB, Len( cB ) - nSfx, 1 )
            nSfx++
         ENDDO
         aRows[ i ][ HC_CMR_LPFX ] := nPfx
         aRows[ i ][ HC_CMR_LSFX ] := nSfx
         aRows[ i ][ HC_CMR_RPFX ] := nPfx
         aRows[ i ][ HC_CMR_RSFX ] := nSfx
      ENDIF
   NEXT
RETURN

/* Maximal runs of consecutive non-equal rows as { first, last } index pairs
 * into aRows; {} when there is nothing to show (S8: <N> of the summary). */
FUNCTION HcCmpBlocks( aRows )
   LOCAL aOut := {}, nFirst := 0, i
   IF ! HB_ISARRAY( aRows )
      RETURN aOut
   ENDIF
   FOR i := 1 TO Len( aRows )
      IF HcCmpKind( aRows[ i ] ) == HC_CMP_EQ
         IF nFirst > 0
            AAdd( aOut, { nFirst, i - 1 } )
            nFirst := 0
         ENDIF
      ELSEIF nFirst == 0
         nFirst := i
      ENDIF
   NEXT
   IF nFirst > 0
      AAdd( aOut, { nFirst, Len( aRows ) } )
   ENDIF
RETURN aOut

/* { equal, removed, added, changed, blocks }, the counts of S8 */
FUNCTION HcCmpStat( aRows )
   LOCAL aSt := { 0, 0, 0, 0, 0 }, i, nKind
   IF ! HB_ISARRAY( aRows )
      RETURN aSt
   ENDIF
   FOR i := 1 TO Len( aRows )
      nKind := HcCmpKind( aRows[ i ] )
      DO CASE
      CASE nKind == HC_CMP_EQ
         aSt[ 1 ] += 1
      CASE nKind == HC_CMP_DEL
         aSt[ 2 ] += 1
      CASE nKind == HC_CMP_ADD
         aSt[ 3 ] += 1
      CASE nKind == HC_CMP_CHG
         aSt[ 4 ] += 1
      ENDCASE
   NEXT
   aSt[ 5 ] := Len( HcCmpBlocks( aRows ) )
RETURN aSt

/* The rows the screen paints (S5/S6). One entry per diff row, two for a change
 * in the unified view, and one fold entry in place of the middle of a long run
 * of equal rows when `Only differences` is on. */
FUNCTION HcCmpView( aRows, lOnlyDiff, nContext, lUnified )
   LOCAL aFull := {}, aOut := {}, i, j, n, nCtx, nRun, nHid
   IF ! HB_ISARRAY( aRows )
      RETURN aOut
   ENDIF
   FOR i := 1 TO Len( aRows )
      AAdd( aFull, { HC_CMPV_ROW, i, 0 } )
      IF lUnified == .T. .AND. HcCmpKind( aRows[ i ] ) == HC_CMP_CHG
         AAdd( aFull, { HC_CMPV_ROW2, i, 0 } )
      ENDIF
   NEXT
   IF lOnlyDiff != .T.
      RETURN aFull
   ENDIF
   nCtx := iif( ValType( nContext ) == "N", Max( 0, nContext ), 0 )
   i := 1
   DO WHILE i <= Len( aFull )
      IF HcCmpKind( aRows[ aFull[ i ][ HC_CMPV_IDX ] ] ) != HC_CMP_EQ
         AAdd( aOut, aFull[ i ] )
         i++
         LOOP
      ENDIF
      j := i
      DO WHILE j <= Len( aFull ) .AND. ;
               HcCmpKind( aRows[ aFull[ j ][ HC_CMPV_IDX ] ] ) == HC_CMP_EQ
         j++
      ENDDO
      nRun := j - i
      IF nRun > 2 * nCtx + 1
         /* keep nContext rows at each end and hide the middle in ONE row; the
          * fold reports the LAST hidden row so a fold can be re-expanded */
         FOR n := i TO i + nCtx - 1
            AAdd( aOut, aFull[ n ] )
         NEXT
         nHid := nRun - 2 * nCtx
         AAdd( aOut, { HC_CMPV_FOLD, aFull[ i + nCtx + nHid - 1 ][ HC_CMPV_IDX ], nHid } )
         FOR n := j - nCtx TO j - 1
            AAdd( aOut, aFull[ n ] )
         NEXT
      ELSE
         FOR n := i TO j - 1
            AAdd( aOut, aFull[ n ] )
         NEXT
      ENDIF
      i := j
   ENDDO
RETURN aOut

/* The pair of files of S2: the entry under the cursor of the active panel and,
 * on the other panel, the first MARKED file or, with nothing marked, the first
 * entry with the same name (case-insensitively, like the rest of the manager).
 * A directory, `..` and an empty entry are never a candidate. nDstSel is taken
 * for symmetry with the two panels; the rule does not depend on that cursor. */
FUNCTION HcCmpPick( aSrcList, nSrcSel, aDstList, nDstSel )
   LOCAL cSrc := "", cDst := "", i
   IF HB_ISARRAY( aSrcList ) .AND. ValType( nSrcSel ) == "N" .AND. ;
      nSrcSel >= 1 .AND. nSrcSel <= Len( aSrcList ) .AND. HcCmpIsFile( aSrcList[ nSrcSel ] )
      cSrc := aSrcList[ nSrcSel ][ HC_E_NAME ]
   ENDIF
   IF Empty( cSrc )
      RETURN { "", "", "nofile" }
   ENDIF
   IF HB_ISARRAY( aDstList )
      FOR i := 1 TO Len( aDstList )
         IF HcCmpMarked( aDstList[ i ] )
            cDst := aDstList[ i ][ HC_E_NAME ]
            EXIT
         ENDIF
      NEXT
      IF Empty( cDst )
         FOR i := 1 TO Len( aDstList )
            IF HcCmpIsFile( aDstList[ i ] ) .AND. ;
               Upper( aDstList[ i ][ HC_E_NAME ] ) == Upper( cSrc )
               cDst := aDstList[ i ][ HC_E_NAME ]
               EXIT
            ENDIF
         NEXT
      ENDIF
   ENDIF
   IF Empty( cDst )
      RETURN { cSrc, "", "notfound" }
   ENDIF
RETURN { cSrc, cDst, "" }

/* .T. when the entry can be compared: a listed file, not a directory, not the
 * parent entry and not an empty name. */
FUNCTION HcCmpIsFile( aEntry )
   LOCAL cName
   IF ! HB_ISARRAY( aEntry ) .OR. Len( aEntry ) < HC_E_ATTR
      RETURN .F.
   ENDIF
   IF ValType( aEntry[ HC_E_NAME ] ) != "C"
      RETURN .F.
   ENDIF
   cName := aEntry[ HC_E_NAME ]
   IF Empty( cName ) .OR. cName == ".."
      RETURN .F.
   ENDIF
   IF ValType( aEntry[ HC_E_ATTR ] ) == "C" .AND. "D" $ Upper( aEntry[ HC_E_ATTR ] )
      RETURN .F.
   ENDIF
RETURN .T.

/* .T. when the entry is a marked file: a mark on a directory never counts */
FUNCTION HcCmpMarked( aEntry )
   IF ! HcCmpIsFile( aEntry ) .OR. Len( aEntry ) < HC_E_MARK
      RETURN .F.
   ENDIF
   IF ValType( aEntry[ HC_E_MARK ] ) != "L"
      RETURN .F.
   ENDIF
RETURN aEntry[ HC_E_MARK ]

/* .T. when the two paths are the same file (S3: `Both sides are the same
 * file.`). HcNormPath() resolves `.`/`..` textually and uppercases. */
FUNCTION HcCmpSame( cA, cB )
   IF ValType( cA ) != "C" .OR. ValType( cB ) != "C" .OR. Empty( cA ) .OR. Empty( cB )
      RETURN .F.
   ENDIF
RETURN Upper( HcNormPath( cA ) ) == Upper( HcNormPath( cB ) )

/* The nW cells of one line that start at offset nOff, TAB expanded and padded
 * with spaces: the screen paints a line without splitting it (S4). */
FUNCTION HcCmpPad( cText, nW, nOff )
   LOCAL c
   IF ValType( nW ) != "N" .OR. nW <= 0
      RETURN ""
   ENDIF
   c := HcCmpExpand( cText )
   nOff := HcCmpNonNeg( nOff )
   IF nOff >= Len( c )
      RETURN Space( nW )
   ENDIF
   c := SubStr( c, nOff + 1 )
   /* PadR() pads but does not cut, so the width is enforced here */
RETURN PadR( Left( c, nW ), nW )

/* The differing span of a changed line, in 1-BASED columns of the nW-wide
 * window that starts at offset nOff: { start, length }, or { 0, 0 } when the
 * span is empty or none of it is visible (S5: nothing is marked then). */
FUNCTION HcCmpMark( cText, nOff, nW, nPfx, nSfx )
   LOCAL nLen, nA, nB, nS, nE, nFrom
   IF ValType( nW ) != "N" .OR. nW <= 0
      RETURN { 0, 0 }
   ENDIF
   nLen := Len( HcCmpExpand( cText ) )
   nA := HcCmpNonNeg( nPfx ) + 1          /* first differing column       */
   nB := nLen - HcCmpNonNeg( nSfx )       /* last differing column        */
   IF nB < nA
      RETURN { 0, 0 }                     /* the two lines share it all   */
   ENDIF
   nFrom := HcCmpNonNeg( nOff )
   nS := Max( nA, nFrom + 1 )             /* clip to the visible window   */
   nE := Min( nB, nFrom + nW )
   IF nE < nS
      RETURN { 0, 0 }
   ENDIF
RETURN { nS - nFrom, nE - nS + 1 }

/* The summary row of S8, format fixed and tested:
 * "<blocks> difference(s)   +<add> -<del> ~<chg>   identical <eq>/<rows>" */
FUNCTION HcCmpSummary( aRows )
   LOCAL aSt := HcCmpStat( aRows )
RETURN HcCmpCount( aSt[ 5 ] ) + " difference(s)   +" + HcCmpCount( aSt[ 3 ] ) + ;
       " -" + HcCmpCount( aSt[ 2 ] ) + " ~" + HcCmpCount( aSt[ 4 ] ) + ;
       "   identical " + HcCmpCount( aSt[ 1 ] ) + "/" + ;
       HcCmpCount( iif( HB_ISARRAY( aRows ), Len( aRows ), 0 ) )

/* Kind of one row of the diff model, 0 when the row is not one (the API may be
 * called with anything: the screen hands over what it keeps in its state) */
FUNCTION HcCmpKind( aRow )
   IF ! HB_ISARRAY( aRow ) .OR. Len( aRow ) < HC_CMR_KIND
      RETURN 0
   ENDIF
   IF ValType( aRow[ HC_CMR_KIND ] ) != "N"
      RETURN 0
   ENDIF
RETURN aRow[ HC_CMR_KIND ]

/* a count that must never be negative and may arrive NIL or empty */
FUNCTION HcCmpNonNeg( nVal )
   IF ValType( nVal ) != "N" .OR. nVal < 0
      RETURN 0
   ENDIF
RETURN nVal

/* a number as it is painted in the summary: no leading blanks */
FUNCTION HcCmpCount( nVal )
RETURN LTrim( Str( HcCmpNonNeg( nVal ) ) )

/* =====================================================================
 *  Compare by content (S1..S9): the screen
 *
 *  There is no disk here: the screen paints the two buffers HcCompare() has
 *  already read (F5 re-reads them) and the models of the pure core above.
 *  Everything is derived from UiRows()/UiCols()/MaxRow()/MaxCol(); the
 *  clickable chips register themselves while they are painted (the rule of
 *  S31) and the key loop is the ONLY place where an option acts.
 * ===================================================================== */

/* the MARGIN BAR colour of one kind of diff row (S5, L6/L7): the word copy of
 * a line is never painted with it, the bar of 1 cell is what carries it */
FUNCTION HcCmpKindColor( nKind )
   DO CASE
   CASE nKind == HC_CMP_DEL
      RETURN UI_C_CMPMRKD
   CASE nKind == HC_CMP_ADD
      RETURN UI_C_CMPMRKA
   CASE nKind == HC_CMP_CHG
      RETURN UI_C_CMPMRKC
   ENDCASE
RETURN UI_C_CMPBODY

/* the side of a row that has no line (DEL has no right, ADD has no left):
 * plain body text, never a highlight */
FUNCTION HcCmpEmptyColor()
RETURN UI_C_CMPBODY

/* the text of a folded run of equal rows (S7) */
FUNCTION HcCmpFoldText( nHidden )
   LOCAL n := iif( ValType( nHidden ) == "N", nHidden, 0 )
   IF n <= 0
      RETURN ""
   ENDIF
RETURN LTrim( Str( n ) ) + " unchanged line" + iif( n == 1, "", "s" )

/* The block a F7/F8 jump lands on: with nDir > 0 the FIRST block that starts
 * AFTER the current row, with nDir < 0 the LAST one that starts BEFORE it.
 * 1-based position inside aBlocks (from HcCmpBlocks()), 0 when there is none. */
FUNCTION HcCmpBlockAt( aBlocks, nRowIdx, nDir )
   LOCAL i, nAt := 0
   IF ! HB_ISARRAY( aBlocks ) .OR. ValType( nRowIdx ) != "N" .OR. ValType( nDir ) != "N"
      RETURN 0
   ENDIF
   IF nDir > 0
      FOR i := 1 TO Len( aBlocks )
         IF aBlocks[ i ][ 1 ] > nRowIdx
            RETURN i
         ENDIF
      NEXT
   ELSEIF nDir < 0
      FOR i := 1 TO Len( aBlocks )
         IF aBlocks[ i ][ 1 ] < nRowIdx
            nAt := i
         ENDIF
      NEXT
   ENDIF
RETURN nAt

/* the chips of the keys bar, in the order they are painted */
FUNCTION HcCmpKeys()
RETURN { { "F1", "Help" }, { "F7", "Prev" }, { "F8", "Next" }, ;
         { "Tab", "Side" }, { "Ctrl-O", "View" }, ;
         { "F5", "Reload" }, { "Esc", "Close" } }

/* the summary row of S8: the counts plus the mode it is showing */
FUNCTION HcCmpSummaryLine( aRows, lUnified )
RETURN HcCmpSummary( aRows ) + iif( lUnified == .T., "   [Unified]", "   [Split]" )

/* initial state of the screen: the two paths, the two buffers, the four
 * options off (split view), the cursor at the top and no message */
STATIC FUNCTION HcCmpState( cL, cR, aL, aR )
RETURN { cL, cR, aL, aR, .F., .F., .F., .F., {}, {}, 1, 1, 0, 0, "", 0 }

/* Rebuilds both models out of the buffers already in memory (option changes)
 * and keeps the top row when the new model still has it. */
STATIC PROCEDURE HcCmpRecompare( st )
   LOCAL nTop := st[ CM_TOP ]
   st[ CM_ROWS ] := HcCmpRows( st[ CM_LLINES ], st[ CM_RLINES ], st[ CM_LCASE ], st[ CM_LWS ] )
   st[ CM_VIEW ] := HcCmpView( st[ CM_ROWS ], st[ CM_LDIFF ], HC_CP_CTX, st[ CM_LUNI ] )
   st[ CM_TOP ] := Max( 1, Min( nTop, Max( 1, Len( st[ CM_VIEW ] ) ) ) )
   HcCmpFixTop( st )
   st[ CM_BLOCK ] := 0
RETURN

/* keeps the first visible row inside the model */
STATIC PROCEDURE HcCmpFixTop( st )
   LOCAL nVis := HC_CP_LAST - HC_CP_FIRST + 1
   IF st[ CM_TOP ] > Len( st[ CM_VIEW ] ) - nVis + 1
      st[ CM_TOP ] := Len( st[ CM_VIEW ] ) - nVis + 1
   ENDIF
   IF st[ CM_TOP ] < 1
      st[ CM_TOP ] := 1
   ENDIF
RETURN

/* moves the window; .T. when the first visible row really changed */
STATIC FUNCTION HcCmpScroll( st, nDelta )
   LOCAL nVis := HC_CP_LAST - HC_CP_FIRST + 1
   LOCAL nOld := st[ CM_TOP ], nMax := Max( 1, Len( st[ CM_VIEW ] ) - nVis + 1 )
   st[ CM_TOP ] := Max( 1, Min( nOld + nDelta, nMax ) )
RETURN st[ CM_TOP ] != nOld

/* the view row that paints a diff row (a fold never hides a difference) */
STATIC FUNCTION HcCmpViewAt( aView, nIdx )
   LOCAL i, aV
   FOR i := 1 TO Len( aView )
      aV := aView[ i ]
      IF aV[ HC_CMPV_KIND ] != HC_CMPV_FOLD .AND. aV[ HC_CMPV_IDX ] == nIdx
         RETURN i
      ENDIF
   NEXT
RETURN 0

/* F7/F8: jump to the previous (nDir < 0) or next block of differences and
 * announce it in the message row (S8) */
STATIC FUNCTION HcCmpJump( st, nDir )
   LOCAL aBlocks := HcCmpBlocks( st[ CM_ROWS ] ), nCur := 0, nPos, nView
   IF Empty( aBlocks ) .OR. Empty( st[ CM_VIEW ] )
      RETURN .F.
   ENDIF
   IF st[ CM_TOP ] >= 1 .AND. st[ CM_TOP ] <= Len( st[ CM_VIEW ] )
      /* the fold reports its LAST hidden row, which is what the next block
       * has to be compared against */
      nCur := st[ CM_VIEW ][ st[ CM_TOP ] ][ HC_CMPV_IDX ]
   ENDIF
   nPos := HcCmpBlockAt( aBlocks, nCur, nDir )
   IF nPos == 0
      RETURN .F.
   ENDIF
   nView := HcCmpViewAt( st[ CM_VIEW ], aBlocks[ nPos ][ 1 ] )
   IF nView == 0
      RETURN .F.
   ENDIF
   st[ CM_BLOCK ] := nPos
   st[ CM_TOP ] := nView
   HcCmpFixTop( st )
   st[ CM_MSG ] := "Difference " + LTrim( Str( nPos ) ) + " of " + ;
                   LTrim( Str( Len( aBlocks ) ) )
RETURN .T.

/* Left/Right: the horizontal offset of the ACTIVE side; .T. when it moved */
STATIC FUNCTION HcCmpOff( st, nDelta )
   LOCAL nOld
   IF st[ CM_SIDE ] == 1
      nOld := st[ CM_OFFL ]
      st[ CM_OFFL ] := Max( 0, nOld + nDelta )
      RETURN st[ CM_OFFL ] != nOld
   ENDIF
   nOld := st[ CM_OFFR ]
   st[ CM_OFFR ] := Max( 0, nOld + nDelta )
RETURN st[ CM_OFFR ] != nOld

/* the four option chips of S7 (they toggle and RECOMPUTE, never re-read) */
STATIC PROCEDURE HcCmpAlt( st, cLetter, lRedraw )
   DO CASE
   CASE cLetter == "C"
      st[ CM_LCASE ] := ! st[ CM_LCASE ]
   CASE cLetter == "W"
      st[ CM_LWS ] := ! st[ CM_LWS ]
   CASE cLetter == "D"
      st[ CM_LDIFF ] := ! st[ CM_LDIFF ]
   CASE cLetter == "V"
      st[ CM_LUNI ] := ! st[ CM_LUNI ]
   OTHERWISE
      RETURN
   ENDCASE
   HcCmpRecompare( st )
   lRedraw := .T.
RETURN

/* F5: read both files again and compare (the panels are not touched: this is
 * a read-only screen) */
STATIC PROCEDURE HcCmpReload( st )
   LOCAL aL := HcReadText( st[ CM_LFILE ] ), aR := HcReadText( st[ CM_RFILE ] )
   LOCAL nTop := st[ CM_TOP ]
   IF ! aL[ 1 ]
      st[ CM_MSG ] := "Reload failed: cannot read " + hb_FNameNameExt( st[ CM_LFILE ] )
      RETURN
   ENDIF
   IF ! aR[ 1 ]
      st[ CM_MSG ] := "Reload failed: cannot read " + hb_FNameNameExt( st[ CM_RFILE ] )
      RETURN
   ENDIF
   st[ CM_LLINES ] := aL[ 2 ]
   st[ CM_RLINES ] := aR[ 2 ]
   HcCmpRecompare( st )
   st[ CM_TOP ] := Max( 1, Min( nTop, Max( 1, Len( st[ CM_VIEW ] ) ) ) )
   HcCmpFixTop( st )
   st[ CM_MSG ] := "Reloaded."
RETURN

/* a path that does not fit is cut from the LEFT, so the file name stays
 * readable (the convention of HcCmdPrompt) */
STATIC FUNCTION HcCmpTail( cText, nW )
   IF ValType( cText ) != "C"
      RETURN Space( Max( 0, nW ) )
   ENDIF
   IF nW < 4 .OR. Len( cText ) <= nW
      RETURN Left( cText, nW )
   ENDIF
RETURN "..." + Right( cText, nW - 3 )

/* a text centred in nW cells (the row of a folded run) */
STATIC FUNCTION HcCmpCentre( cText, nW )
   LOCAL n := Len( cText ), nL
   IF nW <= 0
      RETURN ""
   ENDIF
   IF n >= nW
      RETURN Left( cText, nW )
   ENDIF
   nL := Int( ( nW - n ) / 2 )
RETURN Space( nL ) + cText + Space( nW - nL - n )

/* the visible part of the scroll bar of the last column: { first, size }
 * offsets relative to HC_CP_FIRST, { 0, 0 } when every row fits */
STATIC FUNCTION HcCmpThumb( st )
   LOCAL nVis := HC_CP_LAST - HC_CP_FIRST + 1, nTot := Len( st[ CM_VIEW ] )
   LOCAL nThumb, nFirst
   IF nTot <= nVis
      RETURN { 0, 0 }
   ENDIF
   nThumb := Max( 1, Int( nVis * nVis / nTot ) )
   nFirst := Int( ( st[ CM_TOP ] - 1 ) * ( nVis - nThumb ) / Max( 1, nTot - nVis ) )
RETURN { nFirst, nThumb }

/* S5: the pair of one path of row HC_CP_PATHS. The path of the ACTIVE side is
 * painted in the body pair, so it reads in full black, and the one of the
 * inactive side in the dim pair: that is also the indicator of which side
 * Left/Right scroll (T11) */
STATIC FUNCTION HcCmpPathColor( nSide, nActive )
   IF nSide == nActive
      RETURN UI_C_CMPBODY
   ENDIF
RETURN UI_C_CMPDIM

/* row HC_CP_PATHS on its own, so Tab can repaint ONLY the indicator: it carries
 * no click control, so calling it alone leaves the chip registry of the last
 * full paint exactly as it was (T11). No chips any more (S5/L7): the path of
 * the inactive side goes in the dim pair. A path that does not fit is cut from
 * the LEFT, so the file name stays readable */
STATIC PROCEDURE HcCmpDrawPaths( st )
   SetColor( UI_C_CMPBODY )
   @ HC_CP_PATHS, 0 SAY Space( MaxCol() + 1 )
   SetColor( HcCmpPathColor( 1, st[ CM_SIDE ] ) )
   @ HC_CP_PATHS, 0 SAY PadR( HcCmpTail( st[ CM_LFILE ], HC_CP_LW ), Int( HC_CP_LW ) )
   SetColor( UI_C_CMPDIM )
   @ HC_CP_PATHS, HC_CP_SEP SAY iif( st[ CM_LUNI ] == .T., " ", BP_SEP_VERT )
   SetColor( HcCmpPathColor( 2, st[ CM_SIDE ] ) )
   @ HC_CP_PATHS, HC_CP_RL SAY PadR( HcCmpTail( st[ CM_RFILE ], HC_CP_RW ), Int( HC_CP_RW ) )
   SetColor( UI_C_DESKTOP )
RETURN

/* T11: Tab only switches which side Left/Right scroll, so the only thing that
 * changes on screen is the paths row; repainting just that row gives the
 * feedback at once (a full repaint would also rebuild the chips) */
STATIC PROCEDURE HcCmpPaintPaths( st )
   UiPaintBegin()
   HcCmpDrawPaths( st )
   UiPaintEnd()
RETURN

/* S5/S9: title, the two paths, the header and the rule */
STATIC PROCEDURE HcCmpDrawHead( st )
   LOCAL cL := hb_FNameNameExt( st[ CM_LFILE ] )
   LOCAL cR := hb_FNameNameExt( st[ CM_RFILE ] )
   LOCAL nW := MaxCol() + 1
   /* row HC_CP_TITLE: the cyan chip is the identity row of the screen */
   SetColor( UI_C_CHIP )
   @ HC_CP_TITLE, 0 SAY PadR( Left( "Compare: " + cL + " <-> " + cR, nW ), nW )
   /* row HC_CP_PATHS: painted by its own painter, the one Tab repaints (T11) */
   HcCmpDrawPaths( st )
   /* row HC_CP_HDR: the margin cell first, then the gutter that announces the
    * line numbers and the name; the gutter sits where the numbers sit and the
    * blank cell of HC_CP_GAP keeps the name at the text origin of the rows
    * ("  Ln A.TXT"), and the separator cell is dim too, so the row has no seam */
   SetColor( UI_C_CMPDIM )
   IF st[ CM_LUNI ] == .T.
      @ HC_CP_HDR, 0 SAY PadR( Left( " " + PadL( "Ln", HC_CP_GUT ) + " M " + cL + ;
                                    " -> " + cR, MaxCol() ), MaxCol() )
   ELSE
      @ HC_CP_HDR, 0 SAY Left( PadR( " " + PadL( "Ln", HC_CP_GUT ) + " " + cL, ;
                                    Int( HC_CP_LW ) ), Int( HC_CP_LW ) )
      @ HC_CP_HDR, HC_CP_SEP SAY " "
      @ HC_CP_HDR, HC_CP_RL SAY Left( PadR( " " + PadL( "Ln", HC_CP_GUT ) + " " + cR, ;
                                           Int( HC_CP_RW ) ), Int( HC_CP_RW ) )
   ENDIF
   /* row HC_CP_RULE: the rule of the whole width, with the pane separator */
   SetColor( UI_C_CMPDIM )
   @ HC_CP_RULE, 0 SAY Replicate( BP_LINE_SINGLE, nW )
   IF st[ CM_LUNI ] != .T.
      @ HC_CP_RULE, HC_CP_SEP SAY BP_SEP_VERT
   ENDIF
   SetColor( UI_C_DESKTOP )
RETURN

/* one option chip of S7: "[X] <label>  Alt-<letter>" in the sober pair of S5,
 * painted AND registered with the Alt letter, two blank cells apart, so a
 * click becomes the very key the keyboard produces (S31) */
STATIC FUNCTION HcCmpOpt( nCol, lOn, cLabel, cLetter )
   LOCAL cTxt := "[" + iif( lOn, "X", " " ) + "] " + cLabel + "  Alt-" + cLetter
   LOCAL nW := Len( cTxt )
   SetColor( iif( lOn, UI_C_CMPON, UI_C_CMPOFF ) )
   @ HC_CP_OPT, nCol SAY cTxt
   HcSyncCtlAdd( HC_CP_OPT, nCol, nW, "ALT", cLetter )
RETURN nCol + nW + 2

STATIC PROCEDURE HcCmpDrawOpts( st )
   LOCAL nCol := 1
   SetColor( UI_C_CMPBODY )
   @ HC_CP_OPT, 0 SAY Space( UiCols() )
   nCol := HcCmpOpt( nCol, st[ CM_LCASE ], "Ignore case", "C" )
   nCol := HcCmpOpt( nCol, st[ CM_LWS ], "Ignore white space", "W" )
   nCol := HcCmpOpt( nCol, st[ CM_LDIFF ], "Only differences", "D" )
   nCol := HcCmpOpt( nCol, st[ CM_LUNI ] != .T., "Split view", "V" )
   SetColor( UI_C_DESKTOP )
RETURN

/* the margin bar of one text row: a THIN bar in the LEFT HALF of the cell
 * (Chr( 221 ), CP437 left half block), so a changed line is marked without
 * painting its background (S5, L6/L7). An equal line gets a plain body cell */
STATIC PROCEDURE HcCmpMarker( nRow, nCol, nKind )
   LOCAL cBar := iif( nKind == HC_CMP_DEL .OR. nKind == HC_CMP_ADD .OR. ;
                      nKind == HC_CMP_CHG, Chr( 221 ), " " )
   SetColor( HcCmpKindColor( nKind ) )
   @ nRow, nCol SAY cBar
RETURN

/* one side of a split row: the margin bar, the line number and the text with,
 * on a CHANGED line only, the span of the characters that differ (S5). The
 * caller has already cleared the row to UI_C_CMPBODY. */
STATIC PROCEDURE HcCmpSide( st, nScr, nCol, nLine, nPfx, nSfx, nKind, nW, nOff, aLines, lMark )
   LOCAL cTxt, aMk, nTxt := nCol + HC_CP_TXT
   HcCmpMarker( nScr, nCol, iif( nLine > 0, nKind, HC_CMP_EQ ) )
   SetColor( UI_C_CMPDIM )
   @ nScr, nCol + HC_CP_MRK SAY PadL( iif( nLine > 0, LTrim( Str( nLine ) ), "" ), HC_CP_GUT )
   SetColor( UI_C_CMPBODY )
   IF nLine <= 0 .OR. nLine > Len( aLines )
      @ nScr, nTxt SAY Space( nW )
      RETURN
   ENDIF
   cTxt := HcCmpPad( aLines[ nLine ], nW, nOff )
   @ nScr, nTxt SAY cTxt
   IF lMark
      aMk := HcCmpMark( aLines[ nLine ], nOff, nW, nPfx, nSfx )
      IF aMk[ 2 ] > 0
         SetColor( UI_C_CMPWORD )
         @ nScr, nTxt + aMk[ 1 ] - 1 SAY SubStr( cTxt, aMk[ 1 ], aMk[ 2 ] )
      ENDIF
   ENDIF
RETURN

/* a row of the split view: the two panes side by side, with the separator */
STATIC PROCEDURE HcCmpDrawSplitRow( st, nScr, aR, nKind )
   LOCAL lMark := ( nKind == HC_CMP_CHG )
   HcCmpSide( st, nScr, 0, aR[ HC_CMR_L ], aR[ HC_CMR_LPFX ], aR[ HC_CMR_LSFX ], ;
              nKind, HC_CP_TW, st[ CM_OFFL ], st[ CM_LLINES ], lMark )
   SetColor( UI_C_CMPDIM )
   @ nScr, HC_CP_SEP SAY BP_SEP_VERT
   HcCmpSide( st, nScr, HC_CP_RL, aR[ HC_CMR_R ], aR[ HC_CMR_RPFX ], aR[ HC_CMR_RSFX ], ;
              nKind, HC_CP_TW, st[ CM_OFFR ], st[ CM_RLINES ], lMark )
RETURN

/* a row of the unified view: margin bar, line-number gutter, then the text. A
 * changed line takes two screen rows: the left one (ROW) and the right one
 * (ROW2), in that order, and both paint the changed bar (S6). The old sign
 * column is gone: the colour of the bar says which side the line is */
STATIC PROCEDURE HcCmpDrawUniRow( st, nScr, aV, aR, nKind )
   LOCAL lRight := ( aV[ HC_CMPV_KIND ] == HC_CMPV_ROW2 )
   LOCAL nLine := 0, nShow := nKind, aLines := st[ CM_LLINES ], nOff, cTxt, aMk
   LOCAL nPfx := 0, nSfx := 0, nTxt := HC_CP_TXT
   IF lRight
      nLine := aR[ HC_CMR_R ]
      nShow := HC_CMP_CHG
      aLines := st[ CM_RLINES ]
      nPfx := aR[ HC_CMR_RPFX ]
      nSfx := aR[ HC_CMR_RSFX ]
   ELSE
      DO CASE
      CASE nKind == HC_CMP_ADD
         nLine := aR[ HC_CMR_R ]
         aLines := st[ CM_RLINES ]
         nPfx := aR[ HC_CMR_RPFX ]
         nSfx := aR[ HC_CMR_RSFX ]
      CASE nKind == HC_CMP_DEL
         nLine := aR[ HC_CMR_L ]
      CASE nKind == HC_CMP_CHG
         nLine := aR[ HC_CMR_L ]
         /* the LEFT copy of the span the split view marks on its left pane */
         nPfx := aR[ HC_CMR_LPFX ]
         nSfx := aR[ HC_CMR_LSFX ]
      OTHERWISE
         nLine := aR[ HC_CMR_L ]
      ENDCASE
   ENDIF
   IF st[ CM_SIDE ] == 1
      nOff := st[ CM_OFFL ]
   ELSE
      nOff := st[ CM_OFFR ]
   ENDIF
   HcCmpMarker( nScr, 0, iif( nLine > 0, nShow, HC_CMP_EQ ) )
   SetColor( UI_C_CMPDIM )
   @ nScr, HC_CP_MRK SAY PadL( iif( nLine > 0, LTrim( Str( nLine ) ), "" ), HC_CP_GUT )
   SetColor( UI_C_CMPBODY )
   IF nLine <= 0 .OR. nLine > Len( aLines )
      @ nScr, nTxt SAY Space( HC_CP_TWU )
      RETURN
   ENDIF
   cTxt := HcCmpPad( aLines[ nLine ], HC_CP_TWU, nOff )
   @ nScr, nTxt SAY cTxt
   IF nKind == HC_CMP_CHG
      aMk := HcCmpMark( aLines[ nLine ], nOff, HC_CP_TWU, nPfx, nSfx )
      IF aMk[ 2 ] > 0
         SetColor( UI_C_CMPWORD )
         @ nScr, nTxt + aMk[ 1 ] - 1 SAY SubStr( cTxt, aMk[ 1 ], aMk[ 2 ] )
      ENDIF
   ENDIF
RETURN

/* one entry of the VIEW model, on its screen row. The row is cleared first, so
 * a repaint never leaves the tail of a longer line behind; a folded run of
 * equal rows covers the whole width in the dim pair, with no separator inside
 * it (equal content is equal on both sides). */
STATIC PROCEDURE HcCmpDrawViewRow( st, nIdx )
   LOCAL nScr := HC_CP_FIRST + nIdx - st[ CM_TOP ], aV, aR, nKind
   IF nScr < HC_CP_FIRST .OR. nScr > HC_CP_LAST
      RETURN
   ENDIF
   SetColor( UI_C_CMPBODY )
   @ nScr, 0 SAY Space( MaxCol() + 1 )
   IF nIdx < 1 .OR. nIdx > Len( st[ CM_VIEW ] )
      RETURN
   ENDIF
   aV := st[ CM_VIEW ][ nIdx ]
   IF aV[ HC_CMPV_KIND ] == HC_CMPV_FOLD
      SetColor( UI_C_CMPDIM )
      @ nScr, 0 SAY HcCmpCentre( HcCmpFoldText( aV[ HC_CMPV_HID ] ), MaxCol() + 1 )
      RETURN
   ENDIF
   IF aV[ HC_CMPV_IDX ] < 1 .OR. aV[ HC_CMPV_IDX ] > Len( st[ CM_ROWS ] )
      RETURN
   ENDIF
   aR := st[ CM_ROWS ][ aV[ HC_CMPV_IDX ] ]
   nKind := HcCmpKind( aR )
   IF st[ CM_LUNI ] == .T.
      HcCmpDrawUniRow( st, nScr, aV, aR, nKind )
   ELSE
      HcCmpDrawSplitRow( st, nScr, aR, nKind )
   ENDIF
RETURN

/* the text area of the screen: one row per view entry, from the top */
STATIC PROCEDURE HcCmpDrawText( st )
   LOCAL i
   FOR i := st[ CM_TOP ] TO st[ CM_TOP ] + ( HC_CP_LAST - HC_CP_FIRST )
      HcCmpDrawViewRow( st, i )
   NEXT
RETURN

/* the scroll bar of the last column: a dim track of Chr( 176 ) and a darker
 * thumb of Chr( 178 ) in the same dim grey pair (L7: the column must read as a
 * grey scroll bar, never as a coloured stripe); the column is plain body when
 * every row fits (S5) */
STATIC PROCEDURE HcCmpDrawScroll( st )
   LOCAL aT := HcCmpThumb( st ), i
   FOR i := 0 TO HC_CP_LAST - HC_CP_FIRST
      IF Empty( aT[ 2 ] )
         SetColor( UI_C_CMPBODY )
         @ HC_CP_FIRST + i, MaxCol() SAY " "
      ELSEIF i >= aT[ 1 ] .AND. i < aT[ 1 ] + aT[ 2 ]
         /* the block characters are drawn with the TEXT colour, so the thumb
          * is a dark grey cell (the shade of UI_C_CMPTHUMB) on the light grey
          * of the row: a mid grey, which is what makes it read as a thumb */
         SetColor( UI_C_CMPTHUMB )
         @ HC_CP_FIRST + i, MaxCol() SAY Chr( 178 )
      ELSE
         SetColor( UI_C_CMPTRACK )
         @ HC_CP_FIRST + i, MaxCol() SAY Chr( 176 )
      ENDIF
   NEXT
   SetColor( UI_C_DESKTOP )
RETURN

STATIC PROCEDURE HcCmpDrawSummary( st )
   SetColor( UI_C_CMPBAR )
   @ HC_CP_SUM, 0 SAY PadR( Left( HcCmpSummaryLine( st[ CM_ROWS ], st[ CM_LUNI ] ), ;
                                  MaxCol() + 1 ), MaxCol() + 1 )
   SetColor( UI_C_DESKTOP )
RETURN

STATIC PROCEDURE HcCmpDrawMsg( st )
   SetColor( UI_C_CMPBAR )
   @ HC_CP_MSG, 0 SAY PadR( Left( st[ CM_MSG ], MaxCol() + 1 ), MaxCol() + 1 )
   SetColor( UI_C_DESKTOP )
RETURN

/* the chips of the keys bar of S6/S9: each one registers itself with the key
 * it announces, so a click goes through the same DO CASE as the keyboard */
STATIC PROCEDURE HcCmpDrawKeys()
   LOCAL aAll := HcCmpKeys(), i, nCol := 1, nW
   SetColor( UI_C_MENUBAR )
   @ HC_CP_KEYS, 0 SAY Space( UiCols() )
   FOR i := 1 TO Len( aAll )
      nW := Len( aAll[ i ][ 1 ] ) + 2 + Len( aAll[ i ][ 2 ] ) + 3
      IF nCol + nW > UiCols()
         EXIT
      ENDIF
      HcSyncCtlAdd( HC_CP_KEYS, nCol, nW, "KEY", aAll[ i ][ 1 ] )
      nCol := HcHintKey( HC_CP_KEYS, nCol, aAll[ i ][ 1 ], "=" + aAll[ i ][ 2 ] )
   NEXT
   SetColor( UI_C_DESKTOP )
RETURN

/* everything of S5, inside the caller's paint block */
STATIC PROCEDURE HcCmpDrawScreen( st )
   LOCAL i
   /* the clickable chips are rebuilt with every full paint (S31) */
   HcSyncCtlReset()
   UiCls()
   SetColor( UI_C_DESKTOP )
   FOR i := HC_CP_TITLE TO MaxRow()
      @ i, 0 SAY Space( UiCols() )
   NEXT
   HcCmpDrawHead( st )
   HcCmpDrawOpts( st )
   HcCmpDrawText( st )
   HcCmpDrawScroll( st )
   HcCmpDrawSummary( st )
   HcCmpDrawMsg( st )
   HcCmpDrawKeys()
   SetColor( UI_C_DESKTOP )
RETURN

STATIC PROCEDURE HcCmpPaint( st )
   UiPaintBegin()
   HcCmpDrawScreen( st )
   UiPaintEnd()
RETURN

/* only the rows of the visible window plus the summary, the message and the
 * scroll bar: a movement never repaints the whole screen */
STATIC PROCEDURE HcCmpPaintRows( st, nFrom, nTo )
   LOCAL i
   UiPaintBegin()
   FOR i := nFrom TO nTo
      HcCmpDrawViewRow( st, i )
   NEXT
   HcCmpDrawScroll( st )
   HcCmpDrawSummary( st )
   HcCmpDrawMsg( st )
   UiPaintEnd()
RETURN

STATIC PROCEDURE HcCmpPaintVisible( st )
   HcCmpPaintRows( st, st[ CM_TOP ], st[ CM_TOP ] + ( HC_CP_LAST - HC_CP_FIRST ) )
RETURN

/* S9: the wheel moves one row per notch, a click on the scroll bar goes one
 * page back or on, and a click on a chip becomes the same key the keyboard
 * produces. Returns { nKey, cAlt } or an empty array. */
STATIC FUNCTION HcCmpMouseInput( st )
   LOCAL nNotch, nRow, nCol, aC, aT, nVis := HC_CP_LAST - HC_CP_FIRST + 1
   nNotch := HcMouseWheel()
   IF nNotch != 0
      IF HcCmpScroll( st, -nNotch )
         HcCmpPaintVisible( st )
      ENDIF
      RETURN {}
   ENDIF
   nRow := HcMouseClickRow()
   nCol := HcMouseClickCol()
   IF nRow < 0 .OR. nCol < 0
      RETURN {}
   ENDIF
   IF nCol == MaxCol() .AND. nRow >= HC_CP_FIRST .AND. nRow <= HC_CP_LAST
      aT := HcCmpThumb( st )
      IF ! Empty( aT[ 2 ] )
         IF nRow - HC_CP_FIRST < aT[ 1 ]
            HcCmpScroll( st, -nVis )
         ELSE
            HcCmpScroll( st, nVis )
         ENDIF
         HcCmpPaintVisible( st )
      ENDIF
      RETURN {}
   ENDIF
   aC := HcSyncCtlAt( nRow, nCol )
   IF hb_IsNIL( aC )
      RETURN {}
   ENDIF
   DO CASE
   CASE aC[ 4 ] == "KEY"
      RETURN HcSyncChipInput( aC[ 5 ] )
   CASE aC[ 4 ] == "ALT"
      RETURN { 0, aC[ 5 ] }
   ENDCASE
RETURN { Asc( Upper( aC[ 5 ] ) ), "" }

/* F1 of the Compare screen: the keys it really has */
STATIC PROCEDURE HcCmpHelp()
   LOCAL a := { ;
      "Compare: two files, line by line", ;
      "", ;
      "  The left side is always the LEFT panel of the file manager and the", ;
      "  right side the right panel, whichever one is active. The pair is the", ;
      "  entry under the cursor and, on the other panel, the first MARKED", ;
      "  file, or the entry with the same name when nothing is marked.", ;
      "", ;
      "  Up/Down, PgUp/PgDn   one row / one page", ;
      "  Home/End             first / last row", ;
      "  Ctrl-Home/End        start / end of the diff", ;
      "  F7 / Ctrl-Up         previous difference", ;
      "  F8 / Ctrl-Down       next difference", ;
      "  Tab / Shift-Tab      switch the active side", ;
      "  Left/Right           scroll the active side by one cell", ;
      "  Ctrl-Left/Right      scroll the active side by eight cells", ;
      "  The ACTIVE side is the one whose path is painted in FULL BLACK on the", ;
      "  paths row (the other path is dim), and Left/Right scroll that side.", ;
      "  Ctrl-O               split view <-> unified view", ;
      "  Alt-C  ignore case       Alt-W  ignore white space", ;
      "  Alt-D  only differences  Alt-V  split / unified view", ;
      "  F5     reload both files and compare again", ;
      "  F1     this help         Esc / F10  back to the panels", ;
      "", ;
      "  Colours: a red bar in the left margin marks a line only on the left,", ;
      "  a green one a line only on the right and a brown one a changed line;", ;
      "  of a changed line, only the characters that differ are highlighted in", ;
      "  yellow. The last column is the scroll bar (a click above its thumb goes", ;
      "  one page back, below it one page on). This screen is READ ONLY: neither", ;
      "  file is ever written, and the differences are not applied." }
   UiTextWin( a, "Compare" )
RETURN

/* S6: the keys of the screen, mirroring HcSyncScreen() */
STATIC PROCEDURE HcCmpScreen( cLFile, cRFile, aLLines, aRLines )
   LOCAL st := HcCmpState( cLFile, cRFile, aLLines, aRLines )
   LOCAL nKey, nShift, cAlt, lLeave := .F., lFull := .T., cOldCur, aIn
   cOldCur := SetCursor( 0 )
   HcCmpRecompare( st )
   DO WHILE ! lLeave
      IF lFull
         HcCmpPaint( st )
         lFull := .F.
      ENDIF
      nKey := Inkey( 0.05 )
      /* the ALT state has to be read right after Inkey() (measured: this
       * GTWVG hands Alt+<letter> over as the plain letter plus this state) */
      nShift := HcShiftState()
      cAlt := HcAltLetter( nKey, nShift )
      /* right-click-esc (S1/S2/S7): a plain right click leaves the Compare
       * screen, the same as Esc */
      IF nKey == 0 .AND. HcMouseRightClick()
         nKey := K_ESC
      ENDIF
      IF nKey == 0
         /* no key: the mouse gets its turn and resolves to the SAME input */
         aIn := HcCmpMouseInput( st )
         IF ! Empty( aIn )
            nKey := aIn[ 1 ]
            IF ! Empty( aIn[ 2 ] )
               cAlt := aIn[ 2 ]
            ENDIF
         ENDIF
      ENDIF
      DO CASE
      CASE nKey == K_ESC .OR. nKey == K_F10
         lLeave := .T.
      CASE nKey == K_F1
         HcCmpHelp()
         lFull := .T.
      CASE nKey == K_F5
         HcCmpReload( st )
         lFull := .T.
      CASE nKey == K_UP
         IF HcCmpScroll( st, -1 )
            HcCmpPaintVisible( st )
         ENDIF
      CASE nKey == K_DOWN
         IF HcCmpScroll( st, 1 )
            HcCmpPaintVisible( st )
         ENDIF
      CASE nKey == K_PGUP
         IF HcCmpScroll( st, -( HC_CP_LAST - HC_CP_FIRST + 1 ) )
            HcCmpPaintVisible( st )
         ENDIF
      CASE nKey == K_PGDN
         IF HcCmpScroll( st, HC_CP_LAST - HC_CP_FIRST + 1 )
            HcCmpPaintVisible( st )
         ENDIF
      CASE nKey == K_HOME .OR. nKey == K_CTRL_HOME
         IF HcCmpScroll( st, -Len( st[ CM_VIEW ] ) )
            HcCmpPaintVisible( st )
         ENDIF
      CASE nKey == K_END .OR. nKey == K_CTRL_END
         IF HcCmpScroll( st, Len( st[ CM_VIEW ] ) )
            HcCmpPaintVisible( st )
         ENDIF
      CASE nKey == K_F7 .OR. nKey == K_CTRL_UP
         IF HcCmpJump( st, -1 )
            HcCmpPaintVisible( st )
         ENDIF
      CASE nKey == K_F8 .OR. nKey == K_CTRL_DOWN
         IF HcCmpJump( st, 1 )
            HcCmpPaintVisible( st )
         ENDIF
      CASE nKey == K_TAB .OR. nKey == K_SH_TAB
         st[ CM_SIDE ] := iif( st[ CM_SIDE ] == 1, 2, 1 )
         /* T11: the paths row IS the indicator of the active side, so it is
          * repainted here; without this the switch was invisible until the
          * next full repaint */
         HcCmpPaintPaths( st )
      CASE nKey == K_LEFT
         IF HcCmpOff( st, -1 )
            HcCmpPaintVisible( st )
         ENDIF
      CASE nKey == K_RIGHT
         IF HcCmpOff( st, 1 )
            HcCmpPaintVisible( st )
         ENDIF
      CASE nKey == K_CTRL_LEFT
         IF HcCmpOff( st, -8 )
            HcCmpPaintVisible( st )
         ENDIF
      CASE nKey == K_CTRL_RIGHT
         IF HcCmpOff( st, 8 )
            HcCmpPaintVisible( st )
         ENDIF
      CASE nKey == K_CTRL_O
         st[ CM_LUNI ] := ! st[ CM_LUNI ]
         HcCmpRecompare( st )
         lFull := .T.
      CASE ! Empty( cAlt )
         HcCmpAlt( st, cAlt, @lFull )
      ENDCASE
   ENDDO
   SetCursor( cOldCur )
   SetColor( UI_C_DESKTOP )
RETURN

/* S3: the notice of a side that cannot be read. The two cases the viewer
 * names (binary and too big) are decided with the SAME rules HcReadText()
 * uses - HE_MAXSIZE and HcIsBinaryText() - so the message never guesses; any
 * other failure keeps the error of the engine. */
STATIC PROCEDURE HcCmpReadError( cFile, cError )
   LOCAL cName := hb_FNameNameExt( cFile ), nSize := 0, nHandle, cData := ""
   IF hb_vfExists( cFile )
      nSize := hb_vfSize( cFile )
      IF ValType( nSize ) != "N" .OR. nSize < 0
         nSize := 0
      ENDIF
      nSize := Int( nSize )
      IF nSize > HE_MAXSIZE
         UiMsg( cName + ": file is too large to compare.", "Compare" )
         RETURN
      ENDIF
      nHandle := FOpen( cFile, FO_READ )
      IF nHandle >= 0
         cData := Space( nSize )
         IF nSize > 0
            FRead( nHandle, @cData, nSize )
         ENDIF
         FClose( nHandle )
         IF HcIsBinaryText( cData )
            UiMsg( cName + ": binary file cannot be compared.", "Compare" )
            RETURN
         ENDIF
      ENDIF
   ENDIF
   UiMsg( "Cannot read " + cFile + ":" + hb_eol() + cError, "Compare" )
RETURN

/* S1..S3: the pair of S2, the notices and the entry into the screen. The left
 * side is ALWAYS the left panel and the right side the right panel, whichever
 * one is active (L3). */
STATIC PROCEDURE HcCompare()
   LOCAL aL := HcPanel( HC_PANEL_L ), aR := HcPanel( HC_PANEL_R )
   LOCAL aAct := HcPanelActive(), aOth := HcPanel( HcOtherPanel() )
   LOCAL aPick, cL, cR, aLL, aRR, aRows
   /* S3: the compare reads BOTH panels, so a link on either side refuses it */
   IF HcLinkGuard( .F., .T. )
      RETURN
   ENDIF
   aPick := HcCmpPick( aAct[ HC_P_LIST ], aAct[ HC_P_SEL ], ;
                       aOth[ HC_P_LIST ], aOth[ HC_P_SEL ] )
   IF aPick[ 3 ] == "nofile"
      UiMsg( "Select a file in the active panel to compare.", "Compare" )
      RETURN
   ENDIF
   IF aPick[ 3 ] == "notfound"
      UiMsg( "Cannot find " + aPick[ 1 ] + " in the other panel.", "Compare" )
      RETURN
   ENDIF
   IF HcActive() == HC_PANEL_L
      cL := HcJoinPath( aL[ HC_P_DIR ], aPick[ 1 ] )
      cR := HcJoinPath( aR[ HC_P_DIR ], aPick[ 2 ] )
   ELSE
      cL := HcJoinPath( aL[ HC_P_DIR ], aPick[ 2 ] )
      cR := HcJoinPath( aR[ HC_P_DIR ], aPick[ 1 ] )
   ENDIF
   IF HcCmpSame( cL, cR )
      UiMsg( "Both sides are the same file.", "Compare" )
      RETURN
   ENDIF
   aLL := HcReadText( cL )
   IF ! aLL[ 1 ]
      HcCmpReadError( cL, aLL[ 3 ] )
      RETURN
   ENDIF
   aRR := HcReadText( cR )
   IF ! aRR[ 1 ]
      HcCmpReadError( cR, aRR[ 3 ] )
      RETURN
   ENDIF
   aRows := HcCmpRows( aLL[ 2 ], aRR[ 2 ], .F., .F. )
   IF HcCmpStat( aRows )[ 5 ] == 0
      UiMsg( "Files are identical.", "Compare" )
      RETURN
   ENDIF
   HcCmpScreen( cL, cR, aLL[ 2 ], aRR[ 2 ] )
RETURN

/* =====================================================================
 *  Commander Link (S1..S9 and S14 of odd/tasks/commander-link.md)
 *
 *  The Norton Commander `Commander Link`, over TCP/IP on the LAN: one hwBro in
 *  SLAVE mode serves a scope of its disk and another one in MASTER mode mounts
 *  it in one of its two panels. The transport, the protocol and the server live
 *  in src/bp_link.prg; what lives here is the DIALOG, the remote PANEL and the
 *  pump of the Slave between two keystrokes.
 *
 *  HOW A LINKED PANEL IS MODELLED
 *
 *    - one link at a time, in the module STATIC s_aHcLink (NIL when there is
 *      none) plus a flag in the panel record (HC_P_LINK);
 *    - while the flag is up, HC_P_DIR holds an ABSOLUTE path OF THE PEER
 *      (S14/L7: "C:\Users\Public", "\\SERVER\SHARE", canonicalised by
 *      HcLinkNormDir()). That value
 *      must never reach HcJoinPath()/HcNormPath()/HcCheckDir()/hb_DirExists()
 *      or any other local call, and it cannot: HcLoad() branches on
 *      HcLinkPanel() BEFORE the first local call (HcCheckDir), HcChangeDir()
 *      branches before HcJoinPath()/HcParentDir(), and every routine that would
 *      build a local path out of HC_P_DIR asks HcLinkGuard() first. The only
 *      place where such a path is validated is LinkSafePath() on the Slave;
 *    - `..` never leaves the link (S14): at the top of the exported scope it is
 *      a no-op, and leaving is `Left`/`Right > Disconnect link`;
 *    - the listing has the exact shape HcReadDir() produces (LinkRemoteList()
 *      returns exactly that), so the arrows, PgUp/PgDn, Home/End, Ins, the sort
 *      of the header click, the wheel and the clicks keep working through the
 *      code that already exists.
 *
 *  S3: a linked panel allows only the BASIC operations of the commander. F3,
 *  F4, Shift-F2, the right-button panel, Enter on a file (a *.DBF least of all)
 *  and F5..F8 answer with one short message and do nothing: there is no remote
 *  Browse view nor Browse edit, by design.
 * ===================================================================== */

/* --- the pure part (the headless bank pins it) ----------------------- */

/* One canonical form of a remote directory: backslashes, no trailing separator
 * except the one a root carries ("C:\"), and no leading separator unless it is
 * the UNC prefix. It is purely textual (it never touches the disk and never
 * collapses ".."): what it does is make every remote path comparable. PURE. */
FUNCTION HcLinkNormDir( cDir )
   LOCAL c := ""
   IF ValType( cDir ) == "C"
      c := AllTrim( StrTran( cDir, "/", "\" ) )
   ENDIF
   IF Len( c ) == 0
      RETURN ""
   ENDIF
   DO WHILE Len( c ) > 1 .AND. Right( c, 1 ) == "\"
      /* a drive root keeps its separator, so "C:\" never becomes "C:" */
      IF Len( c ) == 3 .AND. SubStr( c, 2, 1 ) == ":"
         EXIT
      ENDIF
      c := Left( c, Len( c ) - 1 )
   ENDDO
   DO WHILE Left( c, 1 ) == "\" .AND. ! ( Left( c, 2 ) == "\\" )
      c := SubStr( c, 2 )
   ENDDO
RETURN c

/* .T. when the path is absolute on its own ("C:\x" or "\\srv\share"). PURE. */
FUNCTION HcLinkIsAbsPath( cPath )
   LOCAL c := AllTrim( iif( ValType( cPath ) == "C", cPath, "" ) )
   IF Len( c ) >= 2 .AND. SubStr( c, 2, 1 ) == ":" .AND. IsAlpha( Left( c, 1 ) )
      RETURN .T.
   ENDIF
RETURN Left( c, 2 ) == "\\"

/* One step down the remote tree: the absolute directory of the panel plus the
 * name of an entry, in the canonical form of HcLinkNormDir(). PURE. */
FUNCTION HcLinkDirJoin( cDir, cName )
   LOCAL c := HcLinkNormDir( cDir ), cNew
   IF ValType( cName ) != "C"
      RETURN c
   ENDIF
   cNew := AllTrim( cName )
   IF Len( cNew ) == 0
      RETURN c
   ENDIF
   /* a name never carries a path: only what follows its last separator */
   cNew := SubStr( cNew, Max( Rat( "/", cNew ), Rat( "\", cNew ) ) + 1 )
   IF Len( cNew ) == 0
      RETURN c
   ENDIF
   IF Len( c ) == 0
      RETURN cNew
   ENDIF
   IF ! ( Right( c, 1 ) == "\" )
      c += "\"
   ENDIF
RETURN c + cNew

/* One step up the remote tree, with the top of the exported scope as the
 * floor: `..` AT that top (or at a drive root when the whole disk is exported)
 * answers the path it was given, so the caller can do NOTHING. It never
 * unlinks anything (S14): leaving the link is an explicit action. PURE. */
FUNCTION HcLinkUpDir( cDir, cTop )
   LOCAL c := HcLinkNormDir( cDir ), cT, n, aP
   DEFAULT cTop TO ""
   IF Len( c ) == 0
      RETURN ""
   ENDIF
   cT := HcLinkNormDir( cTop )
   IF Len( cT ) > 0 .AND. Upper( c ) == Upper( cT )
      RETURN c
   ENDIF
   /* a drive root, and the root of a UNC share, are their own parents */
   IF Left( c, 2 ) == "\\"
      aP := hb_ATokens( SubStr( c, 3 ), "\" )
      IF Len( aP ) <= 2
         RETURN c
      ENDIF
   ELSEIF Len( c ) <= 3
      RETURN c
   ENDIF
   n := Rat( "\", c )
   IF n <= 1
      RETURN c
   ENDIF
   IF n == 3 .AND. SubStr( c, 2, 1 ) == ":"
      RETURN Left( c, 3 )         /* "C:\Users" -> "C:\" */
   ENDIF
RETURN Left( c, n - 1 )

/* .T. when `..` from <cDir> goes somewhere. The panel paints its `..` row only
 * then, exactly like a local panel at the root of a drive. PURE. */
FUNCTION HcLinkHasUp( cDir, cTop )
   LOCAL c := HcLinkNormDir( cDir )
   DEFAULT cTop TO ""
   IF Len( c ) == 0
      RETURN .F.
   ENDIF
RETURN ! ( HcLinkUpDir( c, cTop ) == c )

/* The listing of a linked panel out of what LinkRemoteList() answered. The
 * remote list NEVER carries the `..` row (a bare `..` is refused by the path
 * confinement of the Slave), so the panel builds the same one a local listing
 * has - but only when there is somewhere to go up to (<lUp>), because at a
 * drive root the local listing has none either - and sorts the whole thing with
 * the key and the direction of the panel. Answers NIL when the remote list
 * itself is not a list. PURE of the disk. */
FUNCTION HcLinkRows( aRemote, cSort, lDesc, lUp )
   LOCAL aOut := {}, i
   DEFAULT cSort TO "NAME"
   DEFAULT lDesc TO .F.
   DEFAULT lUp TO .T.
   IF ! HB_ISARRAY( aRemote )
      RETURN NIL
   ENDIF
   IF lUp
      AAdd( aOut, { "..", 0, NIL, "D", .F., NIL } )
   ENDIF
   FOR i := 1 TO Len( aRemote )
      AAdd( aOut, aRemote[ i ] )
   NEXT
RETURN HcSortList( aOut, cSort, lDesc )

/* The path a linked panel shows: "\\NAME\C:\sub\dir\". Backslashes on purpose
 * (that is what the user reads) and a leading UNC style prefix, so it can never
 * be mistaken for a local path. The absolute path of the peer is kept whole, so
 * this is the inverse of HcLinkTargetAbs(). PURE. */
FUNCTION HcLinkTitle( cName, cDir )
   LOCAL c := "\\" + AllTrim( iif( ValType( cName ) == "C", cName, "" ) )
   LOCAL cD := HcLinkNormDir( iif( ValType( cDir ) == "C", cDir, "" ) )
   IF Len( cD ) > 0
      c := c + "\" + cD
   ENDIF
   IF ! ( Right( c, 1 ) == "\" )
      c := c + "\"
   ENDIF
RETURN c

/* The chip the title of a linked panel carries: "[LINK host:port]". PURE. */
FUNCTION HcLinkPeerText( cHost, nPort )
   LOCAL c := ""
   IF ValType( cHost ) == "C"
      c := AllTrim( cHost )
   ENDIF
   IF ValType( nPort ) == "N" .AND. nPort > 0
      c := c + ":" + LTrim( Str( nPort ) )
   ENDIF
   IF Len( c ) == 0
      RETURN ""
   ENDIF
RETURN "[LINK " + c + "]"

/* The chip that says the Slave of this screen is serving: "[SLAVE :31000]".
 * A port below 1 means "not serving" and answers "". PURE. */
FUNCTION HcLinkSlaveText( nPort )
   IF ValType( nPort ) != "N" .OR. nPort < 1
      RETURN ""
   ENDIF
RETURN "[SLAVE :" + LTrim( Str( nPort ) ) + "]"

/* --- bridge to src/bp_link.prg ---------------------------------------
 *
 *  The headless bank of T5 (src/tests/test_hc.prg) links THIS module with
 *  -DBP_HC_STANDALONE and WITHOUT src/bp_link.prg - exactly the way it already
 *  links it without hwbro.prg (BpSetExit) and without the window hook of
 *  bp_win32.c. Every call into the link module therefore goes through one of
 *  the wrappers below: the panel, the dialog and the key loop are the SAME code
 *  in both builds and only these short bodies differ. The real program links
 *  bp_link.prg (src/hwbro.hbp) and takes the first branch. NOTE: a formal
 *  parameter only updates the caller's variable when the call site writes `@`
 *  (measured in bp_link.prg), so the error text is forwarded with `@`.
 */
#ifndef BP_HC_STANDALONE
