/* =====================================================================
 *  Menu bar (S25..S30)
 *
 *  Row HC_MENU carries the bar of Norton Commander style
 *
 *      Left   Files   Directories   Commands   Right
 *
 *  and every dropdown hangs from its own label. F9 opens the bar (its chip in
 *  the hotkey bar is called `PullDn`) and it is the ONLY F9 path: the UiPick
 *  list of file operations it used to show is gone, every operation is one of
 *  the entries of the Files menu. A click on a label opens that menu and a
 *  click on an entry runs it (S26).
 *
 *  The core is pure and the headless bank drives it: HcMenuList() returns the
 *  five menus as { label, rows } with a row = { text, shortcut, action, flag };
 *  HcMenuFirst()/HcMenuNext() walk one menu skipping the separators and the
 *  unavailable ("D") rows - an "I" row IS reachable, it is dimmed but
 *  runnable - and HcMenuWidth() is the interior width of a dropdown. Every
 *  action here is the very routine its key reaches (HcRunKey()), so the menu
 *  and the keys can never drift apart.
 * ===================================================================== */

/* .T. when the row of a menu is a separator (an EMPTY text, the convention of
 * BpMenus()): it is painted as a rule and the cursor never stops on it */
STATIC FUNCTION HcMenuSep( aItem )
   IF ! HB_ISARRAY( aItem ) .OR. Len( aItem ) < HC_MI_FLAG
      RETURN .T.
   ENDIF
   IF ValType( aItem[ HC_MI_TEXT ] ) != "C"
      RETURN .T.
   ENDIF
RETURN Empty( aItem[ HC_MI_TEXT ] )

/* .T. when the cursor may stop on the row: not a separator and not a "D"
 * (unavailable) one. An "I" row is reachable: it is dimmed because it only
 * reports that it is not part of this reconstruction, but it is runnable. */
STATIC FUNCTION HcMenuOk( aItem )
   IF HcMenuSep( aItem )
      RETURN .F.
   ENDIF
RETURN ! ( aItem[ HC_MI_FLAG ] == "D" )

/* first row of a menu the cursor can reach (0 when there is none) */
FUNCTION HcMenuFirst( aItems )
   LOCAL i
   IF ! HB_ISARRAY( aItems )
      RETURN 0
   ENDIF
   FOR i := 1 TO Len( aItems )
      IF HcMenuOk( aItems[ i ] )
         RETURN i
      ENDIF
   NEXT
RETURN 0

/* Row the cursor reaches from nSel walking nDir (+1 down, -1 up): separators
 * and "D" rows are skipped and the ends WRAP AROUND in both directions, so
 * holding Down walks the whole menu for ever (S26). A menu with nothing to
 * reach answers 0 and a menu with a single reachable row stays on it. */
FUNCTION HcMenuNext( aItems, nSel, nDir )
   LOCAL nLen, n, i
   IF ! HB_ISARRAY( aItems )
      RETURN 0
   ENDIF
   nLen := Len( aItems )
   IF nLen < 1 .OR. HcMenuFirst( aItems ) == 0
      RETURN 0
   ENDIF
   DEFAULT nDir TO 1
   IF ValType( nDir ) != "N" .OR. nDir == 0
      nDir := 1
   ENDIF
   nDir := iif( nDir > 0, 1, -1 )
   IF ValType( nSel ) != "N" .OR. nSel < 1 .OR. nSel > nLen
      RETURN HcMenuFirst( aItems )
   ENDIF
   n := nSel
   FOR i := 1 TO nLen
      n += nDir
      IF n < 1
         n := nLen
      ELSEIF n > nLen
         n := 1
      ENDIF
      IF HcMenuOk( aItems[ n ] )
         RETURN n
      ENDIF
   NEXT
RETURN nSel

/* interior width of a dropdown (S27): the longest row plus the two cells that
 * separate the text from the shortcut of the right border. Separators do not
 * count, they are drawn as a rule of this width. */
FUNCTION HcMenuWidth( aItems )
   LOCAL i, n := 0, nKey
   IF ! HB_ISARRAY( aItems )
      RETURN 0
   ENDIF
   FOR i := 1 TO Len( aItems )
      IF ! HcMenuSep( aItems[ i ] )
         nKey := iif( ValType( aItems[ i ][ HC_MI_KEY ] ) == "C", ;
                      Len( aItems[ i ][ HC_MI_KEY ] ), 0 )
         n := Max( n, UiHotLen( aItems[ i ][ HC_MI_TEXT ] ) + 2 + nKey )
      ENDIF
   NEXT
RETURN n

/* ===================== cascading submenus (S2/S3) =====================
 * odd/tasks/hc-themes-submenu.md: a row may open a CHILD list painted next to
 * the dropdown. The four elements every row of this bar has carried since S30
 * keep their meaning; the child list is an OPTIONAL fifth one (HC_MI_SUB), so a
 * row of four elements is a plain entry and nothing else changes (S5). The
 * decisions below are pure - no window, no state - and the headless bank pins
 * them (S120). */

/* the rows of the cascade a row opens, or NIL when that row is a plain entry.
 * An empty list is read as "no cascade" so the paint can never open a box with
 * nothing in it. */
FUNCTION HcMenuRowSub( aItem )
   IF ! HB_ISARRAY( aItem )
      RETURN NIL
   ENDIF
   IF Len( aItem ) < HC_MI_SUB .OR. ! HB_ISARRAY( aItem[ HC_MI_SUB ] )
      RETURN NIL
   ENDIF
   IF Empty( aItem[ HC_MI_SUB ] )
      RETURN NIL
   ENDIF
RETURN aItem[ HC_MI_SUB ]

/* the cascade of the nIdx-th row of a dropdown, or NIL when that row opens
 * nothing: the loop of HcMenuBar() and the bank ask the very same question */
FUNCTION HcMenuSubAt( aItems, nIdx )
   IF ! HB_ISARRAY( aItems )
      RETURN NIL
   ENDIF
   IF ValType( nIdx ) != "N" .OR. nIdx < 1 .OR. nIdx > Len( aItems )
      RETURN NIL
   ENDIF
RETURN HcMenuRowSub( aItems[ nIdx ] )

/* the affordance painted in the SHORTCUT column of a row that opens a cascade:
 * the CP437 right-pointing pointer (Chr(16), 0x10 of the code page). It is the
 * row's shortcut (HC_MI_KEY), so HcMenuWidth() already counts its cell and
 * HcMenuRow() paints it with no second rule. */
FUNCTION HcMenuSubMark()
RETURN Chr( 16 )

/* geometry of the cascade of one row: { top, left, bottom, interior width }, the
 * VERY shape HcMenuRect() answers, so the whole painting and hit-testing
 * machinery of a dropdown (HcMenuDrawDrop, HcMenuRow, HcMenuPaintMove,
 * HcMenuInside, HcMenuHit, HcMenuHoverIdx, HcMenuWheelSel) works on it
 * untouched. It opens to the RIGHT of the parent box - after its shadow - on the
 * parent's own row; when the right side of the canvas cannot hold it, it goes to
 * the LEFT of the parent box instead, and in both cases the canvas wins
 * (UiFitCol/UiFitRow) instead of a clipped box.
 * Pure: it only reads its arguments and the size of the canvas. */
FUNCTION HcMenuSubRect( aParent, nRow, aSub )
   LOCAL nW, nCnt, nL, nT, nB
   IF ! HB_ISARRAY( aParent ) .OR. Len( aParent ) < 4 .OR. ! HB_ISARRAY( aSub )
      RETURN {}
   ENDIF
   nCnt := Len( aSub )
   IF nCnt < 1
      RETURN {}
   ENDIF
   nW := HcMenuWidth( aSub )
   IF ValType( nRow ) != "N" .OR. nRow < 1
      nRow := 1
   ENDIF
   nL := aParent[ 2 ] + aParent[ 4 ] + 3     /* after the parent box and its shadow */
   IF nL + nW + 2 > UiCols()
      nL := aParent[ 2 ] - nW - 2            /* no room on the right: to its left   */
   ENDIF
   nL := UiFitCol( nL, nW + 3 )
   nT := UiFitRow( aParent[ 1 ] + nRow, nCnt + 2 )
   nB := Min( nT + nCnt + 1, MaxRow() )
RETURN { nT, nL, nB, nW }

/* Invert selection (S28): flips the mark of every entry of the active panel
 * except `..` and returns how many marks it changed. The optional array is the
 * listing of the panel (the headless bank hands it over); the menu passes
 * nothing and the listing of the ACTIVE panel is used. */
FUNCTION HcInvertMarks( aList )
   LOCAL aP, i, n := 0
   IF ! HB_ISARRAY( aList )
      aP := HcPanelActive()
      aList := aP[ HC_P_LIST ]
   ENDIF
   IF ! HB_ISARRAY( aList )
      RETURN 0
   ENDIF
   FOR i := 1 TO Len( aList )
      IF HB_ISARRAY( aList[ i ] ) .AND. Len( aList[ i ] ) >= HC_E_MARK .AND. ;
         ValType( aList[ i ][ HC_E_NAME ] ) == "C" .AND. ;
         ! ( aList[ i ][ HC_E_NAME ] == ".." )
         aList[ i ][ HC_E_MARK ] := ! aList[ i ][ HC_E_MARK ]
         n++
      ENDIF
   NEXT
RETURN n

/* The five menus of the bar, in the order of S25. The labels carry their hot
 * letter as ~X~ (painted by UiDrawHot, read by HcMenuHot). */
FUNCTION HcMenuList()
RETURN { ;
   { "~L~eft",        HcMenuLeft() }, ;
   { "~F~iles",       HcMenuFiles() }, ;
   { "~D~irectories", HcMenuDirs() }, ;
   { "~C~ommands",    HcMenuCmds() }, ;
   { "~R~ight",       HcMenuRight() } }

/* T2 of hc-tree-panel.md (S1): the `Tree panel` row of the Left/Right menus.
 * The flag is "D" (dimmed and unreachable) for a panel that is a Commander Link
 * peer or that is inside an archive: the tree walks THIS disk and those two
 * panels do not have one. */
STATIC FUNCTION HcTreeMenuFlag( nId )
   LOCAL aP := HcPanel( nId )
   IF ( Len( aP ) >= HC_P_LINK .AND. aP[ HC_P_LINK ] == .T. ) .OR. ;
      HcLinkPanel( aP ) .OR. HcTreeInZip( aP )
      RETURN "D"
   ENDIF
RETURN ""

/* the action of that row: it switches the panel and then repaints the WHOLE
 * screen. The menu bar has no flag of the key loop to set, so this follows the
 * same road as the four `Sort by ...` rows, which call HcSortPanel() and let it
 * paint the screen (HcDrawScreen()) instead of a partial repaint. */
STATIC PROCEDURE HcTreeMenu( nId )
   LOCAL aP := HcPanel( nId )
   LOCAL aOther := HcPanel( iif( nId == HC_PANEL_L, HC_PANEL_R, HC_PANEL_L ) )
   HcTreePanelToggle( aP, aOther )
   HcDrawScreen()
RETURN

/* `Left` (S29): only what this port really does with the left panel.
 * `Commander Link...` is here and in `Right`, the two menus of the panels,
 * because it applies to the panel the menu belongs to and asking for it must
 * not need another menu (S2 of commander-cleanup.md took it out of `Commands`).
 * `Disconnect link` is the ONLY way to leave a link (S14: `..` never does it) and
 * it is dimmed while that panel is not linked.
 * The last four entries change the ORDER OF THE FILES OF THE LEFT PANEL
 * (S34/S6): the three keys behave exactly like a click on the matching header
 * (the same HcSortPanel(), so they cannot diverge from the mouse) and `Reverse
 * order` only flips the direction of the key in force. Every reachable row
 * carries its hot letter as ~X~ (hc-menu-hotkeys.md), so the dropdown is also
 * walked with one keystroke (`HcMenuEntryHot()`). */
